<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="2.0dp" android:topRightRadius="2.0dp" android:bottomLeftRadius="2.0dp" android:bottomRightRadius="2.0dp" />
            <stroke android:width="1.0px" android:color="#eaeaea" />
            <solid android:color="#f5f5f5" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:topLeftRadius="2.0dp" android:topRightRadius="2.0dp" android:bottomLeftRadius="2.0dp" android:bottomRightRadius="2.0dp" />
                <solid android:color="#0090ff" />
            </shape>
        </clip>
    </item>
</layer-list>
