<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="#7b7a7a"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/tv_server_role"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:text="服务器名称 嚣张的豆芽"/>
    <LinearLayout
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/msg_failed"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginRight="15dp"
            android:src="@drawable/msg_failed"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/gray"
            android:gravity="center"
            android:id="@+id/tv_send"
            android:background="@drawable/bg_msg_sender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="who?"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_send"
        android:visibility="gone"
        android:layout_width="150dp"
        android:layout_height="300dp"
        android:layout_marginRight="10dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#7b7a7a"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/tv_send_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:text="10月15日 18:00"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/gray"
        android:gravity="center_vertical"
        android:layout_gravity="start"
        android:id="@+id/tv_receive"
        android:background="@drawable/bg_msg_receiver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="i am your father"/>
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/iv_receive"
        android:visibility="gone"
        android:layout_width="150dp"
        android:layout_height="300dp"
        android:layout_marginLeft="10dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#7b7a7a"
        android:gravity="center"
        android:layout_gravity="start"
        android:id="@+id/tv_receive_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:text="10月15日 18:00"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_content_end"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:src="@drawable/icon_content_end"/>
</LinearLayout>
