<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ScrollView
        android:background="@drawable/ttos_moment_alert_bg"
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:paddingStart="35dp"
        android:paddingEnd="35dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="@color/ttos_moment_font"
                android:gravity="center"
                android:id="@+id/tv_alert_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:minHeight="28dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttos_moment_font"
                android:id="@+id/tv_alert_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:layout_marginBottom="21dp"
                android:lineSpacingExtra="4dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttos_moment_white"
                android:gravity="center"
                android:id="@+id/tv_positive"
                android:background="@drawable/ttos_moment_alert_positive_bg"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="38dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttos_moment_font"
                android:gravity="center"
                android:id="@+id/tv_negative"
                android:background="@drawable/ttos_moment_alert_negative_bg"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="35dp"/>
        </LinearLayout>
    </ScrollView>
    <ImageView
        android:id="@+id/iv_alert_close"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ttos_moment_alert_close"
        android:scaleType="centerCrop"/>
</FrameLayout>
