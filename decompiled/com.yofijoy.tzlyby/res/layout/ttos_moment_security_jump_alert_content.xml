<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/moment_security_jump_alert_title"
            android:id="@+id/tv_alert_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/moment_security_jump_alert_title"
            android:lineSpacingExtra="8dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/moment_security_jump_alert_message"
            android:id="@+id/tv_alert_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/moment_security_jump_alert_message"
            android:lineSpacingExtra="5dp"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/iv_alert_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ttos_moment_security_jump_alert_content_close"
        android:layout_marginEnd="8dp"/>
</FrameLayout>
