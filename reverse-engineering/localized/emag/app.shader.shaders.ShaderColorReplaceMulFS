return "\n#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying vec2 v_texCoord;\n\n//uniform sampler2D u_Texture;\nuniform vec3 u_OriginalColor1; // The first color to be replaced\nuniform vec3 u_TargetColor1; // The first target color\nuniform vec3 u_OriginalColor2; // The second color to be replaced\nuniform vec3 u_TargetColor2; // The second target color\nuniform float u_Threshold; // Similarity threshold\n\nuniform sampler2D u_texture;\n\nvoid main()\n{\nvec4 src_color = texture2D(u_texture, v_texCoord); // Get the original texture color\n    gl_FragColor = src_color;\n// Check the similarity between the current pixel and the first original color\nfloat threshold = u_Threshold; // Color similarity threshold\nif (length(u_OriginalColor1) > 0.0 && // Determine whether the first color is valid\n        abs(src_color.r - u_OriginalColor1.r) < threshold &&\n        abs(src_color.g - u_OriginalColor1.g) < threshold &&\n        abs(src_color.b - u_OriginalColor1.b) < threshold) {\n        src_color.rgb = u_TargetColor1; // Replace with the first target color\n    }\n\n    // If there is a second color, check and replace\n    if (length(u_OriginalColor2) >0.0 && // Determine whether the second color is valid\n        abs(src_color.r - u_OriginalColor2.r) < threshold &&\n        abs(src_color.g - u_OriginalColor2.g) < threshold &&\n        abs(src_color.b - u_OriginalColor2.b) < threshold) {\nsrc_color.rgb = u_TargetColor2; // Replace with the second target color\n        \n    }\n    \ngl_FragColor = src_color; // Output the final color\n}\n\n\n"