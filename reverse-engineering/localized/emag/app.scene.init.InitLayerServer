    btnStartGame:setPosition(0, 220)
    self._nodeServer:addChild(btnStartGame)
end

function InitLayerServer:initServerList()
    local x = 294
    local y = 320
    self._listNode = display.newNode()
    -- self._listNode:setAnchorPoint(0, 0)
    self._listNode:setPosition(x, y)
    self._nodeServer:addChild(self._listNode)
    self._listNode:setVisible(false)
    x = 0
    y = 0
    w = 252
    h = #self._serverList * 30 + 40
    local spriteBg = ccui.Scale9Sprite:create(lt.ResManager:resPath("_blackGoldBg"), cc.rect(0, 0, 12, 12), cc.rect(4, 4, 4, 4))
    spriteBg:setContentSize(w, h)
    spriteBg:setPosition(x, y)
    self._listNode:addChild(spriteBg)
    self._listNode:setContentSize(w, h)

    y = h/2 
    for k,v in ipairs(self._serverList) do
        y = y - 32
        local btn = ccui.Button:create(lt.ResManager:resPath("_blackGoldBg"))
        btn:setScale9Enabled(true)
        btn:setContentSize(200, 28)
        btn:setTitleText(v.name)
        btn:setTitleFontSize(16)
        local color = k == 1 and Constant.COLOR_TEXT_GOLD or Constant.COLOR_TEXT_WHITE
        btn:setTitleColor(color)
        btn:setPosition(x, y)
        btn:addClickEventListener(function()
            self:doEventTabState(k)
        end)
        self._listNode:addChild(btn)
        v.btn = btn
    end
    local state = lt.PrefManager:getServerState()
    if not state or state == "" or state == "nil" then
        state = #self._serverList
    end
    self:doEventTabState(tonumber(state))
end

function InitLayerServer:showSelectServer()
    self._serverListOpen = true
    self._listNode:setVisible(self._serverListOpen)

    for k,v in ipairs(self._serverList) do
        local color = k == self._state and Constant.COLOR_TEXT_GOLD or Constant.COLOR_TEXT_WHITE
        v.btn:setTitleColor(color)
    end
end

function InitLayerServer:hideSelectServer()
    self._serverListOpen = false
    self._listNode:setVisible(self._serverListOpen)
end

function InitLayerServer:doEventTabState(state)
    self:hideSelectServer()
    self._state = math.min(state, #self._serverList)
    local str = self._serverList[self._state].name
    self._btnServer:setTitle(str)
end

function InitLayerServer:show()
    self:setVisible(true)

    print(lt.StringManager:getString(lt.StringManager.KEY_LOADING_SERVER_LIST))
    self._nodeServer:setVisible(false)
    self._textState:setString(lt.StringManager:getString(lt.StringManager.KEY_LOADING_SERVER_LIST))

    lt.ScheduleUtil:performWithDelayGlobal(function()
        self._nodeServer:setVisible(true)
        self._textState:setString("")
    end, 0.2)
end

function InitLayerServer:hide()
    self:setVisible(false)
end

function InitLayerServer:onClickChangeAccount()
    local fadeOutView = lt.FadeOutView.new(function()
        self._initScene:showInitLayerAccount()
    end)
    self:addChild(fadeOutView)
end

function InitLayerServer:onClickShowAnnounce()
    lt.LogUtil:debug("InitLayerServer:onClickShowAnnounce")
end

function InitLayerServer:onClickSelectServer()
    lt.LogUtil:debug("InitLayerServer:onClickSelectServer")
    if self._serverListOpen then
        self:hideSelectServer()
    else
        self:showSelectServer()
    end
   
end

function InitLayerServer:openGameAlertTip(event)
    param = event.param
    self._tip = lt.UIDlgTip.new({content = param.content,
                                 btns = param.btns,
                                 title = lt.StringManager:getString(lt.StringManager.KEY_SYSTEM_TIP),
                                 callback = function(state)
                                        local callback = param.callback
                                        if callback then
                                            callback(state)
                                        end
                                        self._tip = nil
                                 end,
                                 otherWay = true,
                                 mask = true})
    self._tip:setPosition(display.cx, display.cy)
    self:addChild(self._tip, 10)
end

function InitLayerServer:onClickStartGame()
    local serverInfo = self._serverList[self._state or 1]
    if not serverInfo then
        local tip = lt.UIWgtFloatTip.new({content = "server is empty, please select again"})
        tip:setPosition(0, 320)
        self._nodeServer:addChild(tip)
        return
    end
    lt.PrefManager:setServerState(self._state)
    self._serverInfo = serverInfo

    -- if true then
        self:_startGame()
    -- else
    --     self:checkUpdate()
    -- end

    return true
end

-- 别修改
function InitLayerServer:checkUpdate()
    print("InitLayerServer:checkUpdate")
    if not self._updater then
        self._updater = require("updater.updater")
        self._updater:setUIDelegate(self)
        self._updater:setCallback(handler(self, self._checkUpdateSuccess), handler(self, self._checkUpdateFail))
    end
    self._updater:checkUpdate(self._resMapCode)
end

function InitLayerServer:_checkUpdateSuccess(needReset)
    if self._updater then
        self._updater:clear()
        self._updater = nil
    end

    if needReset then
        -- 重启游戏
        lt.Game:resetGo()

    else
        -- 正常游戏
        self:_startGame()
    end
end

function InitLayerServer:_checkUpdateFail(errorCode, errorMsg)
    if self._updater then
        self._updater:clear()
        self._updater = nil
    end

    print("updateFail errorCode:", errorCode, "errorMsg:", errorMsg)


end

function InitLayerServer:_startGame()
    if not self._serverInfo then
        return
    end

    -- local roleScene = lt.RoleScene.new()
    -- display.runScene(roleScene)
    print("connect url:",self._serverInfo.url,"ip:",self._serverInfo.ip,"port:",self._serverInfo.port)
    lt.SocketApi:connect(self._serverInfo.url,self._serverInfo.ip, self._serverInfo.port)
    self._textState:setString(lt.StringManager:getString(lt.StringManager.KEY_CONNECTING_SERVER))
end

function InitLayerServer:onConnSuccess(event)
    --发送登录gate请求
    local account = lt.PrefManager:getValueByKey(lt.PrefManager.LOGIN_NAME) -- self._initScene:getAccount()
    lt.LogUtil:debug("Login account:", account)
    local serverId = 0
    if self._serverInfo then
        serverId = self._serverInfo.id
    end

    local codes = "developer"
    local storecode = lt.PrefManager:getValueByKey(lt.PrefManager.LOGIN_NAME..account)
    if storecode and storecode ~= "" then
        codes = storecode
    end
    -- _G_TOKEN = account
    
    lt.LoginCmd:loginReq(account,codes,0,20200428,0,serverId)
end

function InitLayerServer:onLoginGameAck(event)
    lt.LogUtil:debugInfo("InitLayerServer:onLoginGameAck")
    local data = event.param
    -- dump(data)
    if data then
        if data._byResult == lt.CliGgProto.PROTO_SUCCESS then
            lt.RoleModule:setPID(data._stReply._szPTID)

            lt.RoleModule:refreshData(data._stReply._stRoleList)

            if data._stReply and data._stReply._stLoginData and data._stReply._stLoginData._szDataBuf and data._stReply._stLoginData._szDataBuf ~= "" then
                local dataValue = json.decode(data._stReply._stLoginData._szDataBuf) or {}
                if dataValue.invite then
                    -- 邀请码
                    print("invitation code1:", dataValue.invite)
                    lt.RoleModule:setInviteCode(dataValue.invite)
                end
            end

            local roleScene = lt.RoleScene.new()
            display.runScene(roleScene)
            return
        elseif data._byResult == lt.CliGgProto.PROTO_FAILURE then
            if data._stReply then
                lt.LogUtil:debug("Failed to log in to the game _wErrCode", data._stReply._wErrCode)
                return
            end
        end
    end
    lt.LogUtil:debug("Failed to log in to the game")
end

