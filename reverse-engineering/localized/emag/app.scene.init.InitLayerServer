local InitLayerServer = class("InitLayerServer", lt.BaseLayer)

local UIMgr             = lt.UIMgr
local Constant          = lt.Constant
local StringManager     = lt.StringManager

InitLayerServer._initScene = nil

InitLayerServer._textState  = nil
InitLayerServer._nodeServer = nil
InitLayerServer.state       = nil
InitLayerServer._serverList = nil
InitLayerServer._btnServer  = nil
InitLayerServer._tip        = nil

function InitLayerServer:ctor(initScene)
    InitLayerServer.super.ctor(self)
    self._serverList = {}
    self._initScene = initScene

    self:initUI()
end

function InitLayerServer:onClear()
    lt.LogUtil:debug("InitLayerServer:onClear")

    self._initScene = nil
    self._tip = nil
end

function InitLayerServer:onEnter()
    lt.ConnectManager:setDelegate(self)
    -- lt.SocketApi:addProtoListener(lt.SocketApi._Event.Login_ACK, handler(self, self.onLoginGameAck), "InitLayerServer:onLoginGameAck")

    -- 请求基础信息
    self:initServerInfo()
end

function InitLayerServer:onExit()
    lt.ConnectManager:clearDelegate(self)
    -- lt.SocketApi:removeProtoListenerByTag("InitLayerServer:onLoginGameAck")
end

