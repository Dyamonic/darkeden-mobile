    btnChangeAccount:setPosition(display.width - 50, display.height - 90)
    self:addChild(btnChangeAccount)

    self._textState = ccui.Text:create()
    self._textState:setString("")
    self._textState:setPosition(display.cx, 140)
    self._textState:setFontName(Constant.FONT_2)
    self._textState:setFontSize(16)
    self._textState:setColor(Constant.COLOR_TEXT_GOLD_H)
    self._textState:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
    self._textState:enableOutline(Constant.COLOR_OUTLINE, 2)
    self:addChild(self._textState)

    local textCopyright = ccui.Text:create()
    textCopyright:setString(lt.StringManager:getString(lt.StringManager.KEY_COPYRIGHT))
    textCopyright:setPosition(display.cx, 45)
    textCopyright:setFontName(Constant.FONT_2)
    textCopyright:setFontSize(16)
    textCopyright:setColor(Constant.COLOR_COPYRIGHT)
    textCopyright:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
    textCopyright:enableOutline(Constant.COLOR_OUTLINE, 2)
