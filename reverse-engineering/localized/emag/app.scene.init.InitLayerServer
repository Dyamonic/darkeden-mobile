    self._btnServer = lt.ServerButton:create("retro 9999 area", 1, handler(self, self.onClickSelectServer))
    self._btnServer:setPosition(-75, 320)
    self._nodeServer:addChild(self._btnServer)

    local btnSelectServer = UIMgr:createButton("_initSelect", "KEY_INIT_SELECT_SERVER", {
        clickCb = handler(self, self.onClickSelectServer),
    })
    btnSelectServer:setPosition(105, 320)
    btnSelectServer:addClickEventListener(handler(self, self.onClickSelectServer))
    self._nodeServer:addChild(btnSelectServer)

    local btnStartGame = UIMgr:createButton("_initStartGame", nil, {
        clickCb = handler(self, self.onClickStartGame),
