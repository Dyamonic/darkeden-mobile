return "\n#ifdef GL_ES\n    precision highp float;\n#endif\n\nvarying vec2 v_texCoord;\nuniform vec3 dest_color_b; //skin, hair\nuniform vec3 dest_color_g32b; //clothes\nuniform vec3 dest_color_g64b;\nuniform vec3 dest_color_g96b;\nuniform float u_darkFactor;\nuniform float u_saturation; //saturation\nuniform float u_exposure; //Exposure\n\nuniform vec4 skill_color;\nuniform vec4 origin_color;\nuniform vec4 select_color;\nuniform float offset_color; // offset\nuniform float visible_count; //Stealth effect\nuniform float u_wipeAmount; //Control the degree of erasure, ranging from 0 to 64\nuniform int b_snipe; // sniper mode\nuniform float gray_offset; // Paralysis grayscale configuration\nuniform float power_b; //Enhanced magnification\nuniform float power_g32b; //Enhanced magnification\nuniform float power_g64b; //Enhanced magnification\nuniform float power_g96b; //Enhanced magnification\n\nuniform vec2 pixelSize;\n\n// cocos4.0 parameter name changes CC_Texture0 -> u_texture\nuniform sampler2D u_texture;\n\nvoid main(void) {\n    vec4 src_color = texture2D(u_texture, v_texCoord).rgba;\n    vec4 newColor = src_color.rgba;\n\n    if (length(select_color) > 0.0 && src_color.a < 0.1) {\n        gl_FragColor = src_color;\n    }else{\n        float originClothB = (1.0- src_color.b);\n        if(visible_count != 1.0){\n            newColor.a *= visible_count;\n        }\n\n        //(Human) weapons, shields, skins, hair (Ghost) skins\n        if (length(dest_color_b) > 0.0 && src_color.b >= offset_color && src_color.r == 0.0  && src_color.g == 0.0)\n        {\nfloat originB = originClothB * power_b; // Color value magnification adjustment\n            newColor.r = dest_color_b.r * originB;\n            newColor.g = dest_color_b.g * originB;\n            newColor.b = dest_color_b.b * originB;\n            if(visible_count != 1.0){\n                newColor.a *= visible_count;\n            }\n        }\n\n//(Ghost) Coat (Human) Pants, Tops\n        if (length(dest_color_g32b) > 0.0 && src_color.b >= 0.0 && src_color.r == 0.0 && src_color.g > 0.1 && src_color.g < 0.2)\n        {\n            float originB = originClothB * power_g32b; // Color value magnification adjustment\n            newColor.r = dest_color_g32b.r * originB;\n            newColor.g = dest_color_g32b.g * originB;\n            newColor.b = dest_color_g32b.b * originB;\n            if(visible_count != 1.0){\n                newColor.a *= visible_count;\n            }\n        }\n\n\n        //(Ousters) Weapon==Hand\n        if (length(dest_color_g64b) > 0.0 && src_color.b > 0.0 && src_color.r == 0.0  && src_color.g > 0.2 && src_color.g < 0.3)\n        {\n            float originB = originClothB * power_g64b; // Color value magnification adjustment\n\n            newColor.r = dest_color_g64b.r * originB;\n            newColor.g = dest_color_g64b.g * originB;\n            newColor.b = dest_color_g64b.b * originB;\n        }\n\n\n        //(Ousters) boots = feet:\n        if (length(dest_color_g96b) > 0.0 && src_color.b > 0.0 && src_color.r == 0.0  && src_color.g > 0.3 && src_color.g < 0.4)\n        {\n            float originB = originClothB * power_g96b; // Color value magnification adjustment\n\n            newColor.r = dest_color_g96b.r * originB;\n            newColor.g = dest_color_g96b.g * originB;\n            newColor.b = dest_color_g96b.b * originB;\n        }\n\n\n        // Fast sliding effect\n        newColor.rgb *= u_darkFactor; //Adjust color\n\n\n        // Sniper mode special effects\n        vec4 color = texture2D(u_texture, v_texCoord);\n        float distanceFromCenter = abs(v_texCoord.x - 0.5) * 2.0; // Normalize to the range [0, 1]\n        float alpha = 1.0;\n        if (distanceFromCenter < (u_wipeAmount / 64.0)) {\n            if (b_snipe == 1) {\n                newColor.rgb *= vec3(0.1, 0.1, 0.1);\n            }\n        }\n\n        //Paralysis<Green Poison (Venom Arc) = Yellow Poison\n        //ignite>green poison (venom arc) = yellow poison\n// Skill-related discoloration\n        if (length(skill_color) > 0.0) {\n            if (skill_color.a == 2.0){\n//Ice Spiritual Stone turns blue\n                float blueAdjustment = 1.0 - dot(newColor.rgb, vec3(0.299, 0.587, 0.114));\n                vec3 adjustedColor = vec3(\n                    newColor.r - blueAdjustment * newColor.r*2.0,\n                    newColor.g - blueAdjustment * newColor.g*2.0,\n                    newColor.b + blueAdjustment * (1.0 - newColor.b)\n                );\n                adjustedColor = clamp(adjustedColor, 0.0, 1.0);\n                newColor = vec4(adjustedColor,newColor.a);\n            } else {\nvec4 u_skill_color = newColor * skill_color; // Multiply the color with the uniform color\n                if (skill_color.r == 0.5 && skill_color.g == 0.5 && skill_color.b == 0.5) \n                {\n                    float gray = (newColor.r + newColor.g + newColor.b) / gray_offset;\n                    u_skill_color = vec4(gray, gray, gray, src_color.a);\n                }\n                newColor = u_skill_color;\n            }\n        }else{\n            if (length(origin_color) > 0.0) {\n                newColor.rgb *= origin_color.rgb;\n                if (origin_color.r == 0.5 && origin_color.g == 0.5 && origin_color.b == 0.5) \n                {\n                    float gray = (newColor.r + newColor.g + newColor.b) / gray_offset;\n                    newColor = vec4(gray, gray, gray, src_color.a);\n                }\n            }\n        }\n//Stroke effect\n        float alphaSum = 0.0;\n        if (length(select_color) > 0.0 && length(pixelSize) > 0.0) {\n            for (float x = -1.0; x <= 1.0; x += 1.0) {\n                for (float y = -1.0; y <= 1.0; y += 1.0) {\n                    if (x == 0.0 && y == 0.0) continue; \n                    vec2 offset = vec2(x * pixelSize.x, y * pixelSize.y);\n                    vec4 neighborColor = texture2D(u_texture, v_texCoord + offset);\n                    alphaSum += neighborColor.a;\n                }\n            }\n            if (alphaSum > 6.0) {\n                gl_FragColor = newColor;\n            }else{\n                gl_FragColor = select_color;\n            }\n        }else{\n            gl_FragColor = newColor;\n        }\n    }\n}\n"