function GameModule:onWeatherNtf(event)
    local proto = event.param
    local type = proto.type
    local level = proto.level
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_WEATHER_UPDATE, {weather = type, level = level})
end

function GameModule:onDarkLightNtf(event)
    local proto = event.param
    local darkLevel = proto.darkLevel
    local lightLevel = proto.lightLevel
    print("GameModule:onDarkLightNtf:lightLevel, darkLevel", lightLevel, darkLevel)
    local darkLevel = proto.darkLevel or 0
    local lightLevel = proto.lightLevel or 0

    self._darkLevel = darkLevel
    self._lightLevel = lightLevel

    local worldAgent = lt.AgentManager:getWorldAgent()
    if worldAgent then
        local heroAgent = worldAgent:getHeroAgent()
        if heroAgent then
            heroAgent:changeSight(lightLevel, darkLevel)
        end
    end
end

function GameModule:getLightLevel()
    return self._lightLevel
end
function GameModule:getDarkLevel()
    return self._darkLevel
end

function GameModule:onLightingNtf(event)
    local proto = event.param
    local delay = proto.delay
end

--检查对方是否需要名字变色
function GameModule:checkNameColorChange(roleData)
    if not roleData then
       return false 
    end

    local heroData = self:getHeroData()
    if not heroData then
        return false
    end

    local playerIds = heroData:getAttackPlayerIds()
    for i = 1, #playerIds do
        if playerIds[i] == roleData:getPlayerId() then
            return true
        end
    end

    return false
end

function GameModule:isVampire()
    return self:getHeroRace() == Constant.RaceType.Vampire
end
--上次寻路数据
function GameModule:setLastRouteData(routeData)
    self._routeData = routeData
end

function GameModule:getLastRouteData()
    return self._routeData
end

--特殊整点通知ntf
function GameModule:onSpecialTimeNtf(event)
    local proto = event.param
    local timeStamp = proto.timeStamp
    local hour_direct = tonumber(os.date("%H", timeStamp))
    lt.LogUtil:debugInfo("GameModule:onSpecialTimeNtf  "..timeStamp.."  "..hour_direct)
    --零点刷新
    if hour_direct == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_SHOPPING_MALL)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_MONTH_CARD)
    end
end

--更换宠物模型
function GameModule:changeModel(agent)
    if agent:isPet() then
        local monsterData = agent:getMonsterData()
        local petMeta = CacheManager:getPetMeta(monsterData:getMonsterId())
        local petLevel = monsterData:getPetLevel()
        local stage = lt.PetModule:getPetStateByLevel(petLevel)
        local modelId = lt.PetModule:getPetModelByState(petMeta, stage)
        local petSkinModelId = monsterData:getPetSkinModelId()
        if petSkinModelId then
            modelId = petSkinModelId
        end
        if modelId ~= 0 then
            agent:changeAppr(modelId)
        end
    end
end

