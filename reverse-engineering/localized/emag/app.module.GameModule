function GameModule:onUpdateAttackInterval(delta)
    if self._attackElapse and self._attackElapse > 0 then
        self._attackElapse = self._attackElapse - delta
    end
end

function GameModule:getAttackCd()
    return self._attackElapse, self._attackInterval
end

function GameModule:setAttackCd(skillId)
    if skillId then
        local worldAgent = lt.AgentManager:getWorldAgent()
        local selfAgent = worldAgent:getHeroAgent()
        local action = CacheManager:getStartActionBySkillId(skillId)
        action = lt.SkillManager:getSlayerAction(selfAgent, skillId, action)
        if action == nil then
            action = Constant.ROLE_ACTION_IDLE
        end
        
        local count, step = lt.ActionManager:getActorFrameCount(selfAgent:getHeroData():getModelName(), action, selfAgent:getDirection(),selfAgent:getTransformId(),selfAgent:getCurStepMultiple())
        self._attackInterval = (count) * step
    end

    -- yflog:Info("GameModule:setAttackCd  %s", self._attackInterval)
    self._attackElapse = self._attackInterval
end

function GameModule:clearAttackCd()
    self._attackElapse = 0
    self._attackInterval = 0
end

function GameModule:onReliveAck(event)
    yflog:Info("GameModule:onReliveAck")
    local proto = event.param
    if proto.ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_HERO_RELIVE)
    end
end

function GameModule:onAllBodyStatus(event)
    -- yflog:Info("GameModule:onAllBodyStatus")
    local proto = event.param

    local bufferArray = proto.bufferstatus
    for _, buffer in ipairs(bufferArray) do
        --[[
        yflog:Info("objID:",buffer.objID)
        yflog:Info("bufferId:",buffer.bufferId)
        yflog:Info("addOrDel:",buffer.addOrDel)
        yflog:Info("timeRemain:",buffer.timeRemain)
        yflog:Info("skillLevel:",buffer.skillLevel")
	    yflog:Info("srcType:",buffer.srcType")
	    yflog:Info("srcId:",buffer.srcId")
        --]]
        local isExist = buffer.timeRemain ~= buffer.totalTime
        local params =  buffer.params
        local x = params[1]
        local y = params[2]
        local source = {srcType = buffer.srcType,srcId = buffer.srcId, isExist = isExist, x = x, y = y, sequenceId = buffer.sequenceId} -- buff来源

        self:setBuffer(buffer.objID, buffer.bufferId, buffer.addOrDel, buffer.timeRemain / 1000,buffer.skillLevel, source)
    end
end

function GameModule:onBodyStatus(event)
    local proto = event.param
    --[[
    yflog:Info("GameModule:onBodyStatus")
    yflog:Info("objID:",proto.objID)
    yflog:Info("bufferId:",proto.bufferId)
    yflog:Info("addOrDel:",proto.addOrDel)
    yflog:Info("timeRemain:",proto.timeRemain)
    yflog:Info("skillLevel:",buffer.skillLevel")
    yflog:Info("srcType:",buffer.srcType")
    yflog:Info("srcId:",buffer.srcId")
    --]]
    --yflog:Info("skillLevel1111:",proto.bufferId,proto.skillLevel)
    yflog:Info("Buff GameModule:onBodyStatus:%s addorDel:%s, timeRemain:%s,proto.totalTime:%s",tostring(proto.bufferId), tostring(proto.addOrDel),tostring(proto.timeRemain), tostring(proto.totalTime))
    local isExist = proto.timeRemain ~= proto.totalTime
    local params =  proto.params
    local x = params[1]
    local y = params[2]
    local source = {srcType = proto.srcType, srcId = proto.srcId, isExist = isExist, x = x, y = y, sequenceId = proto.sequenceId} -- buff来源

    self:setBuffer(proto.objID, proto.bufferId, proto.addOrDel, proto.timeRemain / 1000,proto.skillLevel,source)
end

--[[
    @param addOrDel 1:添加buff 2:移除buff
]]
function GameModule:setBuffer(objId, bufferId, addOrDel, time, skilllevel, source)
    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return
    end

    local bufferId = bufferId
    if lt.BuffEnum.REPEAT_ADD_BUFF[bufferId] and source.sequenceId then
        bufferId = string.format("%s-%s",bufferId,source.sequenceId)
    end
    local agent = worldAgent:getAgent(objId)

    if addOrDel == 1 then
        if agent then
            -- yflog:Info("添加buff bufferId:%s, skilllevel:%s, source.srcId:%s, triggerTime:%s", bufferId, skilllevel, source.srcId, os.clock())
            agent:addBuffer(bufferId, time, skilllevel, source)
        end

        if objId == self._heroData:getObjId() then
            self._bufferTable = self._bufferTable or {}
            self._bufferTable[bufferId] = time
            self._bufferlevelTable = self._bufferlevelTable or {}
            self._bufferlevelTable[bufferId] = skilllevel
            self._bufferSource = self._bufferSource or {}
            self._bufferSource[bufferId] = source
            self._bufferAddTime = self._bufferAddTime or {}
            self._bufferAddTime[bufferId] = TimeCounter:serverTime()
            -- yflog:Info("------------->>>>>GameModule:setBuffer:" .. bufferId .. " time:" .. time)

            -- 更新UI
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_BUFF_UPDATE)

            --双倍经验buff需要更新主界面精力加成百分比
            if bufferId == lt.BuffEnum.EFFECT_DOUBLE_EXP then
                lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_REFRESH_ENERGY_EXP, {reloadList = true})
            end

            -- if bufferId == lt.BufferSystem.BUFFER.MB then
            --     lt.ChatModule:sendClientInfo(lt.StringManager:getString(lt.StringManager.KEY_BUFFER_NOTICE_1), 22)
            -- elseif bufferId == lt.BufferSystem.BUFFER.DS then
            --     lt.ChatModule:sendClientInfo(lt.StringManager:getString(lt.StringManager.KEY_BUFFER_NOTICE_2), 22)
            -- elseif bufferId == lt.BufferSystem.BUFFER.ZD or bufferId == lt.BufferSystem.BUFFER.SDS then
            --     lt.ChatModule:sendClientInfo(lt.StringManager:getString(lt.StringManager.KEY_BUFFER_NOTICE_3), 22)
            -- elseif bufferId == lt.BufferSystem.BUFFER.ZZS then
            --     lt.ChatModule:sendClientInfo(lt.StringManager:getString(lt.StringManager.KEY_BUFFER_NOTICE_16), 22)
            -- end
        end
    else
        if agent then
            yflog:Info("Delete buff bufferId:%s triggerTimer:%s", bufferId, os.clock())
            agent:delBuffer(bufferId, time)
        end

        if objId == self._heroData:getObjId() then
            self:delBufferByBufferId(bufferId)

            -- if bufferId == lt.BufferSystem.BUFFER.MFD then
            --     lt.SkillCdManager:setCd(Constant.SKILL_CODE.MFD, Constant.SKILL_MFD_BREAK_CD)
            -- end

            -- 更新UI
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_BUFF_UPDATE)
        end
    end
    if agent and agent:isRoleAgent() and agent:getIsSelf() and lt.BuffEnum.REFRESH_SLOT_BUFFS[bufferId] then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPT_SKILL_SLOT_CONDITION, {type = Constant.SLOT_CONDITION_TYPE.BUFF})
    end
end

function GameModule:setAttackType(index)
    local AttackMode = netcmd_pb.SetAttackMode()
    AttackMode.mode = index
    SocketApi:sendToGs(ClientCmdDef.ATTACK_MODE, AttackMode)
end

function GameModule:onAttackMode(event)
    local proto = event.param
    yflog:Info("GameModule:onAttackMode" .. proto.mode)
    self._heroData:setAttackMode(proto.mode)

    local attackMode =  self._heroData:getAttackMode()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = string.format(GReadText.KEY_AUTO_RECYCLE_TIPS2, Constant.TARGET_TYPE_STR[attackMode])})
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_TARGET)
end

function GameModule:onPickError(event)
    local proto = event.param

    yflog:Info("GameModule:onPickError ret:" .. (proto and proto.ret or "nil"))

    local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()

    if proto.ret == 0 then
        local worldAgent = lt.AgentManager:getWorldAgent()
        if worldAgent then
            worldAgent:resetPickTable(proto.x, proto.y)
        end

        NtfManager:dispatchNtf(NtfManager.NTF.NTF_PICK_UP_OPREATE)
    else
        --背包已满
        if proto.ret == Constant.ERROR_CODE.BAGFULL then
            heroAgent:setStopPickUp(true)
        end
    end

    local agent = GameModule:checkCurDropAndBodyGridMap(proto.x, proto.y)
    if agent and agent:isItemAgent() then
        local itemData = agent:getItemData()
        itemData:setPickEndTime(0)
    end
end

-- Setter && Getter
function GameModule:getHeroData()
    return self._heroData
end

function GameModule:getHeroRace()
    if not self._raceType then
        if self._heroData then
            self._raceType = self._heroData:getRace()
        end
    end
    return self._raceType or Constant.RaceType.Slayer
end
function GameModule:getHeroPlayerId()
    local playerId = ""
    if self._heroData then
        playerId = self._heroData:getPlayerId()
    end
    return playerId
end

function GameModule:getHeroLevel()
    if self._heroData then
        return self._heroData:getLevel()
    else
        return 0
    end
end

function GameModule:getHistoryMaxLevel()
    if self._heroData then
        return self._heroData:getHistoryMaxLevel()
    else
        return 0
    end
end

function GameModule:isHeroAlive()
    if not self._heroData then
        return false
    end

    return self._heroData:isAlive()
end

function GameModule:getHeroObjId()
    if not self._heroData then
        return 0
    end

    return self._heroData:getObjId()
end

function GameModule:onUpdateBufferTable(delta)
    if not self._bufferTable then
        return
    end

    for bufferId,time in pairs(self._bufferTable) do
        self._bufferTable[bufferId] = math.max(0, time - delta)
    end
end

function GameModule:getBufferTable()
    return self._bufferTable
end

function GameModule:getBufferLevelTable()
    return self._bufferlevelTable
end

function GameModule:getBufferSource()
    return self._bufferSource
end

function GameModule:getBufferSourceByBuffId(buffId)
    return (self._bufferSource or {})[buffId]
end

function GameModule:getBufferAddTime()
    return self._bufferAddTime
end

function GameModule:clearBufferTable()
    self._bufferTable = nil
    self._bufferlevelTable = nil
    self._bufferSource = nil
    self._bufferAddTime = nil

    -- 更新UI
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_BUFF_UPDATE)
end

function GameModule:delBufferByBufferId(bufferId)
    if self._bufferTable then
        self._bufferTable[bufferId] = nil
    end

    if self._bufferlevelTable then
        self._bufferlevelTable[bufferId] = nil
    end

    if self._bufferSource then
        self._bufferSource[bufferId] = nil
    end
    
    if self._bufferAddTime then
        self._bufferAddTime[bufferId] = nil
    end

    --双倍经验buff需要更新主界面精力加成百分比
    if bufferId == lt.BuffEnum.EFFECT_DOUBLE_EXP then
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_REFRESH_ENERGY_EXP, {reloadList = true})
    end
end

function GameModule:canMove()
    if not self._bufferTable then
        return true
    end

    -- 非麻痹非定身
    return (not self._bufferTable[1] and not self._bufferTable[2])
end

function GameModule:isFaceToFace(agentId)
    local agent = agentId
    if type(agent) == "number" then
        agent = lt.AgentManager:getAgent(agent)
    end

    if not agent then
        return false
    end

    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return false
    end

    local selfAgent = worldAgent:getHeroAgent()
    if not selfAgent then
        return false
    end

    local m1, n1 = agent:getMNExactly()

    if not lt.MapUtil:isMNNeighbor(m0, n0, m1, n1) then
        return false
    end

    local direction1 = agent:getDirection()

    if lt.MapUtil:calcDirectionMN(m0, n0, m1, n1) ~= direction0 then
        return false
    end

    return lt.MapUtil:getOppositeDirection(direction0) == direction1
end

function GameModule:setUpBtnState(types)
    self._upBtnHideType = types
end

function GameModule:getUpBtnState()
    if self._upBtnHideType == nil then
        self._upBtnHideType = true
    end
    return self._upBtnHideType
end

