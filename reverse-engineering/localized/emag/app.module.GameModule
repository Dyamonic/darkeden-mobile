function GameModule:init()
    SocketApi:addProtoListener(ServerCmdDef.HERO_DATA_INFO, handler(self, self.onHeroDataInfo), "GameModule:onHeroDataInfo")
    SocketApi:addProtoListener(ServerCmdDef.ENTER_GS_NOTIFY, handler(self, self.onEnterGsNotify), "GameModule:onEnterGsNotify")
    SocketApi:addProtoListener(ServerCmdDef.APPEAR_MAP_PROPERTY, handler(self, self.onAppearMapProperty), "GameModule:onAppearMapProperty")

    -- 对象出现包(玩家，怪物，物品掉落)
    SocketApi:addProtoListener(ServerCmdDef.OBJ_APPEAR, handler(self, self.onObjAppear), "GameModule:onObjAppear")
   
    -- 对象消失包
    SocketApi:addProtoListener(ServerCmdDef.OBJ_DISAPPEAR, handler(self, self.onObjDisappear), "GameModule:onObjDisappear")

    -- 生物移动
    SocketApi:addProtoListener(ServerCmdDef.OBJ_MOVE, handler(self, self.onObjMove), "GameModule:onObjMove")

    -- 生物平移jump
    SocketApi:addProtoListener(ServerCmdDef.OBJ_JUMP, handler(self, self.onObjJump), "GameModule:onObjJump")
    
    -- 生物攻击 
    SocketApi:addProtoListener(ServerCmdDef.OBJ_ATTACK, handler(self, self.onObjAttack), "GameModule:onObjAttack")

    SocketApi:addProtoListener(ServerCmdDef.S_WARNING_EFFECT, handler(self, self.onObjWarning), "GameModule:onObjWarning")

    -- 对象死亡包
    SocketApi:addProtoListener(ServerCmdDef.OBJ_DIE, handler(self, self.onObjDie), "GameModule:onObjDie")

    -- 通用：生物属性变化
    SocketApi:addProtoListener(ServerCmdDef.OBJ_APPEARANCE_CHANGE, handler(self, self.onAppearanceChange), "GameModule:onAppearanceChange")
    SocketApi:addProtoListener(ServerCmdDef.NAME_COLOR, handler(self, self.onObjNameColor), "GameModule:onObjNameColor")

    -- 本角色属性变化
    SocketApi:addProtoListener(ServerCmdDef.HERO_PROPERTY_CHANGE, handler(self, self.onHeroPropertyChange), "GameModule:onHeroPropertyChange")

    SocketApi:addProtoListener(ServerCmdDef.HP_MP_CHANGE, handler(self, self.onHpMpChange), "GameModule:onHpMpChange")
    SocketApi:addProtoListener(ServerCmdDef.MOVE_ACK, handler(self, self.onMoveAck), "GameModule:onMoveAck")
    SocketApi:addProtoListener(ServerCmdDef.ATTACK_ACK, handler(self, self.onAttackAck), "GameModule:onAttackAck") -- 攻击返回 已验证
    SocketApi:addProtoListener(ServerCmdDef.RELIVE_ACK, handler(self, self.onReliveAck), "GameModule:onReliveAck")
    -- 所有buff
    SocketApi:addProtoListener(ServerCmdDef.ALL_BODY_STATUS, handler(self, self.onAllBodyStatus), "GameModule:onAllBodyStatus")
    -- 添加buff
    SocketApi:addProtoListener(ServerCmdDef.BODY_STATUS, handler(self, self.onBodyStatus), "GameModule:onBodyStatus")

    SocketApi:addProtoListener(ServerCmdDef.ATTACK_MODE, handler(self, self.onAttackMode), "GameModule:onAttackMode")
    SocketApi:addProtoListener(ServerCmdDef.PICKUP_ERROR, handler(self, self.onPickError), "GameModule:onPickError")

    -- 改名
    SocketApi:addProtoListener(ServerCmdDef.CHANGE_OF_NAME_RES, handler(self, self.onChangeRoleName), "GameModule:onChangeRoleName")

    -- 取消变身
    SocketApi:addProtoListener(ServerCmdDef.CANCEL_TRANSFORM, handler(self, self.cancelTransform), "GameModule:cancelTransform")

    -- 取消buff
    SocketApi:addProtoListener(ServerCmdDef.CS_CANCEL_BLOODDRAIN_BUFF_RESP, handler(self, self.cancelBuff), "GameModule:cancelBuff")

    --[[ 特殊怪物强制方向
    self._monsterForceDirectionTable = {
        [20187] = 3,
        [20188] = 3,
        [20189] = 3,
        [20190] = 3,
        [20191] = 5,
        [20192] = 3,
        [20193] = 3,
    }
    ]]

    -- 点数分配
    SocketApi:addProtoListener(ServerCmdDef.S_AssignAttributePoint, handler(self, self.onAssignAttributePoint), "GameModule:onAssignAttributePoint")

    -- 传送点回调
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_JUMP_TO_TRANSFER_POINT_RESP), handler(self, self.onTransferPoint), "GameModule:onTransferPoint")

    -- 天气
    SocketApi:addProtoListener(ServerCmdDef.CS_WEATHER_NTF, handler(self, self.onWeatherNtf), "GameModule:onWeatherNtf")
    -- 光照等级
    SocketApi:addProtoListener(ServerCmdDef.CS_DARK_LIGHT_NTF, handler(self, self.onDarkLightNtf), "GameModule:onDarkLightNtf")
    -- 闪电
    SocketApi:addProtoListener(ServerCmdDef.CS_LIGHTNING_NTF, handler(self, self.onLightingNtf), "GameModule:onLightingNtf")

    --整点通知客户端
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_SPECIAL_TIME_NTF), handler(self, self.onSpecialTimeNtf), "GameModule:onSpecialTimeNtf")

    
    --礼包码兑换成功
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.CS_GIFT_CODE_RESP), handler(self, self.closeUseCode), "GameModule:closeUseCodeNtf")

    --搜索怪物结果
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.CS_SEARCH_MONSTER_RESP), handler(self, self.onSearchMonster), "GameModule:onSearchMonster")
end

function GameModule:clear()
    SocketApi:removeProtoListenerByTag("GameModule:onHeroDataInfo")
    SocketApi:removeProtoListenerByTag("GameModule:onEnterGsNotify")
    SocketApi:removeProtoListenerByTag("GameModule:onAppearMapProperty")
    SocketApi:removeProtoListenerByTag("GameModule:onObjAppear")
    SocketApi:removeProtoListenerByTag("GameModule:onObjDisappear")
    SocketApi:removeProtoListenerByTag("GameModule:onObjMove")
    SocketApi:removeProtoListenerByTag("GameModule:onObjJump")
    SocketApi:removeProtoListenerByTag("GameModule:onObjAttack")
    SocketApi:removeProtoListenerByTag("GameModule:onObjWarning")
    SocketApi:removeProtoListenerByTag("GameModule:onObjDie")
    SocketApi:removeProtoListenerByTag("GameModule:onAppearanceChange")
    SocketApi:removeProtoListenerByTag("GameModule:onObjNameColor")
    SocketApi:removeProtoListenerByTag("GameModule:onHeroPropertyChange")
    SocketApi:removeProtoListenerByTag("GameModule:onHpMpChange")
    SocketApi:removeProtoListenerByTag("GameModule:onMoveAck")
    SocketApi:removeProtoListenerByTag("GameModule:onAttackAck")
    SocketApi:removeProtoListenerByTag("GameModule:onReliveAck")
    SocketApi:removeProtoListenerByTag("GameModule:onAllBodyStatus")
    SocketApi:removeProtoListenerByTag("GameModule:onBodyStatus")
    SocketApi:removeProtoListenerByTag("GameModule:onAttackMode")
    SocketApi:removeProtoListenerByTag("GameModule:onPickError")

    SocketApi:removeProtoListenerByTag("GameModule:onChangeRoleName")

    SocketApi:removeProtoListenerByTag("GameModule:onAssignAttributePoint")

    SocketApi:removeProtoListenerByTag("GameModule:onTransferPoint")
    SocketApi:removeProtoListenerByTag("GameModule:cancelBuff")

    SocketApi:removeProtoListenerByTag("GameModule:onWeatherNtf")
    SocketApi:removeProtoListenerByTag("GameModule:onDarkLightNtf")
    SocketApi:removeProtoListenerByTag("GameModule:onLightingNtf")

    SocketApi:removeProtoListenerByTag("GameModule:onSpecialTimeNtf")
    SocketApi:removeProtoListenerByTag("GameModule:closeUseCodeNtf")
    SocketApi:removeProtoListenerByTag("GameModule:onSearchMonster")

    self:reset()
end

function GameModule:reset()
    self._attackElapse   = 0
    self._attackInterval = 1
    self._petTable = nil
    self._bufferTable = nil
    self._bufferlevelTable = nil
    self._bufferSource = nil -- buff来源数据
    self._bufferAddTime = nil
    self._petstate = nil
    self._eventTable = nil
    self._upBtnHideType = nil
    self._heroData = nil
    self._dropAndBodyGridMap = {}
    self._curDropAndBodyGridMap = {}
    self._potionList = {}
    if self._gameTimer then
        self._gameTimer:stop()
        self._gameTimer = nil
    end

    self._raceType = nil

    -- lt.HangupManager:reset()
    lt.AutoManager:reset()
end

function GameModule:onUpdate()
    local delta = lt.GameBoard:getDeltaTime()
    self:onUpdateBufferTable(delta)
    self:onUpdateEvent(delta)
end

function GameModule:onUpdateEvent(delta)
    if not self._eventTable then
        return
    end

    self._eventUpdateElapse = (self._eventUpdateElapse or 0) + delta
    if self._eventUpdateElapse < 0.2 then
        return
    end
    self._eventUpdateElapse = 0

    for k,v in pairs(self._eventTable) do
        if type(v) == "boolean" then
            NtfManager:dispatchNtf(k)
        else
            NtfManager:dispatchNtf(k, v)
        end
    end
    self._eventTable = nil
end

function GameModule:addUpdateEvent(k, v)
    self._eventTable = self._eventTable or {}
    self._eventTable[k] = v or true
end

function GameModule:addUpdateEventMiniMap(eventName, info)
    self._eventTable = self._eventTable or {}
    if self._eventTable[eventName] then
        self._eventTable[eventName][#self._eventTable[eventName] + 1] = info
    else
        self._eventTable[eventName] = {info}
    end
end

-- SocketApi
function GameModule:sendConfirmOnLogin()
    yflog:Info("GameModule:sendConfirmOnLogin")
    local login = netcmd_pb.LogonInfo()
    login.packInfo = lt.Sdk:getAppName()
    login.userType = lt.GameManager:getUserType()
    login.areaName = lt.SocketManager:getServerName()
    login.userId = lt.SocketManager:getUserId()
    local deviceId = lt.Sdk:getDeviceId()
    login.deviceNo = deviceId
    SocketApi:sendToGs(ClientCmdDef.CONFIRM_ON_LOGIN, login)
end

function GameModule:sendPickUp(itemData, x, y, petObjId)
    local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
    heroAgent:setPickUp(false)

    local pickEndTime = itemData:getPickEndTime()
    local serverTime = TimeCounter:serverTime()
    if pickEndTime == 0 then
        itemData:setPickEndTime(serverTime + 2)
    elseif serverTime > pickEndTime then
        itemData:setPickEndTime(serverTime + 2)
    else
        return
    end

    local pick = netcmd_pb.Pick()
    local objId = itemData:getObjId()
    pick.objID = objId or 0
    pick.x = x
    pick.y = y
    if petObjId then
        pick.petObjId = petObjId
    end
    SocketApi:sendToGs(ClientCmdDef.PICKUP, pick)
end

function GameModule:sendMove(moveType, direction, newM, newN)
    local objMove = netcmd_pb.ObjMove()
    objMove.moveType = Constant.MOVE_RUN
    objMove.direction = direction
    objMove.newX = newM
    objMove.newY = newN

    SocketApi:sendToGs(ClientCmdDef.MOVE, objMove)

    lt.MapModule:onTriggerArea(newM, newN)

    --刷新安全区数据
    local worldAgent = lt.AgentManager:getWorldAgent()
    local heroAgent = worldAgent:getHeroAgent()
    heroAgent:checkSafeRectEvent()

    --检测引导
    -- NtfManager:dispatchNtf(NtfManager.NTF.NTF_CHECK_GUIDE_EVENT)

    --判断是否在自动寻路中
    local isSearch = lt.AutoFightManager:isAutoSearch()
    if isSearch then
        lt.AutoFightManager:addAutoSearchStep(heroAgent)
    end
end

function GameModule:sendAttack(skillCode, direction, targetObjId, m, n, itemObjId)
    -- yflog:Info("GameModule:sendAttack:skillCode:%s, direction:%s, targetObjId:%s, m:%s, n:%s, itemObjId:%s", skillCode, direction, targetObjId, m, n, itemObjId)
    if skillCode == SkillEnum.SKILL_ICE_LANCE_M then
        skillCode = SkillEnum.SKILL_ICE_LANCE
    end

    local objAttack = netcmd_pb.ObjAttack()
    objAttack.skillCode = skillCode
    objAttack.targetDir = direction

    if targetObjId then
        objAttack.targetID = targetObjId
    end

    if m then
        objAttack.targetX = m
    end

    if n then
        objAttack.targetY = n
    end

    if itemObjId then
        objAttack.targetItemID = itemObjId -- 目标道具id
    end
    SocketApi:sendToGs(ClientCmdDef.ATTACK, objAttack)
end

function GameModule:sendSwordSwitch(skillId, skillSwitch)
    print("GameModule:sendSwordSwitch", skillId)
    local swordSwitch = netcmd_pb.SwordSwitch()
    swordSwitch.skillId = skillId
    swordSwitch.skillSwitch = skillSwitch or 1

    SocketApi:sendToGs(ClientCmdDef.C_SWORD_SWITCH, swordSwitch)
end

function GameModule:sendRelive()
    SocketApi:sendToGs(ClientCmdDef.RELIVE)
end


-- 技能同意复活请求
function GameModule:sendAgreeRelive()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(lt.ClientCmdDef.C_AGREE_RELIVE_REQ))
end

function GameModule:sendConvertExpBox()
    
    SocketApi:sendToGs(ClientCmdDef.CONVERT_EXP_BOX)
end

function GameModule:sendAutoConvertExpBox(state)
    local obj = netcmd_pb.ReleaseExpBox()
    obj.releaseFalg = state
    SocketApi:sendToGs(ClientCmdDef.RELEASE_EXP_BOX, obj)
end

function GameModule:reqQueryAppear(objId)
    local req = netcmd_pb.ObjDisappear()
    req.objID = objId
    SocketApi:sendToGs(ClientCmdDef.QUERY_APPEAR, req)
end

-- 点数分配
function GameModule:assignAttributePoint(STRCount,DEXCount,INTCount)
    local msg = netcmd_pb.AssignAttributePoint()
    msg.STRCount = STRCount
    msg.DEXCount = DEXCount
    msg.INTCount = INTCount
    SocketApi:sendToGs(ClientCmdDef.C_AssignAttributePoint, msg)
end

function GameModule:changeRoleName(name,objId)
    local msg = netcmd_pb.CS_ChangePlayerNameReq()
    msg.newName = name 
    msg.itemObj = objId
    SocketApi:sendToGs(ClientCmdDef.CHANGE_OF_NAME, msg)
end

-- SocketApi响应函数
function GameModule:onEnterGsNotify(event)
    local proto = event.param

    TimeCounter:serverTimeUpdate(proto.serverTime)
    TimeCounter:serverOpenTimeUpdate(proto.serverOpenTime)
    --[[
    yflog:Info("serverTime:" .. proto.serverTime)
    yflog:Info("serverVersion:" .. proto.serverVersion)
    yflog:Info("serverOpenTime:" .. proto.serverOpenTime)
    yflog:Info("clientfuncswitch:" .. proto.clientfuncswitch)
    --]]
    if self._gameTimer then
        self._gameTimer:stop()
        self._gameTimer = nil
    end

    self._gameTimer = lt.GameTimer.new({serverTime = proto.serverTime, gameTime = proto.gameTime})
    self._gameTimer:start()
end

function GameModule:getGameTime()
    local date, time = nil, nil
    if self._gameTimer then
        date, time = self._gameTimer:getGameTime()
    end
    return (date or 0), (time or 0)
end

function GameModule:onAppearMapProperty(event)
    yflog:Info("GameModule:onAppearMapProperty")
    local proto = event.param

    --[[
    yflog:Info("mapCode:" .. proto.mapCode)
    yflog:Info("mapName:" .. proto.mapName)
    yflog:Info("mapProperty:" .. proto.mapProperty)
    --]]

    local worldAgent = lt.AgentManager:getWorldAgent()
    if worldAgent then
        worldAgent:loadMap(proto.mapCode)
    end
end

function GameModule:onHeroDataInfo(event)
    local proto = event.param
    --[[
    yflog:Info("GameModule:onHeroDataInfo")
    for _,v in ipairs(proto.objprops) do
        yflog:Info("properCode:%s intValue:%s strValue:%s", v.properCode, v.intValue,v.strValue)
    end
    ]]
    self._heroData = nil
    self._heroData = lt.HeroData.new(proto.objID, proto.objprops)

    lt.PrefManager:setUserId(self._heroData:getPlayerId())
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_INIT_HERO_DATA)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_HERO_EVENT)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPT_FIGHTSCORE_EVENT)
    lt.FunctionToggleModule:init()
end

function GameModule:onObjAppear(event)
    -- yflog:Info("GameModule:onObjAppear")
    local proto = event.param
    --[[
    yflog:Info("GameModule:onObjAppear")
    yflog:Info("objID:" .. proto.objID)
    yflog:Info("x:" .. proto.x)
    yflog:Info("y:" .. proto.y)
    yflog:Info("direction:" .. proto.direction)
    yflog:Info("objType:" .. proto.objType)
    for _,v in ipairs(proto.objprops) do
        yflog:Info("properCode:" .. v.properCode)
        yflog:Info("intValue:" .. v.intValue)
        yflog:Info("strValue:\n" .. v.strValue)
    end
    ]]
    -- if proto.objType ~= 1 then
    --     yflog:Info("objType:" .. proto.objType)
    --     for _,v in ipairs(proto.objprops) do
    --         yflog:Info("properCode:" .. v.properCode)
    --         yflog:Info("intValue:" .. v.intValue)
    --         yflog:Info("strValue:\n" .. v.strValue)
    --     end
    -- end
    -- yflog:Info("*************** GameModule:onObjAppear *****************")
    -- yflog:Info("objID:" .. proto.objID)
    -- yflog:Info("objType:" .. proto.objType)

    local worldAgent = lt.AgentManager:getWorldAgent()

    local fixDirection = proto.direction
    if fixDirection < 0 or fixDirection > Constant.DIRECTION_MAX then
        fixDirection = Constant.DIRECTION_DOWN
    end

    local curAgent = nil

    if proto.objType == Constant.ObjType.OBJ_PLAYER then
        local hasEffect = false
        for _, v in ipairs(proto.objprops) do
            if v.properCode == ServerClientEnum.ObjectValueDef.Attr_AppearEffect then
                hasEffect = (v.intValue == 1)
                break
            end
        end

        -- 创建HeroAgent
        if proto.objID == self._heroData:getObjId() then
            -- 自己
            worldAgent:clearVisibleList()
            self._heroData:setStatus(0)
            self._heroData:setPropertyArray(proto.objprops)
            curAgent = worldAgent:createHeroAgent(self._heroData, proto.x, proto.y, fixDirection, true, hasEffect)
            -- yflog:Info("创建自己 发型:%d 发色:%d 名字:%s", self._heroData:getHair(), self._heroData:getHairColor(), self._heroData:getName())

            NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_HERO_EVENT, {isInit=true})
            --重置拾取队列
            self:resetDropAndBodyGridMap()
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_EVENTFLAG_TRANSITION_ANIMATION)

            --先检查安全区
            curAgent:checkSafeRectEvent()

            -- if hasEffect and worldAgent:getMapAgent():isMapChange() then
            --     lt.HangupManager:stopHangup()
            -- end
        else
            -- 其他玩家
            local heroData = lt.HeroData.new(proto.objID, proto.objprops)
            curAgent = worldAgent:createHeroAgent(heroData, proto.x, proto.y, fixDirection, false, hasEffect)
            -- yflog:Info("创建其他玩家:", heroData:getObjId(), proto.x, proto.y, fixDirection)
        end
    elseif proto.objType == Constant.ObjType.OBJ_MONSTER then
        --[[ 特殊怪物需要出生动画 boss 类
        local hasEffect = false
        for _, v in ipairs(proto.objprops) do
            if v.properCode == ServerClientEnum.ObjectValueDef.Attr_AppearEffect then
                hasEffect = (v.intValue == 1)
                break
            end
        end

        -- 创建 MonsterAgent 创建怪物
        local monsterData = lt.MonsterData.new(proto.objID, proto.objprops)
        local monsterMeta = lt.CacheManager:getMonsterMeta(monsterData:getMonsterId())
        if not monsterMeta then
            return
        end

        -- 陷阱, 暂不启用
        if monsterMeta:getGrade() == lt.MonsterMeta.GRADE.TRAP then
            local trapAgent = worldAgent:createTrapAgent(monsterData, proto.x, proto.y)
        else
            -- 普通怪物
            if hasEffect then
                -- 配合出生动画 修改初始方向
                if monsterData:getModelId() == 20171 then
                    fixDirection = 3
                elseif monsterData:getModelId() == 10056 then
                    fixDirection = 4
                end
            end

            -- 特殊怪物强制方向
            local forceDirection = self._monsterForceDirectionTable[monsterData:getModelId()]
            if forceDirection then
                fixDirection = forceDirection
            end

            -- print("创建怪物:", proto.objID, monsterData:getModelId(), proto.x, proto.y, fixDirection, hasEffect)
            -- yflog:Info("modelId:%d", monsterData:getModelId())
            local monsterAgent = worldAgent:createMonsterAgent(monsterData, proto.x, proto.y, fixDirection, hasEffect)
            if forceDirection then
                monsterAgent:setForceDirection(forceDirection)
            end

            if monsterData:getMasterObjId() == self._heroData:getObjId() then
                -- 自己的召唤物
                self:addPetObjId(monsterData:getMonsterId(), monsterData:getObjId(), monsterData:getName())
            end
        end
        ]]

        -- 天炼怪物创建
        local monsterData = lt.MonsterData.new(proto.objID, proto.objprops)
        --------------------------------------------------------------------------------------------------------
        -- 创建人形怪
        local monsterMeta = monsterData:getMonsterInfoMeta()
        local roleModelInfo = nil
        if monsterMeta then
            roleModelInfo = monsterMeta:getRoleModel()
        end
        if type(roleModelInfo) == "table" then
            local heroData = lt.GameModule:createMonsterHeroData(monsterData:getObjId(), roleModelInfo, monsterMeta:getName())
            curAgent = worldAgent:createHeroAgent(heroData, proto.x, proto.y, fixDirection, false, false)
            return
        end
        --------------------------------------------------------------------------------------------------------
        -- 怪物出现方式 宠物出现方式，使用同一个标识，具体判断是宠物还是怪物在MonsterStateAppear中去判断
        local hasEffect = false
        for _, v in ipairs(proto.objprops) do
            if v.properCode == ServerClientEnum.ObjectValueDef.Attr_AppearEffect then
                hasEffect = (v.intValue == 1)
                break
            end
        end
        if hasEffect then
            local offsetTime = lt.TimeCounter:serverTime() - math.floor(monsterData:getCreateTime()/1000)
            -- yflog:Info("------------------------: %s  %s  %s ",offsetTime, math.floor(monsterData:getCreateTime()/1000), lt.TimeCounter:serverTime())
            hasEffect = hasEffect and (offsetTime <= 1) and monsterData:isAlive()
        end

        local isPet = monsterData:isPet() or false
        hasEffect = hasEffect or isPet
        --------------------------------------------------------------------------------------------------------

        -- yflog:Info("monsterData:getMonsterId():%s name:%s", monsterData:getMonsterId(), monsterData:getName())
        local monsterMeta = CacheManager:getMonsterInfoMeta(monsterData:getMonsterId())
        if not monsterMeta then
            yflog:Warn("MonsterInfoMeta does not exist monsterId:%d", monsterData:getMonsterId())
            return
        end

        curAgent = worldAgent:createMonsterAgent(monsterData, proto.x, proto.y, fixDirection, hasEffect)
        -- if curAgent:isPet() then
        --     curAgent:showAppearEffect()
        -- end
    elseif proto.objType == Constant.ObjType.OBJ_NPC then
        -- npc 已改为单机模式
        -- 创建NpcAgent
        -- local modelId = nil
        -- local name = nil
        -- for _, v in pairs(proto.objprops) do
        --     if v.properCode == lt.ServerClientEnum.ObjectValueDef.Attr_DisplayName then
        --         name = v.strValue
        --     elseif v.properCode == lt.ServerClientEnum.ObjectValueDef.Attr_Appr then
        --         modelId = v.intValue
        --     end
        -- end

        -- local mapCode = worldAgent:getMapCode()
        -- yflog:Info("创建Npc:", proto.objID, modelId, name, proto.x, proto.y, fixDirection, mapCode)
        -- worldAgent:createNpcAgent(proto.objID, modelId, name, proto.x, proto.y, fixDirection)
    elseif proto.objType == Constant.ObjType.OBJ_ITEM then
        yflog:Info("GameModule:onObjAppear ITEM")


        -- 创建ItemAgent
        local itemData = lt.ItemData.new(proto.objID, proto.objprops)
        worldAgent:createItemAgent(itemData, proto.x, proto.y)
    elseif proto.objType == Constant.ObjType.OBJ_FLOOR then
        -- 创建地面类
        local trapData = lt.TrapData.new(proto.objID, proto.objprops)
        -- 陷阱
        if trapData:isVisible()  then
            worldAgent:createTrapAgent(trapData, proto.x, proto.y)
            if trapData:getSkillId() == SkillEnum.SKILL_SHINE_SWORD then
                worldAgent:createTrapAgentTop(trapData, proto.x, proto.y)
            elseif trapData:getSkillId() == SkillEnum.SKILL_FURY_OF_GNOME then
                worldAgent:createTrapAgentBottom(trapData, proto.x, proto.y)
            end
        end
    end

    -- 出现包buff 处理
    if curAgent then
        self:onAllBodyStatus({param = {bufferstatus = proto.bufferstatus, isExist = true}})
        curAgent:addEffectStatus()
    end
end

-- 召唤物或宠物
function GameModule:addPetObjId(monsterId, objId, monsterName)
    local monsetrMeta = lt.CacheManager:getMonsterMeta(monsterId)
    if not monsetrMeta then
        return
    end

    self._petTable = self._petTable or {}
    if not self._petTable[monsetrMeta:getGrade()] then
        self._petTable[monsetrMeta:getGrade()] = {}
    end
    self._petTable[monsetrMeta:getGrade()][objId] = {monsterName or monsetrMeta:getName(), monsterId}
end

function GameModule:hasSummonPet()
    local hasSummon = false
    local monName = ""
    local monId = 0
    local monCount = 0

    while true do
        if not self._petTable then
            break
        end

        for grade,petTable2 in pairs(self._petTable) do
            if grade ~= lt.MonsterMeta.GRADE.LINSHOU and grade ~= lt.MonsterMeta.GRADE.ZHAOHUAN2 then
                for objId, value in pairs(petTable2) do
                    if not hasSummon then
                        hasSummon = true
                        monName = value[1]
                        monId = value[2]
                        monCount = 1
                    else
                        if value[2] == monId then
                            monCount = monCount + 1
                        end
                    end
                end
            end
        end

        break
    end

    return hasSummon, monName, monId, monCount
end

function GameModule:sendQueryPet()
    SocketApi:sendToGs(ClientCmdDef.C_QUERY_PET)
end

function GameModule:onObjDisappear(event)
    local proto = event.param
    --[[
        yflog:Info("GameModule:onObjDisappear")
        yflog:Info("objID:" .. proto.objID)
        yflog:Info("x:" .. proto.x)
        yflog:Info("y:" .. proto.y)
        yflog:Info("ret:" .. proto.ret)
    --]]
    local needRefresh = false
    local worldAgent = lt.AgentManager:getWorldAgent()
    local agent = worldAgent:getAgent(proto.objID)
    if agent and agent:getAgentType() == Constant.AGENT_TYPE_HERO and agent ~= worldAgent:getHeroAgent() then
        needRefresh = true
    end
    
    worldAgent:deleteAgent(proto.objID)

    for _,v in pairs(Constant.CLIENTIDNAME) do
        local trapTopAgent = worldAgent:getAgent(proto.objID .. v)
        if trapTopAgent then
            worldAgent:deleteAgent(proto.objID .. v)
        end
    end

    if needRefresh then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SELECT_TARGET_DiSAPPEAR, {objId = proto.objID})
    end
end

function GameModule:onObjMove(event)
    --yflog:Info("GameModule:onObjMove")
    local proto = event.param

    --[[
    yflog:Info("objID:" .. proto.objID)
    yflog:Info("moveType:" .. proto.moveType)
    yflog:Info("direction:" .. proto.direction)
    yflog:Info("x:" .. proto.newX)
    yflog:Info("y:" .. proto.newY)
    --]]
    
    local worldAgent = lt.AgentManager:getWorldAgent()
    local agent = worldAgent:getAgent(proto.objID)
    if agent and (agent:getAgentType() == Constant.AGENT_TYPE_MONSTER or agent:getAgentType() == Constant.AGENT_TYPE_TRAP or (agent:getAgentType() == Constant.AGENT_TYPE_HERO and agent ~= worldAgent:getHeroAgent())) then
        local cmdMove = lt.CmdMove.new(proto.moveType, proto.direction, proto.newX, proto.newY)
        agent:getCmdSystem():push(cmdMove)
    end
    -- if agent and agent:getAgentType() == Constant.AGENT_TYPE_MONSTER or agent:getAgentType() == Constant.AGENT_TYPE_HERO then
    --     local cmdMove = lt.CmdMove.new(proto.moveType, proto.direction, proto.newX, proto.newY)
    --     agent:getCmdSystem():push(cmdMove)
    -- end
end

function GameModule:onObjJump(event)
    local proto = event.param

    --[[
    yflog:Info("GameModule:onObjJump")
    yflog:Info("objID:" .. proto.objID)
    yflog:Info("moveType:" .. proto.moveType)
    yflog:Info("direction:" .. proto.direction)
    yflog:Info("x:" .. proto.x)
    yflog:Info("y:" .. proto.y)
    yflog:Info("objType:" .. proto.objType)
    yflog:Info("moveType:" .. proto.moveType)
    yflog:Info("skillID:" .. proto.skillID)
    yflog:Info("newX:" .. proto.newX)
    yflog:Info("newY:" .. proto.newY)
    yflog:Info("appear:" .. (proto.appear or 0))
    --]]
    
    
    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return
    end

    local agent = worldAgent:getAgent(proto.objID)

    if proto.appear == 1 then
        -- 创建
        self:onObjAppear(event)
    end
    
    if not agent then
       return 
    end

    local isSelf = agent:getIsSelf()
    if isSelf then -- 自己不需要广播
        self:agentJump(proto)
    else
        local params = {
            proto = {
                objID = proto.objID,
                moveType = proto.moveType,
                direction = proto.direction,
                x = proto.x,
                y = proto.y,
                objType = proto.objType,
                skillID = proto.skillID,
                newX = proto.newX,
                newY = proto.newY,
                appear = proto.appear,
                knockedTarget = proto.knockedTarget,
                targetX = proto.targetX,
                targetY = proto.targetY,
                targetID = proto.targetID,


            },
        }
        local cmdJump = lt.CmdJump.new(params)
        agent:getCmdSystem():push(cmdJump)
    end
end

function GameModule:agentJump(proto)
    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return
    end

    local agent = worldAgent:getAgent(proto.objID)
    if not agent then
        return
    end

    local needDisappear = (proto.appear == 2)
    if proto.moveType == Constant.MOVE_FORWARD then
        -------------------------------------------------------------------------------------------------------
        -- 人物move技能
        if agent:isHeroAgent() then
            if proto.skillID == SkillEnum.SKILL_SET_AFIRE then
                -- 点燃 鬼族
                if agent then
                    agent:changeState(lt.HeroStateAFire.new(agent, proto.newX, proto.newY, needDisappear))
                end
            elseif proto.skillID == SkillEnum.MAGIC_RAPID_GLIDING    -- 快速滑行
                or proto.skillID == SkillEnum.MAGIC_BLOODY_ZENITH    -- 血腥巅峰
                or proto.skillID == SkillEnum.SKILL_BLOODS_SYMPOSION -- 血之盛宴
                then
                agent:changeState(lt.HeroStateRapidMove.new(agent, proto.newX, proto.newY, proto.skillID, proto.targetX, proto.targetY))
            elseif proto.skillID == SkillEnum.SKILL_TELEPORT        -- 瞬间移动
                or proto.skillID == SkillEnum.SKILL_BOMB_CRASH_WALK -- 巨炮轰击
                or proto.skillID == SkillEnum.SKILL_DUCKING_WALLOP  -- 光速冲击
                or proto.skillID == SkillEnum.SKILL_CHARGING_ATTACK -- 精灵之怒
                then
                agent:changeState(lt.HeroStateTeleport.new(agent, proto.newX, proto.newY, proto.skillID, needDisappear, proto.targetID, proto.knockedTarget))
            elseif proto.skillID == SkillEnum.SKILL_SHADOW_WALK   -- 尾行之术
                or proto.skillID == SkillEnum.SKILL_FLASH_SLIDING -- 闪电滑行
                or proto.skillID == SkillEnum.SKILL_BLITZ_SLIDING -- 灭日修罗斩
                or proto.skillID == SkillEnum.SKILL_BIKE_CRASH    -- 飞车一击
                then
                agent:changeState(lt.HeroStateSplitMove.new(agent, proto.newX, proto.newY, proto.skillID, proto.knockedTarget, proto.targetX, proto.targetY, nil))
            elseif proto.skillID == SkillEnum.SKILL_BLAZE_WALK then -- 火焰之步
                local mHero, nHero = agent:getMNExactly()
                local targetX, targetY = proto.targetX, proto.targetY
                agent:changeState(lt.HeroStateSplitMove.new(agent, proto.newX, proto.newY, proto.skillID, proto.knockedTarget, proto.targetX, proto.targetY, nil))

                local worldAgent = lt.AgentManager:getWorldAgent()
                if not worldAgent  then return end

                local targetID = proto.targetID or 0

                local targetList =  { { 1, 0 }, { -1, 0 }, { 0, 1 } }
                local directionList = {0, 4, 6}
                for i =1,#targetList do
                    local heroData = clone(agent:getHeroData())
                    local direction = directionList[i] or 0
                    local cloneObjId = Constant.CLONETAG.BLAZE_WALK .. i
                    heroData:setObjId(cloneObjId)
                    heroData:setDirection(direction)
                    heroData:setCrossCounter(true)
                    worldAgent:createHeroAgent(heroData, mHero, nHero, direction, false, false)
                    local cloneAgent = worldAgent:getAgent(cloneObjId)
                    cloneAgent:setIsOutOfGame(true)
                    cloneAgent:getActor():setLocalZOrder(cloneAgent:getActor():getLocalZOrder()-1)

                    lt.ScheduleUtil:performWithDelayGlobal(function()
                        if targetID > 0 then
                            local worldAgent = lt.AgentManager:getWorldAgent()
                            if not worldAgent  then return end
                            local targetAgent = worldAgent:getAgent(targetID)
                            if not targetAgent then return end
                            targetX, targetY = targetAgent:getMNExactly()
                        end
                        cloneAgent:changeState(lt.HeroStateSplitMove.new(cloneAgent, targetX+targetList[i][1], targetY+targetList[i][2], proto.skillID, false, targetX, targetY, nil))
                    end, (i+1)*1/5 - 0.17)
                end
            end
        end
        -------------------------------------------------------------------------------------------------------
        -- 怪物move技能
        if agent:isMonsterAgent() then
            if proto.skillID == SkillEnum.SKILL_DUPLICATE_SELF then -- 分身术
                agent:changeState(lt.MonsterStateFastMove.new(agent, proto.newX, proto.newY, proto.skillID))

                local worldAgent = lt.AgentManager:getWorldAgent()
                if not worldAgent  then return end

                local targetID = proto.targetID or 0

                -- 创建假体
                local targetList = agent:getDuplicateList()
                for i = 1, #targetList do
                    local monsterData = clone(agent:getHeroData())
                    local cloneObjId = Constant.CLONETAG.DUPLICATESELF .. i
                    monsterData:setObjId(cloneObjId)
                    -- monsterData:setDirection(direction)
                    monsterData:setCrossCounter(true)
                    worldAgent:createMonsterAgent(monsterData, proto.x, proto.y, nil, false)
                    local cloneAgent = worldAgent:getAgent(cloneObjId)
                    cloneAgent:setIsOutOfGame(true)
                    cloneAgent:getActor():setLocalZOrder(cloneAgent:getActor():getLocalZOrder()-1)

                    if type(targetList[i]) == "number" then
                        local targetAgent = worldAgent:getAgent(targetList[i])
                        if targetAgent then
                            local targetX, targetY = targetAgent:getMNExactly()
                            cloneAgent:changeState(lt.MonsterStateFastMove.new(cloneAgent, targetX, targetY, proto.skillID))
                        end
                    end
                end
                agent:clearDuplicateList()
            elseif proto.skillID == SkillEnum.SKILL_BLOODY_WARP then -- 血腥扭曲
                agent:changeState(lt.MonsterStateFastMove.new(agent, proto.newX, proto.newY, proto.skillID))
            elseif proto.skillID == SkillEnum.MAGIC_BLOODY_ZENITH then -- 血腥巅峰
                -- FIXME 暂时用分身术的代替
                agent:changeState(lt.MonsterStateFastMove.new(agent, proto.newX, proto.newY, proto.skillID))
            end
        end
    elseif proto.moveType == Constant.MOVE_BACK then
        if agent then
            agent:onBack(proto.newX, proto.newY, needDisappear, proto.skillID)
        end
    elseif proto.moveType == Constant.MOVE_IMMEDIATE then
        -- 瞬移
        if needDisappear then
            worldAgent:deleteAgent(proto.objID)
        else
            local agent = worldAgent:getAgent(proto.objID)
            if agent then
                local x, y = lt.MapUtil:calcMNMid(proto.newX, proto.newY)

                local mapAgent = worldAgent:getMapAgent()
                if mapAgent then
                    mapAgent:changeAgentMN(agent, proto.newX, proto.newY)
                end

                agent:setMNExactly(proto.newX, proto.newY)
                agent:setPosition(x, y)
                agent:setDirection(proto.direction)

                -- 回归待机状态
                if agent.defaultState then
                    agent:defaultState()
                end
            end
        end
    end
end

function GameModule:onObjAttack(event)
    -- yflog:Info("GameModule:onObjAttackxxxxxxxxxxxxxxxx")
    local proto = event.param

    --[[
    print("GameModule:onObjAttack:")
        yflog:Info("objID:" .. proto.objID)
        yflog:Info("skillCode:" .. proto.skillCode)
        yflog:Info("targetID:" .. proto.targetID)
        yflog:Info("targetX:" .. proto.targetX)
        yflog:Info("targetY:" .. proto.targetY)
        yflog:Info("attackAction:" .. proto.attackAction)
        yflog:Info("targetDir:" .. proto.targetDir)
        yflog:Info("skillLevel:" .. proto.skillLevel)
    --]]
    
    -- print("TZ:TEST::::::::::",proto.skillLevel)

    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent  then
        return 
    end
    local agent = worldAgent:getAgent(proto.objID)
    if not agent then
        return
    end


    local agentType = agent:getAgentType()
    -- if agentType == Constant.AGENT_TYPE_MONSTER then
    --     if not self._testObjID then
    --         self._testObjID =proto.objID
    --     end
    --     if self._testObjID == proto.objID then
    --         yflog:Info("objID:" .. proto.objID)
    --         yflog:debugTime()
    --     end
    -- end

    if agentType == Constant.AGENT_TYPE_TRAP then
        -- 陷阱攻击
        agent:onAttack()
    elseif agentType == Constant.AGENT_TYPE_MONSTER or (agentType == Constant.AGENT_TYPE_HERO and agent ~= worldAgent:getHeroAgent()) then
        if (agentType == Constant.AGENT_TYPE_HERO and agent ~= worldAgent:getHeroAgent()) then
            -- yflog:Info("玩家技能攻击包：",proto.skillCode, proto.skillLevel, proto.targetDir, proto.targetID, proto.targetX, proto.targetY, proto.code, proto.extraCode) 
        end
        
        -- yflog:Info("技能攻击包：",proto.skillCode, proto.skillLevel, proto.targetDir, proto.targetID, proto.targetX, proto.targetY, proto.code, proto.extraCode) 
        ------------------------------------------------------------------------------------------------
        
        -- 角色技能
        -- Jump 类型技能
        if proto.skillCode == SkillEnum.MAGIC_RAPID_GLIDING
        or proto.skillCode == SkillEnum.MAGIC_BLOODY_ZENITH
        or proto.skillCode == SkillEnum.SKILL_BLOODS_SYMPOSION
        or proto.skillCode == SkillEnum.SKILL_TELEPORT
        or proto.skillCode == SkillEnum.SKILL_BOMB_CRASH_WALK
        or proto.skillCode == SkillEnum.SKILL_DUCKING_WALLOP
        or proto.skillCode == SkillEnum.SKILL_CHARGING_ATTACK
        or proto.skillCode == SkillEnum.SKILL_SHADOW_WALK
        or proto.skillCode == SkillEnum.SKILL_FLASH_SLIDING
        or proto.skillCode == SkillEnum.SKILL_BLITZ_SLIDING
        or proto.skillCode == SkillEnum.SKILL_BIKE_CRASH
        or proto.skillCode == SkillEnum.SKILL_BLAZE_WALK
        -- 状态 类型技能
        or proto.skillCode == SkillEnum.SKILL_HIDE
        or proto.skillCode == SkillEnum.MAGIC_SUMMON_CASKET 
        or proto.skillCode == SkillEnum.TRANSFORM_TO_BAT 
        or proto.skillCode == SkillEnum.TRANSFORM_TO_WOLF
        or proto.skillCode == SkillEnum.TRANSFORM_TO_WERWOLF
        -- 吞噬尸体（释放失败的情况下，过滤掉广播消息）
        or (proto.skillCode == SkillEnum.MAGIC_EAT_CORPSE and proto.code ~= 0)
        -- 吸血（释放失败的情况下，过滤掉广播消息）
        or (proto.skillCode == SkillEnum.SKILL_BLOOD_DRAIN and proto.code ~= 0)
        ------------------------------------------------------------------------------------------------
        -- 怪物技能
        or proto.skillCode == SkillEnum.SKILL_BLOODY_WARP
        or proto.skillCode == SkillEnum.SKILL_DUPLICATE_SELF
        then
            return
        end
        local cmdAttack = lt.CmdAttack.new(proto.skillCode, proto.skillLevel, proto.targetDir, proto.targetID, proto.targetX, proto.targetY, proto.code, proto.extraCode)
        agent:getCmdSystem():push(cmdAttack)
    end
end

function GameModule:onObjWarning(event)
    local proto = event.param

    local worldAgent = lt.AgentManager:getWorldAgent()
    local agent = worldAgent:getAgent(proto.objID)
    if not agent then
        return
    end

    if agent.onWarning then
        agent:onWarning()
    end
end

-- 对象死亡包
function GameModule:onObjDie(event)
    local proto = event.param

    local worldAgent = lt.AgentManager:getWorldAgent()
    local agent = worldAgent:getAgent(proto.objID)
    
    -- 死亡处理特效
    if agent and agent:hasBuffer(lt.BuffEnum.EFFECT_CLASS_HARPOON_BOMB) then
        agent:playQueueEffectByLv(SkillEnum.SKILL_HARPOON_BOMB, 1, Constant.EFFECT.HIT)
    end

    -- 客户端设置死亡状态
    if agent and agent.changeHeroStatus then
        agent:changeHeroStatus(Constant.HeroStatus.DEAD)
    end

    if proto.objID == self._heroData:getObjId() then
        -- 自己死亡清除所有宠物
        self._petTable = nil
        -- 清除隐蔽状态
        if agent and self._heroData:isSkillHide() then
            agent:changeSkillHide(0)
        end
        --停止挂机
        lt.AutoFightManager:endAutoFight()
    end
        yflog:Info("GameModule:onObjDie")
        yflog:Info("objID:" .. proto.objID)
        yflog:Info("x:" .. proto.x)
        yflog:Info("y:" .. proto.y)
        yflog:Info("direction:" .. proto.direction)
        yflog:Info("killerID:" .. proto.killerID)

    -- 清除隐蔽状态
    if agent and agent:isSkillHide() then
        agent:changeSkillHide(0)
    end
    if agent and agent["clearAllBuffer"] then
        agent:clearAllBuffer()
    end

    -------------------------------------------------------------------------------
    -- 临时处理鞭尸问题
    if agent and agent:isMonsterAgent() then
        local monsterData = agent:getMonsterData()
        monsterData:setValue(ServerClientEnum.ObjectValueDef.Attr_Status, Constant.HeroStatus.DEAD)
    end
    -------------------------------------------------------------------------------
    
    worldAgent:dieAgent(proto.objID, proto.x, proto.y, proto.direction, proto.killerID)
    
    if self._petTable then
        for grade, petTable2 in pairs(self._petTable) do
            petTable2[proto.objID] = nil
        end
    end

    if not agent then
        if buglyReportLuaException then
            local agentTable = worldAgent:getAgentTable()
            local angentStr = "worldAgent agentTable is nil!"
            if agentTable then
                angentStr = "angent objId:"
                for k, v in pairs(agentTable) do
                    angentStr = string.format("%s,%s", angentStr, tostring(k))
                end
            end
            
            local msgLog = string.format("     agentTable msg:%s \n          objID:%s \n          x:%s \n          y:%s \n          direction:%s \n          killerID:%s", angentStr, proto.objID, proto.x, proto.y, proto.direction, proto.killerID)
            buglyReportLuaException("BUGLY LOG: GameModule:onObjDie not agent", msgLog)
        end
    end

end

function GameModule:onAppearanceChange(event)
    local proto = event.param
    
    --[[
    yflog:Info("GameModule:onAppearanceChange")
    for _, v in ipairs(proto.objprops) do
        yflog:Info("v.properCode = "..tostring(v.properCode).." intValue "..tostring(v.intValue).."strValue"..tostring(v.strValue))
    end
    ]]
    
    
    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return
    end

    local agent = worldAgent:getAgent(proto.objID)
    if not agent then
        return
    end

    -------------------------------------------------------------------------------------
    -- 性别，职业，等级，名字，名字颜色，等级，发型，发色，衣服，武器，坐骑，时装，特效
    local hpmpChange = false -- 血量相关更新
    local levelChange = false -- 人族等级相关更新
    for _, v in ipairs(proto.objprops) do
        if v.properCode == ServerClientEnum.CreatureValueDef.Attr_Gender then
            -- 性别
            agent:changeSex(v.intValue)
        elseif v.properCode == ServerClientEnum.ObjectValueDef.Attr_DisplayName then
            -- 名字
            agent:changeName(v.strValue)

            if agent.getMonsterData and agent:getMonsterData() then
                local monsterData = agent:getMonsterData()
                if monsterData:getMasterObjId() and monsterData:getMasterObjId() > 0 and self:getHeroObjId() == monsterData:getMasterObjId() then
                    -- 宠物升级会改名
                    self:addPetObjId(monsterData:getMonsterId(), monsterData:getObjId(), monsterData:getName())
                end
            end
            -- 如果是选中目标刷新信息
            GameModule:updateSelectTarget(proto.objID)
        elseif v.properCode == ServerClientEnum.ObjectValueDef.Attr_NameColor then
            -- 名字颜色
            agent:changeNameColor(v.intValue)
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_Hair then
            -- 发型
            agent:changeHair(v.intValue)
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_HairColor then
            -- 发色
            agent:changeHairColor(v.intValue)
        elseif v.properCode == ServerClientEnum.ObjectValueDef.Attr_Appr then
            -- 外观
            agent:changeAppr(v.intValue)
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_WeaponAppr then
            -- 武器外显
            agent:changeWeapon(v.strValue)
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_Shield then
            -- 护盾外显
            agent:changeShield(v.strValue)
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_BodyAppr then
            -- 上衣外显
            agent:changeBodyAppr(v.strValue)
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_Helmet then
            -- 头盔外显
            agent:changeHelmet(v.strValue)
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_Trousers then
            -- 裤子外显
            agent:changeTrousers(v.strValue)
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_ClothesAppr then
            -- 时装
            agent:changeClothes(v.intValue)
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_BodyEffect then
            -- 特效
            agent:changeBodyEffect(v.intValue)

        elseif v.properCode == ServerClientEnum.PlayerValueDef.Attr_GuildName then
            agent:changeGuildName(v.strValue)

        elseif v.properCode == ServerClientEnum.PlayerValueDef.Attr_GuildDuty then
            agent:changeGuildDuty(v.intValue)
        elseif v.properCode == ServerClientEnum.MonsterValueDef.Attr_PetLevel then
            -- 宠物等级
            agent:changePetLevel(v.intValue)
            self:changeModel(agent)
         elseif v.properCode == ServerClientEnum.MonsterValueDef.Attr_PetSkin then
            -- 宠物皮肤
            local monsterData = agent:getMonsterData()
            monsterData:setValue(v.properCode, v.intValue)
            self:changeModel(agent)
        elseif ServerClientEnum.ObjectValueDef.Attr_Status == v.properCode then
            -- 状态
            if agent:isMonsterAgent() then
                local monsterData = agent:getMonsterData()
                monsterData:setValue(ServerClientEnum.ObjectValueDef.Attr_Status, v.intValue)
            elseif agent:isHeroAgent() then
                local isAlive = agent:isAlive()
                agent:changeHeroStatus(v.intValue)
                if not isAlive and v.intValue == Constant.HeroStatus.ALIVE then
                    if not agent:getIsSelf() then
                        local m, n = agent:getMN()
                        local direction = agent:getDirection()
                        local cmdIdle = lt.CmdIdle.new(m, n, direction)
                        agent:handleCmd(cmdIdle)
                        agent:resumeAllBuffer()
                    else
                        agent:changeState(lt.HeroStateIdle.new(agent))
                        agent:resumeAllBuffer()
                    end
                    ---------------------------------------------------------------------
                    -- 角色这边不清除会导致死亡复活的时候，标记为死亡不显示的特效一直放不出来
                    -- 怪物暂时没有复活所以不需要处理
                    if agent:getActor() then
                        agent:getActor():clearDead() -- 角色复活清除死亡状态
                    end
                    ---------------------------------------------------------------------
                end
            end
        elseif v.properCode == ServerClientEnum.ObjectValueDef.Attr_MasterID then
            -- 怪物主人
            if agent.getMonsterData and agent:getMonsterData() then
                local monsterData = agent:getMonsterData()
                monsterData:setValue(ServerClientEnum.ObjectValueDef.Attr_MasterID, v.intValue)

                if v.intValue > 0 and self:getHeroObjId() == v.intValue then
                    self:addPetObjId(monsterData:getMonsterId(), monsterData:getObjId(), monsterData:getName())
                end
                agent:changeName(monsterData:getName())
            end
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_HitEffectId then
            -- 正在命中的效果id(毒物，持续效果)特效
            if agent:isHeroAgent() then
                agent:updateHitEffect(v.strValue)
            end

        elseif v.properCode == ServerClientEnum.MonsterValueDef.Attr_Dig then 
            -- 尸体是否挖掘(怪物)
            if agent:isMonsterAgent() then
                local monsterData = agent:getMonsterData()
                monsterData:setValue(v.properCode, v.intValue)

                -- agent 刷新死亡完成挖掘 播放死亡动作的最后一帧
                agent:refreshDieFinishDig()
            end
        elseif v.properCode == ServerClientEnum.PlayerValueDef.Attr_GradeLevel then
            -- 阶级等级刷新
            agent:changeGrade(v.intValue)
            -- 如果是选中目标刷新信息
            GameModule:updateSelectTarget(proto.objID)
            -- 红点刷新
            lt.RedDotModule:onRedDotNotice(Constant.SYSTEM_TYPES.ROLE)
        elseif v.properCode == ServerClientEnum.PlayerValueDef.Attr_Tendencies then
            -- 倾向善恶值
            agent:changeTendencies(v.intValue)
            -- 如果是选中目标刷新信息
            GameModule:updateSelectTarget(proto.objID)
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_Hide then
            -- 技能隐蔽
            -- if agent:getAgentType() == Constant.AGENT_TYPE_HERO then
            --     agent:changeSkillHide(v.intValue)
            -- end
            -- agent:changeSkillHide(v.intValue)
            if agent:getRoleData():getSkillHide() ~= v.intValue then
                if agent:getIsSelf() then
                    agent:changeSkillHide(v.intValue)
                else
                    local cmdProperty = lt.CmdProperty.new(v.properCode,v.intValue)
                    agent:getCmdSystem():push(cmdProperty)
                end
            end
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_MoveMode then
            if agent:isRoleAgent() then
                local value = agent:getRoleData():getValue(v.properCode)
                if v.intValue ~= value then
                    agent:getRoleData():setValue(v.properCode, v.intValue)
                    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
                    mapAgent:resetAgentMN(agent) -- 根据模式重置阻挡点
                end
            end
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_Darkness then
            --黑暗之触
            if (agent:getAgentType() == Constant.AGENT_TYPE_HERO and not agent:getIsSelf()) or agent:getAgentType() == Constant.AGENT_TYPE_MONSTER  then
                -- if agent:getRoleData():getDarkness() ~= v.intValue then
                
                    agent:getRoleData():setValue(v.properCode, v.intValue)
                    agent:changeDarkness(v.intValue)
                -- end
            end
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_Sight then
            --视野
            if (agent:getAgentType() == Constant.AGENT_TYPE_HERO and not agent:getIsSelf()) then
                agent:getRoleData():setValue(v.properCode, v.intValue)
                agent:changeSight(v.intValue, self._darkLevel)
            end
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_MoveSpeedRate then
            if agent:getIsSelf() then
                agent:getRoleData():setValue(v.properCode, v.intValue)
            else
                local cmdProperty = lt.CmdProperty.new(v.properCode,v.intValue)
                agent:getCmdSystem():push(cmdProperty)
            end 
           
        elseif v.properCode == lt.ServerClientEnum.CreatureValueDef.Attr_CurHp or
            v.properCode == lt.ServerClientEnum.CreatureValueDef.Attr_CurMp or
            v.properCode == lt.ServerClientEnum.CreatureValueDef.Attr_HpMax or
            v.properCode == lt.ServerClientEnum.CreatureValueDef.Attr_MpMax then
            hpmpChange = true
            agent:getRoleData():setValue(v.properCode, v.intValue)
        elseif lt.ServerClientEnum.ObjectValueDef.Attr_DisappearTime == v.properCode then --消失时间
            if agent:getAgentType() == Constant.AGENT_TYPE_TRAP then 
                agent:getTrapData():setValue(v.properCode, v.intValue)
            end
        elseif lt.ServerClientEnum.CreatureValueDef.Attr_Level   == v.properCode or -- 鬼族魔族等级
            -- 人族五种等级
            lt.ServerClientEnum.CreatureValueDef.Attr_BladeLevel == v.properCode or
            lt.ServerClientEnum.CreatureValueDef.Attr_SwordLevel == v.properCode or
            lt.ServerClientEnum.CreatureValueDef.Attr_GunLevel   == v.properCode or
            lt.ServerClientEnum.CreatureValueDef.Attr_HealLevel  == v.properCode or
            lt.ServerClientEnum.CreatureValueDef.Attr_BlessLevel == v.properCode then
            agent:getRoleData():setValue(v.properCode, v.intValue)
            if agent:isHeroAgent() then
                levelChange = true
            end
        else
            if agent.getRoleData then
                if v.strValue and v.strValue ~= "" then
                    agent:getRoleData():setValue(v.properCode, v.strValue)
                elseif v.intValue then
                    agent:getRoleData():setValue(v.properCode, v.intValue)
                end
            end
            -- print("GameModule:onAppearanceChange properCode",v.properCode,"not edit")
        end
    end

    -- 更新对应血量
    if hpmpChange then        
        agent:changeHp(agent:getRoleData():getCurHp(), agent:getRoleData():getMaxHp())
        if agent.changeNameHpMp then
            agent:changeNameHpMp()
        end
        GameModule:updateSelectTarget(proto.objID)
    end

    -- 等级变化
    if levelChange then
        agent:showEffectByLevel()
    end
    
    -- 更新UI
    if agent.getIsSelf and agent:getIsSelf() then
        self:propertyChangeUi(proto.objprops)
    end
end

function GameModule:updateSelectTarget(objId)
    local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
    if not heroAgent then return end
    
    local targetId = heroAgent:getTargetAgentId()
    if not targetId then return end
    
    local targetAgent = lt.AgentManager:getAgent(targetId)
    if targetAgent and objId == targetAgent:getObjId() then
        self:addUpdateEvent(NtfManager.NTF.NTF_UPDATE_SELECT_TARGET_NAME_EVENT)
    end
end


function GameModule:onObjNameColor(event)
    local proto = event.param
    --[[
    yflog:Info("objID:" .. proto.objID)
    yflog:Info("nameColor:" .. proto.nameColor)
    --]]

    local worldAgent = lt.AgentManager:getWorldAgent()
    local agent = worldAgent:getAgent(proto.objID)
    if agent then
        -- print("改变名字颜色 2", proto.nameColor)
        agent:changeNameColor(proto.nameColor)
    end
end

function GameModule:onHeroPropertyChange(event)
    local proto = event.param
    if not self._heroData then
        return
    end

    if proto.objID ~= self._heroData:getObjId() then
        return
    end

    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return
    end

    local heroAgent = worldAgent:getHeroAgent()
    if not heroAgent then
        return
    end
    self._heroData:setPropertyArray(proto.objprops)

    -------------------------------------------------------------------------------------
    -- 更新UI
    self:propertyChangeUi(proto.objprops, true)
end

function GameModule:propertyChangeUi(objprops, isHeroPropertyChange)
    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return
    end

    local heroAgent = worldAgent:getHeroAgent()
    if not heroAgent then
        return
    end

    -- 更新UI
    local hpmpChange = false
    local jinbiChange = false
    local yuanbaoChange = false
    local isLevelChange = false
    local isExpChange = false
    local isCurPointChange = false
    local other = 0

    for _, v in ipairs(objprops) do
        if v.properCode then
            if v.properCode == ServerClientEnum.PlayerValueDef.Attr_JinBi or
                v.properCode == ServerClientEnum.PlayerValueDef.Attr_YuanBao or
                v.properCode == ServerClientEnum.PlayerValueDef.Attr_BindYuanBao or
                v.properCode == ServerClientEnum.PlayerValueDef.Attr_JiFen then
                jinbiChange = true
                local addMoney = self._heroData:getChangeValueByKey(ServerClientEnum.PlayerValueDef.Attr_JinBi) 
                if addMoney and addMoney > 0 then
                    lt.AudioManager:playSound(lt.ResManager.SOUND_NUM.GET_MONEY)
                    local content = string.format(StringManager:getString(StringManager.KEY_ADD_MONEY_TIP), tostring(addMoney))
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_NOTICE,{content = content})
                end
            elseif v.properCode == lt.ServerClientEnum.CreatureValueDef.Attr_HpMax or
                v.properCode == lt.ServerClientEnum.CreatureValueDef.Attr_MpMax or
                v.properCode == lt.ServerClientEnum.CreatureValueDef.Attr_CurHp or
                v.properCode == lt.ServerClientEnum.CreatureValueDef.Attr_CurMp or
                v.properCode == lt.ServerClientEnum.CreatureValueDef.Attr_SilverDamage then -- 血条蓝条变换,镀银值改变
                hpmpChange = true
                -- self:propertyChangeNotice(v.properCode)
            elseif v.properCode == ServerClientEnum.PlayerValueDef.Attr_CurExp or
                v.properCode == ServerClientEnum.PlayerValueDef.Attr_BladeExp or
                v.properCode == ServerClientEnum.PlayerValueDef.Attr_SwordExp or
                v.properCode == ServerClientEnum.PlayerValueDef.Attr_GunExp or
                v.properCode == ServerClientEnum.PlayerValueDef.Attr_HealExp or
                v.properCode == ServerClientEnum.PlayerValueDef.Attr_BlessExp or
                v.properCode == ServerClientEnum.PlayerValueDef.Attr_AdvanceExp then -- 转职前经验，转职后经验变化
                isExpChange = true
                other = other + 1
                self:propertyChangeNotice(v.properCode ,isLevelChange)
            elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_Level or
                v.properCode == ServerClientEnum.PlayerValueDef.Attr_AdvanceLevel or
                v.properCode == ServerClientEnum.PlayerValueDef.Attr_AdvanceState then -- 转职前等级变化和转职后变化
                isLevelChange = true
                other = other + 1
                self:onCheckLevelUp(v.properCode)
            elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_BladeLevel or
                v.properCode == ServerClientEnum.CreatureValueDef.Attr_SwordLevel or
                v.properCode == ServerClientEnum.CreatureValueDef.Attr_GunLevel or
                v.properCode == ServerClientEnum.CreatureValueDef.Attr_HealLevel or
                v.properCode == ServerClientEnum.CreatureValueDef.Attr_BlessLevel then  --人族领域等级变化
                if v.intValue > 0 then
                    isLevelChange = true
                    other = other + 1
                    self:onCheckLevelUp(v.properCode,true)
                end
            elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_Darkness then
                --黑暗之触
                if self._heroData:getChangeValueByKey(ServerClientEnum.CreatureValueDef.Attr_Darkness)  then
                    heroAgent:changeDarkness(v.intValue)
                end
            elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_Sight then
                --视野
                heroAgent:getRoleData():setValue(v.properCode, v.intValue)
                heroAgent:changeSight(v.intValue, self._darkLevel or 0)
            elseif v.properCode == ServerClientEnum.PlayerValueDef.Attr_AttackPlayerIds then
                worldAgent:checkPlayersNameColor()
            elseif v.properCode == ServerClientEnum.PlayerValueDef.Attr_SkillPoints then
                -- 红点刷新
                lt.RedDotModule:onRedDotNotice(Constant.SYSTEM_TYPES.ROLE)
            elseif v.properCode == ServerClientEnum.PlayerValueDef.Attr_CurSkillPoint then
                --可用属性点更新
                other = other + 1
                self:propertyChangeNotice(v.properCode)
                isCurPointChange = true
            else
                self:propertyChangeNotice(v.properCode)
                other = other + 1
            end
        end
    end

    -- 如果other > 1 发送UPDATE_HERO事件
    if other > 0 then
        --[[
        -- print("============================== GameModule:onHeroPropertyChange Start ==============================")
        for _, v in ipairs(objprops) do
            if v.properCode then
                local change = self._heroData:getChangeValueByKey(v.properCode) 
                print("properCode:", v.properCode, "intValue:", v.intValue, "strValue:", v.strValue, "change:", change)
            end
        end
        -- print("============================== GameModule:onHeroPropertyChange End ==============================")
        --]]
        self:addUpdateEvent(NtfManager.NTF.NTF_UPDATE_HERO_EVENT)
    end

    --------------------------------------------------------------------------------------------
    -- 特殊标识发特定的消息事件
    if jinbiChange then
        self:addUpdateEvent(NtfManager.NTF.NTF_UPDATE_MONEY_EVENT)
    end
    if isCurPointChange then
        self:addUpdateEvent(NtfManager.NTF.NTF_UPDATE_HERO_POINTS_EVENT)
    end

    if yuanbaoChange then
        -- TODO: 元宝/绑金 变化
    end


    -- 血量和蓝变更
    if hpmpChange then
        heroAgent:changeHp(self._heroData:getCurHp(), self._heroData:getMaxHp())
        self:addUpdateEvent(NtfManager.NTF.NTF_UPDATE_HPMP_EVENT)
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_UPT_SKILL_SLOT_CONDITION, {type = Constant.SLOT_CONDITION_TYPE.HPMP})
    end

    -- 经验变更
    if isExpChange then
        self:addUpdateEvent(NtfManager.NTF.NTF_UPDATE_EXP_EVENT)
    end

    -- 等级变更
    if isLevelChange and isHeroPropertyChange then
        lt.RedDotModule:onRedDotNotice(Constant.SYSTEM_TYPES.ROLE)
        lt.FunctionToggleModule:refresh()--等级变化入口开关优先刷新数据
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPT_SKILL_SLOT_CONDITION, {type = Constant.SLOT_CONDITION_TYPE.LEVEL})
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_VIP_REFRESH_BY_LEVEL)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_ENERGY_EXP)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_CHECK_GUIDE_EVENT)
        heroAgent:showLevelupEffect()
        if heroAgent:getRaceType() == Constant.RaceType.Slayer then
            --人族更新自动挂机技能释放条件
            heroAgent:updateAutoFiterSkills()
        end
    end

    -- 等级和经验变更
    if isLevelChange or isExpChange then
        self:addUpdateEvent(NtfManager.NTF.NTF_LEVEL_EXP_CHANGE)

        if isLevelChange then
            lt.StatisticModule:statisLevelup()
        end
    end
    --------------------------------------------------------------------------------------------
end

function GameModule:onCheckLevelUp(prop,isSlayer)
    local change = self._heroData:getChangeValueByKey(prop) or 0
    if change <= 0 then return end
    local advState = self._heroData:getAdvanceState()
    local level = 0
    local slayerLv = 0
    if advState == Constant.AdvState.NotAdv then
        level = self:getHistoryMaxLevel()
        if isSlayer then
            slayerLv = self._heroData:getValue(prop) or 0
        end
    else
        local curAdvLvl = self._heroData:getAdvanceLevel()
        level = curAdvLvl + Constant.TransferLevel
    end
    local list = {}
    if slayerLv > 0 and slayerLv ~= level then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_LEVEL_UP_EFFECT,{list = list, prop = prop})
        return
    end
    local toggleMap = CacheManager:getFunctionToggleMap()
    for k, v in pairs(toggleMap or {}) do
        if v:getLevel() == level and tonumber(v:getIsDisplay()) == 1 then
            table.insert(list,v:getName())
        end
    end
    
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_LEVEL_UP_EFFECT,{list = list, prop = prop})
end

function GameModule:propertyChangeNotice(prop, isLevelChange)
    local change = self._heroData:getChangeValueByKey(prop) or 0
    
    if ExpToLv[prop] and isLevelChange then
        local level = ExpToLv[prop]
        local changeLv = self._heroData:getChangeValueByKey(level)
        if changeLv > 0 then
            local preLv = self._heroData:getPreValue(level)
            local area = self._heroData:getMaxLevel()
            local curLv= self._heroData:getValue(level)
            local preExp = self._heroData:getPreValue(prop)
            local curExp = self._heroData:getValue(prop)
            local changeValue = 0
            if prop == ServerClientEnum.PlayerValueDef.Attr_AdvanceExp then
                local expMeta = CacheManager:getAdvLevelExpInfoMeta(preLv)
                local maxExp = expMeta:getExp() or 0
                changeValue = maxExp - preExp
                changeValue = changeValue + curExp
                if changeLv > 1 then
                    for i = preLv + 1, curLv - 1 do
                        local expMeta = CacheManager:getAdvLevelExpInfoMeta(i)
                        local maxExp = expMeta:getExp() or 0
                        changeValue = changeValue + maxExp
                    end
                end
            else
                if self._heroData:isSlayer() then
                    local expMeta = CacheManager:getSLevelExpInfoMeta(area, preLv)
                    changeValue = expMeta:getExp() - preExp
                    changeValue = changeValue + curExp
                    if changeLv > 1 then
                        for i = preLv + 1, curLv - 1 do
                            expMeta = CacheManager:getSLevelExpInfoMeta(area, i)
                            changeValue = changeValue + expMeta:getExp()
                        end
                    end
                else
                    local expMeta = CacheManager:getLevelExpInfoMeta(preLv) or {}
                    changeValue = expMeta:getExp() - preExp
                    changeValue = changeValue + curExp
                    if changeLv > 1 then
                        for i = preLv + 1, curLv - 1 do
                            expMeta = CacheManager:getLevelExpInfoMeta(i)
                            changeValue = changeValue + expMeta:getExp()
                        end
                    end
                end
            end
            
            change = changeValue
        end
    end

    if ExpToSDI[prop] and change < 0 then
        local initProp =  ExpToSDI[prop].init
        local pureProp =  ExpToSDI[prop].pure
        local preLv = (self._heroData:getValue(initProp) -1) + self._heroData:getValue(pureProp)
        local expMeta = CacheManager:getAttrLevelExpInfoMeta(preLv)
        if not expMeta then
            return
        end
        local preExp = self._heroData:getPreValue(prop)
        local curExp = self._heroData:getValue(prop)
        local changeValue = 0
        changeValue = expMeta:getExp() - preExp
        changeValue = changeValue + curExp
        change = changeValue
    end

    if change == 0 then return end

    local messageFilterMeta = CacheManager:getMessageFilterMapById(prop)
    local displayType = messageFilterMeta and messageFilterMeta:getDisplayType() or 0

    if messageFilterMeta and displayType > 0 then
        -- 1.提升至（数值） 或  降低至（数值）
        -- 2.:+(数值）  或  ：-（数值）
        -- 3.提升至（数值）%  或  降低至（数值）%
        -- 4.+(数值）%  或  ：-（数值）%
        local content = messageFilterMeta:getDisplayContent() or ""
        local noticeId = 0
        local params = {}
        if displayType == 1 then --
            if change > 0 then
                noticeId = 10005
            else
                noticeId = 10006
            end
            params[1] = content
            params[2] = self._heroData:getValue(prop) or 0
        elseif displayType == 2 then
            if change > 0 then
                noticeId = 10008
            else
                noticeId = 10009
            end
            params[1] = content
            params[2] = math.abs(change)
        elseif displayType == 3 then
            if change > 0 then
                noticeId = 10005
            else
                noticeId = 10006
            end
            params[1] = content
            params[2] = self._heroData:getValue(prop) .."%%"
        elseif displayType == 4 then
            if change > 0 then
                noticeId = 10008
            else
                noticeId = 10009
            end
            if prop == ServerClientEnum.PlayerValueDef.Attr_MonsterDamageBonus
            or prop == ServerClientEnum.PlayerValueDef.Attr_PlayerDamageBonus then
                change = math.floor(change/100)
            end
            params[1] = content
            params[2] = math.abs(change).."%%"
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_NEW_SYSTEM_NOTICE, {noticeId = noticeId,params = params})

    end
    if ServerClientEnum.PlayerValueDef.Attr_Tendencies == prop then --倾向度
        local propValue = self._heroData:getValue(prop)
        local tendencyName = CacheManager:getTendencyNameByValue(propValue)
        local prePropValue = self._heroData:getPreValue(prop)
        local preTendencyName = CacheManager:getTendencyNameByValue(prePropValue)
        if change > 0 then --倾向变好了一些
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_NEW_SYSTEM_NOTICE, {noticeId = 10100,params = {}})
        end
        if tendencyName ~= preTendencyName then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_NEW_SYSTEM_NOTICE, {noticeId = 10101,params = {tendencyName}})
        end
    end
end

function GameModule:onHpMpChange(event)
    local proto = event.param
    --[[
    yflog:Info("GameModule:onHpMpChange")
    yflog:Info("objID:" .. proto.objID)
    yflog:Info("curHP:" .. proto.curHP)
    yflog:Info("maxHP:" .. proto.maxHP)
    yflog:Info("hpChange:" .. proto.hpChange)
    yflog:Info("curMP:" .. proto.curMP)
    yflog:Info("maxMP:" .. proto.maxMP)
    yflog:Info("mpChange:" .. proto.mpChange)
    yflog:Info("skillID:" .. proto.skillID)
    yflog:Info("flag:" .. proto.flag)
    --yflog:Info("attackerID:" .. proto.attackerID)
    --]]
    
    -- yflog:Info("GameModule:onHpMpChange objId:%d curHP:%d maxHP:%d hpChange:%d skillId:%d flag:%d", proto.objID, proto.curHP, proto.maxHP, proto.hpChange, proto.skillID, proto.flag)
    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return
    end

    local agent = worldAgent:getAgent(proto.objID)
    if not agent then
        return
    end

    local change = false

    ---伤害特效播放规则
    local hasSkillID = proto.skillID ~= 0 
    local isHpMpChange = proto.hpChange ~= 0 or proto.mpChange ~= 0
    local isAttackerSelf = proto.objID == proto.attackerID
    if isAttackerSelf and SkillEnum.HELP_SKILL_ID_TABLE[proto.skillID] and isHpMpChange then
        isAttackerSelf = false
    end
    local isReadyAttacker = proto.attackerID == 0 or (not isAttackerSelf)
    if hasSkillID and isHpMpChange and isReadyAttacker then
        if proto.skillID == SkillEnum.SKILL_BLOODSUCKING_ATTACK then
            if proto.hpChange <= 0 then
                lt.SkillManager:skillDamageEffect(proto)
            end
        elseif proto.skillID == SkillEnum.SKILL_BLUESUCKING_ATTACK then
            if proto.mpChange <= 0 then
                lt.SkillManager:skillDamageEffect(proto)
            end
        elseif proto.skillID == SkillEnum.SKILL_PLASMA_ROCKET_LAUNCHER then
            --导弹类只播放指定目标
        else
            lt.SkillManager:skillDamageEffect(proto)
        end
    end

    -- 血量
    if proto.hpChange < 0 then
        change = true

        if agent.changeHp and proto.hpChange ~= 0 then
            agent:changeHp(proto.curHP, proto.maxHP)
        end

        -- 显示伤害数字
        worldAgent:onHpChange(proto.objID, proto.hpChange, proto.skillID, proto.beAttacked, proto.attackerID)
    elseif proto.hpChange > 0 then
        change = true

        if agent.changeHp then
            agent:changeHp(proto.curHP, proto.maxHP)
        end

        -- if agent:getAgentType() == Constant.AGENT_TYPE_HERO then
            -- if bit._and(proto.flag, 0x400) > 0 then
                worldAgent:onHpChange(proto.objID, proto.hpChange, proto.skillID, proto.beAttacked, proto.attackerID)
            -- end


            -- pvp被反弹,hpChange值大于0
            -- if bit._and(proto.flag, 0x40) > 0 then
                -- worldAgent:onHpChange(proto.objID, proto.hpChange, proto.flag, proto.skillID, proto.effectInfo)
            -- end
        -- end
    end

    -- 魔法
    if proto.mpChange ~= 0 then
        change = true

        if agent.changeMp then
            agent:changeMp(proto.curMP, proto.maxMP)
        end
    end

    -- 自己血量变化
    if change and proto.objID == self._heroData:getObjId() then
        self:addUpdateEvent(NtfManager.NTF.NTF_UPDATE_HPMP_EVENT)
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_UPT_SKILL_SLOT_CONDITION, {type = Constant.SLOT_CONDITION_TYPE.HPMP})
    end

    -- 其它对象血条血量更新
    if change then
        self:addUpdateEvent(NtfManager.NTF.NTF_UPDATE_SELECT_TARGET_HPMP_EVENT)
    end
end



function GameModule:onMoveAck(event)
    local proto = event.param
    --[[
        yflog:Info("GameModule:onMoveAck")
        yflog:Info("flag:" .. proto.flag)
        yflog:Info("x:" .. proto.x)
        yflog:Info("y:" .. proto.y)
        yflog:Info("direction:" .. proto.direction)
    --]]
    -- 1: 成功  2: 失败
    local worldAgent = lt.AgentManager:getWorldAgent()
    local mapAgent = worldAgent:getMapAgent()
    if lt.AutoFightManager:isAuto() then
        if self._rangeOutArr and #self._rangeOutArr > 0 then
            yflog:Info("GameModule:onMoveAck  :: revisionXY")
            yflog:Info("flag:" .. proto.flag)
            yflog:Info("x:" .. proto.x)
            yflog:Info("y:" .. proto.y)
            yflog:Info("direction:" .. proto.direction)
            self._rangeOutArr = {}
        end
    end
    if proto.flag == 2 then
        yflog:Info("ret:" .. (proto.ret or "nil"))

        local x, y = lt.MapUtil:calcMNMid(proto.x, proto.y)

       
        local heroAgent = worldAgent:getHeroAgent()
        if mapAgent and heroAgent then
            mapAgent:changeAgentMN(heroAgent, proto.x, proto.y)
            heroAgent:setMNExactly(proto.x, proto.y)
            heroAgent:setPosition(x, y)
           
            heroAgent:setDirection(proto.direction)

            if heroAgent:getCurState().setWait then
                heroAgent:getCurState():setWait()
            else
                heroAgent:changeState(lt.HeroStateIdle.new(heroAgent, 1))
            end
        end
        return
    end
end

function GameModule:onAttackAck(event)
    local proto = event.param
    --[[
        yflog:debug("GameModule:onAttackAck")
        yflog:debug("ret:" .. proto.ret)
        yflog:debug("skillID:" .. proto.skillID)
        yflog:debug("x:" .. proto.x)
        yflog:debug("y:" .. proto.y)
        yflog:debug("direction:" .. proto.direction)
        yflog:debug("cdRemain:" .. (proto.cdRemain or "nil"))
    --]]
    -- yflog:Info("onAttackAck ret:%d, skillId:%d ", proto.ret, proto.skillID)
    local worldAgent = lt.AgentManager:getWorldAgent()
    local heroAgent = worldAgent:getHeroAgent()
    if proto.ret == 0 then  -- 成功
        lt.SkillCdManager:setCd(proto.skillID, proto.cdRemain / 1000, heroAgent and heroAgent:getCurStepMultiple() or 1)
        lt.SkillManager:skillReleaseSuccess(proto)
    elseif proto.ret == Constant.ErrorCode.Miss then -- 未命中 也需要表现
        -- TODO 需添加 未命中飘字
        lt.SkillCdManager:setCd(proto.skillID, proto.cdRemain / 1000 ,heroAgent and heroAgent:getCurStepMultiple() or 1)
        lt.SkillManager:skillReleaseSuccess(proto)

        if proto.skillID == lt.SkillEnum.SKILL_FLASH_SLIDING then -- 闪电滑行未命中切回idle
            local heroAgent = lt.AgentManager:getHeroAgent()
            if heroAgent then
                heroAgent:changeState(lt.HeroStateIdle.new(heroAgent))
            end
        end
    else -- 失败 cd不重置
        -- if proto.skillID and proto.skillID > 0 then
        --     lt.SkillCdManager:setCd(proto.skillID, proto.cdRemain / 1000)
        -- end
        --1=cd未到 2=距离过远 3=蓝不够 4=目标不对 5=目标点不对 6=太频繁 7=和其他技能冲突 8=异常 9=不能使用该技能 10=过期 11=已开启开关 12=未开启开关
        -- lt.SkillManager:skillReleaseFail()
        yflog:Info("onAttackAck fail ret:" .. (proto.ret or "nil"))
        if proto.skillID == lt.SkillEnum.SKILL_BLOOD_DRAIN 
        or proto.skillID == lt.SkillEnum.SKILL_ABSORB_SOUL
        then
            local worldAgent = lt.AgentManager:getWorldAgent()
            local heroAgent = worldAgent:getHeroAgent()
            if heroAgent then
                heroAgent:getActor():setStopBloodDrain()
            end
        end
        if lt.SkillEnum.IS_MOVE_SKILL[proto.skillID] then
            --快速滑行，瞬间移动需要取消掉玩家状态
            heroAgent:changeState(lt.HeroStateIdle.new(heroAgent))
        end
        --自动战斗超过距离(清除技能连击状态)
        if proto.ret == Constant.ErrorCode.RangeOut then
            if lt.AutoFightManager:isAuto() then
                local heroAgent = lt.AgentManager:getHeroAgent()
                heroAgent:clearShotTime()


                
                self._rangeOutArr = self._rangeOutArr or {}
                table.insert(self._rangeOutArr, proto.skillID)
                if #self._rangeOutArr > 5 then
                    local worldAgent = lt.AgentManager:getWorldAgent()
                    local heroAgent = worldAgent:getHeroAgent()
                    local mTarget,nTarget = heroAgent:getMN()
                    yflog:Info("GameModule:sendMove  :: revisionXY",mTarget,nTarget)
                    GameModule:sendMove(Constant.MOVE_RUN,heroAgent:getDirection(),mTarget,nTarget)
                end
            end
        end
    end

    if proto.ret ~= 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = lt.ReadTextManager:getErrorMsgByCode(proto.ret)})

        if proto.skillID == lt.SkillEnum.MAGIC_BITE_OF_DEATH then
            local heroAgent = lt.AgentManager:getHeroAgent()
            if heroAgent then
                lt.SkillManager:playBiteOfDeath(proto.skillID, 1, heroAgent:getAgentId(), proto.ret)
            end
        end
    end
end


