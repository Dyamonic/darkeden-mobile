-- 客户端创建临时heroData
-- npc
function GameModule:createNpcHeroData(objectId, roleModelInfo)
    local objprops = {
        { properCode = ServerClientEnum.CreatureValueDef.Attr_Race,       intValue = roleModelInfo.race },
        { properCode = ServerClientEnum.CreatureValueDef.Attr_Gender,     intValue = roleModelInfo.gender or 0 },
        { properCode = ServerClientEnum.CreatureValueDef.Attr_Helmet,     strValue = string.format("%s,%s,%s",roleModelInfo.helmet or 0, 0, 0) },
        { properCode = ServerClientEnum.CreatureValueDef.Attr_BodyAppr,   strValue = string.format("%s,%s,%s",roleModelInfo.bodyAppr or 0, 0, 0)},
        { properCode = ServerClientEnum.CreatureValueDef.Attr_Trousers,   strValue = string.format("%s,%s,%s",roleModelInfo.trousers or 0, 0, 0)},
        { properCode = ServerClientEnum.CreatureValueDef.Attr_WeaponAppr, strValue = string.format("%s,%s,%s",roleModelInfo.weapon or 0, 0, 0)},
        { properCode = ServerClientEnum.CreatureValueDef.Attr_HairColor,  intValue = 8 },
    }

    local heroData = lt.HeroData.new(objectId, objprops)
    heroData:setNpcId(objectId)

    return heroData
end

-- monster
function GameModule:createMonsterHeroData(objectId, roleModelInfo, name)
    local objprops = {
        { properCode = ServerClientEnum.CreatureValueDef.Attr_Race,       intValue = roleModelInfo.race },
        { properCode = ServerClientEnum.CreatureValueDef.Attr_Gender,     intValue = roleModelInfo.gender or 0 },
        { properCode = ServerClientEnum.CreatureValueDef.Attr_Helmet,     strValue = string.format("%s,%s,%s",roleModelInfo.helmet or 0, 0, 0) },
        { properCode = ServerClientEnum.CreatureValueDef.Attr_BodyAppr,   strValue = string.format("%s,%s,%s",roleModelInfo.bodyAppr or 0, 0, 0)},
        { properCode = ServerClientEnum.CreatureValueDef.Attr_Trousers,   strValue = string.format("%s,%s,%s",roleModelInfo.trousers or 0, 0, 0)},
        { properCode = ServerClientEnum.CreatureValueDef.Attr_WeaponAppr, strValue = string.format("%s,%s,%s",roleModelInfo.weapon or 0, 0, 0)},
    }

    local heroData = lt.HeroData.new(objectId, objprops)
    heroData:setName(name)
    return heroData
end
