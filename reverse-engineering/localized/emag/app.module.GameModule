    if proto.ret == 0 then  -- 成功
        
    end
end

--掉落物/怪物尸体可拾取的格子map
function GameModule:addDropAndBodyGridMap(agent)
    local m, n = agent:getMN()
    local distance = CacheManager:getVariableById(Constant.Variable.PickupDistance, true) or 2
    for i = m-distance, m+distance do
        for j = n-distance, n+distance do
            local mnIndex = lt.MapUtil:calcMNIndex(i, j)
            if not self._dropAndBodyGridMap[mnIndex] then
                self._dropAndBodyGridMap[mnIndex] = {}
            end
            table.insert(self._dropAndBodyGridMap[mnIndex], agent)
        end
    end
    local curMnIndex = lt.MapUtil:calcMNIndex(m, n)
    self._curDropAndBodyGridMap[curMnIndex] = agent
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_PICK_UP)
end

function GameModule:removeDropAndBodyGridMap(agent)
    local m, n = agent:getMN()
    local distance = CacheManager:getVariableById(Constant.Variable.PickupDistance, true) or 2
    for i = m-distance, m+distance do
        for j = n-distance, n+distance do
            local mnIndex = lt.MapUtil:calcMNIndex(i, j)
            local list = self._dropAndBodyGridMap[mnIndex]
            if list then
                for k = 1, #list do
                    if list[k]:getAgentId() == agent:getAgentId() then
                        table.remove(list, k)
                        break
                    end
                end
            end
        end
    end
    local curMnIndex = lt.MapUtil:calcMNIndex(m, n)
    if self._curDropAndBodyGridMap[curMnIndex] then
        self._curDropAndBodyGridMap[curMnIndex] = nil
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_PICK_UP)
end

function GameModule:checkDropAndBodyGridMap()
    local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
    if not heroAgent then
        return nil
    end
    local m, n = heroAgent:getMN()
    local mnIndex = lt.MapUtil:calcMNIndex(m, n)
    if not self._dropAndBodyGridMap[mnIndex] then
        return nil
    end
    local list = {}
    for i = 1, #self._dropAndBodyGridMap[mnIndex] do
        local agent = self._dropAndBodyGridMap[mnIndex][i]
        if agent:isItemAgent() then
            local itemData = agent:getItemData()
            local isRace = itemData:getMetaRace() == 0 or itemData:getMetaRace() == heroAgent:getRoleRace()
            --如果是本种族的
            if isRace then
                local ownerObjId = itemData:getOwnerObjId()
                local ownerTimeout = itemData:getOwnerTimeout()
                local serverTime = lt.TimeCounter:serverTime()
                if ownerObjId == heroAgent:getObjId() or serverTime > ownerTimeout then
                    table.insert(list, agent)
                end
            end
        else
            table.insert(list, agent)
        end
    end
    return list
end

function GameModule:checkCurDropAndBodyGridMap(m, n)
    local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
    if not heroAgent then
        return nil
    end
    if m == nil and n == nil then
        m, n = heroAgent:getMN()
    end
    local mnIndex = lt.MapUtil:calcMNIndex(m, n)
    if not self._curDropAndBodyGridMap[mnIndex] then
        return nil
    end
    local agent = self._curDropAndBodyGridMap[mnIndex]
    if agent:isItemAgent() then
        local itemData = agent:getItemData()
        local isRace = itemData:getMetaRace() == 0 or itemData:getMetaRace() == heroAgent:getRoleRace()
        if not isRace then
            return nil
        end
        local ownerObjId = itemData:getOwnerObjId()
        local ownerTimeout = itemData:getOwnerTimeout()
        local serverTime = lt.TimeCounter:serverTime()
        if ownerObjId ~= heroAgent:getObjId() and serverTime <= ownerTimeout then
            return nil
        end
    end
    return agent
end

function GameModule:resetDropAndBodyGridMap()
    self._dropAndBodyGridMap = {}
    self._curDropAndBodyGridMap = {}
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_PICK_UP)
end

