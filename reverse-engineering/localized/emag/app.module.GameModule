--功能跳转(根据功能解锁id)自行扩展
function GameModule:gotoSystemFunc(systemId)
    local isUnlock = lt.FunctionToggleModule:checkOpen(systemId)
    if not isUnlock then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = GReadText.KEY_PET_TIPS2})
        return
    end
    if systemId == lt.FunctionToggleModule.FunctionHelpId.Character then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndRoleInfo"})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.Skill then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndRoleInfo", param = {tabId = 2}})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.ClassSkill then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndRoleInfo", param = {tabId = 3}})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.AdvancedClassSkill then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndRoleInfo", param = {tabId = 4}})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.EquipmentUpgradeSubpage then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 1}})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.EquipmentStrengthen then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 2, subIdx = 1}})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.EquipmentSynthesis then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 3, subIdx = 1}})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.EquipmentRecast then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 4, subIdx = 1}})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.EquipmentBless then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 2, subIdx = 2}})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.EquipmentInheritance then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 3, subIdx = 2}})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.Pet then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndPet"})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.PetFeed then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndPet", param = {index = 2}})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.Friend then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndFriend"})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.Chat then
        -- NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW,
        -- { class = "UIWndChat", offset = { x = lt.ChatModule.offsetX, y = 0 } })
        lt.ChatModule:openChatUI()
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.Bag then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndInventory"})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.Guild then
        local myGuildId = self._heroData:getGuildId()
        if myGuildId ~= 0 and myGuildId ~= "0" then 
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndGuildMain"})
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndGuildList"})
        end
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.TradingPost then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTransactionMain"})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.EquipmentConvert then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 4, subIdx = 3}})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.Instance then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndLeader", param = {index = 3}})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.MonthlyCard then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndMonthCard"})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.VIP then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndVip"})
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.MonthlyCard then
        --TODO月卡系统做了之后再接系统跳转
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.ChatWorld then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW,
        { class = "UIWndChat", offset = { x = lt.ChatModule.offsetX, y = 0 } })
    elseif systemId == lt.FunctionToggleModule.FunctionHelpId.GoldPage then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndRecharge",param = {type = Constant.RECHARGE_TYPE.GAME_CURRENCY}})
    end
end

