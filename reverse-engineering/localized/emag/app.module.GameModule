function GameModule:sendSearchMonster()
    local msg = netcmd_pb.CS_SearchMonsterReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_SEARCH_MONSTER_REQ), msg)
end

function GameModule:onSearchMonster(event)
    local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
    if not heroAgent then
        return
    end
    local proto = event.param
    local list = proto.position
    local x = 0
    local y = 0
    local minDistance = 999
    local m1, n1 = heroAgent:getMN()
    for i = 1, #list do
        local m2 = list[i].x
        local n2 = list[i].y
        local dis = lt.MapUtil:getMNDistance(m1, n1, m2, n2)
        local route = lt.MapUtil:route(m1, n1, m2, n2)
        if dis <= minDistance and route then
            minDistance = dis
            x = m2
            y = n2
        end
    end
    if x > 0 and y > 0 then
        lt.AutoFightManager:setSearchTarget(x, y)
    end
end

function GameModule:getCurSpeedNameBySpeed(speed)
    local curSpeed = speed or 0
    local speedArray = CacheManager:getSpeedArray() or {}
    local speedName = ""
    for i = 1, #speedArray do
        local speedMeta = speedArray[i]
        local minValue = speedMeta:getMinValue()
        local maxValue = speedMeta:getMaxValue()
        if speed >= minValue and speed <= maxValue then
            return speedMeta:getName()
        end
    end

    return speedName
end

return GameModule