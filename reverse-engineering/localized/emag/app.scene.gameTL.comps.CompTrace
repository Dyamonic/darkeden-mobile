---@class CompTrace 灵魂锁链追踪
local CompTrace = class("CompTrace", lt.UICompBase)

local NtfManager = lt.NtfManager
local DELAY_TIME = 4
local SocketApi = lt.SocketApi
local ServerCmdDef = lt.ServerCmdDef
local ClientCmdDef = lt.ClientCmdDef
local CommonModule = lt.CommonModule
local netcmd_pb = lt.netcmd_pb
function CompTrace:ctor()
    CompTrace.super.ctor(self)
end

function CompTrace:onConstruct()
    self._btnTraceCancel = self:getChild("btnTraceCancel")
    self._btnTraceStart = self:getChild("btnTraceStart")
    self._name = self:getChild("name")
    self._tips = self:getChild("tips")
end

function CompTrace:onClear()
    self._btnTraceCancel = nil
    self._btnTraceStart = nil
    self._name = nil
    self._tips = nil
end

function CompTrace:onExit()
    SocketApi:removeProtoListenerByTag("CompTrace:onTrace")
    self._btnTraceStart:removeClickListener()
    self._btnTraceCancel:removeClickListener()
end
function CompTrace:onEnter()
    SocketApi:addProtoListener(ServerCmdDef.CS_SOUL_CHAIN_RESP, handler(self, self.onTrace), "CompTrace:onTrace")
    self._btnTraceStart:addClickListener(handler(self, self.startTrace))
    self._btnTraceCancel:addClickListener(handler(self, self.cancelTrace))
end

function CompTrace:onTrace(event)
    self._btnTraceStart:setTouchable(true) 
    self._btnTraceCancel:setTouchable(true) 
    self._btnTraceStart:getChild("n6"):setVisible(false)
    self._btnTraceCancel:getChild("n6"):setVisible(false)
    local proto = event.param
    if proto.ret ~= 0 then
        local name = self._name:getText()
        self._tips:setText(string.format("%sFailed to track the person", name))
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_CLOSE_TRACE_UI)
        self._name:setText("")
        self._tips:setText("")
    end
end

function CompTrace:startTrace()
    local name = self._name:getText()
    if name == "" then
        return 
    end

    self._tips:setText(string.format("%stracking people", name))
    self._btnTraceStart:setTouchable(false) 
    self._btnTraceCancel:setTouchable(false) 
    self._btnTraceStart:getChild("n6"):setVisible(true)
    self._btnTraceCancel:getChild("n6"):setVisible(true)

    local msg = netcmd_pb.CS_SoulChainReq()
    msg.targetName = name
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_SOUL_CHAIN_REQ), msg)
end

function CompTrace:cancelTrace()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CLOSE_TRACE_UI)
end


return CompTrace