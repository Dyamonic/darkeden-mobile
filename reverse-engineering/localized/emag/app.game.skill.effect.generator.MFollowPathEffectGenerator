local MFollowPathEffectGenerator = class("MFollowPathEffectGenerator",lt.MEffectGenerator)
local SkillEnum = lt.SkillEnum
local CacheManager = lt.CacheManager
local MapUtil = lt.MapUtil

-- 定义点的结构
local POINT = { x = 0, y = 0 }

-- 定义 FollowPath
local FOLLOW_PATH = {}
for i = 0, 8 do
    FOLLOW_PATH[i] = {}
end

-- 创建路径的函数
local function makePathWildTyphoon()
    local pt

    -- 清空 FollowPath
    for i = 0, 8 do
        FOLLOW_PATH[i] = {}
    end

    -- 设置上下左右方向
    for i = 0, 8, 2 do
        if i == 2 or i == 6 then
            pt = { x = (i == 6) and 1 or -1, y = 0 }
        else
            pt = { x = 0, y = (i == 0) and -1 or 1 }
        end
        table.insert(FOLLOW_PATH[i], pt)

        if i == 2 or i == 6 then
            pt = { x = 0, y = (i == 6) and -2 or 2 }
        else
            pt = { x = (i == 0) and -2 or 2, y = 0 }
        end
        table.insert(FOLLOW_PATH[i], pt)

        if i == 2 or i == 6 then
            pt = { x = (i == 6) and -2 or 2, y = 0 }
        else
            pt = { x = 0, y = (i == 0) and 2 or -2 }
        end
        table.insert(FOLLOW_PATH[i], pt)

        if i == 2 or i == 6 then
            pt = { x = 0, y = (i == 6) and 2 or -2 }
        else
            pt = { x = (i == 0) and 2 or -2, y = 0 }
        end
        table.insert(FOLLOW_PATH[i], pt)

        if i == 2 or i == 6 then
            pt = { x = (i == 6) and 1 or -1, y = (i == 6) and -1 or 1 }
        else
            pt = { x = (i == 0) and -1 or 1, y = (i == 0) and -1 or 1 }
        end
        table.insert(FOLLOW_PATH[i], pt)
    end

    -- 设置对角线方向
    for i = 1, 8, 2 do
        if i == 1 or i == 5 then
            pt = { x = 0, y = (i == 1) and 2 or -2 }
        else
            pt = { x = (i == 3) and 2 or -2, y = 0 }
        end
        table.insert(FOLLOW_PATH[i], pt)

        if i == 1 or i == 5 then
            pt = { x = (i == 1) and -2 or 2, y = 0 }
        else
            pt = { x = 0, y = (i == 3) and 2 or -2 }
        end
        table.insert(FOLLOW_PATH[i], pt)

        if i == 1 or i == 5 then
            pt = { x = 0, y = (i == 1) and -2 or 2 }
        else
            pt = { x = (i == 3) and -2 or 2, y = 0 }
        end
        table.insert(FOLLOW_PATH[i], pt)

        if i == 1 or i == 5 then
            pt = { x = (i == 1) and 1 or -1, y = 0 }
        else
            pt = { x = 0, y = (i == 3) and -1 or 1 }
        end
        table.insert(FOLLOW_PATH[i], pt)

        if i == 1 or i == 5 then
            pt = { x = 0, y = (i == 1) and 1 or -1 }
        else
            pt = { x = (i == 3) and 1 or -1, y = 0 }
        end
        table.insert(FOLLOW_PATH[i], pt)
    end
end

