function FunctionToggleModule:init()
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.CS_FUNCTIONTOGGLENTF_NTF), handler(self, self.onFunctionToggleNtf), "FunctionToggleModule:onFunctionToggleNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.CS_FUNCTION_CLOSED_RESP), handler(self, self.onFunctionClosed), "FunctionToggleModule:onFunctionToggleNtf")
    local heroData = GameModule:getHeroData()
    if not heroData then
        return
    end
    self._curLevel = heroData:getHistoryMaxLevel()
    self._curAdvLvl = heroData:getAdvanceLevel()
    self._serverOpenDays = TimeCounter:getServerOpenDay()
    self._ready = true
end

function FunctionToggleModule:refresh()
    local heroData = GameModule:getHeroData()
    self._curLevel = heroData:getHistoryMaxLevel()
    self._curAdvLvl = heroData:getAdvanceLevel()
    self._serverOpenDays = TimeCounter:getServerOpenDay()
end
function FunctionToggleModule:clear()
    SocketApi:removeProtoListenerByTag("FunctionToggleModule:onFunctionToggleNtf")
    self._curLevel = nil
    self._curAdvLvl = nil
    self._serverOpenDays = nil
    self._ready = nil
end

function FunctionToggleModule:checkOpen(funId)
    local meta = CacheManager:getFunctionToggleMeta(funId)
    if not meta then
        return true
    end
    --服务器开关判定[暂无]
    if meta:getSwitch() == 0 then
        return false,meta:getTip()--策划表控制关闭
    end
    --开服时间诊断【暂无】
    -- if self._serverOpenDays < meta:getOpenDay() then
    --    return false,string.format("%d天后开启",meta:getOpenDay()-self._serverOpenDays)--开服时间未到 
    -- end
    --等级条件检查
    if self._curLevel + self._curAdvLvl < meta:getLevel() then
       return false,string.format("reached%dlevel open",meta:getLevel())
    end
    return true
end

function FunctionToggleModule:checkEnterVisible(funId)
    local meta = CacheManager:getFunctionToggleMeta(funId)
    if meta:getSwitch() == 0 then
        return false
    end
    if meta:getHide() == 0 and not self:checkOpen(funId) then
       return false
    end
    return true
end

function FunctionToggleModule:onFunctionToggleNtf(event)
    local param = event.param
    if param and param.toggle_list then
	    for k,_info in ipairs(param.toggle_list) do
            if _info then
                local meta = CacheManager:getFunctionToggleMeta(_info.func_id)
                if meta then
                    meta:setSwitch(_info.switch_type)
                    meta:setLevel(_info.open_level)
                    meta:setTip(_info.tip)
                    meta:setHide(_info.hide)
                    meta:setIsDisplay(_info.IsDisplay)
                    -- meta:setUseType(_info.IsDisplay)
                end
            end
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_VIP_REFRESH_BY_LEVEL)
    end
end
--服务器开关事件执行回调：客户端暂没用处
function FunctionToggleModule:onFunctionClosed(event)
    local param = event.param
    if param then
        local ret = param.ret
        local func_id = param.func_id
        -- print("")
    end
end

function FunctionToggleModule:getReady()
    return self._ready
end

return FunctionToggleModule