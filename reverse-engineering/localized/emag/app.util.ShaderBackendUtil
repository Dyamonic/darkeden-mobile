function ShaderBackendUtil:CreateProgramState(program)
    if not program then
        return nil
    end

    return ccbEngine.ProgramState:new(program)
end

--[[
    帧动画在手机上抖动bug
    纹理坐标从CPU传到GPU后，因为精度问题带来四舍五入导致了纹理坐标微小变化。

    通过修改精度可解决，具体的修改地方如下
    precision lowp float;
    改成
    precision highp float;

    varying mediump vec2 v_texCoord;
    改成
    varying highp vec2 v_texCoord;
]]

-- 默认 vert 
ShaderBackendUtil.PositionTextureColor_vert = "     \n\\\nattribute vec4 a_position;                          \n\\\nattribute vec2 a_texCoord;                          \n\\\nattribute vec4 a_color;                             \n\\\n                                                    \n\\\n// cocos4.0 parameter name changes CC_PMatrix -> u_MVPMatrix\n\\\nuniform mat4 u_MVPMatrix;                           \n\\\n                                                    \n\\\n#ifdef GL_ES                                        \n\\\nvarying lowp vec4 v_fragmentColor;                  \n\\\nvarying mediump vec2 v_texCoord;                    \n\\\n#else                                               \n\\\nvarying vec4 v_fragmentColor;                       \n\\\nvarying vec2 v_texCoord;                            \n\\\n#endif                                              \n\\\n                                                    \n\\\nvoid main()                                         \n\\\n{                                                   \n\\\n    gl_Position = u_MVPMatrix * a_position;         \n\\\n    v_fragmentColor = a_color;                      \n\\\n    v_texCoord = a_texCoord;                        \n\\\n}                                                   \n\\\n"

--[[ 
    根据纹理大小以及纹理alpha做遮罩
    shader 挖空 GLSL

    文件目录
    local vshPath = cc.FileUtils:getInstance():fullPathForFilename("shader/mb.vsh")
    local fshPath = cc.FileUtils:getInstance():fullPathForFilename("shader/mb.fsh")
]]
ShaderBackendUtil.TextureMask_fragment = "                                                          \n\\\n#ifdef GL_ES                                                                                 \n\\\nprecision mediump float;                                                                     \n\\\n#endif                                                                                       \n\\\n                                                                                             \n\\\nvarying vec4 v_fragmentColor;                                                                \n\\\nvarying vec2 v_texCoord;                                                                     \n\\\n                                                                                             \n\\\nuniform sampler2D u_mask_texture;                                                            \n\\\nuniform vec2 sp_size;                                                                        \n\\\nuniform vec2 mask_size;                                                                      \n\\\nuniform vec2 v_offset;                                                                       \n\\\nuniform float u_enable;                                                                        \n\\\n                                                                                             \n\\\n// cocos4.0 parameter name changes CC_Texture0 -> u_texture\n\\\nuniform sampler2D u_texture;                                                                 \n\\\n                                                                                             \n\\\nvoid main() {                                                                                \n\\\n    vec2 texCoord = v_texCoord;                                                              \n\\\n    vec2 pos = vec2(texCoord.x*sp_size.x, texCoord.y*sp_size.y);                             \n\\\n    vec2 offset = vec2(pos.x - v_offset.x, pos.y - v_offset.y);                              \n\\\n                                                                                             \n\\\n    if(offset.x <= mask_size.x && offset.x >= 0.0 && offset.y <= mask_size.y && offset.y >= 0.0) \n\\\n    {                                                                                        \n\\\n        vec2 finCoord = vec2(offset.x/mask_size.x, offset.y/mask_size.y);                    \n\\\n        vec4 mask_FragColor = texture2D(u_mask_texture, finCoord);                           \n\\\n                                                                                             \n\\\n        vec4 texColor = texture2D(u_texture, v_texCoord);                                    \n\\\n        gl_FragColor = v_fragmentColor*texColor;                                             \n\\\n        gl_FragColor.a = (1.0-mask_FragColor.a*u_enable) * texColor.a;                                \n\\\n    }else{                                                                                   \n\\\n        gl_FragColor = v_fragmentColor*texture2D(u_texture, v_texCoord);                     \n\\\n    }                                                                                        \n\\\n}                                                                                            \n\\\n"

--[[
    cyan变色
]]
ShaderBackendUtil.CyanEffect_vert = "                     \n\
    attribute vec4 a_position;                          \n\
    attribute vec2 a_texCoord;                          \n\
    attribute vec4 a_color;                             \n\
                                                        \n\
    #ifdef GL_ES                                        \n\
    varying lowp vec4 v_fragmentColor;                  \n\
    varying mediump vec2 v_texCoord;                    \n\
    #else                                               \n\
    varying vec4 v_fragmentColor;                       \n\
    varying vec2 v_texCoord;                            \n\
    #endif                                               \n\
    uniform mat4 u_MVPMatrix;                           \n\
                                                        \n\
    void main()                                         \n\
    {                                                   \n\
        gl_Position = u_MVPMatrix * a_position;          \n\
        v_fragmentColor = a_color;                      \n\
        v_texCoord = a_texCoord;                        \n\
    }                                                   \n\
"
ShaderBackendUtil.CyanEffect_frag = "                                     \n\
    #ifdef GL_ES                                                        \n\
    precision mediump float;                                            \n\
    #endif                                                              \n\
                                                                        \n\
    varying vec2 v_texCoord;                                            \n\
    uniform sampler2D u_texture;                                         \n\
    void main(void)                                                     \n\
    {                                                                   \n\
        vec4 col = texture2D(u_texture, v_texCoord);                  \n\
        float green = col.g;                                            \n\
        gl_FragColor = vec4(0, green, green, col.a);                    \n\
    }                                                                   \n\
"

return ShaderBackendUtil