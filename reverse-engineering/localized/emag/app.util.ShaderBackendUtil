--[[
    cocos2dx4.0
    shader: 
    示例:  
        local vsh = require('app.shaders.' .. vshStr)
        local frag = require('app.shaders.' .. fragStr)
        local program = ccb.Device:getInstance():newProgram(vsh, frag)
        local state = ccb.ProgramState:new(program)
        sprite:setProgramState(state)

    本Util用于缓存program
    state不需要缓存，同一个program可以给不用的精灵保持不同的渲染状态。
    因为使用频率较高，先不做retain和release
]]

local ShaderBackendUtil = {}

local ccbEngine = ccb
local ccEngine  = cc

-- 还原原shader 安卓使用时会空
ShaderBackendUtil.CC_ProgramPositionTextureColor    = ccbEngine.Program:getBuiltinProgram(ccEngine.backendProgramType.POSITION_TEXTURE_COLOR)
-- 置灰
ShaderBackendUtil.CC_ProgramGrayScale               = ccbEngine.Program:getBuiltinProgram(ccEngine.backendProgramType.GRAY_SCALE)
-- 默认还原shader key
ShaderBackendUtil.KEY_CC_Shader_ProgramPositionTextureColor= "KEY_CC_Shader_ProgramPositionTextureColor"
-- 默认还原shader key
ShaderBackendUtil.KEY_CC_Shader_ProgramGrayScale           = "KEY_CC_Shader_ProgramGrayScale"
-- 遮罩
ShaderBackendUtil.KEY_CC_Shader_ProgramTextureMask         = "KEY_CC_Shader_ProgramTextureMask"
-- 模型颜色调整
ShaderBackendUtil.KEY_CC_Shader_MulModelEffect             = "KEY_CC_Shader_MulModelEffect"
-- 模型颜色替换调整
ShaderBackendUtil.KEY_CC_Shader_ColorReplaceMulFS          = "KEY_CC_Shader_ColorReplaceMulFS"
-- Cyan变色
ShaderBackendUtil.KEY_CC_Shader_CyanEffect                 = "KEY_CC_Shader_CyanEffect"
-- 武器颜色调整shader
ShaderBackendUtil.KEY_CC_Shader_WeaponEffect               = "KEY_CC_Shader_WeaponEffect"
-- 装备物品变色及描边
ShaderBackendUtil.KEY_CC_Shader_BorderEffect               = "KEY_CC_Shader_BorderEffect"
-- 视野
ShaderBackendUtil.KEY_CC_Shader_LightEffect               = "KEY_CC_Shader_LightEffect"
-- 技能黑暗
ShaderBackendUtil.KEY_CC_Shader_DarknessEffect            = "KEY_CC_Shader_DarknessEffect"
-- 棺材擦除特效
ShaderBackendUtil.KEY_CC_Shader_CasketEffect            = "KEY_CC_Shader_CasketEffect"
-- Boss击杀特效
ShaderBackendUtil.KEY_CC_Shader_BossHitEffect            = "KEY_CC_Shader_BossHitEffect"


ShaderBackendUtil._customShaderProgramTable = nil

function ShaderBackendUtil:init()
    self._customShaderProgramTable = {}
end

function ShaderBackendUtil:clear()
    if self._customShaderProgramTable then
        
        self._customShaderProgramTable = nil
    end
end

function ShaderBackendUtil:loadCustomShader(vert, frag, key)
    local program = self._customShaderProgramTable[key]

    if program ~= nil then
        return program
    end

    if vert == nil or frag == nil then
        return nil
    end

    program = ccbEngine.Device:getInstance():newProgram(vert, frag)
    assert(program ~= nil, "create custom shader " .. key .. " faild.")

    self._customShaderProgramTable[key] = program

    return program
end

-- 置灰
function ShaderBackendUtil:makeNodeFromNormalToGray(node)
    if node == nil then
        return
    end

    -- 引擎内部已缓存
    local program = ShaderBackendUtil.CC_ProgramGrayScale
    if program == nil then
        program = self:loadCustomShader(ccEngine.positionTextureColor_vert, ccEngine.grayScale_frag, ShaderBackendUtil.KEY_CC_Shader_ProgramGrayScale)
        ShaderBackendUtil.CC_ProgramGrayScale = program
    end

    node:setProgramState(ShaderBackendUtil:CreateProgramState(program))

    local children = node:getChildren()
    if children == nil then
        return
    end

    local i = 0
    local len = node:getChildrenCount()
    for i = 1, len, 1 do
        self:makeNodeFromNormalToGray(tolua.cast(children[i], "cc.Node"))
    end
end

-- 还原默认shader
function ShaderBackendUtil:makeNodeFromGrayToNormal(node)
    if node == nil then
        return
    end

    local program = ShaderBackendUtil.CC_ProgramPositionTextureColor
    if program == nil then
        program = self:loadCustomShader(ccEngine.positionTextureColor_vert, ccEngine.positionTextureColor_frag, ShaderBackendUtil.KEY_CC_Shader_ProgramPositionTextureColor)
        ShaderBackendUtil.CC_ProgramPositionTextureColor = program
    end

    node:setProgramState(ShaderBackendUtil:CreateProgramState(program))

    local children = node:getChildren()
    if children == nil then
        return
    end

    local i = 0
    local len = node:getChildrenCount()
    for i = 1, len, 1 do
        self:makeNodeFromGrayToNormal(tolua.cast(children[i], "cc.Node"))
    end
end

function ShaderBackendUtil:makeNodeToNormal(node)
    ShaderBackendUtil:makeNodeFromGrayToNormal(node)
end

--[[
    node: 被遮罩的原图
    maskNode: 遮罩区域 
]]
function ShaderBackendUtil:makeNodeTextureMask(node, maskNode)
    if not node or not maskNode then
        return
    end

    local program = self:loadCustomShader(ShaderBackendUtil.PositionTextureColor_vert, ShaderBackendUtil.TextureMask_fragment, ShaderBackendUtil.KEY_CC_Shader_ProgramTextureMask)     
    local maskProgramState = lt.MaskGLProgramState.new(node, maskNode, program)

    node:setProgramState(maskProgramState:getProgramState())
    -- BlendFactor
    node:setBlendFunc({src=ccbEngine.BlendFactor.SRC_ALPHA, dst=ccbEngine.BlendFactor.ONE_MINUS_SRC_ALPHA}) -- 设置混合模式

    return maskProgramState
end

--[[
    node: 被遮罩的原图
    maskNode: 遮罩区域
    图集
]]
function ShaderBackendUtil:makeNodeSpriteFrameTextureMask(node, maskNode)
    if not node or not maskNode then
        return
    end

    local program = self:loadCustomShader(ShaderBackendUtil.PositionTextureColor_vert, lt.ShaderSpriteFrameTextureMask_fragment, ShaderBackendUtil.KEY_CC_Shader_ProgramTextureMask)     
    local maskProgramState = lt.MaskGLProgramState.new(node, maskNode, program)

    node:setProgramState(maskProgramState:getProgramState())
    -- BlendFactor
    node:setBlendFunc({src=ccbEngine.BlendFactor.SRC_ALPHA, dst=ccbEngine.BlendFactor.ONE_MINUS_SRC_ALPHA}) -- 设置混合模式

    return maskProgramState
end

