---@class CompAutoEquip -- 自动穿戴装备
local CompAutoEquip          = class("CompAutoEquip", lt.UIGButtonBase)

local NtfManager             = lt.NtfManager
local ScheduleUtil           = lt.ScheduleUtil
local Constant               = lt.Constant
local GameModule             = lt.GameModule
local ItemModule             = lt.ItemModule
local AutoFightManager       = lt.AutoFightManager
local TimeCounterManager     = lt.TimeCounterManager

CompAutoEquip.ChangeSkinConf = {
    ["Main"] = {
        ["img_di"] = "bg_zdcd_di",
    },
    ["Task"] = {
        ["img_icon"] = "bg_cwrw_djk",
    },
    ["CommonTL"] = {
        ["btn_close"] = { bg = "bg_beibao_anniu01", bgup = "bg_beibao_anniu02" },
        ["btn_equip"] = { bg = "btn_common_anniu_01" },
    }
}

function CompAutoEquip:ctor(view)
    CompAutoEquip.super.ctor(self)
    --UI
    self._lblLeftTime = nil
    self._lblItemName = nil
    self._btnClose = nil
    self._btnEquip = nil
    self._icon = nil
    self._sprite = nil
    --数据
    self._equipList = {}
    self._equipUnlove = {}
    self._isOpenRefresh = false
end

function CompAutoEquip:onClear()
    --UI
    self._lblLeftTime = nil
    self._lblItemName = nil
    self._btnClose = nil
    self._btnEquip = nil
    self._icon = nil
    if self._sprite then
        self._sprite:removeFromParent()
        self._sprite = nil
    end
    --数据
    self._equipList = nil
    self._equipUnlove = nil
end

function CompAutoEquip:onConstruct()
    self:initUI()
    self:startSkin()
end

function CompAutoEquip:onEnter()
    NtfManager:addNtfListener(
        NtfManager.NTF.NTF_EQUIP_AUTOUSE, handler(self, self.onAddItem), "CompAutoEquip:onAddItem")
    NtfManager:addNtfListener(
        NtfManager.NTF.NTF_EQUIP_AUTOUSE_RMV, handler(self, self.onRmvItem), "CompAutoEquip:onRmvItem")
    NtfManager:addNtfListener(
        NtfManager.NTF.NTF_EQUIP_AUTOUSE_RMV_EQUIP_LATER, handler(self, self.onRmvItemKind),
        "CompAutoEquip:onRmvItemKind")
    self._btnClose:addClickListener(handler(self, self.onCloseClick))
    self._btnEquip:addClickListener(handler(self, self.onEquipClick))

    TimeCounterManager:startTimeCounter(TimeCounterManager.TC.AUTO_EQUIP_UPDATE, {callback = function()
        self:refreshTimer()
    end })
end

function CompAutoEquip:onExit()
    self:closeAutoEquip()
    TimeCounterManager:stopTimeCounter(TimeCounterManager.TC.AUTO_EQUIP_UPDATE)

    self._equipUnlove = {}
    NtfManager:removeNtfListenerByTag("CompAutoEquip:onAddItem")
    NtfManager:removeNtfListenerByTag("CompAutoEquip:onRmvItem")
    NtfManager:removeNtfListenerByTag("CompAutoEquip:onRmvItemKind")

    self._btnClose:removeClickListener()
    self._btnEquip:removeClickListener()
end

function CompAutoEquip:initUI()
    self._lblLeftTime = self:getChild("lbl_leftTime")
    self._lblItemName = self:getChild("lbl_itemName")
    self._btnClose    = self:getChild("btn_close")
    self._btnEquip    = self:getChild("btn_equip")
    self._iconNode    = self:getChild("iconNode")
   
end

function CompAutoEquip:closeAutoEquip()
    self:setVisible(false)
    self._isOpenRefresh = false
end

function CompAutoEquip:refreshTimer()
    if not self._isOpenRefresh then return end
    local list = ItemModule:getAutoEquipList()
    if #list < 1 then
        self:closeAutoEquip()
        return 
    end
    local item = list[1]
    if not item then
        return
    end
    if not item.time then
        item.time = 5
        if self._sprite then
            self._sprite:removeFromParent()
            self._sprite = nil
        end

        local iconId = item:getIconId()
        local affixId = item:getFirstAffixId() or 0
        local affixLevel = item:getFirstAffixLevel() or 0
        local sprite = lt.CommonFunc.createEquipById(iconId,affixId,affixLevel)
        self._iconNode:displayObject():addChild(sprite)
        self._sprite = sprite
        self._lblItemName:setText(item:getName())

        self._sprite:setAnchorPoint(0.5, 0.5)
        local iconSize = self._sprite:getContentSize()
        local scaleW = 55 / iconSize.width
        local scaleH = 55 / iconSize.height
        local scale = scaleW
        if scale > scaleH then
            scale = scaleH
        end
        self._sprite:setScale(scale)
    end
    if item.time < 1 then
        self:onAutoUse()
        return
    end
    self:setVisible(true)
    local leftText = item.time .. "Automatically wear after seconds"
    self._lblLeftTime:setText(leftText)
    item.time = item.time - 1
end

function CompAutoEquip:onCloseClick()
    local list = ItemModule:getAutoEquipList()
    local item = list[1]
    if not item then
        return
    end
    table.insert(self._equipUnlove, item)
    ItemModule:delAutoEquipList(1)
    list = ItemModule:getAutoEquipList()
    if #list < 1 then
        self:closeAutoEquip()
        self:setVisible(false)
    end
end

function CompAutoEquip:onAutoUse()
    local list = ItemModule:getAutoEquipList()
    local item = list[1]
    if item then
        local itemKind = item:getMetaKind()
        local equipPosTable, equipPosNameKeyTable = self:GetEquipPos(itemKind) or {}

        local selectEquipPos = nil
        -- 默认选中没穿的位置
        for index, v in ipairs(equipPosTable) do
            local equipData = ItemModule:getEquipItemByPos(v)
            if not equipData then
                selectEquipPos = index or 1
                break
            end
        end
        if not selectEquipPos then
            ItemModule:delAutoEquipList(1)
            return
        end

        if #equipPosTable > 0 and equipPosTable[selectEquipPos] then
            -- 请求
            ItemModule:sendEquipItem(
                item:getObjId(), equipPosTable[selectEquipPos], Constant.ItemTypePos.Item_InPackage)
        end

        ItemModule:delAutoEquipList(1)
        list = ItemModule:getAutoEquipList()
        if #list < 1 then
            self:closeAutoEquip()
        end
    end
end

function CompAutoEquip:onEquipClick()
    self:onAutoUse()
end

function CompAutoEquip:GetEquipPos(itemKind)
    local kindNam = nil
    local equipKind = Constant.EquipKind
    for k, v in pairs(equipKind) do
        if v == itemKind then
            kindNam = k
            break
        end
    end
    local equipPosTable = {} --{1,1,1,1}
    local equipPosNameKeyTable = {}
    if kindNam then
        local curRace = GameModule:getHeroRace() -- Constant.RaceType.Slayer
        local equipPos = Constant[Constant.RaceToJobPanel[curRace] .. "EquipPos"] or {}
        local armsData = ItemModule:getEquipItemByPos(equipPos["Arms"])
        local function shouldIncludeEquip(k, v)
            if curRace == Constant.RaceType.Slayer then
                if k == "Shield" and kindNam == "Shield" then
                    return armsData and armsData:getMetaType() == Constant.ArmsEquipType.HandSword
                end
            end
            return string.find(k, kindNam) and k ~= "Arms_same"
        end

        for k, v in pairs(equipPos) do
            if shouldIncludeEquip(k, v) then
                table.insert(equipPosTable, v)
                equipPosNameKeyTable[v] = k
            end
        end
    end

    table.sort(equipPosTable, function(a, b) return a < b end)

    return equipPosTable, equipPosNameKeyTable
end

-- 添加到list里面
function CompAutoEquip:onAddItem(event)
    local editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.EQUIP_AUTOUSE)
    if editTable.switch == 0 then
        return
    end
    local param = event.param
    if not param then
        return
    end
    local item = param.item
    if not item then
        return
    end
    -- 是否可穿戴
    if not item:isWearable() then
        return
    end
    -- 叉掉之后同itemid 不加入列表
    for i, v in ipairs(self._equipUnlove or {}) do
        if item:getItemId() == v:getItemId() then
            return
        end
    end

    local itemKind = item:getMetaKind()
    local equipPosTable, equipPosNameKeyTable = self:GetEquipPos(itemKind) or {}

    local selectEquipPos = nil
    -- 默认选中没穿的位置
    for index, v in ipairs(equipPosTable) do
        local equipData = ItemModule:getEquipItemByPos(v)
        if not equipData then
            selectEquipPos = index or 1
            break
        end
    end

    -- 看来是有装备的
    if not selectEquipPos then
        return
    end

    -- 插入列表
    ItemModule:addAutoEquipList(item)
    local list = ItemModule:getAutoEquipList()

    if #list > 0 then
        self._isOpenRefresh = true
    else
        self:closeAutoEquip()
    end
end

function CompAutoEquip:onRmvItem(event)
    local param = event.param
    if not param then
        return
    end
    local item = param.itemInfo
    if not item then
        return
    end
    local list = ItemModule:getAutoEquipList()
    if #list == 0 then
        return
    end
    -- 自己背包装备 从列表去除
    for i, v in ipairs(list or {}) do
        if item:getObjId() == v:getObjId() then
            ItemModule:delAutoEquipList(i)
            return
        end
    end
end

function CompAutoEquip:onCheckBetter(myEquip, addEquip)
    if not myEquip or not addEquip then
        return false
    end
    -- 类型不一样滚
    if myEquip:getMetaType() ~= addEquip:getMetaType() then
        return false
    end

    -- 强化等级
    local myEquipLv = myEquip:getILevel()
    local addEquipLv = addEquip:getILevel()
    if addEquipLv > myEquipLv then
        return true
    end

    -- 词条
    local myQuality = myEquip:getQuality()
    local addQuality = addEquip:getQuality()
    if addQuality > myQuality then
        return true
    end
    return false
end

