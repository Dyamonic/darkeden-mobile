function CompAutoEquip:onCheckLower(delEquip, vEquip)
    return true
end

function CompAutoEquip:onRmvItemKind(event)
    local param = event.param
    if not param then
        return
    end
    local item = param.itemInfo
    if not item then
        return
    end
    local param = event.param
    local list = ItemModule:getAutoEquipList()
    if #list == 0 then
        return
    end
    -- 检验这个装备位是否都他们装备了  然后
    local itemKind = item:getMetaKind()
    local equipPosTable, equipPosNameKeyTable = self:GetEquipPos(itemKind) or {}

    local selectEquipPos = nil
    -- 默认选中没穿的位置
    for index, v in ipairs(equipPosTable) do
        local equipData = ItemModule:getEquipItemByPos(v)
        if not equipData then
            selectEquipPos = index or 1
            break
        end
    end

    -- 看来是有装备的
    if not selectEquipPos then
        -- 安全地删除自动装备列表中的相同种类项
        local toRemoveIndices = {}
        for i, v in ipairs(list) do
            if itemKind == v:getMetaKind() then --self:onCheckLower(equipdel, v)
                table.insert(toRemoveIndices, i)
            end
        end

        for i = #toRemoveIndices, 1, -1 do
            ItemModule:delAutoEquipList(toRemoveIndices[i])
        end
    end

    list = ItemModule:getAutoEquipList()
    if #list < 1 then
        self:closeAutoEquip()
    end
end

return CompAutoEquip
