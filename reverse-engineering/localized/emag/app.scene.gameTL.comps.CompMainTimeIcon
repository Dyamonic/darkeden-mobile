---@class CompMainTimeIcon 主界面-日月交替
local CompMainTimeIcon = class("CompMainTimeIcon", lt.UICompBase)

function CompMainTimeIcon:ctor()
    CompMainTimeIcon.super.ctor(self)
    self._timeProgress  = nil
    self._iconTimeType  = nil
    self._iconTimeType1  = nil
end

function CompMainTimeIcon:onConstruct()
    self._iconTimeType = self:getChild("icon1")
    self._iconTimeType1 = self:getChild("icon2")
end

function CompMainTimeIcon:onClear()
    self._timeProgress  = nil
    self._iconTimeType  = nil
    self._iconTimeType1  = nil
    CompMainTimeIcon.super.onClear(self)
end

function CompMainTimeIcon:onEnter()
    CompMainTimeIcon.super.onEnter(self)
    -- self:refreshTimer()
end

function CompMainTimeIcon:onExit()
    CompMainTimeIcon.super.onExit(self)
end

function CompMainTimeIcon:refreshTimer(time)
    local isDay,progress = self:checkTimePeriod(time)
    if isDay == nil then
        return
    end
    if progress and self._timeProgress ~= progress then
        if isDay then
            self._iconTimeType:setURL(string.format(_GURL.GetImageMain,"icon_zjm_sonbig"))
            self._iconTimeType1:setURL(string.format(_GURL.GetImageMain,"icon_zjm_moonbig"))
        else
            self._iconTimeType:setURL(string.format(_GURL.GetImageMain,"icon_zjm_moonbig"))
            self._iconTimeType1:setURL(string.format(_GURL.GetImageMain,"icon_zjm_sonbig"))
        end
        self._iconTimeType:setY(2-(progress/100)*22)
        self._timeProgress = progress
    end
end

function CompMainTimeIcon:checkTimePeriod(timeStr)
    -- 验证时间格式
    local pattern = "^(%d%d):(%d%d):(%d%d)$"
    local hour, min, sec = string.match(timeStr, pattern)
    if not hour then
        yflog:Info("Time format error, must be HH:MM:SS")
        return
    end
    -- 转换为小时数(带小数，便于比较)
    local totalHours = tonumber(hour) + tonumber(min)/60 + tonumber(sec)/3600
    -- 定义时间节点
    local timePoints = {
        dawnStart = 4,    -- 凌晨开始
        dawnEnd = 8,      -- 凌晨结束/白天开始
        dayEnd = 16,      -- 白天结束
        duskEnd = 20      -- 黄昏结束/夜晚开始
    }
    -- 判断时间段
    if totalHours < timePoints.dawnStart then
        -- 夜晚（00:00:00 - 04:00:00）
        return false,0
    elseif totalHours >= timePoints.dawnStart and totalHours < timePoints.dawnEnd then
        -- 凌晨过渡阶段（04:00:00 - 08:00:00），计算进度
        local duration = timePoints.dawnEnd - timePoints.dawnStart
        local progress = (totalHours - timePoints.dawnStart) / duration * 100
        return false,math.floor(progress)
    elseif totalHours >= timePoints.dawnEnd and totalHours < timePoints.dayEnd then
        return true,0
    elseif totalHours >= timePoints.dayEnd and totalHours < timePoints.duskEnd then
        -- 黄昏过渡阶段（16:00:00 - 20:00:00），计算进度
        local duration = timePoints.duskEnd - timePoints.dayEnd
        local progress = (totalHours - timePoints.dayEnd) / duration * 100
        return true,math.floor(progress)-- 保留整数
    else
        return false,0
    end
end

return CompMainTimeIcon