return "\n    #ifdef GL_ES\n    precision mediump float;\n    #endif\n    uniform vec2 resolution;\n    uniform vec2 mouse;\n    uniform float radius;\n    varying vec2 v_texCoord;\n\n    void mainImage( out vec4 fragColor, in vec2 fragCoord )\n    {\n// y coordinate flip\n        vec2 imouse = vec2(mouse.x, resolution.y - mouse.y);\n// Texture coordinates\n        vec2 uv = v_texCoord.xy ;\n// Texture sampling\n        vec4 tex = texture2D(CC_Texture0, uv);\n// Difference vector from fragment to mouse point\n        vec2 d = uv*resolution.xy -imouse.xy ;\n// Illumination radius\n        vec2 s = radius * resolution.xy;\n// Dot product ratio\n        float r = dot(d, d)/dot(s,s);\n        fragColor =  tex * (1.08 - r);\n    }\n    void main()\n    {\n        mainImage(gl_FragColor, gl_FragCoord.xy);\n    }\n"
