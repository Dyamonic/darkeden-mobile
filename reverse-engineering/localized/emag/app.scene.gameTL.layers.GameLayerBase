
local GameLayerBase = class("GameLayerBase", lt.BaseLayer)

GameLayerBase._gameLayerUI = nil
GameLayerBase._worldAgent = nil
local TimeTrigger = lt.TimeTrigger
local Constant = lt.Constant
local ScheduleUtil = lt.ScheduleUtil

function GameLayerBase:ctor()
    GameLayerBase.super.ctor(self)
    self._sharkDelayTime = 0
    lt.TimeCounterManager:init()
    lt.ScheduleManager:init()


    self._worldAgent = lt.WorldAgent.new(self)
end

function GameLayerBase:onClear()
    yflog:Info("GameLayer:onClear")
    self._sharkParams = nil
    self._triggerShark = nil
    self._runTLFPS = nil
    self._confirmOnLogin = nil

    -- 模块清理
    lt.ConnectManager:moduleTLClear()
    lt.ConnectManager:logicManagerClear()
    lt.TimeCounterManager:clear()
    lt.ScheduleManager:clear()

    self._worldAgent:onClear()

    self._gameLayerUI = nil
    self._worldAgent = nil

    lt.AgentManager:clear()
    lt.NtfManager:clear()
    lt.HandlerManager:clear()

    if DEBUG > 2 then
        local c1 = collectgarbage("count")
        collectgarbage("collect")
        local c2 = collectgarbage("count")
        yflog:Info("collection, Lua memory%s => %s", c1, c2)
        yflog:Info("getCachedTextureInfo:%s",cc.Director:getInstance():getTextureCache():getCachedTextureInfo())
    end
end

function GameLayerBase:onEnter()
    lt.LogUtil:debug("GameLayer:onEnter")

    lt.ConnectManager:setDelegate(self)

    local mouseListener = cc.EventListenerMouse:create()
    mouseListener:registerScriptHandler(handler(self, self.onMouseScroll), cc.Handler.EVENT_MOUSE_SCROLL)
    self:getEventDispatcher():addEventListenerWithSceneGraphPriority(mouseListener, self)

    -- if not self._scheculeHandler then
    --     self._scheculeHandler = ScheduleUtil:scheduleUpdateGlobal(handler(self, self.onUpdate))
    -- end
end

function GameLayerBase:onExit()
    lt.LogUtil:debug("GameLayer:onExit")

    lt.ConnectManager:clearDelegate(self)

    self:getEventDispatcher():removeEventListenersForTarget(self)

end

function GameLayerBase:setConfirmOnLogin(confirmOnLogin)
    self._confirmOnLogin = confirmOnLogin
end

function GameLayerBase:onUpdate(delta)
    if not self._confirmOnLogin then
        self:startGame()
    end
    
    lt.GameBoard:setDeltaTime(delta)
    local controlParam = self._gameLayerUI:getControlParam()
    lt.GameBoard:setControlParam(controlParam)

    lt.HandlerManager:onUpdate()
    self._worldAgent:onUpdate(delta)
    if self._gameLayerUI then
        self._gameLayerUI:onUpdate(delta)
    end

    lt.GameBoard:onUpdate(delta)

    lt.SocketManager:updateBreakInfo()
    self:updateSharkScreen(delta)
end

function GameLayerBase:startGame()
    lt.GameModule:sendConfirmOnLogin()
    self._confirmOnLogin = true
    self._gameLayerUI:startGame()
end

-- 鼠标事件
function GameLayerBase:onMouseScroll(event)
    -- self._worldAgent:onScroll(event:getScrollY())
end

-- Setter && Getter
function GameLayerBase:setGameLayerUI(gameLayerUI)
    self._gameLayerUI = gameLayerUI
end

function GameLayerBase:onEventSharkScreen(event)
    self._count = 1
    self._originX, self._originY = self:getPosition()
    
    self._sharkParams = event.param
    self._sharkDelayTime = self._sharkParams.eventDelay / 1000
    self._triggerShark = TimeTrigger.new(self._sharkDelayTime)
    self._runTLFPS = TimeTrigger.new(1 / Constant.FPS_TL)
end

function GameLayerBase:updateSharkScreen(delta)
    if tonumber(self._sharkDelayTime) > 0 then
        if self._runTLFPS:tick(delta) then
            local eventType = self._sharkParams.eventType
            local step = { 0, 1, 2, 2, 2, 1, 0, -2, -2, -2, -1, -1, 0 }
            if self._count  == 0 then
                self._count = 1
            end
            local sharkParamx = step[self._count] * self._sharkParams.parameter3
            local sharkParamy = (self._count%2)*3-2
            if eventType == Constant.SHARK_SCREEN_TYPE.EVENTID_METEOR_SHAKE then
                sharkParamy = (self._count%3-1)*3
            end
            sharkParamy = sharkParamy* self._sharkParams.parameter3
            self:setPosition(cc.p(self._originX + sharkParamx, self._originY + sharkParamy))
            self._count = self._count + 1
            self._count = self._count % 14
        end
        if self._triggerShark:tick(delta) then
            self:setPosition(self._originX, self._originY)
            self._sharkDelayTime = 0
        end
    end
end

return GameLayerBase
