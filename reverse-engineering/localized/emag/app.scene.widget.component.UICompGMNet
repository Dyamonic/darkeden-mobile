---@class UICompGMNet 网络发送界面
local UICompGMNet = class("UICompGMNet", lt.UICompBase)
local descriptor = require "descriptor"
local FieldDescriptor = descriptor.FieldDescriptor
local SocketApi = lt.SocketApi
local netcmd_pb = lt.netcmd_pb
local ClientCmdDefNew = lt.ClientCmdDefNew
local TEST_MODEL_STRING = "UICompGMNet_IS_TEST"

function UICompGMNet:ctor(param)
    UICompGMNet.super.ctor(self)
    self._sendCnt = 1
    local obj = fgui.UIPackage:createObjectFromURL(param.url)
    self:addChild(obj)

    self._setBtn = obj:getChild("setBtn")
    self._sendBtn = obj:getChild("sendBtn")
    self._modelBtn = obj:getChild("modelBtn")
    
    obj:getChild("tips"):setVisible(DEBUG > 0 and device.platform == "windows")

    self._testBtn = obj:getChild("testBtn")
    self._testBtn:setVisible(DEBUG > 0 and device.platform == "windows")
    
    local isTestMode = cc.UserDefault:getInstance():getBoolForKey(TEST_MODEL_STRING, false)
    self._testBtn:setSelected(isTestMode)
    self:openTestMode(isTestMode)

    self._inputSendNum = obj:getChild("inputSendNum")
    self._inputProtoContext = obj:getChild("tableList"):getChildAt(0):getChild("inputProtoContext")
    self._clientIdInput = obj:getChild("clientId")
end

function UICompGMNet:onClear()
    self._setBtn = nil
    self._sendBtn = nil
    self._modelBtn = nil
    self._testBtn = nil
    self._inputSendNum = nil
    self._inputProtoContext = nil
    self._clientIdInput = nil

    UICompGMNet.super.onClear(self)
end

function UICompGMNet:onEnter()
    self._setBtn:addClickListener(handler(self, self.btnSetNumClick))
    self._sendBtn:addClickListener(handler(self, self.btnSendClick))
    self._modelBtn:addClickListener(handler(self, self.btnModelClick))
    self._testBtn:addClickListener(handler(self, self.btnTestClick))
end

function UICompGMNet:onExit()
    self._setBtn:removeClickListener()
    self._sendBtn:removeClickListener()
    self._modelBtn:removeClickListener()
    self._testBtn:removeClickListener()
end

function UICompGMNet:btnSetNumClick(context)
    local num = self._inputSendNum:getText()
    if num == "0" or num == "" then
        local text = "The format of the number of sending times is incorrect, please re-enter it."
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP, {
            content = text
        })
        return
    end
    self._sendCnt = tonumber(num)
end

function UICompGMNet:btnSendClick(context)
    if not self:checkData() then
        return
    end
    if not self:checkProto() then
        return
    end
 
    local clientId = tonumber(self._clientIdInput:getText())

    local proto, isError = self:getSendProto(clientId)
    if isError then return end
    
    local function startReq(proto)
        if proto then
            SocketApi:sendToGs(clientId, proto)
        else
            SocketApi:sendToGs(clientId)
        end
    end

    for num = 1, self._sendCnt do
        startReq(proto)
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP, {
            content = "Sending protocol successfully"
        })
    end
end

local function createTemplate(newTable, fields)
    for _, field in pairs(fields) do
        if field.cpp_type <= FieldDescriptor.CPPTYPE_FLOAT then
            newTable[field.name] = 0
        elseif field.cpp_type == FieldDescriptor.CPPTYPE_BOOL then
            newTable[field.name] = true --没有使用此种类型的
        elseif field.cpp_type == FieldDescriptor.CPPTYPE_STRING then
            newTable[field.name] = ""
        elseif field.cpp_type == FieldDescriptor.MAX_CPPTYPE then
            newTable[field.name] = {
                [1] = {},
                -- PROTO_TAG = field.message_type.name
            }
            createTemplate(newTable[field.name][1], field.message_type.fields)
        end
    end
end

function UICompGMNet:btnModelClick(context)
    if not self:checkData(true) then
        return
    end
    if not self:checkProto() then
        return
    end

    local clientId = tonumber(self._clientIdInput:getText())
    local proto = self:getProtoDataByClientId(clientId)
    local text = "No template information"
    if proto then
        local metatable = getmetatable(proto)
        local newTable = {}
        createTemplate(newTable, metatable._descriptor.fields)
        text = lt.CommonUtil:tableToString(newTable, nil)
    end
    
    self._inputProtoContext:setText(text)
end

function UICompGMNet:btnTestClick(context)
    local sender = context:getSender()
    self:openTestMode(sender:isSelected())
end

function UICompGMNet:openTestMode(isOpen)
    cc.UserDefault:getInstance():setBoolForKey(TEST_MODEL_STRING, isOpen)
    cc.UserDefault:getInstance():flush()
    if isOpen then
        if DEBUG > 0 and device.platform == "windows" then
            local  function requireLocal()
                netcmd_pb = require("nettest.netcmd_pb")
                ClientCmdDefNew = require("nettest.ClientCmdDefNew")
            end
            local status, msg = xpcall(requireLocal, __G__TRACKBACK__)
            if not status then
                local text = "In test mode: the netcmd_pb.lua/ClientCmdDefNew.lua file was not found under win32/nettest/"
                lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP, {
                    content = text
                })
                netcmd_pb = lt.netcmd_pb
                ClientCmdDefNew = lt.ClientCmdDefNew
            end
        end
    else
        netcmd_pb = lt.netcmd_pb
        ClientCmdDefNew = lt.ClientCmdDefNew
    end
end


-----------------------------------data -----------------------

function UICompGMNet:getSendProto(clientId)

    local protoContext = self._inputProtoContext:getText()
    local proto = self:getProtoDataByClientId(clientId)
    local function copyProtoDataFromTemplate(src, dest, objType)
        for msgID, msg in pairs(src) do
            if msg == nil or msg == "" then
                local text = string.format("field:%svalue is empty, please fill in", msgID)
                lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP, {
                    content = text
                })
                return
            end
            if type(msg) == "table" then
                local objType = dest._message_descriptor and dest._message_descriptor.name or nil
                if objType then
                    -- copyProtoDataFromTemplate(msg, dest._message_descriptor, objType)
                    for protoKey, protoValue in pairs(msg) do
                        local info = netcmd_pb[objType]()
                        info[protoKey] = protoValue
                        table.insert(dest, info)
                    end
                else
                    copyProtoDataFromTemplate(msg, dest[msgID], objType)
                end
            else
                if not dest[msgID] then
                    local text = string.format("ERROR:not found msgID:[%s] from ClientID:[%s]", msgID, clientId)
                    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP, {
                        content = text
                    })
                    return text
                end
                dest[msgID] = msg
            end
        end
    end

    if proto then
        local loadedTable = assert(loadstring("return " .. protoContext))()
        local isError = copyProtoDataFromTemplate(loadedTable, proto)
        return proto, isError
    end
    return nil 
end

function UICompGMNet:checkData(igoreProto)
    local protoContext = self._inputProtoContext:getText()
    local clientId = tonumber(self._clientIdInput:getText())

    if self._sendCnt == "0" or self._sendCnt == "" then
        local text = "The format of the number of sending times is incorrect, please re-enter it."
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP, {
            content = text
        })
        return false
    end
    if not clientId then
        local text = "clientId is empty, please re-enter it"
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP, {
            content = text
        })
        return false
    end

    if not igoreProto and protoContext == "" then
        local text = "structure information is empty, please re-enter"
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP, {
            content = text
        })
        return false
    end
    return true
end

function UICompGMNet:checkProto()

    local clientId = tonumber(self._clientIdInput:getText())

    local hasClientId = false
    for _, proto in pairs(ClientCmdDefNew) do
        if clientId == proto.reqID then
            hasClientId = true
        end
    end

    if not hasClientId then
        local text = string.format("The entered clientId was not found:%s", clientId)
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP, {
            content = text
        })
        return false
    end

    local protoContext = self._inputProtoContext:getText()
    local loadedTable = loadstring("return " .. protoContext)
    if not loadedTable then
        local text = "The input structure information cannot be parsed, please check"
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP, {
            content = text
        })
        return false
    end
    return true
end

function UICompGMNet:getProtoDataByClientId(clientId)
    for _, proto in pairs(ClientCmdDefNew) do
        if tonumber(clientId) == proto.reqID then
            if proto.proto == "" then
                return nil
            else
                return netcmd_pb[proto.proto]()
            end
        end
    end
    yflog:Info("not found client id:%s", clientId)
    return nil
end

return UICompGMNet
