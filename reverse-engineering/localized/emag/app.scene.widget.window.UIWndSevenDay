---@ 七日活动
---@class UIWndSevenDay:UIWindowBase
local UIWndSevenDay  = class("UIWndSevenDay", lt.UIWindowBase)

local Constant       = lt.Constant
local NtfManager     = lt.NtfManager
local SevenDayModule = lt.SevenDayModule
local CacheManager   = lt.CacheManager
local TimeCounter    = lt.TimeCounter
local CommonFunc     = lt.CommonFunc

local FITER_TYPES    = {
    TASK   = 1, --任务
    REWARD = 2, --奖励
}

local btnTypeList    = {
    [FITER_TYPES.TASK] = { name = "btn_task", index = SevenDayModule.CONTROL_INDEX.TASK },     -- 任务
    [FITER_TYPES.REWARD] = { name = "btn_reward", index = SevenDayModule.CONTROL_INDEX.REWARD }, -- 奖励
}

function UIWndSevenDay:ctor(param)
    self:registerComponent("UICompSevenDayTaskCell", "UICompSevenDayRewardCell")
    UIWndSevenDay.super.ctor(self, param)

    self._menuIndex = nil
    self._boxBtns   = {}
    self._fiterBtns = {}
    self._iconBtns  = {}

    self._timer     = 0
end

function UIWndSevenDay:onShown()
    self:enableUpdateEvent(true)

    NtfManager:addNtfListener(NtfManager.NTF.NTF_SEVENDAY_LIST_CHANGE, handler(self, self.refreshList),
        "UIWndSevenDay:refreshList")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SEVENDAY_LIST_ALL_CHANGE, handler(self, self.refreshAllList),
        "UIWndSevenDay:refreshAllList")

    self._listMenu:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickMenu))
    for k, v in ipairs(self._fiterBtns) do
        self._fiterBtns[k]:addClickListener(handler(self, self.onBtnTypeClick))
    end
    for i = 1, #self._iconBtns do
        self._iconBtns[i]:addClickListener(handler(self, self.onBoxClick))
    end
    self._ctl:setSelectedIndex(SevenDayModule.CONTROL_INDEX.TASK)
end

function UIWndSevenDay:onHide()
    NtfManager:removeNtfListenerByTag("UIWndSevenDay:refreshList")
    NtfManager:removeNtfListenerByTag("UIWndSevenDay:refreshAllList")

    if self._listMenu then
        self._listMenu:removeChildrenToPool()
        self._listMenu:removeItemRenderer()
        self._listMenu:removeEventListener(fgui.UIEventType.ClickItem)
        self._listMenu = nil
    end

    if self._listTask then
        self._listTask:removeChildrenToPool()
        self._listTask:removeItemRenderer()
        self._listTask = nil
    end

    if self._listReward then
        self._listReward:removeChildrenToPool()
        self._listReward:removeItemRenderer()
        self._listReward = nil
    end
    for k, v in ipairs(self._fiterBtns) do
        self._fiterBtns[k]:removeClickListener()
    end
    for i = 1, #self._iconBtns do
        self._iconBtns[i]:removeClickListener()
    end
    self:clearTick()
    UIWndSevenDay.super.onHide(self)
end

function UIWndSevenDay:doShowAnimation()
    SevenDayModule:onQuerySevenDayReq()
end

function UIWndSevenDay:onClear()
    self._ctl        = nil
    self._btnTask    = nil
    self._btnReward  = nil
    self._bar        = nil
    self._lblNum     = nil
    self._boxBtns    = {}
    self._fiterBtns  = {}
    self._iconBtns   = {}

    if self._listMenu then
        self._listMenu:removeChildrenToPool()
        self._listMenu:removeItemRenderer()
        self._listMenu = nil
    end

    if self._listTask then
        self._listTask:removeChildrenToPool()
        self._listTask:removeItemRenderer()
        self._listTask = nil
    end

    if self._listReward then
        self._listReward:removeChildrenToPool()
        self._listReward:removeItemRenderer()
        self._listReward = nil
    end
    
    self:unregisterAllComponent()

    UIWndSevenDay.super.onClear(self)
end

function UIWndSevenDay:onInit()
    UIWndSevenDay.super.onInit(self, _GURL.SevenDaysPanel)
    self._listMenu   = self:getChild("list_menu")
    self._ctl        = self:getController("c1")
    self._listTask   = self:getChild("list_task")
    self._listReward = self:getChild("list_reward")
    self._btnTask    = self:getChild("btn_task")
    self._btnReward  = self:getChild("btn_reward")
    self._lblTime    = self:getChild("lbl_time")
    self._bar        = self:getChild("bar")
    self._lblNum     = self:getChild("prpTotal"):getChild("lbl_num")
    self._listMenu:setItemRenderer(handler(self, self.onMenuRender))
    self._listTask:setItemRenderer(handler(self, self.onTaskRender))
    self._listReward:setItemRenderer(handler(self, self.onRewardRender))

    for k, v in ipairs(btnTypeList) do
        local btn = self:getChild(v.name)
        btn.index = v.index
        self._fiterBtns[k] = btn
    end

    local boxes = SevenDayModule:getALTreasureMap()
    for i = 1, #boxes do
        if i >= 7 then
            break
        end
        local obj = self:getChild("pro" .. i)
        local icon = obj:getChild("icon")
        local lblNum = obj:getChild("lbl_num")
        local lblCount = obj:getChild("lbl_count")
        icon.idx = i
        self._iconBtns[i] = icon

        local alnum = boxes[i]:getALNum() or 0
        lblNum:setText(alnum)

        local reward = boxes[i]:getReward()
        if reward and reward[1] then
            local itemInfo = reward[1]
            local itemMeta = ""
            local iconPath = ""
            if itemInfo[1] == Constant.ItemType.ITEM_TYPE_PROP then
                iconPath = "prop"
                itemMeta = CacheManager:getItemMeta(itemInfo[2])
            elseif itemInfo[1] == Constant.ItemType.ITEM_TYPE_EQUIP then
                iconPath = "equip"
                itemMeta = CacheManager:queryEquipMeta(itemInfo[2])
            end
            local resUrl = string.format("ui://Item/%s_%s", iconPath, itemMeta:getIconId())
            icon:setURL(resUrl)
            lblCount:setText(itemInfo[3])
        end
        self._boxBtns[i] = obj
    end
end

function UIWndSevenDay:clearTick()
    self._tickHandler = nil
    self._lblTime:setVisible(false)
end

function UIWndSevenDay:refreshTimer()
    local time = SevenDayModule:getSevenDayCloseTime()
    if time <= 0 then
        self:clearTick()
        return
    end
    local serverTime = TimeCounter:serverTime()
    local lastTime = time - serverTime
    if lastTime <= 0 then
        self:clearTick()
        return
    end
    self._lblTime:setVisible(true)
    local day, hour, minite = CommonFunc:secondsToTime(lastTime)
    local strs = ""
    if day > 0 then
        strs = day .. GReadText.KEY_EQUIP_TIPS40 .. hour ..
            GReadText.KEY_EQUIP_TIPS41 --.. minite .. GReadText.KEY_EQUIP_TIPS42
    elseif hour > 0 then
        strs = hour .. GReadText.KEY_EQUIP_TIPS41 .. minite .. GReadText.KEY_EQUIP_TIPS42
    else
        if minite == 0 then minite = 1 end
        strs = minite .. GReadText.KEY_EQUIP_TIPS42
    end
    self._lblTime:setText("activity remaining:" .. strs)
end

function UIWndSevenDay:onUpdate(dt)
    self._timer = self._timer + dt
    if self._timer < 1 then
        return
    end

    self._timer = 0

    self:refreshTimer()
end

-- 刷新
function UIWndSevenDay:refreshList()
    self:initBoxes()
end

function UIWndSevenDay:initFiterBtn()
    local taskRed = SevenDayModule:getSevenDayTaskRedTips(self._menuIndex)
    self._fiterBtns[FITER_TYPES.TASK]:getChild("red"):setVisible(taskRed)
    local giftRed = SevenDayModule:getSevenDayRewardRedTips(self._menuIndex)
    self._fiterBtns[FITER_TYPES.REWARD]:getChild("red"):setVisible(giftRed) 
end

-- 第一次打开 全量刷新
function UIWndSevenDay:refreshAllList()
    local list = SevenDayModule:getSevenDayMap()
    if not self._menuIndex then
        local maxday = SevenDayModule:getSevenDayMaxDay()
        if maxday <= 0 then
            maxday = 1
        end
        self._menuIndex = maxday
    end

     if #list > 0 then
        self._listMenu:setNumItems(#list)
        local selectIndex = self._menuIndex - 1
        if selectIndex < #list and selectIndex >= 0 then
            self._listMenu:setSelectedIndex(selectIndex)
            self._listMenu:scrollToView(selectIndex)
        else
            self._listMenu:setSelectedIndex(0)
            self._listMenu:scrollToView(0)
        end
    end

    self:initListMenu()
    self:initBoxes()
    self:initFiterBtn()
    self:refreshTimer()
end

function UIWndSevenDay:onBoxClick(target)
    local idx = target:getSender().idx or 0
    local canOpen = false
    local curTotalAl, curProgress = SevenDayModule:getSevenDayAl()
    local boxes = SevenDayModule:getALTreasureMap()
    
    local alnum = boxes[idx]:getALNum() or 0
    if curProgress < alnum and alnum <= curTotalAl then
        canOpen = true
    end

    -- for i = 1, #boxes do
    --     local alnum = boxes[i]:getALNum() or 0
    --     if curProgress < alnum and alnum <= curTotalAl then
    --         canOpen = true
    --         break
    --     end
    -- end
    if canOpen then -- 领取
        SevenDayModule:onGetSevenDayAlrewardReq(curTotalAl)
    else
        --显示详细信息
        local boxes = SevenDayModule:getALTreasureMap()
        local meta = boxes[idx]
        local icon = self._boxBtns[idx]:getChild("icon")
        local itemSize = icon:getSize()
        local point = icon:localToGlobal({ x = itemSize.width / 2, y = itemSize.height / 2 })
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_TEXT_TIPS,
            {
                content = meta:getALDescribe(),
                pt = point,
                pivot = cc.p(0, 1),
            })
    end
end

function UIWndSevenDay:onBtnTypeClick(target)
    self:initListMenu()
end

function UIWndSevenDay:initListMenu()
    local selectedIndex = self._ctl:getSelectedIndex()
    if selectedIndex == SevenDayModule.CONTROL_INDEX.TASK then
        self._taskList = SevenDayModule:getSevenDayTaskMap(self._menuIndex)
        self._listTask:setNumItems(#self._taskList)
        if #self._taskList > 0 then
            self._listTask:scrollToView(0)
        end
    else
        self._rewardList = SevenDayModule:getSevenDayGiftMap(self._menuIndex)
        self._listReward:setNumItems(#self._rewardList)
        if #self._rewardList > 0 then
            self._listReward:scrollToView(0)
        end
    end
end

function UIWndSevenDay:initBoxes()
    local boxes = SevenDayModule:getALTreasureMap()
    local curTotalAl, curProgress = SevenDayModule:getSevenDayAl()
    for i = 1, #boxes do
        if not self._boxBtns[i] then
            break
        end
        local alnum = boxes[i]:getALNum() or 0
        local bg = self._boxBtns[i]:getChild("bg")
        local red = self._boxBtns[i]:getChild("red")
        -- 可以领取 给个提醒
        if curProgress < alnum and alnum <= curTotalAl then
            bg:setVisible(true)
            red:setVisible(true)
        else
            bg:setVisible(false)
            red:setVisible(false)
        end
        self._boxBtns[i]:setGrayed(curProgress >= alnum)
    end

    local totalAL = boxes[#boxes]:getALNum()
    self._bar:setMin(0)
    self._bar:setMax(totalAL)
    self._bar:setValue(curTotalAl)
    self._lblNum:setText(curTotalAl .. "/" .. totalAL)
end

function UIWndSevenDay:onClickMenu(context)
    local obj = context:getData()
    local index = obj.index
    local listTask = SevenDayModule:getSevenDayTaskMap(index)
    if #listTask == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = "is not turned on" })
    else
        self._menuIndex = index
        self:initListMenu()
        self:initFiterBtn()
    end
end

function UIWndSevenDay:onMenuRender(index, obj)
    local index = index + 1
    local list = SevenDayModule:getSevenDayMap()
    local data = list[index][1]
    if data then
        obj:getChild("title"):setText(data:getActivityDayTitle())
        local maxDay = SevenDayModule:getSevenDayMaxDay()
        obj:getChild("img_suo"):setVisible(maxDay < index)
        obj:getChild("img_black"):setVisible(maxDay < index)
        obj.index = index

        local redTask = SevenDayModule:getSevenDayTaskRedTips(index)
        local redReward = SevenDayModule:getSevenDayRewardRedTips(index)
        obj:getChild("img_red"):setVisible((redTask or redReward))
    end
end

function UIWndSevenDay:onTaskRender(index, obj)
    local index = index + 1
    local data = self._taskList[index]
    if data then
        obj:setInfo(data, self._menuIndex)
        obj.index = index
    end
end

function UIWndSevenDay:onRewardRender(index, obj)
    local index = index + 1
    local data = self._rewardList[index]
    if data then
        obj:setInfo(data, self._menuIndex)
        obj.index = index
    end
end

return UIWndSevenDay
