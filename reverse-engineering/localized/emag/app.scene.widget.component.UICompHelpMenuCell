---@class UICompHelpMenuCell 帮助菜单 cell
---
local UICompHelpMenuCell          = class("UICompHelpMenuCell", lt.UIGButtonBase)

local NtfManager                  = lt.NtfManager
local RaceSkinRes                 = lt.Constant.RaceSkinRes
local GameModule                  = lt.GameModule
local CommonUtil                  = lt.CommonUtil

UICompHelpMenuCell.ChangeSkinConf = {
    ["CommonTL"] = {
        ["btn_choose"] = "bg_zuduixitong_yeqiandi",
        ["loader_choose1"] = "icon_zuduixitong_shouqi",
        ["loader_choose2"] = "icon_zuduixitong_shouqi",
    },
}

function UICompHelpMenuCell:ctor()
    UICompHelpMenuCell.super.ctor(self)
    self._race = GameModule:getHeroData():getRace()
end

function UICompHelpMenuCell:onClear()
    self._helpList = nil
    self._isMark = nil
    UICompHelpMenuCell.super.onClear(self)
end

function UICompHelpMenuCell:onEnter()
    UICompHelpMenuCell.super.onEnter(self)
    self._icon:addClickListener(handler(self, self.onIconBtnClick))
    self._list:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickTargetItem))
end

function UICompHelpMenuCell:onExit()
    self._icon:removeClickListener()
    self._list:removeEventListener(fgui.UIEventType.ClickItem)
    UICompHelpMenuCell.super.onExit(self)
end

function UICompHelpMenuCell:onConstruct()
    self._list = self:getChild("list_choose")
    self._list:setItemRenderer(handler(self, self.renderTargetItem))
    self._icon = self:getChild("btn_choose")
    self:getController("c1"):setSelectedIndex(1)
end

function UICompHelpMenuCell:setObjInfo(helpList, index, isMark)
    require("app.offline.EnglishUI").fitHelpMenu(self)
    self._helpList = helpList
    self._index = index
    self._isMark = isMark
    self._list:setNumItems(#self._helpList)
    self._list:setSize(156, 54 * #self._helpList)
end

function UICompHelpMenuCell:renderTargetItem(index, obj)
    local index = index + 1
    local meta = self._helpList[index]
    if self._isMark then
        obj:getChild("title"):setText(meta:getName())
    else
        obj:getChild("title"):setText(meta:getTitle())
    end
    obj:getChild("n1"):setURL(string.format(_GURL.GetImageCommonTL, "bg_zuduixitong_yeqiandi02" ..
        RaceSkinRes[self._race]))
    require("app.offline.EnglishUI").fitHelpItem(obj)
    obj.index = index
end

function UICompHelpMenuCell:onClickTargetItem(context)
    local obj = context:getData()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_HELP_SELECT_SUBIDX, { subIdx = obj.index })
end

function UICompHelpMenuCell:onIconBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_HELP_SELECT_MAINIDX, { mainIdx = self._index })
end

--选中二级按钮回调
function UICompHelpMenuCell:selectSubIdx(subIdx)
    local childs = self._list:getChildren()
    for i = 1, #childs do
        local select = childs[i].index == subIdx
        childs[i]:getChild("n3"):setVisible(select)
        childs[i]:getChild("n0"):setVisible(not select)
        local color = (select) and CommonUtil:convertColorWithX("#ffffff") or
            CommonUtil:convertColorWithX("#7f7f7f")
        childs[i]:getChild("title"):setColor(color)
    end
end

return UICompHelpMenuCell
