-- 解析二进制数据流
function PacketParser:parseBytesPacket(msg, data)
    if msg ~= nil and not pcall(msg.ParseFromString,msg,data) then
        lt.LogUtil:debug("parseBytesPacket msg pcall false msgID, len ", msgID, bodyMsgLen)
        return nil
    end
    return msg
end

-- 添加并检查消息队列是否继续解析
function PacketParser:checkAddMsgParserQueue(msgID, data, wMsgType, bodyMsgLen)
    if self._msgParserQueue[msgID] == nil then
        self._msgParserQueue[msgID] = Queue.new()
    end

    self._msgParserQueue[msgID]:push({msgID = msgID, data = data, wMsgType = wMsgType, bodyMsgLen = bodyMsgLen})

    if self._msgParserQueue[msgID]:getSize() > 1 then
        return true
    end

    return false
end

-- 逐条清除消息解析队列
function PacketParser:clearMsgParserQueue(msgID)
    if self._msgParserQueue[msgID] == nil or self._msgParserQueue[msgID]:getSize() == 0 then 
        return
    end

    -- 清除第一条
    self._msgParserQueue[msgID]:pop()
    if self._msgParserQueue[msgID]:getSize() == 0 then
        self._msgParserQueue[msgID] = nil
        return
    end

    self:executeMsgParserQueue(msgID)
end

function PacketParser:executeMsgParserQueue(msgID)
    if self._msgParserQueue[msgID] == nil then
        return
    end

    local msg = self._msgParserQueue[msgID]:get()
    self:executeProcessPacketGS(msg.msgID, msg.data, msg.wMsgType, msg.bodyMsgLen)
end

-- 处理函数入口-- 约定：c++传过来的数据是  消息类型，body数据，body长度
function PacketParser:processPacket(msgID, bodyMsg, bodyMsgLen)
    -- 流量统计 bodyMsgLen 为字节长度
    self:statisticsBytes(bodyMsgLen)

    msgID = tonumber(msgID)
    if msgID == cliggproto.MessageID.GS_GG_CLI_MSG then

        local netdata = lt.NetData.new()
        netdata:prepare(bodyMsg, bodyMsgLen)
        local wMsgType = netdata:readByte()
        msgID = netdata:readWord()
        local msgLen = netdata:readWord()
        --  yflog:Info("gs msg:%s len:%s", msgID, msgLen)
        if msgLen+5 ~= bodyMsgLen then
            yflog:Info("gs msgLen:%s ~= bodyMsgLen:%s", msgLen+5, bodyMsgLen)
            return
        end

        local data = netdata:readBufs()


        -- 添加消息队列处理相同消息
        if self:checkAddMsgParserQueue(msgID, data, wMsgType, bodyMsgLen) then
            return
        end

        self:executeMsgParserQueue(msgID)
    else
        self:executeProcessPacketNormal(msgID, bodyMsg, bodyMsgLen)
    end
end

function PacketParser:executeProcessPacketGS(msgID, data, wMsgType, bodyMsgLen)
    --处理消息
    --如果是GS来的消息，是这样的头
    --UINT8   wMsgType;
	--UINT16  wMsgID;
    --UINT16  wMsgLen;
    local msg = nil
    if data ~= nil then
        if wMsgType == 0 then --默认采用protocol buffer
            if self._callback[msgID] then
                msg = self:parseBytesPacket(self._callback[msgID], data)
                if not msg then
                    yflog:Error("gs msg pcall false msgID:%s, len:%s ", msgID, bodyMsgLen)

                    -- 网络解包异常
                    local function bin2hex(s)
                        s=string.gsub(s,"(.)",function (x) return string.format("%02X ",string.byte(x)) end)
                        return s
                    end

                    local notice = (msgID or "nil") .. "_" .. (bodyMsgLen or "nil")

                    -- lt.SocketManager:disconnect()
                    -- lt.SocketManager:brokenNtf(notice)

                    lt.SocketManager:setBreakInfo(true, notice)

                    print("Network unpacking exception", notice, bin2hex(data))

                    self:clearMsgParserQueue(msgID)
                    return
                end
            end
        else
            --自己按字节流解析
            yflog:Info("parses msgID by byte stream by itself:%s", msgID)
        end
    end

    self:dispatchProto(msgID, msg)
end

function PacketParser:executeProcessPacketNormal(msgID, bodyMsg, bodyMsgLen)
    -- yflog:Info("msgID msg:%s len:%s", msgID, bodyMsgLen)
    local msg = nil
    msg = cliggproto:decode(msgID, bodyMsg, bodyMsgLen)
    if msg == nil then
        self:clearMsgParserQueue(msgID)
        return
    end

    self:dispatchProto(msgID, msg)
end

function PacketParser:dispatchProto(msgID, msg)
    -- 通用错误码提示
    if msg and msg.ret and msg.ret ~= 0 then
        local isBreak = lt.SocketManager:errorCodeAlertTips(msg, msgID)
        if isBreak then
            self:clearMsgParserQueue(msgID)
            return
        end
    end

    -- yflog:Info("dispatchProto %s",tostring(msgID))
    socketApi:dispatchProto(tostring(msgID), msg)
    self:clearMsgParserQueue(msgID)
end

-- 流量统计
function PacketParser:statisticsBytes(bytes)
    socketApi:statisticByte(bytes)
end

return PacketParser
