return "\n// Fragment Shader\nprecision mediump float;\n\nvarying vec2 v_texCoord;\nuniform sampler2D u_texture;\nuniform float u_wipeAmount; //Control the degree of erasure, ranging from 0 to 64\nuniform vec2 pixelSize;\nuniform vec4 select_color;\n\nvoid main() {\n    vec4 color = texture2D(u_texture, v_texCoord);\n    if (color.a < 0.1) {\n        return;\n    }\n    \n    // Calculate the distance from the center to the current fragment\n    float distanceFromCenter = abs(v_texCoord.x - 0.5) * 2.0; // Normalize to the range [0, 1]\n\n    // Calculate transparency based on distanceFromCenter and u_wipeAmount\n    float alpha = 1.0;\n    if (distanceFromCenter < (u_wipeAmount / 64.0)) {\n        discard;\n    }\n    \n    //stroke effect\n    float alphaSum = 0.0;\n    if (length(select_color) > 0.0 && length(pixelSize) > 0.0) {\n        for (float x = -1.0; x <= 1.0; x += 1.0) {\n            for (float y = -1.0; y <= 1.0; y += 1.0) {\n                if (x == 0.0 && y == 0.0) continue; \n                vec2 offset = vec2(x * pixelSize.x, y * pixelSize.y);\n                vec4 neighborColor = texture2D(u_texture, v_texCoord + offset);\n                alphaSum += neighborColor.a;\n            }\n        }\n        if (alphaSum > 6.0) {\n            gl_FragColor = vec4(color.rgb, color.a * alpha);\n        }else{\n            gl_FragColor = select_color;\n        }\n    }else{\ngl_FragColor = vec4(color.rgb, color.a * alpha); // Apply transparency\n    }\n}\n\n"