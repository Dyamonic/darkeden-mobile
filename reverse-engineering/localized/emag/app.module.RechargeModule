--解析协议中的数据
function RechargeModule:analysisNtfMapByData(datas)
    datas = datas or {}
    local tables = {}
    for i = 1, #datas do
        local key = datas[i].key or 0
        local value = datas[i].value or 0
        if key ~= 0 then
            tables[key] = value
        end
    end
    return tables
end

