function RechargeModule:getDayDayReChargeRed()
    for _, dailyInfo in ipairs(self._dailyRechargeArray) do
        if dailyInfo.state == Constant.DayDayChargeState.NODRAW then
            return true
        end
    end
    return false
end

function RechargeModule:getDayDayRechargeByDay(day)
    for _, dailyInfo in ipairs(self._dailyRechargeArray) do
        if dailyInfo.day == day then
            return dailyInfo.state
        end
    end
end

function RechargeModule:setDayDayRechargeInfo(day,state)
    for _, dailyInfo in ipairs(self._dailyRechargeArray) do
        if dailyInfo.day == day then
            dailyInfo.state = state
            return
        end
    end
end

function RechargeModule:onDailyRechargeNtf(event)
    local proto = event.param
    local ret = proto.ret
    self._rechargedDays  = proto.recharged_days or 0
    self._dailyRechargeArray = {}
    local dailyArray = proto.daily_list or {}
    for _, dailyInfo in ipairs(dailyArray) do
        table.insert(self._dailyRechargeArray, {day = dailyInfo.day, state = dailyInfo.state})
    end
    local startTime = proto.start_time or 0  -- 一定是当天的零点
    self._dailyRechargeCycleId = proto.cycleId or 0

    local cycleId = self:getDailyRechargeCycleId()
    -- yflog:Info("self._time = %s",startTime)
    -- yflog:Info("self.cycleId = %s",self._dailyRechargeCycleId)
    local rechargeCycle = CacheManager:getDailyRechargeCycleByCycleId(cycleId)
    if rechargeCycle then
        self._dailyRechargeEndTime = startTime + rechargeCycle:getLastingDays() * 24 * 60 * 60
    end

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_DAY_DAY_RECHARGE)
    local curIsOpen = self:dailyRechargeIsOpen()
    if curIsOpen ~= self._dailyRechargePerIsOpen then
        self._dailyRechargePerIsOpen = curIsOpen
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_CHARGE_ACTIVITY_LIST)
    end
end

function RechargeModule:getRechargedDays()
    return self._rechargedDays or 0
end

function RechargeModule:getDailyRechargeEndTime()
    return self._dailyRechargeEndTime or 0
end

function RechargeModule:getDailyRechargeCycleId()
    return self._dailyRechargeCycleId or 0
end

function RechargeModule:dailyRechargeIsOpen()
    local open, tips = FunctionToggleModule:checkEnterVisible(FunctionToggleModule.FunctionHelpId.DailyRecharge)
    if not open then
        return false
    end
    return self:getDailyRechargeEndTime() >= TimeCounter:serverTime()
end

function RechargeModule:getRewardStoreId()
    local cycleId = self:getDailyRechargeCycleId()
    local rechargeCycle = CacheManager:getDailyRechargeCycleByCycleId(cycleId)
    if rechargeCycle then
        return rechargeCycle:getRewardStoreId()
    end

    return 0
end

function RechargeModule:onGetDailyRechargeRewardResp(event)
    local proto = event.param
    local ret = proto.ret
    local day = proto.day
    if ret == 0 then
        self:setDayDayRechargeInfo(day,Constant.DayDayChargeState.DRAWED)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_DAY_DAY_RECHARGE)
    end
end
