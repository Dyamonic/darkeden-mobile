--商品购买回调
function RechargeModule:onShoppingMallBuy(event)
    lt.LogUtil:debugInfo("RechargeModule:onShoppingMallBuy")
    local proto = event.param
    local singleData = proto.singleShoppingInfo
    if not self._shoppingData then
        self._shoppingData = {}
    end
    local curNum = singleData.buyNum - (self._shoppingData[singleData.id] or 0)
    self._shoppingData[singleData.id] = singleData.buyNum
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_SHOPPING_MALL)
    local itemMeta = CacheManager:getShoppingMallMetaById(singleData.id)
    if itemMeta and curNum > 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_SHOPPING_TIPS15..itemMeta:getName().."x"..curNum})
    end
end

function RechargeModule:sendCreateOrder(rechargeId)
    if RechargeModule:showVoucher(rechargeId) then
        -- 代金券足够多不发订单请求（代金券充值除外）
        return
    end

    local open,tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.RechargePage) 
    if not open then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
        return
    end

    local msg = netcmd_pb.CS_CreateRechargeOrderReq()
    msg.id = rechargeId
    yflog:Info("RechargeModule:sendCreateOrder rechargeId: %s", msg.id)
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_CREATE_RECHARGE_ORDER_REQ), msg)
end

-- 代金券流程
function RechargeModule:showVoucher(rechargeId)
    local rechargeInfo = CacheManager:getRechargeInfoById(rechargeId)
    if rechargeInfo and rechargeInfo:getShopType() ~= Constant.RechargeShopType.VOUCHER then
        local heroData = lt.GameModule:getHeroData()
        local price = rechargeInfo:getPrice()
        local voucher = 0
        if heroData then
            voucher = heroData:getVoucher()
        end
        if voucher >= price then
            local tips = string.format(GReadText.KEY_SHOPPING_TIPS23,rechargeInfo:getName())
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_VOUCHER, {
                content = tips,
                rechargeId = rechargeId,
                confirmCallback = function()
                    RechargeModule:sendConsumeVoucher(rechargeId)
                end,
            })
            return true
        end
    end

    return false
end

function RechargeModule:onCreateOrderResp(event)
    local proto = event.param
    local ret = proto.ret
    yflog:Info("RechargeModule:onCreateOrderResp(): ret:%s id:%s orderId:%s productId:%s",ret, proto.rechargeId, proto.orderId, proto.productId)
    if ret == 0 then
        self:onRecharge(proto.orderId, proto.productId, proto.rechargeId)
    end
end

-- 调用充值
function RechargeModule:onRecharge(orderId, productId, rechargeId)
    -- 支付是否开启
    if (device.platform == "ios" or device.platform == "android") and cpp.SdkService:shared().payment then
        local rechargeInfo = CacheManager:getRechargeInfoById(rechargeId)
        if not rechargeInfo then
           yflog:Info("not found data from excel:%s", rechargeId) 
           return 
        end
        local price = rechargeInfo:getPrice()
        local productName = rechargeInfo:getName()
        local serverId = tostring(SocketManager:getServerId())
        local serverName = tostring(SocketManager:getServerName())


        local deviceId = "unknow"
        if cpp.GamePlatform and cpp.GamePlatform.getDeviceId then
            deviceId = cpp.GamePlatform:getDeviceId()
        end

        local roleId = GameModule:getHeroPlayerId()
        local uid = tostring(SocketManager:getUserId())
        local roleName = RoleModule:getCurRoleName()
        local roleLevel = GameModule:getHeroLevel()

        local channelId = ConfigLoader:getChannelId()
        if cpp.SdkService:shared().getChannelType then
            channelId = cpp.SdkService:shared():getChannelType()
        end

        local extraParam = {rechargeId, serverId, deviceId, roleId, uid, channelId}
        local extra = table.concat(extraParam, "_")

        yflog:Info("RechargeModule:onRecharge(): productName:%s, productId:%s, tostring(orderId):%s, price:%s, extra:%s, roleId:%s, roleName:%s, roleLevel:%s, serverId:%s, serverName:%s", productName, productId, tostring(orderId), tostring(price), extra, roleId, roleName, roleLevel, serverId, serverName)
        cpp.SdkService:shared():payment(productName, productId, tostring(orderId), tostring(price), extra, roleId, roleName, roleLevel, serverId, serverName)
    end
end

