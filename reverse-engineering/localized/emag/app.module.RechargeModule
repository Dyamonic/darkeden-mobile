local function mergeTables(tab1, tab2)
    for key, value in pairs(tab2) do
        tab1[key] = value
    end
    return tab1
end
--获取回调
function RechargeModule:onNtfGetDayGiftResp(event)
    local param = event.param
    local tabs = self:analysisNtfMapByData(param.dayGiftBagInfo.dayGiftMap)
    self._dayGiftBagInfo.dayGiftData = mergeTables(self._dayGiftBagInfo.dayGiftData,tabs)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CS_DAILY_GIFT_TIPS)
end

--刷新回调
function RechargeModule:onRefreshDayGiftData(event)
    local param = event.param
    local tabs = self:analysisNtfMapByData(param.dayGiftInfo.rechargeMap)
    self._dayGiftBagInfo = {}
    if not next(tabs) then
        self._dayGiftBagInfo.rechargeData = {}
        self._dayGiftBagInfo.dayGiftData = {}
    end
    self._dayGiftBagInfo.rechargeData = mergeTables(self._dayGiftBagInfo.rechargeData,tabs)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CS_DAILY_GIFT_TIPS)
end

