--获得商城meta数据
function RechargeModule:getShoppingMeta(shoppingType)
    local shopList = CacheManager:getShoppingMallMeta(shoppingType)
    return shopList
end

--获得商品数据
function RechargeModule:getItemListMeta(shoppingType, mainIdx, subIdx)
    local shopList = self:getShoppingMeta(shoppingType)
    if shopList and shopList[mainIdx] and shopList[mainIdx][subIdx] then
        local race = GameModule:getHeroRace()
        local list = {}
        for i = 1, #shopList[mainIdx][subIdx] do
            if shopList[mainIdx][subIdx][i]:getContem() == 0 or shopList[mainIdx][subIdx][i]:getContem() == race then
                table.insert(list, shopList[mainIdx][subIdx][i])
            end
        end
        table.sort(list, function(a, b)
            return a:getSort() < b:getSort()
        end)
        return list
    end
    return nil
end

--设置商城data数据
function RechargeModule:setShoppingData(shoppingData)
    self._shoppingData = {}
    for i = 1, #shoppingData do
        local data = shoppingData[i]
        self._shoppingData[data.id] = data.buyNum
    end
end

--获得商城data数据
function RechargeModule:getShoppingData(shoppingId)
    local shoppingData = self._shoppingData or {}
    return shoppingData[shoppingId] or 0
end

