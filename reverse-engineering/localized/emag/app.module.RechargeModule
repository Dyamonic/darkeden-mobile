end

--是否展示首充按钮
function RechargeModule:getFirstRechargeBtnIsOpen()
    if self._firstRechargeData == nil then
        return false
    end
    if self._firstRechargeData.reward_list == nil then
        return false
    end
    for i = 1,Constant.FIRSTRECHARGEGIFT.MAX do
        --三个礼包全部领取的二进制值为7
        if self._firstRechargeData.reward_list[i] and self._firstRechargeData.reward_list[i].reward_days ~= 7 then
            return true
        end
    end
    return false
end

