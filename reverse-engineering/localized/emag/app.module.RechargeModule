function RechargeModule:checkMonthCard(needTips)
    if self:getMonthCardEndTime() == 0 then
        if needTips then
            --没有月卡弹出购买月卡界面
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {
                type = 2,
                content = GReadText.KEY_MONTHCARD_TIPS5,
                confirmCallback = function()
                    local systemId = FunctionToggleModule.FunctionHelpId.MonthlyCard
                    GameModule:gotoSystemFunc(systemId)
                end,
            })
        end
        return false
    end
    return true
end

--月卡到期时间点
function RechargeModule:getMonthCardEndTime()
    local serverTime = TimeCounter:serverTime()
    local endTime = self:getCardEndTime()
    if serverTime < endTime then
        return endTime - serverTime
    end
    return 0
end

--是否领取了月卡奖励
function RechargeModule:getMonthCardRewardTime()
    local monthCardEnd = self:getMonthCardEndTime()
    if monthCardEnd <= 0 then
        return true
    end
    local activeReward = self:getActivityRewardTimes()
    --有可领取的激活奖励
    if activeReward > 0 then
        return false
    end
    local serverTime = TimeCounter:serverTime()
    local rewardTime = self:getCardRewardTime()
    if rewardTime == 0 or serverTime <= rewardTime then
        return true
    end
    return CommonFunc:isSameDay(serverTime, rewardTime)
end

