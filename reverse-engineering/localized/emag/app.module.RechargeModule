end

function RechargeModule:getDayRechargeData(giftId)
    if self._dayGiftBagInfo == nil then
        return
    end
    return self._dayGiftBagInfo.rechargeData[giftId]
end

function RechargeModule:getDayGiftRed()
    if self._dayGiftBagInfo == nil then
        return true
    end
    local heroData = GameModule:getHeroData()
    if not heroData then
        return true
    end
    local _list = RechargeModule:getActivityGiftMapByRace(heroData:getRace())
    for i = 1,#_list do
        local giftId = _list[i]:getGiftId()
        if (not RechargeModule:getDayGiftData(giftId)) then
            if _list[i]:getPrice() == 0 or RechargeModule:getDayRechargeData(giftId) then
                return true
            end
        end
    end
    return false
end

function RechargeModule:getDayGiftBagData()
    local open,tips = FunctionToggleModule:checkEnterVisible(FunctionToggleModule.FunctionHelpId.DailyGiftPackage) 
    if not open then
        return nil
    end
    return self._dayGiftBagInfo
end

-- 打开购买界面
function RechargeModule:openRechargeByItemId(itemId)
    if not itemId then
        return
    end

    local function findItem(typeEnum)
        local shopList = self:getShoppingMeta(typeEnum)
        if not shopList then return nil end
        for i, v in ipairs(shopList) do
            for ii, vv in ipairs(v or {}) do
                local list = self:getItemListMeta(typeEnum, i, ii)
                for iii, vvv in ipairs(list or {}) do
                    if vvv:getId() == itemId then
                        return typeEnum, i, ii ,iii
                    end
                end
            end
        end
        return nil
    end

    local filterOrder = {
        Constant.RECHARGE_TYPE.POINT,
        Constant.RECHARGE_TYPE.SCORE,
        Constant.RECHARGE_TYPE.GAME_CURRENCY
    }

    for _, itemType in ipairs(filterOrder) do
        local result, mainIdx, subIdx, index = findItem(itemType)
        if result then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {
                class = "UIWndRecharge",
                param = {type = itemType, mainIdx = mainIdx, subIdx = subIdx, index = index}
            })
            return
        end
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndRecharge"})
end

-- 快捷购买

function RechargeModule:autoBuyByShopId(shopId , num)
    local itemMeta = CacheManager:getShoppingMallMetaById(shopId)
    if not itemMeta then
        return
    end
    if not num or num <= 0 then
        return
    end
    local buyTimes = self:getShoppingData(itemMeta:getId()) or 0
    if itemMeta:getQuotaType() ~= Constant.QUOTA_TYPE.UNLIMITE and itemMeta:getQuotaNum() - buyTimes <= 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_SHOPPING_TIPS18})
        return
    end
    local cost = itemMeta:getCost()
    local total = cost[3] * num
    local heroData = GameModule:getHeroData()
    local have = 0 --itemMeta:getCostType() == Constant.SHOP_TYPE.POINT and heroData:getGold() or heroData:getBindGold()
    local costType =  itemMeta:getCostType()
    if costType == Constant.SHOP_TYPE.POINT then
        have = heroData:getGold()
    elseif costType == Constant.SHOP_TYPE.SCORE then
        have = heroData:getBindGold()
    elseif costType == Constant.SHOP_TYPE.JINBI then
        have = heroData:getJinBi()
    end
    if have < total then
        if itemMeta:getCostType() == Constant.SHOP_TYPE.POINT then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {type = 2, content = GReadText.KEY_SHOPPING_TIPS16, confirmCallback = function()
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_RECHARGE_GORO)
            end})
        elseif costType == Constant.SHOP_TYPE.JINBI then
             NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = "Insufficient gold coins"})
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_SHOPPING_TIPS17})
        end
    else
        self:sendShoppingMallBuy(itemMeta, num)
    end    
end

-- 商场 vip 增加限购次数
function RechargeModule:getVipQuotaNum(shopItemMeta)
    if not shopItemMeta then
        return 0
    end
    local vipEffectArr = shopItemMeta:getVIPEffectArr()
    if next(vipEffectArr) == nil then
        return 0
    end

    local vipLv = lt.VipModule:getCurVipLv()
    local count = vipEffectArr[vipLv] or 0
    
    return count
end
