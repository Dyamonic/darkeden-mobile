--当前开启首充项状态
function RechargeModule:getFirstRechargeBtnStates()
    if self._firstRechargeData == nil then
        return Constant.FIRSTRECHARGEGIFT.JUNIOR
    end
    for i = 1,Constant.FIRSTRECHARGEGIFT.MAX do
        if self._firstRechargeData.recharge_list[i].rechargeTime == 0 then
            return i - 1
        end
    end
    return Constant.FIRSTRECHARGEGIFT.LUXURY
end
--阶段礼包是否开启
function RechargeModule:getFirstRechargeInfoStates(key)
    if self._firstRechargeData == nil then
        return false
    end
    if self._firstRechargeData.recharge_list == nil then
        return false
    end
    if self._firstRechargeData.recharge_list[key] == nil then
        return false
    end
    return self._firstRechargeData.recharge_list[key].rechargeTime ~= 0
end

function RechargeModule:getFirstRechargeRewardStates(index,day)
    if self._firstRechargeData == nil then
        return Constant.GETREWARDSTATES.ERROR
    end
    if self:getFirstRechargeInfoStates(index) == false then
        return Constant.GETREWARDSTATES.ERROR
    end
    local rewardDays = self._firstRechargeData.reward_list[index].reward_days
    local _bit = (2 ^ day)--移位运算三个礼包根据bit索引指定bit位
    local overReward = (math.floor(rewardDays / _bit) % 2 == 1)
    if overReward then
        return Constant.GETREWARDSTATES.GETOVER
    end
    if not overReward then
        local buyDays = lt.TimeCounter:getEventServerOpenDay(self._firstRechargeData.recharge_list[index].rechargeTime)
        local nowDays = lt.TimeCounter:getServerOpenDay()
        if nowDays - buyDays >= day then
            return Constant.GETREWARDSTATES.CANREWARD
        else
            return Constant.GETREWARDSTATES.TIMEOUT
        end
    end
end
--首充页签红点
function RechargeModule:getFirstRechargeRewardStatesBtn(index)
    if self:getFirstRechargeInfoStates(index) == false then
        return false
    end
    for _day = 1,Constant.FIRSTRECHARGEGIFT.MAX do
        if self:getFirstRechargeRewardStates(index,_day-1) == Constant.GETREWARDSTATES.CANREWARD then
            return true,_day
        end
    end
    return false
end
--入口红点
function RechargeModule:getFirstRechargeEntryRed()
    for _index = 1,Constant.FIRSTRECHARGEGIFT.MAX do
        local red,_day = self:getFirstRechargeRewardStatesBtn(_index)
        if red then
            return red,_index,_day
        end
    end
    return false
end

--特惠礼包读表
function RechargeModule:getActivityGiftMapByType(_type)
	if self._activityGiftMapArr then
		return self._activityGiftMapArr
	end
	local giftTable = {}
	local allgift = CacheManager:getActivityGiftMap()
    for i = 1, #allgift do
		local meta = allgift[i]
        local m_type = meta:getActivityType()
        if _type == m_type then
			table.insert(giftTable,meta)
        end
    end
	self._activityGiftMapArr = giftTable
    return self._activityGiftMapArr
end

--每日特惠礼包
function RechargeModule:getActivityGiftMapByRace(race)
    if self.dailyGiftMapBayRace and self.dailyGiftMapBayRace[race] then
        return self.dailyGiftMapBayRace[race]
    end
    local giftTable = {}
	local allgift = self:getActivityGiftMapByType(Constant.ActivityType.DAILYGIFT)
    for i = 1, #allgift do
		local meta = allgift[i]
        local m_race = meta:getRace()
        if race == tonumber(m_race) then
			table.insert(giftTable,meta)
        end
    end
	self.dailyGiftMapBayRace = self.dailyGiftMapBayRace or {}
	self.dailyGiftMapBayRace[race] = giftTable
    return self.dailyGiftMapBayRace[race]
end

