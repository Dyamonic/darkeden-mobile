--获取首充礼包配置数据
function RechargeModule:getFirstRechargeGiftByRace(myRace)
	if self._firstRechargeTable then
		return self._firstRechargeTable
	end
	local giftTable = {}
	local firstRecharge = CacheManager:getFirstRechargeGiftMap()
    for i = 1, #firstRecharge do
		local meta = firstRecharge[i]
        local race = meta:getRace()
        if myRace == race then
            local tabs = {}
            tabs._id = meta:getId()%3
            if tabs._id == 0 then
                tabs._id = 3
            end
            giftTable[tabs._id] = meta
        end
    end
	self._firstRechargeTable = giftTable
    return self._firstRechargeTable
end

--首充礼包
function RechargeModule:onNtfFirstRechargerResp(event)
    local param = event.param
    self._firstRechargeData = self._firstRechargeData or {}
    self._firstRechargeData.recharge_list = param.recharge_list
    self._firstRechargeData.reward_list = param.reward_list
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CS_FIRST_RECHARGE_TIPS)
end
--首充数据变更购买成功
function RechargeModule:onRefreshFirstRechargeData(event)
    local param = event.param
    if self._firstRechargeData == nil then
        return
    end
    local function updateList(tab1List, tab2List)
        local idIndexMap = {}
        for i, v in ipairs(tab1List) do
            idIndexMap[v.packID] = i
        end
        for _, newV in ipairs(tab2List) do
            local index = idIndexMap[newV.packID]
            if index then
                tab1List[index] = newV
            else
                table.insert(tab1List, newV)
            end
        end
    end
    updateList(self._firstRechargeData.recharge_list,param.recharge_list)
    updateList(self._firstRechargeData.reward_list,param.reward_list)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CS_FIRST_RECHARGE_TIPS)
end

function RechargeModule:onNtfGetFirstRechargerResp(event)
    local param = event.param
    if param.ret == 0 then
        if self._firstRechargeData and self._firstRechargeData.reward_list then
            for k,_v in pairs(self._firstRechargeData.reward_list) do
                if _v.packID == param.packId then
                    --根据返回值进行二进制移位运算
                    _v.reward_days = _v.reward_days + (2 ^ (param.day - 1))
                    break
                end
            end
        end
    else

    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CS_FIRST_RECHARGE_TIPS)
end

