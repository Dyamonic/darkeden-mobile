local RechargeMeta = class("RechargeMeta")

function RechargeMeta:ctor(row)
	self:initWithRow(row)
end

function RechargeMeta:initWithRow(row)
    self._id             = row.Id
    self._productId      = row.ProductId
    self._name           = row.Name
    self._shopType       = row.ShopType
    -- self._funcId         = row.FuncId
    -- self._sequence       = row.Sequence
    -- self._firstId        = row.FirstId
    self._itemType       = row.ItemType
    self._itemId         = row.ItemId
    self._price          = row.Price
    -- self._first          = row.First
    self._productIdIOS   = row.ProductIdIOS
    -- self._giveReward     = row.GiveReward
    self._specialReward  = row.SpecialReward
    self._iconId         = row.IconId
    -- self._refundType     = row.RefundType
    self._refundItems    = row.RefundItems
    -- self._rechargeItemId = row.RechargeItemId

    if self._itemId ~= "" then
        local itemCountInfo = json.decode(self._itemId)
        if type(itemCountInfo) == "table" then
            self._itemCount = itemCountInfo[3] or 0
        else
            yflog:Info("Parsing the number of shopping mall tables err, check ID:%s", self._id)
        end
    end
end

-- AUTO GENERATED GETTERS START
-- 以下方法由脚本自动生成，请勿手动修改

function RechargeMeta:getId() return self._id end
function RechargeMeta:getProductId() return self._productId end
function RechargeMeta:getName() return self._name end
function RechargeMeta:getShopType() return self._shopType end
-- function RechargeMeta:getFuncId() return self._funcId end
-- function RechargeMeta:getSequence() return self._sequence end
-- function RechargeMeta:getFirstId() return self._firstId end
function RechargeMeta:getItemType() return self._itemType end
function RechargeMeta:getItemId() return self._itemId end
function RechargeMeta:getItemCount() return self._itemCount end
function RechargeMeta:getPrice() return self._price end
-- function RechargeMeta:getFirst() return self._first end
function RechargeMeta:getProductIdIOS() return self._productIdIOS end
-- function RechargeMeta:getGiveReward() return self._giveReward end
function RechargeMeta:getSpecialReward() return self._specialReward end
function RechargeMeta:getIconId() return self._iconId end
-- function RechargeMeta:getRefundType() return self._refundType end
function RechargeMeta:getRefundItems() return self._refundItems end
-- function RechargeMeta:getRechargeItemId() return self._rechargeItemId end

-- AUTO GENERATED GETTERS END
return RechargeMeta