                        --         if not route and skillId and skillId > 0 and self._heroAgent:isInSkillDistance(skillId, mTarget, nTarget) then
                        --             self._ignoreChaseCheck = true
                        --             self._ignoreChaseCheckElapse = 1
                        --             break
                        --         end
                        --     end

                        --     self._heroAgent:changeState(lt.HeroStateChase.new(self._heroAgent, targetAgentId))
                        --     return
                        -- end

                        break
