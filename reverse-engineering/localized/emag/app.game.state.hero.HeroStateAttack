
local HeroStateAttack = class("HeroStateAttack", lt.HeroStateBase)

local Constant = lt.Constant
local SkillEnum = lt.SkillEnum
local GameModule = lt.GameModule

HeroStateAttack._targetAgentId = nil

HeroStateAttack._isWaitting  = nil
HeroStateAttack._isAttacking = nil
HeroStateAttack._timeTrigger = nil
HeroStateAttack._timeTriggerPickUp = nil

HeroStateAttack._needStop = nil
HeroStateAttack._attackTimes = nil

function HeroStateAttack:ctor(heroAgent, targetAgentId)
    HeroStateAttack.super.ctor(self, heroAgent)

    self._targetAgentId = targetAgentId

    self._isWaitting = false
    self._isAttacking = false
    self._timeTrigger = lt.TimeTrigger.new(1, 1)
    self._timeTriggerPickUp = lt.TimeTrigger.new(1)

    self._needStop = false
    self._attackTimes = 0
end

function HeroStateAttack:onClear()
    self._timeTrigger = nil
    self._timeTriggerPickUp = nil
    HeroStateAttack.super.onClear(self)

end

function HeroStateAttack:onEnter()
    local attackElapse, attackInterval = self._heroAgent:getAttackCd()
    if attackElapse > 0 then
        -- 还处于之前的攻击状态
        self._isWaitting = true

        self._timeTrigger:reset(attackElapse)

        -- 动作
        self._heroAgent:playAction(Constant.ROLE_ACTION_ATTACK_IDLE)

        -- 设置方向
        local targetAgent = lt.AgentManager:getAgent(self._targetAgentId)
        if targetAgent then
            local mHero, nHero = self._heroAgent:getMNExactly()
            local mTarget, nTarget = targetAgent:getMNExactly()
            local direction = lt.MapUtil:getDirectionToPosition(mHero, nHero, mTarget, nTarget)
            self._heroAgent:setDirection(direction)
        end
    end

