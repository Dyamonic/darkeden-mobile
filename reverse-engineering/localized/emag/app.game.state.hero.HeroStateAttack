            --                 return
            --             end
            --         end
            --     end
            -- end

            -- tick
            if self._timeTrigger:tick(deltaTime) then
                -- 可以攻击了
                if self._attackWait then
                    self._timeTrigger:reset(self._attackWait)
                    self._heroAgent:playAction(Constant.ROLE_ACTION_ATTACK_IDLE)

                    self._attackWait = nil
                    return
                end

                -- 攻击
                if self:onUpdateAttack(deltaTime) then
                    -- 发生了状态变化
                    return
                end
            else
                local mHero, nHero = self._heroAgent:getMNExactly()
                local mTarget, nTarget = targetAgent:getMNExactly()

                local targetAgentId = self._heroAgent:getTargetAgentId()
                if not targetAgentId then
                    -- 没有目标
