                        local skillId, _ = self._heroAgent:getSkillId()
                        if skillId and skillId > 0 and self._heroAgent:isInSkillDistance(skillId, mTarget, nTarget) then
                            break
                        end


                        -- if lt.HangupManager:isHangup() and not lt.HangupManager:useAttack() then
