function HeroStateAttack:onUpdate()
    local deltaTime = lt.GameBoard:getDeltaTime()

    -- 追击检测
    if self._ignoreChaseCheck then
        self._ignoreChaseCheckElapse = self._ignoreChaseCheckElapse - deltaTime
        if self._ignoreChaseCheckElapse <= 0 then
            self._ignoreChaseCheck = false
        end
    end


    if self._isWaitting then
        if self._timeTrigger:tick(deltaTime) then
            self._isWaitting = false
        end

    else
        if self._isAttacking then
            if self._timeTrigger:tick(deltaTime) then
                self._isAttacking = false
                self._timeTrigger:reset(0.4)
                self._heroAgent:playAction(Constant.ROLE_ACTION_ATTACK_IDLE)
            end

        else
            local targetAgent = lt.AgentManager:getAgent(self._targetAgentId)
            -- 目标消失或死亡
            if not targetAgent then --or targetAgent:getIsOutOfGame() --尸体也要能放技能,灵魂吸收
                self._heroAgent:setTargetAgentId(nil) 
                self._heroAgent:setIsSkillIdUsed(true)

                self._heroAgent:changeState(lt.HeroStateIdle.new(self._heroAgent))

                return
            end

            -- 自己消失或死亡
            if self._heroAgent:getIsOutOfGame() then
                self._heroAgent:changeState(lt.HeroStateDie.new(self._heroAgent))
                return
            end

            -- 是否能攻击
            if not self._heroAgent:canAttack() or self._needStop then
                if self._routeMsg then
                    self._heroAgent:handleRouteMsg(self._routeMsg)
                    self._routeMsg = nil
                else
                    self._heroAgent:changeState(lt.HeroStateIdle.new(self._heroAgent))
                end
                return
            end

            local worldAgent = lt.AgentManager:getWorldAgent()
            local mHero, nHero = self._heroAgent:getMNExactly()
