                        -- local skillId, level = self._heroAgent:getSkillId()
                        -- if lt.SkillCdManager:IsNormalSkill(skillId) and not self._ignoreChaseCheck and lt.MapUtil:getMNDistance(mHero, nHero, mTarget, nTarget) > 1 then
                        --     -- 超出普攻范围 非战士目标无法到目标挂机技能能打到就不追击
                        --     if not self._heroAgent:isJobZS() then
