
local DbManager = {}

DbManager._db = nil
DbManager._errorXml = nil

DbManager._defuatDb = nil
DbManager._deviceDb = nil
DbManager._maskArray = nil

function DbManager:init()
    self:getDb()
    self:getDefaultDb()
    self:getMaskWord()
end

function DbManager:clear()
    self:clearDb()
end

function DbManager:clearDb()
    if self._db then
        self._db:close()
        self._db = nil
    end
    if self._defuatDb then
        self._defuatDb:close()
        self._defuatDb = nil
    end
    self._maskArray = nil
end

function DbManager:getDb()
    -- print("DbManager:getDb", debug.traceback("", 2))
    if self._db == nil then
        local confBin = "data/data.bin"
        local dbPath = cc.FileUtils:getInstance():fullPathForFilename(confBin)
        if device.platform == "windows" then
            if _G_BASE_SEARCH_PATHS then
                dbPath = _G_BASE_SEARCH_PATHS[1]

                if _G_STARTER_MODE and _G_GAME_INFO and _G_GAME_INFO.type then
                    dbPath = dbPath .. _G_GAME_INFO.type .. "/"
                end

                dbPath = dbPath .. "res/"..confBin
            end
        end


        local uroot = device.writablePath
        if device.platform == "mac" or device.platform == "windows" then
            uroot = uroot.."download/"
        end
        if _G_STARTER_MODE and _G_GAME_INFO and _G_GAME_INFO.type then
            uroot = uroot .. _G_GAME_INFO.type .. "/"
        end

        local dir = uroot.."res/data"
        local dataPath = dir.."/data-en-6eb2a27603f3.bin"
        print("dbPath:", dbPath)
        print("dataPath:", dataPath)

        if device.platform == "windows" or not io.exists(dataPath) then
            cc.FileUtils:getInstance():createDirectory(dir)
            local dataFromFile = cc.FileUtils:getInstance():getDataFromFile(dbPath)
            print("dataFromFile fileSize:", string.len(dataFromFile))
            print("dataFromFile:", dataFromFile)

            local file = io.open(dataPath,"w+b")
            file:write(dataFromFile)
            file:close()
        end

        self._db = lt.sqlite3.open(dataPath) -- lt.sqlite3.open_key(dbPath, lt.GameConfig.DB_KEY)
        if self._db == nil then
            lt.LogUtil:debug("db == nil")
        else
            lt.LogUtil:debug("db opened ok...")
        end
    end

    return self._db
end

function DbManager:getMaskWord()
    if self._maskArray == nil then
        self._maskArray = {}
        local db = self:getDb()
        for row in db:nrows("SELECT * FROM MaskWord;") do
            table.insert(self._maskArray, row.Word)
        end
    end
    return self._maskArray
end

function DbManager:execInDb(sql, name, callback)
    if callback == nil then callback = handler(self,self.createTableResult) end
    return self._db:exec(sql, callback, name)
end

-- 查询表中某个字段, 多行数据但仅只有一个配置的值
function DbManager:queryField(tbName, field)
    local db = self:getDb()
    for row in db:nrows(string.format("SELECT %s AS field FROM %s WHERE %s != '' and %s != '0' ;", field, tbName, field, field)) do
        return row.field
    end
end

function DbManager:tableIsExistDb(db, tableName, callback)
    if self._db == nil then return false end
    local sql = "select count(type) from sqlite_master where type='table' and name ='"..tableName.."'"
    local result = self:execInDb(sql, "tableIsExist", function (udata,cols,values,names)
        if udata == "tableIsExist" then
            if callback then callback(values[1] == "1") end
        end
    end)
end

function DbManager:deleteTableInDb(name)
    if self._db == nil then return false end
    local sql = "delete from "..name
    self._db:exec('BEGIN') 
    local result = self:execInDb(sql, "deleteTable")
    self._db:exec('COMMIT')
    -- lt.LogUtil:debugTable("delete: name = "..name .."  result = ".. result)
end

function DbManager:deleteTableDbInDb(key, name, tableName)
    if self._db == nil then return false end
    local sql = "delete from ".. tableName .. " WHERE ".. key .. "='".. name .."';"
    self._db:exec('BEGIN') 
    local result = self:execInDb(sql, "deleteTableDb")
    self._db:exec('COMMIT')
    -- lt.LogUtil:debugTable("delete: name = "..name.." tableName = "..tableName .. " key = "..key.."  result = ".. result)
end

-------------------------------本地储存数据以数据库形式----------------------------------------- 

function DbManager:getDefaultDb()
    if self._defuatDb == nil then
        local bn = "defaultdData.bin"
        if _G_GAME_INFO and _G_GAME_INFO.type then
            bn = "defaultdData" .. _G_GAME_INFO.type .. ".bin"
        end
        
        local uroot = device.writablePath
        local dir = uroot.."res/data"
        local dataPath = dir.."/"..bn
        local isExist = cc.FileUtils:getInstance():isFileExist(dataPath)
        if not isExist then
            cc.FileUtils:getInstance():createDirectory(dir)
        end
        print("dataPath "..dataPath)
        -- dataPath
        -- if device.platform == "windows" then 
        --     self._defuatDb = lt.sqlite3.open(dataPath)
        --    -- self._defuatDb = lt.sqlite3.open_v2(dataPath)

        -- else
        --     self._defuatDb = lt.sqlite3.open(dataPath)
        -- end
        -- 需要写入不能只读
        self._defuatDb = lt.sqlite3.open(dataPath)
       
        -- self._defuatDb:trace(function (ud, sql)
        --     lt.LogUtil:debugTable("sql = "..tostring(sql))
        -- end)
        
        if isExist then

        else
            self:initDB()
        end
    end
    return self._defuatDb
end

function DbManager:isDefuatDbOpen()
    if self._defuatDb == nil then return false end
    return self._defuatDb:isopen()
end

function DbManager:initDB()
    local sql=
    [=[
        CREATE TABLE user(userId,key,value);
        INSERT INTO user VALUES(1,"name1","ABC");
        CREATE TABLE device(key,value);
        INSERT INTO device VALUES("key1","value1");
    ]=]

    self:exec(sql)
end

function DbManager:insertDefaultDb(key, value)
    local ret = false
    for row in self._defuatDb:nrows("SELECT * FROM device;") do
        if row.key == key then
            ret = true
            break
        end
    end
    self:exec('BEGIN') 
    local sql = ""
    if not ret then
        sql = string.format("INSERT INTO device VALUES('%s', '%s')", key, value)
    else
        sql = string.format("UPDATE device SET value='%s' WHERE key='%s';", value, key)
    end
    self:exec(sql)
    self:exec('COMMIT')
end

function DbManager:getDefaultDbBykey(key)
    for row in self._defuatDb:nrows("SELECT * FROM device;") do
        if row.key == key then
            return row.value
        end
    end
    return ""
end

function DbManager:setUserId(userId)
    local ret = false
    local sql = "SELECT * FROM user WHERE userId='"..userId.."';"
    for row in self._defuatDb:nrows(sql) do
        ret = true
        break
    end
    if not ret then
        self._defuatDb:exec('BEGIN')
        sql = "INSERT INTO user('userId') VALUES('"..userId.."')"
        self:exec(sql)
        self._defuatDb:exec('COMMIT')
    end
end

function DbManager:insertUserDefaultDb(userId, key, value)
    if not userId then return nil end

    local ret = false
    local sql = "SELECT * FROM user WHERE userId='"..userId.."';"
    for row in self._defuatDb:nrows(sql) do
        if row[key] then
            ret = true
            break
        end
    end
    
    self:exec('BEGIN')
    if not ret then
        sql = string.format("alter table user add %s;",key)
        self:exec(sql)
    end
    if type(value) == "number" then
        sql = string.format("UPDATE user SET %s=%.2f WHERE userId='%s';", key, value, userId)
    else
        sql = "UPDATE user SET " .. key .. "='" .. value .. "' WHERE userId='".. userId .. "';"
    end
    self:exec(sql)
    self:exec('COMMIT')
end

function DbManager:getUserDefaultDbBykey(userId, key)
    if not userId then return nil end
    local sql = "SELECT * FROM user WHERE userId='"..userId.."';"
    for row in self._defuatDb:nrows(sql) do
        return row[key]
    end
end

function DbManager:getUserDefaultDb(userId)
    if not userId then return nil end
    local sql = "SELECT * FROM user WHERE userId='"..userId.."';"
    for row in self._defuatDb:nrows(sql) do
        return row
    end
end

function DbManager:createUserLogTable(tableName)
    local db_woool_sql = string.format("CREATE TABLE %s(key int primary key,value,flag int);", tableName)
    self:createTable(db_woool_sql, tableName)
end

function DbManager:getUserDbLogs(tableName)
    local isExist = nil
    self:tableIsExist(tableName, function (exist)
        isExist = exist
    end)

    if not isExist then
        self:createUserLogTable(tableName)
    end

    local logs = {}
    for row in self._defuatDb:nrows(string.format("SELECT * FROM %s", tableName)) do
        logs[#logs+1] = row
    end

    return logs
end

function DbManager:insertUserDbLog(tableName, key, value, flag)
    local isExist = nil
    self:tableIsExist(tableName, function (exist)
        isExist = exist
    end)

    if not isExist then
        self:createUserLogTable(tableName)
    end

    local showrow = function(udata,cols,values,names)
        assert(udata == 'db_woool_exite')
        print('[SQLite] %s rows %s', udata, table.concat(values, "-"))
        return 0
    end
    local ret = false
    for row in self._defuatDb:nrows(string.format("SELECT * FROM %s;", tableName)) do
        if row.key == key then
            ret = true
            break
        end
    end
    self._defuatDb:exec('BEGIN') 
    local db_woool_sql = ""
    if not ret then
        db_woool_sql = string.format("INSERT INTO %s VALUES('%d', '%s', '%d')", tableName, key, value, flag)
    else
        db_woool_sql = string.format("UPDATE %s SET value='%s', flag='%d' WHERE key='%d';", tableName, value, flag, key)
    end
    local ret = self._defuatDb:exec(db_woool_sql, showrow, 'db_woool_exite')
    self._defuatDb:exec('COMMIT')

    if ret ~= 0 then
        print(string.format("DbManager:insert error tableName = %s, key=%s, tableParas=%s", tableName, tostring(key), tostring(value)))
    end
end

function DbManager:uptUserDbLogFlag(tableName, flag)
    local showrow = function(udata,cols,values,names)
        assert(udata == 'db_woool_exite')
        print('[SQLite] %s rows %s', udata, table.concat(values, "-"))
        return 0
    end

    local count = 0
    for row in self._defuatDb:nrows(string.format("SELECT COUNT(*) AS count FROM %s;", tableName)) do
        count = row.count
        break
    end

    self._defuatDb:exec('BEGIN') 
    for i=1,count do
        local db_woool_sql = string.format("UPDATE %s SET flag=%d WHERE key='%s';", tableName, flag, i)
        local ret = self._defuatDb:exec(db_woool_sql, showrow, 'db_woool_exite')

        if ret ~= 0 then
            print(string.format("DbManager: update error tableName = %s, key =", tableName, tostring(i)))
            break
        end
    end
    self._defuatDb:exec('COMMIT')
end

function DbManager:tableIsExist(tableName, callback)
    if self._defuatDb == nil then return false end
    local sql = "select count(type) from sqlite_master where type='table' and name ='"..tableName.."'"
    local result = self:exec(sql, "tableIsExist", function (udata,cols,values,names)
        if udata == "tableIsExist" then
            if callback then callback(values[1] == "1") end
        end
    end)
end

function DbManager:deleteTable(name)
    if self._defuatDb == nil then return false end
    local sql = "delete from "..name
    self._defuatDb:exec('BEGIN') 
    local result = self:exec(sql, "deleteTable")
    self._defuatDb:exec('COMMIT')
    -- lt.LogUtil:debugTable("delete: name = "..name .."  result = ".. result)
end

function DbManager:deleteTableDb(key, name, tableName)
    if self._defuatDb == nil then return false end
    local sql = "delete from ".. tableName .. " WHERE ".. key .. "='".. name .."';"
    self._defuatDb:exec('BEGIN') 
    local result = self:exec(sql, "deleteTableDb")
    self._defuatDb:exec('COMMIT')
    -- lt.LogUtil:debugTable("delete: name = "..name.." tableName = "..tableName .. " key = "..key.."  result = ".. result)
end

function DbManager:createTable(sql, name)
    if self._defuatDb == nil then return false end
    local result = self:exec(sql, "createTable")
    -- lt.LogUtil:debugTable("createTable: name = "..name .."  result = ".. result)
end

function DbManager:createTableDb(keys, tables, names)
    local isExist = nil
    self:tableIsExist(names, function (exist)
        isExist = exist
    end)

    if isExist == true then
        self:deleteTable(names)
    end
    
    local types = {}
    local checkTypeFun = function (tbls)
        for index,value3 in ipairs(tbls) do
            if types[index] == nil and value3 ~= nil then
                types[index] = self:getTypeByValue(value3)
            elseif types[index] ~= self:getTypeByValue(value3) then
                types[index] = "BLOB"
            end
        end
    end
    for _,value in pairs(tables) do
        if type(value[1]) == "table" then
            for index,value2 in ipairs(value) do
                checkTypeFun(value2)
            end
        else
            checkTypeFun(value)
        end
    end

    local sql = "create table "..names.."("
    local totalKey = table.nums(keys)
    local _types = {}
    for index,key in ipairs(keys) do
        local typeName = types[index] or "TEXT"
        _types[index] = typeName
        sql = sql..key.." "..typeName
        if index == totalKey then
            sql = sql..")"
        else
            sql = sql .. ","
        end
    end
    self:createTable(sql, names)

    local insertSql = {}
    local insertTableFun = function (tbl)
        local insertName = ""
        local insertValue = ""
        local isFrist = true
        for index,key in ipairs(keys) do
            local _value = tbl[index]
            if _value ~= nil then
                if _types[index] == "TEXT" then
                    _value = "'"..tostring(_value).."'"
                end
                if isFrist == false then
                    insertName = insertName..","..key
                    insertValue = insertValue..","..tostring(_value)
                else
                    isFrist = false
                    insertName = insertName..key
                    insertValue = insertValue..tostring(_value)
                end
            end
        end
        table.insert(insertSql, "INSERT INTO "..names.." ("..insertName..")  VALUES ("..insertValue..")")
    end
    for _,value in pairs(tables) do
        if type(value[1]) == "table" then
            for index,value2 in ipairs(value) do
                insertTableFun(value2)
            end
        else
            insertTableFun(value)
        end
    end

    if #insertSql > 0 then
        self._defuatDb:exec('BEGIN') 
        for _,sql in ipairs(insertSql) do
            self._defuatDb:exec(sql)
        end
        self._defuatDb:exec('COMMIT') 
    end
end

function DbManager:insertTableByTable(tables, tableName, db, notCheck)
    local keys = {}
    local values = {}
    for k,v in pairs(tables) do
        keys[#keys + 1] = k
        values[#values + 1] = v or ""
    end

    self:insertTableDb(keys, values, tableName, db, notCheck)
end

function DbManager:insertTableLostKey(tables, tableName)
    for k,v in pairs(tables) do
        self:addNewKeyDb(k, tableName)
    end
end

function DbManager:addNewKeyDb(key, tableName)
    local ret = false
    local sql = "SELECT * FROM "..tableName..";"
    for row in self._db:nrows(sql) do
        if row[key] then
            ret = true
        end
        break
    end
    
    if not ret then
        self._db:exec('BEGIN')
        sql = string.format("alter table %s add %s;", tableName, key)
        self._db:exec(sql)
        self._db:exec('COMMIT')
    end 
end


function DbManager:insertTableDb(keys, values, tableName, db, notCheck)
    if keys[1] == nil or values[1] == nil then return end

    local types = {}
    local checkTypeFun = function (tbls)
        for index,value3 in ipairs(tbls) do
            if types[index] == nil and value3 ~= nil then
                types[index] = self:getTypeByValue(value3)
            elseif types[index] ~= self:getTypeByValue(value3) then
                types[index] = "BLOB"
            end
        end
    end
    checkTypeFun(values)

    local ret = false
    if not notCheck then
        local sql = "SELECT * FROM "..tableName.." WHERE "..keys[1].."='"..values[1].."';"
        if type(values[1]) == "number" then
            sql = string.format("SELECT * FROM %s WHERE %s=%d;",tableName, keys[1], values[1])
        end
        
        if db and db == "self" then
            for row in self._db:nrows(sql) do
                ret = true
                break
            end
        else
            for row in self._defuatDb:nrows(sql) do
                ret = true
                break
            end
        end
    end

    local insertSql = ""
    local insertTableFun = function (tbl)
        local insertName = ""
        local insertValue = ""
        local isFrist = true
        for index,key in ipairs(keys) do
            local _value = tbl[index]
            local typeName = types[index] or "TEXT"
            if _value ~= nil then
                if typeName == "TEXT" then
                    _value = "'"..tostring(_value).."'"
                end
                if ret then
                    if index > 1 then
                        if isFrist == false  then
                            insertValue = insertValue .. "," .. key .. "=" .. tostring(_value)
                        else
                            isFrist = false
                            insertValue = insertValue .. key .. "=" .. tostring(_value)
                        end
                    end
                else
                    if isFrist == false then
                        insertName = insertName..","..key
                        insertValue = insertValue..","..tostring(_value)
                    else
                        isFrist = false
                        insertName = insertName..key
                        insertValue = insertValue..tostring(_value)
                    end
                end
            end
        end
        if ret then
            insertSql = "UPDATE "..tableName.." SET "..insertValue.." WHERE "..keys[1].."='"..values[1].."';"
            if type(values[1]) == "number" then
                insertSql = "UPDATE "..tableName.." SET "..insertValue.." WHERE "..keys[1].."="..values[1]..";"
            end
        else
            insertSql =  "INSERT INTO "..tableName.." ("..insertName..")  VALUES ("..insertValue..")"
        end
    end
    insertTableFun(values)
    -- lt.LogUtil:debugTable("insertSql = "..tostring(insertSql))
    if insertSql ~= "" then
        if db and db == "self" then 
            self._db:exec('BEGIN')
            self._db:exec(insertSql)
            self._db:exec('COMMIT')
        else
            self._defuatDb:exec('BEGIN')
            self._defuatDb:exec(insertSql)
            self._defuatDb:exec('COMMIT')
        end 
    end
end

function DbManager:exec(sql, name, callback)
    if callback == nil then callback = handler(self,self.createTableResult) end
    return self._defuatDb:exec(sql, callback, name)
end

function DbManager:getTypeByValue(value)
    if type(value) == "boolean" then 
        return "INTEGER"
    end
    if type(value) == "number" then 
        return "REAL"
    end
    if type(value) == "nil" or type(value) == "string" or type(value) == "table" or type(value) == "function" or type(value) == "thread"  or type(value) == "userdata" then 
        return "TEXT"
    end
end

function DbManager:createTableResult()
    -- nothing call back
end

-------------------------------本地储存数据以数据库形式----------------------------------------- 

-- ----------------------------------解析xml---------------------------------------------

function DbManager:getErrorCodeXml()
        local myxml = cc.FileUtils:getInstance():getStringFromFile("data/errdefs.xml");

    local parsedXml = self:ParseXmlText(myxml)

    -- lt.LogUtil:debugTable(parsedXml,"parsedXml = ", 2)
end

function DbManager:ToXmlString(value)
    value = string.gsub(value, "&", "&amp;"); -- '&' -> "&amp;"
    value = string.gsub(value, "<", "&lt;"); -- '<' -> "&lt;"
    value = string.gsub(value, ">", "&gt;"); -- '>' -> "&gt;"
    value = string.gsub(value, "\"", "&quot;"); -- '"' -> "&quot;"
    value = string.gsub(value, "([^%w%&%;%p%\t% ])",
        function(c)
            return string.format("&#x%X;", string.byte(c))
        end);
    return value;
end

function DbManager:FromXmlString(value)
    value = string.gsub(value, "&#x([%x]+)%;",
        function(h)
            return string.char(tonumber(h, 16))
        end);
    value = string.gsub(value, "&#([0-9]+)%;",
        function(h)
            return string.char(tonumber(h, 10))
        end);
    value = string.gsub(value, "&quot;", "\"");
    value = string.gsub(value, "&apos;", "'");
    value = string.gsub(value, "&gt;", ">");
    value = string.gsub(value, "&lt;", "<");
    value = string.gsub(value, "&amp;", "&");
    return value;
end

function DbManager:ParseArgs(node, s)
    string.gsub(s, "(%w+)=([\"'])(.-)%2", function(w, _, a)
        node:addProperty(w, self:FromXmlString(a))
    end)
end

function DbManager:ParseXmlText(xmlText)
    local stack = {}
    local top = newNode()
    table.insert(stack, top)
    local ni, c, label, xarg, empty
    local i, j = 1, 1
    while true do
        ni, j, c, label, xarg, empty = string.find(xmlText, "<(%/?)([%w_:]+)(.-)(%/?)>", i)
        if not ni then break end
        local text = string.sub(xmlText, i, ni - 1);
        if not string.find(text, "^%s*$") then
            local lVal = (top:value() or "") .. self:FromXmlString(text)
            stack[#stack]:setValue(lVal)
        end
        if empty == "/" then -- empty element tag
            local lNode = newNode(label)
            self:ParseArgs(lNode, xarg)
            top:addChild(lNode)
        elseif c == "" then -- start tag
            local lNode = newNode(label)
            self:ParseArgs(lNode, xarg)
            table.insert(stack, lNode)
            top = lNode
        else -- end tag
            local toclose = table.remove(stack) -- remove top

            top = stack[#stack]
            if #stack < 1 then
                error("XmlParser: nothing to close with " .. label)
            end
            if toclose:name() ~= label then
                error("XmlParser: trying to close " .. toclose.name .. " with " .. label)
            end
            top:addChild(toclose)
        end
        i = j + 1
    end
    local text = string.sub(xmlText, i);
    if #stack > 1 then
        error("XmlParser: unclosed " .. stack[#stack]:name())
    end
    return top
end


function newNode(name)
    local node = {}
    node.___value = nil
    node.___name = name
    node.___children = {}
    node.___props = {}

    function node:value() return self.___value end
    function node:setValue(val) self.___value = val end
    function node:name() return self.___name end
    function node:setName(name) self.___name = name end
    function node:children() return self.___children end
    function node:numChildren() return #self.___children end

    function node:addChild(child)
        if self[child:name()] ~= nil then
            if type(self[child:name()].name) == "function" then
                local tempTable = {}
                table.insert(tempTable, self[child:name()])
                self[child:name()] = tempTable
            end
            table.insert(self[child:name()], child)
        else
            self[child:name()] = child
        end
        table.insert(self.___children, child)
    end

    function node:properties() return self.___props end

    function node:numProperties() return #self.___props end

    function node:addProperty(name, value)
        local lName = "@" .. name
        if self[lName] ~= nil then
            if type(self[lName]) == "string" then
                local tempTable = {}
                table.insert(tempTable, self[lName])
                self[lName] = tempTable
            end
            table.insert(self[lName], value)
        else
            self[lName] = value
        end
        table.insert(self.___props, { name = name, value = self[name] })
    end
    return node
end
-- ----------------------------------解析xml---------------------------------------------

return DbManager
