-- 刷新腰带显示状态
function UIWndInventory:refreshBeltInfo(isShow)
    local beltCom = self:getChild("beltCom")
    beltCom:refreshBeltInfo()
    beltCom:refreshCanSelect()
    
    if not beltCom.pos then
        local pos = beltCom:getPosition()
        beltCom.pos = pos
    end
    local pos = beltCom.pos
    if self._targetAction then
        self._targetAction:kill()
        self._targetAction = nil
    end
    if isShow then
        beltCom:setVisible(isShow)
        self._targetAction = fgui.GTween:to(cc.p(pos.x , pos.y), cc.p(pos.x , pos.y+75), 0.2):setTarget(beltCom, fgui.TweenPropType.Position):onComplete(function()
            self._targetAction = nil
            beltCom:setVisible(isShow)
            self:refreshBeltBtn(isShow)
            beltCom:setSortingOrder(100)
            self._touchLayer:setVisible(true)
            self._touchLayer:setSortingOrder(99)
        end)
    else
        beltCom:setSortingOrder(3)
        self._touchLayer:setVisible(false)
        self._touchLayer:setSortingOrder(1)
        self._targetAction = fgui.GTween:to(cc.p(pos.x , pos.y+75), cc.p(pos.x , pos.y), 0.2):setTarget(beltCom, fgui.TweenPropType.Position):onComplete(function()
            if self._targetAction then
                self._targetAction = nil
                beltCom:setVisible(isShow)
                self:refreshBeltBtn(isShow)
            end
        end)
    end
end

