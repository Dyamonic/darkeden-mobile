        editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.WINDOW_OPACITY)
        for i = 1, #childs do
            childs[i]:setBGVisible(not self._isBGOpacity)
            childs[i]:getChild("bgHide"):setAlpha(self._isBGOpacity and editTable.value/100 or 1)
            childs[i]:getChild("selectHide"):setAlpha(self._isBGOpacity and editTable.value/100 or 1)
        end
        local expand = self:getChild("defaultExpand")
        expand:setAlpha(self._isBGOpacity and editTable.value/100 or 1)
        for index = 1, ExpandCNT do
            expand = self:getChild("defaultExpand"..index)
            expand:setAlpha(self._isBGOpacity and editTable.value/100 or 1)
        end
    end
