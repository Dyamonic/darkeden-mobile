function UIWndInventory:ctor(param)
    UIWndInventory.super.ctor(self, param)
    self._isOnInit = false
    self._isBGOpacity = false 
    self._fiterBtns = {}
    self._targetAction = nil
    self._expandsBtns = {}

    self._tiledsTab = {}    --格子的行号分组
    self._itemsTab = {}     --道具的分组
    self._tiledMapSelectTab = {}    --格子的选中态分组

    self._gridWidth = 0              -- 网格宽度
    self._gridHeight = 0             -- 网格高度

    -- 背包物品存储
    self._bagItems = {}
end

function UIWndInventory:onInit()
    self:registerComponent("UICompExpandBagItem", "UICompInventoryTiled", "UICompItem", "CompQuickBar2")
    UIWndInventory.super.onInit(self, _GURL.Inventory)
    self._isOnInit = true
    self._remainTs = 0
    self:initUI()
    self:setBGOpacity()
    self:initGridData()
end

function UIWndInventory:onClear()
    self:clear()
    if self._targetAction then
        self._targetAction:kill()
        self._targetAction = nil
    end
    if self._gridManger then
        self._gridManger:clearTiledItem()
        self._gridManger = nil
    end
    self:unregisterAllComponent()
    if self._effectActorsArr then
        for i = #self._effectActorsArr,1,-1 do
            self._effectActorsArr[i]:onClear()
            table.remove(self._effectActorsArr,i)
        end
        self._effectActorsArr = nil
    end
    self._bg = nil
    self._btnOpacity = nil
    self._btnFiterAll = nil
    self._btnFiterItem = nil
    self._btnFiterEquip = nil
    self._btnSort = nil
    self._btnSell = nil
    self._touchLayer = nil
    self._gridList = nil
    self._controlTab = nil
    self._gridPanel = nil
    self._tiledPanel = nil
    self._itemsPanel = nil
    self._btnMoney = nil
    self._btnBelt = nil
    self._customCloseButton = nil
    self._defaultExpand = nil

    for i = 1, 3 do
        self["_equipSprite"..i] = nil
    end

    for i = 1, 3 do
        self["_contract"..i] = nil
    end

    for index, _ in pairs(self._tiledsTab) do
        self._tiledsTab[index] = nil
    end
    self._tiledsTab = nil

    for index, _ in pairs(self._bagItems) do
        self._bagItems[index] = nil
    end
    self._bagItems = nil


    for index, _ in ipairs(self._expandsBtns) do
        self._expandsBtns[index] = nil
    end
    self._expandsBtns = nil

    for index, _ in ipairs(self._itemsTab) do
        self._itemsTab[index] = nil
    end
    self._itemsTab = nil

    for index, _ in ipairs(self._itemDataTable) do
        self._itemDataTable[index] = nil
    end
    self._itemDataTable = nil
    
    self._preNode = nil
    self._btnSell = nil
    self._gridManger = nil

    UIWndInventory.super.onClear(self)
end

function UIWndInventory:onHide()
    TimeCounterManager:stopTimeCounter(TimeCounterManager.TC.BAG_SORT_UPDATE)
    self:removeUIListenerEvent()

    UIWndInventory.super.onHide(self)
end

function UIWndInventory:onShown()
    self:enableUpdateEvent(true)

    self:addUIListenerEvent()

    self._isMonthCard = RechargeModule:checkMonthCard()
    self:loadExpand()--扩展背包以及Manger相关

    local param = self:getParam().param or {}
    local defaultId = param.tabId or 1
    local defaultView, openViewParam= self._fiterBtns[defaultId], nil
    self._preNode =  nil
    self.openViewType = 0

    self:setBGOpacity()
    self:openFiterView(defaultView, openViewParam)

    self:refreshMoney()

    self:refreshBeltBtn()

    self:refreshSellInfo(false)

    local beltCom = self:getChild("beltCom")
    beltCom:setType(Constant.BeltBarType.Inventory)
    beltCom:insertObjectToFactory(self)

    --交换转职装备先请求数据
    if WndLockManager:getWndLockType() == Constant.WndLockType.Trade and WndLockManager:getTradeType() == Constant.FiterType.Exchange then
        StrengthenModule:sendAdvanceEquipInfo()
    end

    TimeCounterManager:startTimeCounter(TimeCounterManager.TC.BAG_SORT_UPDATE, {callback = function()
        if self._isStartCounterLimit then
            if self._btnSort then
                self._btnSort:setTitle(self._remainTs .. "s")
                self._remainTs = self._remainTs - 1
                if self._remainTs < 0 then
                    self._isStartCounterLimit = false
                    self._btnSort:setTitle(INVENTORY_TIPS.STRING_SORT)
                end
            end
        end
    end })

end

