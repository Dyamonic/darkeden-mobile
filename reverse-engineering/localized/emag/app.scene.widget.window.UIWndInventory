function UIWndInventory:checkGuide()
    local layerManager = display.getRunningScene():getLayerManager()

    --有tips不展示引导
    if layerManager:checkHasTips() then return end
    
    local wndLockType = WndLockManager:getWndLockType()
    --背包界面
    if wndLockType == nil then
        --了解宠物引导
        if GuideModule:checkCanGuide(Constant.GUIDE_ID.PETFIGHT4) then
            local childs = self._itemsPanel:getChildren()
            for i = 1, #childs do
                if childs[i]:getItemInfo():getItemId() == 901001 then
                    self:showTargetGuide(Constant.GUIDE_ID.PETFIGHT4, childs[i])
                    return
                end
            end
            --完成了解宠物的引导
            GuideModule:directEndGuide({Constant.GUIDE_ID.PETFIGHT4, Constant.GUIDE_ID.PETFIGHT5})
        end
    end
end

function UIWndInventory:showTargetGuide(guideId, child, list)
    local poslist = {} 
    if list and #list > 1 then
        for i = 2, #list do
            local x = list[i]:getPosition().x
            local y = self._gridPanel:getSize().height - list[i]:getPosition().y
            local pos = self._gridPanel:displayObject():convertToWorldSpace(cc.p(x, y))
            pos = cc.p(pos.x - list[i]:getSize().width/2, display.height - pos.y - list[i]:getSize().height/2)
            table.insert(poslist, pos)
        end
    end
    
    local x = child:getPosition().x
    local y = self._gridPanel:getSize().height - child:getPosition().y
    local pos = self._gridPanel:displayObject():convertToWorldSpace(cc.p(x, y))
    GuideModule:triggerGuide(guideId, child, cc.p(pos.x - child:getSize().width/2, display.height - pos.y - child:getSize().height/2), function()
        local sender = child
        if not self._preNode then
            self._preNode = sender
        else
            self._preNode:loadShader(false)
            self._preNode = sender
        end
        local itemInfo = child:getItemInfo()
        sender:loadShader(true)
        itemInfo:setNew(false)
        child:setNew()
        ItemModule:showTips(itemInfo)
    end, poslist)
end
