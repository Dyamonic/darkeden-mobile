function UIWndInventory:initUI()
    self._bg = self:getChild("bg")
    self._btnOpacity = self:getChild("btnOpacity")
    self._btnFiterAll = self:getChild("btnFiterAll")
    self._btnFiterItem = self:getChild("btnFiterItem")
    self._btnFiterEquip = self:getChild("btnFiterEquip")
    self._btnSort = self:getChild("btnSort")
    self._btnSell = self:getChild("btnSell")
    self:refreshSellInfo(false)
    self._touchLayer = self:getChild('touchLayer')
    

    self._touchLayer:setVisible(false)
    self._gridList = self:getChild("gridList")
    self._controlTab = self:getController("tabs")
    self._gridList:setScrollItemToViewEnabled(false)
    self._gridPanel = self._gridList:addItemFromPool()

    self._tiledPanel = fgui.GComponent:create()
    self._itemsPanel = fgui.GComponent:create()
    self._gridPanel:addChild(self._tiledPanel)
    self._gridPanel:addChild(self._itemsPanel)
    -- 获取GList的ScrollPane
    self._scrollPane = self._gridList:getScrollPane()
    self._listSize = self._gridList:getSize()
    -- 存钱按钮
    self._btnMoney = self:getChild("btnMoney")

    -- 腰带按钮
    self._btnBelt = self:getChild("btnBelt")

    -- 关闭按钮
    self._customCloseButton = self:getChild("closeButton1")

    -- 扩容背包
    for index = 1, ExpandCNT do 
        local expand = self:getChild("defaultExpand"..index)
        expand:setEmpty()
        expand:setFromWnd(self)
        expand:insertObjectToFactory(self)
        table.insert(self._expandsBtns, expand)
    end

    self._defaultExpand = self:getChild("defaultExpand")
    self._defaultExpand:setExpandInfo({addH = 8}, true)

    --初始化所有层级
    local childs = self:getChildren()
    for i = 1, #childs do
        childs[i]:setSortingOrder(i)
    end
end 

function UIWndInventory:showSpine(param)
    local callback = param.param.callback
    --添加特效
    if not self._preNode then
        return
    end
    if self._preNode.spine then
        self._preNode.spine:setVisible(true)
        self._preNode.spine:setAnimation(0, "JiYiShuiJing", false)
    else
        local spine = lt.SkeletonManager:createSkeletonEffectWithFile("CompactEffect01", "CompactEffect_skeleton")
        self._preNode:displayObject():addChild(spine)
        local size = self._preNode:getSize()
        spine:setPosition(size.width*2.5, size.height/2)
        spine:setAnimation(0, "JiYiShuiJing", false)
        self._preNode.spine = spine
    end
    
    if callback then
        self._preNode.spine:setCallback(function(event)
            if event.type == "complete" then
                callback()
                self._preNode.spine:setVisible(false)
            end
        end)
    end
end


function UIWndInventory:setBGOpacity()
    local editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.BAG_OPACITY)
    self._isBGOpacity = editTable.switch == 1
    if self._isBGOpacity then
        editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.WINDOW_OPACITY)
        self._bg:setAlpha(editTable.value/100)
    else
        self._bg:setAlpha(1)
    end
end

function UIWndInventory:clear()
    self._preNode = nil
    self._gridManger:clear()
    self:clearAllSelectTiled()
    self:resetTiledAndItem()
end

function UIWndInventory:openFiterView(sender, params)
    if self.openViewType == sender.fiterType then 
        return
    end
    self._preNode = nil
    local wndLockType = WndLockManager:getWndLockType()

    if wndLockType ~= Constant.WndLockType.Belt then
        self._gridList:scrollToView(0)
    end

    self.openViewType = sender.fiterType
    self._controlTab:setSelectedIndex(self.openViewType - 1);
    local isShow = self.openViewType == FITER_TYPES.ALL
    self._btnSort:setVisible(isShow)

    self:setBagItemVisible()
    self:refreshItemInfo()
end

function UIWndInventory:setBagItemVisible()
    self:clearAllSelectTiled()
end

function UIWndInventory:refreshItemInfo(event)
    self:clear()--清除所有物品
    local itemArray = {}
    if self.openViewType == FITER_TYPES.ALL then
        itemArray = ItemModule:getPackageArray()
    elseif self.openViewType == FITER_TYPES.EQUIPS then
        itemArray = ItemModule:getFiterEquipArr()
    elseif self.openViewType == FITER_TYPES.PROPS then
        itemArray = ItemModule:getFiterPropArr()
    end
    
    if not itemArray then return end
    yflog:Info("Backpack item quantity:%s",#itemArray)

    self:createItemDataTable(itemArray)
    self:onGildScrollChange()
    self:refreshContract()
    self:refreshUseNum()
    
    -- ItemModule:clearCreateHolyPotion()
    -- ItemModule:clearCreateHolyPotionDoctor()

    --透明度
    local childs = self._tiledPanel:getChildren()
    local editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.WINDOW_OPACITY)
    for i = 1, #childs do
        childs[i]:setBGVisible(not self._isBGOpacity)
        childs[i]:getChild("bgHide"):setAlpha(editTable.value/100)
        childs[i]:getChild("selectHide"):setAlpha(editTable.value/100)
    end

    local expand = self:getChild("defaultExpand")
    expand:setAlpha()
    for index = 1, ExpandCNT do
        expand = self:getChild("defaultExpand"..index)
        expand:setAlpha()
    end
end

function UIWndInventory:autoSortResponse(params)
    local ret = params.param.ret
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = SORT_CODE[tostring(ret)]})
end

