function UIWndInventory:btnMoneyClik()
    if WndLockManager:getWndLockType() ~= Constant.WndLockType.WareHouse then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = INVENTORY_TIPS.STRING_TIPS_2})
        return
    end
    local heroData = GameModule:getHeroData()
    local jinBi = heroData:getJinBi()
    if jinBi <= 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_INVENTORY_TIPS18})
        return
    end
    local bagMaxCoin = CacheManager:getValueById(Constant.Variable.StoreMaxCoin)
    local maxNum = math.min(jinBi, bagMaxCoin - heroData:getJinBiInStorage())
    local minNum = jinBi > 0 and 1 or 0
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_NUM, 
    {
        content = INVENTORY_TIPS.STRING_TIPS_1,
        confirmCallback = function(curNum)
            ItemModule:sendToDepot(0, 0, curNum or 0)
        end,
        param = {
            maxNum = maxNum,
            minNum = minNum,
        }
    })
end

function UIWndInventory:customCloseBtnClick()
    local wndLockType = WndLockManager:getWndLockType()
    if wndLockType == Constant.WndLockType.WareHouse or wndLockType == Constant.WndLockType.AutoRecycle then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndLock", close = true})
    elseif wndLockType == Constant.WndLockType.Belt then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndLock", close = true})
    elseif wndLockType == Constant.WndLockType.Trade or wndLockType == Constant.WndLockType.Repair then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndLock", close = true})
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTalkNpc", close = true})
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndInventory", close = true})
    end
end

