--刷新契约（客户端自己放契约位置）
function UIWndInventory:refreshContract()
    local width, height = self._gridManger:getGridWH()
    local curRace = GameModule:getHeroRace()
    local equipPos = Constant[Constant.RaceToJobPanel[curRace] .. "EquipPos"] or {}
    for i = 1, 3 do
        local equipData = self:getEquipItemInfoByPos(equipPos["Contract"..i])
        if equipData then
            if self["_contract"..i] == nil then
                self["_contract"..i] = self:createItemUI(equipData)
            end
            self["_contract"..i]:setItemInfo(equipData, self.openViewType, true)
            self._gridManger:addItemToGrid(self["_contract"..i], i, width)
            self:showTiledSelect(width, i)
            local cellPos = self._gridManger:getCenterXY(self["_contract"..i], width, i)
            self["_contract"..i]:setPosition(cellPos.x, cellPos.y)
        else
            if self["_equipSprite"..i] == nil then
                self["_equipSprite"..i] = display.newSprite("icon/itemTL/bg_beibao_ttjy.png")
                self._itemsPanel:displayObject():addChild(self["_equipSprite"..i])
                local cellPos = self._gridManger:getCenterXY2(width, i, 1, 1)
                self["_equipSprite"..i]:setPosition(cellPos.x, -cellPos.y)
            end
        end
        if self["_equipSprite"..i] then
            self["_equipSprite"..i]:setVisible(equipData == nil)
        end
        if self["_contract"..i] then
            self["_contract"..i]:setVisible(equipData ~= nil)
        end
    end
end

function UIWndInventory:getEquipItemInfoByPos(pos)
    local equipData = ItemModule:getEquipArray()
    for k,v in ipairs(equipData) do
        local equipPos = v:getPos()
        if pos == equipPos then
            return v
        end
    end
end

