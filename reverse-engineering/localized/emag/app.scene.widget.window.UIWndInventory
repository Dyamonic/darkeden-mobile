function UIWndInventory:addUIListenerEvent()
    self._touchLayer:addClickListener(handler(self, self.replaceTouchClick));
    self._btnSort:addClickListener(handler(self, self.btnSortClick));
    self._btnSell:addClickListener(handler(self, self.btnSellClick))
    self._btnBelt:addClickListener(handler(self, self.btnBeltClick))
    for fiterType = 1, table.nums(FITER_TYPES) do
        local obj = self:getChild("btnFiter"..fiterType);
        obj:addClickListener(handler(self, self.openFiterBtnClick));
        obj.fiterType = fiterType
        self._fiterBtns[fiterType] = obj
    end
    self._btnMoney:addClickListener(handler(self, self.btnMoneyClik))
    self._customCloseButton:addClickListener(handler(self, self.customCloseBtnClick))
    -- 监听滚动事件
    self._gridList:addEventListener(fgui.UIEventType.Scroll,handler(self, self.onGildScrollChange))
    -- self:onUpdate()
end

function UIWndInventory:removeUIListenerEvent()
    self._gridList:removeEventListener(fgui.UIEventType.Scroll)
    self._touchLayer:removeClickListener()
    self._btnSort:removeClickListener()
    self._btnSell:removeClickListener()
    self._btnBelt:removeClickListener()
    for _, fiterBtn in ipairs(self._fiterBtns) do
        fiterBtn:removeClickListener()
    end
    self._btnMoney:removeClickListener()
    self._customCloseButton:removeClickListener()
end

function UIWndInventory:openFiterBtnClick(context)
    local sender = context:getSender()
    for fiterType = 1, table.nums(FITER_TYPES) do
        if fiterType == sender.fiterType then
            self._fiterBtns[fiterType]:setSortingOrder(14)
        else
            self._fiterBtns[fiterType]:setSortingOrder(12)
        end
    end
    self:openFiterView(sender)
end

function UIWndInventory:btnSortClick()
