--道具物品变化
function UIWndInventory:changeItemFromBag(objId,item)
    if item then
        if self._itemDataTable then
            if not self._itemDataTable[item:getObjId()] then
                self:addItemDataForTable(item)
            end
            if item and self.scroolTopPosY and self.downPosY then
                if self._gridManger:isItemInWindow(item,self.scroolTopPosY,self.downPosY,self.openViewType == FITER_TYPES.ALL) then
                    self:showItemInPanle(item)
                end
            end
        end
    else
        if self._itemsTab and self._itemsTab[objId] then
            self._itemsTab[objId]:removeFromParent()
            self._gridManger:pushBagItem(self._itemsTab[objId])
            self._itemsTab[objId] = nil
        end
        if self._itemDataTable then
            self:removeItemDataForTable(objId)
        end
    end
end

function UIWndInventory:createItemEffect(item)
    --圣水制造（人祝）特效刷新
    local holyPotionArr = ItemModule:getCreateHolyPotion()
    for _,itemObjId in ipairs(holyPotionArr) do
        if itemObjId == item:getItemObjId() then
            local actionInfoMetas = CacheManager:getSkillEffectBySkillIdAndEName(lt.SkillEnum.SKILL_CREATE_HOLY_POTION, "result_magic_create_holy_water")
            local index = #self._effectActorsArr + 1
            self._effectActorsArr[index] = lt.UIEffectActor.new(actionInfoMetas[1], 1, nil)
            local pos = self._gridManger:getCenterXY(item)
            self._effectActorsArr[index]:setPosition(pos.x-15,-pos.y+15)
            item:getParent():displayObject():addChild(self._effectActorsArr[index])
            ItemModule:clearCreateHolyPotion(itemObjId)
        end
    end
    -- 圣水制造（人医）特效刷新
    local holyPotionDoctorArr = ItemModule:getCreateHolyPotionDoctor()
    for _,itemObjId in ipairs(holyPotionDoctorArr) do
        if itemObjId == item:getItemObjId() then
            local metas = CacheManager:getProcessMetas(lt.SkillEnum.SKILL_CREATE_HOLY_POTION_DOCTOR)
            if metas and metas[1] then
                local index = #self._effectActorsArr + 1
                self._effectActorsArr[index] = lt.UIEffectActor.new(metas[1], 1, nil)
                local pos = self._gridManger:getCenterXY(item)
                self._effectActorsArr[index]:setPosition(pos.x-15,-pos.y+15)
                item:getParent():displayObject():addChild(self._effectActorsArr[index])
                ItemModule:clearCreateHolyPotionDoctor(itemObjId)
            end
        end
    end
end

function UIWndInventory:onUpdate(dt)
    if self._effectActorsArr then
        for i = #self._effectActorsArr,1,-1 do
            if self._effectActorsArr[i]:getStopEffect() then
                self._effectActorsArr[i]:onClear()
                table.remove(self._effectActorsArr,i)
            else
                self._effectActorsArr[i]:onUpdate(dt)
            end
        end
    end
end

function UIWndInventory:onGildScrollChange(event)
    local posY = self._scrollPane:getPosY()
    local top = math.floor(posY/68)
    if self.scroolTopPosY ~= top then
        self.scroolTopPosY = math.floor(posY/68)
        self.downPosY = self.scroolTopPosY + 8
        -- print("当前的计划顶点是:",self.scroolTopPosY,"底点是：",self.downPosY," 窗口高度：",posY)
        self:updateTiledItem(self.scroolTopPosY,self.downPosY)
    end
end

function UIWndInventory:updateTiledItem(top,down)
    --归还视图外的格子
    for row, _ in pairs(self._tiledsTab) do
        if row < top or row > down then
            if self._tiledsTab[row] then
                for _, tiled in pairs(self._tiledsTab[row]) do
                    if not self._gridList:isChildInView(tiled) then
                        self._gridManger:pushTiledGird(tiled)
                    end
                    self._tiledsTab[row] = nil
                end
            end
        end
    end
    --从缓存中取格子
    for row = top, down do
        if self._tiledsTab[row] == nil then
            for col = 1, self._gridWidth do
                local tiled = self._gridManger:popTiledGird()
                self:showTiledInPanel(row,col,tiled)
            end
        end
    end
    --归还视图外的道具
    for key, item in pairs(self._itemsTab) do
        if not self._gridList:isChildInView(item) or self._itemDataTable[key] == nil then
            -- print("update清除道具：",item:getItemInfo():getItemMeta():getName(),key)
            item:removeFromParent()
            self._gridManger:pushBagItem(item)
            self._itemsTab[key] = nil
        end
    end
    if self._itemDataTable then
        for _, itemdata in pairs(self._itemDataTable) do
            if not self._itemsTab[itemdata:getObjId()] and self._gridManger:isItemInWindow(itemdata,top,down,self.openViewType == FITER_TYPES.ALL) then
                self:showItemInPanle(itemdata)
            end
        end
    end
end

-- 创建单个格子
function UIWndInventory:showTiledInPanel(row, col,tiled)
    -- 复用已存在的格子或创建新格子
    if not tiled:getParent() then 
        tiled:insertObjectToFactory(self)
        tiled:setPivot(0.5, 0.5, true)
        self._tiledPanel:addChild(tiled)
    end
    self._tiledsTab[row] = self._tiledsTab[row] or {}
    self._tiledsTab[row][col] = tiled
    -- 设置格子位置
    local centerPos = self._gridManger:getTiledCenterXY(col, row)
    tiled:setPosition(centerPos.x, centerPos.y)
    
    if (row == 1 or row == 2 or row == 3) and col == self._gridWidth then
        tiled:setSpecialShow(true)
    else
        tiled:setSpecialShow(false)
    end
    --占用态
    if self._tiledMapSelectTab[row] and self._tiledMapSelectTab[row][col] then
        tiled:setSelectedShow(true)
    else
        tiled:setSelectedShow(false)
    end
    tiled:setBGVisible(not self._isBGOpacity)
end

function UIWndInventory:showItemInPanle(itemInfo)
    -- itemInfo.show = true
    local gridSizeIndex = itemInfo:getItemMeta():getItemSize()
    local objId = itemInfo:getObjId()
    if not self._itemsTab[objId]  then
        local item = self._gridManger:popBagItem(gridSizeIndex)
        self._itemsTab[objId] = item
        if not item:getParent() then
            item:insertObjectToFactory(self)
            item:setPivot(0.5,0.5, true)
            item:setFromWnd(self)
            item:setSortingOrder(10)
            self._itemsPanel:addChild(item)
            -- print("添加道具：",itemInfo:getItemMeta():getName(),objId)
        end
    end
    self._itemsTab[objId]:setItemInfo(itemInfo, self.openViewType, true)
    self._itemsTab[objId]:setRed(not itemInfo:isWearable())
    local monthBound = itemInfo:getBound() == Constant.BOUND_TYPE.MONTH_BOUND
    self._itemsTab[objId]:setIsBind(monthBound and not self._isMonthCard)
    self._itemsTab[objId]:setVisible(true)
    self:pushItemInBag(self._itemsTab[objId])
    self:createItemEffect(self._itemsTab[objId])
end

---添加一个物品到格子上
function UIWndInventory:pushItemInBag(pItem)
    local gridX, gridY = pItem:getGridX(), pItem:getGridY()
    local gridWidth = pItem:getGridWidth()
    local gridHeight = pItem:getGridHeight()
    if not gridY then
        return
    end
    for i = gridY, gridY + gridHeight - 1 do
        for j = gridX, gridX + gridWidth - 1 do
            -- self._gridManger:addItemToGrid(true, i, j)
            -- print(string.format("添加道具：%s到格子：X%s,Y%s",pItem:getIgetObjId(),j,i))
            self:showTiledSelect(j, i) -- 需要延后处理（因为格子还没创完）
            local cellPos = self._gridManger:getCenterXY(pItem)
            pItem:setPosition(cellPos.x, cellPos.y)
        end
    end
end

function UIWndInventory:showTiledSelect(gridX, gridY)
    self._tiledMapSelectTab[gridY] = self._tiledMapSelectTab[gridY] or {}
    self._tiledMapSelectTab[gridY][gridX] = true
    if self._tiledsTab[gridY] and self._tiledsTab[gridY][gridX] then
        self._tiledsTab[gridY][gridX]:setSelectedShow(true)
    end
end

function UIWndInventory:hideTiledSelect(gridX, gridY)
    self._tiledMapSelectTab[gridY] = self._tiledMapSelectTab[gridY] or {}
    self._tiledMapSelectTab[gridY][gridX] = nil
    if self._tiledsTab[gridY] and self._tiledsTab[gridY][gridX] then
        self._tiledsTab[gridY][gridX]:setSelectedShow(false)
    end
end

function UIWndInventory:resetTiledAndItem()
    if self._tiledsTab then
        for row, _ in pairs(self._tiledsTab) do
            if self._tiledsTab[row] then
                for _, tiled in pairs(self._tiledsTab[row]) do
                    tiled:removeFromParent()
                    self._gridManger:pushTiledGird(tiled)
                    self._tiledsTab[row] = nil
                end
            end
        end
    end
    self._tiledsTab = {} --视图中的格子
    if self._itemsTab then
        for key, item in pairs(self._itemsTab) do
            -- print("清除道具：",item:getItemInfo():getItemMeta():getName(),key)
            item:removeFromParent()
            self._gridManger:pushBagItem(item)
            self._itemsTab[key] = nil
        end
    end
    self._itemsTab = {}         -- 视图中的道具
    self.scroolTopPosY = nil    -- 顶部格子坐标系高度
    self._tiledMapSelectTab = {}--存放格子选中态数据
end


return UIWndInventory