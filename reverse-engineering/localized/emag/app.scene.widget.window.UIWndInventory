function UIWndInventory:checkCanReplace(addH, replaceH)
    local canReplace = self._gridManger:checkExpandGrid(addH, replaceH, self._totalGrid)
    return canReplace
end

function UIWndInventory:refreshExpandData()
    local expandArr = ItemModule:getExpandArray()
    local oldTotalGrid = clone(self._totalGrid) or 0
    --计算总高度
    self._totalGrid = Constant.INVENTORY_DEFUAL_SIZE.HEIGHT

    for index, btn in ipairs(self._expandsBtns) do
        local expandItemInfo = expandArr[tonumber(index)]
        if expandItemInfo then
            local config = expandItemInfo:getItemMeta()
            local addH = config:getEffectParam()[1][2]
            self._totalGrid = self._totalGrid + addH
            btn:setExpandInfo({addH = addH, index = index, expandItemInfo = expandItemInfo})
        else
            btn:setEmpty()
        end
    end
    
    if oldTotalGrid > self._totalGrid then
        local oldY = self._scrollPane:getPosY()
        local panelHeight = self._gridPanel:getSize().height
        if oldY + self._listSize.height > panelHeight then
            self._scrollPane:setPosY(panelHeight - self._listSize.height)
        end
        self:onGildScrollChange()
    end
    oldTotalGrid = nil
end

function UIWndInventory:refreshUseNum()
    local used = self._gridManger:getUsedNum(1, 8)
    local total = 64

    local base = 8
    local expandArr = ItemModule:getExpandArray()
    for _, info in pairs(expandArr) do
        local addH = info:getItemMeta():getEffectParam()[1][2]
        local startPos = base + 1
        local endPos = startPos + addH - 1
        used = used + self._gridManger:getUsedNum(startPos, endPos)
        total  = total + 8 * addH
        base = endPos
    end
    self._defaultExpand:setNumText(used, total)
end

--创建当前页数据，初始背包使用量
function UIWndInventory:createItemDataTable(itemArray)
    self._itemDataTable = {}
    for _, itemInfo in ipairs(itemArray) do
        self:addItemDataForTable(itemInfo)
    end
end

--数据中添加一个道具刷新背包使用情况
function UIWndInventory:addItemDataForTable(iteminfo)
    local gridSizeIndex = iteminfo:getItemMeta():getItemSize()
    local size = lt.Constant.ITEMSIZE[gridSizeIndex or 1]
    local gridWidth = size.width
    local gridHeight = size.height
    local itemX,itemY = 0,0
    if self.openViewType == FITER_TYPES.ALL then
        itemX = iteminfo:getItemX() + 1
        itemY = iteminfo:getItemY() + 1
    else
        itemX,itemY = iteminfo:getFiterXY()
    end
    if not itemY then
        return
    end
    for i = itemY, itemY + gridHeight - 1 do
        for j = itemX, itemX + gridWidth - 1 do
            self._gridManger:addItemToGrid(true, i, j)
            self:showTiledSelect(j, i)
        end
    end
    self._itemDataTable[iteminfo:getObjId()] = iteminfo
end
--数据中删除一个道具刷新背包使用情况
function UIWndInventory:removeItemDataForTable(objId)
    if not objId then
        return
    end
    if not self._itemDataTable[objId] then
        return
    end
    local itemObj = self._itemDataTable[objId]
    local sizeIndex = itemObj:getItemMeta():getItemSize()
    local gridSize = Constant.ITEMSIZE[sizeIndex]
    local itemX,itemY = 0,0
    if self.openViewType == FITER_TYPES.ALL then
        itemX = itemObj:getItemX() + 1
        itemY = itemObj:getItemY() + 1
    else
        itemX,itemY = itemObj:getFiterXY()
    end
    for i = itemY, itemY + gridSize.height - 1 do
        for j = itemX, itemX + gridSize.width - 1 do
            self._gridManger:removeItemFromGrid(i, j)
            if not self._gridManger:getItemGird(i,j) then
                self:hideTiledSelect(j, i) --刷新选中态的记录和表现
            end
        end
    end
    self._itemDataTable[objId] = nil
end
