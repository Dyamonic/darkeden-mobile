--道具属性变更
function UIWndInventory:updateItemFromBagEvent(event)
    local param = event.param
    local typePos = param.typePos
    if typePos == Constant.ItemTypePos.Item_InPackage then
        local item = param.item
        local objId = param.objId
        self:changeItemFromBag(objId,item)
        self:refreshUseNum()
    end
