function UIWndInventory:changeSettings(params)
    local param = params.param
    if param.index == Constant.SETTINGS_TYPES.BAG_OPACITY or param.index == Constant.SETTINGS_TYPES.WINDOW_OPACITY then
        local editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.BAG_OPACITY)
