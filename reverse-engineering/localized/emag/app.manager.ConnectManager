
local ConnectManager = {}

function ConnectManager:init()
    lt.SocketApi:addProtoListener(lt.SocketApi._Event.SOCKET_CONNECT_SUCCESS, handler(self, self.onConnSuccess), "ConnectManager:onConnSuccess")
    lt.SocketApi:addProtoListener(lt.SocketApi._Event.SOCKET_CONNECT_FAIL, handler(self, self.onConnFail), "ConnectManager:onConnFail")
    lt.SocketApi:addProtoListener(lt.SocketApi._Event.Login_ACK, handler(self, self.onLoginGameAck), "ConnectManager:onLoginGameAck")
    lt.SocketApi:addProtoListener(lt.SocketApi._Event.KickOff_NTF, handler(self, self.onKickOff), "ConnectManager:onKickOff")

    lt.SocketApi:addProtoListener(lt.ServerCmdDef.BILLBOARD, handler(self, self.onBillBoardCmd), "ConnectManager:onBillBoardCmd")
    lt.SocketApi:addProtoListener(lt.ServerCmdDef.S_KICKOUT, handler(self, self.onKickout), "ConnectManager:onKickout")
end

function ConnectManager:clear()
    lt.SocketApi:removeProtoListenerByTag("ConnectManager:onConnSuccess")
    lt.SocketApi:removeProtoListenerByTag("ConnectManager:onConnFail")
    lt.SocketApi:removeProtoListenerByTag("ConnectManager:onLoginGameAck")
    lt.SocketApi:removeProtoListenerByTag("ConnectManager:onKickOff")
    lt.SocketApi:removeProtoListenerByTag("ConnectManager:onBillBoardCmd")
    lt.SocketApi:removeProtoListenerByTag("ConnectManager:onKickout")
end

