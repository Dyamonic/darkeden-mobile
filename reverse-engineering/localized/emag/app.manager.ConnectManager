-- 逻辑模块manager初始化，即需要依赖逻辑数据的manager
function ConnectManager:logicManagerInit()
    lt.AutoFightManager:init()
end

function ConnectManager:logicManagerClear()
    lt.AutoFightManager:clear()
end

function ConnectManager:setDelegate(delegate)
	self._delegate = delegate
end

function ConnectManager:clearDelegate(delegate)
	if self._delegate and delegate and self._delegate == delegate then
		self._delegate = nil
	end
end

function ConnectManager:onConnSuccess(event)
	if self._delegate and self._delegate.onConnSuccess then
		self._delegate:onConnSuccess(event)
		return
	end

    lt.LoginCmd:userLogin()
end

function ConnectManager:onConnFail(event)
	if self._delegate and self._delegate.onConnFail then
		self._delegate:onConnFail(event)
		return
	end
end

function ConnectManager:onLoginGameAck(event)
	if self._delegate and self._delegate.onLoginGameAck then
		self._delegate:onLoginGameAck(event)
		return
	end

	local data = event.param
    local errCode = nil
    if data then
        if data._byResult == lt.CliGgProto.PROTO_SUCCESS then
            lt.RoleModule:setPID(data._stReply._szPTID)
            lt.RoleModule:refreshData(data._stReply._stRoleList)

            -- 自动选人
            -- print("自动选人")
            if self._delegate.setConfirmOnLogin then
                local roleArray = lt.RoleModule:getRoleArray()
                if roleArray[lt.RoleModule:getSelect()] then
                    lt.SocketApi:selectRoleReq(roleArray[lt.RoleModule:getSelect()]:getName())
                    return
                end
            end
            return

        elseif data._byResult == lt.CliGgProto.PROTO_FAILURE then
            if data._stReply then
                errCode = data._stReply._wErrCode
            end
        end
    end

    -- 主动断开
    lt.SocketManager:disconnect()
    lt.SocketManager:brokenNtf()
    print("Login failed game reset")
end

function ConnectManager:onBillBoardCmd(event)
	if self._delegate and self._delegate.onBillBoardCmd then
		self._delegate:onBillBoardCmd(event)
		return
	end

	-- 已经在游戏场景中
	if self._delegate and self._delegate.setConfirmOnLogin then
		self._delegate:setConfirmOnLogin(false)

        -- local isHangup = lt.HangupManager:isHangup()

        self:moduleTLClear()
        self:moduleTLInit()

        -- 逻辑模块manager初始化，即需要依赖逻辑数据的manager
        self:logicManagerClear()
        self:logicManagerInit()

        -- 人物可能已死亡 需要复活
        -- lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_HERO_RELIVE)

        -- 关闭所有界面
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_CLOSE_ALL)

        -- 结束当前引导
        lt.GuideModule:endGuide()

        -- if isHangup then
        --     -- 防止掉线停止挂机
        --     lt.HangupManager:startHangup()
        -- end
	end
end

function ConnectManager:onKickOff(event)
    lt.SocketManager:willKick()

    if self._delegate and self._delegate.onKickOff then
        self._delegate:onKickOff(event)
        return
    end
end

function ConnectManager:onKickout(event)
    lt.SocketManager:willKick()
end

return ConnectManager
