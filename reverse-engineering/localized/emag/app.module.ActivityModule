function ActivityModule:checkActNotice()
    local cw, ct, cd, openT, meta, mArr, od
    cw = lt.TimeCounter:getServerWeek()
    ct = lt.TimeCounter:getServerHour()*100 + lt.TimeCounter:getServerMin()
    cd = lt.TimeCounter:getServerMonth()*100 + lt.TimeCounter:getServerDay()
    od = lt.TimeCounter:getServerOpenDay()

    -- meta = lt.RegularnoticeDao:query(cw, ct)
    for i=1, 4 do
        local meta, day, time, tType
        tType = i
        if i == 1 then
            day = cw
        elseif i == 2 then
            day = cd
        elseif i == 3 then
            day = od
        elseif i == 4 then
            day = 0
            tType = 0
        end
        time = ct

        meta = lt.RegularnoticeDao:query(tType, day, time)
        self:playLanternNotice(meta)
    end
end

function ActivityModule:playLanternNotice(meta)
    if meta then
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_LANTERN_NOTICE, {content = meta:getNotice()})

        local contentArr = lt.TaskModule:parseTaskString(meta:getNotice().."<>")
        local content = ""

        for _,v in ipairs(contentArr) do
            if v.content then
                content = content .. v.content 
            end
        end

        if meta:getState() ~= 0 then
            content = content .. "[Transmit]"
        end

        lt.ChatModule:sendClientInfo(content, 5, function ()
            if meta:getState() ~= 0 then
                lt.FlyModule:useFlyshoe(meta:getState())
            end
        end)
    end
end

function ActivityModule:checkActTimeRedTips()
    local day = tonumber(os.date("%j"))
    if self._checkDay ~= day then
        for k,v in pairs(self._checkAct) do
            self._checkAct[k] = true
        end
    end

    local ActArray = lt.ActCentreDao:queryPhaseOpenByType(2, lt.CommonModule:getServerPrase())
    for _,v in ipairs(ActArray) do
        if self._checkAct[v:getActId()] then
            local less, inTime = self:isInTime(v)
            lt.RedDotModule:setTipsStateByName("GameLayerUI_ActTime_" .. v:getActId(), inTime)
        end
    end
end

function ActivityModule:detachCheckActTimeRed(actId)
    lt.RedDotModule:setTipsStateByName("GameLayerUI_ActTime_" .. actId, false)
    self._checkAct[actId] = false
end

function ActivityModule:isInTime(meta)
    local ct = os.date("%H")*100 + os.date("%M")
    local cw = os.date("%w")*10000
    if cw == 0 then cw = 70000 end

    local less = 0
    local intime = false

    local week = meta:getDayOfWeek()
    local tMsg, st, et, eh

    tMsg = meta:getTime()

    st = tMsg.st
    et = tMsg.et
    
    if week then
        local msg = string.split(week, ",")
        table.sort(msg, function (a, b)
            return tonumber(a) < tonumber(b)
        end)
        for i=1,#msg do
            local aw = tonumber(msg[i]) * 10000

            if et and et > 2400 then

                local day = math.floor(tMsg.eh/24)*10000

                local awDay = aw + day
                local gap = (cw - aw)/10000

                if awDay > 70000 then
                    awDay = awDay - 70000
                    gap = gap + 7
                end

                if awDay <= cw and aw ~= cw then
                    if ct >= 0 and ct <= (et - 2400*gap) then
                        less = et - ct
                        intime = true
                    else
                        less = st - ct + gap*2400
                        --  
                    end
                    break
                end
            end

            if aw >= cw then
                if st and et then
                    if aw == cw then 
                        if ct >= st and ct <= et then
                            less = et - ct
                            intime = true
                        else
                            less = st - ct
                            -- if less < 0 then
                            --     less = less + 2400
                            -- end
                        end
                    else
                        less = aw - cw + st
                    end
                else
                    intime = true
                    less = aw - cw
                end
                break
            end
        end
    else
        if st and et then
            if ct >= st and ct <= et then
                less = et - ct
                intime = true
            else
                less = st - ct
                -- if less < 0 then
                --     less = less + 2400
                -- end
            end
        else
            less = 0
            intime = true
        end
    end
    return less, intime
end

