function ActivityModule:onActivityUpdateFinish(event)
    local ret = lt.TimeLimitSetDao:queryActivityTab()
    for k,v in pairs(ret) do
        local data = {
            tag = k,
            title = v:getTitle(),
            order = v:getOrder(),
            timeType = lt.TimeLimitSetDao:queryTimeType(k),
            timeValue = lt.TimeLimitSetDao:queryTimeValue(k),
        }
        self:uptListDataItem(data)
    end

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ACTIVITY_LIST_CHG)
    self:checkRedTips()
end

function ActivityModule:uptListDataItem(data)
    local isChange = false
    -- 活动时间
    local open = self:testActivityTime(data)


    -- 强制关闭活动
    local forceClose = data.timeType == ActivityModule.DateType.Close

    -- 部分常驻活动领取完奖励需要自动隐藏(首充, 登录有礼)
    if data.tag == lt.ActivityConst.ID.LoginGift then
        open = remain
    end

    -- 已结束需要清理的活动数据
    local clean = not open and not remain 
    
    local isUnOpen = false
    -- 未开启的活动列表
    if data.timeType == ActivityModule.DateType.Operation then
        local tmp = lt.TimeCounter:fmt2TimeStamp(data.timeValue, { timeType = data.timeType })
        isUnOpen = tmp.sTime > lt.TimeCounter:serverTime()
    end

    if self._openListData[data.tag] and (clean or forceClose) then
        isChange = true
        self._openListData[data.tag] = nil
    elseif (open or remain) and not forceClose then
        isChange = (not self._openListData[data.tag]) and true or false
        -- insert or update data
        self._openListData[data.tag] = data
    end

    if self._unOpenListData[data.tag] and open then
        self._unOpenListData[data.tag] = nil
    elseif not self._unOpenListData[data.tag] and isUnOpen then
        self._unOpenListData[data.tag] = data
    end

    return isChange
end

function ActivityModule:checkActivityList()
    local change = false
    for k,v in pairs(self._unOpenListData) do
        self:uptListDataItem(v)
    end

    for k,v in pairs(self._openListData) do
        local tmp = self:uptListDataItem(v)
        change = change or tmp
    end

    if change then  -- 通知变化
        -- print("==================> 活动列表更新 ")
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ACTIVITY_LIST_CHG)
    end
end

function ActivityModule:testActivityTime(data)
    local tType, tValue = data.timeType, data.timeValue
    local sTime, eTime 
    if tType == ActivityModule.DateType.Close then
        return false
    elseif tType == ActivityModule.DateType.KeepOn then
        return true
    elseif tType == ActivityModule.DateType.OpenServer then
        -- 开服活动, 活动结束时间为当天12点+活动开启天数
        sTime = lt.TimeCounter:getServerOpenTime()
        eTime = lt.TimeCounter:fmt2TimeStamp(tonumber(tValue), { timeType = tType })
    elseif tType == ActivityModule.DateType.Operation then
        local tmp = lt.TimeCounter:fmt2TimeStamp(tValue, { timeType = tType })
        sTime = tmp.sTime
        eTime = tmp.eTime
    end

    return lt.TimeCounter:timeInRange(sTime, eTime)
end

function ActivityModule:getListData(aType)
    local ret = {}
    local config = lt.ActivityConst.Config
    for aID, v in pairs(self._openListData) do
        if config[aID] and config[aID].aType == aType then
            ret[#ret + 1] = v
        end
    end

    table.sort(ret, function (a, b)
        return a.order < b.order
    end)

    return ret
end

function ActivityModule:requestKeyCode(code)
    local msg = lt.netcmd_pb.ActiveCode()
    msg.code = code
    SocketApi:sendToGs(lt.ClientCmdDef.ACTIVECODE, msg)
end

function ActivityModule:reqUpdateActivityCfg()
    local tlsTable = lt.TimeLimitSetDao:queryAll()
    local tlsArr = {}
    local db = lt.DbManager:getDb()
    for k,v in pairs(tlsTable) do
        local tls = {}
        tls.id = v:getId()

        local cfgName = v:getConfigName()
        if cfgName then
            --print("reqUpdateActivityCfg++++++++++++:  "..cfgName)
            for row in db:nrows(string.format("SELECT version AS version FROM %s;", cfgName)) do
                tls.version = row.version
                break
            end
            tlsArr[#tlsArr + 1] = tls
        end
    end
    self:reqActivityUpdate(tlsArr)
end

function ActivityModule:reqActivityUpdate(actArrTable)
    local req = lt.netcmd_pb.ActivityUpdate()
    req.infoList = {}
    for i,v in ipairs(actArrTable) do
        local info = lt.netcmd_pb.ActivityInfo()
        info.activityID = v.id
        info.version = v.version
        req.infoList[#req.infoList + 1] = info
    end

    SocketApi:sendToGs(lt.ClientCmdDef.ACTIVITY_UPDATE_REQ, req)
end


