ActivityModule.ActType = {
    Daily   = 1,            --日常活动
    Time    = 2,            --限时活动
}

-- 活动时间类型
ActivityModule.DateType = {
    Close       = -1,       --活动关闭
    KeepOn      = 0,        --活动常驻
    OpenServer  = 1,        --开服活动
    Operation   = 2,        --运营活动
}

function ActivityModule:init()
    self._openListData = {}     --开启的活动列表
    self._unOpenListData = {}   --未开启的活动列表

    SocketApi:addProtoListener(ServerCmdDef.ACTIVITY_UPDATE_ACK, handler(self, self.onActivityUpdateAck), "ActivityModule:onActivityUpdateAck")
    SocketApi:addProtoListener(ServerCmdDef.ACTIVITY_UPDATE_FINISH, handler(self, self.onActivityUpdateFinish), "ActivityModule:onActivityUpdateFinish")

    self:initListModule()
end

function ActivityModule:clear()
    self:clearListModule()
    
    SocketApi:removeProtoListenerByTag("ActivityModule:onActivityUpdateAck")
    SocketApi:removeProtoListenerByTag("ActivityModule:onActivityUpdateFinish")
    self._openListData = nil
    self._unOpenListData = nil

    if self._scheduleHandler then
        lt.ScheduleUtil:unscheduleGlobal(self._scheduleHandler)
        self._scheduleHandler = nil
    end


    self._checkAct = nil
end

function ActivityModule:initListModule()
    local lookupTable = {}
    for _,v in pairs(ActivityConst.Config) do
        if v.module and not lookupTable[v.module] then
            lt.getClass(v.module):init()
            lookupTable[v.module] = true
        end
    end
end

function ActivityModule:clearListModule()
    local lookupTable = {}
    for _,v in pairs(ActivityConst.Config) do
        if v.module and not lookupTable[v.module] then
            lt.getClass(v.module):clear()
            lookupTable[v.module] = true
        end
    end
end

function ActivityModule:isVaild(activityId)
    return self._openListData[activityId] and true or false
end

function ActivityModule:onActivityUpdateAck(event)
    local proto = event.param
    if proto and proto.infoList then
        for i,v in ipairs(proto.infoList) do
            local meta = lt.TimeLimitSetDao:query(v.activityID)

            local compress=lt.zlib.deflate()
            local uncompress=lt.zlib.inflate()
            local content = v.encodeFlag == 1 and uncompress(v.content) or v.content
            self:writeActivity2Db(meta:getFormName(), content)
            
            compress=lt.zlib.deflate()
            uncompress=lt.zlib.inflate()
            local cfgContent = v.encodeFlag == 1 and uncompress(v.contentConfig) or v.contentConfig
            self:writeActivity2Db(meta:getConfigName(), cfgContent)
        end
    end
end

