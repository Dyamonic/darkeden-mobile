--[[
获取活动的时间
activityId, 活动ID
params 
    countDown 返回倒计时格式文本
]]
function ActivityModule:fmtTime(activityId, params)
    params = params or {}

    local aType = lt.TimeLimitSetDao:queryTimeType(activityId)
    local aValue = lt.TimeLimitSetDao:queryTimeValue(activityId)

    local sTime, eTime
    if aType == ActivityModule.DateType.Close then
        return StringManager:getString(StringManager.TIME_OUT_OF_DATE)
    elseif aType == ActivityModule.DateType.KeepOn then
        return ""
    elseif aType == ActivityModule.DateType.OpenServer then
        -- 开始时间设置为开服时间,如果需要显示天以下更精确的时间,需要注意开始时间是否正确
        sTime = lt.TimeCounter:getServerOpenTime()
        eTime = lt.TimeCounter:fmt2TimeStamp(tonumber(aValue), { timeType = lt.TimeCounter.TIME_TYPE.INTERVAL})
    elseif aType == ActivityModule.DateType.Operation then
        local tmp = lt.TimeCounter:fmt2TimeStamp(aValue)  
        sTime, eTime = tmp.sTime, tmp.eTime
    end

    if params.countDown then
        return lt.TimeCounter:fmt2TimeText(eTime, {countDown = true})
    else
        return (params.prefix or "") .. lt.TimeCounter:fmt2TimeText(sTime) .. "~" .. lt.TimeCounter:fmt2TimeText(eTime)
    end
end

return ActivityModule
