-- boss 击杀跑马灯 Fragment Shader
return "\n    #ifdef GL_ES\n        precision mediump float;\n    #endif\n\nvarying vec2 v_texCoord; // Receive texture coordinates passed from the vertex shader\nuniform sampler2D u_Texture; // text texture\n\n    void main()\n    {\n        vec2 uv = v_texCoord;\n\n        vec3 topColor = vec3(1.0, 0.0, 0.0);     // #FF0000 -> (1.0, 0.0, 0.0)\n        vec3 bottomColor = vec3(0.294, 0.0, 0.0); // #4B0000 -> (0.294, 0.0, 0.0)\n\n        float mixFactor = 1.0 - uv.y;\n\n        vec3 finalColor = mix(bottomColor, topColor, mixFactor);\n\n        float alpha = texture2D(u_Texture, uv).a;\n\n        gl_FragColor = vec4(finalColor, alpha);\n    }\n"
