---@ Vip界面
---@class UIWndVip:UIWindowBase
local UIWndVip     = class("UIWndVip", lt.UIWindowBase)

local CacheManager = lt.CacheManager
local Constant     = lt.Constant
local NtfManager   = lt.NtfManager
local VipModule    = lt.VipModule
local ItemModule   = lt.ItemModule
local CommonUtil   = lt.CommonUtil
local CommonModule = lt.CommonModule
local FunctionToggleModule = lt.FunctionToggleModule

local VIP_TYPES    = {
    ONE_KEY_SELL   = 1, --开启一键出售
    ACTIVECHAT     = 2, --激活聊天
    AUTOMEDICATION = 3, --自动买药
    AUTOREAIR      = 4, --开启随身出售
    AUTO_SELL      = 5, --开启自动出售
    DOUBLEEXP      = 6, --增加商城每日购买双倍经验沙漏数量
    KILL_MONSTER   = 7, --怪物经验加成
    LUCKY          = 8, --幸运爆率增加
}

function UIWndVip:ctor(param)
    UIWndVip.super.ctor(self, param)
    self._curIndex = 0
    self._listShowDesc = nil
end

function UIWndVip:onShown()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_VIP_LIST_CHANGE, handler(self, self.refreshList),
        "UIWndVip:refreshList")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_VIP_STATE_CHANGE, handler(self, self.refreshCurLevel),
        "UIWndVip:refreshCurLevel")
    self._listTitle:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickTitle))
    self._listItem:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    self._btnBuy:addClickListener(handler(self, self.onBtnBuyClick))
    self._btnFix:addClickListener(handler(self, self.onBtnOpenFixClick))
    self._btnSell:addClickListener(handler(self, self.onBtnOpenSellClick))

    VipModule:sendVipReq()
    
    local param    = self:getParam().param or {}
    if param and param.selectIndex then
        self._firstIndex = (param.selectIndex or 1)
    end
end

function UIWndVip:onHide()
    NtfManager:removeNtfListenerByTag("UIWndVip:refreshList")
    NtfManager:removeNtfListenerByTag("UIWndVip:refreshCurLevel")
    if self._listTitle then
        self._listTitle:removeEventListener(fgui.UIEventType.ClickItem)
    end

    if self._listItem then
        self._listItem:removeEventListener(fgui.UIEventType.ClickItem)
    end
    self._btnBuy:removeClickListener()
    self._btnFix:removeClickListener()
    self._btnSell:removeClickListener()
    UIWndVip.super.onHide(self)
    self._firstIndex = nil
end

function UIWndVip:onClear()
    self._listDesc = nil
    self._btnFix   = nil
    self._btnSell  = nil
    self._btnBuy   = nil
    self._lblLv    = nil
    UIWndVip.super.onClear(self)
end

function UIWndVip:onInit()
    UIWndVip.super.onInit(self, _GURL.VipWndPanel)
    self._listTitle = self:getChild("list_title")
    self._listItem  = self:getChild("list_item")
    self._listDesc  = self:getChild("list_desc")
    self._btnFix    = self:getChild("btn_Fix")
    self._btnSell   = self:getChild("btn_sell")
    self._btnBuy    = self:getChild("btn_buy")
    self._lblLv     = self:getChild("lbl_lv")

    self._listTitle:setItemRenderer(handler(self, self.onTitleRender))
    self._listItem:setItemRenderer(handler(self, self.onItemRender))
    self._listDesc:setItemRenderer(handler(self, self.onDescRender))
end

function UIWndVip:refreshList()
    self:initUI()
end

function UIWndVip:refreshCurLevel()
    local state = VipModule:getVipLvState(self._curIndex)
    local obj = self._listTitle:getChildAt(self._curIndex - 1)

    self:setTouchEnabel(self._btnBuy, state ~= CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_RECEIVE_ENUM"))
    if state == CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_BUY_ENUM") then
        self._btnBuy:setTitle(GReadText.KEY_ACTIVITY_TASK_TIPS4) --领取
        self._btnBuy:getChild("red"):setVisible(true)
    elseif state == CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_RECEIVE_ENUM") then
        self._btnBuy:setTitle(GReadText.KET_MAIL_TIPS10) --已领取
        self._btnBuy:getChild("red"):setVisible(false)
    end
    if obj then
        local red = state == CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_BUY_ENUM")
        obj:getChild("img_red"):setVisible(red)
        self._btnBuy:getChild("red"):setVisible(red)
        local active = state ~= CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_NULL_ENUM")
        obj:getChild("img_suo"):setVisible(not active)
        obj:getChild("img_black"):setVisible(not active)
        local color = (active) and CommonUtil:convertColorWithX("#e3cb74") or
            CommonUtil:convertColorWithX("#565550")
        obj:getChild("title"):setColor(color)
    end
end

function UIWndVip:setTouchEnabel(btn, enable)
    btn:setGrayed(not enable)
    btn:setTouchable(enable)
end

function UIWndVip:onBtnBuyClick(target)
    local index = target:getSender().index
    if VipModule:getVipLvState(index) == CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_BUY_ENUM") then      -- 领取
        VipModule:sendReceiveVipRewardReq(index)
    elseif VipModule:getVipLvState(index) == CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_NULL_ENUM") then -- 购买
        local cost = target:getSender().cost
        if not cost then
            return
        end
        local itemType = tonumber(cost[1])
        local itemMeta = ""
        if itemType == Constant.ItemType.ITEM_TYPE_PROP then
            itemMeta = CacheManager:getItemMeta(tonumber(cost[2]))
        elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
            itemMeta = CacheManager:queryEquipMeta(tonumber(cost[2]))
        end
        local name = itemMeta:getName()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
            content = string.format(GReadText.KEY_VIP_TIPS_1, name .. cost[3], index),
            confirmCallback = function()
                local heroData = lt.GameModule:getHeroData()
                local point = heroData:getGold() or 0
                local costNum = tonumber(cost[3]) or 0
                if point < costNum then
                    local open,tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.RechargePage) 
                    if not open then
                        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
                        return
                    end
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndRecharge", param = { type = Constant.RECHARGE_TYPE.RECHARGE }, reopen = true })
                else
                    VipModule:sendBuyVipReq(index)
                end
            end,
        })
    end
end

function UIWndVip:onBtnOpenFixClick(target)
    local index = target:getSender().index
    if VipModule:getCurVipLv() < index then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = GReadText.KEY_ACCESS_TIPS7 })
        return
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {
        class = "UIWndLock",
        reopen = true,
        param = {
            [1] = {
                class = "UIWndRepair",
                location = "right",
                reopen = true,
                param = {
                    tabId = 1, }
            },
            [2] = { class = "UIWndRoleEquip", reopen = true },
            WndLockType = Constant.WndLockType.Repair,
        }
    })
end

function UIWndVip:onBtnOpenSellClick(target)
    local index = target:getSender().index
    if VipModule:getCurVipLv() < index then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = GReadText.KEY_ACCESS_TIPS7 })
        return
    end

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {
        class = "UIWndLock",
        reopen = true,
        param = {
            [1] = {
                class = "UIWndTrade",
                param = {
                    tabId = 2, },
                reopen = true,
            },
            [2] = { class = "UIWndInventory", reopen = true },
            WndLockType = Constant.WndLockType.Trade,
        }
    })
end

function UIWndVip:onBtnOpenStorageClick(target)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {
        class = "UIWndLock",
        reopen = true,
        param = {
            [1] = { class = "UIWndWareHouse" },
            [2] = { class = "UIWndInventory", reopen = true },
            WndLockType = Constant.WndLockType.WareHouse,
        }
    })
end

function UIWndVip:onTitleRender(index, obj)
    local title = obj:getChild("title")
    title:setText("VIP" .. index + 1)
    obj.index = index + 1
    local state = VipModule:getVipLvState(index + 1)
    local active = state ~= CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_NULL_ENUM")
    obj:getChild("img_red"):setVisible(state == CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_BUY_ENUM"))
    obj:getChild("img_suo"):setVisible(not active)
    obj:getChild("img_black"):setVisible(not active)
    local color = (active) and CommonUtil:convertColorWithX("#e3cb74") or
        CommonUtil:convertColorWithX("#565550")
    title:setColor(color)
end

function UIWndVip:onClickTitle(context)
    local data     = context:getData()
    local index    = data.index
    self._curIndex = index
    self:oninitItemListUI(self._curIndex)
    self:oninitDescListUI(self._curIndex)
end

function UIWndVip:oninitItemListUI(index)
    local array = CacheManager:getPrivilegeArray()
    local curData = array[index]
    local rewardList = curData:getReward()
    self._lblLv:setText("VIP" .. index)
    self._listItemData = rewardList
    self._listItem:setNumItems(#rewardList)

    local cost = curData:getCost()
    local itemType = tonumber(cost[1])
    local itemMeta = ""
    if itemType == Constant.ItemType.ITEM_TYPE_PROP then
        itemMeta = CacheManager:getItemMeta(tonumber(cost[2]))
    elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
        itemMeta = CacheManager:queryEquipMeta(tonumber(cost[2]))
    end
    local name = itemMeta:getName()
    local state = VipModule:getVipLvState(index)
    local red = false
    if state == CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_NULL_ENUM") then
        self._btnBuy:setTitle(name .. cost[3])
    elseif state == CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_BUY_ENUM") then
        self._btnBuy:setTitle(GReadText.KEY_ACTIVITY_TASK_TIPS4) --领取
        red = true
    elseif state == CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_RECEIVE_ENUM") then
        self._btnBuy:setTitle(GReadText.KET_MAIL_TIPS10) --已领取
    end

    self._btnBuy:getChild("red"):setVisible(red)
    self:setTouchEnabel(self._btnBuy, state ~= CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_RECEIVE_ENUM"))
    self._btnBuy.index = index
    self._btnBuy.cost = cost
    -- self:setTouchEnabel(self._btnFix, curData:getRepair() == 1)
    -- self:setTouchEnabel(self._btnSell, curData:getSell() == 1)
    self._btnFix.index = index
    self._btnSell.index = index
end

-- vip 特权描述
function UIWndVip:oninitDescListUI(index)
    local listDesc = CacheManager:getPrivilegeDescTable()
    local array = CacheManager:getPrivilegeArray()
    local curMeta = array[index]
    local oldIndex = index - 1
    local listShowDesc = {}
    for i, v in ipairs(listDesc or {}) do
        local listShow = v:getShow()
        local isNew = true
        local id = v:getId()
        for ii, vv in ipairs(listShow) do
            if oldIndex == 0 or oldIndex == vv then -- 和上一等级比较 是否是新的属性
                isNew = false
            end
            if vv == index then
                local data = {}
                data.isNew = isNew
                local desc = ""
                local filter = ""
                if id == VIP_TYPES.KILL_MONSTER then  -- 杀怪
                    filter = "[color=#00ff00]+" .. curMeta:getLevelBonus() / 100 .. "%" .. "[/color]"
                elseif id == VIP_TYPES.LUCKY then     -- 积分
                    filter = "[color=#00ff00]+" .. curMeta:getExplosion() / 100 .. "%" .. "[/color]"
                elseif id == VIP_TYPES.DOUBLEEXP then --增加商城每日购买双倍经验沙漏数量%s
                    filter = "[color=#00ff00]+" .. curMeta:getDoubleHourglassNumber() .. "[/color]"
                end

                if filter ~= "" then
                    desc = string.format((#listShowDesc + 1) .. "." .. v:getTxt(), filter)
                else
                    desc = (#listShowDesc + 1) .. "." .. v:getTxt()
                end

                data.desc = desc
                table.insert(listShowDesc, data)
            end
        end
    end

    self._listShowDesc = listShowDesc
    self._listDesc:setNumItems(#listShowDesc)
    if #listShowDesc > 0 then
        self._listDesc:scrollToView(0)
    end
end

-- vip 礼包渲染
function UIWndVip:onItemRender(index, obj)
    local itemData = self._listItemData[index + 1]

    local itemType = tonumber(itemData[1])
    local itemMeta = ""
    local iconPath = ""
    if itemType == Constant.ItemType.ITEM_TYPE_PROP then
        iconPath = "prop"
        itemMeta = CacheManager:getItemMeta(tonumber(itemData[2]))
    elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
        iconPath = "equip"
        itemMeta = CacheManager:queryEquipMeta(tonumber(itemData[2]))
    end
    local resUrl = string.format("ui://Item/%s_%s", iconPath, itemMeta:getIconId())
    obj:getChild("icon"):setURL(resUrl)

    local count = obj:getChild("lbl_count")
    count:setText(itemData[3])
    local size =  count:getSize()
    local scale = 1
    if size.width > 64 then
        scale = 64/size.width
    end
    count:setScale(scale,scale)
    
    obj.itemData = itemData
end

function UIWndVip:onClickItem(context)
    local data     = context:getData()
    local itemData = data.itemData
    if tonumber(itemData[1]) == Constant.ItemType.ITEM_TYPE_PROP then
        local itemMeta = CacheManager:getItemMeta(tonumber(itemData[2]))
        local itemInfo = ItemModule:getItemDataByConfig(itemMeta, nil, tonumber(itemData[3]))
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,
            { itemInfo = itemInfo, tipsType = Constant.PROPTIPS_FORM.Display })
    elseif tonumber(itemData[1]) == Constant.ItemType.ITEM_TYPE_EQUIP then
        local itemMeta = CacheManager:queryEquipMeta(tonumber(itemData[2]))
        local itemInfo = ItemModule:getItemDataByConfig(itemMeta, nil, tonumber(itemData[3]))
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,
            { itemInfo = itemInfo, tipsType = Constant.EquipShowTipsType.Display })
    end
end

function UIWndVip:onDescRender(index, obj)
    local showDescData = self._listShowDesc[index + 1]
    obj:getChild("txt"):setText(showDescData.desc)
    obj:getChild("icon"):setVisible(showDescData.isNew)
end

function UIWndVip:initUI()
    local vipLv = VipModule:getCurVipLv()
    if self._firstIndex then
        self._curIndex = self._firstIndex
        self._firstIndex = nil
    else
        self._curIndex = vipLv == 0 and 1 or vipLv
    end
    
    local array = CacheManager:getPrivilegeArray()
    self._listTitle:setNumItems(#array)
    self._listTitle:setSelectedIndex(self._curIndex - 1)
    self:oninitItemListUI(self._curIndex)
    self:oninitDescListUI(self._curIndex)
end

return UIWndVip
