---@class UICompEnergyCell
---
local UICompEnergyCell = class("UICompEnergyCell", lt.UIGButtonBase, lt.UICompChangeSkin)
local Constant = lt.Constant
local GameModule = lt.GameModule
local RechargeModule = lt.RechargeModule
local CommonFunc = lt.CommonFunc
local TimeCounterManager = lt.TimeCounterManager

function UICompEnergyCell:ctor()
    UICompEnergyCell.super.ctor(self)
    --UI
    self._grayBg = nil
    self._lightBg = nil
    self._nameLabel = nil
    self._addLabel = nil
    self._statusLabel = nil
    self._gotoBtn = nil
    --数据
    self._data = nil
    self._lastTime = nil
end

function UICompEnergyCell:onClear()
    --UI
    self._grayBg = nil
    self._lightBg = nil
    self._nameLabel = nil
    self._addLabel = nil
    self._statusLabel = nil
    self._gotoBtn = nil
    --数据
    self._data = nil
    self._lastTime = nil
end

function UICompEnergyCell:onConstruct()
    self._grayBg = self:getChild("bg_gray")
    self._lightBg = self:getChild("bg_light")
    self._nameLabel = self:getChild("label_name")
    self._addLabel = self:getChild("label_add")
    self._statusLabel = self:getChild("label_status")
    self._gotoBtn = self:getChild("btn_goto")
end

function UICompEnergyCell:onEnter()
    self._gotoBtn:addClickListener(function()
        self:onGotoBtn()
    end)
end

function UICompEnergyCell:onExit()
    self._gotoBtn:removeClickListener()
end

function UICompEnergyCell:setObjInfo(data)
    self._data = data
    local meta = data.meta
    self._grayBg:setVisible(data.status == 0)
    self._lightBg:setVisible(data.status == 1)
    self._nameLabel:setText(data.name)
    self._nameLabel:setColor(data.status == 0 and Constant.COLOR_GRAY or Constant.COLOR_LIGHT_YELLOW)
    self._addLabel:setText(string.format(GReadText.KEY_ENERGY_TIPS3, data.addPer.."%"))
    self._addLabel:setColor(data.status == 0 and Constant.COLOR_GRAY or Constant.COLOR_LIGHT_YELLOW)
    if data.status == 0 then
        self._statusLabel:setText(GReadText.KEY_ENERGY_TIPS4)
    else
        if meta:getDisplayContent() == 0 then
            self._statusLabel:setText(GReadText.KEY_ENERGY_TIPS5)
        else
            self._lastTime = self._data.lastTime
            self:refreshTime()
        end
    end
    self._statusLabel:setColor(data.status == 0 and Constant.COLOR_GRAY or Constant.COLOR_GREEN)
end

--跳转
function UICompEnergyCell:onGotoBtn()
    local meta = self._data.meta

    local jumpPage = meta:getJumpPage()
    if jumpPage ~= 0 then
        --跳转系统
        GameModule:gotoSystemFunc(jumpPage)
        return
    end

    local jumpStore = meta:getJumpStore()
    if jumpStore ~= 0 then
        --跳转商城
        RechargeModule:openRechargeByItemId(jumpStore)
        return
    end

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = "No jump configured yet"})
end

--刷新倒计时
function UICompEnergyCell:refreshTime()
    local days, hours, minutes, seconds = CommonFunc:secondsToTime(self._lastTime)
    if self._lastTime <= 0 then
        self._statusLabel:setText(GReadText.KEY_ENERGY_TIPS4)
    else
        self._statusLabel:setText(hours..GReadText.KEY_EQUIP_TIPS41..minutes..GReadText.KEY_EQUIP_TIPS42..seconds..GReadText.KEY_TIME_SEC)
        self._lastTime = self._lastTime - 1
    end
end

function UICompEnergyCell:getLastTime()
    return self._lastTime
end

return UICompEnergyCell