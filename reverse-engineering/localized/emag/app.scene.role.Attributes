-- 属性类
local Attributes = class("Attributes")
local Constant = lt.Constant
local RaceType = Constant.RaceType

--魔族初始值
local OuterOriginAttr = {
    strength = 10,
    agility = 10,
    knowledge = 10,
    point = 15
}
function Attributes:ctor()
    self._attrs = {}
end

function Attributes:refreshAttr(race, outersDis)
    if race == RaceType.Slayer then
        self:initializeHuman()
    elseif race == RaceType.Vampire then
        self:initializeVampire()
    elseif race == RaceType.Ousters then
        self:initializeSpirit(outersDis)
    else
        error("Unknown race")
    end
    self:calculateAttributes()
end

function Attributes:getAttr()
    return self._attrs
end
function Attributes:getStrength()
    return self._attrs.strength
end
function Attributes:getAgility()
    return self._attrs.agility
end
function Attributes:getKnowledge()
    return self._attrs.knowledge
end

function Attributes:initializeHuman()
    local min =  5
    local dValue = 15
    self._attrs.strength = math.random(min, min + dValue)
    dValue =  dValue - (self._attrs.strength - min)
    self._attrs.agility = math.random(min, min + dValue)
    dValue = dValue - (self._attrs.agility - min)
    self._attrs.knowledge = min + dValue
end

function Attributes:initializeVampire()
    self._attrs.strength = 20
    self._attrs.agility = 20
    self._attrs.knowledge = 20
end

function Attributes:initializeSpirit(outersDis)
    local outDis = outersDis or {}
    local attrPoint = outDis.attPointTable or {}

    self._attrs = clone(OuterOriginAttr)
    self._attrs.strength = self._attrs.strength + (attrPoint[1] or 0)
    self._attrs.agility = self._attrs.agility + (attrPoint[2] or 0)
    self._attrs.knowledge = self._attrs.knowledge + (attrPoint[3] or 0)
    self._attrs.point = outDis.remainPoint or self._attrs.point
end

function Attributes:distributePoints(min, max, total)
    local remainingPoints = total - (self._attrs.strength + self._attrs.agility + self._attrs.knowledge)

    while remainingPoints > 0 do
        local randStat = math.random(3) -- 随机选择一个属性
        if randStat == 1 and self._attrs.strength < max then
            self._attrs.strength = math.min(max, self._attrs.strength + 1)
        elseif randStat == 2 and self._attrs.agility < max then
            self._attrs.agility = math.min(max, self._attrs.agility + 1)
        elseif randStat == 3 and self._attrs.knowledge < max then
            self._attrs.knowledge = math.min(max, self._attrs.knowledge + 1)
        end
        remainingPoints = total - (self._attrs.strength + self._attrs.agility + self._attrs.knowledge)
    end
end

function Attributes:calculateAttributes()
    self._attrs.health = 2 * self._attrs.strength
    self._attrs.magic = 2 * self._attrs.knowledge
    self._attrs.evasion = self._attrs.agility
    self._attrs.defense = math.floor(self._attrs.strength / 15)
    self._attrs.hitRate = self._attrs.agility
    self._attrs.damage = (self._attrs.strength >= 20) and "1~2" or "1~1"
end

function Attributes:clear()
    self._attrs = {}
end

return Attributes

