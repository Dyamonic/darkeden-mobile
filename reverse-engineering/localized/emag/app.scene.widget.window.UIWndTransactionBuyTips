---@class UIWndTransactionBuyTips:UIWindowBase
---交易行 购买 tips
local UIWndTransactionBuyTips = class("UIWndTransactionBuyTips", lt.UIWindowBase)

local Constant                = lt.Constant
local CacheManager            = lt.CacheManager
local NtfManager              = lt.NtfManager
local TransactionModule       = lt.TransactionModule
local ItemModule              = lt.ItemModule
local GameModule              = lt.GameModule
local RechargeModule          = lt.RechargeModule

UIWndTransactionBuyTips.ChangeSkinConf = {
    ["Transaction"] = {
        ["n1"] = "bg_pmh_cztc",
        ["btn_sub"] = { icon = "btn_pmh_jianhao" },
        ["btn_add"] = { icon = "btn_pmh_jiahao" },
        ["btn_max"] = { icon = "btn_pmh_max" },
    },
    ["CommonTL"] = {
        ["frame"] = {
            closeButton = { bg = "bg_beibao_anniu01", bgup = "bg_beibao_anniu02" },
        },
        ["btn_buy"] = { bg = "bg_youjian_changanniu01", disabled = "bg_youjian_changanniu02" },
    }
}

function UIWndTransactionBuyTips:ctor(param)
    UIWndTransactionBuyTips.super.ctor(self, param)
end

function UIWndTransactionBuyTips:onClear()
    self._lblCost = nil
    self._iconItem = nil
    self._rareImg = nil
    self._lblName = nil
    self._btnNumAdd = nil
    self._btnNumSub = nil
    self._btnNumMax = nil
    if self._numInput then
        self._numInput:removeEditHandler()
        self._numInput:removeSelf()
        self._numInput = nil
    end
    self._btnBuy = nil
    self._price = nil
    self._max = nil
    self._num = nil
    self._sprite = nil

    UIWndTransactionBuyTips.super.onClear(self)
end

function UIWndTransactionBuyTips:onHide()
    self._btnNumSub:removeClickListener()
    self._btnNumAdd:removeClickListener()
    self._btnNumMax:removeClickListener()
    self._btnBuy:removeClickListener()
    self._iconItem:removeClickListener()
    UIWndTransactionBuyTips.super.onHide(self)
end

function UIWndTransactionBuyTips:onShown()
    self._btnNumSub:addClickListener(handler(self, self.openSubNumBtnClick))
    self._btnNumAdd:addClickListener(handler(self, self.openAddNumBtnClick))
    self._btnNumMax:addClickListener(handler(self, self.openMaxNumBtnClick))
    self._btnBuy:addClickListener(handler(self, self.onBuyBtnClick))
    self._iconItem:addClickListener(handler(self, self.onShowTipClick))
    self:refreshView()
end

function UIWndTransactionBuyTips:onInit()
    UIWndTransactionBuyTips.super.onInit(self, _GURL.WndTransactionBuyTips)
    self._lblCost = self:getChild("lbl_cost")
    self._iconItem = self:getChild("icon_item")
    self._rareImg = self:getChild("img_rare")
    self._lblName = self:getChild("lbl_itemName")
    self._btnNumAdd = self:getChild("btn_add")
    self._btnNumSub = self:getChild("btn_sub")
    self._btnNumMax = self:getChild("btn_max")
    self._btnBuy = self:getChild("btn_buy")
    self:initCocosInputUI()
end

function UIWndTransactionBuyTips:refreshView()
    local param = self:getParam() or {}
    local data = param.data
    local cofingId = data.cofingId
    local itemMeta = nil
    local sid = nil
    local itemType = nil
    local itemInfo = nil

    if self._sprite then
        self._sprite:removeFromParent()
        self._sprite = nil
    end

    if cofingId then
        local meta = CacheManager:getTransactionsById(cofingId)
        itemType = meta:getType()
        sid = meta:getItemId()
        if itemType == Constant.ItemType.ITEM_TYPE_PROP then
            itemMeta = CacheManager:getItemMeta(sid)
            itemInfo = ItemModule:getItemDataByConfig(itemMeta, nil, nil)
            self._iconItem:setURL(string.format("ui://Item/prop_%s", itemMeta and itemMeta:getIconId() or ""))
            self._iconItem:setAlpha(1)
        else
            yflog:Info("----------------------------")
        end
    else
        itemInfo = ItemModule:getItemDataByProperty(data.objProperty)
        itemMeta = itemInfo:getItemMeta()
        sid = itemInfo:getItemId()
        itemType = itemInfo:getItemType()
        self._iconItem:setURL(string.format("ui://Item/equip_%s", itemMeta and itemMeta:getIconId() or ""))
        self._iconItem:setAlpha(0)

        local iconId = itemMeta:getIconId()
        if iconId then
            local affixId = itemInfo:getFirstAffixId() or 0
            local affixLevel = itemInfo:getFirstAffixLevel() or 0
            local sprite = lt.CommonFunc.createEquipById(iconId,affixId,affixLevel)
            self:displayObject():addChild(sprite)
            local pos = self._iconItem:getPosition()
            sprite:setPosition(pos.x,self:getSize().height-pos.y)
            self._sprite = sprite
        end
    end
    self._lblName:setText(itemMeta and itemMeta:getName() or "")
    self._iconItem.itemMeta = itemInfo
    
    --缩放尺寸
    local itemSize = self._iconItem:getSize()
    local heightS = 50 / itemSize.height
    local widthS = 50 / itemSize.width
    local scale = heightS
    if widthS < heightS then
        scale = widthS
    end
    self._iconItem:setScale(scale, scale)

    if self._sprite then
        self._sprite:setScale(scale)
    end

    --公示时间
    local meta = TransactionModule:getTransactionDataByItemIdAndType(sid, itemType)
    local announce = meta:getAnnounce()
    self._rareImg:setVisible(announce == 1)

    --阈值
    local heroData = GameModule:getHeroData()
    local goldMax = heroData:getGold()

    if not data.IsBidding or data.IsBidding == 0 then -- 是否是竞价物品 0 不是， 1 是
        self._price = data.sellPrice
    else
        self._price = data.curBiddingPrice
    end
    
    local canBuyNum = math.floor(goldMax / self._price)
    if canBuyNum == 0 then canBuyNum = 1 end
    local itemNum = data.itemNum or 1
    self._max = canBuyNum > itemNum and itemNum or canBuyNum
    if self._max == 0 then self._max = 1 end
    self._num = 1
    self:refreshBuyNum()
end

function UIWndTransactionBuyTips:initCocosInputUI()
    if not self._numInput then
        self._numInput = ccui.EditBox:create(cc.size(110, 32), "", ccui.TextureResType.localType)
        self._numInput:setAnchorPoint(cc.p(0, 0))
        self._numInput:setFontName(lt.Constant.FONT_4)
        self._numInput:setFontSize(20)
        self._numInput:setReturnType(cc.KEYBOARD_RETURNTYPE_SEND)
        self._numInput:setInputMode(cc.EDITBOX_INPUT_MODE_SINGLELINE)
        self._numInput:registerScriptEditBoxHandler(handler(self, self.editBoxEvent))
        self._numInput:setPosition(cc.p(10, 1))
        self._numInput:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
        self:getChild("n6"):displayObject():addChild(self._numInput)
    end
end

--购买
function UIWndTransactionBuyTips:onBuyBtnClick()
    local isMonthCard = RechargeModule:checkMonthCard(true)
    if not isMonthCard then
        return
    end
    local enoughMoney = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.TICKET,
        self._price * self._num, { tips = true })
    if enoughMoney then
        local param = self:getParam() or {}
        local data = param.data
        TransactionModule:sendBuyTransactionReq(data.itemUniqueId, data.cofingId, self._num, self._price)
        self:hideSelectView()
    end
end

function UIWndTransactionBuyTips:editBoxEvent(eventType, sender)
    if eventType == "began" then
    elseif eventType == "ended" then
        --过滤无效字符
        self._num = tonumber(sender:getText())
        if self._num == nil then
            self._num = 1
        else
            --判断上下限
            if self._num > self._max then
                self._num = self._max
            elseif self._num < 1 then
                self._num = 1
            end
        end
        sender:setText("")
        --刷新界面
        self:refreshBuyNum()
    elseif eventType == "changed" then
        local str = sender:getText()
        str = string.gsub(str, "[^0-9]", "")
        sender:setText(str)
    elseif eventType == "return" then
    end
end

function UIWndTransactionBuyTips:openAddNumBtnClick()
    if self._num >= self._max then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = "cannot be added" })
        return
    end
    self._num = self._num + 1
    self:refreshBuyNum()
end

function UIWndTransactionBuyTips:openSubNumBtnClick()
    if self._num <= 1 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = "cannot be reduced" })
        return
    end
    self._num = self._num - 1
    self:refreshBuyNum()
end

function UIWndTransactionBuyTips:openMaxNumBtnClick()
    self._num = self._max
    self:refreshBuyNum()
end

function UIWndTransactionBuyTips:hideSelectView()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndTransactionBuyTips", close = true })
end

function UIWndTransactionBuyTips:refreshBuyNum()
    self._lblCost:setText(self._num * self._price)

    local enoughMoney = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.TICKET,
        self._price * self._num)
    self._lblCost:setColor(enoughMoney and Constant.COLOR_TEXT_WHITE_PURE or Constant.COLOR_TEXT_RED)
    self._numInput:setText(self._num)
end

function UIWndTransactionBuyTips:onShowTipClick(target)
    local itemMeta = target:getSender().itemMeta
    if itemMeta then
        ItemModule:showTipsByType(itemMeta)
    end
end

return UIWndTransactionBuyTips
