-- 公会
local GuildModule             = {}

local SocketApi               = lt.SocketApi
local netcmd_pb               = lt.netcmd_pb
local CommonModule            = lt.CommonModule
local ServerCmdDef            = lt.ServerCmdDef
local ClientCmdDef            = lt.ClientCmdDef
local GameModule              = lt.GameModule
local NtfManager              = lt.NtfManager
local StringManager           = lt.StringManager
local RedDotModule            = lt.RedDotModule
local GuideModule             = lt.GuideModule
local Constant                = lt.Constant

GuildModule._guildList        = {}  -- 公会列表
GuildModule._applyMemberList  = {}  -- 公会申请列表
GuildModule._myApplyGuildList = {}
GuildModule._inviteGuildInfo  = nil -- 邀请入会 公会信息
GuildModule._showClientTips   = nil -- 客户端文本提示
GuildModule._getGuildMembers  = nil

GuildModule.NOTICE_TYPE       = {
    GUILD_NOTICE  = 1, --  公会公告
    MEMBER_NOTICE = 2, --  个人简介
}

GuildModule.initNotice        =
"Our guild takes \"unity, collaboration, and common growth\" as its core purpose. 1. Participate in at least one activity per week. Those who are inactive for 7 consecutive days will be demoted or kicked out. 2. It is prohibited to maliciously grab equipment, insult members or passively participate in the battle. 3. The guild channel only discusses game content, and prohibits advertisements and sensitive topics."
function GuildModule:init()
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_CREATE_GUILD_RESP),
        handler(self, self.onGuildCreateResp), "GuildModule:onGuildCreateResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_LIST_RESP),
        handler(self, self.onGuildListResp), "GuildModule:onGuildListResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_APPLY_LIST_RESP),
        handler(self, self.onGuildApplyListResp), "GuildModule:onGuildApplyListResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_APPLY_RESP),
        handler(self, self.onGuildApplyResp), "GuildModule:onGuildApplyResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_APPLY_OPT_RESP),
        handler(self, self.onGuildApplyOptResp), "GuildModule:onGuildApplyOptResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_INVITE_SEND_RESP),
        handler(self, self.onGuildInviteSendResp), "GuildModule:onGuildInviteSendResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_INVITE_OPT_RESP),
        handler(self, self.onGuildInviteOptResp), "GuildModule:onGuildInviteOptResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_LEAVE_RESP),
        handler(self, self.onGuildLeaveResp), "GuildModule:onGuildLeaveResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_KICK_RESP),
        handler(self, self.onGuildKickResp), "GuildModule:onGuildKickResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_DELETE_RESP),
        handler(self, self.onGuildDeleteResp), "GuildModule:onGuildDeleteResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_SET_DUTY_RESP),
        handler(self, self.onGuildSetDutyResp), "GuildModule:onGuildSetDutyResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_DETAIL_RESP),
        handler(self, self.onGuildDetailResp), "GuildModule:onGuildDetailResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_MEMBER_JOIN_NTF),
        handler(self, self.onGuildMemberJoinNtf), "GuildModule:onGuildMemberJoinNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_MEMBER_LEAVE_NTF),
        handler(self, self.onGuildMemberLeaveNtf), "GuildModule:onGuildMemberLeaveNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_MEMBER_UPDATE_NTF),
        handler(self, self.onGuildMemberUpdateNtf), "GuildModule:onGuildMemberUpdateNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_UPDATE_NTF),
        handler(self, self.onGuildUpdateNtf), "GuildModule:onGuildUpdateNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_INVITE_NTF),
        handler(self, self.onGuildInviteNtf), "GuildModule:onGuildInviteNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_SET_NOTICE_RESP),
        handler(self, self.onGuildSetNoticeResp), "GuildModule:onGuildSetNoticeResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILDPLAYERAPPLYLISTNTF),
        handler(self, self.onGuildPlayerApplyListNtf), "GuildModule:onGuildPlayerApplyListNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUILD_HAS_APPLY_NTF),
        handler(self, self.onGuildHasApplyNtf), "GuildModule:onGuildHasApplyNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_CANCEL_GUILD_APPLY_RESP),
        handler(self, self.onCancelGuildApplyResp), "GuildModule:onCancelGuildApplyResp")
end

function GuildModule:clear()
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildCreateResp")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildListResp")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildApplyListResp")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildApplyResp")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildApplyOptResp")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildInviteSendResp")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildInviteOptResp")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildLeaveResp")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildKickResp")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildDeleteResp")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildSetDutyResp")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildDetailResp")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildMemberJoinNtf")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildMemberLeaveNtf")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildMemberUpdateNtf")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildUpdateNtf")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildInviteNtf")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildSetNoticeResp")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildPlayerApplyListNtf")
    SocketApi:removeProtoListenerByTag("GuildModule:onGuildHasApplyNtf")
    SocketApi:removeProtoListenerByTag("GuildModule:onCancelGuildApplyResp")

    self._guildList        = {}
    self._myApplyGuildList = {}
    self._applyMemberList  = {}
    self._inviteGuildInfo  = nil
    self._showClientTips   = nil
end

----------------------------回调----------------------------
--创建公会
function GuildModule:onGuildCreateResp(event)
    local proto = event.param
    local ret = proto.ret
    if ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndGuildCreate", close = true })
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndGuildList", close = true })
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndGuildMain" })
    end
end

--公会列表
function GuildModule:onGuildListResp(event)
    local proto = event.param
    local guildList = proto.guildList --// 公会列表

    self._guildList = guildList
    self:sortGuildList(1)

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUILD_LIST)
end

--// 公会申请列表
function GuildModule:onGuildApplyListResp(event)
    local proto = event.param
    local memberList = proto.memberList --// 公会列表
    self._applyMemberList = memberList
    RedDotModule:setTipsStateByName("GuildApplyRedTips", #self._applyMemberList > 0)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUILD_APPLY_LIST)
end

--公会申请
function GuildModule:onGuildApplyResp(event)
    local proto = event.param
    local ret = proto.ret
    if ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUILD_LIST)
    end
end

--公会申请操作
function GuildModule:onGuildApplyOptResp(event)
    local proto = event.param
    local ret = proto.ret -- 0 成功
    if ret == 0 then
        if self._delplayerId == "0" then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndGuildApplyList", close = true })
            self._applyMemberList = {}
        else
            self:deleteGuildApplyList()
        end
        local applylist = self:getApplyList()
        RedDotModule:setTipsStateByName("GuildApplyRedTips", #applylist > 0)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUILD_APPLY_LIST)
    end
end

--公会邀请
function GuildModule:onGuildInviteSendResp(event)
    local proto = event.param
    local ret = proto.ret -- 0 成功
    if ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = GReadText.KEY_GUILD_INVITE_TIPS })
    end
end

--公会邀请操作
function GuildModule:onGuildInviteOptResp(event)
    local proto = event.param
    local ret = proto.ret -- 0 成功
    if ret == 0 then
        self._inviteGuildInfo = nil
        NtfManager:dispatchNtf(NtfManager.NTF.NFT_SYSTEM_TIPS_CHANGE,
            { key = Constant.SYSTEMTIPS.INVITEGUILD, visible = (self._inviteGuildInfo ~= nil) })
    end
end

--离开公会
function GuildModule:onGuildLeaveResp(event)
    local proto = event.param
    local ret = proto.ret -- 0 成功
    if ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndGuildMain", close = true })
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndGuildList" })
    end
end

--踢人
function GuildModule:onGuildKickResp(event)
    local proto = event.param
    local ret = proto.ret -- 0 成功
    self:deleteGuildMemberList()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUILD_MEMBER_LIST)
end

--公会详情
function GuildModule:onGuildDetailResp(event)
    local proto = event.param
    local ret = proto.ret -- 0 成功
    local guildData = proto.guildData
    if ret == 0 then
        self._guildData = guildData
        GuildModule:sortGuildMemberList()
        self._getGuildMembers = true
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUILD_INFO)
end

--有人加入公会
function GuildModule:onGuildMemberJoinNtf(event)
    local proto = event.param
    local member = proto.member
    if self._guildData and self._guildData.memberList then
        for i, v in ipairs(self._guildData.memberList) do
            if member.playerId == v.playerId then
                return
            end
        end
        table.insert(self._guildData.memberList, member)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUILD_MEMBER_LIST)
    end
end

--有人离开公会
function GuildModule:onGuildMemberLeaveNtf(event)
    local proto = event.param
    local playerId = proto.playerId
    if self._guildData and self._guildData.memberList then
        for i, v in ipairs(self._guildData.memberList) do
            if v.playerId == playerId then
                table.remove(self._guildData.memberList, i)
                -- 通知相关模块数据已更新
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUILD_MEMBER_LIST)
                return
            end
        end
    end
end

--成员信息变更通知
function GuildModule:onGuildMemberUpdateNtf(event)
    local proto = event.param
    local member = proto.member
    if self._guildData and self._guildData.memberList then
        local found = false
        for i, v in ipairs(self._guildData.memberList) do
            if v.playerId == member.playerId then
                self._guildData.memberList[i] = member
                found = true
                break
            end
        end
        if not found then -- 如果未找到，则插入新成员
            table.insert(self._guildData.memberList, member)
        end
        -- 通知相关模块数据已更新
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUILD_MEMBER_LIST)
    end
end

--公会基础信息变更通知
function GuildModule:onGuildUpdateNtf(event)
    local proto = event.param
    local simpleData = proto.simpleData
    if self._guildData then
        self._guildData.simpleData = simpleData
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUILD_INFO)
    end
end

--收到公会邀请
function GuildModule:onGuildInviteNtf(event)
    local proto = event.param
    local simpleData = proto.simpleData
    self._inviteGuildInfo = simpleData

    NtfManager:dispatchNtf(NtfManager.NTF.NFT_SYSTEM_TIPS_CHANGE,
        { key = Constant.SYSTEMTIPS.INVITEGUILD, visible = (self._inviteGuildInfo ~= nil) })
end

--设置公会公告
function GuildModule:onGuildSetNoticeResp(event)
    local proto = event.param
    local ret = proto.ret
    if ret == 0 then
        if self._noticeType == false then
            self._guildData.simpleData.noticeText = self._notice
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUILD_INFO)
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndGuildNotice", close = true })
    end
end

--申请列表
function GuildModule:onGuildPlayerApplyListNtf(event)
    local proto = event.param
    local applyGuildId = proto.applyGuildId --// 当前正在申请的公会id
    self._myApplyGuildList = applyGuildId
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUILD_APPLY_LIST)
end

--有人申请公会
function GuildModule:onGuildHasApplyNtf(event)
    local heroData = GameModule:getHeroData()
    local myGuildDuty = tonumber(heroData:getGuildDuty())
    if (myGuildDuty == Constant.GuildDuty.Master or myGuildDuty == Constant.GuildDuty.ViceMaster) then
        RedDotModule:setTipsStateByName("GuildApplyRedTips", true)
    else
        self._applyMemberList = {}
        RedDotModule:setTipsStateByName("GuildApplyRedTips", false)
    end
end

--设置职位回调
function GuildModule:onGuildSetDutyResp(event)
    local proto = event.param
    local ret = proto.ret -- 0 成功
    if ret == 0 and self._showClientTips then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = self._showClientTips })
        self._showClientTips = nil
    end
end

--取消公会申请
function GuildModule:onCancelGuildApplyResp(event)
    local proto = event.param
    local ret = proto.ret
    if ret ~= 0 then
        return
    end
    for i = 1, #self._myApplyGuildList do
        if self._myApplyGuildList[i].guildId == self._delApplyGuildId then
            table.remove(self._myApplyGuildList, i)
            break
        end
    end
    self._delApplyGuildId = nil
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUILD_APPLY_LIST)
end

----------------------------请求----------------------------
--创建公会
function GuildModule:sendGuildCreateReq(guildName, noticeText, icon)
    local msg = netcmd_pb.CS_CreateGuildReq()
    msg.guildName = guildName
    msg.noticeText = noticeText
    msg.icon = icon
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_CREATE_GUILD_REQ), msg)
end

--公会详情
function GuildModule:sendGuildDetailReq(guildId)
    local msg = netcmd_pb.CS_GuildDetailReq()
    msg.guildId = guildId
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GUILD_DETAIL_REQ), msg)
end

--公会列表
function GuildModule:sendGuildListReq(guildName)
    local msg = netcmd_pb.CS_GuildListReq()
    msg.guildName = guildName
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GUILD_LIST_REQ), msg)
end

--申请公会
function GuildModule:sendGuildApplyReq(guildId)
    local msg = netcmd_pb.CS_GuildApplyReq()
    msg.guildId = guildId
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GUILD_APPLY_REQ), msg)
end

--公会申请列表
function GuildModule:sendGuildApplyListReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GUILD_APPLY_LIST_REQ))
end

--公会申请操作
function GuildModule:sendGuildApplyOptReq(playerId, operate)
    local msg = netcmd_pb.CS_GuildApplyOptReq()
    msg.playerId = playerId -- // =0时表示全部
    self._delplayerId = playerId
    msg.operate = operate   --// 1.同意  2.拒绝
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GUILD_APPLY_OPT_REQ), msg)
end

--公会邀请
function GuildModule:sendGuildInviteSendReq(playerId)
    local msg = netcmd_pb.CS_GuildInviteSendReq()
    msg.playerId = playerId -- // =0时表示全部
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GUILD_INVITE_SEND_REQ), msg)
end

--操作公会邀请
function GuildModule:sendGuildInviteOptReq(agree, guildId)
    local msg = netcmd_pb.CS_GuildInviteOptReq()
    msg.agree = agree -- //  true同意 false拒绝
    msg.guildId = guildId
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GUILD_INVITE_OPT_REQ), msg)
end

--离开公会
function GuildModule:sendGuildLeaveReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GUILD_LEAVE_REQ))
end

--踢出公会
function GuildModule:sendGuildKickReq(playerId)
    local msg = netcmd_pb.CS_GuildKickReq()
    msg.playerId = playerId --
    self._delplayerId = playerId
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GUILD_KICK_REQ), msg)
end

--解散公会
function GuildModule:sendGuildDeleteReq()
    local heroData = lt.GameModule:getHeroData()
    if heroData then
        self._showClientTips = string.format(GReadText.KEY_GUILD_TIPS31, heroData:getGuildName())
    end
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GUILD_DELETE_REQ))
end

--解散公会回调
function GuildModule:onGuildDeleteResp(event)
    local proto = event.param
    local ret = proto.ret -- 0 成功
    if ret == 0 and self._showClientTips then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = self._showClientTips })
        self._showClientTips = nil
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndGuildMain", close = true })
end

--设置职位
function GuildModule:sendGuildSetDutyReq(playerId, duty)
    local msg = netcmd_pb.CS_GuildSetDutyReq()
    msg.playerId = playerId --玩家id
    msg.duty = duty         --职位
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GUILD_SET_DUTY_REQ), msg)

    -------------------------------------------------------------------------------------------
    -- 系统提示
    if not self._guildData then
        return
    end

    if not self._guildData.memberList then
        return
    end

    local memberData = nil
    for i = 1, #self._guildData.memberList do
        if self._guildData.memberList[i].playerId == playerId then
            memberData = self._guildData.memberList[i]
            break
        end
    end

    if type(memberData) ~= "table" then
        return
    end
    if duty == Constant.GuildDuty.Master then
        self._showClientTips = string.format(GReadText.KEY_GUILD_TIPS32, memberData.name)
    elseif duty == Constant.GuildDuty.ViceMaster then
        self._showClientTips = string.format(GReadText.KEY_GUILD_TIPS29, memberData.name)
    elseif duty == Constant.GuildDuty.Normal then
        self._showClientTips = string.format(GReadText.KEY_GUILD_TIPS30, memberData.name)
    end
    -------------------------------------------------------------------------------------------
end

--设置公会公告
function GuildModule:sendGuildSetNoticeReq(notice, player)
    local msg = netcmd_pb.CS_GuildSetNoticeReq()
    msg.notice = notice
    msg.player = player --true玩家公告 false公会公告
    self._noticeType = player
    self._notice = notice
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GUILD_SET_NOTICE_REQ), msg)
end

--取消公会申请
function GuildModule:sendCancelGuildApplyReq(guildId)
    local msg = netcmd_pb.CS_CancelGuildApplyReq()
    msg.guildId = guildId
    self._delApplyGuildId = guildId
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_CANCEL_GUILD_APPLY_REQ), msg)
end

----------------------------方法----------------------------
-- 获取公会信息
function GuildModule:getGuildData()
    return self._guildData or {}
end

-- 申请列表
function GuildModule:getApplyList()
    return self._applyMemberList or {}
end

-- 公会列表
function GuildModule:getGuildList()
    return self._guildList or {}
end

-- 我申请加入行会的列表
function GuildModule:getMyApplyGuildList()
    return self._myApplyGuildList or {}
end

-- 邀请入会信息
function GuildModule:getInviteGuildInfo()
    return self._inviteGuildInfo or nil
end

function GuildModule:getMyApplyGuildHash()
    local myApplyList = GuildModule:getMyApplyGuildList() or {}
    -- 将 myApplyList 转换为哈希表
    local applyGuilds = {}
    for _, guildId in ipairs(myApplyList) do
        applyGuilds[guildId] = true
    end
    return applyGuilds
end

-- 1 人数由大到小 2 人数由小到大
function GuildModule:sortGuildList(type)
    if type == 1 then
        table.sort(self._guildList, function(a, b)
            if a.curMemberSize ~= b.curMemberSize then
                return a.curMemberSize > b.curMemberSize
            end
            return a.createTime < b.createTime
        end)
    elseif type == 2 then
        table.sort(self._guildList, function(a, b)
            if a.curMemberSize ~= b.curMemberSize then
                return a.curMemberSize < b.curMemberSize
            end
            return a.createTime < b.createTime
        end)
    end
end

-- 公会成员排序 自己 在线 职位 等级
function GuildModule:sortGuildMemberList()
    if self._guildData and self._guildData.memberList then
        local playerId = GameModule:getHeroData():getPlayerId() --自己
        table.sort(self._guildData.memberList, function(a, b)
            if a.playerId == playerId then
                return true
            end
            if b.playerId == playerId then
                return false
            end
            if a.lastLogoutTime ~= b.lastLogoutTime then -- 0 在线
                if a.lastLogoutTime == 0 and b.lastLogoutTime ~= 0 then
                    return true
                end
                if a.lastLogoutTime ~= 0 and b.lastLogoutTime == 0 then
                    return false
                end
            end
            if a.duty ~= b.duty then -- 职位
                return a.duty < b.duty
            end
            return a.level > b.level -- 等级
        end)
    end
end

function GuildModule:getLastTimeStr(lasttime)
    local str = ""
    local lastTime = lasttime
    if lastTime == 0 then
        str = StringManager:getString(StringManager.KEY_ONLINE)
    else
        -- 精确到秒 无需 /1000
        local lastLeaveTime = (os.time() - lastTime)
        if lastLeaveTime > 3600 then
            local hour = math.floor(lastLeaveTime / 3600)
            if hour < 24 then
                str = string.format(StringManager:getString(StringManager.KEY_LAST_HOUR), hour)
            else
                str = string.format(StringManager:getString(StringManager.KEY_LAST_DAY), math.floor(hour / 24))
            end
        else
            str = string.format(StringManager:getString(StringManager.KEY_LAST_SECOND), math.floor(lastLeaveTime / 60))
        end
    end
    return str
end

function GuildModule:deleteGuildMemberList()
    if self._guildData and self._guildData.memberList then
        for i = 1, #self._guildData.memberList do
            if self._guildData.memberList[i].playerId == self._delplayerId then
                table.remove(self._guildData.memberList, i)
                break
            end
        end
    end
end

function GuildModule:deleteGuildApplyList()
    if self._applyMemberList then
        for i = 1, #self._applyMemberList do
            if self._applyMemberList[i].playerId == self._delplayerId then
                table.remove(self._applyMemberList, i)
                break
            end
        end
    end
end

function GuildModule:getOnlineMemberCount()
    local onlineCount = 0
    local maxCount = 0
    if not self._guildData or not self._guildData.memberList then
        return onlineCount, maxCount -- 如果不存在，直接返回 (0, 0)
    end
    local memberList = self._guildData.memberList
    maxCount = #memberList
    for _, member in ipairs(memberList) do
        if member.lastLogoutTime == 0 then
            onlineCount = onlineCount + 1
        end
    end
    return onlineCount, maxCount
end

function GuildModule:getGuildMember()
    local guildId = GameModule:getHeroData():getGuildId()
    if guildId == 0 or guildId == "0" then
        return {}
    end
    if not self._guildData then
        if self._getGuildMembers == nil then
            self._getGuildMembers = false
            GuildModule:sendGuildDetailReq(guildId)
        end
        return {}
    end
    if not self._guildData.memberList then
        return {}
    end
    return self._guildData.memberList
end

----------------------------红点----------------------------

function GuildModule:getRedPoint()
    return RedDotModule:getTipsStateByName("GuildApplyRedTips")
end

return GuildModule
