-- [[ 天炼 属性变化 ]]
-- 正在命中的效果id(毒物，持续效果)特效
function HeroAgent:updateHitEffect(strValue)
    local effectIds = string.split(strValue, ",")

    self._heroData:setEffectIds(effectIds, strValue)

    -- 增删特效Id归类统计 
    local changeRemoveEffectId = {}
    local changeAddEffectId = {}

    if not self._playingEffectIdMap then
        self._playingEffectIdMap = {}
    end

    
    for _, effectId in pairs(self._playingEffectIdMap) do
        -- 假设所有的都需要删
        changeRemoveEffectId[effectId] = true
    end

    for _, effectId in ipairs(effectIds) do
        -- 有则不需要删
        if changeRemoveEffectId[effectId] then
            changeRemoveEffectId[effectId] = nil
        else
            -- 新增的一定是最外的层级，所以无需担心层级
            changeAddEffectId[effectId] = true
        end
    end

    -- 更新当前effectIdMap
    for _, removeEffectId in pairs(changeRemoveEffectId) do
        self._playingEffectIdMap[removeEffectId] = nil
    end

    for _, AddEffectId in pairs(changeAddEffectId) do
        self._playingEffectIdMap[AddEffectId] = true
    end
 
    self._heroActor:updateHitEffect(changeRemoveEffectId, changeAddEffectId)
end

