-- 根据move类型 选择动作帧
function HeroAgent:moveTypeToActionId(moveType)
    if moveType == Constant.MOVE_RUN then
        -- 魔族移动
        local race = self:getRoleData():getRace()
        if race == Constant.RaceType.Ousters then 
            local weaponType = self:getWeaponType()
            local action = Constant.ROLE_ACTION_MOVE
            if weaponType ~= Constant.WeaponType.BattleWheel then
                action = Constant.ACTION_OUSTERS_MOVE
            end
            return action
        elseif race == Constant.RaceType.Slayer then
            local action = Constant.ACTION_MOVE
            local mountId = self:getRoleData():getMountId()
            if mountId > 0 then
                if Constant.MOUNT_ADVANCED_ITEMS3[mountId] then
                    action = Constant.ACTION_MOVE
                else
                    action = Constant.ACTION_SLAYER_MOTOR_MOVE
                end 
            end
            
            return action
        end
        return Constant.ROLE_ACTION_MOVE

    elseif moveType == Constant.MOVE_FORWARD  then
        return Constant.ROLE_ACTION_IDLE
    elseif moveType == Constant.MOVE_IMMEDIATE  then
        return Constant.ROLE_ACTION_IDLE
    else
        print("no moveTypeToActionId for ", moveType)
        return nil

    end
end

function HeroAgent:playMoveAction(moveType)
    self:playAction(self:moveTypeToActionId(moveType))
    --对象移动刷新周围玩家
    local worldAgent = lt.AgentManager:getWorldAgent()
end

-- 动画 skillId 存在作为技能释放 普攻为空
function HeroAgent:playAction(actionId, skillId)
    if not actionId then
        return
    end

    if self._isSelf and (not self._heroData:isAlive()) and actionId ~= Constant.ROLE_ACTION_DIE then
        return
    end

    if not self:getRoleData() then
       return 
    end
    
    -- 魔族
    -- 召唤-精灵 动作改变
    if self:isOusters() and self:hasBuffer(BuffEnum.EFFECT_SUMMON_SYLPH) then
        if actionId == Constant.ACTION_OUSTERS_MOVE or actionId == Constant.ROLE_ACTION_MOVE then
            actionId = Constant.ACTION_OUSTERS_FAST_MOVE_MOVE
        else
            actionId = Constant.ACTION_OUSTERS_FAST_MOVE_STAND
        end

        local summonSylphId = self._heroData:getSummonSylphId()
        if actionId == Constant.ACTION_OUSTERS_FAST_MOVE_MOVE then
            if summonSylphId  == Constant.OUTSET_MOUNTID.FAIRY then
                actionId = Constant.ACTION_OUSTERS_FAIRY_MOVE_MOVE
            elseif summonSylphId  == Constant.OUTSET_MOUNTID.PEGASUS then
                actionId = Constant.ACTION_OUSTERS_PEGASUS_MOVE_MOVE
            end
        end
        if actionId == Constant.ACTION_OUSTERS_FAST_MOVE_STAND then
            if summonSylphId  == Constant.OUTSET_MOUNTID.FAIRY then
                actionId = Constant.ACTION_OUSTERS_FAIRY_MOVE_STAND
            elseif summonSylphId  == Constant.OUTSET_MOUNTID.PEGASUS then
                actionId = Constant.ACTION_OUSTERS_PEGASUS_MOVE_STAND
            end 
        end
    end

    --魔族站立根据武器显示不同动作
    if self:isOusters() and actionId == Constant.ROLE_ACTION_IDLE then
        local weaponType = self:getWeaponType()
        if weaponType ~= Constant.WeaponType.BattleWheel then
            actionId = Constant.ACTION_OUSTERS_STAND
        end
        local summonSylphId = self._heroData:getSummonSylphId()
        if summonSylphId  == Constant.OUTSET_MOUNTID.FAIRY then
            actionId = Constant.ACTION_OUSTERS_FAIRY_MOVE_STAND
        elseif summonSylphId  == Constant.OUTSET_MOUNTID.PEGASUS then
            actionId = Constant.ACTION_OUSTERS_PEGASUS_MOVE_STAND
        end 
    end

    self._heroActor:playAction(actionId)
end


-- 取消 召唤-精灵 动作
function HeroAgent:cancelSummonSylph()
    local actionId = self._heroActor:getActionId()
    if actionId == Constant.ACTION_OUSTERS_FAST_MOVE_STAND then
        actionId = Constant.ROLE_ACTION_ATTACK_IDLE
    elseif actionId == Constant.ACTION_OUSTERS_FAST_MOVE_MOVE then
        actionId = Constant.ROLE_ACTION_MOVE
    end
    self._heroActor:playAction(actionId)
end

function HeroAgent:cancelSummonSylphMount()
    local actionId = self._heroActor:getActionId()
    if actionId == Constant.ACTION_OUSTERS_FAIRY_MOVE_STAND 
        or actionId == Constant.ACTION_OUSTERS_PEGASUS_MOVE_STAND then
        actionId = Constant.ROLE_ACTION_ATTACK_IDLE
    elseif actionId == Constant.ACTION_OUSTERS_FAIRY_MOVE_MOVE or
        actionId == Constant.ACTION_OUSTERS_PEGASUS_MOVE_MOVE
         then
        actionId = Constant.ROLE_ACTION_MOVE
    end
    self._heroActor:playAction(actionId)
end

