function HeroAgent:casketInvisible(transform)
    local worldAgent = lt.AgentManager:getWorldAgent()
    local selfHeroAgent = worldAgent:getMapAgent():getSelfHeroAgent()
    if transform == SkillEnum.TRANSFORM.CASKET then
        local heroXY = cc.p(self:getPosition())
        self._casketActor:setPositionEx(heroXY)
        if self._isSelf then
            self._casketActor:addCasket(19)
        else
            self._casketActor:addCasketSoon(0)
            self._heroActor:setHideSprite(true)
        end
        
        self._heroActor:createCasketShot()
    elseif transform == SkillEnum.TRANSFORM.NONE then
        self._casketActor:removeCasket()
        if not selfHeroAgent:isTransCasket() then
            self._heroActor:setHideSprite(false)
        end
    end
end

function HeroAgent:getCasketActor()
    return self._casketActor
end

