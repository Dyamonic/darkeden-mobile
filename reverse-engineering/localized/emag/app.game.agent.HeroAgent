function HeroAgent:changeSkillHide(hide)
    if hide ~= self._heroData:getSkillHide() then
        if Constant.SkillHide.Hide == hide then
            self:clearAllBuffer()
        elseif Constant.SkillHide.None == hide then
            self:resumeAllBuffer()
        end
    end

    self._heroData:setSkillHide(hide)
    self._heroActor:changeSkillHide()
end

