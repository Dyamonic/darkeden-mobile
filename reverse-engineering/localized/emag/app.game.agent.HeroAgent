function HeroAgent:onChatLabelPost(event)
    local param = event.param
    local chatInfo = param.chatInfo
    if not chatInfo then
        return 
    end
    local name = chatInfo.sendMan
    local str = chatInfo.chatMsg
    if not name or not str  then
        return
    end
    if self._heroData:getName() == name then
        if self._heroActor then
            self._heroActor:updateChatLabel(chatInfo)
        end
    end
end

