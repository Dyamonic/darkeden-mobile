-- 技能轮盘方向指示器
function HeroAgent:getSkillInitDirection(skillId, showType)
    local isNeedInitDirection = self._skillActor:isNeedInitDirection(showType)
    if isNeedInitDirection then
        local directionDelta = cc.p(0, 0)
        local skillMeta = lt.CacheManager:querySkillMeta(skillId)
        if not skillMeta then
            return directionDelta
        end
        local mHero, nHero = self:getMNExactly()
        -- 范围内是否有目标
        local mTarget, nTarget
        if not SkillEnum.IS_MOVE_SKILL[skillId] then
            local targetAgent = self:getTargetAgentMini()
            local isHelpSkill = SkillEnum.HELP_SKILL_ID_TABLE[skillId]
            if not targetAgent then
                if isHelpSkill then
                    targetAgent = self
                else
                    targetAgent = self:getTargetAgent(true, skillId)
                end
            end
            local isAOE = self._skillActor:getType(showType) == 2 and (not targetAgent or (targetAgent and self:isFriendAgent(targetAgent)))
            local isToSelf = isHelpSkill and (not targetAgent or (targetAgent and self:isFriendAgent(targetAgent)))
            if isAOE or isToSelf  then
                targetAgent = self
            elseif SkillEnum.SKILL_INTIMATE_GRAIL == skillId then
                --亲密圣杯可以对敌也可以对友
            else
                if targetAgent and self:isFriendAgent(targetAgent) then
                    self:setTargetAgentId(nil)
                    targetAgent = nil
                end
                if not targetAgent then
                    targetAgent = self:getTargetAgent(true, skillId)
                    -- 校验是否符合追击范围
                    if targetAgent then
                        if not self:checkChaseRange(skillId, targetAgent) then
                            targetAgent = nil
                            self:setTargetAgentId(nil)
                        end
                    end
                end
            end
            if targetAgent then
                mTarget, nTarget = targetAgent:getMNExactly()
            else
                mTarget, nTarget = MapUtil:getPositionToDirection(mHero, nHero, self:getDirection())
            end
        else
            mTarget, nTarget = MapUtil:getPositionToDirection(mHero, nHero, self:getDirection())
        end
        if mTarget and nTarget then
            local x1, y1 = lt.MapUtil:calcMNMid(mHero, nHero)
            local x2, y2 = lt.MapUtil:calcMNMid(mTarget, nTarget)

            local delta = cc.p(x2 - x1, y1 - y2)
            local angle = math.atan2(delta.y, delta.x)
        
            -- -- 指定方向最大范围发出弹道的技能
            -- if SkillEnum.DIRECTION_MAX_SKILL_ID_TABLE[skillId]  then
            --     local width, height = lt.SkillModule:getSkillOperatorSize(skillId)
            --     delta.x = width * math.cos(angle)
            --     delta.y = height * math.sin(angle)
            -- end
            -- 指定方向最大范围发出弹道的技能
            if SkillEnum.DIRECTION_MAX_SKILL_ID_TABLE[skillId] or SkillEnum.IS_MOVE_SKILL[skillId] then
                local width, height = lt.SkillModule:getSkillOperatorSize(skillId)
                
                local halfWidth = width / 2
                local halfHeight = height / 2
                
                local maxDistanceX = math.abs(halfWidth / math.cos(angle)) 
                local maxDistanceY = math.abs(halfHeight / math.sin(angle))

                local maxDistance = math.min(maxDistanceX, maxDistanceY)

                delta.x = maxDistance * math.cos(angle)
                delta.y = maxDistance * math.sin(angle)
            end
            return delta
        end
    else
        -- 不能对自己释放限制
        local skillMeta = lt.CacheManager:querySkillMeta(skillId)
        if self:getTargetAgentId() == self:getAgentId() and not skillMeta:isToSelf() then
            self:setTargetAgentId(nil)
            local targetAgent = self:getTargetAgent(true, skillId)
            -- 校验是否符合追击范围
            if targetAgent then
                if not self:checkChaseRange(skillId, targetAgent) then
                    targetAgent = nil
                    self:setTargetAgentId(nil)
                end
            end
        elseif self:getTargetAgentId() == nil then
            local targetAgent = self:getTargetAgent(true, skillId)
            if targetAgent and (not self:checkChaseRange(skillId, targetAgent)) then
                targetAgent = nil
                self:setTargetAgentId(nil)
            end
        end
    end
    return nil
end

--- 判断是否在移动中（且不在攻击范围内）就不进行追击
function HeroAgent:checkMovingAttack(skillId)
    if SkillEnum.IS_MOVE_SKILL[skillId] then
        return true
    end 
    local targetAgent = self:getTargetAgentMini()
    if not targetAgent then
        targetAgent = self:getTargetAgent(true)
        if targetAgent then
            if not self:checkChaseRange(skillId, targetAgent) then
                targetAgent = nil
                self:setTargetAgentId(nil)
            end
        end
    end
    local skillMeta = lt.CacheManager:querySkillMeta(skillId)

    if targetAgent then
        local mTarget, nTarget = targetAgent:getMNExactly()
        if not self:_isInSkillDistance(skillMeta, mTarget, nTarget) then
            local controlParam = lt.SkillModule:getTouchMoving()
            if controlParam then
                return false
            end
        end
    end

    -- 可以滑动释放的
    -- local releaseOpenTable = skillMeta:getReleaseOpen()
    -- if releaseOpenTable[SkillOpen.MoveLongPress]  then
        local controlParam = lt.SkillModule:getTouchMoving()
        if controlParam then
            return false
        end 
    -- end

    return true
end

function HeroAgent:getRaceType()
    return self._raceType
end
-- 火箭数量
function HeroAgent:getMissileIndex()
    self._missileIndex = self._missileIndex + 1
    return self._missileIndex
end

function HeroAgent:isCrossCount()
    if self._heroData then
        return self._heroData:isCrossCount()
    else
        return false
    end
end
