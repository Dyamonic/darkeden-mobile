
local HeroAgent = class("HeroAgent", lt.BaseAgent)

local Constant = lt.Constant
local SkillEnum = lt.SkillEnum
local MapUtil = lt.MapUtil
local CacheManager = lt.CacheManager
local BuffEnum = lt.BuffEnum
local AgentManager = lt.AgentManager
local CommonUtil = lt.CommonUtil
local AutoFightManager = lt.AutoFightManager
local SkillCdManager = lt.SkillCdManager
local SkillModule = lt.SkillModule

HeroAgent._heroData     = nil
HeroAgent._isSelf       = nil
HeroAgent._heroActor    = nil
HeroAgent._stateMachine = nil
HeroAgent._isOutOfGame  = nil

HeroAgent._cmdSystem = nil
HeroAgent._bufferSystem = nil

-- MN，地图上的格子坐标(m横轴,n纵轴) -> 与服务器对应 
HeroAgent._mCur = nil
HeroAgent._nCur = nil

HeroAgent._targetAgentId = nil
HeroAgent._skillId = nil
HeroAgent._autoSkillIdArray = nil
HeroAgent._selfSkillIdArray = nil
HeroAgent._isSkillIdUsed = nil

HeroAgent._customTouchTarget = nil
HeroAgent._lastAttackMode = nil

HeroAgent._shotTime = nil -- 枪动作次数
HeroAgent._pickEndTime = nil -- 物品拾取保护结束时间

HeroAgent._missileIndex = 0

-- MN，上一个位置
HeroAgent._mLast = nil
HeroAgent._nLast = nil

--[[
    天炼技能说明: 同时只支持3个技能 2个持续技能，1个即时技能

    _skillId         即时技能
    _skillDelayTable 延迟技能[skillId] = count 持续释放的次数
]] 

-- heroActor为node,agent是管理器
function HeroAgent:ctor(heroData, m, n, direction, isSelf)
    HeroAgent.super.ctor(self, Constant.AGENT_TYPE_HERO)

    self._heroData = heroData
    self._mCur = m
    self._nCur = n
    self._isSelf = isSelf or false
    self._customTouchTarget = true
    self._elementalID = nil --所属元素ID
    self._raceType = self._heroData:getRace()
    self._preBorderAgentObjId = nil
    self._transformId = SkillEnum.TRANSFORM.NONE


    -- 初始化天炼技能信息
    self:InitSkill()

    -- 持续特效初始化
    self._playingEffectIdMap = {}

    -- 是否检查过跳转状态
    self._checkSendingProtalMap = {}

    if self._isSelf then
        -- lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MINIMAP_ADD_MN, {agentId=self._agentId,m=m,n=n,colorType=Constant.MINIMAP_WHITE,isSelf=true})
        lt.GameModule:addUpdateEventMiniMap(lt.NtfManager.NTF.NTF_MINIMAP_ADD_MN, {agentId=self._agentId,m=m,n=n,colorType=Constant.MINIMAP_WHITE,isSelf=true})
    else
        local myTeamid = lt.GameModule:getHeroData():getTeamId()
        if myTeamid ~= 0 and myTeamid == self._heroData:getTeamId() then
            lt.GameModule:addUpdateEventMiniMap(lt.NtfManager.NTF.NTF_MINIMAP_ADD_MN, {agentId=self._agentId,m=m,n=n,colorType=Constant.MINIMAP_YELLOW})
        else
            lt.GameModule:addUpdateEventMiniMap(lt.NtfManager.NTF.NTF_MINIMAP_ADD_MN, {agentId=self._agentId,m=m,n=n,colorType=Constant.MINIMAP_BLUE})
        end
        -- lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MINIMAP_ADD_MN, {agentId=self._agentId,m=m,n=n,colorType=Constant.MINIMAP_BLUE})
       
    end

    -- 转换为地图坐标 heroActor为node,agent是管理器 agent会将x,y透传到actor
    local actorX, actorY = lt.MapUtil:calcMNMid(self._mCur, self._nCur)
    self._heroActor = lt.HeroActor.new(self._heroData, direction, self._isSelf)
    self:setAgent()
    if heroData:isAlive() then
        -- TODO 是否乘骑状态 param: HeroStateIdle || HeroStateMountIdle
        if self:hasBuffer(BuffEnum.EFFECT_CLASS_SLAYER_MOUNT) then
            self._stateMachine = lt.StateMachine.new(lt.HeroStateMountIdle.new(self), lt.HeroStateGlobal.new(self), self._isSelf)
        else
            self._stateMachine = lt.StateMachine.new(lt.HeroStateIdle.new(self), lt.HeroStateGlobal.new(self), self._isSelf)
        end
        
        self._isOutOfGame = false
    else
        self._heroActor:setDead()
        
        self._stateMachine = lt.StateMachine.new(lt.HeroStateDie.new(self,true), lt.HeroStateGlobal.new(self), self._isSelf)
        self._isOutOfGame = false
    end

    -- 首次进入无需检查
    self:setProtalSending(self._mCur, self._nCur, true)
    
    self:setPosition(actorX, actorY)

    lt.AgentManager:addAgent(self)
    if not isSelf then
        self._cmdSystem = lt.CmdSystem.new()
    end
    self._bufferSystem = lt.BufferSystem.new(self._heroActor)

    if DEBUG > 0 then
        local rect = self:getRect()
        local spriteRect = display.newSprite("ui/common/rect.png")
        spriteRect:setAnchorPoint(0.5, 0)
        spriteRect:setScale(rect.width / 100, rect.height / 100)
        self._heroActor:addChild(spriteRect, 999999)
    end

    --self:addBuffer(2)

    if self._isSelf then
        lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_MINIMAP_ROUTE_POS, handler(self, self.minimapRoutePos), "HeroAgent:NTF_MINIMAP_ROUTE_POS")

        lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_AUTO_FIND_MAP_POS, handler(self, self.autoFindMapPos), "HeroAgent:NTF_AUTO_FIND_MAP_POS")

        -- 设置相关
        lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NET_SETTING_CHANGE, handler(self, self.onSettingChange), "HeroAgent:NET_SETTING_CHANGE")
        self:onSettingChange()

        lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_BOSS_APPEAR, handler(self, self.onBossAppearEvt), "HeroAgent:NTF_BOSS_APPEAR")
        lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_BOSS_DISAPPEAR, handler(self, self.onBossDisappearEvt), "HeroAgent:NTF_BOSS_DISAPPEAR")

        lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_MINIMAP_ROUTE_NOTICE, function(event)
            local param = event.param
            local routeArray = param.routeMNArray
            if self._heroActor then
                self._heroActor:updateAutoRouteTip(routeArray)
            end

        end, "HeroAgent:NTF_MINIMAP_ROUTE_NOTICE")

        lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_UPDATE_HERO_EQUIP_EVENT, handler(self, self.refreshRoleEquip), "HeroAgent:NTF_UPDATE_HERO_EQUIP_EVENT")
        lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_UPDATE_ITEM_CHANGE_EVENT, handler(self, self.refreshRoleItem), "HeroAgent:NTF_UPDATE_ITEM_CHANGE_EVENT")
        lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_UPDATE_AUTO_EQUIP_EVENT, handler(self, self.refreshAutoRoleEquip), "HeroAgent:NTF_UPDATE_AUTO_EQUIP_EVENT")
        lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_UPDATE_CREATURE_EVENT, handler(self, self.updateCreature), "HeroAgent:NTF_UPDATE_CREATURE_EVENT")
    end
    if self._heroData and self._heroData:getObjType() == Constant.ObjType.OBJ_PLAYER then
        lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_CHAT_LABEL_POST, handler(self, self.onChatLabelPost), "HeroAgent:NTF_CHAT_LABEL_POST")
    end

    -- 跨地图寻路，继续寻路
    local mapLinkArray, mTarget, nTarget, params = lt.AgentManager:getWorldAgent():getMapLinkRouteInfo()
    if mapLinkArray then
        -- 继续寻路
        if #mapLinkArray > 0 then
            local mapLinkFirst = mapLinkArray[1]
            table.remove(mapLinkArray, 1)

            self:onMessage({msgId=Constant.MSG_ROUTE, mTarget=mapLinkFirst:getM(), nTarget=mapLinkFirst:getN()})
        else
            self:onMessage({msgId=Constant.MSG_ROUTE, mTarget=mTarget, nTarget=nTarget})
        end
    end

    if self._isSelf then
        self._skillActor = self:getActor():getSkillActor()
        self._opacitySkillActor = self:getActor():getOpacitySkillActor()
    end

    self._casketActor = lt.CasketActor.new()
    local worldAgent = lt.AgentManager:getWorldAgent()
    if worldAgent then
        local mapActor = worldAgent:getMapAgent():getMapActor()
        mapActor:addCasketActor(self._casketActor, self)
    end

    if self._heroData:getFakeCreatureType() == Constant.FAKE_CREATURE_TYPE.FAST_MOVE_ACTION then
        local destM, destN, destDir = self._heroData:getShadowDancingDest()
        self:changeState(lt.HeroStateDancing.new(self, Constant.MOVE_RUN, direction, destM, destN, destDir))
    end
end

function HeroAgent:minimapRoutePos(event)
    local param = event.param
    local mTarget = param.posx
    local nTarget = param.posy

    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return
    end

    local mapCode = worldAgent:getMapCode()
    param.mapId = param.mapId or mapCode
    local mapCodeTarget = param.mapId

    -- 同地图寻路
    if mapCode == mapCodeTarget then
        self:onMessage({msgId=Constant.MSG_ROUTE, mTarget=mTarget, nTarget=nTarget, params = param})
    else
        -- 夸地图寻路
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = lt.StringManager:getString(lt.StringManager.KEY_NO_MAP_LINK_TIP)})
    end
end

function HeroAgent:autoFindMapPos(event)
    local param = event.param
    local mapCodeTarget = param.mapId
    if not param.pos then
        return
    end
    local mTarget = param.pos.x
    local nTarget = param.pos.y

    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return
    end

    local mapCode = worldAgent:getMapCode()
    if mapCode == mapCodeTarget then
        self:onMessage({msgId=Constant.MSG_ROUTE, mTarget=mTarget, nTarget=nTarget, params = param})
    else
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = lt.StringManager:getString(lt.StringManager.KEY_NO_MAP_LINK_TIP)})
    end
end

function HeroAgent:onClear()
    -- 从AgentManager中移除
    lt.AgentManager:removeAgent(self)

    if self._elementalID then
        local worldAgent = lt.AgentManager:getWorldAgent()
        if worldAgent  then
            worldAgent:removeElementAgent(self._elementalID) 
        end
    end

    if self._stateMachine then
        self._stateMachine:onClear()
    end
    if self._casketActor then
        self._casketActor:onClear()
        self._casketActor:removeFromParent()
        self._casketActor = nil
    end
    
    if self._heroActor then
        self._heroActor:onClear()
        self._heroActor = nil
    end

    self._skillActor = nil
    self._opacitySkillActor = nil

    if self._heroData and self._heroData:getObjType() == Constant.ObjType.OBJ_PLAYER then
        lt.NtfManager:removeNtfListenerByTag("HeroAgent:NTF_CHAT_LABEL_POST")
    end

    self._heroData = nil
    self._stateMachine = nil
    self._cmdSystem = nil
    self._bufferSystem = nil
    self._sheildEffect = nil
    self._sheidEffectlv = nil
    self._preBorderAgentObjId = nil


    -- lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MINIMAP_DEL_MN, {agentId=self._agentId})
    lt.GameModule:addUpdateEventMiniMap(lt.NtfManager.NTF.NTF_MINIMAP_DEL_MN, {agentId=self._agentId})

    if self._isSelf then
        lt.NtfManager:removeNtfListenerByTag("HeroAgent:NTF_MINIMAP_ROUTE_POS")
        lt.NtfManager:removeNtfListenerByTag("HeroAgent:NTF_AUTO_FIND_MAP_POS")
        lt.NtfManager:removeNtfListenerByTag("HeroAgent:NET_SETTING_CHANGE")
        lt.NtfManager:removeNtfListenerByTag("HeroAgent:NTF_HORSE_LEVEL")
        lt.NtfManager:removeNtfListenerByTag("HeroAgent:NTF_BOSS_APPEAR")
        lt.NtfManager:removeNtfListenerByTag("HeroAgent:NTF_BOSS_DISAPPEAR")
        lt.NtfManager:removeNtfListenerByTag("HeroAgent:NTF_MINIMAP_ROUTE_NOTICE")
        lt.NtfManager:removeNtfListenerByTag("HeroAgent:NTF_UPDATE_HERO_EQUIP_EVENT")
        lt.NtfManager:removeNtfListenerByTag("HeroAgent:NTF_UPDATE_ITEM_CHANGE_EVENT")
        lt.NtfManager:removeNtfListenerByTag("HeroAgent:NTF_UPDATE_AUTO_EQUIP_EVENT")
        lt.NtfManager:removeNtfListenerByTag("HeroAgent:NTF_UPDATE_CREATURE_EVENT")
        
        -- 清理目标信息
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SET_TARGET, {})
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SET_SKILL, {})
    end

    self._selfSkillIdArray = nil
end

function HeroAgent:setBloodyTunnelId(agent)
    if self._bloodyTunnel and self._bloodyTunnel:getActor() then
        self._bloodyTunnel:getActor():setSelect(false)
    end
    self._bloodyTunnel = agent
    if self._bloodyTunnel:getActor() then
        self._bloodyTunnel:getActor():setSelect(true)
    end
end

function HeroAgent:isInBloodyTunnel()
    if not self._bloodyTunnel or not self._bloodyTunnel:getActor() then
        return
    end
    local grids = {
        {1, 0},  -- 下
        {-1, 0}, -- 上
        {0, 1},  -- 右
        {0, -1}, -- 左
        {1, 1},  -- 右下
        {1, -1}, -- 左下
        {-1, 1}, -- 右上
        {-1, -1} -- 左上
    }
    for _, grid in ipairs(grids) do
        local tunnelM , tunnelN = self._bloodyTunnel:getMNExactly()
        if tunnelM  + grid[1] == self._mCur and tunnelN + grid[2] == self._nCur then
            return true
        end
    end
    return false
end

-- 是否变身为棺材
function HeroAgent:isTransCasket()
    return self._transformId == SkillEnum.TRANSFORM.CASKET
end

function HeroAgent:changeDarkness(darknessId)
    if not self._heroData then return end
    -- yflog:Info("HeroAgent:changeDarkness:%s name:%s",darknessId, self._heroData:getName())
    local canRemoveDarkness = false
    self._heroData:setDarkness(darknessId)
    for index, bitInfo in pairs(SkillEnum.DARKNESS_BITS) do
        if CommonUtil:isBitSet(darknessId, bitInfo.bit) == 1 then
            if bitInfo.buffId == BuffEnum.EFFECT_GROUND_VISIBLE  then
                if self:isOusters() then
                    self:addBuffer(bitInfo.buffId)
                end
            else
                if self:isSlayer() and bitInfo.buffId == BuffEnum.EFFECT_CLASS_DARKNESS or bitInfo.buffId == BuffEnum.EFFECT_CLASS_GRAY_DARKNESS then
                    if not self:hasBuffer(BuffEnum.EFFECT_CLASS_LIGHTNESS) then
                        self:addBuffer(bitInfo.buffId)
                    end
                    return 
                end
                self:addBuffer(bitInfo.buffId)
            end
        else
            -- 黑暗神力切换到黑暗之触
            if bitInfo.buffId == BuffEnum.EFFECT_CLASS_DARKNESS then
                canRemoveDarkness = true
            else
                if self:hasBuffer(bitInfo.buffId) then
                    self:delBuffer(bitInfo.buffId)
                end
            end
        end
    end
    if canRemoveDarkness then
        if self:hasBuffer(BuffEnum.EFFECT_CLASS_DARKNESS) then
            self:delBuffer(BuffEnum.EFFECT_CLASS_DARKNESS)
        end 
    end
end

function HeroAgent:isInDarkness()
    return self._heroData and self:hasBuffer(BuffEnum.EFFECT_CLASS_DARKNESS)
end

function HeroAgent:isInGrayDarkness()
    return self._heroData and self:hasBuffer(BuffEnum.EFFECT_CLASS_GRAY_DARKNESS)
end

function HeroAgent:onUpdate(dt)
    local delta = lt.GameBoard:getDeltaTime()
    if self:isInBloodyTunnel() then
        lt.SkillModule:sendBloodyTunnelMap(self._bloodyTunnel:getObjId())
        self._bloodyTunnel:getActor():setSelect(false)
        self._bloodyTunnel = nil
    end

    local worldAgent = lt.AgentManager:getWorldAgent()
    if self:getIsSelf() then
        worldAgent:getVisiblePlayers(self)
    end

    if self._stateMachine then
        self._stateMachine:onUpdate()
    end
    if self._heroActor then
        self._heroActor:onUpdate(delta)
    end
    if self._isSelf then
        -- 更新模块数据
        lt.GameModule:onUpdateAttackInterval(delta)
        self:clearSelfSkillId()
        -- 自动逻辑
        AutoFightManager:onUpdate(delta, self)
    end

    if self._casketActor then
        self._casketActor:updateCasket()
    end
end

function HeroAgent:onDelayUpdate(dt,delaylevel)
    local delta = lt.GameBoard:getDeltaTime()
    if self:isInBloodyTunnel() then
        lt.SkillModule:sendBloodyTunnelMap(self._bloodyTunnel:getObjId())
        self._bloodyTunnel:getActor():setSelect(false)
        self._bloodyTunnel = nil
    end
    if self._stateMachine then
        self._stateMachine:onUpdate()
    end
    if delaylevel > 2 then
        if not self:isAlive() then
            return
        end
    end
    if self._heroActor and delaylevel <= 3 then
        self._heroActor:onUpdate(delta,delaylevel)
    end
    if self._isSelf then
        -- 更新模块数据
        lt.GameModule:onUpdateAttackInterval(delta)
        -- 自动逻辑
        AutoFightManager:onUpdate(dt, self)
    end
    if self._casketActor and delaylevel <= 3 then
        self._casketActor:updateCasket()
    end
    local worldAgent = lt.AgentManager:getWorldAgent()
    if self:getIsSelf() then
        worldAgent:getVisiblePlayers(self)
    end
end

function HeroAgent:checkDieDelayUpdate()
    if self._delayedFrame then
        local delta = lt.GameBoard:getDeltaTime()
        for i = 1,self._delayedFrame do
            if self._stateMachine then
                self._stateMachine:onUpdate()
                if self._monsterActor then
                    self._monsterActor:onUpdate(delta,4)
                end
            end
        end
    end
end

function HeroAgent:onMessage(msg)
    if self._stateMachine then
        self._stateMachine:onMessage(msg)
    end
end

function HeroAgent:hideNameNode()
    self._heroActor:hideNameNode()
end

function HeroAgent:getSpriteSkillHideVisible()
    if not self._heroActor then
       return false 
    end
    return self._heroActor:getSpriteSkillHideVisible()
end

function HeroAgent:isSkillHide()
    if not self._heroData then
        return false
    end
    
    return self._heroData:isSkillHide()
end

-- 判断是否有物品可以捡
function HeroAgent:checkPickUp()
    if self._isSelf then
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_REFRESH_PICK_UP)
    end
end

-- 选择攻击目标
function HeroAgent:getTargetAgentMini()
    if self._targetAgentId then
        local agent = lt.AgentManager:getAgent(self._targetAgentId)
        if agent then
            return agent
        else
            self:setTargetAgentId(nil)
        end
    end

    return nil
end

---@param isNewSelect boolean 是否新选一个目标
function HeroAgent:getTargetAgent(isNewSelect, skillId)
    -- 判断当前是否有目标
    if self._targetAgentId then
        local agent = lt.AgentManager:getAgent(self._targetAgentId)
        if agent then
            return agent
        else
            self:setTargetAgentId(nil)
        end
    end
    -- if self:getAttackMode() ~= Constant.TARGET_TYPE.RACE then
    --     return--非和平模式不主动选取；目标为玩家选取对象
    -- end
    if isNewSelect then
        -- 选择新目标
        local agent, distanceMin = lt.AgentManager:getWorldAgent():selectTargetAgent(skillId)
        if agent then
            self:setTargetAgentId(agent:getAgentId())
            return agent
        else
            return nil
        end
    end
end

-- 返回周围 padding 范围内存在的怪物数量
function HeroAgent:aroundTargetAgentCount(padding)
    return lt.AgentManager:getWorldAgent():queryAroundTargetAgentCount(self, padding)
end

function HeroAgent:canPlaySkill(skillId, noTips)
    if not self:getIsSelf() then
        return true
    end

    -- 技能冷却
    if not lt.SkillCdManager:isReady(skillId) then
        return false
    end

    -- 计算魔法值
    -- if not self:hasSkillMp(skillId) then
    --     if lt.GameBoard:isNoManaTips() and not noTips then
    --         lt.GameBoard:setNoManaTips(false)

    --         lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = lt.StringManager:getString(lt.StringManager.KEY_NO_MANA_TIP)})
    --     end

    --     return false
    -- end

    if not self:canAttack() then
        return false
    end

    return true
end

function HeroAgent:checkPlaySkillBaseCondition(skillId)
    if not lt.SkillCdManager:isReady(skillId) then
        return false
    end

    if not SkillModule:isHPMPContion(skillId, self._heroData) then
        return false
    end

    -- if not self:canAttack() then
    --     return false
    -- end

    return true
end

function HeroAgent:isInSkillDistance(skillId, mTarget, nTarget)
    if not skillId then
        return false
    end

    local skillMeta = lt.CacheManager:querySkillMeta(skillId)
    return self:_isInSkillDistance(skillMeta, mTarget, nTarget)
end

--[[
    天炼攻击距离是动态值，会随属性值与等级变化
]]
function HeroAgent:_isInSkillDistance(skillMeta, mTarget, nTarget)
    if not skillMeta then
        return true
    end

    local skillId = skillMeta:getSkillId()
    local mHero, nHero = self:getMNExactly()
    local skillRange = lt.SkillModule:getAttackRect(skillId)

    return (skillRange == 0 or math.abs(mHero - mTarget) <= skillRange) and (skillRange == 0 or math.abs(nHero - nTarget) <= skillRange)
end

function HeroAgent:hasSkillToUse(mTarget, nTarget)
    local skillId, _ = self:getSkillId()
    local ret = skillId and skillId > 0 and not self:getIsSkillIdUsed(skillId) and lt.SkillCdManager:isReady(skillId)
    if ret and mTarget and nTarget then
        ret = ret and self:isInSkillDistance(self:getSkillId(), mTarget, nTarget)
    end

    return ret
end

function HeroAgent:handleSkillMsg(msg)
    if not msg then
        return
    end

    self:setSkillId(msg.skillId)
end
--[[__fmt
    params
    level 技能等级
    inState 是否为攻击状态

    handleSkill 技能释放基础条件判断与状态切换
]]
function HeroAgent:handleSkill(skillId, params)
    --设置自动释放技能状态
    if AutoFightManager:isAuto() then
        self:setAutoSkill(true)
    end 
    params = params or {}
    self._handleSkillId = skillId
    if not params.inState then
        -- 非状态中 判断距离
        if not self:canPlaySkill(skillId) then
            return false
        end
    end

    if not self:canAttack() then
        return false
    end
    local skillMeta = CacheManager:querySkillMeta(skillId)
    if not skillMeta then
        return false
    end

    print("HeroAgent:handleSkill skillId:",skillId," skillMeta level:", params.level or 0, "name:", skillMeta:getName(), "targetType:", skillMeta:getTargetType())

    -- 普攻与其他技能分开
    if not SkillCdManager:IsNormalSkill(skillId) then
        local condition, tips = self:checkSkillCondition(skillId, skillMeta)
        if not condition then
            if tips then
                lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
            end

            self:setIsSkillIdUsed(true)
            self:setSkillId(nil)
            return false
        end
    else
        -- 人族是枪的时候需要判断子弹是否足够
        local condition, tips = self:checkBulletEnough(skillId)
        if not condition then
            if tips then
                lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
            end

            self:setIsSkillIdUsed(true)
            self:setSkillId(nil)
            return false
        end
    end

    -- 释放对象
    if skillMeta:getTargetType() == Constant.SkillTargetType.SELF then
        local targetAgent = self
        if params.inState then
            self:playSkill(skillId, nil, nil, targetAgent:getAgentId())
        else
            self:changeState(lt.HeroStateSkill.new(self, skillId, nil, nil, targetAgent:getAgentId()))
        end

        self:setIsSkillIdUsed(true)

    -- 单体攻击技能
    elseif skillMeta:getTargetType() == Constant.SkillTargetType.ONE then
        -- 选择目标
        local targetAgent = self:getTargetAgentMini()
        if SkillEnum.SKILL_TRANSFUSION == skillId then
            --血液互补要求不判断攻击模式只判断种族
            if targetAgent == self then
                targetAgent = nil
                self:setTargetAgentId(nil)
            end
        elseif SkillEnum.HELP_SKILL_ID_TABLE[skillId] and (not targetAgent or self:isEnemyAgent(targetAgent)) then
            if not targetAgent or self:isEnemyAgent(targetAgent) then
                targetAgent = self
            end
        elseif SkillEnum.SKILL_INTIMATE_GRAIL == skillId then
            -- 亲密圣杯技能和亲密圣杯buff
            if (not targetAgent) or (targetAgent and targetAgent:hasBuffer(BuffEnum.EFFECT_INTIMATE_GRAIL)) then
                targetAgent = self
                if targetAgent:hasBuffer(BuffEnum.EFFECT_INTIMATE_GRAIL) then
                    -- 没目标选择一个目标
                    targetAgent = self:getTargetAgent(true, skillId)
                    -- 校验是否符合追击范围
                    if targetAgent then
                        if not self:checkChaseRange(skillId, targetAgent) then
                            targetAgent = nil
                            self:setTargetAgentId(nil)
                        end
                    end
                end
            end
        elseif skillId == SkillEnum.SKILL_ABSORB_SOUL or skillId == SkillEnum.MAGIC_EAT_CORPSE then
            -- 灵魂吸收 目标为尸体
            targetAgent = nil
            self:setTargetAgentId(nil)
            local monster = self:getMonsterBody(skillId == SkillEnum.SKILL_ABSORB_SOUL)
            if monster then
                targetAgent = monster
            end
        else
            if targetAgent and self:isFriendAgent(targetAgent) and not SkillEnum.HELP_SKILL_ID_TABLE[skillId] then
                self:setTargetAgentId(nil)
                targetAgent = nil
            end
            if not targetAgent then
                -- 没目标选择一个目标
                targetAgent = self:getTargetAgent(true, skillId)
                -- 校验是否符合追击范围
                if targetAgent then
                    if not self:checkChaseRange(skillId, targetAgent) then
                        targetAgent = nil
                        self:setTargetAgentId(nil)
                    end
                end
            end
        end

        if skillId == SkillEnum.SKILL_WILD_WOLF then
            -- 野狼 未找到目标，再找尸体
            if not targetAgent then
                self:setTargetAgentId(nil)
                local monster = self:getMonsterBody()
                if monster then
                    targetAgent = monster
                end
            end
        end

        if targetAgent then
            if not self:checkSkillTargetAgent(skillId, targetAgent) then
                self:setIsSkillIdUsed(true)
                self:setSkillId(nil)
                return false
            end

            -- 重生技能检测
            if not self:checkRebirthSkill(skillId, targetAgent) then
                self:setIsSkillIdUsed(true)
                self:setSkillId(nil)
                return false
            end

            -- 判断距离+设置方向
            local mHero, nHero = self:getMNExactly()
            local mTarget, nTarget = targetAgent:getMNExactly()

            -- 技能验证距离
            if not self:_isInSkillDistance(skillMeta, mTarget, nTarget) then
                -- 超过距离 设置使用技能+追击目标
                self:setSkillId(skillId)
                self:setDisplaySkillId(skillId)
                self:setIsSkillIdUsed(false)

                -- 切换追逐状态
                self:changeState(lt.HeroStateChase.new(self, targetAgent:getAgentId()))
                return true
            end

            -- 使用技能  设置朝向
            if mHero ~= mTarget or nHero ~= nTarget then
                local direction = lt.MapUtil:getDirectionToPosition(mHero, nHero, mTarget, nTarget)
                self:setDirection(direction)
            end

            -- 是否为攻击状态，是则直接释放技能
            if params.inState then
                self:playSkill(skillId, nil, nil, targetAgent:getAgentId())
            else
                -- 否则切换状态，释放技能
                self:changeState(lt.HeroStateSkill.new(self, skillId, nil, nil, targetAgent:getAgentId()))
            end

            if params.level and params.level > 0 then
                self:setDisplaySkillId(skillId)

                -- 判断是否释的技能不同，则清理当前技能Id
                if self:_getSkillId() and self:_getSkillId() ~= skillId then
                    self:setSkillId(nil)
                end
            end
        else
            -- TODO not HangupManager:isHangup() 不处于挂机判断
            if not params.inState and lt.GameBoard:isNoTargetTips() then
                lt.GameBoard:setNoTargetTips(false)
                lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = lt.StringManager:getString(lt.StringManager.KEY_NO_TARGET_TIP)})
            end

            self:setIsSkillIdUsed(true)
            self:setSkillId(nil)
            return false
        end

        self:setIsSkillIdUsed(true)
    elseif skillMeta:getTargetType() == Constant.SkillTargetType.ONE_AREA or skillMeta:getTargetType() == Constant.SkillTargetType.AREA then
        -- 判断是否指定了地点
        local mTarget = lt.GameBoard:getSkillMNext()
        local nTarget = lt.GameBoard:getSkillNNext()
        if not mTarget or not nTarget then
            mTarget = lt.GameBoard:getSkillMNext2()
            nTarget = lt.GameBoard:getSkillNNext2()

            if mTarget and nTarget then
                lt.GameBoard:clearSkillMNNext2()
            end
        end

        local mHero, nHero = self:getMNExactly()
        if mTarget and nTarget then
            -- 设置方向
            if not self:_isInSkillDistance(skillMeta, mTarget, nTarget) then
                if lt.GameBoard:isOutRangeTips() then
                    lt.GameBoard:setOutRangeTips(false)

                    yflog:InfoLine("The target exceeds the skill range mTarget,nTarget")
                    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = lt.StringManager:getString(lt.StringManager.KEY_OUT_SKILL_DIS_TIP)})
                end
                self:setIsSkillIdUsed(true)
                self:setSkillId(nil)
                return false
            end

            local targetAgent = self:getTargetAgentMini()
            if SkillEnum.IS_MOVE_SKILL[skillId] then
                targetAgent = nil
            end

            if lt.SkillModule:isLongPress() then
                if not targetAgent then
                    -- 没目标选择一个目标
                    targetAgent = self:getTargetAgent(true)
                    -- 校验是否符合追击范围
                    if targetAgent then
                        if not self:checkChaseRange(skillId, targetAgent) then
                            targetAgent = nil
                            self:setTargetAgentId(nil)
                        end
                    end
                end
                if not targetAgent then
                    if skillId ~= SkillEnum.SKILL_DUCKING_WALLOP then
                        targetAgent = self
                    end
                end
                if SkillEnum.IS_MOVE_SKILL[skillId] then
                    targetAgent = nil
                end

                if targetAgent then
                    mTarget,nTarget = targetAgent:getMNExactly()
                end
            end
            if mHero ~= mTarget or nHero ~= nTarget then
                -- local x1, y1 = lt.MapUtil:calcMNMid(mHero, nHero)
                -- local x2, y2 = lt.MapUtil:calcMNMid(mTarget, nTarget)
                -- local direction = lt.MapUtil:calcDirectionXY(x2 - x1, y2 - y1)
                local direction = lt.MapUtil:getDirectionToPosition(mHero, nHero, mTarget, nTarget)
                self:setDirection(direction)
            end
            if targetAgent then
                mTarget, nTarget = self:maxDirectionSkillRange(skillId, targetAgent:getAgentId(), mTarget, nTarget)
            end

            local targetAgentId = nil
            if targetAgent and not targetAgent:getIsOutOfGame() then
                targetAgentId = targetAgent:getAgentId()
            end
            if SkillEnum.IS_MOVE_SKILL[skillId] then
                targetAgentId = nil
            end
            if params.inState then
                self:playSkill(skillId, mTarget, nTarget)
            else
                self:changeState(lt.HeroStateSkill.new(self, skillId, mTarget, nTarget, targetAgentId))
            end

            if params.level and params.level > 0 then
                self:setDisplaySkillId(skillId)

                if self:_getSkillId() and self:_getSkillId() ~= skillId then
                    self:setSkillId(nil)
                end
            end

            self:setIsSkillIdUsed(true)
        else
            -- 位移技能 无需目标
            if SkillEnum.IS_MOVE_SKILL[skillId] then
                -- print('没有targetM的情况')
                self:setIsSkillIdUsed(true)
                return false
            end

            -- 判断是否有目标
            local targetAgent = self:getTargetAgentMini()
            if not targetAgent then
                -- 没目标选择一个目标
                targetAgent = self:getTargetAgent(true)
                -- 校验是否符合追击范围
                if targetAgent then
                    if not self:checkChaseRange(skillId, targetAgent) then
                        targetAgent = nil
                        self:setTargetAgentId(nil)
                    end
                end
            end

            if not targetAgent then
                targetAgent = self
            end

            if targetAgent and not targetAgent:getIsOutOfGame() then
                -- 设置方向
                local mTarget, nTarget = targetAgent:getMNExactly()

                if not self:_isInSkillDistance(skillMeta, mTarget, nTarget) and self:canMove() then
                    -- 追击
                    self:changeState(lt.HeroStateChase.new(self, targetAgent:getAgentId()))
                    return true
                end

                if (mHero ~= mTarget or nHero ~= nTarget) and (not SkillEnum.IGNORE_DIR[skillId]) then -- SkillEnum.IGNORE_DIR table里 技能需要忽略方向
                    local direction = lt.MapUtil:getDirectionToPosition(mHero, nHero, mTarget, nTarget)
                    self:setDirection(direction)
                end

                mTarget, nTarget = self:maxDirectionSkillRange(skillId, targetAgent:getAgentId(), mTarget, nTarget)
                ----------------------------------------------------------------------------

                if params.inState then
                    self:playSkill(skillId, mTarget, nTarget)
                else
                    self:changeState(lt.HeroStateSkill.new(self, skillId, mTarget, nTarget))
                end

                if params.level and params.level > 0 then
                    self:setDisplaySkillId(skillId)

                    if self:_getSkillId() and self:_getSkillId() ~= skillId then
                        self:setSkillId(nil)
                    end
                end

                self:setIsSkillIdUsed(true)
            else
                if SkillEnum.HELP_SKILL_ID_TABLE[skillId] then
                    if params.inState then
                        self:playSkill(skillId, mHero, nHero)
                    else
                        self:changeState(lt.HeroStateSkill.new(self, skillId, mHero, nHero))
                    end
                    if params.level and params.level > 0 then
                        self:setDisplaySkillId(skillId)
                    end
                    self:setIsSkillIdUsed(true)
                else
                    self:setSkillId(skillId)
                    if params.level and params.level > 0 then
                        self:setDisplaySkillId(skillId)

                        if self:_getSkillId() and self:_getSkillId() ~= skillId then
                            self:setSkillId(nil)
                        end
                    end
                    self:setIsSkillIdUsed(true)
                    return false
                end
            end
        end
    end

    return true
end

function HeroAgent:repeatSendAttack(skillId)
    local targetAgent = self:getTargetAgent()
    local mTouch = lt.GameBoard:getSkillMNext()
    local nTouch = lt.GameBoard:getSkillNNext()
    local mTarget, nTarget
    local targetObjId
    if mTouch and nTouch or not targetAgent then
        mTarget, nTarget = mTouch, nTouch
    else
        mTarget, nTarget = targetAgent:getMNExactly()
        targetObjId= targetAgent:getObjId()
    end
    
    local changeDirection = false
    local direction = self:getDirection()
    if  SkillEnum.REPEATED_CHANGE_DIR_TABLE[skillId] and mTarget and nTarget then
        local mHero, nHero = self:getMNExactly()
        direction = lt.MapUtil:getDirectionToPosition(mHero, nHero, mTarget, nTarget)
        if self._direction ~= direction then
            self:setDirection(direction)
            changeDirection = true
        end
    end
    lt.GameModule:sendAttack(skillId, direction, targetObjId, mTarget, nTarget)
    return changeDirection
end

function HeroAgent:playSkill(skillCode, mTouch, nTouch, targetAgentId, skilllevel)
    -- self:setDisplaySkillId(skillCode)
    if not skilllevel then
        skilllevel = lt.SkillModule:getSkillLevel(skillCode)
    end

    -- 熟练度处理
    local extraCode = nil
    local newSkillId = SkillEnum.NORMAL_2_MASTERY[skillCode]
    if newSkillId and lt.SkillModule:hasSkill(newSkillId) then
        extraCode = newSkillId
    end

    local params = {
        skillId = skillCode,
        fromAgentId =  self._agentId,
        targetAgentId = targetAgentId or self._targetAgentId,
        mTouch = mTouch,
        nTouch = nTouch,
        skilllevel = skilllevel,
        code = nil,
        extraCode = extraCode,
    }

    lt.SkillManager:playSkill(params)
end

function HeroAgent:playSwordSkill(skillId)
    lt.GameModule:sendSwordSwitch(skillId)
    lt.SkillCdManager:setCd(skillId)

    if skillId == Constant.SKILL_CODE.LHJF then
        lt.ChatModule:sendClientInfo(lt.StringManager:getString(lt.StringManager.KEY_SWORD_11100_USE), 21)

    elseif skillId == Constant.SKILL_CODE.LTJ then
        lt.ChatModule:sendClientInfo(lt.StringManager:getString(lt.StringManager.KEY_SWORD_11200_USE), 21)

    end
end

function HeroAgent:handleRouteMsg(msg)
    if not msg then
        return
    end

    local mHero, nHero = self:getMNExactly()
    if mHero == tonumber(msg.mTarget) and nHero == tonumber(msg.nTarget) then
        self:handleRouteCallback(msg.params)
        return
    end

    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()

    -- 目标点是否是传送点,则不屏蔽传送点寻路阻挡
    local isTransTarget = mapAgent:isTrans(msg.mTarget, msg.nTarget)

    -- 无视终点阻挡
    local route = lt.MapUtil:route(mHero, nHero, msg.mTarget, msg.nTarget, true, isTransTarget)
    if not route then
        yflog:Info("HeroAgent:handleRouteMsg does not exist in pathfinding",mHero, nHero, msg.mTarget, msg.nTarget)
        --不存在寻路,设置自动寻路结束
        if AutoFightManager:isAuto() then
            self:setSearch(false)
        end
        return
    end

    if route:getMNCount() > 0 then
        self:changeState(lt.HeroStateRoute.new(self, route, msg.params))
        return
    end
end

-- buffer
function HeroAgent:addBuffer(bufferId, time, skilllevel, source)
    -- bufferId 根据bufferId获取meta，判断buffer类型
    local buffMeta = lt.CacheManager:getBuffById(bufferId)
    if not buffMeta then
        yflog:Info("HeroAgent Config not found buffMeta --->>> buffId = %s", bufferId)
        return
    end
    yflog:Info("enter HeroAgent:addBuffer:%s", bufferId)
    if buffMeta:getBuffType() == BuffEnum.BUFFER_TYPE.SKILL then
        yflog:Info("HeroAgent:addBuffer:%s", bufferId)
        self._bufferSystem:addBuffer(bufferId, time, skilllevel, source)

        -- 刷新外观
        if bufferId == BuffEnum.EFFECT_STRIKING 
            or bufferId == BuffEnum.EFFECT_CLASS_REDIANCE
        then
            self:updateCreature()
        end

    elseif buffMeta:getBuffType() == BuffEnum.BUFFER_TYPE.ITEM then
        self._bufferSystem:addItemBuffer(bufferId, self, source.srcId, source)
    end
end

function HeroAgent:delBuffer(bufferId, time)
    yflog:Info("HeroAgent:delBuffer: bufferId:%s time:%s", bufferId, time)
    self._bufferSystem:delBuffer(bufferId)
    if bufferId == BuffEnum.EFFECT_STRIKING 
    or bufferId == BuffEnum.EFFECT_CLASS_REDIANCE
    then
        self:updateCreature()
    end
end

 -- 恢复buff
function HeroAgent:resumeAllBuffer()
    self._bufferSystem:resumeAllBuffer()
end

function HeroAgent:clearAllBuffer()
    self._bufferSystem:clearAllBuffer()
end

function HeroAgent:hasBuffer(bufferId)
    if not self._bufferSystem then
        return false
    end

    return self._bufferSystem:getBuffer(bufferId) ~= nil
end

function HeroAgent:getBufferLvl(bufferId)
    if not self._bufferSystem then
        return 0
    end

    return self._bufferSystem:getBufferLvl(bufferId)
end

function HeroAgent:getBufferLvlLimit(buffId,lvl)
    return self:hasBuffer(buffId) and (self:getBufferLvl(buffId) >= lvl)
end

function HeroAgent:getBufferIsExit(bufferId)
    if not self._bufferSystem then
        return false
    end

    return self._bufferSystem:getBufferIsExit(bufferId)
end

function HeroAgent:getBuffer(bufferId)
    if not self._bufferSystem then
        return false
    end

    return self._bufferSystem:getBuffer(bufferId)
end

function HeroAgent:getBufferTable()
    if not self._bufferSystem then
        return nil
    end
    
    return self._bufferSystem:getBufferTable()
end

-- 能否移动
function HeroAgent:canMove()
    local buffCanMove = self._bufferSystem:canMove()
    local heroDataCanMove = self._heroData:canMove()
    local isNotTurning = not self._heroActor:isTurning()
    local isNotInCasket = not self._casketActor:isInCasket()
    return buffCanMove and heroDataCanMove and isNotInCasket and isNotTurning
end

-- 能否攻击
function HeroAgent:canAttack()
    return self._bufferSystem:canAttack() and self._heroData:canAttack()
end

-- 能否位移攻击
function HeroAgent:canMoveAttack()
    return self._bufferSystem:canMoveAttack()
end

-- 攻击冷却
function HeroAgent:getAttackCd()
    if not self._isSelf then
        return 0, 1
    end

    return lt.GameModule:getAttackCd()
end


function HeroAgent:setAttackCd(skillId)
    if not self._isSelf then
        return
    end

    lt.GameModule:setAttackCd(skillId)
end

-- 判断是否在攻击范围内
function HeroAgent:isInAttackDistance(mTarget, nTarget)
    local mHero, nHero = self:getMNExactly()
    
    if math.max(math.abs(mTarget - mHero), math.abs(nTarget - nHero)) <= 1 then
        return true
    else
        return false
    end
end

 -- TODO 无调用 
-- 处理摇杆或者点击移动
-- 返回值：moveType, direction, mNext, nNext
function HeroAgent:handleControlParam(controlParam)
    if not controlParam.touchMovePoint and not controlParam.moveType then
        return Constant.MOVE_NONE
    end

    local mHero, nHero = self:getMNExactly()
    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()

    if controlParam.touchMovePoint then
        local mTarget, nTarget = mapAgent:calcMNInMap(controlParam.touchMovePoint)
        return mapAgent:calcTouchMove(mHero, nHero, mTarget, nTarget)
    else
        -- 摇杆移动
        return mapAgent:calcJoyStickMove(mHero, nHero, controlParam.moveType, controlParam.moveDirection)
    end
end

-- State
function HeroAgent:changeState(newState)
    -- if self._isSelf then
    --     print("changeState from "..self:getCurStateId() .. " to "..newState:getStateId().."\n"..debug.traceback("", 2))
    -- end
    if not self._stateMachine then
       return 
    end
    self._stateMachine:changeState(newState)
end

function HeroAgent:defaultState()
    if not self._heroData then
        return
    end
    -- TODO 是否乘骑状态
    if self._heroData:isAlive() then
        if self:hasBuffer(BuffEnum.EFFECT_CLASS_SLAYER_MOUNT) then
            self:changeState(lt.HeroStateMountIdle.new(self))
        else
            self:changeState(lt.HeroStateIdle.new(self))
        end
    else
        if self._transformId == SkillEnum.TRANSFORM.NONE then
            self:changeState(lt.HeroStateDead.new(self))
        else
            --有变身则需要执行系列动作落点位置取消变身再死
            self:changeState(lt.HeroStateIdle.new(self))
        end
    end
end

function HeroAgent:isInStateId(stateId)
    return self._stateMachine:isInStateId(stateId)
end

function HeroAgent:isDead()
    return self:isInStateId(Constant.HERO_STATE_DIE) or self:isInStateId(Constant.HERO_STATE_DEAD)
end

function HeroAgent:isRoute()
    return self:isInStateId(Constant.HERO_STATE_ROUTE)
end

function HeroAgent:getCurState()
    return self._stateMachine:getCurState()
end

function HeroAgent:getCurStateId()
    if not self._stateMachine then
        return
    end
    return self._stateMachine:getCurStateId()
end

function HeroAgent:isStateIdle()
    return self:getCurStateId() == Constant.HERO_STATE_IDLE
end

function HeroAgent:isStateShot()
    return self:getCurStateId() == Constant.HERO_STATE_SHOT
end

function HeroAgent:isStateSkill()
    return self:getCurStateId() == Constant.HERO_STATE_SKILL
end

function HeroAgent:isAttackDummy()
    return self:getCurStateId() == Constant.HERO_STATE_ATTACK_DUMMY
end

function HeroAgent:isStateChase()
    return self:getCurStateId() == Constant.HERO_STATE_CHASE
end

function HeroAgent:isStateTelePort()
    return self:getCurStateId() == Constant.HERO_STATE_TELEPORT
end

-- 命令
function HeroAgent:handleCmd(cmd)
    if cmd:getCmdId() == Constant.CmdId.CMD_MOVE then
        self:move(cmd:getMoveType(), cmd:getDirection(), cmd:getMNext(), cmd:getNNext())
    elseif cmd:getCmdId() == Constant.CmdId.CMD_ATTACK then
        self:attack(cmd)
    elseif cmd:getCmdId() == Constant.CmdId.CMD_DIE then
        self:die(cmd:getM(), cmd:getN(), cmd:getDirection())
    elseif cmd:getCmdId() == Constant.CmdId.CMD_IDLE then
        self:idle(cmd:getM(), cmd:getN(), cmd:getDirection())
    elseif cmd:getCmdId() == Constant.CmdId.CMD_JUMP then
        self:jump(cmd)
    elseif cmd:getCmdId() == Constant.CmdId.CMD_MOUNT then
        self:mount(cmd:getM(), cmd:getN(), cmd:getDirection())
    elseif cmd:getCmdId() == Constant.CmdId.CMD_TRANSFORM then
        self:changeState(lt.HeroStateTransform.new(self, cmd:getBuffId(), cmd:getIsExist(), cmd:getState(), cmd:getSrcId()))
    elseif cmd:getCmdId() == Constant.CmdId.CMD_PROPERTY then
        self:propertyChange(cmd:getProperty(),cmd:getValue())
    end
end

function HeroAgent:propertyChange(property,value)
    if property == lt.ServerClientEnum.CreatureValueDef.Attr_Hide then
        self:changeSkillHide(value)
    elseif property == lt.ServerClientEnum.CreatureValueDef.Attr_MoveSpeedRate then
        self:getRoleData():setValue(property, value)
    end
end

function HeroAgent:move(moveType, direction, mNext, nNext)
    if not self:canMove() then return end
    -- TODO 乘骑状态判断 
    if self:hasBuffer(BuffEnum.EFFECT_CLASS_SLAYER_MOUNT) then
        self:changeState(lt.HeroStateMountMove.new(self, moveType, direction, mNext, nNext))
    else
        self:changeState(lt.HeroStateMove.new(self, moveType, direction, mNext, nNext))
    end 
end

function HeroAgent:jump(cmd)
    lt.GameModule:agentJump(cmd:getProto())
end

function HeroAgent:attack(cmd)
    self:changeState(lt.HeroStateAttackDummy.new(self, cmd))
end

function HeroAgent:die(m, n, direction)
    self:setPosition(lt.MapUtil:calcMNMid(m, n))
    self:setDirection(direction)
    self._heroActor:setDie()
    
    self:changeState(lt.HeroStateDie.new(self))
end

function HeroAgent:idle(m, n, direction)
    self:setPosition(lt.MapUtil:calcMNMid(m, n))
    self:setDirection(direction)

    -- TODO 坐骑状态判断 
    if self:hasBuffer(BuffEnum.EFFECT_CLASS_SLAYER_MOUNT) then
        self:changeState(lt.HeroStateMountIdle.new(self))
    else
        self:changeState(lt.HeroStateIdle.new(self))
    end
end

