-- 位移
function HeroAgent:getRect()
    --FIX 
    -- local modelMeta = self:getModelMeta()
    -- if modelMeta then
    --     modelRadius = modelMeta:getRadius()
    --     modelHeight = modelMeta:getHeight()
    -- end
    -- TODO 人物模型高度配置，先固定48,77 可以选中
    if self:isDead() and self:getRoleRace() ~= Constant.RaceType.Vampire then
       return self:getDieRect() 
    end
    local transformId = self:getTransformId()
    if transformId > 0 then
        return self:getTransformRect(transformId) 
    end
    local x, y = self:getPosition()
    return cc.rect(x - 24, y, 48, 77)
end

function HeroAgent:getTransformId()
    return self._transformId
end
function HeroAgent:setTransformId(transformId)
    self._transformId = transformId
end

function HeroAgent:getDieRect()
    local x, y = self:getPosition()
    return cc.rect(x - 24, y - 12, 77, 48)
end

function HeroAgent:getTransformRect(transformId)
    local modelId = SkillEnum.TRANSFORM_MODELID[transformId]
    local modelRadius = 0
    local modelHeight = 0
    local offsetX = 0
    local offsetY = 0
    local modelMeta = CacheManager:getModelMeta(modelId)
    if modelMeta then
        modelRadius = modelMeta:getRadius()
        modelHeight = modelMeta:getHeight()
        offsetX = modelMeta:getOffsetX()
        offsetY = modelMeta:getOffsetY()
    end

    local x, y = self:getPosition()
    local ox, oy = 0, 100
    local radiusScale = (ox ~= 0) and 4 or 2

    return cc.rect(x - modelRadius + offsetX + ox, y + offsetY + oy, modelRadius * radiusScale, modelHeight)
end


-- 获取角色移动速度
function HeroAgent:getMoveSpeed(moveType)
    local moveSpeed = 0
    if moveType == Constant.MOVE_RUN then
        moveSpeed = Constant:getHeroRunSpeed(self:getDirection())
    elseif moveType == Constant.MOVE_BACK then
        moveSpeed = Constant:getHeroRunSpeed(self:getDirection())
    elseif moveType == Constant.MOVE_IMMEDIATE then
        moveSpeed = Constant.HERO_WALK_SPEED
    else
        print("please override getMoveSpeed for moveType ",moveType)
        moveSpeed = Constant.HERO_WALK_SPEED
    end
    local moveRate = self._heroData:getMoveSpeed()
    if moveRate == 0 then
        moveRate = 100
    end
    local moveSpeedRate = moveRate / 100
    return moveSpeed * moveSpeedRate
end

function HeroAgent:getMN()
    local x, y = self:getPosition()
    return lt.MapUtil:calcMN(x, y)
end

function HeroAgent:getMNExactly()
    return self._mCur, self._nCur
end

function HeroAgent:setMNExactly(m, n)
    self._mCur = m
    self._nCur = n

    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return
    end
    local mapCode = worldAgent:getMapCode()
    -- 通知UI改变m,n
    -- lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MINIMAP_CHANGE_MN, {agentId=self._agentId,m=self._mCur,n=self._nCur,isSelf=self._isSelf})
    lt.GameModule:addUpdateEventMiniMap(lt.NtfManager.NTF.NTF_MINIMAP_CHANGE_MN, {mapCode=mapCode,agentId=self._agentId,m=self._mCur,n=self._nCur,isSelf=self._isSelf})
end

function HeroAgent:getPosition()
    if self._heroActor then
        return self._heroActor:getPosition()
    else
        return 0, 0
    end
end

function HeroAgent:getMapPos()
    if self._heroActor then
        return self._heroActor:getMapPos()
    else
        return 0, 0
    end
end

function HeroAgent:setPosition(x, y)
    self._heroActor:setPositionEx(x, y)
    
    local m, n = self:getMN()
    local zorderOffset = 1
    if self._heroData:getFakeCreatureType() == Constant.FAKE_CREATURE_TYPE.FAST_MOVE_ACTION then
        zorderOffset = 0
    end
    local zOrder = ((n + self._heroActor._zOrderDeltaN) * 10000 + m + self._heroActor._zOrderDeltaM + 9999) * 10 + zorderOffset
    self._heroActor:setLocalZOrder(zOrder)

    if self._isSelf then
        local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
        
        local mnIndex = MapUtil:calcMNIndex(m, n)
        if self._mLast ~= m or self._nLast ~= n then
            self._mLast = m
            self._nLast = n
            if not self._checkSendingProtalMap[mnIndex] then
                self._checkSendingProtalMap[mnIndex] = true
                self:doProtalEvent(mapAgent, m, n)
            end
        end

        -- 检查遮罩
        mapAgent:updateMapObjMask(x, y)    
    end
end

-- 入口检查并跳转
function HeroAgent:doProtalEvent(mapAgent, m, n)
    local protalSector = mapAgent:getPortalSector(m, n)
    if protalSector ~= nil then
        -- 发送跳转
        if protalSector.zoneId == nil then
            --电梯界面
            if protalSector.type == 3 then
                lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndElevator", param = {zoneIds = protalSector.zoneIds, m = m, n = n}})
            end
        else
            lt.MapModule:sendProtal(protalSector.zoneId)
        end
    else
        --检查血之祭坛跳转
        lt.MapModule:sendBloodTransfer()
    end
end

-- 当前位置无需检查入口, 通常用于首次进入某个点位
function HeroAgent:setProtalSending(m, n, flag)
    local mnIndex = MapUtil:calcMNIndex(m, n)
    self._checkSendingProtalMap[mnIndex] = flag
end

function HeroAgent:resetProtalSending()
    self._checkSendingProtalMap = {}
end

-- 安全区检查
function HeroAgent:checkSafeRectEvent()
    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
    if mapAgent:getWholeMapSafe() then
        self._isSafe = true
        return
    end
    local m, n = self:getMN()
    local safeRect = mapAgent:getSafeRect(m, n)
    self._isSafe = safeRect
end

