-- 迷幻术
function HeroAgent:setHalluCreature()
    self._isHallu = lt.Constant.HALLUMODLE[math.random(1,#lt.Constant.HALLUMODLE)]
    self:getActor():hideNodeSprite()
    self:initActionInfo()
end

function HeroAgent:unSetHalluCreature()
    self._isHallu = nil
    self:getActor():resumeNodeSpriteByRoot()
    self:initActionInfo()
end

function HeroAgent:initActionInfo()
    local actor = self:getActor()
    if actor and actor.initActionInfo then
        actor:initActionInfo()
    end
end

function HeroAgent:getIsHallu()
    return self._isHallu
end

function HeroAgent:setAutoSkill(isAutoSkill)
    AutoFightManager:setAutoSkill(isAutoSkill)
end

function HeroAgent:setSearch(isSearch)
    AutoFightManager:setSearch(isSearch)
end

function HeroAgent:stopAutoRoute()
    if self:getCurStateId() == Constant.HERO_STATE_ROUTE then
        self:onMessage({msgId = Constant.MSG_ROUTE_STOP})
    end
end

function HeroAgent:setPickUp(pickup)
    AutoFightManager:setPickUp(pickup)
end

function HeroAgent:setStopPickUp(stopPickup)
    AutoFightManager:setStopPickUp(stopPickup)
end

--更新自动战斗配置的技能
function HeroAgent:updateAutoSettingSkills()
    SkillModule:updateAutoSettingSkills()
end

--更新自动技能释放条件
function HeroAgent:updateAutoFiterSkills()
    -- 目前入口有2个，人族等级变化和装备变化
    SkillModule:updateAutoSettingSkills()
end

--是否拿枪
function HeroAgent:isGun()
    if self._isGun == nil then
        self._isGun = lt.ItemModule:checkCurEquipIsGun()
    end
    return self._isGun
end

--是否在安全区
function HeroAgent:isInSafeArea()
    return self._isSafe
end

---------------------------------------------------------------------
-- 检查是否是移动技能
function HeroAgent:checkIsMoveAction(actionId)
    -- 移动动作
    if actionId == Constant.ACTION_MOVE then
        return true
    end

    -- 人族
    if self:isSlayer() then
        return actionId == Constant.ACTION_SLAYER_MOTOR_MOVE
    end

    -- 魔族
    if self:isOusters() then
        return actionId == Constant.ACTION_OUSTERS_MOVE or actionId == Constant.ACTION_OUSTERS_FAST_MOVE_MOVE
    end

    return false
end

--是否能使用吸血技能
function HeroAgent:getCanBloodDrain()
    local targetAgentId = self:getTargetAgentId()
    if targetAgentId then
        local targetAgent = lt.AgentManager:getAgent(targetAgentId)
        local hpPercent = targetAgent:getHeroData():getHpPercent()
        if hpPercent > 1/3 then
            return false,GReadText.SKILL_BLOOD_DRAIN
        end
        if targetAgent:hasBuffer(BuffEnum.EFFECT_CLASS_BLOOD_DRAIN) then
            return false,GReadText.KET_SKILL_TIPS48
        end
        return true
    end
    return true
end

return HeroAgent