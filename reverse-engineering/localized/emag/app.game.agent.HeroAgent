function HeroAgent:setTargetAgentId(targetAgentId, noNtf, noCustom)
    if not self._isSelf then
        return
    end
    -- 取消当前目标的选中特效
    local agent = lt.AgentManager:getAgent(self._targetAgentId)
    if agent then
        agent:hideTargetMark()
    end

    -- 挖尸体判断
    -- local corpseAgent = lt.AgentManager:getAgent(targetAgentId)
    -- if self:isDigCorpse(corpseAgent) then
    --     print("HeroAgent:isDigCorpse ",targetAgentId)
    --     return
    -- end

    if noCustom then
        self._customTouchTarget = false
    elseif not targetAgentId or (self._targetAgentId and self._targetAgentId == targetAgentId and not self._customTouchTarget) then
        -- 目标变空及选中相同目标, 模式不变
        self._customTouchTarget = self._customTouchTarget
    else
        self._customTouchTarget = true
    end

    -- 选中相同的目标
    if self._targetAgentId and self._targetAgentId == targetAgentId then
        if not self:isJobZS() then
            -- lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = lt.StringManager:getString(lt.StringManager.KEY_TARGET_ATTACK_TIP)})
        end
    end
    if self._handleSkillId == SkillEnum.SKILL_ABSORB_SOUL then
        if targetAgentId then
             local agent = lt.AgentManager:getAgent(targetAgentId)
             if agent:isMonsterAgent() and not agent:isDead() then
                return
             end
        end
    elseif SkillEnum.IS_MOVE_SKILL[self._handleSkillId] then
        self._targetAgentId = nil
        return 
    end
    self._targetAgentId = targetAgentId

    if self._targetAgentId then
        -- 清空堆栈目标
        self._stackTargetObjId = nil
    
        local agent = lt.AgentManager:getAgent(targetAgentId)
    
        if agent and agent:getAgentType() ~= lt.Constant.AGENT_TYPE_NPC and not noNtf then
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SET_TARGET, {targetAgentId=targetAgentId ,targetAgentName=agent:getName(), targetAgentType=agent:getAgentType()})
        end

        -- 显示选中特效
        local agent = lt.AgentManager:getAgent(self._targetAgentId)
        if agent then
            agent:showTargetMark()
        end
       
    else
        if not noNtf then
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SET_TARGET, {})

            -- print(debug.traceback("", 2))
        end
    end
    --- 刷新技能面板
    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_UPT_SKILL_SLOT_CONDITION, {type = Constant.SLOT_CONDITION_TYPE.TARGET})
end

function HeroAgent:getTargetAgentId()
    return self._targetAgentId
end

function HeroAgent:setViewSkillId(skillId)
end

function HeroAgent:addAutoSkillId(skillId)
    if not self._autoSkillIdArray then
        self._autoSkillIdArray = {}
    end

    self._autoSkillIdArray[#self._autoSkillIdArray + 1] = skillId
end

function HeroAgent:clearAutoSkillId()
    self._autoSkillIdArray = nil
end

function HeroAgent:addSelfSkillId(skillId)
    if not self._selfSkillIdArray then
        self._selfSkillIdArray = {}
    end

    self._selfSkillIdArray[#self._selfSkillIdArray + 1] = skillId
end

function HeroAgent:clearSelfSkillId()
    self._selfSkillIdArray = nil
end

function HeroAgent:setSkillId(skillId)
    if self._skillId == skillId then
        -- 重复使用技能生效
        self:setIsSkillIdUsed(false)
        return
    end

    self:_setSkillId(skillId, false)
end

function HeroAgent:_setSkillId(skillId, setSkillIdUsed)
    if not skillId then
        self._skillId = nil

    else
        local skillMeta = lt.CacheManager:querySkillMeta(skillId)
        if not skillMeta then
            self._skillId = nil
        else
            self._skillId = skillId
            if setSkillIdUsed ~= nil then
                self:setIsSkillIdUsed(setSkillIdUsed)
            end
        end
    end

    if not self._skillId then
        self:setDisplaySkillId(nil)
    end
end

function HeroAgent:setDisplaySkillId(skillId)
    local skillMeta = lt.CacheManager:querySkillMeta(skillId)
    if not skillMeta or skillMeta:getTargetType() == Constant.SkillTargetType.SELF then
        return
    end

    self._displaySkillId = skillId

    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SET_SKILL, {skillId = self._displaySkillId})
end

function HeroAgent:getSkillValueArray(addSkillIdArray, isDump)
    local skillValueArray = {}

    -- 附加使用 (类似自动使用) 
    if addSkillIdArray then
        for _, skillId in ipairs(addSkillIdArray) do
            local priority = 0
            local skillMeta = lt.CacheManager:querySkillMeta(skillId)
            if skillMeta then
                priority = skillMeta:getAutoPriority()
            end

            skillValueArray[#skillValueArray + 1] = {skillId, priority, 0}
        end
    end

    -- 挂机时的主动技能 主动使用 SKILL
    if self._selfSkillIdArray and type(self._selfSkillIdArray) == "table" then
        for _, skillId in ipairs(self._selfSkillIdArray) do
            local priority = 0
            local skillMeta = lt.CacheManager:querySkillMeta(skillId)
            if skillMeta then
                priority = skillMeta:getSelfPriority()
            end

            skillValueArray[#skillValueArray + 1] = {skillId, priority, 1}
        end
    end

    -- -- 自动使用的技能 自动buff之类
    -- if self._autoSkillIdArray then
    --     for _, skillId in ipairs(self._autoSkillIdArray) do
    --         local priority = 0
    --         local skillMeta = lt.CacheManager:querySkillMeta(skillId)
    --         if skillMeta then
    --             priority = skillMeta:getAutoPriority()
    --         end

    --         skillValueArray[#skillValueArray + 1] = {skillId, priority, 0}
    --     end
    -- end

    -- 主动使用
    if self._skillId and self:canPlaySkill(self._skillId, true) and not self._isSkillIdUsed then
        local priority = 0
        local skillMeta = lt.CacheManager:querySkillMeta(self._skillId)
        if skillMeta then
            priority = skillMeta:getSelfPriority()
        end

        skillValueArray[#skillValueArray + 1] = {self._skillId, priority, 1}
    end

    -- if isDump then
    --     dump(addSkillIdArray, "HeroAgent:getSkillValueArray addSkillIdArray")
    --     dump(self._selfSkillIdArray, "HeroAgent:getSkillValueArray self._selfSkillIdArray")
    --     dump(self._autoSkillIdArray, "HeroAgent:getSkillValueArray self._autoSkillIdArray")
    --     dump(self._skillId, "HeroAgent:getSkillValueArray self._skillId")
    -- end

    return skillValueArray
end

function HeroAgent:getCheckSkillId()
    return self:getSkillId()
end

function HeroAgent:isNoDelaySkill()
    local skillId,_ = self:getSkillId()
    if not skillId then
        return skillId ~= nil
    end

    local skillMeta = lt.CacheManager:querySkillMeta(skillId)
    if skillMeta then
        return skillMeta:getTargetType() ~= Constant.SkillTargetType.ONE
    end

    return skillId ~= nil
end

-- 获取能使用的技能
function HeroAgent:getSkillId(addSkillIdArray, isDump)
    local skillValueArray = self:getSkillValueArray(addSkillIdArray, isDump)
    if isDump then
        dump(skillValueArray, "skillValueArray")
    end

    if #skillValueArray == 0 then
        return nil
    end

    table.sort(skillValueArray, function(skillValue1, skillValue2)
        return skillValue1[2] > skillValue2[2]
    end)

    return skillValueArray[1][1], skillValueArray[1][3]
end

function HeroAgent:_getSkillId()
    return self._skillId
end

--[[__fmt
    SkillId是否已经使用 
    isSkillIdUsed: 
        true: 已使用
        false:未使用(可暂存,继续释放)
]]
function HeroAgent:setIsSkillIdUsed(isSkillIdUsed)
    self._isSkillIdUsed = isSkillIdUsed

    -- 清理自动技能与自己的技能
    if isSkillIdUsed then
        self:clearAutoSkillId()
        self:clearSelfSkillId()
        lt.GameBoard:clearSkillNext()
        self._handleSkillId = nil
    end
end

-- 已使用的技能Id
function HeroAgent:getIsSkillIdUsed(skillId)
    if not skillId then
        return self._isSkillIdUsed
    end

    if skillId and self._skillId ~= skillId then
        -- 添加技能 返回false
        return false
    else
        -- 判断是否属于自动释放技能
        if self._selfSkillIdArray then
            for _, _skillId in ipairs(self._selfSkillIdArray) do
                if skillId == _skillId then
                    return false
                end
            end
        end
        if self._autoSkillIdArray then
            for _, _skillId in ipairs(self._autoSkillIdArray) do
                if skillId == _skillId then
                    return false
                end
            end
        end

        return self._isSkillIdUsed
    end
end

function HeroAgent:setIsOutOfGame(isOutOfGame)
    self._isOutOfGame = isOutOfGame

    if self._isOutOfGame then
        -- 死亡了
        if self._heroActor then
            -- 恢复行动
            self._heroActor:setActionPause(false)
        end
    end
end

function HeroAgent:getIsOutOfGame()
    return self._isOutOfGame
end



function HeroAgent:handleRouteCallback(params)
    if not params then
        return
    end

    if params.npcName then
        local worldAgent = lt.AgentManager:getWorldAgent()
        local npcId = worldAgent:getNpcAgentByName(params.npcName)
        if npcId then
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_CLOSE_ALL,{closeNpcDlg = true})
            lt.TaskModule:sendClickNpc(npcId)
        end
    end
end


function HeroAgent:onSettingChange()
    -- lt.AudioManager:reloadConfig(self)
    lt.AutoManager:reloadConfig(self)
    -- lt.HangupManager:reloadConfig(self)

    self._heroActor:changeBodyEffect()
end

function HeroAgent:hasSummonEntity()
    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return false
    end

    return worldAgent:hasSummonEntity(self)
end

function HeroAgent:isEnemyAgent(targetAgent)
    return not self:isFriendAgent(targetAgent)
end

function HeroAgent:isFriendAgent(targetAgent)
    if targetAgent == self then
        return true
    end
    
    --[[
        目前只 同种族 为友好
    
    if targetAgent:isHeroAgent() and self:getHeroData():getRace() == targetAgent:getHeroData():getRace() then
        return true
    else
        return false
    end
    ]]
    --[[ TODO 下面是根据攻击模式判断是否友好
    ]]
    -- if lt.HangupManager:isHangup() then
    --     if targetAgent:getAgentType() == Constant.AGENT_TYPE_MONSTER and targetAgent:isPet() then
    --         return true
    --     end
    -- end

    local attackMode = self:getAttackMode()
    if attackMode == Constant.ATTACK_MODE.ALL then

    elseif attackMode == Constant.ATTACK_MODE.RACE then
        if targetAgent:getAgentType() == Constant.AGENT_TYPE_HERO then
            return targetAgent:isSameRace()
        elseif targetAgent:getAgentType() == Constant.AGENT_TYPE_MONSTER and targetAgent:isPet() then
            return true
        end
    elseif attackMode == Constant.ATTACK_MODE.TEAM then
        local teamId = self:getTeamId()
        local targetTeamId = 0
        if targetAgent:getAgentType() == Constant.AGENT_TYPE_HERO then
            targetTeamId = targetAgent:getTeamId()
            if teamId > 0 and targetTeamId == teamId then
                return true
            end
        elseif targetAgent:getAgentType() == Constant.AGENT_TYPE_MONSTER and targetAgent:isPet() then
            -- local masterAgent = targetAgent:queryMasterAgent()
            -- if masterAgent and masterAgent == self then
            --     return true
            -- end
            -- if masterAgent then
            --     targetTeamId = masterAgent:getTeamId()
            -- end
            return true
        end
    elseif attackMode == Constant.ATTACK_MODE.GUILD then
        local myGuildId = self:getHeroData():getGuildId()
        local targetGuildId = nil
        if targetAgent:getAgentType() == Constant.AGENT_TYPE_HERO then
            if not myGuildId or myGuildId == 0 then
                return false
            end
            targetGuildId = targetAgent:getHeroData():getGuildId()
            if targetGuildId == myGuildId then
                return
            end
        elseif targetAgent:getAgentType() == Constant.AGENT_TYPE_MONSTER and targetAgent:isPet() then
            -- local masterAgent = targetAgent:queryMasterAgent()
            -- if masterAgent and masterAgent == self then
            --     return true
            -- end
            -- if not myGuildId or myGuildId == 0 then
            --     return false
            -- end
            -- if masterAgent then
            --     targetGuildId = masterAgent:getUnionName()
            -- end
            return true
        end
    end
    
    return false
end

function HeroAgent:isCustomTouchTarget()
    return self._customTouchTarget
end

function HeroAgent:getLastAttackMode()
    return self._lastAttackMode
end

function HeroAgent:setLastAttackMode(mode)
    self._lastAttackMode = mode
end

-- 获取当前英雄移动状态
function HeroAgent:getCurMoveMode()
    if self._heroData then
        return self._heroData:getMoveMode()
    else
        return 0
    end
end

--[[
    天炼skill
]]

function HeroAgent:InitSkill()
    self._skillDelayTable = {}
end

-- 延时技能是否正在释放
function HeroAgent:IsSkillDelaying(skillId)
    if not self._skillDelayTable[skillId] or self._skillDelayTable[skillId] <= 0 then
        return false
    end

    return true
end

-- 插入一次延迟技能
function HeroAgent:InsertSkillDelay(skillId)
    local count = self._skillDelayTable[skillId]
    if not count then
        count = 0
    end

    self._skillDelayTable[skillId] = count + 1
end

-- 删除一次延迟仅能
function HeroAgent:DelSkillDelay(skillId)
    if not self:IsSkillDelaying() then
        return
    end

    self._skillDelayTable[skillId] = self._skillDelayTable[skillId] - 1

    if self._skillDelayTable[skillId] == 0 then
        self._skillDelayTable[skillId] = nil
    end
end

--[[
    isDelay：持续释放的技能
]]
function HeroAgent:playEffect(skillId, isDelay, index)
    if isDelay then
        self:addDelayEffect(skillId)
        return
    end
    
    self._heroActor:playEffect(skillId, index)
end

function HeroAgent:addDelayEffect(skillId)
    self._heroActor:addDelayEffect(skillId)
end


function HeroAgent:checkTargetType(skillId)
    local canUse = true
    local skillMeta = lt.CacheManager:querySkillMeta(skillId)
    if skillMeta:getSelectTarget() > 0 and self:getTargetAgentId() == nil  then
        yflog:Info("This skill requires a target but there is no target within the current range, so it will not be released.")
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_SKILL_RELEASE_TIPS1})
        canUse = false
    end

    if skillMeta:getSelectTarget() == Constant.SelectTargetType.Self and self:getTargetAgentId() ~= self:getAgentId()  then
        yflog:Info("This skill is only released to yourself, but the target is not yourself.")
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_SKILL_RELEASE_TIPS2})
        canUse = false
    end

    --友方TODO
    return canUse
end

--是否同种族
function HeroAgent:isSameRace()
    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return
    end
    local agentHeroData = self:getHeroData()
    local heroAgent = worldAgent:getHeroAgent()
    if heroAgent:getHeroData():getRace() ~= agentHeroData:getRace() then
        return false 
    end
    return true
end

---是否是友方(同种族且善恶值为中立以下为友方)
function HeroAgent:isPeaceAgent()
    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return
    end
    local agentHeroData = self:getHeroData()
    local heroAgent = worldAgent:getHeroAgent()
    if heroAgent:getHeroData():getRace() ~= agentHeroData:getRace() then
        return false 
    else
        local tendency = agentHeroData:getTendencies()
        local tendencyId = CacheManager:getTendencyIdByValue(tendency)
        if tendencyId > 3 then
            return false
        end
        return true
    end
end

function HeroAgent:setAgent()
    self._heroActor:setAgent(self)
end

function HeroAgent:changeSight(lightLevel, darkLevel, sight)
    if self._heroActor then
        self._heroActor:changeSightNode(lightLevel, darkLevel, sight)
    end
end

--获得自身周围半径两格内是否有可挖掘的尸体或者拾取的掉落物(顺时针)
function HeroAgent:getMonsterBodyOrDropItem()
    local worldAgent = lt.AgentManager:getWorldAgent()
    local gridArray = worldAgent:getDigArray()
    local distance = CacheManager:getVariableById(Constant.Variable.PickupDistance, true) or 2
    for _, grid in ipairs(gridArray) do
        if grid.x > distance or grid.y > distance then
            break
        end
        local agent = worldAgent:queryItemAndBodyAgent(self._mCur + grid.x, self._nCur + grid.y)
        if agent then
            return agent
        end
    end
    return nil
end

-- 最近拾取描边
function HeroAgent:refreshMonsterBodyOrDropItemShader() 
    local worldAgent = lt.AgentManager:getWorldAgent()
    local gridArray = worldAgent:getDigArray()
    local distance = CacheManager:getVariableById(Constant.Variable.PickupDistance, true) or 2
    for _, grid in ipairs(gridArray) do
        if grid.x > distance or grid.y > distance then
            break
        end
        local agent = worldAgent:queryItemAndBodyAgent(self._mCur + grid.x, self._nCur + grid.y)
        if agent then
            local borderAgentObjId = agent:getObjId()
            if self._preBorderAgentObjId then
                if borderAgentObjId ~= self._preBorderAgentObjId then
                    --移除前一个描边
                    local preBorderAgent = worldAgent:getAgent(self._preBorderAgentObjId)
                    if preBorderAgent then
                        preBorderAgent:showBorder(false)
                    end
                else
                    return agent
                end
            end
            agent:showBorder(true)
            self._preBorderAgentObjId = borderAgentObjId
            return agent
        end
    end
    return nil
end

function HeroAgent:getMonsterBody(isAbsorbSoulFlag)
    local worldAgent = lt.AgentManager:getWorldAgent()
    local step = isAbsorbSoulFlag and 2 or 1
    for m = -step, step do
        for n = -step, step do
            local agent = worldAgent:queryMonsterAgent(self._mCur + m, self._nCur + n, isAbsorbSoulFlag)
            if agent then
                return agent
            end
        end
    end
    return nil
end

-- 捡物品
function HeroAgent:pickUpDrop(agent, pet)
    if not self._isSelf then
        return
    end
    local itemData = agent:getItemData()
    if not itemData then
        return
    end
    local x, y = agent:getMN()
    local petObjId = nil
    if pet then
        local monsterData = pet:getMonsterData()
        petObjId = monsterData:getObjId()
    end
    lt.GameModule:sendPickUp(itemData, x, y, petObjId)
end

function HeroAgent:refreshRoleEquip()
    self:updateCreature()

    -- 魔族装备刷新站姿
    if self:isOusters() then
        if self:getActionId() == Constant.ROLE_ACTION_IDLE or self:getActionId() == Constant.ACTION_OUSTERS_STAND then
            self:playAction(Constant.ROLE_ACTION_IDLE)
        end
    end

    --刷新是否为枪
    self._isGun = lt.ItemModule:checkCurEquipIsGun()
end

-- 更新挂机技能条件
function HeroAgent:refreshAutoRoleEquip(event)
    --如果有装备数据
    local param = event.param or {}
    local itemInfo = param.itemInfo
    if itemInfo then
        --如果变更的装备是武器或者精灵石需要刷新
        if itemInfo:getMetaKind() == Constant.EquipKind.Arms or
        itemInfo:getMetaKind() == Constant.EquipKind.ElfStone then
            --更新自动挂机技能释放条件
            self:updateAutoFiterSkills()
        end
    end
end

--背包物品更新
function HeroAgent:refreshRoleItem(event)
    local param = event.param
    local typePos = param.typePos
    if typePos == Constant.ItemTypePos.Item_InPackage then
        local item = param.item
        if item == nil then
            self:setStopPickUp(false)
        end
    end
end

-- 获取当前动作Id
function HeroAgent:getActionId()
    if self._heroActor and self._heroActor.getActionId then
        return self._heroActor:getActionId()
    end
    return nil
end

-- 升级特效
function HeroAgent:showLevelupEffect()
    local skillId = Constant.LEVELUP_TYPE.SLAYER
    local levelupEffectId = Constant.LEVELUP_TYPE.SLAYER
    if self:getRoleData():getRace() == Constant.RaceType.Vampire then
        skillId = Constant.LEVELUP_TYPE.VAMPIRE
    elseif self:getRoleData():getRace() == Constant.RaceType.Ousters then
        skillId = Constant.LEVELUP_TYPE.OUSTERS
    end
    local actionMetas = CacheManager:getActionMetas(skillId)
    if actionMetas ~= "" then
        self._heroActor:playSoleEffectByMetas(actionMetas)
    end
    local processMetas = CacheManager:getProcessMetas(skillId)
    if processMetas ~= "" then
        self._heroActor:playParallelEffectSpecial(skillId, processMetas)
    end
    self._heroActor:showLevelUpSpine()
end

function HeroAgent:showEffectByLevel()
    -- 刷新等级长显特效
    self._heroActor:showEffectByLevel()
end

function HeroAgent:getWeaponType()
    local weaponId = self._heroData:getWeapon()
    if weaponId and weaponId > 0 then
        local weaponMeta = lt.CacheManager:queryEquipMeta(weaponId)
        if weaponMeta then
            return weaponMeta:getType()
        end
    end
end

function HeroAgent:updateCreature()
    if self._heroActor and self._heroActor.updateCreature then
        local isStriking = nil
        if self:hasBuffer(BuffEnum.EFFECT_STRIKING) then
            isStriking = true
        end
        local isRediance = false
        if self:hasBuffer(BuffEnum.EFFECT_CLASS_REDIANCE) then
            isRediance = true
        end
        self._heroActor:updateCreature({isStriking = isStriking, isRediance = isRediance})
    end
end

function HeroAgent:visibleActor(isVisible)
    local worldAgent = lt.AgentManager:getWorldAgent()
    local selfHeroAgent = worldAgent:getMapAgent():getSelfHeroAgent() 
    -- -- 隐藏时，如果对方选中目标
    -- if not self:getIsSelf() and selfHeroAgent:getTargetAgentId() == self:getAgentId() and not isVisible then
    --     selfHeroAgent:setTargetAgentId(nil)
    -- end

    local actor = self:getActor()
    if actor and not tolua.isnull(actor) then
        actor:setVisible(isVisible)
        actor:getShadowActor():setVisible(isVisible)
        if self._skillActor then
            self._skillActor:setVisible(isVisible)
        end

        local shadowTurret = actor:getShadowActorTurret()
        if shadowTurret then
            shadowTurret:setVisible(isVisible)  
        end

        if selfHeroAgent:getCasketActor():isInCasket() then
            if not self._isSelf  then
                actor:setVisible(false)
                actor._nameNode:setVisible(false)

            else
                actor:getShadowActor():setVisible(false)
                actor._nameNode:setVisible(false)
            end
            return 
        else
            if self:isTransCasket() then
                actor:setVisible(false)
                actor:getShadowActor():setVisible(false)
            end
        end
        if isVisible == true and self:getHeroData():isSkillHide() then
            --隐蔽时不对名字进行设置
            return
        end
        actor._nameNode:setVisible(isVisible)
    end
end

function HeroAgent:isVampire()
    return self:getRoleRace() == Constant.RaceType.Vampire
end
function HeroAgent:isOusters()
    return self:getRoleRace() == Constant.RaceType.Ousters
end
function HeroAgent:isSlayer()
    return self:getRoleRace() == Constant.RaceType.Slayer
end

-- 血液互补 只能对鬼族释放，并且
function HeroAgent:checkSkillTargetAgent(skillId, targetAgent)
    if skillId == SkillEnum.SKILL_TRANSFUSION then
        if targetAgent:getAgentType () == Constant.AGENT_TYPE_HERO and targetAgent:isVampire() and not targetAgent:getHeroData():isFullHp() then
            return true
        end
        
        return false
    end

    return true
end

-- 检测重生技能
function HeroAgent:checkRebirthSkill(skillId, targetAgent)
    local isAlive = targetAgent:isAlive()
    local isRebirth = (skillId == SkillEnum.SKILL_RESURRECT or skillId == SkillEnum.SKILL_SOUL_REBIRTH )
    local isCorpseSkill = skillId == SkillEnum.SKILL_ABSORB_SOUL
    local isEatCorpse = skillId == SkillEnum.MAGIC_EAT_CORPSE
    local isEatCorpseWolf = skillId == SkillEnum.SKILL_WILD_WOLF
    local isTransfusion = skillId == SkillEnum.SKILL_TRANSFUSION
    if isRebirth then
        -- 无法使用
        local isHeroAgent = targetAgent:isHeroAgent()
        if isAlive or (not isHeroAgent) then
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_SKILL_LIMIT_TIPS7})
            return false
        end

        -- 只能对同族使用 提示种族不一致
        if self:getRoleRace() ~= targetAgent:getRoleRace() then
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_TARGET_NEED_SAME_RACE})
            return false
        end
    elseif isCorpseSkill then
        -- 对尸体使用
        if isAlive then
            return false
        end
    elseif isEatCorpse then
        if not targetAgent:isMonsterAgent() then
            return false
        end

        if isAlive then
            return false
        end
        
        if self:getTransformId() ~= SkillEnum.TRANSFORM.WOLF then --吞噬尸体要变身小狼才能使用
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KET_SKILL_TIPS58})
            return false
        end
    elseif isEatCorpseWolf then
        
    elseif isTransfusion then
        if self:isVampire() and targetAgent:isVampire() then
            return true
        end
    else
        if not isAlive then -- 提示目标死亡
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_TARGET_IS_DIE})
            return false
        end
    end

    return true
end

-- 技能条件检查
function HeroAgent:checkSkillCondition(skillId, skillMeta)
    -- 不能对自己释放限制
    if self:getTargetAgentId() == self:getAgentId() and not skillMeta:isToSelf() then
        return false, SkillModule.SKILL_RELESE_TIPS.LIMIT_SELF
    end

    local check, tips = self:checkBuff(skillId)
    if not check then return false, tips end

    if not SkillCdManager:isReady(skillId) then
        return false, SkillModule.SKILL_RELESE_TIPS.CD
    end

    -- 血蓝
    check, tips = self:checkHpMp(skillId, self:getRaceType())
    if not check then return false, tips end

    -- 武器 判断身上的武器、精灵石头是否满足释放条件
    check, tips = self:checkWeaponSkill(skillId)
    if not check then return false, tips end

    -- 需要道具
    check, tips = self:checkUseItemSkill(skillId)
    if not check then  return false, tips end

    check, tips = self:checkItemSpecial(skillId)
    if not check then  return false, tips end

    -- 鬼族变身
    check,tips = self:checkSkillRaceVampire(skillId)
    if not check then
        return false , tips
    end

    -- 魔族特定检测
    check,tips = self:checkRaceOusters(skillId)
    if not check then
        return false , tips
    end

    -- 人族特定检测
    check,tips = self:checkRaceSlayer(skillId)
    if not check then
        return false , tips
    end

    return true, nil
end

function HeroAgent:checkBuff(skillId)
    -- 愉悦引爆
    local hasBuffer = self:hasBuffer(BuffEnum.EFFECT_CLASS_PLEASURE_EXPLOSION)
    if hasBuffer then
        return false, SkillModule.SKILL_RELESE_TIPS.PLEASURE_EXPLOSION
    end

    -- 被吸血
    if self:hasBuffer(BuffEnum.EFFECT_CLASS_BLOOD_DRAINING) then
        return false, SkillModule.SKILL_RELESE_TIPS.BLOODYING
    end

    -- 眩晕中
    if self:hasBuffer(BuffEnum.EFFECT_BLOCK_HEAD) and skillId ~= SkillEnum.NORAML_MELEE and skillId ~= SkillEnum.NORMAL_RANGE then
        return false, SkillModule.SKILL_RELESE_TIPS.BLOCKHEAD
    end

    -- 重复buff 只播动作 FIXME isReadyBuff写的太多了
    local buffer = CacheManager:getBuffBySkillId(skillId)
    if buffer and buffer:isIntercept() then
        local isMissile = skillId == SkillEnum.SKILL_PLASMA_ROCKET_LAUNCHER or skillId == SkillEnum.SKILL_XRL_MISSILE
        if (not SkillModule:isReadyBuff(skillId)) and (not isMissile) then
            return false, SkillModule.SKILL_RELESE_TIPS.BUFFCD
        end
    end

    return true
end

-- 检查鬼族变身
function HeroAgent:checkSkillRaceVampire(skillId)
    if self:getRaceType() ~= Constant.RaceType.Vampire then return true end

    local isTransforming, transformId = SkillModule:isTransforming()
    if isTransforming then
        -- if not SkillCdManager:isReady(skillId) then
        --     return false, SkillModule.SKILL_RELESE_TIPS.CD
        -- end

        if skillId == SkillEnum.TRANSFORM_SKILL[transformId] then
            return true
        end

        -- 战争咆哮（需要变身小狼才可使用）1
        if skillId == SkillEnum.MAGIC_HOWL then
            return transformId == SkillEnum.TRANSFORM.WOLF, SkillModule.SKILL_RELESE_TIPS.TRANSFORMWOLF
        end

        -- 死亡之吻
        if skillId == lt.SkillEnum.MAGIC_BITE_OF_DEATH then
            return transformId == lt.SkillEnum.TRANSFORM.WERWOLF, SkillModule.SKILL_RELESE_TIPS.TRANSFORMWERWOLF
        end

        if skillId == lt.SkillEnum.MAGIC_EAT_CORPSE then
            if transformId == lt.SkillEnum.TRANSFORM.WOLF then
                local monster = self:getMonsterBody()
                local isExitMonster = false
                if monster then
                    isExitMonster = true
                end
                return isExitMonster, SkillModule.SKILL_RELESE_TIPS.EATCORPSE 
            else
                return false, SkillModule.SKILL_RELESE_TIPS.TRANSFORMWOLF
            end
        end

        if transformId == SkillEnum.TRANSFORM.WOLF then
            if skillId == SkillEnum.NORAML_MELEE or skillId == SkillEnum.MAGIC_HOWL then
                return true
            end
        elseif transformId == lt.SkillEnum.TRANSFORM.WERWOLF then
            if SkillEnum.WER_WOLF_USE[skillId] then
                return true
            end
        end

        return false, SkillModule.SKILL_RELESE_TIPS.TRANSFORM
    end

    if self:hasBuffer(BuffEnum.EFFECT_CLASS_STONE_SKIN) and (skillId == lt.SkillEnum.TRANSFORM_TO_WOLF or skillId == lt.SkillEnum.TRANSFORM_TO_WERWOLF) then
        return  false, SkillModule.SKILL_RELESE_TIPS.STONE_SKIN
    end

    if skillId == SkillEnum.SKILL_BLOODS_SYMPOSION and not self:hasBuffer(BuffEnum.EFFECT_BLOOD_CURSE) then -- 血之盛宴 需要血之诅咒buff
        return false, SkillModule.SKILL_RELESE_TIPS.BLOODS_SYMPOSION --"血之盛宴需要血之诅咒"
    end

    return true
end

-- 魔族特定检测
function HeroAgent:checkRaceOusters(skillId)
    if self:getRaceType() ~= Constant.RaceType.Ousters then return true end

    -- 召唤-精灵 buff
    local hasBuffer = self:hasBuffer(BuffEnum.EFFECT_SUMMON_SYLPH)
    if hasBuffer then
        -- yflog:Info(" 召唤-精灵 buff")
        return true,""
    end
    
    --魔族普通攻击 需要装备轮子
    if not SkillModule:outersMeleeLimit(skillId) then
        return false, "" 
    end

    return true
end

-- 人族特定检测
function HeroAgent:checkRaceSlayer(skillId)    
    if self:getRaceType() ~= Constant.RaceType.Slayer then return true end

     -- 枪子弹限制 子弹数量校验
    local isReadyBullet = SkillModule:checkBulletNum(skillId)
    if not isReadyBullet then
        return false, SkillModule.SKILL_RELESE_TIPS.NEED_BULLET
    end

    -- 人族烈焰指
    if skillId == SkillEnum.SKILL_PIERCING and self:getWeaponType() == Constant.WeaponType.SGGun then
        return false, SkillModule.SKILL_RELESE_TIPS.LIMIT_PIERCING
    end

    -- 安装炮塔 buff
    local hasBufferTurret = self:hasBuffer(BuffEnum.EFFECT_INSTALL_TURRET)
    if skillId == SkillEnum.SKILL_TURRET_FIRE and not hasBufferTurret then
        -- 炮塔火力
        return false, SkillModule.SKILL_RELESE_TIPS.NEED_INSTALL_TURRET
    end

    -- 人族领域等级
    local isDomainLv, msg = SkillModule:checkSlayerDomainLevel(skillId)
    if not isDomainLv then
        return false, msg
    end

    return true
end

function HeroAgent:checkBulletEnough(skillId)
    if self:getRaceType() ~= Constant.RaceType.Slayer then return true end

     -- 枪子弹限制 子弹数量校验
    local isReadyBullet = SkillModule:checkBulletNum(skillId)
    if not isReadyBullet then
        return false, SkillModule.SKILL_RELESE_TIPS.NEED_BULLET
    end

    return true
end

-- 检查血蓝
function HeroAgent:checkHpMp(skillId, race)
    -- FIXME 文字统一处理
    if not SkillModule:isHPMPContion(skillId, self._heroData) then
        if race == Constant.RaceType.Slayer then
            return false, GReadText.KET_SKILL_TIPS69 --"蓝量不足"
        elseif race == Constant.RaceType.Vampire then
            return false, GReadText.KET_SKILL_TIPS70 --"血量不足"
        elseif race == Constant.RaceType.Ousters then
            return false, GReadText.KET_SKILL_TIPS71 --"灵力不足"
        end
    end

    return true
end

-- 检查武器
function HeroAgent:checkWeaponSkill(skillId)
    local isReadyCondition, tips = SkillModule:isReadyCondition(skillId)
    if not isReadyCondition then
        return false, tips
    end
    
    return true
end

-- 检查道具
function HeroAgent:checkUseItemSkill( skillId )
    local isReadyItem, itemName = SkillModule:isReadyUseItems(skillId)
    if not isReadyItem then
        return false, string.format(SkillModule.SKILL_RELESE_TIPS.USEITEM, itemName)
    end

    return true
end

function HeroAgent:checkItemSpecial(skillId)
    --需要道具的相关条件
    local isReadyItemCondition, itemName = SkillModule:isReadyItemSpecialCondition(skillId)
    if not isReadyItemCondition then 
        return false, string.format(SkillModule.SKILL_RELESE_TIPS.USEITEM_CONDITION, itemName)
    end

    return true
end

-- ------------------ 技能条件检测end ------------------

function HeroAgent:addShotTime()
    self._shotTime = self:getShotTime() + 1
end

function HeroAgent:clearShotTime()
    self._shotTime = 0
end

function HeroAgent:getShotTime()
    if not self._shotTime then
        self._shotTime = 0
    end
    return self._shotTime
end

function HeroAgent:getCurShotCount()
    local atcor = self:getActor()
    if not atcor then
       return 1
    end

    return atcor:getCurShotCount()
end

-- 清除
function HeroAgent:clearLarSlashMultip()
    local atcor = self:getActor()
    if not atcor then
       return 
    end

    atcor:clearLarSlashMultip()
end

function HeroAgent:setElementalID(elementId)
    self._elementalID = elementId
end

-- 设置旋转射击MN
 function HeroAgent:setRotateShotMN(m, n)
    self._rotateM = m
    self._rotateN = n
end

function HeroAgent:getRotateShotMN()
    return self._rotateM, self._rotateN
end
    
-- 初始化特殊buff逻辑处理（隐身等）
function HeroAgent:addEffectStatus()


    self._casketActor:setOwnerID(self:getObjId())
    
    -- 棺材同步
    if self:hasBuffer(BuffEnum.EFFECT_CLASS_TRANSFORM_TO_CASKET) then
        local heroXY = cc.p(self:getPosition())
        self._casketActor:setPositionEx(heroXY)
        self._casketActor:addCasketSoon(0)
        -- self:visibleActor(false)
    end   

    if self:hasBuffer(BuffEnum.EFFECT_CLASS_INVISIBILITY) then
        self:getActor():getCreature():setInvisibleSoon()
    end
    local worldAgent = lt.AgentManager:getWorldAgent()

    local selfHeroAgent = worldAgent:getHeroAgent()

    if self:isInDarkness() or self:isInGrayDarkness() then
        self:visibleActor(false)
    end
    if selfHeroAgent and selfHeroAgent:isTransCasket() then
        self:getActor():setVisible(false)
        self:getActor():getShadowActor():setVisible(false)
        self:getActor()._nameNode:setVisible(false)
    end
    
    if self:isTransCasket() then
        self:getActor():getShadowActor():setVisible(false)
        return --棺材中依旧显示名字
    end
    
    self:refreshInvisibility()
    self:refreshHide()
end

-- 刷新隐身状态
function HeroAgent:refreshInvisibility()
    if self:hasBuffer(BuffEnum.EFFECT_CLASS_INVISIBILITY) then
        local worldAgent = lt.AgentManager:getWorldAgent()
        local selfHeroAgent = worldAgent:getMapAgent():getSelfHeroAgent()
        if not selfHeroAgent then
            return
        end
        local hasDetectInvisibility = selfHeroAgent:hasBuffer(BuffEnum.EFFECT_CLASS_DETECT_INVISIBILITY)
        local hasGnomesWhisper = selfHeroAgent:getBufferLvlLimit(BuffEnum.EFFECT_GNOMES_WHISPER,15) -- 魔族真实视野15级可以看到隐身
        if not selfHeroAgent:getRoleData():isVampire() and (not hasDetectInvisibility) and (not hasGnomesWhisper) then
            self:visibleActor(false)
        end
        if not selfHeroAgent:getRoleData():isVampire() and (hasDetectInvisibility or hasGnomesWhisper) and not self:isInDarkness() and not self:isInGrayDarkness() then
            self:visibleActor(true)
        end
    end
end

-- 刷新隐蔽
function HeroAgent:refreshHide()
    local isVisible = false
    local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
    if not heroAgent then
        return isVisible
    end
    
    local heroData = lt.GameModule:getHeroData()
    if heroData:isVampire() then -- 鬼族可以看到隐蔽
        isVisible = true
        return isVisible
    end

    if heroData:isOusters() and heroAgent:getBufferLvlLimit(BuffEnum.EFFECT_GNOMES_WHISPER,15) then-- 魔族加真实视野可以看到隐蔽
        isVisible = true
        return isVisible
    end


    local hasBuffer = heroAgent:hasBuffer(lt.BuffEnum.EFFECT_DETECT_HIDDEN) or heroAgent:hasBuffer(lt.BuffEnum.EFFECT_REVEALER)
    if heroData:isSlayer() and hasBuffer then -- 人族探测术可以看到隐蔽   人族启示者可以看到隐蔽
        isVisible = true
        return isVisible
    end
    self:visibleActor(isVisible)
end


function HeroAgent:checkChaseRange(skillId, targetAgent)
    local skillRange = lt.SkillModule:getAttackRect(skillId)
    local mHero,nHero = self:getMNExactly()
    local mTarget,nTarget = targetAgent:getMNExactly()
    local distanceMin = 0
    if skillRange == 0 then
        distanceMin = 0
    elseif skillRange <= 6 then
        distanceMin = 6
    elseif skillRange <= 9 then
        distanceMin = 9
    elseif skillRange <= 12 then
        distanceMin = 12
    end
    local distance = math.max(math.abs(mTarget - mHero), math.abs(nTarget - nHero))

    return distance <= distanceMin
end

