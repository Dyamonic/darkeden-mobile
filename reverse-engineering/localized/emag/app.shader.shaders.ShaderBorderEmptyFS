
return "\n\nvarying vec2 v_texCoord;\n\n\nuniform vec3 u_color;\nuniform vec3 u_tColor;\nuniform float u_flash; // Variable to control flashing\nuniform int u_isFlashing; // Use an integer to control whether to flash a variable\nuniform int u_isBorder; \nuniform float u_colorOffset; // color value magnification\n\nuniform vec3 allColor;\nuniform sampler2D u_texture;\n\nconst int SAMPLES = 10;\nvarying vec2 v_OutlineSamples[SAMPLES];\nvoid main() {\n// Get the current texture color\n    vec4 textureColor = texture2D(u_texture, v_texCoord);\n\n    vec4 newColor = vec4(textureColor.rgb, textureColor.a);\n\n//Dyeing\nfloat originB = textureColor.b * u_colorOffset; // Color value magnification adjustment (enhancement level modification magnification)\n//Remarks for modification: 2100001 body armor M equipment requires g value including 0\n    if (length(u_tColor) >= 0.0 && textureColor.b > 0.031 && textureColor.r == 0.0  && (textureColor.g >= 0.0 && textureColor.g < 0.031) && textureColor.a > 0.0)\n    {\n        newColor.r = u_tColor.r * originB;\n        newColor.g = u_tColor.g * originB;\n        newColor.b = u_tColor.b * originB;\n    }\n\n//Status dyeing\n    if ( length(allColor) > 0.0 && textureColor.a > 0.0){\n        if (allColor.r == 0.5 && allColor.g == 0.5 && allColor.b == 0.5) \n        {\n            float gray = (newColor.r + newColor.g + newColor.b) / 3.0;\n            newColor.rgb = vec3(gray, gray, gray);\n        }else{\n            newColor.rgb = newColor.rgb * allColor.rgb;\n        }\n    }\n\n    if (u_isBorder == 0){\ngl_FragColor = newColor; // Display the original texture color\n    }else{\n// Calculate edge alpha\n        float edgeAlpha = 0.0;\n        for (int i = 0; i < SAMPLES; i++) {\n            vec4 sampleColor = texture2D(u_texture, v_OutlineSamples[i]);\n            if (sampleColor.a > 0.0) {\nedgeAlpha = max(edgeAlpha, sampleColor.a); // Calculate the alpha of the edge\n            }\n        }\n\n//Set the edge color to golden yellow\n        vec4 outlineColor = vec4(u_color.r, u_color.g, u_color.b, edgeAlpha);\n\n// Calculate flash color\nvec4 flashColor = mix(vec4(1.0, 1.0, 1.0, 1.0), vec4(0.0, 0.0, 1.0, 1.0), (sin(u_flash * 3.14) + 1.0) / 2.0); // Gradient from white to blue\n\n        if(u_isFlashing==1){\n            outlineColor = flashColor;\n        }\n// Only the golden color appears at the intersection of transparent color and color\n        if (newColor.a == 0.0 && edgeAlpha > 0.0) {\ngl_FragColor = outlineColor; // The edge is golden yellow\n        } else if (newColor.a > 0.0) {\ngl_FragColor = newColor; // Display the original texture color\n        } else {\ngl_FragColor = vec4(0.0, 0.0, 0.0, 0.0); // Transparent part\n        }\n    }\n   \n    \n}\n\n\n \n"
