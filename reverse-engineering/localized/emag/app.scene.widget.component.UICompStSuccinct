--------------------服务器回调--------------------
function UICompStSuccinct:equipTransform(event)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_OPEN_STRENGTHEN_MASK, true)
    self._costImg:setVisible(false)
    --获得新装备
    self._params = event.param
    --播放特效
    self._processNode:setVisible(true)
    self._processSpine:setAnimation(0, "ZhuanHuan", false)
    self._downNode:setVisible(true)
    self._downSpine:setAnimation(0, "lizi_feiXIng", false)
end

--动画回调
function UICompStSuccinct:spineAnimationEnd(event)
    if event.type == "complete" then
        if event.animation == "XinZhuangBei" then
            self._animNode:setVisible(false)
        elseif event.animation == "ZhuanHuan" then
            self._processNode:setVisible(false)
            --展示结果界面
            local objUid = self._params.transformEquipUid
            self:showTransformResult(objUid)
            --弹出消息
            local tipStr = #self._metaList > 1 and GReadText.KEY_STRENGTHEN_TIPS77 or GReadText.KEY_STRENGTHEN_TIPS78
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = tipStr})
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_OPEN_STRENGTHEN_MASK, false)
            AudioManager:playSound(Constant.SoundEffect.EventFanfare)
        elseif event.animation == "lizi_feiXIng" then
            self._downNode:setVisible(false)
        end
    end
end

function UICompStSuccinct:checkGuide()
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.PURIFY5) then
        local btn = self:getChild("btn_yeqian2")
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, pos.y)
        GuideModule:triggerGuide(Constant.GUIDE_ID.PURIFY5, btn, pos, function()
            self:openFiterView(btn)
        end)
        return
    end

    if GuideModule:checkCanGuide(Constant.GUIDE_ID.TRANSFORM5) then
        local btn = self:getChild("btn_yeqian3")
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, pos.y)
        GuideModule:triggerGuide(Constant.GUIDE_ID.TRANSFORM5, btn, pos, function()
            self:openFiterView(btn)
        end)
        return
    end
end

function UICompStSuccinct:refreshItemNum(event)
    if event and event.name == "NTF_UPDATE_ITEM_NUMB" then
        if event.param and event.param.content then
            if self._itemContentTable and self._itemContentTable[event.param.content] then
                
            else
                return
            end
        end
    end
    if self._openViewType == SUCCINCT_TYPES.RECASTING then
        if self._itemInfo and self._cost then
            self._item:setInfo({1, self._cost, 1})
            local costs, lord = StrengthenModule:getRecastingItem(self._itemInfo)
            local canSuccinct = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, lord, {tips = false})
            if canSuccinct then
                canSuccinct = ItemModule:enoughItem(1, costs, 1, {tips = false})
            end
            self._levelupBtn:setGrayed(not canSuccinct)
        end
    elseif self._openViewType == SUCCINCT_TYPES.PURIFY then
        if self._itemInfo and self._cost then
            self._item:setInfo({1, self._cost, 1})
            local canSuccinct = ItemModule:enoughItem(1, self._cost, 1, {tips = false})
            self._levelupBtn:setGrayed(not canSuccinct)
        end
    elseif self._openViewType == SUCCINCT_TYPES.TRANSFORM then
        if self._itemInfo and self._transformMeta then
            local cost = self._transformMeta:getCostItems()
            self._transformItem:setNeedNum(ItemModule:getItemNum(tonumber(cost[1][2])), tonumber(cost[1][3]))
            local canSuccinct = ItemModule:enoughItem(1, tonumber(cost[1][2]), tonumber(cost[1][3]), {tips = false})
            self._transformBtn:setGrayed(not canSuccinct)
        end
    end
end

function UICompStSuccinct:refreshMoney()
    if self._openViewType == SUCCINCT_TYPES.RECASTING then
        if self._itemInfo then
            local costs, lord = StrengthenModule:getRecastingItem(self._itemInfo)
            local canSuccinct = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, lord, {tips = false})
            local color = canSuccinct and "[color=#00ff00]" or "[color=#ff0000]"
            local lordStr = color..CommonFunc:changeNumberShow(lord).."[/color]"
            self._costLabel:setText(string.format(GReadText.KEY_NPC_CLS_SKILL_TIPS3, _GURL.GetImageCoin..lordStr))
            if canSuccinct then
                canSuccinct = ItemModule:enoughItem(1, costs, 1, {tips = false})
            end
            self._levelupBtn:setGrayed(not canSuccinct)
        end
    end
end

