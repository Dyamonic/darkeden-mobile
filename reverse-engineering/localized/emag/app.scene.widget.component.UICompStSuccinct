function UICompStSuccinct:onTransformBtnClick()
    if self._transformMeta then
        local cost = self._transformMeta:getCostItems()
        local canTransform = ItemModule:enoughItem(tonumber(cost[1][1]), tonumber(cost[1][2]), tonumber(cost[1][3]), {tips = true})
        if canTransform then
            local str = ""
            local types = self._transformMeta:getType()
            local fromType = self._transformMeta:getTypeName()
            local toType = self._transformMeta:getTransformType()
            if types == Constant.TRANSFORMTYPE.ARMSTYPE then
                str = string.format(GReadText.KEY_STRENGTHEN_TIPS82, "[color=#00ff00]"..fromType.."→"..toType.."[/color]")
            elseif types == Constant.TRANSFORMTYPE.CLOTHESGENDER then
                str = string.format(GReadText.KEY_STRENGTHEN_TIPS83, "[color=#00ff00]"..fromType.."→"..toType.."[/color]")
            end
            str = GReadText.KEY_STRENGTHEN_TIPS81.."\n"..str
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {content = str, confirmCallback = function()
                --服务器交互
                StrengthenModule:sendEquipTransform(self._itemInfo:getItemUid(), self._transformMeta:getId())
            end})
        end
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = "Please select the equipment to be converted"})
    end
end

function UICompStSuccinct:onHelpBtnClick()
    local helpStr = GReadText.KEY_STRENGTHEN_TIPS84
    local race = GameModule:getHeroRace()
    if race == Constant.RaceType.Vampire then
        helpStr = GReadText.KEY_STRENGTHEN_TIPS85
    elseif race == Constant.RaceType.Ousters then
        helpStr = GReadText.KEY_STRENGTHEN_TIPS86
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {content = helpStr})
end

