function UICompStSuccinct:onEnter()
    self._btnPanel:addClickListener(handler(self, self.onCancelBtnClick))
    self._levelupBtn:addClickListener(handler(self, self.onLevelupBtnClick))
    self._attrlist:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    self._item:addClickListener(function()
        local cost = 703001
        if self._openViewType == SUCCINCT_TYPES.PURIFY then
            cost = StrengthenModule:getSuccinctItem(self._itemInfo, self._attr)
        else
            cost = StrengthenModule:getRecastingItem(self._itemInfo)
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = CacheManager:getItemMeta(cost), tipsType = Constant.PROPTIPS_FORM.Display})
    end)
    for k, v in ipairs(self._fiterBtns) do
        v:addClickListener(handler(self, self.openFiterBtnClick))
    end
    self._selectBtn:addClickListener(handler(self, self.onSelectBtnClick))

    self._chooseTab:getChild("btn_choose"):addClickListener(handler(self, self.onTabClick))
    self._chooselist:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onTransformClickItem))
    self._transformBtn:addClickListener(handler(self, self.onTransformBtnClick))
    self._transformBtnPanel:addClickListener(handler(self, self.onCancelBtnClick))
    self._helpBtn:addClickListener(handler(self, self.onHelpBtnClick))
    self._sureBtn:addClickListener(handler(self, self.onSureBtnClick))
    self._transformItem:addClickListener(function()
        local cost = self._transformMeta:getCostItems()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = CacheManager:getItemMeta(tonumber(cost[1][2])), tipsType = Constant.PROPTIPS_FORM.Display})
    end)
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB,
        handler(self, self.refreshItemNum), "UICompStSuccinct:refreshItemNum")
end

function UICompStSuccinct:onExit()
    self._btnPanel:removeClickListener()
    self._levelupBtn:removeClickListener()
    self._item:removeClickListener()
    for k, v in ipairs(self._fiterBtns) do
        v:removeClickListener()
    end
    self._selectBtn:removeClickListener()
    self._attrlist:removeEventListener(fgui.UIEventType.ClickItem)

    self._chooseTab:getChild("btn_choose"):removeClickListener()
    self._chooselist:removeEventListener(fgui.UIEventType.ClickItem)
    self._transformBtn:removeClickListener()
    self._transformBtnPanel:removeClickListener()
    self._helpBtn:removeClickListener()
    self._sureBtn:removeClickListener()
    self._transformItem:removeClickListener()
    NtfManager:removeNtfListenerByTag(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB, "UICompStSuccinct:refreshItemNum")
end

function UICompStSuccinct:openFiterView(sender)
    if self._openViewType == sender.fiterType then 
        return 
    end
    self._openViewType = sender.fiterType
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SELECT_SUBVIEW, self._openViewType)
end

function UICompStSuccinct:refreshView(itemInfo, subIdx)
    self:clear()
    self._itemContentTable = {}
    self._itemInfo = itemInfo
    self._openViewType = subIdx
    self._controlTab:setSelectedIndex(self._openViewType - 1)

    if self._openViewType ~= SUCCINCT_TYPES.TRANSFORM then
        if self._icon == nil then
            self._icon = fgui.UIPackage:createObject("Item", "Item")
            self._icon:insertObjectToFactory(self)
            self._icon:setPivot(0.5,0.5, true)
            self._equipIcon:addChild(self._icon)
        end
        if itemInfo then
            --选中状态
            self._icon:setItemInfo(itemInfo)
            self._nameLabel:setText(itemInfo:getName())
            self._itemNode:setPosition(29, 70)
            self._attr = StrengthenModule:transformAffix(itemInfo)
        else
            --默认状态
            self._itemNode:setPosition(154 ,70)
            self._attr = {}
        end
        self._icon:setVisible(itemInfo ~= nil)

        --消耗
        self._cost = 703001
        if self._openViewType == SUCCINCT_TYPES.RECASTING then
            --装备重铸
            self._tipsLabel:setText(GReadText.KEY_STRENGTHEN_TIPS32)
            self._levelupBtn:setText(GReadText.KEY_STRENGTHEN_TIPS33)
            self._emptyLabel:setText(GReadText.KEY_STRENGTHEN_TIPS34)
            self._warningLabel:setText(GReadText.KEY_STRENGTHEN_TIPS35)
            local costs, lord = StrengthenModule:getRecastingItem(self._itemInfo)
            self._cost = costs
            local canSuccinct = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, lord, {tips = false})
            local color = canSuccinct and "[color=#00ff00]" or "[color=#ff0000]"
            local lordStr = color..CommonFunc:changeNumberShow(lord).."[/color]"
            self._costLabel:setText(string.format(GReadText.KEY_NPC_CLS_SKILL_TIPS3, _GURL.GetImageCoin..lordStr))
            self._costLabel:setVisible(itemInfo ~= nil)
            if canSuccinct then
                canSuccinct = ItemModule:enoughItem(1, self._cost, 1, {tips = false})
            end
            self._levelupBtn:setGrayed(itemInfo == nil or not canSuccinct)

            local _itemkey = string.format("%d_%d",1,self._cost)
            self._itemContentTable[_itemkey] = true
        elseif self._openViewType == SUCCINCT_TYPES.PURIFY then
            --装备净化
            self._tipsLabel:setText(GReadText.KEY_STRENGTHEN_TIPS36)
            self._levelupBtn:setText(GReadText.KEY_STRENGTHEN_TIPS37)
            self._emptyLabel:setText(GReadText.KEY_STRENGTHEN_TIPS38)
            self._warningLabel:setText(GReadText.KEY_STRENGTHEN_TIPS39)
            self._cost = StrengthenModule:getSuccinctItem(self._itemInfo, self._attr)
            self._costLabel:setVisible(false)
            local canSuccinct = ItemModule:enoughItem(1, self._cost, 1, {tips = false})
            self._levelupBtn:setGrayed(itemInfo == nil or not canSuccinct)

            local _itemkey = string.format("%d_%d",1,self._cost)
            self._itemContentTable[_itemkey] = true
        end
        --通用逻辑
        self._item:setInfo({1, self._cost, 1})
        self._item:setVisible(itemInfo ~= nil)
        self._attrlist:setNumItems(itemInfo and #self._attr or 0)
        self._tipsLabel:setVisible(itemInfo ~= nil)
        self._emptyLabel:setVisible(itemInfo == nil)
        self._attrlist:setVisible(itemInfo ~= nil)
        self._nameLabel:setVisible(itemInfo ~= nil)
    else
        --装备转换
        self:refreshLeftView()
    end
    self._node1:setVisible(self._openViewType ~= SUCCINCT_TYPES.TRANSFORM)
    self._node2:setVisible(self._openViewType == SUCCINCT_TYPES.TRANSFORM)
    self._animFlag = false
end

function UICompStSuccinct:clear()
    self._itemInfo = nil
    if self._selectItem then
        self._selectItem:changeSelect(false)
    end
    self._selectItem = nil
    self._attr = {}
    self._transformAttr = {}
    self._transformMeta = nil
    self._controlBtn:setSelectedIndex(self._selectIdx)
end

function UICompStSuccinct:openFiterBtnClick(context)
    local sender = context:getSender()
    for fiterType = 1, table.nums(SUCCINCT_TYPES) do
        if fiterType == sender.fiterType then
            self._fiterBtns[fiterType]:setSortingOrder(3)
        else
            self._fiterBtns[fiterType]:setSortingOrder(1)
        end
    end
    self:openFiterView(sender)
end

function UICompStSuccinct:onLevelupBtnClick()
    if self._itemInfo == nil then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content =  GReadText.KEY_STRENGTHEN_TIPS87})
        return
    end
    if self._itemInfo then
        local isExit = StrengthenModule:checkStrengthenEquip(self._itemInfo)
        if not isExit then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_AUTO_TIPS10})
            return
        end
        if self._selectItem == nil then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_STRENGTHEN_TIPS40})
            return
        end
        local cost = 703001
        local lord = 0
        if self._openViewType == SUCCINCT_TYPES.PURIFY then
            cost = StrengthenModule:getSuccinctItem(self._itemInfo, self._attr)
        else
            cost, lord = StrengthenModule:getRecastingItem(self._itemInfo)
        end
        local canSuccinct = ItemModule:enoughItem(1, cost, 1, {tips = true})
        if canSuccinct then
            --检测货币
            canSuccinct = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, lord, {tips = true})
        end
        if canSuccinct then
            if self._openViewType == SUCCINCT_TYPES.RECASTING and self._selectIdx == 1 then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_CONFIRM_SUCCINCT)
            else
                self:showSuccinctConfirm()
            end
        end
    end
end

--二次确认界面
function UICompStSuccinct:showSuccinctConfirm()
    if not self._confirm then
        self._confirm = fgui.UIPackage:createObject("Strengthen", "SuccinctConfirm")
        self._confirm:insertObjectToFactory(self)
        self._confirm:setPosition(-466,-45)
        self:addChild(self._confirm)
    end
    self._confirm:refreshView(self._openViewType, self._selectItem)
    self._confirm:setVisible(true)
end

--去洗炼
function UICompStSuccinct:toSuccinct()
    --防止连续请求
    if self._animFlag then return end
    local cost = 703001
    local lord = 0
    if self._openViewType == SUCCINCT_TYPES.PURIFY then
        cost = StrengthenModule:getSuccinctItem(self._itemInfo, self._attr)
    else
        cost, lord = StrengthenModule:getRecastingItem(self._itemInfo)
        if self._confirm then
            self._confirm:closeView()
        end
    end
    local canSuccinct = ItemModule:enoughItem(1, cost, 1, {tips = true})
    if canSuccinct then
        --检测货币
        canSuccinct = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, lord, {tips = true})
    end
    if canSuccinct then
        if self._selectItem then
            --服务器交互
            self._animFlag = true
            self._index = StrengthenModule:getServerEnumByIdx(self._itemInfo, self._selectItem:getPorp()[1])
            if self._openViewType == SUCCINCT_TYPES.RECASTING then
                StrengthenModule:sendEquipRecasting(self._itemInfo:getObjId(), self._index)
            else
                StrengthenModule:sendEquipPurify(self._itemInfo:getObjId(), self._index)
            end
        end
    end
end

function UICompStSuccinct:showSuccinctResult()
    --显示结果
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_OPEN_STRENGTHEN_MASK, true)
    if self._openViewType == SUCCINCT_TYPES.RECASTING then
        -- local isFast = self._selectIdx == 1
        local isFast = true
        local newAttr = StrengthenModule:getAffixById(self._itemInfo, self._index)
        self._selectItem:startAnim(isFast, newAttr)
    else
        self._confirm:closeView()
        self._selectItem:changeSelect(false)
        self._selectItem:startCleanAnim()
        self._tailNode:setVisible(true)
        self._tailSpine:setAnimation(0, "JingHua", false)
        local tran = self._selectItem:getTran()
        tran:play(function()
            self._selectItem:endCleanAnim()
            self._tailNode:setVisible(false)
            --客户端清除数据词条
            -- local attrId = StrengthenModule:getServerEnumByIdx(self._itemInfo, self._selectItem:getPorp()[1])
            -- self._itemInfo:setValue(attrId, 0)
            if #self._attr == 1 then
                self:onCancelBtnClick()
            else
                local objId = self._itemInfo:getObjId()
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_EQUIP_VIEW, {objId = objId, noRefresh = true})
                self:refreshView(self._itemInfo, self._openViewType)
            end
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_OPEN_STRENGTHEN_MASK, false)
            AudioManager:playSound(Constant.SoundEffect.EventFanfare)
        end)
        --播几号动画
        local index = self._selectItem.index == 1 and #self._attr or #self._attr + self._selectItem.index
        self:getTransition("t"..index):play()
    end
end

