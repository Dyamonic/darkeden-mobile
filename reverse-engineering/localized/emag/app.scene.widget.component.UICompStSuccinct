--装备转换

--刷新左侧界面
function UICompStSuccinct:refreshLeftView()
    local itemInfo = self._itemInfo

    if self._icon1 == nil then
        self._icon1 = fgui.UIPackage:createObject("Item", "Item")
        self._icon1:insertObjectToFactory(self)
        self._icon1:setPivot(0.5,0.5, true)
        self._equipIcon1:addChild(self._icon1)
    end
    if itemInfo then
        self._icon1:setItemInfo(itemInfo)
    end
    self._icon1:setVisible(itemInfo ~= nil)
    self._costLoader:setVisible(itemInfo ~= nil)

    --特效是否显示
    self._costBar1:setVisible(itemInfo ~= nil)
    --刷新数据
    self._emptyLabel1:setText(GReadText.KEY_STRENGTHEN_TIPS73)
    self._emptyLabel1:setVisible(itemInfo == nil)
    self._nameLabel1:setVisible(itemInfo ~= nil)
    self._attrlist1:setVisible(itemInfo ~= nil)
    self._item:setVisible(false)
    if itemInfo then
        local itemConfig = self._itemInfo:getItemMeta()
        local lvStr = lt.StringManager:getRomeNumber(self._itemInfo:getILevel())
        self._nameLabel1:setText(itemConfig:getName()..lvStr)
        self._transformAttr = StrengthenModule:transformAffix(itemInfo)
        self._attrlist1:setNumItems(#self._transformAttr)
        self._metaList = StrengthenModule:getTransformData(itemInfo:getItemId())
    else
        self._attrlist1:setNumItems(0)
        self._metaList = {}
    end
    self._chooseTab:setVisible(#self._metaList > 1)
    self._transformBtn:setGrayed(true)
    self._transformControlTab:setSelectedIndex(0)
    --判断是否直接显示右边(一个就直接显示)
    if #self._metaList == 1 then
        self._transformMeta = self._metaList[1]
    end
    --刷新选择框
    self._chooselist:setNumItems(#self._metaList > 1 and #self._metaList or 0)
    if self._transformInfo then
        self._transformInfo:setSelect(false)
    end
    self._transformInfo = nil

    --刷新右侧
    self:refreshRightView()

    --判断是否开着结果界面，如果开着要关掉
    if self._resultNode:isVisible() then
        self._mainNode:setVisible(true)
        self._resultNode:setVisible(false)
    end
end

--刷新右侧界面
function UICompStSuccinct:refreshRightView()
    local meta = self._transformMeta
    --特效是否显示
    self._costBar2:setVisible(meta ~= nil)
    --刷新数据
    self._emptyLabel2:setText(#self._metaList <= 1 and GReadText.KEY_STRENGTHEN_TIPS73 or GReadText.KEY_STRENGTHEN_TIPS74)
    self._emptyLabel2:setVisible(meta == nil)
    self._nameLabel2:setVisible(meta ~= nil)
    self._attrlist2:setVisible(meta ~= nil)
    self._transformItem:setVisible(meta ~= nil)
    self._transformCostLabel:setVisible(meta ~= nil)
    self._costImg:setVisible(meta ~= nil)
    self._chooseText:setText(meta ~= nil and meta:getTransformType() or GReadText.KEY_STRENGTHEN_TIPS80)

    if self._icon2 == nil then
        self._icon2 = fgui.UIPackage:createObject("Item", "Item")
        self._icon2:insertObjectToFactory(self)
        self._icon2:setPivot(0.5,0.5, true)
        self._equipIcon2:addChild(self._icon2)
    end

    if self._itemInfo and meta then
        local itemConfig = CacheManager:queryEquipMeta(meta:getTransformItemIdx())
        local lvStr = lt.StringManager:getRomeNumber(self._itemInfo:getILevel())
        self._nameLabel2:setText(itemConfig:getName()..lvStr)
        self._attrlist2:setNumItems(#self._transformAttr)
        local itemInfo = clone(self._itemInfo)
        itemInfo:setItemId(meta:getTransformItemIdx())
        itemInfo:initMetaInfo()
        self._icon2:setItemInfo(itemInfo)
        self._icon2:setVisible(true)
        --消耗显示
        local cost = meta:getCostItems()
        self._transformItem:setInfo(string.format(_GURL.GetImageItem, tonumber(cost[1][2])))
        self._transformItem:setItemNums("")
        self._transformItem:setNeedNum(ItemModule:getItemNum(tonumber(cost[1][2])), tonumber(cost[1][3]))
        self._transformItem:setIconSize(68, 68)
        self._transformItem:setIconScale(0.8, 0.8)
        self._transformCostLabel:setText(CacheManager:getItemMeta(tonumber(cost[1][2])):getName())
        local canSuccinct = ItemModule:enoughItem(1, tonumber(cost[1][2]), tonumber(cost[1][3]), {tips = false})
        self._transformBtn:setGrayed(not canSuccinct)

        local _itemkey = string.format("%d_%d",tonumber(cost[1][1]),tonumber(cost[1][2]))
        self._itemContentTable[_itemkey] = true
    else
        self._attrlist2:setNumItems(0)
        self._icon2:setVisible(false)
        self._transformBtn:setGrayed(true)
    end
end

--显示结果界面
function UICompStSuccinct:showTransformResult(objUid)
    local itemdata = ItemModule:getItemByUid(objUid)
    if self._iconResult == nil then
        self._iconResult = fgui.UIPackage:createObject("Item", "Item")
        self._iconResult:insertObjectToFactory(self)
        self._iconResult:setPivot(0.5,0.5, true)
        self._iconPanel:addChild(self._iconResult)
