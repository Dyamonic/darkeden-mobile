----选角色
local CompSelectRole = class("CompSelectRole", lt.UIGButtonBase)
local RoleModule = lt.RoleModule
local Constant = lt.Constant
local RaceType = Constant.RaceType
local NtfManager = lt.NtfManager
Constant.RaceType = {
    Slayer = 1, --人类
    Vampire = 2, --吸血鬼
    Ousters = 3, --魔灵
}

local TIPS = {
    Default = "Select a character, then press Next to play. Press Create to make a new character.",
    CommonS = {
        [1] = {key = GReadText.SELECT_ROLE_1, value = "_name"},
        [2] = {key = GReadText.SELECT_ROLE_2, value = "_level"},
        [3] = {key = GReadText.SELECT_ROLE_3, value = "_STR"},
        [4] = {key = GReadText.SELECT_ROLE_4, value = "_DEX"},
        [5] = {key = GReadText.SELECT_ROLE_5, value = "_INT"},
        [6] = {key = GReadText.SELECT_ROLE_6, value = "_repute"},
        [7] = {key = GReadText.SELECT_ROLE_7, value = "_grade"},
    },

    Slayer = {
        [1] = {key = GReadText.SELECT_ROLE_8, value = "_bladeLevel"},
        [2] = {key = GReadText.SELECT_ROLE_9, value = "_swordLevel"},
        [3] = {key = GReadText.SELECT_ROLE_10, value = "_gunLevel"},
        [4] = {key = GReadText.SELECT_ROLE_11, value = "_healLevel"},
        [5] = {key = GReadText.SELECT_ROLE_12, value = "_blessLevel"},
    },
}

function CompSelectRole:ctor()
    CompSelectRole.super.ctor(self)

    self._selRoles = {}
    self._selectIndex = nil
end



function CompSelectRole:onConstruct()
    for i = 1, Constant.CREATE_ROLES_MAX do
        local selRole = self:getChild("selRole"..i)
        selRole:setSelectRoleItemInfo({index = i})
        selRole:setFromWnd(self)
        self._selRoles[i] = selRole
    end
    self._textTips = self:getChild("textTips")
    self._textTips2 = self:getChild("textTips2")
    self._tipsControl = self:getController("tips")
    self._roleSelectControl = self:getController("select")
end

function CompSelectRole:onClear()
    if self._selRoles and #self._selRoles > 0 then
        for k, _ in pairs(self._selRoles) do
            if self._selRoles[k] then
                self._selRoles[k]:onClear()
            end
            self._selRoles[k] = nil
        end
    end
    self._selRoles = nil
    self._textTips = nil
    self._textTips2 = nil
    self._tipsControl = nil
    self._roleSelectControl = nil
    self._selectIndex = nil
end

function CompSelectRole:onEnter()
    if self._selRoles and #self._selRoles > 0 then
        for k, _ in pairs(self._selRoles) do
            if self._selRoles[k] then
                self._selRoles[k]:insertObjectToFactory(self:getRegClass())
            end
        end
    end
    self._showDel = false
    self._selectIndex = RoleModule:getSelect()
    self:refreshUI()
end

function CompSelectRole:onExit()
end

function CompSelectRole:onClear()

end
function CompSelectRole:getSelectIndex()
    return self._selectIndex
end
function CompSelectRole:setSelectIndex(selectIndex)
    self._selectIndex = selectIndex
end

function CompSelectRole:switchSelect()
    self._roleSelectControl:setSelectedIndex(self._selectIndex - 1)
    local roleArray = RoleModule:getRoleArray()
    local curRole = roleArray[self._selectIndex]
    RoleModule:setSelect(self._selectIndex)
    if curRole == nil then
        self._roleSelectControl:setSelectedIndex(3)
    end
    if curRole then
        self:showTipsByRace(curRole)
    else
        self._textTips:setText(TIPS.Default)
    end
end

function CompSelectRole:showTipsByRace(raceInfo)
    local raceType = raceInfo:getJob()
    local textT = {}
    local idx = 0
    if raceType == RaceType.Slayer then
        for i = 1, #TIPS.CommonS do
            if i ~= 2 then
                --人族不要显示等级
                idx = idx + 1
                textT[idx] = TIPS.CommonS[i]
            end
        end
        for i = 1, #TIPS.Slayer do
            table.insert(textT, idx-2+i, TIPS.Slayer[i])
        end
    else
        textT = TIPS.CommonS
    end
    local result = ""
    for _, textInfo in ipairs(textT) do
        local itemstr = string.format("  %s: %s\n",textInfo.key,raceInfo[textInfo.value])
        if textInfo.key == TIPS.CommonS[7].key then
            --阶级需要显示职位
            local grade = raceInfo[textInfo.value]
            if grade == 0 then grade = 1 end
            local rankData = lt.CacheManager:getRoleRankByRaceAndLvl(raceType, grade)
            if rankData then
                itemstr = string.format("  %s: %s\n",textInfo.key,rankData:getName().." ["..grade.."]")
            end
        end
        result = result .. itemstr
    end
    self._textTips:setText(result)
end

function CompSelectRole:refreshUI()
    local roleArray = RoleModule:getRoleArray()
    self._textTips:setVisible(#roleArray > 0)
    self._textTips2:setVisible(#roleArray == 0)
    for index = 1, Constant.CREATE_ROLES_MAX do
        local roleData = roleArray[index]
        local name = ""
        if roleData then
            name = roleData:getName()
            self._selRoles[index]:createRoleModel(roleData, index)
        else
            self._selRoles[index]:setModelVisible(false)
        end
        self._selRoles[index]:setTouch(roleData ~= nil)
        self._selRoles[index]:setName(name)
    end
    self:switchSelect()
    self:playSelectAction()
end

function CompSelectRole:reportDeleteRoleInfo()
    local roleArray = RoleModule:getRoleArray()
    local idx = RoleModule:getSelect()
    local role = roleArray[self._selectIndex]
    local createTime = os.time()
    local roleId = role:getPlayerId()

    --用户唯一标识(多渠道不能重复自行拼接， 服务端已拼接)
    local uuid = _G_TOKEN

    local params = {
        timestamp = createTime,
        roleId = roleId,
        uuid = uuid,
    }
    lt.HttpApi:reportDeleteRoleInfo(params,function(code)
        yflog:Info("reportDeleteRoleInfo success code:%s",code)
    end, function(code)
        yflog:Info("reportDeleteRoleInfo fail:%s",code)
    end)
end

-- 退出场景时，停止所有动作逻辑
function CompSelectRole:stopAll()
    if self._selRoles and #self._selRoles > 0 then
        for k, _ in pairs(self._selRoles) do
            if self._selRoles[k].roleModel then
                self._selRoles[k].roleModel:stopAllActions()
            end
        end
    end
end

function CompSelectRole:delRole()
    self:reportDeleteRoleInfo()
    RoleModule:deletRole(self._selectIndex)
    self:refreshUI()

    if self._selRoles[self._selectIndex] then
        self._selRoles[self._selectIndex]:resetModel()
    end
end

function CompSelectRole:playSelectAction()
    local roleArray = RoleModule:getRoleArray()
    for index = 1, Constant.CREATE_ROLES_MAX do
        if self._selRoles[index] and self._selRoles[index]:getRoleModel() and roleArray[self._selectIndex] then
            local roleModel = self._selRoles[index]:getRoleModel()
            local curRole = roleArray[index]
            self._selRoles[index]:roleModelPlayAction(roleModel,index == self._selectIndex,curRole:getJob(),curRole:getWeaponAppr())
        end
    end
end

return CompSelectRole


