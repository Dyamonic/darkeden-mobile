function StringManager:convertLargerNumber(num)
    num = tonumber(num)
    local unit = ""
    if num >= 10000000000 then
        num = math.floor(num/100000000)
        unit = "billion"
    elseif num >= 1000000 then
        num = math.floor(num/10000)
        unit = "million"
    end
    return num..unit
end

function StringManager:convert4BitNumber(num)
    
    num = tonumber(num)
    local unit = ""
    if num >= 100000000 then
        num = math.floor(num/100000000)
        unit = "billion"
    elseif num >= 10000 then
        num = math.floor(num/10000)
        unit = "million"
    end
    return num..unit
end

