-- 仅支持了2位数数字的转换中文
function StringManager:num2Chs(num)
    num = tonumber(num)
    if not num then return end

    local len = string.len(num)
    if len > 2 then return end

    local szText = ""
    local unitNum = num%10
    local decadeNum = math.floor(num/10)

    if decadeNum ~= 0 then
        szText = (decadeNum ~= 1 and StringManager:getChsNumber(decadeNum) or "") .. StringManager:getChsNumber(10)
    end

    if unitNum ~= 0 then
        szText = szText .. StringManager:getChsNumber(unitNum)
    end

    return szText
end

-- 根据时间戳转化成天或小时,特殊物品显示时限用
-- 返回格式后字符串,默认显示颜色
function StringManager:getTimeInfo(time)
    local strArray = StringManager:getString(StringManager.KEY_SPIRIT_TIMETIP)
    local strs = ""
    local color = lt.Constant.COLOR_TEXT_RED
    if not time then
        return strs,color
    end
    if time == 0 then
        strs = strArray[1]
        color = lt.Constant.COLOR_GREEN_H
    else
        local timenum = os.time()
        local leftime = time - timenum
        if leftime > 86400 then
            strs = math.ceil(leftime/86400)..strArray[2]
        else
            strs = math.ceil(leftime/3600)..strArray[3]
        end
    end
    return strs,color
end

