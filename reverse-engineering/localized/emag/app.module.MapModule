
local MapModule = {}

local SocketApi     = lt.SocketApi
local netcmd_pb     = lt.netcmd_pb
local NpcDao        = lt.NpcDao
local NtfManager    = lt.NtfManager
local DbManager     = lt.DbManager
local ClientCmdDef  = lt.ClientCmdDef
local CommonModule  = lt.CommonModule
local ServerCmdDef  = lt.ServerCmdDef
local Constant      = lt.Constant
local CacheManager  = lt.CacheManager

MapModule._routearray  = nil
MapModule._isInSafetyArea = false
MapModule._dbNames   = {}
MapModule._listInit  = {}
MapModule._listData  = {}
MapModule._flagPosTb = {}
MapModule._Maxnum    = 10
MapModule._ownPosData= nil
MapModule._npcVampireLairInfo = nil

MapModule.FLAG_STATE = {
    NORMAL = 0,
    OVERWRITE = 1,       --拥有该标志的日志需要转移到标记为0的日志后面
}

function MapModule:init()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_MINIMAP_ROUTE_NOTICE, handler(self, self.onNtfRoutePos) , "MapModule:onNtfRoutePos")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SAFETY_AREA_IN, handler(self, self.onNtfSafeareaIn) , "MapModule:onNtfSafeareaIn")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SAFETY_AREA_OUT, handler(self, self.onNtfSafeareaOut) , "MapModule:onNtfSafeareaOut")

    -- 地图跳转点回包
    SocketApi:addProtoListener(lt.ServerCmdDef.CS_TRANSFER_RESP, handler(self, self.onProtalResp), "MapModule:onProtalResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_MAP_CHANGED_NTF), handler(self, self.onMapChangedNtf), "MapModule:onMapChangedNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_QUERY_TEAMMATE_POS_RESP), handler(self, self.onQueryTeamMatePos), "MapModule:onQueryTeamMatePos")

    --副本状态协议 
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_NPC_VAMPIRE_LAIR_INFO_NTF), handler(self, self.onNpcVampireLairInfoNtf), "MapModule:onNpcVampireLairInfoNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GATE_OF_ALTAR_NTF), handler(self, self.onGateOfAltarNtf), "MapModule:onGateOfAltarNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_ADVANCE_NTF), handler(self, self.onAdvancerNtf), "MapModule:onAdvancerNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_ALTAR_OF_BLOOD_COMMIT_RESP), handler(self, self.onAltarOfBloodCommit), "MapModule:onAltarOfBloodCommit")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_ALTAR_OF_BLOOD_NTF), handler(self, self.onAltarOfBloodNtf), "MapModule:onAltarOfBloodNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_MIRROR_OF_ABYSS_NTF), handler(self, self.onMirrorOfAbyssNtf), "MapModule:onMirrorOfAbyssNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_NPC_VAMPIRE_LAIR_INFO_RESP), handler(self, self.onNpcVampireLairInfoResp), "MapModule:onNpcVampireLairInfoResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_TRANSFER_BY_CONFIG_RESP), handler(self, self.onTransferByConfigResp), "MapModule:onTransferByConfigResp")

    --中地图
    self._showNpc = false
    self._showDungeon = true
    self._showTransmit = true
    self._showMission = true
    self._showTeamMate = true

    --大地图
    self._showPos = true
    self._showTeam = true
    self._showTask = true
    self._showEntrance = true
    self._showMapName = true
    self._showLevel = true
end

function MapModule:clear()
    NtfManager:removeNtfListenerByTag("MapModule:onNtfRoutePos")
    NtfManager:removeNtfListenerByTag("MapModule:onNtfSafeareaIn")
    NtfManager:removeNtfListenerByTag("MapModule:onNtfSafeareaOut")
    SocketApi:removeProtoListenerByTag("MapModule:onProtalResp")
    SocketApi:removeProtoListenerByTag("MapModule:onMapChangedNtf")
    SocketApi:removeProtoListenerByTag("MapModule:onQueryTeamMatePos")
    SocketApi:removeProtoListenerByTag("MapModule:onNpcVampireLairInfoNtf")
    SocketApi:removeProtoListenerByTag("MapModule:onGateOfAltarNtf")
    SocketApi:removeProtoListenerByTag("MapModule:onAdvancerNtf")
    SocketApi:removeProtoListenerByTag("MapModule:onAltarOfBloodCommit")
    SocketApi:removeProtoListenerByTag("MapModule:onAltarOfBloodNtf")
    SocketApi:removeProtoListenerByTag("MapModule:onMirrorOfAbyssNtf")
    SocketApi:removeProtoListenerByTag("MapModule:onNpcVampireLairInfoResp")
    SocketApi:removeProtoListenerByTag("MapModule:onTransferByConfigResp")

    self._routearray  = nil
    self._isInSafetyArea = false
    self._dbNames   = {}
    self._listInit  = {}
    self._listData  = {}
    self._flagPosTb = {}
    self._ownPosData = nil
    self._npcVampireLairInfo = nil

    --中地图
    self._showNpc = nil
    self._showDungeon = nil
    self._showTransmit = nil
    self._showMission = nil
    self._showTeamMate = nil

    --大地图
    self._showPos = true
    self._showTeam = true
    self._showTask = true
    self._showEntrance = true
    self._showMapName = true
    self._showLevel = true
end

function MapModule:getNpcList(mapcode)
    local infoTable = {}
    local info = NpcDao:queryAll()
    for k,v in pairs(info) do
        if v:getMapCode() == tostring(mapcode) and (v:getShowName() ~= "" and v:getShowName() ~= nil) then
            infoTable[#infoTable+1] = v
        end
    end
    return infoTable
end

function MapModule:onNtfRoutePos(event)
    self._routearray = nil
    if event.param.routeMNArray then
        self._routearray = event.param.routeMNArray
    else
        lt.AgentManager:getWorldAgent():getMapAgent():clearClickMark()
    end
end

function MapModule:getNtfRoute()
    return self._routearray
end

function MapModule:onNtfSafeareaIn(event)
    self:setInSafetyArea(true)
    lt.ChatModule:sendClientInfo(lt.StringManager:getString(lt.StringManager.KEY_MAP_INAREA), 21)
end

function MapModule:onNtfSafeareaOut(event)
    self:setInSafetyArea(false)
    lt.ChatModule:sendClientInfo(lt.StringManager:getString(lt.StringManager.KEY_MAP_OUTAREA), 22)
    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIDlgTradingInfo", close = true}) -- 离开安全区关闭 交易行
end

function MapModule:onMapChangedNtf(event)
    local proto = event.param
    local playerId = lt.GameModule:getHeroData():getPlayerId()
    if playerId ~= proto.playerId then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_TEAM_MATE_INFO, proto)
    end
end

-- 发送获取队友位置
function MapModule:sendQueryTeamMatePos(playerIdList)
    local msg = netcmd_pb.CS_QueryTeamMatePosReq()
    msg.playerIds = lt.TeamModule:getTeamMatePlayerId()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_QUERY_TEAMMATE_POS_REQ), msg)
end

-- 获取队友位置回调
function MapModule:onQueryTeamMatePos(event)
    local proto = event.param
    for i = 1, #proto.posList do
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_QUERY_TEAM_MATE_POS, proto.posList[i])
    end
end

--副本状态协议
function MapModule:onNpcVampireLairInfoNtf(event)
    local proto = event.param
    self._npcVampireLairInfo = proto
    local vampireState = proto.vampireState   -- 副本状态
    yflog:Info("--------vampireState=="..vampireState.."-mobMonsterFlag-"..tostring(proto.mobMonsterFlag).."-waveCount-"..proto.waveCount.."---"..proto.nextSateStamp)
    if proto.vampireState == CommonModule:GetNetCmdEnum("NPCVAMPIRELAIRSTATE_NPCVAMPIRELAIRSTATE_PLAYTIME_ENUM") then
        local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
        if not heroAgent then
            return
        end
        local mHero, nHero = heroAgent:getMNExactly()
        self:onTriggerArea(mHero, nHero)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_EVENTFLAG_SHAKE_SCREEN, {eventDelay = 0, parameter3 = 3, eventType = Constant.SHARK_SCREEN_TYPE.EVENTID_METEOR_SHAKE})
    elseif proto.vampireState == CommonModule:GetNetCmdEnum("NPCVAMPIRELAIRSTATE_NPCVAMPIRELAIRSTATE_PREPARATION_ENUM") then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_EVENTFLAG_SHAKE_SCREEN, {eventDelay = 300000, parameter3 = 3, eventType = Constant.SHARK_SCREEN_TYPE.EVENTID_METEOR_SHAKE})
    elseif proto.vampireState == CommonModule:GetNetCmdEnum("NPCVAMPIRELAIRSTATE_NPCVAMPIRELAIRSTATE_ENDCOUNTDOWN_ENUM") then
        -- -- 抖动
        -- 一分钟抖动 + 5s下陨石
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_EVENTFLAG_SHAKE_SCREEN, {eventDelay = 68000, parameter3 = 3, eventType = Constant.SHARK_SCREEN_TYPE.EVENTID_METEOR_SHAKE})

        lt.AgentManager:getWorldAgent():changCasketOpen()
    elseif proto.vampireState == CommonModule:GetNetCmdEnum("NPCVAMPIRELAIRSTATE_NPCVAMPIRELAIRSTATE_ENDFIREBALLTIME_ENUM") then
        local mapActor = lt.AgentManager:getWorldAgent():getMapAgent():getMapActor()
        if mapActor then
            mapActor:repeatShakeEffect()            
        end
        lt.AgentManager:getWorldAgent():changCasketOpen()
    elseif proto.vampireState == CommonModule:GetNetCmdEnum("NPCVAMPIRELAIRSTATE_NPCVAMPIRELAIRSTATE_ENDKICKOFF_ENUM") then
        -- 踢出副本
        self._npcVampireLairInfo = nil        
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_VAMPIRELAIR_INFO)
end

--副本染色状态协议
function MapModule:onGateOfAltarNtf(event)
    local proto = event.param
    self._altarGatePos = proto.pos
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DUNGEON_ALTAR)
end

function MapModule:getAltarGatePos()
    return self._altarGatePos or {}
end

--副本失败ntf
function MapModule:onAdvancerNtf(event)
    local proto = event.param
    local mapCode = proto.mapCode
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DUNGEON_FAIL)
end

function MapModule:onAltarOfBloodCommit(event)
    local proto = event.param
    if proto.ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = GReadText.KEY_TASK_TIPS9})
    end
end

--副本npc解救状态协议
function MapModule:onAltarOfBloodNtf(event)
    local proto = event.param
    self._altarBloodNpc = proto.npcId
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DUNGEON_BLOOD)
end

function MapModule:getAltarBloodNpc()
    return self._altarBloodNpc or {}
end

--副本倒计时状态协议
function MapModule:onMirrorOfAbyssNtf(event)
    local proto = event.param
    self._protectTime = proto.protectTime
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DUNGEON_TIME)
end

--界面展示信息 请求
function MapModule:onNpcVampireLairInfoReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_NPC_VAMPIRE_LAIR_INFO_REQ))
end

--界面展示信息 回包
function MapModule:onNpcVampireLairInfoResp(event)
    local proto = event.param
    local copyInfo = proto.copyInfo
    -- for i,v in ipairs(copyInfo or {}) do
    --     yflog:Info("-mapCode=%s--curPlayerNum=%s-timeStamp=%s-vampireState=%s-",v.mapCode,v.curPlayerNum,v.timeStamp,v.vampireState)
    -- end
    self._dungeonInfo = copyInfo
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DUNGEON_LIST_CHANGE)
end


function MapModule:getDungeonInfo()
