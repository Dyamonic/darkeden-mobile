end

--传送地图 根据配置
function MapModule:onTransferByConfigReq(configId)
    local req = netcmd_pb.CS_TransferByConfigReq()
    req.configId = tonumber(configId) or 0
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_TRANSFER_BY_CONFIG_REQ), req)
end

--传送地图 根据配置
function MapModule:onTransferByConfigResp(event)
    local proto = event.param
    local ret = proto.ret
    local configId = proto.configId
    local config = CacheManager:getTransferByConfig(configId)
    if config and config:getAutoBattleActivate() == 1 then
        --自动战斗
        if not lt.AutoFightManager:isAuto() then
            lt.AutoFightManager:startAutoFight()
        end
    end
    yflog:Info("-----------------------------ret"..ret)
end

function MapModule:getProtectTime()
    return self._protectTime or 0
end

function MapModule:getNpcVampireLairInfo()
    return self._npcVampireLairInfo
end

function MapModule:sendTransferReq(zoneId)
    local req = netcmd_pb.CS_TransferReq()
    req.mapCode = tostring(zoneId)
    SocketApi:sendToGs(ClientCmdDef.CS_TRANSFER_REQ, req) 
end

-- 发送地图跳转
function MapModule:sendProtal(zoneId)
    --月卡地图
    local moonCardMap = CacheManager:getMonthCardMap()
    local zoneIdStr = tostring(zoneId)
    if moonCardMap[zoneIdStr] then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndLeader", param = { mapCode = zoneIdStr ,index = 3}})
        return
    end
    local canJump = self:checkCanJump(zoneId)
    if canJump then
        self:sendTransferReq(zoneId)
    end
end

-- 地图跳转回复
function MapModule:onProtalResp(event)
    -- 地图跳转成功 or 失败
    local proto = event.param
    yflog:Info("MapModule Prottal resp map jump back package ret:%s", proto.ret)
end

function MapModule:setInSafetyArea(bool)
    self._isInSafetyArea = bool
end

function MapModule:getInSafetyArea()
    return self._isInSafetyArea
end

function MapModule:getLogList(moduleName)
    self:parseLog(moduleName)

    local ret = {}
    local list = self._listData[moduleName]
    local flagPos = self._flagPosTb[moduleName]
    for i=1,#list do
        ret[#ret+1] = list[i]
    end

    table.sort(ret , function(a , b)
        return json.decode(a.value)[4] < json.decode(b.value)[4]
    end)
    --[[
    if flagPos == 1 then
        for i=1,#list do
            ret[#ret+1] = list[i].value
        end
    else
        for i=flagPos,#list do
            ret[#ret+1] = list[i].value
        end

        for i=1,flagPos-1 do
            ret[#ret+1] = list[i].value
        end
    end
    ]]
    return ret
end

function MapModule:parseLog(moduleName)
    if not self._listInit then
        self._listInit = {}
    end
    if not self._dbNames then
        self._dbNames = {}
    end
    if not self._listInit[moduleName] then
        local playerId = lt.GameModule:getHeroData():getPlayerId()

        self._dbNames[moduleName] = string.format("%s_%s",moduleName, tostring(playerId))
        self._listInit[moduleName] = true
    end

    self._listData[moduleName] = DbManager:getUserDbLogs(self._dbNames[moduleName])

    --[[
    self._flagPosTb[moduleName] = 1
    for i,v in ipairs(self._listData[moduleName]) do
        if v.flag == MapModule.FLAG_STATE.NORMAL then
            self._flagPosTb[moduleName] = i
            break
        end
    end
    --]]
end

function MapModule:saveLog(moduleName, szText)
    if not self._listInit then
        self._listInit = {}
    end
    if not self._listInit[moduleName] then
        self:parseLog(moduleName)
    end

    local list = self._listData[moduleName]
    local dbName = self._dbNames[moduleName]

    local settype = false
    if #list < self._Maxnum then
        if #list > 0 then
            for i=1,#list do
                if i ~= list[i].flag then
                    list[i] = { value=szText, flag=i}
                    DbManager:insertUserDbLog(dbName, i, szText, i)
                    settype= true
                    break 
                end
            end
        end
        if not settype then
            list[#list+1] = { value=szText, flag=#list+1 }
            DbManager:insertUserDbLog(dbName, #list, szText, #list)
        end
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = lt.StringManager:getString(lt.StringManager.KEY_MAP_SRORETIPS)})
        --[[
        list[#list] = { value=szText, flag=#list }
        DbManager:insertUserDbLog(dbName, #list, szText,#list)
        
        self._flagPosTb[moduleName] = self._flagPosTb[moduleName] + 1

        if self._flagPosTb[moduleName] > self._Maxnum then
            self._flagPosTb[moduleName] = 1
            for _,v in ipairs(list) do
                --v.flag = MapModule.FLAG_STATE.NORMAL
                DbManager:uptUserDbLogFlag(dbName, v.flag)
            end
        end
        ]]
    end
end

function MapModule:deleteInfo(moduleName, key)
    local playerId = lt.GameModule:getHeroData():getPlayerId()
    local tablename= string.format("%s_%s",moduleName, tostring(playerId))
    DbManager:deleteTableDb("flag",key, tablename)
end

function MapModule:setMyPosData(data)
    self._ownPosData = data
end

function MapModule:getMyPosData()
    return self._ownPosData or {}
end

--副本 触发怪物刷新
function MapModule:onTriggerArea(x, y)
    if self._npcVampireLairInfo then
        if self._npcVampireLairInfo.mobMonsterFlag == true then
            return
        end
        if self._npcVampireLairInfo.vampireState ~= CommonModule:GetNetCmdEnum("NPCVAMPIRELAIRSTATE_NPCVAMPIRELAIRSTATE_PLAYTIME_ENUM") then
            return
        end
        local myMapMeta = lt.AgentManager:getWorldAgent():getMapAgent():getMapMeta()
        local mymapcode = myMapMeta:getMapCode()
        local npcMap =  lt.CacheManager:getNpcVampireLairTable()
        if not npcMap[mymapcode] then
            return
        end
        local map = lt.CacheManager:getNpcTriggerAreaTable(mymapcode)
        for i,v in pairs(map) do
            if tonumber(x) == tonumber(v[1]) and tonumber(y) == tonumber(v[2]) then
                local result = tonumber(x) * 1000 + tonumber(y)
                MapModule:onNpcVampireLairPosCheckReq(result)
                return
            end
        end 
    end
end

function MapModule:onNpcVampireLairPosCheckReq(checkPos)
    local msg = netcmd_pb.CS_NpcVampireLairPosCheckReq()
    msg.checkPos = checkPos
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_NPC_VAMPIRE_LAIR_POS_CHECK_REQ), msg)
end

function MapModule:getNpcOffset(npcId)
    local markShift = lt.CacheManager:getVariableById(Constant.Variable.NPCMarkShift)
    local list = json.decode(markShift)
    for i = 1, #list do
        if npcId == tonumber(list[i][1]) then
            return list[i]
        end
    end
    return nil
end

function MapModule:checkCanJump(zoneId)
    local worldAgent = lt.AgentManager:getWorldAgent()
    local myMapMeta = worldAgent:getMapAgent():getMapMeta()
    local mymapcode = myMapMeta:getMapCode()
    local race = lt.GameModule:getHeroData():getRace()
    local canJump = true
    if mymapcode == Constant.MAP_CODE.GATEOFALTAR then
        --祭坛入口(染色任务)
        local taskData = lt.TaskModule:getTaskById(Constant["ADVANCE_TASK"..race].DYEING)
        canJump = lt.TaskModule:checkTaskComplete(taskData)
    elseif mymapcode == Constant.MAP_CODE.ALTAROFBLOOD then
        --血之祭坛(解救人质任务)
        local taskData = lt.TaskModule:getTaskById(Constant["ADVANCE_TASK"..race].HOSTAGE)
        canJump = lt.TaskModule:checkTaskComplete(taskData)
    elseif mymapcode == Constant.MAP_CODE.ADAMHOLYLAND then
        --亚当圣地中(去染色任务的路上)
        if zoneId == tonumber(Constant.MAP_CODE.GATEOFALTAR) then
            local taskData = lt.TaskModule:getTaskById(Constant["ADVANCE_TASK"..race].ALTAR)
            canJump = lt.TaskModule:checkTaskComplete(taskData)
        end
    end
    return canJump
end

--转职副本2 传送地图
function MapModule:sendBloodTransfer()
    local worldAgent = lt.AgentManager:getWorldAgent()
    local myMapMeta = worldAgent:getMapAgent():getMapMeta()
    local mymapcode = myMapMeta:getMapCode()
    local race = lt.GameModule:getHeroData():getRace()
    if mymapcode ~= Constant.MAP_CODE.ALTAROFBLOOD then
        return
    end
    local taskData = lt.TaskModule:getTaskById(Constant["ADVANCE_TASK"..race].HOSTAGE)
    local isComplete = lt.TaskModule:checkTaskComplete(taskData)
    if not isComplete then
        return
    end
    local heroAgent = worldAgent:getHeroAgent()
    if not heroAgent then
        return
    end
    local missionMeta = lt.CacheManager:getMissionMeta(Constant["ADVANCE_TASK"..race].HOSTAGE)
    local target = missionMeta:getMissionTarget()[1][2]
    local poslist = lt.CacheManager:getBloodTransferPos(target)
    local mHero, nHero = heroAgent:getMNExactly()
    local idx = lt.MapUtil:calcMNIndex(mHero, nHero)
    if not poslist[idx] then
        return
    end
    local req = netcmd_pb.CS_AltarOfBloodTransferReq()
    req.posX = mHero
    req.posY = nHero
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_ALTAR_OF_BLOOD_TRANSFER_REQ), req)
end

--转职副本3 传送地图
function MapModule:sendMirrorOfAbyss()
    local req = netcmd_pb.CS_MirrorOfAbyssTransferReq()
    req.mapCode = Constant.MAP_CODE.MIRROROFABYSS
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_MIRROR_OF_ABYSS_TRANSFER_REQ), req)
end

--中地图数据保存
function MapModule:setSelectTable(idx, show)
    if idx == Constant.MiniMapSelect.Npc then
        self._showNpc = show
    elseif idx == Constant.MiniMapSelect.Pos then
        self._showDungeon = show
    elseif idx == Constant.MiniMapSelect.Delivery then
        self._showTransmit = show
    elseif idx == Constant.MiniMapSelect.Task then
        self._showMission = show
    elseif idx == Constant.MiniMapSelect.Team then
        self._showTeamMate = show
    end
end

function MapModule:getSelectTable(idx)
    if idx == Constant.MiniMapSelect.Npc then
        return self._showNpc
    elseif idx == Constant.MiniMapSelect.Pos then
        return self._showDungeon
    elseif idx == Constant.MiniMapSelect.Delivery then
        return self._showTransmit
    elseif idx == Constant.MiniMapSelect.Task then
        return self._showMission
    elseif idx == Constant.MiniMapSelect.Team then
        return self._showTeamMate
    end
end

--大地图数据保存
function MapModule:setStateSelectTable(idx, show)
    if idx == Constant.StateSelect.Pos then
        self._showPos = show
    elseif idx == Constant.StateSelect.Team then
        self._showTeam = show
    elseif idx == Constant.StateSelect.Task then
        self._showTask = show
    elseif idx == Constant.StateSelect.Entrance then
        self._showEntrance = show
    elseif idx == Constant.StateSelect.MapName then
        self._showMapName = show
    elseif idx == Constant.StateSelect.Level then
        self._showLevel = show
    end
end

function MapModule:getStateSelectTable(idx)
    if idx == Constant.StateSelect.Pos then
        return self._showPos
    elseif idx == Constant.StateSelect.Team then
        return self._showTeam
    elseif idx == Constant.StateSelect.Task then
        return self._showTask
    elseif idx == Constant.StateSelect.Entrance then
        return self._showEntrance
    elseif idx == Constant.StateSelect.MapName then
        return self._showMapName
    elseif idx == Constant.StateSelect.Level then
        return self._showLevel
    end
end

return MapModule