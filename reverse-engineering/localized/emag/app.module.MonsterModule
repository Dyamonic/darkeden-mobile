
local MonsterModule = {}

local netcmd_pb = lt.netcmd_pb
local ClientCmdDef = lt.ClientCmdDef
local SocketApi = lt.SocketApi
local ServerCmdDef = lt.ServerCmdDef
local AgentManager = lt.AgentManager
local TimeCounter = lt.TimeCounter

function MonsterModule:init()
    -- 挖掘尸体返回
    SocketApi:addProtoListener(ServerCmdDef.S_DigCorpse, handler(self, self.onDigCorpseAck), "MonsterModule:onDigCorpse")
end

function MonsterModule:clear()
    SocketApi:removeProtoListenerByTag("MonsterModule:onDigCorpse")
end

-- 挖掘尸体
function MonsterModule:sendDigCorpse(agent, petObjId)
    local heroAgent = AgentManager:getWorldAgent():getHeroAgent()
    heroAgent:setPickUp(false)

    local objId = agent:getObjId()
    if not objId or type(objId) ~= "number" then
        return
    end

    local monsterData = agent:getMonsterData()
    if monsterData then
        local digEndTime = monsterData:getDigEndTime()
        local serverTime = TimeCounter:serverTime()
        if digEndTime == 0 then
            monsterData:setDigEndTime(serverTime + 2)
        elseif serverTime > digEndTime then
            monsterData:setDigEndTime(serverTime + 2)
        else
            return
        end
    end

    yflog:Info("Dig the corpse: sendDigCorpse objId:%s", objId)

    local req = netcmd_pb.CS_DigCorpseReq()
    --尸体的objId
    req.corpseObjId = objId
    --宠物的objId(可以没有)
    if petObjId then
        req.petObjId = petObjId
    end

    SocketApi:sendToGs(ClientCmdDef.C_DigCorpse, req)
end

-- 挖掘尸体返回
function MonsterModule:onDigCorpseAck(event)
    local proto = event.param

    local agentId = proto.corpseObjId
    local agent = AgentManager:getWorldAgent():getAgent(agentId)
    if proto.ret == 0 then
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_PICK_UP_OPREATE)
    else
        if agent then
            agent:getMonsterData():setDig(1)
            lt.GameModule:removeDropAndBodyGridMap(agent)
        end
    end

    if agent then
        local monsterData = agent:getMonsterData()
        if monsterData then
            monsterData:setDigEndTime(0)
        end
    end
    
    yflog:Info("mining returns onDigCorpseAck success ret:%d", proto.ret)
end

return MonsterModule
