return "\n#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying vec2 v_texCoord;\nuniform sampler2D u_texture;\nuniform vec2 u_holeCenter; // Hole center\nuniform vec2 u_holeRadius; // Hole radius (x: width, y: height)\nuniform vec2 u_spriteSize;\nuniform float u_opatity;//Transparency outside the aperture (Mozu has higher transparency)\n\nvoid main()\n{\n    vec4 color = texture2D(u_texture, v_texCoord);\n    \n// Calculate the standardized coordinates from the current pixel to the center of the hole\n    vec2 normalizedCoord = (v_texCoord - u_holeCenter) * u_spriteSize / min(u_spriteSize.x, u_spriteSize.y);\n    \n// Use elliptical equation to determine whether it is within the digging range\n    float ellipseEquation = (normalizedCoord.x * normalizedCoord.x) / (u_holeRadius.x * u_holeRadius.x) +\n                            (normalizedCoord.y * normalizedCoord.y) / (u_holeRadius.y * u_holeRadius.y);\n    \n\n//If within the digging range, return transparent color\n    if (ellipseEquation < 1.0) {\nfloat opacity = smoothstep(0.0, 1.0, ellipseEquation); // Transparency increases from center to edge\nopacity = mix(0.0, u_opatity, opacity); // Adjust according to the maximum transparency\n        color = vec4(0.0, 0.0, 0.0, opacity);\n// discard; // Discard this fragment\n    }else{\ncolor = vec4(color.rgb, color.a * u_opatity); // Adjust according to transparency\n    }\n    \ngl_FragColor = color; // Otherwise, display the original color\n}\n"

