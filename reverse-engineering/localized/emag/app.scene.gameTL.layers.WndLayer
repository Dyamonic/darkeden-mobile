---@class WndLayer 窗口层
local WndLayer = class("WndLayer", lt.UICompBase)
local NtfManager = lt.NtfManager
local NpcModule = lt.NpcModule

--- 窗口固定位置
WndLayer.LEFT_LOCATION = { "UIWndChat"}
-- WndLayer.RIGHT_LOCATION = {"UIDlgPackage"}
-- WndLayer.CENTER_LOCATION = {"UIWndGuideStart", "UIWndTalkNpc", "UIWndCurrentMap", "UIWndStateMap", "UIWndRecharge", "UIWndRecharge"}
WndLayer.SPECIAL_LOCATION = {"UIWndLock", "UIWndInventory", "UIWndRoleEquip", "UIWndRoleInfo", "UIWndWareHouse", "UIWndTeam", "UIWndTask", "UIWndMail",
                            "UIWndFriend", "UIWndStrengthen", "UIWndPet", "UIWndAppearance", "UIWndSetting", "UIWndActivityTask", "UIWndTrade", "UIWndRepair",
                            "UIWndMagicOTips","UIWndAutoRecycle"}

function WndLayer:ctor()
    WndLayer.super.ctor(self)
    self._viewOpenArray = {}
    self._viewArray = {}
    self._view = fgui.UIPackage:createObject("Main", "WindowLayer")
    self._view:center()
    self:addChild(self._view)
end

function WndLayer:onClear()
    self:removeFromParent()
    if type(self._viewArray) == "table" and #self._viewArray > 0 then 
        for _,v in ipairs(self._viewArray) do
            v:onClear()
        end
    end
    self._viewOpenArray = nil
    self._view = nil
    WndLayer.super.onClear(self)
end

function WndLayer:onExit()
    NtfManager:removeNtfListenerByTag("WndLayer:openDlgMainView")
    NtfManager:removeNtfListenerByTag("WndLayer:closeAllDlg")
end

function WndLayer:onEnter()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_DLG_MAIN_VIEW, handler(self, self.openDlgMainView), "WndLayer:openDlgMainView")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_DLG_CLOSE_ALL, handler(self, self.closeAllDlg), "WndLayer:closeAllDlg")
end

function WndLayer:onUpdate(delta)
    for k,v in ipairs(self._viewOpenArray) do
        if v:getParam().enableUpdateEvent then
            if v.onUpdate then
                v:onUpdate(delta)
            end
        end
    end
end

function WndLayer:openDlgMainView(event)
    local param = event.param
    local layerName = param.class
    if param.layerName then
        layerName = param.layerName
    end
    if layerName == "UIWndTalkNpc" and not param.close and not param.skip then
        --检测是否为对话任务
        local missionId = lt.TaskModule:checkNpcTalkDialog(param.npcId)
        if missionId then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTaskTalk", missionId = missionId,
            confirmCallback = function()
                NpcModule:sendNpcTaskFinish(param.npcId,missionId)
            end})
            return
        end
        --检测是否为提交物品任务
        local checkTask = lt.TaskModule:checkNpcUseItem(param.npcId)
        if checkTask then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTaskUseItem", npcId = param.npcId})
            return
        end
        --判断是否为己方种族
        local npcMeta = lt.CacheManager:queryNpc(param.npcId)
        local contem = npcMeta:getContem()
        local race = lt.GameModule:getHeroRace()
        if contem ~= 0 and contem ~= race then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = GReadText.KEY_NPC_NOTRACE_TIPS})
            return
        end
    end
    self:openView(layerName, param)
end

function WndLayer:openView(layerName, param)
    if layerName then
        local view = nil
        for _,v in ipairs(self._viewOpenArray) do
            if v:getParam().layerName == layerName then
                -- self:resetViewLocalZOrder(v)
                if not param.reopen or param.close then
                    self:setOffset(v, true)
                    v:onCloseView()
                    
                end
                -- 如果重新打开根据参数设置
                if param.reopen then
                    if not param then param = {} end 
                    param.layerName = layerName
                    v:setParam(param)
                    v:show()
                    v:onHide()
                    v:onShown() -- 刷新一些UI数据
                    v:checkRedTips()
                    param.reopen = false
                    v:setParam(param)
                    self:setOffset(v, false)
                end
                return
            end
        end
        if param.close then
            self:setOffset(nil, true)
            return
        end
        if DEBUG > 0  then 
            self:reloadDebug()
        end
        
        for _,v in ipairs(self._viewArray) do
            if v:getParam().layerName == layerName then
                view = v
            end
        end
        
        if view then
            --判断是否解锁
            view:setParam(param)
            if view.checkUnlock and view:checkUnlock() == false then
                return
            end
            if not param then param = {} end 
            param.layerName = layerName
            view:show()
            require("app.offline.EnglishUI").fit(view)
            view:checkRedTips()
            self:setOffset(view, false)
            table.insert(self._viewOpenArray, view)
        else
            if not param then param = {} end 
            param.layerName = layerName
            if lt[param.class] and lt[param.class].new then
                view = lt[param.class].new(param)
            else
                print("not found")
            end
            view:setDialogSystem(self)
            table.insert(self._viewArray, view)
            --判断是否解锁
            if view.checkUnlock and view:checkUnlock() == false then
                return
            end
            view:show()
            require("app.offline.EnglishUI").fit(view)
            view:checkRedTips()
            self:setOffset(view, false)
            table.insert(self._viewOpenArray, view)
        end
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = "function is not available yet"})
    end  
end


function WndLayer:getLocationByLayerName(name)
    for _,v in ipairs(WndLayer.LEFT_LOCATION) do
        if v == name then
            return "left"
        end
    end
    -- for _,v in ipairs(WndLayer.RIGHT_LOCATION) do
    --     if v == name then
    --         return "right"
    --     end
    -- end

    for _,v in ipairs(WndLayer.SPECIAL_LOCATION) do
        if v == name then
            return "special"
        end
    end

    return ""
end

function WndLayer:setOffset(view, isClose)
    local location = nil
    local param = nil
    local x, y = display.cx, display.cy

    if view then
        param = view:getParam()
        location = self:getLocationByLayerName(param.layerName)
        if param and param.location then
            location = param.location
        end
        if param.layerName == "UIWndLock" and param.param.WndLockType == lt.Constant.WndLockType.Belt then
            return
        end
    end
    if location == "special" or isClose then
        local viewOpen = {}
        for i = 1, #self._viewOpenArray do
            if self._viewOpenArray[i]:getParam().layerName ~= "UIWndLock" and self._viewOpenArray[i]:isVisible()
            and view and self._viewOpenArray[i]:getParam().layerName ~= view:getParam().layerName then
                if self:getLocationByLayerName(self._viewOpenArray[i]:getParam().layerName) == "special" then
                    table.insert(viewOpen, self._viewOpenArray[i])
                end
            end
        end
        if not isClose and view:getParam().layerName ~= "UIWndLock" then
            table.insert(viewOpen, view)
        end
        local minusWidth = 0
        if view and view:getParam().layerName == "UIWndLock" then
            if view:getParam().param.WndLockType == lt.Constant.WndLockType.WareHouse or
            view:getParam().param.WndLockType == lt.Constant.WndLockType.Trade or
            (view:getParam().param.WndLockType == lt.Constant.WndLockType.Repair and view:getParam().param.lockIds == "110+109") then
                table.sort(viewOpen, function (a, b)
                    return a:getContentSize().width < b:getContentSize().width
                end)
            else
                table.sort(viewOpen, function (a, b)
                    return a:getContentSize().width > b:getContentSize().width
                end)
            end
            minusWidth = 0
        else
            table.sort(viewOpen, function (a, b)
                return a:getContentSize().width > b:getContentSize().width
            end)
        end
        local totalWidth = lt.Constant:GetLiuHaiX()/2
        for i = 1, #viewOpen do
            totalWidth = totalWidth + viewOpen[i]:getContentSize().width
        end
        local disWidth = display.width - totalWidth - minusWidth
        if disWidth >= 0 then
            disWidth = disWidth/(#viewOpen+1)
        elseif #viewOpen > 1 then
            disWidth = disWidth/(#viewOpen-1)
        end
        totalWidth = lt.Constant:GetLiuHaiX()/2
        for i = 1, #viewOpen do
            x = totalWidth + i * disWidth
            if disWidth < 0 then
                x = x - disWidth
            end
            if #viewOpen > 1 and x + viewOpen[i]:getContentSize().width > display.width - minusWidth then
                local dis = x + viewOpen[i]:getContentSize().width - (display.width - minusWidth)
                x = x - dis
            end
            if x < 0 then x = 0 end
            y = (display.height - viewOpen[i]:getContentSize().height)/2
            viewOpen[i]:setPosition(x, y)
            totalWidth = totalWidth + viewOpen[i]:getContentSize().width
        end
    elseif location == "left" then
        x = lt.Constant:GetLiuHaiX()/2
        y = (display.height - view:getContentSize().height)/2
        view:setPosition(x, y)
    elseif location == "right" then
        x = display.width - view:getContentSize().width - lt.Constant:GetLiuHaiX()/2
        y = (display.height - view:getContentSize().height)/2
        view:setPosition(x, y)
    elseif location == "unchanged" then
        -- 什么也不需要做
    else
        if view then
            view:setSelfPos()
        end
    end

    
    if param and type(param.offset) == "table" then
        local offset = param.offset
        local x,y = view:getPosition()
        x = x + (offset.x or 0)
        y = y + (offset.y or 0)
        view:setPosition(x, y)
    end
end


function WndLayer:closeView(layerName)
    if layerName then
        for k,v in ipairs(self._viewOpenArray) do
            if v:getParam().layerName == layerName then
                table.remove(self._viewOpenArray, k)
                v:hide()
                break
            end
        end
    end
    for k,v in ipairs(self._viewArray) do
        if v:getParam().layerName == layerName then
            table.remove(self._viewArray, k)

            v:onClear()

            break
        end
    end
end


function WndLayer:closeAllDlg()
    for i = #self._viewOpenArray, 1, -1 do
        if self._viewOpenArray[i] then
            self._viewOpenArray[i]:onCloseView()
        end
    end
    self._viewOpenArray = {}

    lt.SkillModule:setEditConf(nil)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CLOSE_SKILL_EDIT, {close = true})
end

function WndLayer:isEmpty()
    return #self._viewOpenArray == 0
end

function WndLayer:getViewOpenArray()
    return self._viewOpenArray
end

