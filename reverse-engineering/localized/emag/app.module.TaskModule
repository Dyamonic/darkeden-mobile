--保存任务列表
function TaskModule:setTaskList(tasklist)
    self._mainTaskArr = {}
    self._subTotalTaskArr = {}
    self._dailyTaskArr = {}
    self._weeklyTaskArr = {}
    self._advanceTaskArr = {}
    local tasksTab = {}
    local changeState = false
    for i = 1, #tasklist do
        local missionId = tasklist[i].taskId
        local meta = CacheManager:getMissionMeta(missionId)
        if meta then
            if meta:getMissionType() == Constant.TASK_TYPES.DAILY then
                table.insert(self._dailyTaskArr, tasklist[i])
                tasksTab[Constant.TASK_TYPES.DAILY] = true
                changeState = true
            elseif meta:getMissionType() == Constant.TASK_TYPES.WEEKLY then
                table.insert(self._weeklyTaskArr, tasklist[i])
                tasksTab[Constant.TASK_TYPES.WEEKLY] = true
                changeState = true
            elseif meta:getMissionType() == Constant.TASK_TYPES.TRUNK then
                table.insert(self._mainTaskArr, tasklist[i])
                tasksTab[Constant.TASK_TYPES.TRUNK] = true
                changeState = true
            elseif meta:getMissionType() == Constant.TASK_TYPES.BRANCH or
                meta:getMissionType() == Constant.TASK_TYPES.SYSTEM
                or meta:getMissionType() == Constant.TASK_TYPES.BRANCH2 then
                
                if tasklist[i].taskState ~= Constant.TASK_STATE.NOSTART then
                    self._TaskSort = self._TaskSort or {}
                    if self._TaskSort[missionId] == nil then
                        self._sortCount = self._sortCount or 0
                        self._sortCount = self._sortCount + 1
                        self._TaskSort[missionId] = self._sortCount + 1
                    end
                    table.insert(self._subTotalTaskArr, tasklist[i])
                end
                tasksTab[Constant.TASK_TYPES.BRANCH] = true
                changeState = true
            elseif meta:getMissionType() == Constant.TASK_TYPES.ADVANCE then
                table.insert(self._advanceTaskArr, tasklist[i])
                tasksTab[Constant.TASK_TYPES.ADVANCE] = true
                changeState = true
            end
        end
    end
    --判断当前转职任务是否要自动完成
    local advanceTask = self:getAdvanceTask()
    if advanceTask and advanceTask.taskState == Constant.TASK_STATE.FINISH then
        local meta = CacheManager:getMissionMeta(advanceTask.taskId)
        if meta:getClickComplete() == 0 then
            self:sendTaskReward(advanceTask.taskId)
        end
    end
    self:initTaskListCanReward(Constant.TASK_TYPES.DAILY)
    self:initTaskListCanReward(Constant.TASK_TYPES.WEEKLY)

    self:initCheckBoxOpen(Constant.TASK_TYPES.DAILY)
    self:initCheckBoxOpen(Constant.TASK_TYPES.WEEKLY)
    return changeState,tasksTab
end

--更新任务列表
function TaskModule:updateTaskList(tasklist)
    local needGuide = false
    local needTop = false
    --做类型区分，针对没必要的刷新进行拦截
    local tasksEventTab = {}
    local changeState = false
    for i = 1, #tasklist do
        local missionId = tasklist[i].taskId
        local meta = CacheManager:getMissionMeta(missionId)
        local taskTable = nil
        if meta then
            tasksEventTab[meta:getMissionType()] = true
            if meta:getMissionType() == Constant.TASK_TYPES.DAILY then
                taskTable = self._dailyTaskArr
            elseif meta:getMissionType() == Constant.TASK_TYPES.WEEKLY then
                taskTable = self._weeklyTaskArr
            elseif meta:getMissionType() == Constant.TASK_TYPES.TRUNK then
                taskTable = self._mainTaskArr
            elseif meta:getMissionType() == Constant.TASK_TYPES.BRANCH
                or meta:getMissionType() == Constant.TASK_TYPES.SYSTEM
                or meta:getMissionType() == Constant.TASK_TYPES.BRANCH2 then
                taskTable = self._subTotalTaskArr
            elseif meta:getMissionType() == Constant.TASK_TYPES.ADVANCE then
                taskTable = self._advanceTaskArr
            end
            
            local taskIdx = nil
            local showTask = true
            for j = 1, #taskTable do
                if taskTable[j].taskId == missionId then
                    taskIdx = j
                    if taskTable[j].taskState == Constant.TASK_STATE.NOSTART then
                        showTask = false
                    end
                    break
                end
            end
            if taskIdx == nil then
                --新增任务
                changeState = true
                if meta:getMissionType() == Constant.TASK_TYPES.BRANCH
                or meta:getMissionType() == Constant.TASK_TYPES.SYSTEM
                or meta:getMissionType() == Constant.TASK_TYPES.BRANCH2 then
                    self._TaskSort = self._TaskSort or {}
                    if self._TaskSort[missionId] == nil then
                        self._sortCount = self._sortCount or 0
                        self._sortCount = self._sortCount + 1
                        self._TaskSort[missionId] = self._sortCount + 1
                    end
                end
                table.insert(taskTable, tasklist[i])
            else
                if (showTask == false and tasklist[i].taskState ~= Constant.TASK_STATE.NOSTART) then
                    self._TaskSort = self._TaskSort or {}
                    if self._TaskSort[missionId] == nil then
                        self._sortCount = self._sortCount or 0
                        self._sortCount = self._sortCount + 1
                        self._TaskSort[missionId] = self._sortCount + 1
                    end
                end
                --判断这个任务是否为筛选过的任务
                if taskTable[taskIdx].taskState == Constant.TASK_STATE.NOSTART and tasklist[i].taskState == Constant.TASK_STATE.START
                or taskTable[taskIdx].taskState == Constant.TASK_STATE.START and tasklist[i].taskState == Constant.TASK_STATE.FINISH then
                    needGuide = true
                end
                --判断这个任务状态是否变成完成状态
                if taskTable[taskIdx].taskState ~= Constant.TASK_STATE.FINISH and tasklist[i].taskState == Constant.TASK_STATE.FINISH then
                    needTop = true
                end
                --更新任务
                if taskTable[taskIdx].taskState ~= tasklist[i].taskState then
                    changeState = true
                elseif taskTable[taskIdx].taskState == Constant.TASK_STATE.START then
                    changeState = true
                end
                if taskTable[taskIdx].taskState ~= tasklist[i].taskState then
                    changeState = true
                end
                taskTable[taskIdx] = tasklist[i]
                if tasklist[i].taskState == Constant.TASK_STATE.FINISH then
                    --判断是否需要自动完成
                    if meta:getClickComplete() == 0 then
                        TaskModule:sendTaskReward(missionId)
                    end
                end
            end
        end
    end
    if tasksEventTab[Constant.TASK_TYPES.DAILY] then
        self:initTaskListCanReward(Constant.TASK_TYPES.DAILY)
        self:initCheckBoxOpen(Constant.TASK_TYPES.DAILY)
    end
    if tasksEventTab[Constant.TASK_TYPES.WEEKLY] then
        self:initTaskListCanReward(Constant.TASK_TYPES.WEEKLY)
        self:initCheckBoxOpen(Constant.TASK_TYPES.WEEKLY)
    end
    --任务栏跳到最上面
    if needTop then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_TASK_TOP_EVENT)
    end
    --检测引导
    if needGuide then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_CHECK_GUIDE_EVENT)
    end
    return changeState,tasksEventTab
end

function TaskModule:getSortTask()
    return self._TaskSort or {}
end

--获得任务列表
function TaskModule:getTaskList(missionType)
    local tasklist = {}
    if missionType == Constant.TASK_TYPES.DAILY then
        tasklist = self._dailyTaskArr
        table.sort(tasklist, function(a, b)
            if a.taskState == Constant.TASK_STATE.FINISH and b.taskState ~= Constant.TASK_STATE.FINISH then
                return true
            elseif a.taskState ~= Constant.TASK_STATE.FINISH and b.taskState == Constant.TASK_STATE.FINISH then
                return false
            else
                if a.taskState == b.taskState then
                    return a.taskId < b.taskId
                else
                    return a.taskState < b.taskState
                end
            end
        end)
        self._dailyTaskArr = tasklist
    elseif missionType == Constant.TASK_TYPES.WEEKLY then
        tasklist = self._weeklyTaskArr
        table.sort(tasklist, function(a, b)
            if a.taskState == Constant.TASK_STATE.FINISH and b.taskState ~= Constant.TASK_STATE.FINISH then
                return true
            elseif a.taskState ~= Constant.TASK_STATE.FINISH and b.taskState == Constant.TASK_STATE.FINISH then
                return false
            else
                if a.taskState == b.taskState then
                    return a.taskId < b.taskId
                else
                    return a.taskState < b.taskState
                end
            end
        end)
        self._weeklyTaskArr = tasklist
    elseif missionType == Constant.TASK_TYPES.TRUNK then
        tasklist = self._mainTaskArr
    elseif missionType == Constant.TASK_TYPES.BRANCH
        or missionType == Constant.TASK_TYPES.SYSTEM
        or missionType == Constant.TASK_TYPES.BRANCH2 then
        for k, v in ipairs(self._subTotalTaskArr) do
            --需要客户端过滤
            if v.taskState ~= Constant.TASK_STATE.REWARD and v.taskState ~= Constant.TASK_STATE.NOSTART then
                table.insert(tasklist, v)
            end
        end
    elseif missionType == Constant.TASK_TYPES.ADVANCE then
        tasklist = self._advanceTaskArr
    end
    return tasklist
end

--获得任务列表缓存
function TaskModule:getTaskListCache(missionType)
    if missionType == Constant.TASK_TYPES.DAILY then
        return self._dailyTaskArr
    elseif missionType == Constant.TASK_TYPES.WEEKLY then
        return self._weeklyTaskArr
    elseif missionType == Constant.TASK_TYPES.TRUNK then
        return self._mainTaskArr
    elseif missionType == Constant.TASK_TYPES.BRANCH
        or missionType == Constant.TASK_TYPES.SYSTEM
        or missionType == Constant.TASK_TYPES.BRANCH2 then
        return self._subTotalTaskArr
    elseif missionType == Constant.TASK_TYPES.ADVANCE then
        return self._advanceTaskArr
    end
end

--获得任务列表 是否有可以领奖
function TaskModule:initTaskListCanReward(missionType)
    local tasklist = {}
    if missionType == Constant.TASK_TYPES.DAILY then
        tasklist = self._dailyTaskArr
    elseif missionType == Constant.TASK_TYPES.WEEKLY then
        tasklist = self._weeklyTaskArr
    end
    if #tasklist <= 0 then
        return
    end
    for i = 1, #tasklist do
        if tasklist[i].taskState == Constant.TASK_STATE.FINISH then
            TaskModule:setTaskTypeRedTips(missionType, true)
            return
        end
    end
    return TaskModule:setTaskTypeRedTips(missionType, false)
end

--获得主线任务
function TaskModule:getMainTask()
    local tasklist = self:getTaskList(Constant.TASK_TYPES.TRUNK)
    for i = 1, #tasklist do
        if tasklist[i].taskId == self._curMainTaskId then
            return tasklist[i]
        end
    end
    return nil
end

--获得主线任务id
function TaskModule:getMainTaskId()
    return self._curMainTaskId
end

--获得支线任务
function TaskModule:getBranchTask(taskId)
    local tasklist = self:getTaskListCache(Constant.TASK_TYPES.BRANCH)
    for i = 1, #tasklist do
        if tasklist[i].taskId == taskId then
            return tasklist[i]
        end
    end
    return nil
end

--获得转职任务
function TaskModule:getAdvanceTask()
    local tasklist = self:getTaskList(Constant.TASK_TYPES.ADVANCE)
    for i = 1, #tasklist do
        if tasklist[i].taskId == self._curAdvanceTaskId then
            return tasklist[i]
        end
    end
    return nil
end

--判断任务是否完成
function TaskModule:checkTaskComplete(taskData)
    if taskData == nil then return false end
    if taskData.taskState == Constant.TASK_STATE.FINISH then
        return true
    end
    local missionId = taskData.taskId
    local meta = CacheManager:getMissionMeta(missionId)
    local missionTarget = meta:getMissionTarget()
    for i = 1, #missionTarget do
        local max = tonumber(missionTarget[i][1])
        local cur = (taskData.hadNumMap and taskData.hadNumMap[i]) and taskData.hadNumMap[i].value or 0
        if meta:getObjectType() == Constant.TASK_FINISH_TYPES.SEARCH then
            local itemId = tonumber(missionTarget[i][3])
            cur = ItemModule:getItemNum(itemId)
        end
        if cur < max then
            return false
        end
    end
    return true
end

--获得某个任务
function TaskModule:getTaskById(missionId)
    local meta = CacheManager:getMissionMeta(missionId)
    if not meta then
        return nil
    end
    local missionType = meta:getMissionType()
    local tasklist = self:getTaskList(missionType)
    for i = 1, #tasklist do
        if missionId == tasklist[i].taskId then
            return tasklist[i]
        end
    end
    return nil
end

--获得某个任务状态
function TaskModule:getTaskState(missionId)
    local taskData = self:getTaskById(missionId)
    if taskData then
        return taskData.taskState
    end
    return nil
end

--获得能接取的任务id
function TaskModule:getAchieveTask(missionIds)
    local heroData = GameModule:getHeroData()
    for i = 1, #missionIds do
        local meta = CacheManager:getMissionMeta(missionIds[i])
        if meta then
            local needLv = meta:getNeedLv()
            local canAchieve = false
            if needLv == nil then
                canAchieve = true
            else
                local lv = heroData:getLevel(true)
                if self:checkLevel(lv, needLv[1], needLv[2]) then
                    canAchieve = true
                end
            end
            if canAchieve then
                local requireSum = meta:getRequireSum()
                if requireSum == nil then
                    return tonumber(missionIds[i])
                else
                    local sum = heroData:getPureAbility()
                    if (sum >= requireSum[1] or requireSum[1] == 0) and (sum <= requireSum[2] or requireSum[2] == 0) then
                        return tonumber(missionIds[i])
                    end
                end
            end
        end
    end
    return nil
end

function TaskModule:checkLevel(lv, minNeedLv, maxNeedLv)
    -- 都等于0 无等级限制
    if minNeedLv == 0 and maxNeedLv == 0 then
        return true
    end
    -- 无最低等级要求 有最高等级要求
    if minNeedLv == 0 and lv <= maxNeedLv then
        return true
    end
    -- 无最高等级要求 有最低等级要求
    if maxNeedLv == 0 and lv >= minNeedLv then
        return true
    end
    -- 既有最高等级要求 又有最低等级要求
    if lv >= minNeedLv and lv <= maxNeedLv then
        return true
    end
    return false
end

--检查是否为npc对话任务
function TaskModule:checkNpcTalkDialog(npcId)
    if npcId == nil then
        return nil
    end
    local curTask = nil
    local mainTask = self:getMainTask()
    if mainTask then
        local missionId = mainTask.taskId
        local taskMeta = CacheManager:getMissionMeta(missionId)
        local missionTarget = taskMeta:getMissionTarget()
        if taskMeta:getObjectType() == Constant.TASK_FINISH_TYPES.NPCTALK and missionTarget[1][2] == npcId then
            curTask = mainTask
        end
    end
    if curTask == nil then
        local advanceTask = self:getAdvanceTask()
        if advanceTask then
            local missionId = advanceTask.taskId
            local taskMeta = CacheManager:getMissionMeta(missionId)
            local missionTarget = taskMeta:getMissionTarget()
            if taskMeta:getObjectType() == Constant.TASK_FINISH_TYPES.NPCTALK and missionTarget[1][2] == npcId then
                curTask = advanceTask
            end
        end
    end
    if curTask == nil then
        local branchTasksArr = self:getTaskList(Constant.TASK_TYPES.BRANCH)
        for i = 1,#branchTasksArr do
            local missionId = branchTasksArr[i].taskId
            local taskMeta = CacheManager:getMissionMeta(missionId)
            local missionTarget = taskMeta:getMissionTarget()
            if taskMeta:getObjectType() == Constant.TASK_FINISH_TYPES.NPCTALK and missionTarget[1][2] == npcId then
                curTask = branchTasksArr[i]
                break
            end
        end
    end
    if curTask == nil then
        return nil
    end
    local taskState = curTask.taskState
    if taskState ~= Constant.TASK_STATE.START then
        return nil
    end
    return curTask.taskId
end

function TaskModule:checkNpcUseItem(npcId)
    if npcId == nil then
        return false
    end
    local advanceTask = self:getAdvanceTask()
    if advanceTask == nil then
        return false
    end
    local missionId = advanceTask.taskId
    local race = GameModule:getHeroData():getRace()
    if missionId ~= Constant["ADVANCE_TASK"..race].HOSTAGE then
        return false
    end
    local missionMeta = CacheManager:getMissionMeta(missionId)
    local target = missionMeta:getMissionTarget()[1][2]
    local meta = CacheManager:getAltarOfBloodMeta(target)
    local dungeonTarget = meta:getDungeonTarget()
    for i = 1, #dungeonTarget do
        local data = dungeonTarget[i]
        --同种族的npc
        if data[1] == race and data[2] == npcId then
            return true
        end
    end
    return false
end

--获得日总活跃度
function TaskModule:getDailyLiveness()
    return self._dailyLiveness or 0
end

--获得周总活跃度
function TaskModule:getWeekendLiveness()
    return self._weekendLiveness or 0
end

--获得日领取总活跃度
function TaskModule:getDailyReceiveLiveness()
    return self._dailyReceiveLiveness or 0
end

--获得周领取总活跃度
function TaskModule:getWeekendReceiveLiveness()
    return self._weekendReceiveLiveness or 0
end

--检查某个宝箱是否已领取
function TaskModule:checkBoxOpen(missionType, idx)
    local isOpen = false
    local boxes = self:getALTreasureMeta(missionType)
    if missionType == Constant.TASK_TYPES.DAILY then
        isOpen = self:getDailyReceiveLiveness() >= boxes[idx]:getALNum()
    elseif missionType == Constant.TASK_TYPES.WEEKLY then
        isOpen = self:getWeekendReceiveLiveness() >= boxes[idx]:getALNum()
    end
    return isOpen
end


--检查某个宝箱是否可以领取
function TaskModule:checkBoxCanOpen(missionType, idx)
    local canOpen = false
    local isOpen = self:checkBoxOpen(missionType, idx)
    if isOpen then
        return canOpen
    end
    local boxes = self:getALTreasureMeta(missionType)
    if missionType == Constant.TASK_TYPES.DAILY then
        canOpen = self:getDailyLiveness() >= boxes[idx]:getALNum()
    elseif missionType == Constant.TASK_TYPES.WEEKLY then
        canOpen = self:getWeekendLiveness() >= boxes[idx]:getALNum()
    end
    return canOpen
end

-- 检查宝箱是否有可以领取的
function TaskModule:initCheckBoxOpen(missionType)
    local boxes = self:getALTreasureMeta(missionType)
    if #boxes <= 0 then
        return
    end
    for i = 1, #boxes do
        local canGet = self:checkBoxCanOpen(missionType, i)
        if canGet == true then
            self:setTaskBoxTypeRedTips(missionType, true)
            return 
        end
    end
    self:setTaskBoxTypeRedTips(missionType, false)
end

--获得某个类型的任务是否有可领取的
function TaskModule:checkAllTask(missionType)
    local tasklist = self:getTaskList(missionType)
    for i = 1, #tasklist do
        local taskData = self:getTaskById(tasklist[i].taskId)
        if taskData and taskData.taskState == Constant.TASK_STATE.FINISH then
            return true
        end
    end
    return false
end

