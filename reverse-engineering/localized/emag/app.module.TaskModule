--任务列表
function TaskModule:sendTaskList()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_TASK_LIST_REQ))
end

--任务列表回调
function TaskModule:onTaskList(event)
    lt.LogUtil:debugInfo("TaskModule:onTaskList")
    local proto = event.param
    local change,changeTaskTab = false, {}
    if self._curMainTaskId ~= proto.curMainTaskId then
        self._curMainTaskId = proto.curMainTaskId
        changeTaskTab[Constant.TASK_TYPES.TRUNK] = true
        change = true
    end
    if self._curAdvanceTaskId ~= proto.curAdvanceTaskId then
        self._curAdvanceTaskId = proto.curAdvanceTaskId
        changeTaskTab[Constant.TASK_TYPES.ADVANCE] = true
        change = true
    end
    if self._dailyLiveness ~= proto.dailyLiveness then
        self._dailyLiveness = proto.dailyLiveness
        changeTaskTab[Constant.TASK_TYPES.DAILY] = true
        change = true
    end
    if self._weekendLiveness ~= proto.weekendLiveness then
        self._weekendLiveness = proto.weekendLiveness
        changeTaskTab[Constant.TASK_TYPES.WEEKLY] = true
        change = true
    end
    if self._dailyReceiveLiveness ~= proto.dailyReceiveLiveness then
        self._dailyReceiveLiveness = proto.dailyReceiveLiveness
        changeTaskTab[Constant.TASK_TYPES.DAILY] = true
        change = true
    end
    if self._weekendReceiveLiveness ~= proto.weekendReceiveLiveness then
        self._weekendReceiveLiveness = proto.weekendReceiveLiveness
        changeTaskTab[Constant.TASK_TYPES.WEEKLY] = true
        change = true
    end

    
    local changeValue,tasksEventTable = false,{}--任务数值发生变化
    if #proto.taskInfoArray > 0 then--没有数据变化不用刷新
        changeValue,tasksEventTable = self:setTaskList(proto.taskInfoArray)
    end

    if change == true or changeValue then
        if change and changeValue then
            local combinedEventTab = {}
            for k, _ in pairs(changeTaskTab) do
                combinedEventTab[k] = true
            end
            for k, _ in pairs(tasksEventTable) do
                combinedEventTab[k] = true
            end
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_TASK_MY,{taskTypes = combinedEventTab})
        elseif change then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_TASK_MY,{taskTypes = changeTaskTab})
        elseif changeValue then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_TASK_MY,{taskTypes = tasksEventTable})
        end
    end
    --转职副本显示初始化
    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
    mapAgent:initAdvanceDungeon()
end

--接取任务
function TaskModule:sendTaskLeading(npcObjId, taskId)
    local msg = netcmd_pb.CS_TaskLeadingReq()
    msg.npcObjId = npcObjId
    msg.taskId = taskId
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_TASK_LEADING_REQ), msg)
end

--接取任务回调
function TaskModule:onTaskLeading(event)
    lt.LogUtil:debugInfo("TaskModule:onTaskLeading")
end

--提交任务
function TaskModule:sendTaskCommit(npcObjId, taskId)
    local msg = netcmd_pb.CS_TaskCommitReq()
    msg.npcObjId = npcObjId
    msg.taskId = taskId
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_TASK_COMMIT_REQ), msg)
end

--提交任务回调
function TaskModule:onTaskCommit(event)
    lt.LogUtil:debugInfo("TaskModule:onTaskCommit")
    if event and event.param then
        local param = event.param
        local ret = param.ret
        local taskid = param.taskId
        if ret == 0 then
            local meta = CacheManager:getMissionMeta(taskid)
            local missionType = meta:getMissionType()
            local tasklist = self:getTaskList(missionType)
            local taskData = nil
            for i = 1, #tasklist do
                if tasklist[i].taskId == taskid then
                    taskData = tasklist[i]
                    break
                end
            end
            if taskData then
                taskData.taskState = Constant.TASK_STATE.FINISH
                self:sendTaskReward(taskid)
            end
        end
    end
end

--领取任务奖励
function TaskModule:sendTaskReward(taskId)
    local msg = netcmd_pb.CS_ReceiveTaskRewardReq()
    msg.taskId = taskId
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_TASK_RECEIVE_REWARD_REQ), msg)
end

--领取任务奖励回调
function TaskModule:onTaskReward(event)
    lt.LogUtil:debugInfo("TaskModule:onTaskReward")
    if event and event.param then
        local ret = event.param.ret
        local taskid = event.param.taskId
        if ret == 0 then
            local taskType = {}
            local meta = CacheManager:getMissionMeta(taskid)
            --只有支线任务要删除本地数据
            if meta:getMissionType() == Constant.TASK_TYPES.DAILY then
                for i = 1, #self._dailyTaskArr do
                    if self._dailyTaskArr[i].taskId == taskid then
                        taskType[meta:getMissionType()] = true
                        self._dailyTaskArr[i].taskState = Constant.TASK_STATE.REWARD
                        break
                    end
                end
            elseif meta:getMissionType() == Constant.TASK_TYPES.WEEKLY then
                for i = 1, #self._weeklyTaskArr do
                    if self._weeklyTaskArr[i].taskId == taskid then
                        taskType[meta:getMissionType()] = true
                        self._weeklyTaskArr[i].taskState = Constant.TASK_STATE.REWARD
                        break
                    end
                end
            elseif meta:getMissionType() == Constant.TASK_TYPES.TRUNK then
                for i = 1, #self._mainTaskArr do
                    if self._mainTaskArr[i].taskId == taskid then
                        self._mainTaskArr[i].taskState = Constant.TASK_STATE.REWARD
                        taskType[meta:getMissionType()] = true
                        break
                    end
                end
            elseif meta:getMissionType() == Constant.TASK_TYPES.BRANCH
                or meta:getMissionType() == Constant.TASK_TYPES.SYSTEM
                or meta:getMissionType() == Constant.TASK_TYPES.BRANCH2 then
                for i = 1, #self._subTotalTaskArr do
                    if self._subTotalTaskArr[i].taskId == taskid then
                        taskType[meta:getMissionType()] = true
                        self._subTotalTaskArr[i].taskState = Constant.TASK_STATE.REWARD
                        table.remove(self._subTotalTaskArr,i)
                        break
                    end
                end
            elseif meta:getMissionType() == Constant.TASK_TYPES.ADVANCE then
                for i = 1, #self._advanceTaskArr do
                    if self._advanceTaskArr[i].taskId == taskid then
                        taskType[meta:getMissionType()] = true
                        self._advanceTaskArr[i].taskState = Constant.TASK_STATE.REWARD
                        break
                    end
                end
            end
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_TASK_MY,{taskTypes = taskType})
            local proto = event.param
            local liveness = 0
            if meta:getMissionType() == Constant.TASK_TYPES.DAILY or meta:getMissionType() == Constant.TASK_TYPES.WEEKLY then
                liveness = meta:getALReward()
            end
            self:showTaskRewardTips(proto.multiRewards, liveness)
        end
    end
end

--放弃任务
function TaskModule:sendTaskGiveup(taskId)
    local msg = netcmd_pb.CS_TaskGiveUpReq()
    msg.taskId = taskId
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_TASK_GIVE_UP_REQ), msg)
end

--放弃任务回调
function TaskModule:onTaskGiveup(event)
    lt.LogUtil:debugInfo("TaskModule:onTaskGiveup")
    if event and event.param then
        local ret = event.param.ret
        local taskid = event.param.taskId
        if ret == 0 then
            local meta = CacheManager:getMissionMeta(taskid)
            local taskType = {}
            if meta:getMissionType() == Constant.TASK_TYPES.DAILY then
                taskType[Constant.TASK_TYPES.DAILY] = true
                for i = 1, #self._dailyTaskArr do
                    if self._dailyTaskArr[i].taskId == taskid then
                        table.remove(self._dailyTaskArr, i)
                        break
                    end
                end
            elseif meta:getMissionType() == Constant.TASK_TYPES.WEEKLY then
                taskType[Constant.TASK_TYPES.WEEKLY] = true
                for i = 1, #self._weeklyTaskArr do
                    if self._weeklyTaskArr[i].taskId == taskid then
                        table.remove(self._weeklyTaskArr, i)
                        break
                    end
                end
            elseif meta:getMissionType() == Constant.TASK_TYPES.TRUNK then
                taskType[Constant.TASK_TYPES.TRUNK] = true
                for i = 1, #self._mainTaskArr do
                    if self._mainTaskArr[i].taskId == taskid then
                        table.remove(self._mainTaskArr, i)
                        break
                    end
                end
            elseif meta:getMissionType() == Constant.TASK_TYPES.BRANCH or
                meta:getMissionType() == Constant.TASK_TYPES.SYSTEM or
                meta:getMissionType() == Constant.TASK_TYPES.BRANCH2 then
                taskType[Constant.TASK_TYPES.BRANCH] = true
                for i = 1, #self._subTotalTaskArr do
                    if self._subTotalTaskArr[i].taskId == taskid then
                        table.remove(self._subTotalTaskArr, i)
                        break
                    end
                end
            elseif meta:getMissionType() == Constant.TASK_TYPES.ADVANCE then
                taskType[Constant.TASK_TYPES.ADVANCE] = true
                for i = 1, #self._advanceTaskArr do
                    if self._advanceTaskArr[i].taskId == taskid then
                        table.remove(self._advanceTaskArr, i)
                        break
                    end
                end
            end
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_TASK_MY,{taskTypes = taskType})
        end
    end
end

--任务跳地图
function TaskModule:sendTaskJumpUp(taskId)
    local taskMeta = CacheManager:getMissionMeta(taskId)
    --判断任务传送点是否在附近
    local transferPoint = taskMeta:getTransferPoint()
    local worldAgent = lt.AgentManager:getWorldAgent()
    local mapCode = worldAgent:getMapCode()
    local heroAgent = worldAgent:getHeroAgent()
    if not heroAgent then
        return
    end
    local mHero, nHero = heroAgent:getMNExactly()
    local distance = lt.MapUtil:getMNDistance(mHero, nHero, transferPoint[2], transferPoint[3])
    local distanceVariable = CacheManager:getVariableById(Constant.Variable.TaskDistanceDetection) or 5
    if tostring(transferPoint[1]) == mapCode and distance <= tonumber(distanceVariable) then
        local missionTarget = taskMeta:getMissionTarget()
        local npcMeta = lt.CacheManager:queryNpc(missionTarget[1][2])
        -- local npcTask = taskMeta:getNpcInterface() ~= 0
        if not npcMeta then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_MINIMAP_ROUTE_POS,{posx = transferPoint[2], posy = transferPoint[3], mapId = tostring(transferPoint[1])})
            return
        end
        if taskMeta:getObjectType() == Constant.TASK_FINISH_TYPES.NPCTALK  then
            if distance <= npcMeta:getDialogueDistance() then
                --距离足够则直接弹窗
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTaskTalk", missionId = taskId,
                confirmCallback = function()
                    local missionTarget = taskMeta:getMissionTarget()
                    NpcModule:sendNpcTaskFinish(missionTarget[1][2],missionTarget[1][3])
                end})
                return
            end
            --距离不足移动过去
            local targetNpc = worldAgent:getNpcAgentById(missionTarget[1][2])
            if targetNpc then
                heroAgent:setTargetAgentId(targetNpc:getAgentId())
            else
                yflog:Info("Task NPC is null,",taskId)
                return
            end
            local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
            local moveType, moveDirection, mNext, nNext = mapAgent:calcTouchMove(mHero, nHero,transferPoint[2], transferPoint[3])
            heroAgent:onMessage({msgId=Constant.MSG_MOVE_TOUCH, moveType=Constant.MOVE_RUN_NPC, moveDirection=moveDirection, mNext=mNext, nNext=nNext, isMoveToNpc = true})
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_TASK_TIPS14})
        end
        return
    end
    local msg = netcmd_pb.CS_TaskJumpMapReq()
    msg.taskId = taskId
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_TASK_JUMP_UP_REQ), msg)
end

--任务跳地图回调
function TaskModule:onTaskJumpUp(event)
    lt.LogUtil:debugInfo("TaskModule:onTaskJumpUp")
    if event and event.param then
        local ret = event.param.ret
        local taskid = event.param.taskId
        if ret == 0 then
            local taskMeta = CacheManager:getMissionMeta(taskid)
            if taskMeta:getObjectType() == Constant.TASK_FINISH_TYPES.KILLMONSTER then
                --自动挂机
                if not AutoFightManager:isAuto() then
                    AutoFightManager:startAutoFight()
                end
            elseif taskMeta:getObjectType() == Constant.TASK_FINISH_TYPES.NPCTALK then
                --检测是否为对话任务(自动弹出npc对话界面)
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTaskTalk", missionId = taskid,
                confirmCallback = function()
                    local missionTarget = taskMeta:getMissionTarget()
                    NpcModule:sendNpcTaskFinish(missionTarget[1][2],missionTarget[1][3])
                end})
            elseif taskMeta:getNpcInterface() ~= 0 then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTalkNpc", npcId = taskMeta:getNpcInterface(), skip = true})
            end
        end
    end
end

--领取宝箱奖励
function TaskModule:sendTaskBoxReward(missionType)
    local msg = netcmd_pb.CS_ReceiveTaskBoxRewardReq()
    msg.type = missionType
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_RECEIVE_TASK_BOX_REWARD_REQ), msg)
end

--领取宝箱奖励回调
function TaskModule:onTaskBoxReward(event)
    lt.LogUtil:debugInfo("TaskModule:onTaskBoxReward")
    local proto = event.param
    self._dailyLiveness = proto.dailyLiveness
    self._weekendLiveness = proto.weekendLiveness
    self._dailyReceiveLiveness = proto.dailyReceiveLiveness
    self._weekendReceiveLiveness = proto.weekendReceiveLiveness
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_TASK_MY)

    self:initCheckBoxOpen(Constant.TASK_TYPES.DAILY)
    self:initCheckBoxOpen(Constant.TASK_TYPES.WEEKLY)

    self:showTaskRewardTips(proto.multiRewards)
end

--一键领取任务奖励
function TaskModule:sendReceiveAllTaskReward(missionType)
    local msg = netcmd_pb.CS_ReceiveAllTaskRewardReq()
    msg.type = missionType
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_RECEIVE_ALL_TASK_REWARD_REQ), msg)
end

--一键领取任务奖励回调
function TaskModule:onReceiveAllTaskReward(event)
    lt.LogUtil:debugInfo("TaskModule:onReceiveAllTaskReward")
    local proto = event.param
    local liveness = proto.dailyLiveness == 0 and proto.weekendLiveness or proto.dailyLiveness
    self:showTaskRewardTips(proto.multiRewards, liveness)
end

--任务更新通知NTF
function TaskModule:onUpdateTaskInfo(event)
    lt.LogUtil:debugInfo("TaskModule:onUpdateTaskInfo")
    -- if true then return end
    local proto = event.param
    local change,changeTaskTab = false, {}
    if self._curMainTaskId ~= proto.curMainTaskId then
        self._curMainTaskId = proto.curMainTaskId
        changeTaskTab[Constant.TASK_TYPES.TRUNK] = true
        change = true
    end
    if self._curAdvanceTaskId ~= proto.curAdvanceTaskId then
        self._curAdvanceTaskId = proto.curAdvanceTaskId
        changeTaskTab[Constant.TASK_TYPES.ADVANCE] = true
        change = true
    end
    if self._dailyLiveness ~= proto.dailyLiveness then
        self._dailyLiveness = proto.dailyLiveness
        changeTaskTab[Constant.TASK_TYPES.DAILY] = true
        change = true
    end
    if self._weekendLiveness ~= proto.weekendLiveness then
        self._weekendLiveness = proto.weekendLiveness
        changeTaskTab[Constant.TASK_TYPES.WEEKLY] = true
        change = true
    end
    if self._dailyReceiveLiveness ~= proto.dailyReceiveLiveness then
        self._dailyReceiveLiveness = proto.dailyReceiveLiveness
        changeTaskTab[Constant.TASK_TYPES.DAILY] = true
        change = true
    end
    if self._weekendReceiveLiveness ~= proto.weekendReceiveLiveness then
        self._weekendReceiveLiveness = proto.weekendReceiveLiveness
        changeTaskTab[Constant.TASK_TYPES.WEEKLY] = true
        change = true
    end
    local changeValue,tasksEventTable = false,{}--任务数值发生变化
    if #proto.taskInfoArray > 0 then--没有数据变化不用刷新
        changeValue,tasksEventTable = self:updateTaskList(proto.taskInfoArray)
    end
    if change == true or changeValue == true then
        if change and changeValue then
            local combinedEventTab = {}
            for k, _ in pairs(changeTaskTab) do
                combinedEventTab[k] = true
            end
            for k, _ in pairs(tasksEventTable) do
                combinedEventTab[k] = true
            end
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_TASK_MY,{taskTypes = combinedEventTab})
        elseif change then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_TASK_MY,{taskTypes = changeTaskTab})
        elseif changeValue then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_TASK_MY,{taskTypes = tasksEventTable})
        end
    end
end

--收集类的任务
function TaskModule:haveItemSearchTask(task_list)
    for i = 1,#task_list do
        local taskid = task_list[i].taskId
        local meta = CacheManager:getMissionMeta(taskid)        
        if meta:getObjectType() == Constant.TASK_FINISH_TYPES.SEARCH then
            return true
        end
    end
    return false
end

function TaskModule:getALTreasureMeta(boxType)
    local boxArray = {}
    local boxMeta = CacheManager:getALTreasureMeta(boxType)
    local race = GameModule:getHeroRace()
    for k, v in ipairs(boxMeta) do
        if v:getRace() == 0 or v:getRace() == race then
            table.insert(boxArray, v)
        end
    end
    return boxArray
end

return TaskModule