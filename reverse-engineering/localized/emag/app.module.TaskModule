function TaskModule:parseRateString()
    local str = "Task test: go somewhere<101,2,3>Found an object<202,4,5><>"
    local config = {}
    local startIndex = string.find(str,"<.->")
    if startIndex then
        string.gsub(str,"(.-)<(.-)>",function(normalText, richContent)
            print(string.format(" normalText = %s, richContent = %s", normalText, richContent))
        end)
    end
end

function TaskModule:parseString(content)
    if not content or content == "" then
        lt.LogUtil:debugInfo("TaskModule:parseString content is nil or empty")
        return content 
    end

    local color = "yellow"

    local idx = string.find(content,"##")

    if idx then
        local ck = string.sub(content, 3, 3)
        content = string.sub(content, 4)

        color = TaskModule.colors[ck]
    end

    return content, color
end

