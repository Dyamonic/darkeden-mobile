
local TaskModule = {}

local netcmd_pb = lt.netcmd_pb
local SocketApi = lt.SocketApi
local ClientCmdDef = lt.ClientCmdDef
local ServerCmdDef = lt.ServerCmdDef
local Constant = lt.Constant
local AutoFightManager = lt.AutoFightManager
local CommonModule = lt.CommonModule
local NtfManager = lt.NtfManager
local CacheManager = lt.CacheManager
local GameModule = lt.GameModule
local ItemModule = lt.ItemModule
local RedDotModule = lt.RedDotModule
local NpcModule = lt.NpcModule

TaskModule._taskTable = {}
TaskModule._clickNpcId = {}

TaskModule._mainTaskArr = {}
TaskModule._subTotalTaskArr = {}
TaskModule._dailyTaskArr = {}
TaskModule._weeklyTaskArr = {}
TaskModule._advanceTaskArr = {}
TaskModule._timeTrigger = nil
TaskModule._TaskSort = {}

TaskModule.colors = {
    ["w"] = "white",
    ["g"] = "green",
    ["b"] = "blue",
    ["y"] = "yellow",
    ["r"] = "red",
    ["o"] = "orange",
    ["h"] = "gray",
}

function TaskModule:init()
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_TASK_LIST_RESP), handler(self, self.onTaskList), "TaskModule:onTaskList")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_TASK_LEADING_RESP), handler(self, self.onTaskLeading), "TaskModule:onTaskLeading")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_TASK_COMMIT_RESP), handler(self, self.onTaskCommit), "TaskModule:onTaskCommit")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_TASK_RECEIVE_REWARD_RESP), handler(self, self.onTaskReward), "TaskModule:onTaskReward")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_TASK_GIVE_UP_RESP), handler(self, self.onTaskGiveup), "TaskModule:onTaskGiveup")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_TASK_JUMP_UP_RESP), handler(self, self.onTaskJumpUp), "TaskModule:onTaskJumpUp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_RECEIVE_TASK_BOX_REWARD_RESP), handler(self, self.onTaskBoxReward), "TaskModule:onTaskBoxReward")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_RECEIVE_ALL_TASK_REWARD_RESP), handler(self, self.onReceiveAllTaskReward), "TaskModule:onReceiveAllTaskReward")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_TASK_INFO_NTF), handler(self, self.onUpdateTaskInfo), "TaskModule:onUpdateTaskInfo")
end

function TaskModule:clear()
    SocketApi:removeProtoListenerByTag("TaskModule:onTaskList")
    SocketApi:removeProtoListenerByTag("TaskModule:onTaskLeading")
    SocketApi:removeProtoListenerByTag("TaskModule:onTaskCommit")
    SocketApi:removeProtoListenerByTag("TaskModule:onTaskReward")
    SocketApi:removeProtoListenerByTag("TaskModule:onTaskGiveup")
    SocketApi:removeProtoListenerByTag("TaskModule:onTaskJumpUp")
    SocketApi:removeProtoListenerByTag("TaskModule:onTaskBoxReward")
    SocketApi:removeProtoListenerByTag("TaskModule:onReceiveAllTaskReward")
    SocketApi:removeProtoListenerByTag("TaskModule:onUpdateTaskInfo")
    self._TaskSort = {}
end

function TaskModule:sendClickNpc(objId)
    self:setClickNpcId(objId)
    local msg = netcmd_pb.ClickNpc()
    msg.objID = objId
    SocketApi:sendToGs(ClientCmdDef.CLICK_NPC, msg)
end

function TaskModule:sendNpcCommand(objId, command)
    local msg = netcmd_pb.NpcCommand()
    msg.objID = objId
    msg.strCommand = "@"..command
    SocketApi:sendToGs(ClientCmdDef.NPC_COMMAND, msg)
end

function TaskModule:sendTaskTransfer(taskId, taskType)
    local msg = netcmd_pb.TaskTransfer()
    msg.taskID = taskId
    msg.taskType = taskType
    SocketApi:sendToGs(ClientCmdDef.TASK_TRANSFER, msg)
end

-- ---------------------------------------------------

function TaskModule:onClickNpcCloseAll()
    lt.LogUtil:debugTable("onClickNpcCloseAll")
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTalkNpc", close = true})
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_CLOSE_ALL,{closeNpcDlg = true})
end

function TaskModule:autoFightTask()
    local task = self:getMainTask()
    if not task then return nil end

    if task:isFightTask() then
        local worldAgent = lt.AgentManager:getWorldAgent()
        local pos = worldAgent:getHeroAgent():getMapPos()
        local mapId = worldAgent:getMapAgent():getMapCode()
        if task:isInMap(mapId) and task:getPosDis(pos) < lt.Constant.MAP_BLOCK_WIDTH*2 then
            -- lt.HangupManager:startHangup()
            -- lt.LogUtil:debugTable("startHangup")
            return true
        end
    end
    return false
end

function TaskModule:getTaskTable()
    return self._taskTable
end

function TaskModule:getTaskInfoById(taskID)
    if self._taskTable then
        for k,v in pairs(self._taskTable) do
            if v:getTaskId() == taskID then
                return v
            end
        end
    end
    return nil
end

function TaskModule:setClickNpcId(npcId)
    self._clickNpcId = npcId
end

function TaskModule:getClickNpcId()
    return self._clickNpcId
end

function TaskModule:onObjDisappear(npcId)
    if self._clickNpcId and self._clickNpcId == npcId then
        self:onClickNpcClose()
    end
end

--[[
    解析规则 
    "<color=green 显示的内容>"   文字颜色
    "<内容/@msg>"   带下划线 可点击事件 颜色为黄色   
--]]
function TaskModule:parseTaskString(str, fromNpc)
    if not str or str == "" then
        lt.LogUtil:debugInfo("TaskModule:parseString str is nil or empty")
        return
    end

    -- lt.LogUtil:debugTable("str = "..tostring(str))
    
    fromNpc = fromNpc or false

    local config = {}
    local startIndex = string.find(str,"<.->")
    if startIndex then
        string.gsub(str,"(.-)<(.-)>",function(normalText, richContent)
            if normalText and normalText ~= "" then
                normalText = string.gsub(normalText, "\\n", "\n")
                local normalTextTable = string.split(normalText, "\n")

                for k, v in pairs(normalTextTable) do
                    if k > 1 then
                        table.insert(config,{oType = "wrap"})
                    end
                    if v and v ~= "" then
                        table.insert(config,{oType = "font",content = v, outline = true})
                    end
                end
            end

            -- if string.find(richContent, "%a-%s*=%s*#%s*%x+%s+.-") then
            --     print("pipei1")
            --     string.gsub(richContent,"(%a-)%s*=%s*#%s*(%d+)%s+(.+)",function(tag, param, content)
            --         print("31313",tag, param, content)
            --         if tag == "color" and param ~= "" then
            --             print("pipei222")
            --             local colorP = lt.CommonUtil:convertColorWithX(param)
            --             table.insert(config,{oType = "font", content = content, tag = tag, color = colorP, outline = true})
            --         elseif tag == "unLine" and param ~= "" then
            --             local colorP = lt.CommonUtil:convertColorWithX(param)
            --             table.insert(config,{oType = "font", content = content, tag = tag, color = colorP, outline = true, unLine = true})
            --         end
            --     end)
            -- end

            if string.find(richContent, "%a-%s*=%s*#%s*%x+%s+.-") then
            
                string.gsub(richContent, "(%a-)%s*=%s*(#%s*%x+)%s+(.+)", function(tag, param, content)
                    if tag == "color" and param ~= "" then
                        local colorP = lt.CommonUtil:convertColorWithX(param)
                        table.insert(config, {oType = "font", content = content, tag = tag, color = colorP, outline = true})
                    elseif tag == "unLine" and param ~= "" then
                        local colorP = lt.CommonUtil:convertColorWithX(param)
                        table.insert(config, {oType = "font", content = content, tag = tag, color = colorP, outline = true, unLine = true})
                    end
                end)
            end
            
            

            if string.find(richContent, "%a-%s*=%s*%a-%s+.-") then
                string.gsub(richContent,"(%a-)%s*=%s*(%a-)%s+(.+)",function(tag, param, content)
                    if tag == "color" and param ~= "" then
                        table.insert(config,{oType = "font", content = content, tag = tag, color = param, outline = true})
                    elseif tag == "unLine" and param ~= "" then
                        table.insert(config,{oType = "font", content = content, tag = tag, color = param, outline = true, unLine = true})
                    end
                end)
            end

            if string.find(richContent, ".-%s*/%s*@%s*%a-") then
                string.gsub(richContent,"(.-)%s*/%s*@%s*(.+)",function(content, command)
                    local color
                    content, color = self:parseString(content)
                    table.insert(config,{oType = "font", content = content, command = command, color = color or "yellow", btnSign = fromNpc, fileSign = lt.ResManager:resPath("_commonOpt"),unLine = not fromNpc, unLineHeight = 4, button = true, outline = true, btnSpacing = fromNpc and 16 or 0})
                end)
            end
            if string.find(richContent, "item%s+.-") then
                string.gsub(richContent,"item%s+(%w+)%s*,%s*(%w+)%s*,%s*(%w+)",function(itemType, itemId, itemNum)
                    table.insert(config,{oType = "item",itemType = itemType, itemId = itemId, itemNum = itemNum})
                end)
            end
        end)
    else
        if str ~= "" then
            local normalText = string.gsub(str, "\\n", "\n")
            local normalTextTable = string.split(normalText, "\n")
            for k, v in pairs(normalTextTable) do
                if k > 1 then
                    table.insert(config,{oType = "wrap"})
                end
                if v and v ~= "" then
                    table.insert(config,{oType = "font",content = v})
                end
            end
        end
    end

    return config
end

