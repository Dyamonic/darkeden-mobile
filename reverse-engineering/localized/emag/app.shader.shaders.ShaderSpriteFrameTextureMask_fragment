return "\n\n#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying vec4 v_fragmentColor;\nvarying vec2 v_texCoord;\n\nuniform vec4 u_frameRect;\nuniform vec2 u_atlasSize;\nuniform float u_isRotated;\nuniform sampler2D u_mask_texture;\nuniform vec2 sp_size;\nuniform vec2 mask_size;\nuniform vec2 v_offset;\nuniform float u_enable;\n\n\n// cocos4.0 parameter name changes CC_Texture0 -> u_texture\nuniform sampler2D u_texture;\n\nvoid main() {\n    // vec2 atlasCoord = vec2(u_frameRect.x + u_frameRect.z * v_texCoord.x, u_frameRect.y + u_frameRect.w * v_texCoord.y);\n    vec2 texCoord = v_texCoord;\n    vec2 pos = vec2(0.0, 0.0);\n    if(u_isRotated != 0.0) {\n        pos = vec2((texCoord.y-u_frameRect.y)*u_atlasSize.y, sp_size.x-(texCoord.x-u_frameRect.x)*u_atlasSize.x);\n    }else{\n        pos = vec2((texCoord.x-u_frameRect.x)*u_atlasSize.x, (texCoord.y-u_frameRect.y)*u_atlasSize.y);\n    }\n\n    vec2 offset = vec2(pos.x - v_offset.x, pos.y - v_offset.y);\n\n    if(offset.x <= mask_size.x && offset.x >= 0.0 && offset.y <= mask_size.y && offset.y >= 0.0) \n    {\n        vec2 finCoord = vec2(offset.x/mask_size.x, offset.y/mask_size.y);\n        vec4 mask_FragColor = texture2D(u_mask_texture, finCoord);\n\n        vec4 texColor = texture2D(u_texture, v_texCoord);\n        gl_FragColor = v_fragmentColor*texColor;\n\n        gl_FragColor.a = (1.0-mask_FragColor.a*u_enable) * texColor.a;\n    }else{\n        gl_FragColor = v_fragmentColor*texture2D(u_texture, v_texCoord);\n    }\n}\n"
