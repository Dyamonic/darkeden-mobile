---@class CompReviveItem 复活cell
local CompReviveItem = class("CompReviveItem", lt.UIGButtonBase)
local Constant = lt.Constant
local GameModule = lt.GameModule

function CompReviveItem:ctor()
    CompReviveItem.super.ctor(self)
end
   
function CompReviveItem:onConstruct()
    self._icon = self:getChild("icon")
    self._title = self:getChild("title")
    self._cdBg = self:getChild("bg_cd")
    self._cdImg = self:getChild("img_cd")
end

function CompReviveItem:onClear()
    self._icon = nil
    self._title = nil
    self._cdBg = nil
    self._cdImg = nil
    self._data = nil
end

function CompReviveItem:onEnter()
    
end

function CompReviveItem:onExit()
    
end

function CompReviveItem:setInfo(data)
    self._data = data
    self._icon:setURL(data.icon)
    self._title:setText(data.name)
    require("app.offline.EnglishUI").fitReviveItem(self)
    self._cdBg:setVisible(not data.enable)
end

return CompReviveItem