
if not _G_TL_URL then
    _G_TL_URL = "http://192.168.6.76:7200/"
end

_G_DEBUG = false

local envFile = device.writablePath.."env"
if cc.FileUtils:getInstance():isFileExist(envFile) == true then
    envName = cc.FileUtils:getInstance():getDataFromFile(envFile)
    loadstring(tostring(envName))()
else
    local searchPathArr = cc.FileUtils:getInstance():getSearchPaths()
    if searchPathArr then
        envFile = searchPathArr[1].."env"
        if cc.FileUtils:getInstance():isFileExist(envFile) == true then
            envName = cc.FileUtils:getInstance():getDataFromFile(envFile)
            loadstring(tostring(envName))()
        end
    end
end

