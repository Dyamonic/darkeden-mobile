    self._attrlist1:setNumItems(3)
    local isFast = true
    local childs = self._attrlist1:getChildren()
    for k, v in ipairs(childs) do
        local newAttr = StrengthenModule:getAffixById(self._itemInfo, 8061+(k-1)*2)
