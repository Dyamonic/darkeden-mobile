function UICompStEnchant:checkGuide()
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.ENCHANT5) then
        local btn = self:getChild("btn_yeqian2")
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, pos.y)
        GuideModule:triggerGuide(Constant.GUIDE_ID.ENCHANT5, btn, pos, function()
            self:openFiterView(btn)
        end)
        return
    end

    if GuideModule:checkCanGuide(Constant.GUIDE_ID.ENCHANT7) then
        local btn = self._levelupBtn
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x - btn:getSize().width/2, pos.y - btn:getSize().height/2)
        GuideModule:triggerGuide(Constant.GUIDE_ID.ENCHANT7, btn, pos)
        return
    end
end

function UICompStEnchant:refreshItemNum(event)
    if event and event.name == "NTF_UPDATE_ITEM_NUMB" then
        if event.param and event.param.content then
            if self._itemContentTable and self._itemContentTable[event.param.content] then
                
            else
                return
            end
        end
    end
    if self._openViewType == ENCHANT_TYPES.STRENGTHEN then
        if self._itemcost then
            self._itemlist:setNumItems(#self._itemcost)
        end
        if self._selectItem then
            local id = self._selectItem:getCostId()
            self._levelupBtn:setGrayed(self._itemInfo == nil or ItemModule:getItemNum(id) < 1)
        end
    elseif self._openViewType == ENCHANT_TYPES.BLESSING then
        local selectGem = self._gemInfo or self._gems[1]
        local gemId = selectGem:getItemId()
        self._item:setNeedNum(ItemModule:getItemNum(gemId), 1)
        self._gemlist:setNumItems(#self._gems)
        self._levelupBtn:setGrayed(self._itemInfo == nil or ItemModule:getItemNum(gemId) < 1)
    elseif self._openViewType == ENCHANT_TYPES.MOTIVATE then
        if self._itemcost1 then
            self._itemlist1:setNumItems(#self._itemcost1)
        end
        if self._costLord then
            local canStrengthen = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, self._costLord, {tips = false})
            if canStrengthen then
                for k, v in ipairs(self._itemcost1) do
                    canStrengthen = ItemModule:enoughItem(v[1], v[2], v[3], {tips = false})
                    if not canStrengthen then
                        break
                    end
                end
            end
            self._levelupBtn:setGrayed(not canStrengthen)
        end
    end
end

function UICompStEnchant:refreshMoney()
    if self._openViewType == ENCHANT_TYPES.MOTIVATE then
        if self._costLord then
            local canStrengthen = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, self._costLord, {tips = false})
            local color = canStrengthen and "[color=#00ff00]" or "[color=#ff0000]"
            local lordStr = color..CommonFunc:changeNumberShow(self._costLord).."[/color]"
            self._costLabel:setText(string.format(GReadText.KEY_NPC_CLS_SKILL_TIPS3, lordStr))
            if canStrengthen then
                for k, v in ipairs(self._itemcost1) do
                    canStrengthen = ItemModule:enoughItem(v[1], v[2], v[3], {tips = false})
                    if not canStrengthen then
                        break
                    end
                end
            end
            self._levelupBtn:setGrayed(not canStrengthen)
        end
    end
end

