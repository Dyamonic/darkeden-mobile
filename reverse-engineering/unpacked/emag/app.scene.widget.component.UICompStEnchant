function UICompStEnchant:onClickItem(context)
    local data = context:getData()
    local costId = data:getCostId()
    if #self._itemcost > 1 then
        if self._selectItem and self._selectItem:getCostId() == costId then
            --打开来源
            local itemMeta = CacheManager:getItemMeta(costId)
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemMeta, tipsType = Constant.PROPTIPS_FORM.Display})
            return
        end
        if self._selectItem then
            self._selectItem:setSelect(false)
        end
        self._selectItem = data
        self._selectItem:setSelect(true)
        --刷新概率
        local attr = StrengthenModule:transformAffix(self._itemInfo)
        local rate = StrengthenModule:getEnchantRate(attr[self._selectAffix.index])
        local rateStr = GReadText.KEY_STRENGTHEN_TIPS9..rate.."%"
        local id = self._selectItem:getCostId()
        local meta = CacheManager:getItemMeta(id)
        local param = meta:getEffectParam()
        if param then
            local addRate = param[1][2]/100
            rateStr = rateStr.."[color=#00ff00]+"..addRate.."%[/color]"
        end
        self._rateLabel:setText(rateStr)
        self._levelupBtn:setGrayed(self._itemInfo == nil or ItemModule:getItemNum(id) < 1)
    else
        --打开来源
        local itemMeta = CacheManager:getItemMeta(costId)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemMeta, tipsType = Constant.PROPTIPS_FORM.Display})
    end
end

