function UICompStEnchant:startAnim(index, success)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_OPEN_STRENGTHEN_MASK, true)
    self:showAnim(index, success)
end

function UICompStEnchant:showAnim(index, success)
    local childIndex = self._attrlist:itemIndexToChildIndex(index-1)
    local lastItem = self._attrlist:getChildAt(childIndex)
    if success then
        lastItem:showUpImg(true)
        self._resultPanel:setURL(_GURL.GetImageSuccess)
        self._rateLabel:setText(GReadText.KEY_STRENGTHEN_TIPS16)
        AudioManager:playSound(Constant.SoundEffect.EventFanfare)
    else
        lastItem:showUpImg(false)
        self._resultPanel:setURL(_GURL.GetImageFailed)
        self._rateLabel:setText(GReadText.KEY_STRENGTHEN_TIPS17)
        AudioManager:playSound(Constant.SoundEffect.JewelItemMoveSound)
    end
    lastItem:showAnimation(success)
end

