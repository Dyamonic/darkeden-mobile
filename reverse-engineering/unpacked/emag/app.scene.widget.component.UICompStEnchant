function UICompStEnchant:onEnter()
    self._btnPanel:addClickListener(handler(self, self.onCancelBtnClick))
    self._levelupBtn:addClickListener(handler(self, self.onLevelupBtnClick))
    for k, v in ipairs(self._fiterBtns) do
        v:addClickListener(handler(self, self.openFiterBtnClick))
    end
    self._attrlist:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onSelectItem))
    self._itemlist:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    self._item:addClickListener(function()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = self._gemInfo, tipsType = Constant.PROPTIPS_FORM.Display})
    end)
    self._gemlist:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickGem))

    self._btnPanel1:addClickListener(handler(self, self.onCancelBtnClick))
    for i = 1, 3 do
        self["_lockBtn"..i]:addClickListener(handler(self, self.onLockBtnClick))
    end
    self._itemlist1:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem1))

    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB,
        handler(self, self.refreshItemNum), "UICompStEnchant:refreshItemNum")
end

function UICompStEnchant:onExit()
    NtfManager:removeNtfListenerByTag(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB, "UICompStEnchant:refreshItemNum")
    self._btnPanel:removeClickListener()
    self._levelupBtn:removeClickListener()
    for k, v in ipairs(self._fiterBtns) do
        v:removeClickListener()
    end
    self._item:removeClickListener()
    self._attrlist:removeEventListener(fgui.UIEventType.ClickItem)
    self._itemlist:removeEventListener(fgui.UIEventType.ClickItem)
    self._gemlist:removeEventListener(fgui.UIEventType.ClickItem)

    self._btnPanel1:removeClickListener()
    for i = 1, 3 do
        self["_lockBtn"..i]:removeClickListener()
    end
end

function UICompStEnchant:openFiterView(sender)
    if self._openViewType == sender.fiterType then 
        return
    end
    self._openViewType = sender.fiterType
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SELECT_SUBVIEW, self._openViewType)
end

function UICompStEnchant:refreshView(itemInfo, subIdx, noClear)
    self:clear(noClear)
    self._itemContentTable = {}
    self._itemInfo = itemInfo
    
    self._openViewType = subIdx
    self._controlTab:setSelectedIndex(self._openViewType - 1)

    if self._openViewType == ENCHANT_TYPES.MOTIVATE then
        if self._icon1 == nil then
            self._icon1 = fgui.UIPackage:createObject("Item", "Item")
            self._icon1:insertObjectToFactory(self)
            self._icon1:setPivot(0.5, 0.5, true)
            self._equipIcon1:addChild(self._icon1)
        end
        if itemInfo then
            self._icon1:setItemInfo(itemInfo)
            local level = itemInfo:getILevel()
            self._nameLabel1:setText(itemInfo:getName().."+"..level)
        else
            self._nameLabel1:setText(GReadText.KEY_STRENGTHEN_TIPS87)
        end
        self._icon1:setVisible(itemInfo ~= nil)
    else
        if self._icon == nil then
            self._icon = fgui.UIPackage:createObject("Item", "Item")
            self._icon:insertObjectToFactory(self)
            self._icon:setPivot(0.5, 0.5, true)
            self._equipIcon:addChild(self._icon)
        end
        if itemInfo then
            self._icon:setItemInfo(itemInfo)
            self._nameLabel:setText(itemInfo:getName())
        end
        self._icon:setVisible(itemInfo ~= nil)
    end

    if self._openViewType == ENCHANT_TYPES.STRENGTHEN then
        --装备强化
        if itemInfo then
            --选中状态
            local attr = StrengthenModule:transformAffix(itemInfo)
            self._itemNode:setPosition(32, 70)
            self._attrlist:setNumItems(#attr)
            self._itemcost = StrengthenModule:getEnchantCost(attr)
            self._itemlist:setNumItems(#self._itemcost)
            --默认选中第一个
            if not noClear then
                self._selectAffix = self._attrlist:getChildAt(0)
                self._selectItem = self._itemlist:getChildAt(0)
            end
            self._selectAffix:changeSelect(true)
            self._selectItem:setSelect(true)
            local rate = StrengthenModule:getEnchantRate(attr[self._selectAffix.index])
            local rateStr = GReadText.KEY_STRENGTHEN_TIPS9..rate.."%"
            if self._selectItem then
                local id = self._selectItem:getCostId()
                local meta = CacheManager:getItemMeta(id)
                local param = meta:getEffectParam()
                if param then
                    local addRate = param[1][2]/100
                    rateStr = rateStr.."[color=#00ff00]+"..addRate.."%[/color]"
                end
                self._levelupBtn:setGrayed(self._itemInfo == nil or ItemModule:getItemNum(id) < 1)
            end
            self._rateLabel:setText(rateStr)
            local isMax = StrengthenModule:getSingleEnchantMax(attr[self._selectAffix.index])
            self._rateLabel:setVisible(not isMax)
            self._resultPanel:setVisible(not isMax)
            self._resultPanel:setURL(_GURL.GetImageMoren)
            self._itemlist:setVisible(not isMax)
            self._itemlist:setVisible(not isMax)
            self._levelupBtn:setVisible(not isMax)
            self._levelMaxImg:setVisible(isMax)

            for k, v in ipairs(self._itemcost) do
                local _itemkey = string.format("%d_%d",v[1],v[2])
                self._itemContentTable[_itemkey] = true
            end
        else
            --默认状态
            self._itemNode:setPosition(154 ,70)
            self._rateLabel:setVisible(false)
            self._resultPanel:setVisible(false)
            self._attrlist:setNumItems(0)
            self._itemcost = {{1,701002,1}}
            self._itemlist:setNumItems(1)
            self._itemlist:setVisible(false)
            self._levelMaxImg:setVisible(false)
            self._levelupBtn:setVisible(true)
            self._levelupBtn:setGrayed(true)
        end
        self._tipsLabel:setText(GReadText.KEY_STRENGTHEN_TIPS10)
        self._tipsLabel:setVisible(itemInfo ~= nil)
        self._emptyLabel:setVisible(itemInfo == nil)
        self._attrlist:setVisible(itemInfo ~= nil)
        self._nameLabel:setVisible(itemInfo ~= nil)
        self._levelupBtn:setText(GReadText.KEY_STRENGTHEN_TIPS11)
        self._animNode:setVisible(false)
    elseif self._openViewType == ENCHANT_TYPES.BLESSING then
        --装备祝福
        self._tipsLabel:setText(GReadText.KEY_STRENGTHEN_TIPS12)
        self._tipsLabel:setVisible(true)
        self._nameLabel:setVisible(itemInfo ~= nil)
        self._emptyLabel2:setVisible(itemInfo == nil)
        self._animNode:setVisible(itemInfo ~= nil)
        self._itemNode:setPosition(32, 70)
        self._levelupBtn:setText(GReadText.KEY_STRENGTHEN_TIPS13)
        self._levelupBtn:setVisible(true)
        self._gems = StrengthenModule:getAllEnchantGem(itemInfo)
        self._gemlist:setNumItems(#self._gems)
        self._gemlist:setVisible(itemInfo ~= nil)
        self._emptyItemNode:setVisible(itemInfo ~= nil)
        self._itemLabel:setVisible(itemInfo ~= nil)
        self._emptyNode:setVisible(itemInfo ~= nil)
        local idx = StrengthenModule:getFirstGemIdx(itemInfo, self._gems)
        local childIndex = self._gemlist:itemIndexToChildIndex(idx)
        local context = self._gemlist:getChildAt(childIndex)
        self._selectGem = context
        self._selectGem:changeSelect(true)
        self._gemInfo = context.gemInfo
        self:refreshBlessView()
        for k, v in ipairs(self._gems) do
            if v then
                local itemId = v:getItemId()
                local _itemkey = string.format("%d_%d",1,itemId)
                self._itemContentTable[_itemkey] = true
            end
        end
    elseif self._openViewType == ENCHANT_TYPES.MOTIVATE then
        self._animNode:setVisible(false)
        --首饰套激发
        if itemInfo then
            --选中状态
            local attr = StrengthenModule:transformAffix(itemInfo)
            self._attrlist1:setNumItems(#attr)
            self._tipsLabel1:setText(GReadText.KEY_STRENGTHEN_TIPS92)
        else
            --默认状态
            self._attrlist1:setNumItems(0)
            self._tipsLabel1:setText(GReadText.KEY_STRENGTHEN_TIPS91)
        end
        --消耗刷新
        self:refreshCostView()
        self._nameLabel:setVisible(false)
        self._tipsLabel:setVisible(false)
        self._nameLabel1:setVisible(itemInfo ~= nil)
        self._attrlist1:setVisible(itemInfo ~= nil)
        self._costLabel:setVisible(itemInfo ~= nil)
        self._itemlist1:setVisible(itemInfo ~= nil)

        --刷新锁定界面
        if not noClear then
            self._lockList = {}
            self:refreshLockView()
        end
    end

    --通用逻辑
    self._bar:setVisible(self._openViewType == ENCHANT_TYPES.BLESSING)
    self._itemNode:setVisible(self._openViewType ~= ENCHANT_TYPES.MOTIVATE)
    self._panel1:setVisible(self._openViewType == ENCHANT_TYPES.STRENGTHEN)
    self._panel2:setVisible(self._openViewType == ENCHANT_TYPES.BLESSING)
    self._panel3:setVisible(self._openViewType == ENCHANT_TYPES.MOTIVATE)
    self._animFlag = false
end

--激发消耗刷新
function UICompStEnchant:refreshCostView()
    self._itemcost1, self._costLord = StrengthenModule:getMotivateCost(self._itemInfo, #self._lockList)
    local canStrengthen = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, self._costLord, {tips = false})
    local color = canStrengthen and "[color=#00ff00]" or "[color=#ff0000]"
    local lordStr = color..CommonFunc:changeNumberShow(self._costLord).."[/color]"
    self._costLabel:setText(string.format(GReadText.KEY_NPC_CLS_SKILL_TIPS3, _GURL.GetImageCoin..lordStr))
    self._itemlist1:setNumItems(#self._itemcost1)
    if canStrengthen then
        for k, v in ipairs(self._itemcost1) do
            canStrengthen = ItemModule:enoughItem(v[1], v[2], v[3], {tips = false})
            if not canStrengthen then
                break
            end
        end
    end
    self._levelupBtn:setGrayed(self._itemInfo == nil or not canStrengthen)


    for k, v in ipairs(self._itemcost1) do
        local _itemkey = string.format("%d_%d",v[1],v[2])
        self._itemContentTable[_itemkey] = true
    end
end

function UICompStEnchant:refreshBlessView()
    local selectGem = self._gemInfo or self._gems[1]
    local gemId = selectGem:getItemId()
    self._item:setInfo(string.format(_GURL.GetImageItem, gemId))
    self._item:setItemNums("")
    self._item:setNeedNum(ItemModule:getItemNum(gemId), 1)
    self._item:setIconScale(1.5, 1.5)
    self._itemLabel:setText(selectGem:getName())
    local param = selectGem:getEffectParam()[1]
    self._attrItem:setAttr({param[2], param[3]})
    self._levelupBtn:setGrayed(self._itemInfo == nil or ItemModule:getItemNum(gemId) < 1)
end

function UICompStEnchant:clear(noClear)
    self._itemInfo = nil
    if not noClear then
        self._selectItem = nil
    end
    self._gemInfo = nil
    if self._selectGem then
        self._selectGem:changeSelect(false)
    end
    self._selectGem = nil
end

function UICompStEnchant:openFiterBtnClick(context)
    local sender = context:getSender()
    self:onFiterBtnClick(sender)
end

function UICompStEnchant:onFiterBtnClick(sender)
    for fiterType = 1, table.nums(ENCHANT_TYPES) do
        if fiterType == sender.fiterType then
            self._fiterBtns[fiterType]:setSortingOrder(3)
        else
            self._fiterBtns[fiterType]:setSortingOrder(1)
        end
    end
    self:openFiterView(sender)
end

--锁定
function UICompStEnchant:onLockBtnClick(context)
    --没有选中
    if self._itemInfo == nil then
        return
    end
    --没有词条
    local attr = StrengthenModule:transformAffix(self._itemInfo)
    if #attr == 0 then
        return
    end
    local sender = context:getSender()
    local index = tostring(sender.index)
    local isRemove = false
    for k, v in ipairs(self._lockList) do
        if v == index then
            isRemove = true
            table.remove(self._lockList, k)
            break
        end
    end
    if not isRemove then
        if #self._lockList == 2 then
            --最多锁定两条
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_STRENGTHEN_TIPS90})
            return
        end
        table.insert(self._lockList, index)
    end
    --刷新锁定界面
    self:refreshLockView()
    --刷新消耗
    self:refreshCostView()
end

function UICompStEnchant:refreshLockView()
    --刷新锁定界面
    local childs = self._attrlist1:getChildren()
    for i = 1, 3 do
        self["_lockImg"..i]:setURL(string.format(_GURL.GetCompStrengthen, "bg_zhuangbei_suok"))
        self["_lockLoader"..i]:setURL(string.format(_GURL.GetCompStrengthen, "bg_zhuangbei_suo01"))
        if childs[i] then
            childs[i]:showBreaken(true)
        end
    end
    for k, v in ipairs(self._lockList) do
        self["_lockImg"..v]:setURL(string.format(_GURL.GetCompStrengthen, "bg_zhuangbei_suok2"))
        self["_lockLoader"..v]:setURL(string.format(_GURL.GetCompStrengthen, "bg_zhuangbei_suo02"))
        if childs[tonumber(v)] then
            childs[tonumber(v)]:showBreaken(false)
        end
    end
end

function UICompStEnchant:onLevelupBtnClick()
    --防止连续点击
    if self._animFlag then return end
    if self._itemInfo == nil then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_STRENGTHEN_TIPS87})
        return
    end
    if self._itemInfo then
        local isExit = StrengthenModule:checkStrengthenEquip(self._itemInfo)
        if not isExit then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_AUTO_TIPS10})
            return
        end
        if self._openViewType == ENCHANT_TYPES.STRENGTHEN then
            if #self._itemcost > 1 and self._selectItem == nil then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_STRENGTHEN_TIPS14})
                return
            end
            local id = self._selectItem:getCostId()
            local canStrengthen = ItemModule:enoughItem(1, id, 1, {tips = true})
            --服务器交互
            if canStrengthen then
                local isOver = StrengthenModule:checkOverRequire(self._itemInfo, 1)
                if isOver then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {content = GReadText.KEY_STRENGTHEN_TIPS72, confirmCallback = function()
                        self._animFlag = true
                        StrengthenModule:sendEquipStrengthen(self._itemInfo:getItemUid(), self._selectAffix.index, self._selectItem.index)
                    end})
                else
                    self._animFlag = true
                    StrengthenModule:sendEquipStrengthen(self._itemInfo:getItemUid(), self._selectAffix.index, self._selectItem.index)
                end
            end
        elseif self._openViewType == ENCHANT_TYPES.BLESSING then
            if not StrengthenModule:suitEnchantGem(self._itemInfo, self._gemInfo) then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content =  GReadText.KEY_STRENGTHEN_TIPS15})
                return
            end
            local id = self._gemInfo:getItemId()
            local canBless = ItemModule:enoughItem(1, id, 1, {tips = true})
            --服务器交互
            if canBless then
                self._animFlag = true
                local objId = ItemModule:getObjIdById(id)
                StrengthenModule:sendEquipBlessing(self._itemInfo:getObjId(), objId)
            end
        elseif self._openViewType == ENCHANT_TYPES.MOTIVATE then
            self._itemcost1, self._costLord = StrengthenModule:getMotivateCost(self._itemInfo, #self._lockList)
            local canStrengthen = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, self._costLord, {tips = true})
            if canStrengthen then
                for k, v in ipairs(self._itemcost1) do
                    canStrengthen = ItemModule:enoughItem(v[1], v[2], v[3], {tips = true})
                    if not canStrengthen then
                        break
                    end
                end
            end
            --服务器交互
            if canStrengthen then
                local attr = StrengthenModule:transformAffix(self._itemInfo)
                local needTips = false
                for k, v in ipairs(attr) do
                    local isMax = StrengthenModule:getSingleEnchantMax(v)
                    local isExit = CommonFunc:isInArray(self._lockList, tostring(k))
                    if isMax and not isExit then
                        needTips = true
                        break
                    end
                end
                --判断是否有没锁定的最高等级词条
                if needTips then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {type = 2, content = GReadText.KEY_STRENGTHEN_TIPS104, confirmCallback = function()
                        local uid = self._itemInfo:getItemUid()
                        StrengthenModule:sendEquipMotivate(uid, self._lockList)
                    end})
                else
                    local uid = self._itemInfo:getItemUid()
                    StrengthenModule:sendEquipMotivate(uid, self._lockList)
                end
            end
        end
    end
end

