
local TimeTrigger = class("TimeTrigger")

TimeTrigger._time = nil
TimeTrigger._timeElapsed = nil

function TimeTrigger:ctor(time, timeElapsed)
    self._time = time or 0
    self._timeElapsed = timeElapsed or 0
end

function TimeTrigger:tick(deltaTime)
    deltaTime = deltaTime or lt.GameBoard:getDeltaTime()
    
    self._timeElapsed = self._timeElapsed + deltaTime
    if self._timeElapsed >= self._time then
        self._timeElapsed = self._timeElapsed - self._time
        return true
    else
        return false
    end
end

function TimeTrigger:reset(time)
    self._time = time or self._time
    self._timeElapsed = 0
end

-- Setter && Getter
function TimeTrigger:getTimeElapsed()
    return self._timeElapsed
end

return TimeTrigger
