
local ViewMeta = class("ViewMeta")



function ViewMeta:ctor(row)
	self:initWithRow(row)
end

function ViewMeta:initWithRow(row)
    self._viewId = row.ViewID
    self._viewName = row.ViewName
    self._viewShowName = row.Name
    self._viewParam = row.ViewParam
    self._dialogue = row.Dialogue
    self._answer = row.Answer


    if not self._decodeViewParam and self._viewParam and self._viewParam ~= "" then
        self._decodeViewParam = {}
        local viewParam = json.decode(self._viewParam)

        for _,v in pairs(viewParam) do
            self._decodeViewParam[v[1]] = v
        end
    end
end

-- 解析viewParam
function ViewMeta:getDecodeViewParam()
    return self._decodeViewParam or {}
end

-- AUTO GENERATED GETTERS START
-- 以下方法由脚本自动生成，请勿手动修改

function ViewMeta:getViewId() return self._viewId end
function ViewMeta:getViewName() return self._viewName end
function ViewMeta:getViewShowName() return self._viewShowName end
function ViewMeta:getViewParam() return self._viewParam end
function ViewMeta:getDialogue() return self._dialogue end
function ViewMeta:getAnswer() return self._answer end

-- AUTO GENERATED GETTERS END
return ViewMeta
