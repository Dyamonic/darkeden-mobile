---@小地图界面
---@class UIWndCurrentMap:UIWindowBase
local UIWndCurrentMap = class("UIWndCurrentMap", lt.UIWindowBase)

local NtfManager = lt.NtfManager
local Constant = lt.Constant
local TeamModule = lt.TeamModule
local MapModule = lt.MapModule
local GameModule = lt.GameModule
local CacheManager = lt.CacheManager

local btnCfg = {
    { name = "pointPos", type = Constant.MiniMapSelect.Pos},
    { name = "pointNPC", type = Constant.MiniMapSelect.Npc},
    { name = "pointDelivery", type = Constant.MiniMapSelect.Delivery},
    { name = "pointTask", type = Constant.MiniMapSelect.Task},
    { name = "pointTeam", type = Constant.MiniMapSelect.Team},
}

function UIWndCurrentMap:ctor(param)
    UIWndCurrentMap.super.ctor(self, param)
    self:makeFullScreen()

    self._params = self:getParam().param
    -- 数据
    self._mapData = nil
    self._mapMeta = nil
    self._mWidth = nil
    self._nWidth = nil
    -- UI
    self._miniMap = nil
    self._backToWorld = nil
    self._targetList = nil
    self._downBtn = nil
    self._upBtn = nil
end

function UIWndCurrentMap:onClear()
    self:unregisterAllComponent()
    self._params = nil
    self._mapData = nil
    self._mapMeta = nil
    self._miniMap = nil
    self._backToWorld = nil
    self._downBtn = nil
    self._upBtn = nil
    if self._targetList then
        self._targetList:removeChildrenToPool()
        self._targetList:removeItemRenderer()
        self._targetList = nil
    end
    UIWndCurrentMap.super.onClear(self)
end

function UIWndCurrentMap:onInit()
    self:registerComponent("UICompMiniMap")
    UIWndCurrentMap.super.onInit(self, _GURL.GetMiniMapCurMap)
    self:initUI()
end

function UIWndCurrentMap:onShown()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CHANGE_MAP, handler(self, self.refreshMiniMap), "UIWndCurrentMap:NTF_CHANGE_MAP")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_MINIMAP_CHANGE_MN, handler(self, self.refreshMiniMap), "UIWndCurrentMap:NTF_MINIMAP_CHANGE_MN")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_TEAM_MATE_INFO, handler(self, self.onTeamMeteInfo) , "UIWndCurrentMap:NTF_TEAM_MATE_INFO")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_QUERY_TEAM_MATE_POS, handler(self, self.onTeamMeteInfo) , "UIWndCurrentMap:NTF_QUERY_TEAM_MATE_POS")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_NPC_DISAPPEAR, handler(self, self.onNpcDisappear), "UIWndCurrentMap:NTF_NPC_DISAPPEAR")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_NPC_SHOW_IN_MINI, handler(self, self.onNpcShow), "UIWndCurrentMap:onNpcShow")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_MINIMAP_ROUTE_NOTICE, handler(self, self.onNtfRoutePos) , "UIWndCurrentMap:NTF_MINIMAP_ROUTE_NOTICE")

    self._backToWorld:addClickListener(handler(self, function()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndCurrentMap", close = true})
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStateMap"})
    end))
    for _,v in pairs(btnCfg) do
        local btn = self:getChild(v.name)
        btn:addClickListener(handler(self, self.btnSelect))
    end
    self._downBtn:addClickListener(handler(self, function()
        local mapMeta = CacheManager:getMapMeta(self._mapMeta:getDownMapId())
        local param = self:getParam()
        if not param.param then
            param.param = {}
        end
        param.param.mapMeta = mapMeta
        self:setParam(param)
        self:refreshMiniMap()
    end))
    self._upBtn:addClickListener(handler(self, function()
        local mapMeta = CacheManager:getMapMeta(self._mapMeta:getUpMapId())
        local param = self:getParam()
        if not param.param then
            param.param = {}
        end
        param.param.mapMeta = mapMeta
        self:setParam(param)
        self:refreshMiniMap()
    end))
    self._targetList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickTargetItem))
    self._miniMap:addEventListener(fgui.UIEventType.TouchEnd, handler(self, self.onToucheEnd))

    if self:getContentPane() then
        self:refreshMiniMap()
    end
end

function UIWndCurrentMap:onHide()
    self._backToWorld:removeClickListener()
    for _,v in pairs(btnCfg) do
        local btn = self:getChild(v.name)
        btn:removeClickListener()
    end
    self._upBtn:removeClickListener()
    self._downBtn:removeClickListener()
    self._targetList:removeEventListener(fgui.UIEventType.ClickItem)
    self._miniMap:removeEventListener(fgui.UIEventType.TouchEnd)

    NtfManager:removeNtfListenerByTag("UIWndCurrentMap:NTF_CHANGE_MAP")
    NtfManager:removeNtfListenerByTag("UIWndCurrentMap:NTF_MINIMAP_CHANGE_MN")
    NtfManager:removeNtfListenerByTag("UIWndCurrentMap:NTF_TEAM_MATE_INFO")
    NtfManager:removeNtfListenerByTag("UIWndCurrentMap:NTF_QUERY_TEAM_MATE_POS")
    NtfManager:removeNtfListenerByTag("UIWndCurrentMap:NTF_NPC_DISAPPEAR")
    NtfManager:removeNtfListenerByTag("UIWndCurrentMap:NTF_NPC_SHOW_IN_MINI")
    NtfManager:removeNtfListenerByTag("UIWndCurrentMap:NTF_MINIMAP_ROUTE_NOTICE")

    UIWndCurrentMap.super.onHide(self)
end

function UIWndCurrentMap:initUI()
    self._backToWorld = self:getChild("backToWorld")
   
    self._miniMap = self:getChild("minimap")
    self._targetList = self:getChild("targetList")
    self._targetList:setItemRenderer(handler(self, self.renderTargetItem))
   
    -- 筛选过滤按钮
    for _,v in pairs(btnCfg) do
        local btn = self:getChild(v.name)
        btn.index = v.type
    end

    -- 地图上下层
    self._downBtn = self:getChild("btn_down")
    self._upBtn = self:getChild("btn_up")
    self._downBtn:setVisible(false)
    self._upBtn:setVisible(false)

    -- 小地图更新
    self:refreshMiniMap()

    -- self._miniMap:drawSafeArea()
end

function UIWndCurrentMap:refreshMiniMap()
    self._params = self:getParam().param
    if self._params and self._params.mapMeta then
        self._mapData = nil
        self._mapMeta = self._params.mapMeta
        local myMapMeta = lt.AgentManager:getWorldAgent():getMapAgent():getMapMeta()
        if self._mapMeta and myMapMeta and (self._mapMeta:getMapCode() == myMapMeta:getMapCode()) then
            self._mapData = lt.AgentManager:getWorldAgent():getMapAgent():getMapData()
        end
    else
        self._mapData = lt.AgentManager:getWorldAgent():getMapAgent():getMapData()
        self._mapMeta = lt.AgentManager:getWorldAgent():getMapAgent():getMapMeta()
    end

    -- 显示自己
    for _,v in pairs(btnCfg) do
        local btn = self:getChild(v.name)
        btn:setSelected(MapModule:getSelectTable(v.type))
    end
    self._miniMap:refreshMinMapInfo(self._mapData,self._mapMeta)

    -- 显示地图名
    local mapNameT = self:getChild("mapName")
    mapNameT:setText("")

    local mapLvlRecom = self:getChild("mapLvlRecom")
    mapLvlRecom:setText("")
    if self._mapMeta then
        local mapName = self._mapMeta:getMapName()
        if self._mapMeta:getMapCode() == Constant.MAP_CODE.MIRROROFABYSS then
            local race = GameModule:getHeroRace()
            local missionMeta = CacheManager:getMissionMeta(Constant["ADVANCE_TASK"..race].COLUMN)
            local target = missionMeta:getMissionTarget()[1][2]
            local meta = CacheManager:getMirrorOfAbyssMeta(target)
            mapName = meta:getMapName()[race]
        end
        mapNameT:setText(mapName)
        local startLvl,endLvl = self._mapMeta:getLvlRecommend()
        if startLvl and endLvl then
            mapLvlRecom:setText(string.format("Lv%s - Lv%s",startLvl,endLvl))
        end
        self._downBtn:setVisible(self._mapMeta:getDownMapId() ~= 0)
        self._upBtn:setVisible(self._mapMeta:getUpMapId() ~= 0)
    end

    self:refreshGuideList()

    --打开界面查询队友位置
    local playerIdList = TeamModule:getTeamMatePlayerId()
    if #playerIdList > 0 then
        MapModule:sendQueryTeamMatePos(playerIdList)
    else
        self._miniMap:onTeamMeteInfo({})
    end
end

function UIWndCurrentMap:btnSelect(context)
    local sender = context:getSender()
    MapModule:setSelectTable(sender.index, sender:isSelected())
    if sender.index == Constant.MiniMapSelect.Npc then
        self._miniMap:showNpc(sender:isSelected())
    elseif sender.index == Constant.MiniMapSelect.Pos then
        self._miniMap:showDungeon(sender:isSelected())
    elseif sender.index == Constant.MiniMapSelect.Delivery then
        self._miniMap:showTransmit(sender:isSelected())
    elseif sender.index == Constant.MiniMapSelect.Task then
        self._miniMap:showMission(sender:isSelected())
    elseif sender.index == Constant.MiniMapSelect.Team then
        self._miniMap:showTeamMate(sender:isSelected())
    end
    self:refreshGuideList()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MINIMAP_SELECT, {index = sender.index, select = sender:isSelected()})
end

function UIWndCurrentMap:renderTargetItem(index, obj)
    local guidelist = self._miniMap:getGuideList()
    obj:getChild("icon"):setURL(string.format(_GURL.GetMapObjPath, guidelist[index + 1].icon))
    local lbl = obj:getChild("n2")
    lbl:setText(guidelist[index + 1].name)
    local size = lbl:getSize()
    if size.width > 120 then
        local scale = 120/size.width
        lbl:setScale(scale,scale)
    else
        lbl:setScale(1,1)
    end

    obj:getChild("n3"):setVisible(index + 1 < #guidelist)
    obj.index = index + 1
end

function UIWndCurrentMap:onClickTargetItem(context)
    local obj = context:getData()
    local guidelist = self._miniMap:getGuideList()
    local data = guidelist[obj.index]
    if not data.guide then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_TRANSMIT_MAP_TIPS4})
        return
    end
    --寻路
    lt.AutoFightManager:endAutoFight()
    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
    local myMapMeta = mapAgent:getMapMeta()
    if data.npcId then
        --npc寻路坐标
        local x = data.posX
        local y = data.posY
        for i = -1, 1 do
            for j = -1, 1 do
                if not mapAgent:isBlocked(x+i, y+j) then
                    x = x + i
                    y = y + j
                    break
                end
            end
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_MINIMAP_ROUTE_POS,{posx = x, posy = y, mapId = myMapMeta:getMapCode()})
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_MINIMAP_ROUTE_POS,{posx = data.posX, posy = data.posY, mapId = myMapMeta:getMapCode()})
    end
    GameModule:setLastRouteData(data)
end

function UIWndCurrentMap:refreshGuideList()
    --导航列表
    local guidelist = self._miniMap:getGuideList()
    self._targetList:setNumItems(#guidelist)
end

--队友位置信息
function UIWndCurrentMap:onTeamMeteInfo(event)
    local param = event.param
    self._miniMap:onTeamMeteInfo(param)
end

function UIWndCurrentMap:onNtfRoutePos(event)
    local param = event.param
    self._miniMap:routePos(param)
end

function UIWndCurrentMap:onToucheEnd(context)
    local evt = context:getInput()
    self._miniMap:selectMapPos(evt:getPosition())

    self:test()
end

function UIWndCurrentMap:test()
    local guidelist = self._miniMap:getGuideList()
    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
    for i = 1, #guidelist do
        if guidelist[i].npcId == nil then
            if mapAgent:isBlocked(guidelist[i].posX, guidelist[i].posY) then
                print(guidelist[i].name)
            end
        end
    end
end

function UIWndCurrentMap:onNpcDisappear(event)
    local param = event.param
    self._miniMap:onNpcDisappear(param)
end

function UIWndCurrentMap:onNpcShow(event)
    if self._miniMap then
        self._miniMap:onNpcShow(event.param)
    end
end

function UIWndCurrentMap:onLayerClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndCurrentMap", close = true })
end

return UIWndCurrentMap