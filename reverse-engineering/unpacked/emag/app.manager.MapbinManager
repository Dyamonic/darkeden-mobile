local MapbinManager = {}

MapbinManager._mapTable = nil

function MapbinManager:init()
    if not self._mapTable then
        self._mapTable = lt.MapbinDao:queryAll()
    end
end

function MapbinManager:clear()
    self._mapTable = nil
end

function MapbinManager:getMapbinInfoByKey(obj, key)
    return self._mapTable[obj][key]
end

return MapbinManager