function UICompEquipTips:refreshTipsInfo(param)
    if not param then
        return
    end
    local item = param.itemInfo -- 传入服务器下发数据然后组装的数据
    local pos = 0
    local itemConfig = param.itemConfig -- 传入静态的表数据
    local isEquip = false
    local isLottoFlag = param.isLotto
    local isPutIn = param.isPutIn

    if item then
        pos = item:getPos()
        itemConfig = item:getItemMeta()
        local objId = item:getObjId()
        local equip, index = ItemModule:getEquipItemByObjId(objId)
        if equip then
            isEquip = true
        end
    elseif itemConfig then
        -- 创建临时装备数据
        item = ItemModule:getItemDataByConfig(itemConfig)
    end
    local tipsType = param.tipsType
    
    --------------------------------------------------------------------------
    -- 传入对比数据
    local compareItem = param.compareItem
    local compareItemCfg = param.compareItemCfg
    if compareItem then
        compareItemCfg = compareItem:getItemMeta()
    elseif compareItemCfg then
        -- 创建临时装备数据
        compareItem = ItemModule:getItemDataByConfig(compareItemCfg)
    end
    --------------------------------------------------------------------------

    if not itemConfig then
        return
    end

    local itemName = itemConfig:getName()
    local itemEnName = itemConfig:getEnName()
    if item and itemConfig:getRank() > 0 then
        --添加强化等级显示
        local ilevel = item:getILevel()
        local levelStr = StringManager:getRomeNumber(ilevel)
        itemName = itemName..levelStr
        itemEnName = itemEnName..levelStr
    end

    local itemDes = itemConfig:getDes()
    local itemQuality = item:getQuality()
    local itemKind = itemConfig:getKind()

    local qualityColor = equipQuality[itemQuality]
    local shadowColor = equipShadow[itemQuality]
    local contentList = self:getChild("contentList")
    local content = contentList:getChildAt(0)
    if self._nameT == nil then
        self._nameT = ccui.Text:create()
        self._nameT:setFontName(Constant.FONT_4)
        self._nameT:setFontSize(22)
        content:displayObject():addChild(self._nameT)
    end

    --乐透显示??????
    itemName = isLottoFlag and "??????" or itemName
    self._nameT:setString(itemName)
    self._nameT:setTextColor(qualityColor)
    self._nameT:enableShadow(shadowColor, cc.size(1,-1), 1)

    local qualityEnColor = equipEnQuality[itemQuality]
    if self._nameEnT == nil then
        self._nameEnT = ccui.Text:create()
        self._nameEnT:setFontName(Constant.FONT_4)
        self._nameEnT:setFontSize(18)
        content:displayObject():addChild(self._nameEnT)
    end
    --乐透显示?????????????????
    local enNameStr = "(" .. itemEnName .. ")"
    enNameStr = isLottoFlag and "?????????????????" or enNameStr
    self._nameEnT:setString(enNameStr)
    self._nameEnT:setTextColor(qualityEnColor)
    self._nameEnT:enableShadow(shadowColor, cc.size(1,-1), 1)

    --标记(限时/绑定/锁定)
    if self._brandT == nil then
        self._brandT = ccui.Text:create()
        self._brandT:setFontName(Constant.FONT_4)
        self._brandT:setFontSize(22)
        content:displayObject():addChild(self._brandT)
    end
    self._brandT:setVisible(false)

    --标识
    local isEquipCom = self:getChild("isEquip")

    if isPutIn then
        --已放入
        isEquipCom:setPosition(207, -25)
        isEquipCom:setVisible(isPutIn)
        isEquipCom:getChild("n8"):setText(GReadText.KEY_ITEMTIPS_TIPS19)
    else
        --已装备
        if pos and (pos >= 0) and isEquip then
            isEquipCom:setPosition(0, -25)
            isEquipCom:setVisible(true)
            isEquipCom:getChild("n8"):setText(GReadText.KEY_ITEMTIPS_TIPS18)
        else
            isEquipCom:setVisible(false)
        end
    end

    -- 主体内容
    local contentStr = ""
    local tableStr = {}
    local suitTableStr = nil
    local attributeDisplay = itemConfig:getAttributeDisplay()
    local displays = string.split(attributeDisplay, ",")

    ------------------------------------------------------------------------------------------------------
    -- 参与对比 start
    local function addCompareArrow(compareValue,itemValue)
        if not isLottoFlag and type(compareValue) == "number" and type(itemValue) == "number" and compareValue ~= itemValue then
            table.insert(tableStr," [/color]")
            if compareValue > itemValue then
                table.insert(tableStr,redArrow)
            elseif compareValue < itemValue then
                table.insert(tableStr,greenArrow)
            end
            table.insert(tableStr,"<br/>")
        else
            table.insert(tableStr,"\n[/color]")
        end
    end

        -- 评分
    if StrengthenModule:getAttrShow(displays[Constant.EqAttrShowType.SCORE]) then
        -- 评分显示数值
        local score = item:getEquipScore()
        score = isLottoFlag and "???" or score
        local titleName = tipsStringTable.StringTips46
        table.insert(tableStr,"[color=#c6c3ff]")
        table.insert(tableStr,titleName)
        table.insert(tableStr, "[/color][color=#F4E680]")
        table.insert(tableStr,score)

        local score = item:getEquipScore()
        local compareScore = compareItem and compareItem:getEquipScore()
        addCompareArrow(compareScore, score)
    end

    -- 武器类型
    local itemType = itemConfig:getType()
    if StrengthenModule:getAttrShow(displays[Constant.EqAttrShowType.TYPE]) then
