                for i = 1, #affixProp do
                    table.insert(tableStr, "[color=#beba00]")
                    local enchantInfo = lt.StrengthenModule:getEnchantInfo(affixProp[i][1], affixProp[i][2])
                    table.insert(tableStr, (suitTableStr == nil and i == 1) and enchantInfo or "      "..enchantInfo)
                    table.insert(tableStr, "\n[/color]")
                end
                
                local effectParam = suitConfig:getEffectParam()
                if effectParam and effectParam ~= "" and effectParam[1][1] == "Suit" then
                    --套装属性
                    local suitMeta = CacheManager:getEquipSuitMeta(effectParam[1][2])
                    local disableColor = "[color=#777977]"
                    local ableColor = "[color=#38F319]"
                    if suitMeta then
                        local titleName = suitMeta:getSuitName().."："
                        table.insert(tableStr,"\n[color=#c6c3ff]")
                        table.insert(tableStr,titleName)
                        table.insert(tableStr,"\n[/color]")
                        local suitBonus = suitMeta:getSuitBonus()
                        local suitsIdxs = isEquip and ItemModule:checkSuitIdxs(suitMeta) or {}
                        for k, v in ipairs(suitBonus) do
                            local color = disableColor
                            if isEquip then
                                --只有角色身上装备才检测套装属性
                                local isActive = CommonFunc:isInArray(suitsIdxs, k)
                                color = isActive and ableColor or disableColor
                            end
                            table.insert(tableStr, color)
                            local suitNumber = GReadText.KEY_EQUIPSUIT_TIPS1.."("..v[1]..")："
                            table.insert(tableStr, suitNumber)
                            local attrMeta = CacheManager:getAttributeMetaByOptionId(v[2])
                            local suitAttr = attrMeta:getName()
                            table.insert(tableStr, suitAttr)
                            table.insert(tableStr,"\n[/color]")
                        end
                    end
                end
            end
        end
    end
    
    contentStr = table.concat(tableStr)
    local detailT = content:getChild("detail")
    detailT:setText(contentStr)
    
    -- 设置数据后重构大小
    local topHeight = 60
    local detailTSize = detailT:getSize()
    local descT = content:getChild("desc")
    descT:setText("")
    local descTSize = descT:getSize()
    local curComSize = self:getSize()
    if detailTSize.height == 0 then
        topHeight = 60
    end
    local descOffsetH = 0
    if descTSize.height == 0 then
        descOffsetH = 0
    end
    local height = detailTSize.height + descTSize.height + topHeight + descOffsetH
    descT:setPosition(0,detailTSize.height + topHeight + descOffsetH)
    local showHeight = height
    if showHeight > maxHeight then
        showHeight = maxHeight
    end

    if showHeight < minHeight then
        showHeight = minHeight
    end
    self:setSize(curComSize.width,showHeight+15)

    contentList:setSize(curComSize.width,showHeight)
    content:setSize(curComSize.width+10,height)

    self._nameT:setPosition(cc.p(self._nameT:getContentSize().width/2, height-self._nameT:getContentSize().height/2))
    self._nameEnT:setPosition(cc.p(-2+self._nameEnT:getContentSize().width/2, height-26-self._nameT:getContentSize().height/2))
    self._brandT:setPosition(cc.p(295-self._brandT:getContentSize().width/2, height-self._nameT:getContentSize().height/2))

    if height > maxHeight then
        contentList:scrollToView(0)
    end
end

function UICompEquipTips:getEquipItemInfoByPos(pos)
    local equipData = ItemModule:getEquipArray()
    for k,v in ipairs(equipData) do
        local equipPos = v:getPos()
        if pos == equipPos then
            return v
        end
    end
end

-- 开始闪烁动画
function UICompEquipTips:startBlinkAnimation()
    local function createTween(target, start, ends, duration)
        local tween = fgui.GTween:to(start, ends, duration):setTarget(target, fgui.TweenPropType.Alpha)
        table.insert(self._blinkTweenArray, tween)
        return tween
    end

    local function blink()
        -- 清除旧tween
        if self._blinkTweenArray then
            for _, t in ipairs(self._blinkTweenArray) do
                t:kill()
            end
        end
        self._blinkTweenArray = {}

        -- 第一阶段
        createTween(self._nameT, 255, 125, 0.75)
        createTween(self._nameEnT, 255, 125, 0.75)
        createTween(self._brandT, 255, 125, 0.75)
        
        -- 只在最后一个tween上挂回调
        self._blinkTweenArray[#self._blinkTweenArray]:onComplete(function()
            -- 第二阶段
            createTween(self._nameT, 125, 255, 0.75)
            createTween(self._nameEnT, 125, 255, 0.75)
            createTween(self._brandT, 125, 255, 0.75)
            
            self._blinkTweenArray[#self._blinkTweenArray]:onComplete(blink) -- 循环
        end)
    end
    
    blink()
end

-- 停止动画
function UICompEquipTips:stopBlinkAnimation()
    if self._blinkTweenArray then
        for _, t in ipairs(self._blinkTweenArray) do
            t:kill()
        end
    end
    self._blinkTweenArray = nil
end

return UICompEquipTips