
local ShopItemData = class("ShopItemData")

local Constant = lt.Constant

ShopItemData._itemType       = nil  -- 技能编号
ShopItemData._itemId         = nil  -- 技能等级
ShopItemData._price          = nil  -- 技能经验值
ShopItemData._priceType      = nil  -- 技能CD
ShopItemData._nextLevel      = nil  -- 下一次释放剩余时间
ShopItemData._itemMeta       = nil   
ShopItemData._npcId          = nil   
ShopItemData._objId          = nil   
ShopItemData._select         = nil   
ShopItemData._itemData       = nil   

function ShopItemData:ctor(perShopItemData)
    assert(perShopItemData ~= nil, "perShopItemData is nil !")

    self:initShopItemData(perShopItemData)
    self:initMetaInfo()
end

function ShopItemData:initShopItemData(perShopItemData)
    self._itemType = perShopItemData.itemType
    self._itemId = perShopItemData.itemIdx
    self._price = perShopItemData.price
    self._priceType = perShopItemData.priceType
    self._nextLevel = perShopItemData.nextLevel
    -- self:dump()
    local objprop = perShopItemData.itemProp
    if objprop and objprop.objID ~= 0 then
        self._objId = objprop.objID
        self._itemData = lt.ItemData.new(objprop.objID, objprop.objprops)
    end
    
end

function ShopItemData:initMetaInfo()
    local itemType = self:getItemType() or 1
    local itemIdx = self:getItemId()
    if itemType == 1 then
        self._itemMeta = lt.ItemDao:query(itemIdx)
    elseif itemType == 2 then
        self._itemMeta = lt.EquipDao:query(itemIdx)
    elseif itemType == 3 then
        self._itemMeta = lt.BookDao:query(itemIdx)
    end
end

function ShopItemData:getItemData()
    return self._itemData
end

function ShopItemData:getObjId()
    return self._objId
end

function ShopItemData:setNpcId(npcId)
    self._npcId = npcId
end

function ShopItemData:getNpcId()
    return self._npcId
end

function ShopItemData:setSelect(select)
    self._select = select
end

function ShopItemData:getSelect()
    return self._select or false
end

function ShopItemData:getItemType()
    return self._itemType
end

function ShopItemData:getItemId()
    return self._itemId
end

function ShopItemData:getPrice()
    return self._price
end

function ShopItemData:getPriceType()
    return self._priceType
end

function ShopItemData:getNextLevel()
    return self._nextLevel or 0
end

function ShopItemData:getItemMeta()
    return self._itemMeta
end

function ShopItemData:dump()
    lt.LogUtil:debug(">>>>>>>>>>>>>>>>>>>> ShopItemData >>>>>>>>>>>>>>>>>>>>")
    lt.LogUtil:debug("self._itemType = "..tostring(self._itemType))
    lt.LogUtil:debug("self._itemId = "..tostring(self._itemId))
    lt.LogUtil:debug("self._price = "..tostring(self._price))
    lt.LogUtil:debug("self._priceType = "..tostring(self._priceType))
    lt.LogUtil:debug("self._nextLevel = "..tostring(self._nextLevel))
    lt.LogUtil:debug("<<<<<<<<<<<<<<<<<<<< ShopItemData <<<<<<<<<<<<<<<<<<<<")
end

return ShopItemData
