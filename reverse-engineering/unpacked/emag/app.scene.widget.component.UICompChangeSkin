local RaceSkinRes = lt.Constant.RaceSkinRes


function UICompChangeSkin:startSkin()
    if not self.ChangeSkinConf then return end
    self.race = lt.GameModule:getHeroRace()

    for pkgName, pkgConf in pairs(self.ChangeSkinConf) do
        self:changeSkin(pkgConf, self, pkgName)
    end

    if not self.ChangeSkinOffset then return end
    self:changeSkinOffset()
end

function UICompChangeSkin:changeSkin(conf, parent, pkgName)
    if not conf then return end
    if parent == nil then return end

    for name, resPathConf in pairs(conf) do
        local childNode = parent:getChild(name)
        if not childNode then
            print("changeskin not found", name)
        end
        if type(resPathConf) == "table" then
            self:changeSkin(resPathConf, childNode,pkgName)
        elseif type(resPathConf) == "string" then
            local url = string.format("ui://%s/%s%s",pkgName, resPathConf,RaceSkinRes[self.race])
            -- print("change skin url",url)
            childNode:setURL(url)
        end
    end
end

function UICompChangeSkin:changeByOffsetCfg(cfg,target)
    for name, offset in pairs(cfg) do
        local childNode = target:getChild(name)
        local nodeXY = childNode:getPosition()
        if offset.x or offset.y then
            local newX = nodeXY.x + (offset.x or 0)
            local newY = nodeXY.y + (offset.y or 0)
            childNode:setPosition(newX,newY)
        else
            self:changeByOffsetCfg(offset,childNode)
        end
    end
end

function UICompChangeSkin:changeSkinOffset()
    local jobOffsetConf = self.ChangeSkinOffset[self.race]
    self:changeByOffsetCfg(jobOffsetConf,self)
end

return UICompChangeSkin