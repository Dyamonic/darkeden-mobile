
local MaskWordUtil = {}

local DbManager = lt.DbManager

function MaskWordUtil:process(input, replace)
    local maskWord = DbManager:getMaskWord()

    for _, v in ipairs(maskWord) do
        if v then
            input = string.gsub(input, v, replace)
        end
    end
    return input
end

function MaskWordUtil:isFind(input)
    local maskWord = DbManager:getMaskWord()

    for _, v in ipairs(maskWord) do
        if v then
            local index = string.find(input, v)
            if index then
                return true
            end
        end
    end

    return false
end

return MaskWordUtil
