--- 公会信息
---@class UICompGuildInfo
local UICompGuildInfo = class("UICompGuildInfo", lt.UIGButtonBase)

local NtfManager  = lt.NtfManager
local GuildModule = lt.GuildModule
local Constant    = lt.Constant
local GameModule  = lt.GameModule

UICompGuildInfo.ChangeSkinConf = {
    ["Guild"] = {
        ["bg"] = "bg_gonghuixt_08",
        ["bg_icon"] = "bg_huizhang",
    },
    ["CommonTL"] = {
        ["btn_edit"] = { icon = "bg_youjian_changanniu02" },
    }
}

function UICompGuildInfo:ctor()
    UICompGuildInfo.super.ctor(self)
    self._richNotice = nil
end

function UICompGuildInfo:onClear()
    self._lblGuildName  = nil
    self._lblMasterName = nil
    self._lblCount      = nil
    self._lblNotice     = nil
    self._bgGuildIcon   = nil
    UICompGuildInfo.super.onClear(self)
end

function UICompGuildInfo:onConstruct()
    self._btnEdit = self:getChild("btn_edit")
    self._lblGuildName = self:getChild("lbl_guildName")
    self._lblMasterName = self:getChild("lbl_masterName")
    self._lblCount = self:getChild("lbl_count")
    self._lblNotice = self:getChild("lbl_notice")
    self._bgGuildIcon = self:getChild("bg_guildIcon")
end

function UICompGuildInfo:onEnter()
    UICompGuildInfo.super.onEnter(self)
    self._btnEdit:addClickListener(handler(self, self.onBtnFncEditClick))
    self:initUI()

    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_HERO_EVENT, handler(self, self.refreshBtnVisible), "UICompGuildInfo:NTF_UPDATE_HERO_EVENT")
end

function UICompGuildInfo:onExit()
    NtfManager:removeNtfListenerByTag("UICompGuildInfo:NTF_UPDATE_HERO_EVENT")

    self._btnEdit:removeClickListener()
    UICompGuildInfo.super.onExit(self)
end

function UICompGuildInfo:initUI()

end

-- 修改公告
function UICompGuildInfo:onBtnFncEditClick(obj)
    local guildData = GuildModule:getGuildData()
    local info = guildData and guildData.simpleData or nil
    local noticeText = info.noticeText or ""
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW,
        { class = "UIWndGuildNotice", type = GuildModule.NOTICE_TYPE.GUILD_NOTICE, noticeText = noticeText })
end

function UICompGuildInfo:refreshView()
    local guildData = GuildModule:getGuildData()
    local info = guildData and guildData.simpleData or nil

    self._lblGuildName:setText(info and info.guildName or "")
    self._lblMasterName:setText(info and info.masterName or "")
    self._lblCount:setText((info and info.curMemberSize or "0") .. "/" .. (info and info.maxMemberSize or "100"))
    -- self._lblNotice:setText(info.noticeText)
    self._lblNotice:setText("")
    self._bgGuildIcon:setURL(string.format(_GURL.GetGuildIcon, info and info.icon or ""))
    local config = {}
    local notice = GuildModule.initNotice
    if info and info.noticeText ~= "" then
        notice = info.noticeText
    end
    table.insert(config, { oType = "font", content = notice, unLine = true })
    if not self._richNotice then
        self._richNotice = lt.RichText.new(config, 249,
            { defaultSize = 20, lineSpacing = 3, label = true, fontName = Constant.FONT_4 })
        self._richNotice:setAnchorPoint(0, 1)
        self._richNotice:setPosition(574, 388)
        self:displayObject():addChild(self._richNotice)
    else
        self._richNotice:setString(config)
    end

    self:refreshBtnVisible()
end

function UICompGuildInfo:refreshBtnVisible()
    local heroData = GameModule:getHeroData()
    local myGuildDuty = tonumber(heroData:getGuildDuty())
    self._btnEdit:setVisible(myGuildDuty == Constant.GuildDuty.Master or myGuildDuty == Constant.GuildDuty.ViceMaster)
end

return UICompGuildInfo
