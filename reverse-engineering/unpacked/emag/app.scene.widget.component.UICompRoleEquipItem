---@class UICompRoleEquipItem 角色装备栏
---
local UICompRoleEquipItem = class("UICompRoleEquipItem", lt.UIGButtonBase)
local Constant = lt.Constant
local WndLockManager = lt.WndLockManager
local ItemModule = lt.ItemModule
local CacheManager = lt.CacheManager

function UICompRoleEquipItem:ctor()
    self._respath    = nil
    self._equipIcon  = nil
    self._tColor     = nil
    self._itemObjId  = nil
    self._red        = nil
    self._powerLevel = CacheManager:getVariableById(Constant.Variable.DefaultEqiupColorSet) or Constant.BaseColorRatio 
    UICompRoleEquipItem.super.ctor(self)
end

function UICompRoleEquipItem:onClear()
    self._respath    = nil
    self._equipIcon  = nil
    self._tColor     = nil
    self._itemObjId  = nil
    self._red        = nil
    UICompRoleEquipItem.super.onClear(self)
end

function UICompRoleEquipItem:onEnter()
end

function UICompRoleEquipItem:onExit()
end

function UICompRoleEquipItem:setInfo(respath)
    self:getChild("icon"):setVisible(false)

    local scale = lt.CacheManager:getValueById(lt.Constant.Variable.WearEquipIconScale) or 1
    self:setScale(scale,scale)

    self._respath = respath
end

function UICompRoleEquipItem:setItemInfo(item,size)
    self:setSize(size.width, size.height)
    self:getChild("n2"):setSize(size.width, size.height)

    -- 创建装备图标
    if self._equipIcon then
        self._equipIcon:removeFromParent()
        self._equipIcon = nil
    end
    if self._respath then
        self._equipIcon = display.newSprite(self._respath)
        local texture = self._equipIcon:getTexture()
        texture:setAliasTexParameters()--fgui.UIPackage:createObjectFromURL(self._respath)
        if not self._equipIcon then
            return
        end
        self:displayObject():addChild(self._equipIcon)
        local icon = self._equipIcon
        self._equipIcon:setAnchorPoint(0.5, 0.5)
        local iconSize = self._equipIcon:getContentSize()
        local scaleW = size.width/iconSize.width
        local scaleH = size.height/iconSize.height
        local scale = scaleW
        if scale > scaleH then
            scale = scaleH
        end
        self._equipIcon:setScale(scale)
        self._equipIcon:setPosition(size.width/2, size.height/2)
    end

    if not item then
        return
    end

    self._itemInfo = item

    local itemConfig = item:getItemMeta()
    if not itemConfig then
        return 
    end

    local iconId = itemConfig:getIconId()
    local affixId = item:getFirstAffixId() 
    local isChangeColor = itemConfig:isChangeColor()
    if isChangeColor then
        self._tColor = lt.ItemModule:getAffixColor(affixId)
    end
    self._itemObjId = item:getObjId()

    local durability = item:getDurability()
    local maxDurability = item:getTotalDurability()
    
    self:setRed((durability == 0 and maxDurability > 0) or not item:isWearable())

    local affixId = item:getFirstAffixId() 
    local isChangeColor = itemConfig:isChangeColor()
    if isChangeColor then
        self._tColor = ItemModule:getAffixColor(affixId)
        local affixLevel = item:getFirstAffixLevel()
        self._powerLevel = CacheManager:getPowerColorSet(affixLevel) or Constant.BaseColorRatio
    end
    self:loadShader(false)
end

function UICompRoleEquipItem:loadShader(isBorder, allColor)
    if not self._equipIcon then
        return
    end
    self._equipIcon:setColor(self._red and Constant.COLORS.red or Constant.COLORS.white)
    allColor = self._red and cc.vec3(1.0, 0.0, 0.0) or cc.vec3(1.0, 1.0, 1.0)
    local isBorderFlag = isBorder and 1 or 0
    local param = {
        node = self._equipIcon, 
        isBorder = isBorderFlag,
        bColor = cc.vec3(1.0, 1.0, 1.0),
        tColor =  self._tColor;
        allColor = allColor or cc.vec3(1.0, 1.0, 1.0),
        isBlink = false,
        outLineWidth = 1,
        objId = self._itemObjId or math.random(1, 99),
        colorOffset = self._powerLevel,
    }
    lt.ShaderBackendUtil:makeBorderEffect(param.node, param)
end

function UICompRoleEquipItem:showTips(equipData)
    if not equipData then
        return
    end
    if WndLockManager:getWndLockType() == Constant.WndLockType.Repair then
        if WndLockManager:getRepairType() == Constant.RepairType.Repair then
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = equipData,tipsType = Constant.EquipShowTipsType.Repair})
        else
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = equipData,tipsType = Constant.EquipShowTipsType.Silver})
        end
    else
        if lt.ChatModule._isChating then -- 聊天发送物品
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = equipData,tipsType = Constant.EquipShowTipsType.Chat})
        else
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = equipData,tipsType = Constant.EquipShowTipsType.RoleEquip})
        end
    end
    -- ,operate = {
    --     [1] = Constant.EquipTipBtns.UnEquip,
    -- }})
end

--切换选中状态
function UICompRoleEquipItem:setItemSelect(select)
    self:getChild("select"):setVisible(select)
end

function UICompRoleEquipItem:setRed(red)
    if self._equipIcon then
        self._red = red
        self._equipIcon:setColor(self._red and Constant.COLORS.red or Constant.COLORS.white)
    end
end

function UICompRoleEquipItem:getItemInfo()
    return self._itemInfo
end

return UICompRoleEquipItem