---@class UICompChatLabaEmoji
local UICompChatLabaEmoji = class("UICompChatLabaEmoji", lt.UIGButtonBase)

local NtfManager = lt.NtfManager

function UICompChatLabaEmoji:ctor()
    UICompChatLabaEmoji.super.ctor(self)
end

function UICompChatLabaEmoji:onClear()
    UICompChatLabaEmoji.super.onClear(self)
end

function UICompChatLabaEmoji:onEnter()
    UICompChatLabaEmoji.super.onEnter(self)
    self._listIcon:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
end

function UICompChatLabaEmoji:onExit()
    self._listIcon:removeEventListener(fgui.UIEventType.ClickItem)
    UICompChatLabaEmoji.super.onExit(self)
end

function UICompChatLabaEmoji:onConstruct()
    self._listIcon = self:getChild("list_item")
    self._listIcon:setItemRenderer(handler(self, self.renderChatItem))
    self._listIcon:setNumItems(16)
end

function UICompChatLabaEmoji:renderChatItem(index, obj)
    obj.index = index
    obj.obj = obj
    local urlPath = string.format(_GURL.GetCompChatEmoji, index + 1)
    obj:getChild("n0"):setURL(urlPath)
end

function UICompChatLabaEmoji:onClickItem(context)
    local data = context:getData()
    local index = data.index + 1

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CHAT_ADDKINK_POST, { emoji = index, index = 3 })
end

return UICompChatLabaEmoji
