
local AttributeDao = {}

function AttributeDao:query(id)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Attribute WHERE OptionId=%d;", id)) do
        local data = lt.AttributeMeta.new(row)
        return data
    end
end

function AttributeDao:queryAll()
    local dataTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Attribute;") do
        local data = lt.AttributeMeta.new(row)
        dataTable[data:getType().."_"..data:getGrade()] = data
    end
    return dataTable
end

return AttributeDao