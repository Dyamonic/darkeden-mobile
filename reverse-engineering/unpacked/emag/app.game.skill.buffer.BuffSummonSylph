local BuffSummonSylph = class("BuffSummonSylph", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local CacheManager = lt.CacheManager
local Constant = lt.Constant
--[[
    召唤-精灵
]]
BuffSummonSylph._agentId   = nil
BuffSummonSylph._isAdvance = nil

function BuffSummonSylph:ctor(time, actor, skilllevel, source)
    BuffSummonSylph.super.ctor(self, BuffEnum.EFFECT_SUMMON_SYLPH, time, actor, skilllevel)
    if not actor:getAgent() then
        return
    end

    yflog:Info("--------itemId=%s == == srcType= %s",source.srcId,source.srcType)

    if source.srcId == Constant.OUTSET_MOUNTID.FAIRY then
        self._skillId = SkillEnum.SKILL_SUMMON_FAIRY
    elseif source.srcId == Constant.OUTSET_MOUNTID.PEGASUS then
        self._skillId = SkillEnum.SKILL_SUMMON_PEGASUS
    else
        self._skillId = SkillEnum.SKILL_SUMMON_SYLPH
    end

    actor:getAgent():changeSummonSylphId(source.srcId)

    if source.srcId == Constant.OUTSET_MOUNTID.FAIRY then
        self._agentId = actor:getAgent():getAgentId()
        actor:getAgent():playAction(lt.Constant.ACTION_OUSTERS_FAIRY_MOVE_STAND)
        actor:playFairyEffect()
        return
    end

    if source.srcId == Constant.OUTSET_MOUNTID.PEGASUS then
        self._agentId = actor:getAgent():getAgentId()
        actor:getAgent():playAction(lt.Constant.ACTION_OUSTERS_PEGASUS_MOVE_STAND)
        actor:playPegasusEffect()
        return
    end

    local isAdvance = actor:getAgent():isAdvance()
    self._isAdvance = isAdvance
    if self._isAdvance then
        -- 转生后效果
        actor:playParallelEffect(SkillEnum.SKILL_SUMMON_SYLPH)
        actor:hideSprite()
    else
        -- 转生前效果
        actor:playZorderEffect(SkillEnum.SKILL_SUMMON_SYLPH, true)
    end
    self._agentId = actor:getAgent():getAgentId()
    actor:getAgent():playAction(lt.Constant.ACTION_OUSTERS_FAST_MOVE_STAND, SkillEnum.SKILL_SUMMON_SYLPH)
end

function BuffSummonSylph:onClear()
    if self._skillId == SkillEnum.SKILL_SUMMON_FAIRY then
        self._actor:removeBindingEffect(SkillEnum.SKILL_SUMMON_FAIRY)
    elseif self._skillId == SkillEnum.SKILL_SUMMON_PEGASUS then
        self._actor:removeBindingEffect(SkillEnum.SKILL_SUMMON_PEGASUS)
    end
    self._actor:getAgent():changeSummonSylphId(0)
    if self._skillId == SkillEnum.SKILL_SUMMON_SYLPH then
        if self._isAdvance then
            -- 转生后效果
            self._actor:removeParalEffect(SkillEnum.SKILL_SUMMON_SYLPH)
            self._actor:playQueueEffect(SkillEnum.SKILL_SUMMON_SYLPH)
            self._actor:showSprite()
        else
            -- 转生前效果
            self._actor:removeZorderEffect(SkillEnum.SKILL_SUMMON_SYLPH)
        end
    end
    BuffSummonSylph.super.onClear(self)
    if self._skillId == SkillEnum.SKILL_SUMMON_SYLPH then
        if self._agentId and lt.AgentManager:getAgent(self._agentId) then
            local agent = lt.AgentManager:getAgent(self._agentId)
            agent:cancelSummonSylph()
        end
    end

    self._agentId = nil
end

return BuffSummonSylph
