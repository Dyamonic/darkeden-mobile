--显示结果界面
function UICompStFusion:showFusionResult(params)
    self._diImage:setVisible(true)
    self._emptyNode:setVisible(false)
    self._mainNode:setVisible(false)
    if self._openViewType == FUSION_TYPES.COMPOSE then
        local itemInfo = self._itemInfo1:getObjId() == params.destoryedEquipObjId and self._itemInfo2 or self._itemInfo1

        if self._iconResult == nil then
            self._iconResult = fgui.UIPackage:createObject("Item", "Item")
            self._iconResult:insertObjectToFactory(self)
            self._iconResult:setPivot(0.5,0.5, true)
            self._iconPanel:addChild(self._iconResult)
        end
        if itemInfo then
            self._iconResult:setItemInfo(itemInfo)
        end

        self._attr = StrengthenModule:transformAffix(itemInfo)
        self._attrlist:setNumItems(#self._attr)

        self._resultNode:setVisible(true)
        self:setResult(self._openViewType)
        --播放特效
        self._animNode:setVisible(true)
        self._spine:setAnimation(0, "XinZhuangBei", false)
    elseif self._openViewType == FUSION_TYPES.INHERIT then
        if self._iconResult == nil then
            self._iconResult = fgui.UIPackage:createObject("Item", "Item")
            self._iconResult:insertObjectToFactory(self)
            self._iconResult:setPivot(0.5,0.5, true)
            self._iconPanel:addChild(self._iconResult)
        end
        if self._itemInfo2 then
            self._iconResult:setItemInfo(self._itemInfo2)
        end

        self._attr = StrengthenModule:transformAffix(self._itemInfo2)
        self._attrlist:setNumItems(#self._attr)

        self._resultNode:setVisible(true)
        self:setResult(self._openViewType)
        --播放特效
        self._animNode:setVisible(true)
        self._spine:setAnimation(0, "XinZhuangBei", false)
    elseif self._openViewType == FUSION_TYPES.REFINE then
        --成功失败
        local success = params.bSuccess
        --失败卸下右边
        if not success then
            self:onCancelBtnClick2()
        end
        self._mainNode1:setVisible(not success)
        self._attrNode:setVisible(false)
        --属性
        local itemInfo = success and self._newItemInfo or self._itemInfo1
        local level = itemInfo:getILevel()
        local prop = StrengthenModule:getActiveProp(itemInfo, level)
        local curProp = string.split(prop[1], "|")
        local curPropNum = curProp[2]
        if curProp[1] == GReadText.KEY_EQUIP_TIPS45 or curProp[1] == GReadText.KEY_EQUIP_TIPS46 then
            curPropNum = curPropNum.."%"
        end
        if success then
            self._newAttrLabel:setText(curProp[1].."：[color=#00ff00]"..curPropNum.."[/color]")
        else
            self._newAttrLabel:setText(curProp[1].."："..curPropNum)
        end
        self._newAttrLabel:setVisible(true)
        self._newUpImg:setVisible(success)
        self._tipsLabel:setText(success and GReadText.KEY_STRENGTHEN_TIPS99 or GReadText.KEY_STRENGTHEN_TIPS100)
        self._tipsLabel:setColor(success and cc.c3b(233, 218, 103) or Constant.COLORS.red)
        self._refineBtn:setText(GReadText.KEY_STRENGTHEN_TIPS102)
        --是否满级
        local isMax = StrengthenModule:isLevelMax(itemInfo, level)
        self._levelMaxImg:setVisible(isMax)
        self._tipsLabel:setVisible(not isMax)
        --定时器
        self._schedulerTime = success and 3 or 2
        self._costLabel1:setText("[color=#b0b0b0]"..string.format(GReadText.KEY_STRENGTHEN_TIPS103, self._schedulerTime).."[/color]")
        self._isOpenTimerRefresh = true
    end
end

function UICompStFusion:openFiterBtnClick(context)
    local sender = context:getSender()
    -- if sender.fiterType == FUSION_TYPES.REFINE then
    --     NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = "暂未开放"})
    --     return
    -- end
    for fiterType = 1, table.nums(FUSION_TYPES) do
        if fiterType == sender.fiterType then
            self._fiterBtns[fiterType]:setSortingOrder(3)
        else
            self._fiterBtns[fiterType]:setSortingOrder(1)
        end
    end
    self:openFiterView(sender)
end

function UICompStFusion:onLevelupBtnClick()
    if self._openViewType == FUSION_TYPES.REFINE then
        if self._schedulerTime and self._schedulerTime > 0 then
            self._schedulerTime = 0
            self:closeResultView()
            return
        end
        if self._itemInfo1 then
            local level = self._itemInfo1:getILevel()
            local isMax = StrengthenModule:isLevelMax(self._itemInfo1, level)
            if isMax then
                --卸下
                self:onCancelBtnClick1()
                return
            end
        end
    end
    if self._itemInfo1 == nil or self._itemInfo2 == nil then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_STRENGTHEN_TIPS87})
        return
    end
    if self._itemInfo1 and self._itemInfo2 then
        local isExit = StrengthenModule:checkStrengthenEquip(self._itemInfo1, self._itemInfo2)
        if not isExit then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_AUTO_TIPS10})
            return
        end
        local cost = InheritCost
        if self._openViewType == FUSION_TYPES.COMPOSE then
            cost = StrengthenModule:getFusionItem(self._itemInfo1)
        elseif self._openViewType == FUSION_TYPES.REFINE then
            cost = self._itemcost[1][2]
        end
        local canFusion = ItemModule:enoughItem(1, cost, 1, {tips = true})
        if canFusion then
            --检测货币
            canFusion = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, self._costLord, {tips = true})
        end
        if canFusion then
            if self._openViewType == FUSION_TYPES.COMPOSE then
                self:showFusionPreview()
            elseif self._openViewType == FUSION_TYPES.INHERIT then
                self:showFusionPreview()
            elseif self._openViewType == FUSION_TYPES.REFINE then
                self:showRefinePreview()
            end
        end
    end
end

