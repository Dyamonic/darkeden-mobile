--去融合
function UICompStFusion:toFusion()
    --防止连续点击
    if self._animFlag then return end
    local cost = InheritCost
    local num = 1
    if self._openViewType == FUSION_TYPES.COMPOSE then
        cost = StrengthenModule:getFusionItem(self._itemInfo1)
    elseif self._openViewType == FUSION_TYPES.REFINE then
        cost = self._itemcost[1][2]
        num = self._itemcost[1][3]
    end
    local canFusion = ItemModule:enoughItem(1, cost, num, {tips = true})
    if canFusion then
        --检测货币
        canFusion = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, self._costLord, {tips = true})
    end
    if canFusion then
        --服务器交互
        self._animFlag = true
        if self._openViewType == FUSION_TYPES.COMPOSE then
            StrengthenModule:sendEquipCompose(self._itemInfo1:getObjId(), self._itemInfo2:getObjId())
        elseif self._openViewType == FUSION_TYPES.INHERIT then
            StrengthenModule:sendEquipInherit(self._itemInfo1:getObjId(), self._itemInfo2:getObjId())
        elseif self._openViewType == FUSION_TYPES.REFINE then
            --判断item2是通用素材就传"0"
            local itemUid2 = nil
            if self._itemInfo2:getItemType() == Constant.ItemType.ITEM_TYPE_EQUIP then
                itemUid2 = self._itemInfo2:getItemUid()
            end
            StrengthenModule:sendEquipLevelup(0, nil, self._itemInfo1:getItemUid(), itemUid2)
        end
    end
end

