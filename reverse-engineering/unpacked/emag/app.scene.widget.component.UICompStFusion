    self._newUpImg:setVisible(false)
    self._levelMaxImg:setVisible(false)
    --未满级需要选中原来的首饰套
    local level = self._itemInfo1:getILevel()
    local isMax = StrengthenModule:isLevelMax(self._itemInfo1, level)
    if not isMax then
        self:refreshView1(self._itemInfo1, FUSION_TYPES.REFINE)
    else
        self:onCancelBtnClick1()
    end
    self:onCancelBtnClick2()
    self:getChild("mask"):setVisible(false)
end

function UICompStFusion:checkGuide()
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.INHERIT5) then
        local btn = self:getChild("btn_yeqian2")
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, pos.y)
        GuideModule:triggerGuide(Constant.GUIDE_ID.INHERIT5, btn, pos, function()
            self:openFiterView(btn)
        end)
        return
    end

    if GuideModule:checkCanGuide(Constant.GUIDE_ID.INHERIT7) then
        local pos = self:displayObject():convertToWorldSpace(self._mainNode:getPosition())
        pos = cc.p(pos.x, pos.y)
        GuideModule:triggerGuide(Constant.GUIDE_ID.INHERIT7, self._mainNode, pos)
        return
    end
end

function UICompStFusion:refreshItemNum(event)
    if event and event.name == "NTF_UPDATE_ITEM_NUMB" then
        if event.param and event.param.content then
            if self._itemContentTable and self._itemContentTable[event.param.content] then
                
            else
                return
            end
        end
    end
    if self._openViewType == FUSION_TYPES.COMPOSE then
        if self._cost then
            self._item:setNeedNum(ItemModule:getItemNum(self._cost), 1)
            local gray = self._itemInfo1 == nil or self._itemInfo2 == nil
            if not gray then
                gray = ItemModule:getItemNum(self._cost) < 1
            end
            self._levelupBtn:setGrayed(gray)
        end
    elseif self._openViewType == FUSION_TYPES.INHERIT then
        if self._cost then
            self._item:setNeedNum(ItemModule:getItemNum(self._cost), 1)
            local gray = self._itemInfo1 == nil or self._itemInfo2 == nil
            if not gray then
                gray = ItemModule:getItemNum(self._cost) < 1
            end
            self._levelupBtn:setGrayed(gray)
        end
    elseif self._openViewType == FUSION_TYPES.REFINE then
        if self._costLord then
            self._itemList:setNumItems(#self._itemcost)
            if self._itemcost then
                local gray = self._itemInfo1 == nil or self._itemInfo2 == nil
                local canRefine = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, self._costLord, {tips = false})
                if not gray and canRefine then
                    cost = self._itemcost[1][2]
                    canRefine = ItemModule:enoughItem(1, cost, 1, {tips = false})
                end
                self._refineBtn:setGrayed(gray or not canRefine)
            end
        end
    end
end

function UICompStFusion:refreshMoney()
    if self._openViewType == FUSION_TYPES.REFINE then
        if self._costLord then
            local canRefine = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, self._costLord, {tips = false})
            local color = canRefine and "[color=#00ff00]" or "[color=#ff0000]"
            local lordStr = color..CommonFunc:changeNumberShow(self._costLord).."[/color]"
            self._costLabel1:setText(string.format(GReadText.KEY_NPC_CLS_SKILL_TIPS3, _GURL.GetImageCoin..lordStr))
            if self._itemcost then
                local gray = self._itemInfo1 == nil or self._itemInfo2 == nil
                local canRefine = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, self._costLord, {tips = false})
                if not gray and canRefine then
                    cost = self._itemcost[1][2]
                    canRefine = ItemModule:enoughItem(1, cost, 1, {tips = false})
                end
                self._refineBtn:setGrayed(gray or not canRefine)
            end
        end
    end
end

return UICompStFusion