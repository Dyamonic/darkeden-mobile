                local name = itemInfo:getName().."+"..(level+1)
                self._icons3:setItemInfo(itemInfo)
                self._nameLabels3:setText(name)

                for k, v in ipairs(self._itemcost) do
                    local _itemkey = string.format("%d_%d",v[1],v[2])
                    self._itemContentTable[_itemkey] = true
                end
            else
                local name = itemInfo:getName().."+"..level
                self._icons3:setItemInfo(itemInfo)
                self._nameLabels3:setText(name)
                local prop = StrengthenModule:getActiveProp(itemInfo, level)
                local curProp = string.split(prop[1], "|")
                local curPropNum = curProp[2]
                if curProp[1] == GReadText.KEY_EQUIP_TIPS45 or curProp[1] == GReadText.KEY_EQUIP_TIPS46 then
                    curPropNum = curPropNum.."%"
                end
                self._newAttrLabel:setText(curProp[1].."：[color=#00ff00]"..curPropNum.."[/color]")
                self._refineBtn:setGrayed(true)
            end
            self._mainNode1:setVisible(not isMax)
            self._attrNode:setVisible(not isMax)
            self._newAttrLabel:setVisible(isMax)
            self._levelMaxImg:setVisible(isMax)
            self._tipsLabel:setVisible(not isMax)
            self._refineBtn:setText(isMax and GReadText.KEY_STRENGTHEN_TIPS102 or GReadText.KEY_STRENGTHEN_TIPS101)
        else
            self._nameLabels1:setText(GReadText.KEY_STRENGTHEN_TIPS97)
            --消耗
            self._itemcost, self._costLord = StrengthenModule:getLevelUpCost(itemInfo, 1)
            self._itemList:setNumItems(#self._itemcost)
            local lordStr = "[color=#00ff00]"..CommonFunc:changeNumberShow(self._costLord).."[/color]"
            self._costLabel1:setText(string.format(GReadText.KEY_NPC_CLS_SKILL_TIPS3, _GURL.GetImageCoin..lordStr))
            self._attrNode:setVisible(false)
            self._levelMaxImg:setVisible(false)
            self._refineBtn:setText(GReadText.KEY_STRENGTHEN_TIPS101)
            self._refineBtn:setGrayed(true)
        end
        self._icons3:setVisible(itemInfo ~= nil)
        self._frameImg3:setVisible(itemInfo ~= nil)
        self._nameLabels3:setVisible(itemInfo ~= nil)
    end
    self._costLoader:setVisible(self._itemInfo1 ~= nil or self._itemInfo2 ~= nil)
    self._costLabel:setVisible(self._itemInfo1 ~= nil or self._itemInfo2 ~= nil)
    self._emptyNode:setVisible(self._itemInfo1 ~= nil or self._itemInfo2 ~= nil)
    self._itemList:setVisible(self._itemInfo1 ~= nil or self._itemInfo2 ~= nil)
    self._costLabel1:setVisible(self._itemInfo1 ~= nil or self._itemInfo2 ~= nil)
