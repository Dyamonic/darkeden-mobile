--动画回调
function UICompStFusion:spineAnimationEnd(event)
    if event.type == "complete" then
        if event.animation == "XinZhuangBei" then
            self._animNode:setVisible(false)
            AudioManager:playSound(Constant.SoundEffect.EventFanfare)
        elseif event.animation == "ShengJiPanDuan2" then
            local success = self._params.bSuccess
            if success then
                self._resultSpine:setAnimationScale(0.5)
                self._resultSpine:setAnimation(0, "ShengJiChengGong2", false)
                self:showFusionResult(self._params)
            else
                self._resultSpine:setAnimationScale(1)
                self._resultSpine:setAnimation(0, "ShengJiShiBai2", false)
                self:showFusionResult(self._params)
            end
        elseif event.animation == "ShengJiChengGong2" then
            self._effectnNode:setVisible(false)
            AudioManager:playSound(Constant.SoundEffect.EventFanfare)
        elseif event.animation == "ShengJiShiBai2" then
            self._effectnNode:setVisible(false)
            AudioManager:playSound(Constant.SoundEffect.JewelItemMoveSound)
        end
    end
end

