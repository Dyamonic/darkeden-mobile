function UICompStFusion:onEnter()
    TimeCounterManager:startTimeCounter(TimeCounterManager.TC.EQUIP_STFUSION_UPDATE, {callback = function()
        if self._isOpenTimerRefresh then
            self:refreshTimer()
        end
    end })
    ScheduleManager:startTimeCounter(ScheduleManager.TC.EQUIP_STFUSION_UPDATE, {callback = handler(self, self.onUpdate)})

    for i = 1, 2 do
        self["_btnPanel"..i]:addClickListener(handler(self, self["onCancelBtnClick"..i]))
    end
    self._levelupBtn:addClickListener(handler(self, self.onLevelupBtnClick))
    for k, v in ipairs(self._fiterBtns) do
        v:addClickListener(handler(self, self.openFiterBtnClick))
    end
    self._item:addClickListener(function()
        local cost = InheritCost
        if self._openViewType == FUSION_TYPES.COMPOSE then
            cost = StrengthenModule:getFusionItem(self._itemInfo1)
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = CacheManager:getItemMeta(cost), tipsType = Constant.PROPTIPS_FORM.Display})
    end)
    self._sureBtn:addClickListener(handler(self, self.onSureBtnClick))

    for i = 1, 3 do
        self["_btnPanels"..i]:addEventListener(fgui.UIEventType.TouchBegin, handler(self, self.onTouchBegain))
        self["_btnPanels"..i]:addEventListener(fgui.UIEventType.TouchEnd, handler(self, self.onTouchEnd))
    end
    self._itemList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    self._refineBtn:addClickListener(handler(self, self.onLevelupBtnClick))

    
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB,
        handler(self, self.refreshItemNum), "UICompStFusion:refreshItemNum")
end

function UICompStFusion:onExit()
    for i = 1, 2 do
        self["_btnPanel"..i]:removeClickListener()
    end
    self._levelupBtn:removeClickListener()
    for k, v in ipairs(self._fiterBtns) do
        v:removeClickListener()
    end
    self._item:removeClickListener()
    self._sureBtn:removeClickListener()

    for i = 1, 3 do
        self["_btnPanels"..i]:removeEventListener(fgui.UIEventType.TouchBegin)
        self["_btnPanels"..i]:removeEventListener(fgui.UIEventType.TouchEnd)
    end
    self._itemList:removeEventListener(fgui.UIEventType.ClickItem)
    self._refineBtn:removeClickListener()
    TimeCounterManager:stopTimeCounter(TimeCounterManager.TC.EQUIP_STFUSION_UPDATE)
    ScheduleManager:stopTimeCounter(ScheduleManager.TC.EQUIP_STFUSION_UPDATE)
    NtfManager:removeNtfListenerByTag(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB, "UICompStFusion:refreshItemNum")
end

function UICompStFusion:onUpdate(_, dt)
    self:checkLongPress(dt)
end

function UICompStFusion:checkLongPress(dt)
    if self._beginLongPress then
        self._beginLongPress = self._beginLongPress + dt
        if self._beginLongPress > LONG_PRESS_TIME then
            self._beginLongPress = nil
            self:onBeginLongPressEvent()
        end
    end
end

-- began 长按
function UICompStFusion:onBeginLongPressEvent()
    if self._btnName == "panel_btns1" then
        if self._itemInfo1 then
            local itemType = self._itemInfo1:getItemType()
            if itemType == Constant.ItemType.ITEM_TYPE_PROP then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = self._itemInfo1, tipsType = Constant.PROPTIPS_FORM.Display})
            elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = self._itemInfo1, tipsType = Constant.PROPTIPS_FORM.Display})
            end
        end
    elseif self._btnName == "panel_btns2" then
        local itemType = self._itemInfo2:getItemType()
        if itemType == Constant.ItemType.ITEM_TYPE_PROP then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = self._itemInfo2, tipsType = Constant.PROPTIPS_FORM.Display})
        elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = self._itemInfo2, tipsType = Constant.PROPTIPS_FORM.Display})
        end
    elseif self._btnName == "panel_btns3" then
        self:onShowRefineResultClick()
    end
end

function UICompStFusion:startBeginLongPress() 
    self._beginLongPress = 0
end

function UICompStFusion:resetBeganLongPress()
    self._beginLongPress = nil
end

function UICompStFusion:onTouchBegain(context)
    self._btnName = context:getSender().name
    self:startBeginLongPress()
end

function UICompStFusion:onTouchEnd(context)
    local btnName = context:getSender().name
    if btnName ~= self._btnName then
        return
    end
    if self._beginLongPress == nil then
        return
    end
    self:resetBeganLongPress()
    --普通点击事件
    if self._btnName == "panel_btns1" then
        self:onCancelBtnClick1()
    elseif self._btnName == "panel_btns2" then
        self:onCancelBtnClick2()
    elseif self._btnName == "panel_btns3" then
        if self._itemInfo1 then
            local level = self._itemInfo1:getILevel()
            local isMax = StrengthenModule:isLevelMax(self._itemInfo1, level)
            if isMax then
                self:onCancelBtnClick1()
            end
        end
    end
    self._btnName = nil
end

function UICompStFusion:openFiterView(sender)
    if self._openViewType == sender.fiterType then 
        return 
    end
    -- if self._openViewType == self._result then
    --     return
    -- end
    self._openViewType = sender.fiterType
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SELECT_SUBVIEW, self._openViewType)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_EQUIP_FUSION_SURE)
end

--左侧界面
function UICompStFusion:refreshView1(itemInfo, subIdx)
    self:clear1()
    self._itemContentTable = {}
    self._itemInfo1 = itemInfo
    self._costLord = 0
    self._openViewType = subIdx
    self._controlTab:setSelectedIndex(self._openViewType - 1)
    self._itemContentTable = {}
    if self._openViewType == FUSION_TYPES.REFINE then
        --精炼
        if self._icons1 == nil then
            self._icons1 = fgui.UIPackage:createObject("Item", "Item")
            self._icons1:insertObjectToFactory(self)
            self._icons1:setPivot(0.5, 0.5, true)
            self._iconPanels1:addChild(self._icons1)
        end
        if itemInfo then
            self._icons1:setItemInfo(itemInfo)
        end
        self._icons1:setVisible(itemInfo ~= nil)
    else
        if self._icon1 == nil then
            self._icon1 = fgui.UIPackage:createObject("Item", "Item")
            self._icon1:insertObjectToFactory(self)
            self._icon1:setPivot(0.5, 0.5, true)
            self._equipIcon1:addChild(self._icon1)
        end
        if itemInfo then
            self._icon1:setItemInfo(itemInfo)
        end
        self._icon1:setVisible(itemInfo ~= nil)
    end

    if self._openViewType == FUSION_TYPES.COMPOSE then
        --装备合成
        self._costBar1:setVisible(itemInfo ~= nil)
        self._emptyLabel1:setText(GReadText.KEY_STRENGTHEN_TIPS18)
        self._emptyLabel1:setVisible(itemInfo == nil)
        self._tipsLabel1:setText(GReadText.KEY_STRENGTHEN_TIPS19)
        self._tipsLabel1:setVisible(itemInfo == nil)
        self._tipsLabel2:setText(GReadText.KEY_STRENGTHEN_TIPS20)
        self._tipsLabel2:setVisible(itemInfo == nil)
        self._levelupBtn:setText(GReadText.KEY_STRENGTHEN_TIPS21)
        self._attrlist1:setVisible(itemInfo ~= nil)
        if itemInfo then
            self._cost = StrengthenModule:getFusionItem(itemInfo)
            if self._cost ~= 0 then
                self._attr1 = StrengthenModule:transformAffix(itemInfo)
                self._attrlist1:setNumItems(#self._attr1)
                self._item:setInfo(string.format(_GURL.GetImageItem,self._cost))
                self._item:setItemNums("")
                self._item:setNeedNum(ItemModule:getItemNum(self._cost), 1)
                self._item:setIconScale(1.5, 1.5)
                self._costLabel:setText(CacheManager:getItemMeta(self._cost):getName())

                local _itemkey = string.format("%d_%d",1,self._cost)
                self._itemContentTable[_itemkey] = true
            end
        else
            self._attrlist1:setNumItems(0)
        end
        self._refineNode:setVisible(false)
        self._mainNode:setVisible(true)

        local gray = itemInfo == nil or self._itemInfo2 == nil
        if not gray and self._cost then
            gray = ItemModule:getItemNum(self._cost) < 1
        end
        self._levelupBtn:setGrayed(gray)
    elseif self._openViewType == FUSION_TYPES.INHERIT then
        --装备继承
        self._costBar1:setVisible(itemInfo ~= nil)
        self._emptyLabel1:setText(GReadText.KEY_STRENGTHEN_TIPS22)
        self._emptyLabel1:setVisible(itemInfo == nil)
        self._tipsLabel1:setText(GReadText.KEY_STRENGTHEN_TIPS23)
        self._tipsLabel1:setVisible(itemInfo == nil)
        self._tipsLabel2:setText(GReadText.KEY_STRENGTHEN_TIPS24)
        self._tipsLabel2:setVisible(itemInfo == nil)
        self._attrlist1:setVisible(itemInfo ~= nil)
        self._levelupBtn:setText(GReadText.KEY_STRENGTHEN_TIPS25)
        self._cost = InheritCost
        if itemInfo then
            self._attr1 = StrengthenModule:transformAffix(itemInfo)
            self._attrlist1:setNumItems(#self._attr1)
        else
            self._attrlist1:setNumItems(0)
        end
        self._costLabel:setText(CacheManager:getItemMeta(self._cost):getName())
        self._costLabel:setVisible(true)
        self._item:setInfo(string.format(_GURL.GetImageItem,self._cost))
        self._item:setItemNums("")
        self._item:setNeedNum(ItemModule:getItemNum(self._cost), 1)
        self._item:setIconScale(1.5, 1.5)
        self._refineNode:setVisible(false)
        self._mainNode:setVisible(true)

        local gray = itemInfo == nil or self._itemInfo2 == nil
        if not gray and self._cost then
            gray = ItemModule:getItemNum(self._cost) < 1
        end
        self._levelupBtn:setGrayed(gray)
        
        local _itemkey = string.format("%d_%d",1,self._cost)
        self._itemContentTable[_itemkey] = true
    elseif self._openViewType == FUSION_TYPES.REFINE then
        self._mainNode:setVisible(false)
        self._refineNode:setVisible(true)
        self._costBar3:setVisible(itemInfo ~= nil)
        if itemInfo == nil then
            self._tipsLabel:setText(GReadText.KEY_STRENGTHEN_TIPS94)
        else
            if self._itemInfo2 then
                local rate = StrengthenModule:getLevelUpRate(itemInfo, itemInfo:getILevel())
                self._tipsLabel:setText(GReadText.KEY_STRENGTHEN_TIPS96.."[color=#ffff00]"..rate.."%[/color]")
            else
                self._tipsLabel:setText(GReadText.KEY_STRENGTHEN_TIPS95)
            end
        end
        self._tipsLabel:setColor(Constant.COLORS.white)
        self._tipsLabel:setVisible(true)

        if self._icons3 == nil then
            self._icons3 = fgui.UIPackage:createObject("Item", "Item")
            self._icons3:insertObjectToFactory(self)
            self._icons3:setPivot(0.5, 0.5, true)
            self._iconPanels3:addChild(self._icons3)
        end
        if itemInfo then
