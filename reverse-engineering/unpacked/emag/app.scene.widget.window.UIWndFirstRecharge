local UIWndFirstRecharge          = class("UIWndFirstRecharge", lt.UIWindowBase)
local CacheManager = lt.CacheManager
local Constant = lt.Constant
local GameModule = lt.GameModule
local ItemModule = lt.ItemModule
local NtfManager = lt.NtfManager
local RechargeModule = lt.RechargeModule

local PRICETAB = {
    [0] = "6"..GReadText.KEY_ACTIVITY_RMB_TIP,
    [1] = "30"..GReadText.KEY_ACTIVITY_RMB_TIP,
    [2] = "68"..GReadText.KEY_ACTIVITY_RMB_TIP
}

local DAYIDX = {
    FirstDay = 0,
    SecondDay = 1,
    ThirdDay = 2
}

local NPCBGNAME ={
    [0] = "bg_sc_bg1",
    [1] = "bg_sc_bg2",
    [2] = "bg_sc_bg3"
}

function UIWndFirstRecharge:ctor(param)
    UIWndFirstRecharge.super.ctor(self, param)
end

function UIWndFirstRecharge:onClear()
    self._btnsControl = nil
    self._daysControl  = nil
    self._btnshowControl  = nil
    self._listItem  = nil
    self._btnJunior = nil
    self._btnAdvanced = nil
    self._btnLuxury = nil
    self._btnBuyGift = nil
    self._btnGetGift = nil
    self._dayBtns = nil
    self._textPrice = nil
    self._textBtnDes = nil
    self._getGiftBtnControl = nil
    self._redGetGift = nil
    self._titleGetGift = nil
    self._redBtnDay1 = nil
    self._redBtnDay2 = nil
    self._redBtnDay3 = nil
    self._redBtnJunior = nil
    self._redBtnAdvanced = nil
    self._redBtnLuxury = nil
    self._bgNPC1 = nil
    self._bgNPC2 = nil
    self._oldNPCBgURL = nil
    self._tBgFadeChange = nil
    self._tBgFadeIn = nil
    UIWndFirstRecharge.super.onClear(self)
end

function UIWndFirstRecharge:onInit()
    UIWndFirstRecharge.super.onInit(self, _GURL.UIWndFirstRecharge)
    self._btnsControl = self:getController("btns")
    self._daysControl  = self:getController("days")
    self._btnshowControl  = self:getController("btnshow")
    self._listItem  = self:getChild("list_item")
    self._btnJunior = self:getChild("btn6")
    self._btnAdvanced = self:getChild("btn30")
    self._btnLuxury = self:getChild("btn68")
    self._btnBuyGift = self:getChild("btnbuygift")
    self._btnGetGift = self:getChild("btnreward")
    self._dayBtns = {}
    for fiterType = 1,3 do
        local obj = self:getChild("btnday"..fiterType)
        obj.fiterType = fiterType
        self._dayBtns[fiterType] = obj
    end
    self._textPrice = self:getChild("price")
    self._textBtnDes = self:getChild("des")
    self._btnBuyGift:getChild("red"):setVisible(false)

    self._getGiftBtnControl = self._btnGetGift:getController("button")
    self._redGetGift = self._btnGetGift:getChild("red")
    self._titleGetGift = self._btnGetGift:getChild("title")
    
    self._redBtnDay1 = self._dayBtns[1]:getChild("red")
    self._redBtnDay2 = self._dayBtns[2]:getChild("red")
    self._redBtnDay3 = self._dayBtns[3]:getChild("red")
    self._redBtnJunior = self._btnJunior:getChild("red")
    self._redBtnAdvanced = self._btnAdvanced:getChild("red")
    self._redBtnLuxury = self._btnLuxury:getChild("red")
    self._bgNPC1 = self:getChild("npcbg1")
    self._bgNPC2 = self:getChild("npcbg2")
    self._tBgFadeIn = self:getTransition("fadein")
    self._tBgFadeOut = self:getTransition("fadeout")
    self._btnJunior.fiterType = 0
    self._btnAdvanced.fiterType = 1
    self._btnLuxury.fiterType = 2
    self._listItem:setItemRenderer(handler(self, self.onItemRender))
end

function UIWndFirstRecharge:onShown()
    UIWndFirstRecharge.super.onShown(self)
    self._btnBuyGift:addClickListener(handler(self, self.onBuyMallIdClick))
    self._btnGetGift:addClickListener(handler(self, self.onGetRewardClick))
    self._btnJunior:addClickListener(handler(self, self.onChangeClickPackItem))
    self._btnAdvanced:addClickListener(handler(self, self.onChangeClickPackItem))
    self._btnLuxury:addClickListener(handler(self, self.onChangeClickPackItem))
    self._listItem:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    if self._dayBtns then
        for _,obj in pairs(self._dayBtns) do
            obj:addClickListener(handler(self, self.onInitRewardItem))
        end
    end
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CS_FIRST_RECHARGE_TIPS, handler(self, self.refreshFirstRechargeTips), "UIWndFirstRecharge:refreshFirstRechargeTips")
    self:initUI()
end

function UIWndFirstRecharge:onHide()
    self._btnBuyGift:removeClickListener()
    self._btnGetGift:removeClickListener()
    self._btnJunior:removeClickListener()
    self._btnAdvanced:removeClickListener()
    self._btnLuxury:removeClickListener()
    if self._dayBtns then
        for _,obj in pairs(self._dayBtns) do
            obj:removeClickListener()
        end
    end
    self._listItem:removeItemRenderer()
    self._listItem:removeEventListener(fgui.UIEventType.ClickItem)
    NtfManager:removeNtfListenerByTag("UIWndFirstRecharge:refreshFirstRechargeTips")
    self._oldNPCBgURL = nil
    UIWndFirstRecharge.super.onHide(self)
end

function UIWndFirstRecharge:refreshFirstRechargeTips()
    self._btnShowStates = RechargeModule:getFirstRechargeBtnStates()
    self._btnshowControl:setSelectedIndex(self._btnShowStates)
    self:onInitRewardItem()
    self:onRefreshBtnRed()
end

function UIWndFirstRecharge:initUI()
    local reward,key,days = RechargeModule:getFirstRechargeEntryRed()
    if reward then
        self._selectStates = key - 1
        self._dayStates = days - 1
    else
        for i = Constant.FIRSTRECHARGEGIFT.MAX,1,-1 do
            local open = RechargeModule:getFirstRechargeInfoStates(i)
            if open then
                self._selectStates = i - 1
                break
            end
        end
        self._selectStates = self._selectStates or 0
        self._dayStates = self._dayStates or 0
    end
    self._btnShowStates = RechargeModule:getFirstRechargeBtnStates()
    self._btnsControl:setSelectedIndex(self._selectStates)
    self._daysControl:setSelectedIndex(self._dayStates)
    self._btnshowControl:setSelectedIndex(self._btnShowStates)
    self:onChangeClickPackItem(nil,true)
    self:onRefreshBtnRed()
end

