local ScheduleUtil = lt.ScheduleUtil

local descTips = GReadText["KET_SKILL_TIPS1"]

function UICompRoleSkill:ctor()
    self:registerComponent("UICompSkillItem")
    self._btnIndex = nil
    self._curCls = nil
    self._race = nil
    self._listCfg = nil
    UICompRoleSkill.super.ctor(self)
end

function UICompRoleSkill:onClear()
    self:unregisterAllComponent()
    self._btnIndex = nil
    self._curCls = nil
    self._race = nil
    self._listCfg = nil
    UICompRoleSkill.super.onClear(self)
end

function UICompRoleSkill:onEnter()
    for i=1,4 do
        local btn = self:getChild("btn" .. i)
        btn.index = i
        btn:addClickListener(handler(self, function()
            self._btnIndex = i
            -- self:refreshBtnName(self._btnIndex)
            self:refreshPanelByCls(self._curCls)
        end))
    end
    self._roleSkillList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))

    local lvlBar = self:getChild("bar1")
    lvlBar:addClickListener(handler(self, function()
        self:showLevelTips()
    end))

    local expBar = self:getChild("bar2")
    expBar:addClickListener(handler(self, function()
        self:showExpTips()
    end))
end

function UICompRoleSkill:onExit()
    for i=1,4 do
        local btn = self:getChild("btn" .. i)
        btn:removeClickListener()
    end

    self._roleSkillList:removeEventListener(fgui.UIEventType.ClickItem)

    local lvlBar = self:getChild("bar1")
    lvlBar:removeClickListener()

    local expBar = self:getChild("bar2")
    expBar:removeClickListener()
end

function UICompRoleSkill:initUI()
    self._race = GameModule:getHeroRace()
end

function UICompRoleSkill:refreshBtnName(index)
    for j=1,4 do
        local btn = self:getChild("btn" .. j)
        local btnControl = btn:getController("visible")
        if index == btn.index then
            btnControl:setSelectedIndex(0)
        else
            btnControl:setSelectedIndex(1)
        end
    end
end

function UICompRoleSkill:onConstruct()
    self:startSkin()
    self._roleSkillList = self:getChild("skilllist")
    self._roleSkillList:setItemRenderer(handler(self, self.renderListItem))
end

function UICompRoleSkill:refreshPanelByCls(curCls,isInit)
    self._curCls = curCls
    
    local heroData = GameModule:getHeroData()
    local grade = heroData:getGrade()
    local rankExpCfg = RankEXPInfoDao:query(grade)
    -- print("rankExpCfg" .. rankExpCfg:getClassLevel())
    local rankEXPTable = RankEXPInfoDao:queryAll()
    local bar1Percent = grade/#rankEXPTable
    local bar1 = self:getChild("bar1")
    bar1:setFillAmount(bar1Percent)
    local value1 = self:getChild("value1")
    value1:setText(grade .. "/" .. #rankEXPTable)

    local bar2 = self:getChild("bar2")
    local gradeExp = heroData:getGradeExp()
    local needExp = rankExpCfg:getGoalEXP()
    local bar2Percent = gradeExp/needExp
    bar2:setFillAmount(bar2Percent)
    local value2 = self:getChild("value2")
    value2:setText(math.floor(bar2Percent*100) .. "%/100%")

    -- 刷新按钮状态
    if isInit then
        self._btnIndex = 1
        local selectControl = self:getController("select")
        selectControl:setSelectedIndex(self._btnIndex - 1)
    end
    self:refreshBtnName(self._btnIndex)

    -- 技能数据组装
    local listCfg = {}
    local curMax = 0
    if Constant.RoleInfoBtnType.lowCls == curCls then
        -- local lowCfg = getLowCfg(self._race)
        listCfg = CacheManager:getRankBonusInfoCfg(self._race, 1, 4)
        curMax = #listCfg
    elseif Constant.RoleInfoBtnType.superCls == curCls then
        listCfg = CacheManager:getRankBonusInfoCfg(self._race, 5, 6)
        curMax = #listCfg
    end
    self._listCfg = listCfg

    -- 技能分类
    local idx = curCls == Constant.RoleInfoBtnType.lowCls and 3 or 4
    for i=1,4 do
        local btn = self:getChild("btn" .. i)
        btn:setVisible(curMax >= i)
        local itemCfg = listCfg[i]
        if itemCfg and itemCfg[1] then
            local classLevel = itemCfg[1]:getClassLevel()
            local rankData = CacheManager:getRoleRankByRaceAndLvl(self._race,classLevel)
            local name = ""
            if rankData then
                name = rankData:getName()
            end
            btn:getChild("name"):setText(name)
            btn:getChild("nameSelect"):setText(name)
            local isRed = SkillModule:getRedPoint(idx, i)
            btn:getChild("reddot"):setVisible(isRed)
        end
    end

    -- 技能列表

    if listCfg[self._btnIndex] then
        self._roleSkillList:setNumItems(#listCfg[self._btnIndex])
    end
    -- print("------------------->" .. (curCls or 0))
end

function UICompRoleSkill:uptRedDotEvt()
    local max = self._curCls == Constant.RoleInfoBtnType.lowCls and 4 or 2
    local idx = self._curCls == Constant.RoleInfoBtnType.lowCls and 3 or 4
    for i = 1, max do
        local isRed = SkillModule:getRedPoint(idx, i)
        local btn = self:getChild("btn"..i)
        btn:getChild("reddot"):setVisible(isRed)
    end
end

function UICompRoleSkill:renderListItem(index, obj)
    obj.index = index

    local skillItemCfg = self._listCfg[self._btnIndex][index+1]
    if not skillItemCfg then
        return
    end

    local spriteId = skillItemCfg:getSpriteID()
    obj:setSpriteId(spriteId)

    local curState = Constant.ClsSkillState.NotLearnable
    local heroData = GameModule:getHeroData()
    local grade = heroData:getGrade()
    local classLevel = skillItemCfg:getClassLevel()
    if classLevel <= grade then
        curState = Constant.ClsSkillState.Learnable
    end

    local learned = SkillModule:checkPassiveSkillLearned(skillItemCfg:getRankId())
    local classLevel = skillItemCfg:getClassLevel()
    local race = skillItemCfg:getRace()
    local rankBonusInfoTable = RankBonusInfoDao:queryByClassLevelAndRaceId(classLevel,race)
    local sameLearned = false
    if not learned then -- 未学习才去检测
        for k,v in pairs(rankBonusInfoTable) do
            local learned = SkillModule:checkPassiveSkillLearned(k)
            if learned then
                sameLearned = true
                break
            end
        end
    end
    if learned then
        curState = Constant.ClsSkillState.Learned
    elseif sameLearned then -- 最后检查同类型的技能是否有学习过的
        curState = Constant.ClsSkillState.CurUnableToLearn
    end
    
    obj:refreshItem(curState)
    obj:insertObjectToFactory(self)
end

function UICompRoleSkill:onClickItem(context)
    local data = context:getData()
    if not data.index then
        return
    end

    local skillItemCfg = self._listCfg[self._btnIndex][data.index+1]
    -- print("seletIndex---->" .. data.index)
    -- print("skillItemCfg---->" .. skillItemCfg._enName)
    if not skillItemCfg then
        return
    end

    local btnList = { Constant.SkillTipBtns.Study }
    if data:getCurState() == Constant.ClsSkillState.NotLearnable then
        btnList = {}
    elseif data:getCurState() == Constant.ClsSkillState.Learned then
        btnList = {}
    elseif data:getCurState() == Constant.ClsSkillState.CurUnableToLearn then
        btnList = {}
    end

    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SHOW_SKILL_TIPS, 
    {
        skillInfo = skillItemCfg,
        btnList = btnList,
        btnState = data:getCurState(),
        studyCallback = function()
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {content = descTips, confirmCallback = function()
                -- print("-------------------->>>confirmCallback")
                -- data:setState(Constant.ClsSkillState.Learned)
                SkillModule:sendLearnSkill(1,skillItemCfg:getRankId())
            end})
        end
    })
end

function UICompRoleSkill:showLevelTips()
    local lvlBar = self:getChild("bar1")
    local itemSize = lvlBar:getSize()
    local point = lvlBar:localToGlobal({x=itemSize.width,y=0})
    local heroData = GameModule:getHeroData()
    local grade = heroData:getGrade()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_TEXT_TIPS, 
    {
        content = GReadText["KEY_ROLE_INFO_TIPS31"]..grade,
        pt = point,
        pivot = cc.p(0.5, 0.5)
    })
end

function UICompRoleSkill:showExpTips()
    local expBar = self:getChild("bar2")
    local itemSize = expBar:getSize()
    local point = expBar:localToGlobal({x=itemSize.width,y=0})
    local heroData = GameModule:getHeroData()
    local gradeExp = heroData:getGradeExp()
    local grade = heroData:getGrade()
    local rankExpCfg = RankEXPInfoDao:query(grade)
    local needExp = rankExpCfg:getGoalEXP()
    local percent = math.floor(gradeExp/needExp*100)
    if percent > 100 then
        percent = 100
    end
    local expStr = CommonFunc:changeNumberShow(needExp - gradeExp)
    expStr = expStr .. "("..percent.."%)"
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_TEXT_TIPS,
    {
        content = GReadText.KEY_ROLE_INFO_TIPS32..expStr,
        pt = point,
        pivot = cc.p(0.5, 0.5)
    })
end

return UICompRoleSkill