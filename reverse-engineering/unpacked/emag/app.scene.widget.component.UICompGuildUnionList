local UICompGuildUnionList = class("UICompGuildUnionList", lt.UIGButtonBase)

local NtfManager = lt.NtfManager

UICompGuildUnionList.ChangeSkinConf = {
    ["Guild"] = {
        ["bg"] = "bg_gonghuixt_15",
    },
    ["CommonTL"] = {
        ["btn_applyList"] = { icon = "bg_youjian_changanniu02" },
        ["btn_union"] = { icon = "bg_youjian_changanniu02" },
    }
}

function UICompGuildUnionList:ctor()
    self:registerComponent("UICompGuildUnionListCell")
    UICompGuildUnionList.super.ctor(self)

end

function UICompGuildUnionList:onEnter()
    UICompGuildUnionList.super.onEnter(self)
    self._btnApplyList:addClickListener(handler(self, self.onBtnFncApplyListClick))
    self._btnUnion:addClickListener(handler(self, self.onBtnFncUnionClick))
    self._btnSelect:addClickListener(handler(self, self.onBtnFncSelectClick))
end

function UICompGuildUnionList:onExit()
    self._btnApplyList:removeClickListener()
    self._btnUnion:removeClickListener()
    self._btnSelect:removeClickListener()
    self._listUnion:removeClickListener()
    UICompGuildUnionList.super.onExit(self)
    self:initUI()
end

function UICompGuildUnionList:onClear()
    self._listUnion    = nil
    self._btnApplyList = nil
    self._btnUnion     = nil
    self._btnSelect    = nil
    self:unregisterAllComponent()
    UICompGuildUnionList.super.onClear(self)
end

function UICompGuildUnionList:onConstruct()
    self._listUnion = self:getChild("list")
    self._listUnion:setItemRenderer(handler(self, self.renderListItem))

    self._btnApplyList = self:getChild("btn_applyList")
    self._btnUnion = self:getChild("btn_union")
    self._btnSelect = self:getChild("btn_select")

end

function UICompGuildUnionList:initUI()
    self._listUnion:setNumItems(10)
end

