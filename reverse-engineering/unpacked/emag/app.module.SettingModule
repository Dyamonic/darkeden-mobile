local SettingModule      = {}

local SocketApi      = lt.SocketApi
local netcmd_pb      = lt.netcmd_pb
local CommonModule   = lt.CommonModule
local ServerCmdDef   = lt.ServerCmdDef
local ClientCmdDef   = lt.ClientCmdDef
local NtfManager     = lt.NtfManager

SettingModule._codeHash = ""
SettingModule._sConfigVersion = ""


function SettingModule:init()
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.CS_VERSION_RESP),
        handler(self, self.onRevServerVersion), "SettingModule:onRevServerVersion")
end

function SettingModule:clear()
    SocketApi:removeProtoListenerByTag("SettingModule:onRevServerVersion")
    self._codeHash = nil
    self._sConfigVersion = nil
end


function SettingModule:onRevServerVersion(event)
    local proto = event.param
    self._codeHash = proto.codeHash 	-- 代码hash值
    self._sConfigVersion = proto.configVersion -- 配置文件版本
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SERVER_VERSION_REFRESH)
end

----------------------------请求----------------------------
function SettingModule:sendServerVersionReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_VERSION_REQ))
end


-----------get/set
-----------------
function SettingModule:getCodeHash()
    return self._codeHash
end
function SettingModule:getServerVersion()
    return self._sConfigVersion
end
function SettingModule:getServerVer()
    return string.format("%s_%s",self._sConfigVersion, self._codeHash)
end


return SettingModule
