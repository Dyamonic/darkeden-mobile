local AchievementModule             = {}

local SocketApi                     = lt.SocketApi
local ServerCmdDef                  = lt.ServerCmdDef
local NtfManager                    = lt.NtfManager
local GameModule                    = lt.GameModule
local CacheManager                  = lt.CacheManager
local CommonModule                  = lt.CommonModule
local netcmd_pb                     = lt.netcmd_pb
local ClientCmdDef                  = lt.ClientCmdDef
local RedDotModule                  = lt.RedDotModule

AchievementModule._achievementTable = {} -- 成就表

function AchievementModule:init()
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_ACHIEVE_LIST_RESP),
        handler(self, self.onAchieveListResp), "AchievementModule:onAchieveListResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_ACHIEVE_REWARD_RESP),
        handler(self, self.onAchieveRewardResp), "AchievementModule:onAchieveRewardResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_ACHIEVE_UPDATE_NTF),
        handler(self, self.onAchieveUpdateNtf), "AchievementModule:onAchieveUpdateNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_ACHIEVE_JUMP_MAP_RESP),
        handler(self, self.onAchieveJumpMapResp), "AchievementModule:onAchieveJumpMapResp")
end

function AchievementModule:clear()
    SocketApi:removeProtoListenerByTag("AchievementModule:onAchieveListResp")
    SocketApi:removeProtoListenerByTag("AchievementModule:onAchieveRewardResp")
    SocketApi:removeProtoListenerByTag("AchievementModule:onAchieveUpdateNtf")
    SocketApi:removeProtoListenerByTag("AchievementModule:onAchieveJumpMapResp")

    self._achievementTable = {}
end

-----------------------------------------------------
-- 根据种族分类
function AchievementModule:getAchivementMap()
    local heroData = GameModule:getHeroData()
    if not heroData then
        return
    end
    local myrace = heroData:getRace()
    local firstList = CacheManager:getAchivementMap()
    local mapTable = {}
    for i, meta in pairs(firstList or {}) do
        local condi = meta:getRace() or 0
        if condi == 0 or myrace == condi then
            local first = meta:getFirst()
            local second = meta:getSecond()
            if not mapTable[first] then
                mapTable[first] = {}
            end
            if not mapTable[first][second] then
                mapTable[first][second] = {}
            end
            table.insert(mapTable[first][second], meta)
        end
    end
    return mapTable
end

function AchievementModule:getAchivementById(id)
    local vid = tonumber(id)
    return self._achievementTable[vid] or nil
end

function AchievementModule:getAcheivementByType(type)
    local listData = AchievementModule:getAchivementMap()
    local list = {}
    for k, v in pairs(listData[type] or {}) do
        for kk, vv in pairs(v or {}) do
            local acievement = self:getAchivementById(vv:getId())
            if acievement then
                if not acievement.reward and acievement.step >= tonumber(vv:getMissionTarget()[1]) then
                    table.insert(list, vv)
                end
            end
        end
    end
    return list
end

function AchievementModule:getAcheivementByTitle(data)
    if not data then
        return {}
    end
    local list = {}
    for kk, vv in pairs(data or {}) do
        local acievement = self:getAchivementById(vv:getId())
        if acievement then
            if not acievement.reward and acievement.step >= tonumber(vv:getMissionTarget()[1]) then
                table.insert(list, vv)
            end
        end
    end
    return list
end

----------------------------请求----------------------------
-- 请求
function AchievementModule:sendAchieveListReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_ACHIEVE_LIST_REQ))
end

-- 领取奖励
function AchievementModule:sendAchieveRewardReq(vId)
    local msg = netcmd_pb.CS_AchieveRewardReq()
    msg.vId = vId
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_ACHIEVE_REWARD_REQ), msg)
end

-- 成就跳地图
function AchievementModule:sendAchieveJumpMapReq(id)
    local msg = netcmd_pb.CS_AchieveJumpMapReq()
    msg.id = id
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_ACHIEVE_JUMP_MAP_REQ), msg)
end

----------------------------回调----------------------------
function AchievementModule:onAchieveListResp(event)
    local proto = event.param
    local vAchieve = proto.vAchieve
    -- 全量
    self._achievementTable = {}
    for i, v in ipairs(vAchieve or {}) do
        self._achievementTable[v.id] = v
        -- yflog:Info("------------------" .. v.id .. "=-=" .. v.step .. "=-=" .. tostring(v.reward))
    end
    self:initAchievementList()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ACHIEVEMENT_LIST_CHANGE)
end

function AchievementModule:onAchieveRewardResp(event)
    local proto = event.param
    local vId = proto.vId
    local ret = proto.ret


    -- 领取成功下发
    for i, v in ipairs(vId or {}) do
        if self._achievementTable[tonumber(v)] then
            self._achievementTable[tonumber(v)].reward = true
        else
            yflog:Info("-----onAchieveRewardResp not in self._achievementTable" .. v)
        end
    end
    if ret == 0 and #vId > 0 then
        self:initAchievementList()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ACHIEVEMENT_LIST_DESC_CHANGE)
    end
end

function AchievementModule:onAchieveUpdateNtf(event)
    local proto = event.param
    local vAchieve = proto.vAchieve

    -- 增量 一般是 进度
    for i, v in ipairs(vAchieve or {}) do
        self._achievementTable[v.id] = v -- 直接覆盖
    end
    self:initAchievementList()
end

function AchievementModule:onAchieveJumpMapResp(event)
    local proto = event.param
    local ret = proto.ret

    yflog:Info("-----onAchieveJumpMapResp" .. ret)
end

----------------------------红点----------------------------
function AchievementModule:setAchievementRedTips(type, bool)
    RedDotModule:setTipsStateByName("AchievementRedTips" .. type, bool)
end

function AchievementModule:getRedPoint(type)
    return RedDotModule:getTipsStateByName("AchievementRedTips" .. type)
end

function AchievementModule:initAchievementList()
    local listData = AchievementModule:getAchivementMap()
    for i, v in ipairs(listData or {}) do
        local list = self:getAcheivementByType(i)
        AchievementModule:setAchievementRedTips(i, #list > 0)
    end
end

function AchievementModule:getRedPointAll()
    local listData = AchievementModule:getAchivementMap()
    for i, v in ipairs(listData or {}) do
        local point = self:getRedPoint(i)
        if point then
            return true
        end
    end
    return false
end

return AchievementModule
