
local NpcAgent = class("NpcAgent", lt.BaseAgent)

NpcAgent._objId        = nil
NpcAgent._modelId      = nil
NpcAgent._name         = nil
NpcAgent._npcActor     = nil
NpcAgent._stateMachine = nil

-- MN，与服务器严格对应
NpcAgent._mCur = nil
NpcAgent._nCur = nil

function NpcAgent:ctor(npcMeta)
    NpcAgent.super.ctor(self, lt.Constant.AGENT_TYPE_NPC)


    local name = npcMeta:getNpcName()
    local direction = npcMeta:getNpcDirection()
    local npcType = npcMeta:getNpcType()

    self._objId   = npcMeta:getNpcId()
    self._modelId = npcMeta:getNpcFigure()
    self._mCur, self._nCur = npcMeta:getNpcPos()
    self._npcVisible = true
    self:setName(name)


    -- lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MINIMAP_ADD_MN, {agentId=self._agentId,m=m,n=n,colorType=lt.Constant.MINIMAP_RED})
    lt.GameModule:addUpdateEventMiniMap(lt.NtfManager.NTF.NTF_MINIMAP_ADD_MN, {agentId=self._agentId,m=m,n=n,colorType=lt.Constant.MINIMAP_RED})
    
    local npcX, npcY = lt.MapUtil:calcMNMid(self._mCur, self._nCur)

    local roleModelInfo = npcMeta:getRoleModel()
    if type(roleModelInfo) == "table" then
        local heroData = lt.GameModule:createNpcHeroData(self._objId, roleModelInfo)
        self._npcActor = lt.HeroActor.new(heroData, direction, false)
    else
        self._npcActor = lt.NpcActor.new(self._modelId, self._objId, name, direction, npcType)
    end
    self:setAgent()
    self:setPosition(npcX, npcY)

    self._stateMachine = lt.StateMachine.new(lt.NpcStateIdle.new(self), lt.NpcStateGlobal.new(self))

    lt.AgentManager:addAgent(self)

    if DEBUG > 0 then
        -- local rect = self:getRect()

        -- local spriteRect = display.newSprite("ui/common/rect.png")
        -- spriteRect:setAnchorPoint(0.5, 0)
        -- spriteRect:setScale(rect.width / 100, rect.height / 100)
        -- self._npcActor:addChild(spriteRect, 999999)
    end
end

function NpcAgent:onClear()
    -- 从AgentManager中移除
    lt.AgentManager:removeAgent(self)

    if self._npcActor then
        self._npcActor:onClear()
    end
    if self._stateMachine then
        self._stateMachine:onClear()
    end

    self._npcActor = nil
    self._stateMachine = nil

    -- lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MINIMAP_DEL_MN, {agentId=self._agentId})
    lt.GameModule:addUpdateEventMiniMap(lt.NtfManager.NTF.NTF_MINIMAP_DEL_MN, {agentId=self._agentId})
end

function NpcAgent:onUpdate()
    if self._stateMachine then
        self._stateMachine:onUpdate()
    end
    if self._npcActor then
        self._npcActor:onUpdate()
    end
end

-- State
function NpcAgent:changeState(newState)
    self._stateMachine:changeState(newState)
end

function NpcAgent:getObjId()
    return self._npcData:getObjId()
end

-- 动画
function NpcAgent:playAction(actionId)
    self._npcActor:playAction(actionId)
end

function NpcAgent:setAgent()
    self._npcActor:setAgent(self)
end

function NpcAgent:getModelHeight()
    local modelMeta = lt.CacheManager:getModelMeta(self._npcData:getModelId())
    return modelMeta:getHeight()
end

function NpcAgent:showTargetMark()
    self._npcActor:showTargetMark()
end

function NpcAgent:hideTargetMark()
    self._npcActor:hideTargetMark()
end

-- 位移
function NpcAgent:getRect()
    local modelMeta = lt.CacheManager:getModelMeta(self._modelId)
    local modelRadius = modelMeta:getRadius()
    local modelHeight = modelMeta:getHeight()

    local x, y = self:getPosition()
    return cc.rect(x - modelRadius, y, modelRadius * 2, modelHeight)
end

function NpcAgent:setAgent()
    self._npcActor:setAgent(self)
end
function NpcAgent:getIsHallu()
    return false
end
function NpcAgent:hasBuffer()
    return false
end
function NpcAgent:isStateShot()
    return false
end

function NpcAgent:isStateSkill()
    return false
end

function NpcAgent:isAttackDummy()
    return false
end

function NpcAgent:getMN()
    local x, y = self:getPosition()
    return lt.MapUtil:calcMN(x, y)
end

function NpcAgent:getMNExactly()
    return self._mCur, self._nCur
end

function NpcAgent:setMNExactly(m, n)
    self._mCur = m
    self._nCur = n
end

function NpcAgent:getPosition()
    if self._npcActor then
        return self._npcActor:getPosition()
    else
        return 0, 0
    end
end

function NpcAgent:setPosition(x, y)
    self._npcActor:setPositionEx(x, y)

    local m, n = self:getMN()

    self._npcActor:setLocalZOrder((n  * 10000 + m + 9999) * 10 + 1)

    -- local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
    -- if mapAgent:isMNMask(m, n) then
    --     self._npcActor:setAlpha(0.5)
    -- else
    --     self._npcActor:setAlpha(1)
    -- end
end

function NpcAgent:getDirection()
    return self._npcActor:getDirection()
end

function NpcAgent:setDirection(direction)
    self._npcActor:setDirection(direction)
end

-- Setter && Getter
function NpcAgent:getObjId()
    return self._objId
end

function NpcAgent:changeName(name)
    self._npcActor:changeName(name)
end

function NpcAgent:getName()
    return self._name
end

function NpcAgent:setName(name)
    name = string.gsub(name, "\\n", "\n")
    local nameReturn = string.split(name, "\n")
    self._name = nameReturn[1]
end

function NpcAgent:getActor()
    return self._npcActor
end

--更新箭头
function NpcAgent:updateTargetArrow(show)
    if self._npcActor.updateTargetArrow then
        self._npcActor:updateTargetArrow(show)
    end
end

function NpcAgent:changeVisible(isVisible)
    self:getActor():setVisible(isVisible)
end

function NpcAgent:changCasketOpen()
    self:playAction(lt.Constant.ROLE_ACTION_DIE)
end

--npc标记显示
function NpcAgent:setNpcVisible(visible)
    self._npcVisible = visible
end

function NpcAgent:getNpcVisible()
    return self._npcVisible
end

return NpcAgent
