local ActionData = class("ActionData")
--[[
    json：结构
    model{
        creature_id{
            action_id{
                direction_id{
                    spriteId: 0,
                    x: 0,
                    y: 0,
                }
            }
        }
    }

    读取字节 打开cfpk文件 并写入Table中
]]

ActionData._data = lt.NetData.new()
ActionData._actionTable = nil

function ActionData:ctor(modelname, modelId)
    self._use = 1

    self._modeName = modelname
    self._modelId = modelId

    local content = self:loadCFPKBuffer(modelname, modelId)
    self:CCreatureFramePack(content)

    -- yflog:Info("modelname:%s modelId:%s", modelname, modelId)
    -- local content = self:getJsonContent(modelname, modelId)
    -- self._actionTable = json.decode(content)
end

function ActionData:clear()
    self._actionTable = nil
end

function  ActionData:loadCFPKBuffer(modelname, modelId)
    local pathName = string.format("tlmodel/cfpk/%s/%s_%s.cfpk", modelname, modelname, modelId)
    local cfpkFullPath = cc.FileUtils:getInstance():fullPathForFilename(pathName)
    -- yflog:Info("cfpkFullPath:%s ", cfpkFullPath)

    return cc.FileUtils:getInstance():getDataFromFile(cfpkFullPath)
end

-- function ActionData:getJsonContent(modelname, modelId)
--     local pathName = string.format("tlmodel/json/%s/creature_%s.json", modelname, modelId)
--     local fullPath = cc.FileUtils:getInstance():fullPathForFilename(pathName)
--     local content = cc.FileUtils:getInstance():getStringFromFile(fullPath)
--     return content
-- end


function ActionData:CCreatureFramePack(content)
    if not content then
        return
    end

    self._actionTable = {}

    -- yflog:Info("content len: ".. #content)

    self._data:reset()
    self._data:prepare(content, #content)

    local actionCount = self._data:readByte()
    -- yflog:Info("actionCount = "..actionCount)

    local actionTable = {}
    for a = 1, actionCount, 1 do
        local dircount = self._data:readByte()
        local direction = {}

        for d = 1, dircount, 1 do
            local frameCount = self._data:readUInt16()
            -- yflog:Info("frameCount = "..frameCount)
            local directionArray = {}
            for f = 1, frameCount, 1 do
                local spriteId = self._data:readUInt16()
                local x = self._data:readInt16()
                local y = self._data:readInt16()

                directionArray[#directionArray + 1] = {spriteId = spriteId, x = x, y = y}
            end

            direction["direction_"..(d-1)] = directionArray
        end

        actionTable["action_"..(a - 1)] = direction
    end

    self._actionTable = actionTable
end

function ActionData:getAction(actionId)
    if not self._actionTable then
        yflog:Error("ActionData actionTable is nil , modelName:%s modelId:%s", self._modeName, self._modelId)
        return
    end

    return self._actionTable["action_"..actionId]
end

-- 获取某个当前角色 动作 方向 下的帧数
function ActionData:getDirection(actionId, directionId)
    local action = self:getAction(actionId)
    if not action then
        yflog:Error("ActionData action is nil , modelName:%s modelId:%s actionId:%s", self._modeName, self._modelId, actionId)
        return
    end

    return action["direction_"..directionId]
end

function ActionData:getFrameCount(actionId, directionId)
    local frameArr = self:getDirection(actionId, directionId)
    if not frameArr then
        yflog:Error("ActionData:getFrameCount frameArr is nil modelName:%s modelId:%s actionId:%s directionId:%s", self._modeName, self._modelId, actionId, directionId)
        return 0
    end

    return #frameArr
end

function ActionData:addUse()
    self._use = self._use + 1
end

function ActionData:setUse(use)
    self._use = use
end

function ActionData:getUse()
    return self._use
end

return ActionData