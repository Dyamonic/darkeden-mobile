
local TimeCounter = class("TimeCounter")

local socket = require "socket"

TimeCounter._name = name
TimeCounter._startTime = nil

TimeCounter._serverTime = nil
TimeCounter._serverResTime = nil
TimeCounter.MIN = 60
TimeCounter.HOUR = 60 * TimeCounter.MIN
TimeCounter.DAY = 24 * TimeCounter.HOUR
TimeCounter.WEEK = 7 * TimeCounter.DAY

-- 时间类型
TimeCounter.TIME_TYPE = {
    INTERVAL    = 1,    --时间间隔, 例如n天, n小时
    DATE        = 2,    --时间日期, 例如2000-01-01
}

function TimeCounter:ctor(name)
    self._name = name
    self:reset()
    -- self._startTime = socket.gettime()
end

function TimeCounter:finish()
    -- local time = socket.gettime() - self._startTime
    -- lt.LogUtil:debug("%s: %fms", self._name, time * 1000)
end

function TimeCounter:getSocketTime()
    -- return socket.gettime()
    return 0
end

-- -------------------------------------
-- string 转 time 2019-01-01 11:11:11
function TimeCounter:s2t(ts)
    if type(ts) ~= 'string' then error('s2t: ts is not a string') return 0 end

    local fun = string.gmatch(ts, "%d+")

    local y = fun() or 0    if y == 0 then error('ts is a invalid time string') return 0 end
    local m = fun() or 0    if m == 0 then error('ts is a invalid time string') return 0 end
    local d = fun() or 0    if d == 0 then error('ts is a invalid time string') return 0 end
    local H = fun() or 0    if H == 0 then error('ts is a invalid time string') return 0 end
    local M = fun() or 0    if M == 0 then error('ts is a invalid time string') return 0 end
    local S = fun() or 0    if S == 0 then error('ts is a invalid time string') return 0 end 

    return os.time({year=y, month=m, day=d, hour=H, min=M, sec=S})
end

function TimeCounter:serverOpenTimeUpdate(serverOpenTime)
    serverOpenTime = serverOpenTime .. " 00:00:00"
    self._serverOpenTime = self:s2t(serverOpenTime)
end

function TimeCounter:serverTimeUpdate(serverTime)

    self._serverTime = self:s2t(serverTime)

    self._serverResTime = self:time()
end

