
local WndLockManager = {}

-- 通用
WndLockManager._wndLockType = nil -- 窗口锁定类型
WndLockManager._subWndClass = nil -- 子窗口类型
WndLockManager._closeIgnore = nil -- 关闭时是否忽略

function WndLockManager:init()
end

function WndLockManager:setWndLockType(wndLockType)
    self._wndLockType = wndLockType
end

function WndLockManager:getWndLockType()
    return self._wndLockType
end

function WndLockManager:setSubWndClass(subWndClass)
    if not self._subWndClass then
        self._subWndClass = {}
    end
    table.insert(self._subWndClass,subWndClass)
end

function WndLockManager:getSubWndClass()
    return self._subWndClass or {}
end

function WndLockManager:setCloseIgnore(closeIgnore)
    self._closeIgnore = closeIgnore
end

function WndLockManager:getCloseIgnore()
    return self._closeIgnore or {}
end

-- close时候不关闭的窗口
function WndLockManager:closeIgnoreRoleInfo()
    if WndLockManager:getWndLockType() == lt.Constant.WndLockType.SkillTips then
        WndLockManager:setCloseIgnore({["UIWndRoleInfo"] = true})
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndLock", close = true})
    end
end

function WndLockManager:clear()
    self._wndLockType = nil
    self._subWndClass = nil
    self._closeIgnore = nil
end

