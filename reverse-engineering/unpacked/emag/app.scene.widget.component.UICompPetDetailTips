----@class UICompPetDetailTips 宠物tips
local UICompPetDetailTips = class("UICompPetDetailTips", lt.UIGButtonBase)
local Constant = lt.Constant
local NtfManager = lt.NtfManager
local PetModule = lt.PetModule
local CommonFunc = lt.CommonFunc
local CacheManager = lt.CacheManager

function UICompPetDetailTips:ctor()
    --UI
    self._touchLayer = nil
    self._closeBtn = nil
    self._bgImg = nil
    self._nameLabel = nil
    self._levelLabel = nil
    self._itemLoader = nil
    self._petLoader = nil
    self._propertyLabel1 = nil
    self._propertyLabel2 = nil
    self._propertyLabel3 = nil
    self._composeLabel = nil
    self._digLabel = nil
    self._capsuleLabel = nil
    self._lastExpLabel = nil
    self._lastDayLabel = nil
    self._barImg1 = nil
    self._lastTimeLabel = nil
    self._barImg2 = nil
    UICompPetDetailTips.super.ctor(self)
end

function UICompPetDetailTips:onClear()
    --UI
    self._touchLayer = nil
    self._closeBtn = nil
    self._bgImg = nil
    self._nameLabel = nil
    self._levelLabel = nil
    self._itemLoader = nil
    self._petLoader = nil
    self._propertyLabel1 = nil
    self._propertyLabel2 = nil
    self._propertyLabel3 = nil
    self._composeLabel = nil
    self._digLabel = nil
    self._capsuleLabel = nil
    self._lastExpLabel = nil
    self._lastDayLabel = nil
    self._barImg1 = nil
    self._lastTimeLabel = nil
    self._barImg2 = nil
    UICompPetDetailTips.super.onClear(self)
end

function UICompPetDetailTips:onConstruct()
    self._touchLayer = self:getChild("touchLayer")
    self._touchLayer:addEventListener(fgui.UIEventType.TouchBegin, handler(self, self.onLayerClick))
    self._closeBtn = self:getChild("btn_close")
    self._closeBtn:addClickListener(handler(self, self.onLayerClick))
    self._bgImg = self:getChild("img_bg")

    --基本信息
    self._nameLabel = self:getChild("label_name")
    self._levelLabel = self:getChild("label_level")
    self._itemLoader = self:getChild("loader_item")
    self._petLoader = self:getChild("loader_pet")

    --属性
    self._propertyLabel1 = self:getChild("label_propertyt1")
    self._propertyLabel2 = self:getChild("label_propertyt2")
    self._propertyLabel3 = self:getChild("label_propertyt3")
    self._composeLabel = self:getChild("label_compose")
    self._digLabel = self:getChild("label_dig")
    self._capsuleLabel = self:getChild("label_capsule")
    self._capsuleLabelRace = self:getChild("label_capsule_race")

    --喂养
    self._lastExpLabel = self:getChild("label_lastexp")
    self._lastDayLabel = self:getChild("label_lastday")
    self._barImg1 = self:getChild("img_bar1")
    self._lastTimeLabel = self:getChild("label_lasttime")
    self._barImg2 = self:getChild("img_bar2")
end

function UICompPetDetailTips:onEnter()
    UICompPetDetailTips.super.onEnter(self)

    self._touchLayer:addEventListener(fgui.UIEventType.TouchBegin, handler(self, self.onLayerClick))
    self._closeBtn:addClickListener(handler(self, self.onLayerClick))
end

function UICompPetDetailTips:onExit()
    UICompPetDetailTips.super.onExit(self)

    self._touchLayer:removeEventListener(fgui.UIEventType.TouchBegin)
    self._closeBtn:removeClickListener()
end

function UICompPetDetailTips:onLayerClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_PET_DETAIL_TIPS)
end

function UICompPetDetailTips:refreshTips(petData)
    local id = petData.id
    local petMeta = CacheManager:getPetMeta(id)
    self._bgImg:setURL(string.format(_GURL.GetImagePet, petMeta:getDi()))

    --基本信息
    self._nameLabel:setText(petMeta:getPetName())
    self._levelLabel:setText(PetModule:getPetLevel(petData.exp))
    local itemId = PetModule:getPetCaptureItem(id)
    self._itemLoader:setURL(string.format(_GURL.GetImageItem, itemId))
    local photos = string.split(petMeta:getPhoto(), ",")
    local stage = PetModule:getPetStateByExp(petData.exp)
    if #photos == 1 then stage = 1 end
    local photo = photos[stage]
    self._petLoader:setURL(string.format(_GURL.GetImagePet, "petface_"..photo))

    local petUIData = lt.PetUIData.new(petData)
    local attr1    = petUIData:getAttr1()
    local attr2    = petUIData:getAttr2()
    local attr3    = petUIData:getAttr3()
    --属性
    self._propertyLabel1:setText(attr1 == 0 and GReadText.KEY_PET_TIPS3.."[color=#ff0000]"..GReadText.KEY_PET_TIPS2.."[/color]" or GReadText.KEY_PET_TIPS3.."[color=#ffff00]".. petUIData:getAttr1Str() .."[/color]")
    local attrStr = ""
    local showNext = false
    if attr2 ~= 0 then
        attrStr = petUIData:getAttr2Str()
        showNext = true
    elseif attr3 ~= 0 then
        attrStr = petUIData:getAttr3Str()
    end
    self._propertyLabel2:setText(attrStr == "" and GReadText.KEY_PET_TIPS3.."[color=#ff0000]"..GReadText.KEY_PET_TIPS2.."[/color]" or GReadText.KEY_PET_TIPS3.."[color=#ffff00]".. attrStr .."[/color]")
    
    if showNext then
        self._propertyLabel3:setText(attr3 == 0 and "1" or petUIData:getAttr3Str())
        self._propertyLabel3:setVisible(attr3 ~= 0)
        -- self._propertyLabel3:setY(attr3 ~= 0 and 252 or 230)
    else
        self._propertyLabel3:setText("1")
        self._propertyLabel3:setVisible(false)
        -- self._propertyLabel3:setY(230)
    end

    -- 组合
    -- self._composeLabel:setText(GReadText.KEY_PET_TIPS4.."[color=#ffff00]"..GReadText.KEY_PET_TIPS31.."[/color]")
    local compose    = petUIData:getCompose()
    local composeStr = ""
    if compose ~= "" then
        composeStr = GReadText.KEY_PET_TIPS4.."[color=#00ff00]"..petUIData:getComposeStr().."[/color]"
    else
        composeStr = GReadText.KEY_PET_TIPS4.."[color=#ff0000]"..GReadText.KEY_PET_TIPS69.."[/color]"
    end
    self._composeLabel:setText(composeStr)

    -- self._capsuleLabel:setText(petData.capsule ~= 0 and string.format(GReadText.KEY_PET_TIPS9, "电击") or GReadText.KEY_PET_TIPS8)
    -- self._capsuleLabel:setColor(petData.capsule ~= 0 and Constant.COLOR_BLUE or Constant.COLOR_TEXT_RED)

    -- 胶囊技能显示
    local capsule = petData.capsule
    local capsuleCfg = CacheManager:getPetCapsuleById(capsule)
    local capsuleName = GReadText.KEY_PET_TIPS87
    local capsuleSkillStr = nil
    if capsuleCfg then
        capsuleSkillStr = capsuleName .. ": [color=#ffffff]" .. capsuleCfg:getDesc() .."[/color]"
    else
        capsuleSkillStr = capsuleName .. ": [color=#ff0000]" .. GReadText.KEY_PET_TIPS43 .."[/color]"
    end
    self._capsuleLabel:setText(capsuleSkillStr)
    
    -- 种族技能显示
    local capsuleRace = petData.capsuleRace
    local capsuleRaceCfg = CacheManager:getPetCapsuleById(capsuleRace)
    local raceName = GReadText.KEY_PET_TIPS88
    local raceSkillStr = nil
    if capsuleRaceCfg then
        raceSkillStr = raceName .. ": [color=#ffffff]" .. capsuleRaceCfg:getDesc() .."[/color]"
    else
        raceSkillStr = raceName .. ": [color=#ff0000]" .. GReadText.KEY_PET_TIPS43 .."[/color]"
    end
    self._capsuleLabelRace:setText(raceSkillStr)

    self._digLabel:setText(petData.dig and GReadText.KEY_PET_TIPS6 or GReadText.KEY_PET_TIPS7)
    self._digLabel:setColor(petData.dig and Constant.COLOR_GREEN or Constant.COLOR_TEXT_RED)

    --喂养
    local lastExp = PetModule:getPetLastExp(petData.exp)
    self._lastExpLabel:setText(lastExp <= petData.exp and GReadText.KEY_PET_TIPS15 or CommonFunc:changeNumberShow(lastExp - petData.exp))
    self._lastExpLabel:setColor(lastExp <= petData.exp and Constant.COLOR_TEXT_RED or Constant.COLOR_TEXT_WHITE_PURE)
    local lastDay, lastTime = PetModule:getSurviveTime(petData.deadTime)
    self._lastDayLabel:setText(lastDay..GReadText.KEY_TIME_DAY)
    self._barImg1:setFillAmount(lastDay/Constant.PET_MAX_SURVIVE)
    local lastsTime = CommonFunc:secondsToTime4(lastTime)
    self._lastTimeLabel:setText(lastsTime)
    self._barImg2:setFillAmount(lastTime/Constant.WHOLE_DAY)
    self._barImg1:setURL(string.format(_GURL.GetImagePet, "up_"..petMeta:getJindu()))
    self._barImg2:setURL(string.format(_GURL.GetImagePet, "down_"..petMeta:getJindu()))
end

return UICompPetDetailTips