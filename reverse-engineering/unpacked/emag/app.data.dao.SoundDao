local SoundDao = {}

function SoundDao:queryAll()
    local tb = {}
    local db = lt.DbManager:getDb()
     
    for row in db:nrows("SELECT * FROM Sound") do
    	local meta = lt.SoundMeta.new(row)
        if not tb[meta:getSoundID()] then
            tb[meta:getSoundID()] = meta
        end
    end

    return tb
end

return SoundDao