local numberWH = 20

function UIWndWareHouse:ctor(param)
    UIWndWareHouse.super.ctor(self, param)
    self._curSelectWH = nil
    self._control = nil
    self._btnList = nil  -- 5个仓库按钮
    self._itemList = nil -- 仓库物品列表
    self._isFirst = nil
end

function UIWndWareHouse:onClear()
    if self._btnList then
        for i = 1, #self._btnList do
            self._btnList[i]:removeClickListener()
        end

        self._btnList = nil
    end

    if self._touch then
        self._touch:removeClickListener()
        self._touch = nil
    end

    if self._btnQuick then
        self._btnQuick:removeClickListener()
        self._btnQuick = nil
    end
    self._btnQuickSelect = nil

    if self._btnMoney then
        self._btnMoney:removeClickListener()
        self._btnMoney = nil
    end

    if self._closeBtn then
        self._closeBtn:removeClickListener()
        self._closeBtn = nil
    end

    if self._itemList then
        for i = 1, #self._itemList do
            self._itemList[i].item:removeClickListener()
        end

        self._itemList = nil
    end

    self._curSelectWH = nil
    self._control = nil
    self._isFirst = nil

    self:unregisterAllComponent()

    UIWndWareHouse.super.onClear(self)
end

function UIWndWareHouse:onEnter()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_DEPOT_EVENT, handler(self, self.refreshWareHouse), "UIWndWareHouse:refreshWareHouse")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_WEARHOUSE_DEPOSIT, handler(self, self.refreshWareHouseDeposit), "UIWndWareHouse:refreshWareHouseDeposit")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_WEARHOUSE_REFRESH_BY_POS, handler(self, self.refreshWareHouseByPos), "UIWndWareHouse:refreshWareHouseByPos")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_HERO_EVENT, handler(self, self.refreshWareHouseInfo), "UIWndWareHouse:refreshWareHouseInfo")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CANCEL_SELECT_STATE_ITEM, handler(self, self.cancelSelectItem), "UIWndWareHouse:cancelSelectItem")
    -- local depotArray = ItemModule:getDepotArray()
    -- for k,v in pairs(depotArray) do
    --     local depotPos = v:getPos()
    --     print("-------------------------------------------------------------")
    --     print("pos------------------->" .. depotPos)
    -- end

    -- 防止重复刷新
    if not self._isFirst then
        self._isFirst = true
        return
    end
    self:refreshPanel(self._curSelectWH)
    self:refreshBtnQuick()
    self:refreshWHBtnList()
    self:refreshMoney()
end


function UIWndWareHouse:onExit()
    WndLockManager:clearWarehouseQuick()
    NtfManager:removeNtfListenerByTag("UIWndWareHouse:refreshWareHouse")
    NtfManager:removeNtfListenerByTag("UIWndWareHouse:refreshWareHouseDeposit")
    NtfManager:removeNtfListenerByTag("UIWndWareHouse:refreshWareHouseByPos")
    NtfManager:removeNtfListenerByTag("UIWndWareHouse:refreshWareHouseInfo")
    NtfManager:removeNtfListenerByTag("UIWndWareHouse:cancelSelectItem")
    UIWndWareHouse.super.onExit(self)
end

function UIWndWareHouse:onInit()
    self:registerComponent("UICompItem")
    UIWndWareHouse.super.onInit(self, "ui://WareHouse/WareHouse")
    self:initUI()
    -- 只需初始化一次
    self:initCloseBtn()
end

function UIWndWareHouse:onShown()
    self:refreshMoney()
end

function UIWndWareHouse:refreshWareHouseInfo()
    self:refreshMoney()
    self:refreshWHBtnList()
end

function UIWndWareHouse:initTouchOperate()
    self._touch = self:getChild("touch")
    self._touch:setVisible(false)

    local function onTouchOperate(target)
        self:cancelOperate(true)
    end

    self._touch:addClickListener(handler(self, onTouchOperate))
end

function UIWndWareHouse:cancelOperate(showTips)
    self._touch:setVisible(false)
    self:refreshPanel(self._curSelectWH)
    if showTips then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = wareHouseTips.StringTips3})
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_SELECT_STATE_ITEM)
end


function UIWndWareHouse:initUI()
    self._curSelectWH = 1
    self._control = self:getController("c1")
    self._control:setSelectedIndex(self._curSelectWH-1)

    -- 5个仓库按钮
    self._btnList = {}
    for i= 1, 5 do
        local btn = self:getChild("btn" .. i)
        btn.index = i
        btn:addClickListener(handler(self, self.onBtnClick))
        self._btnList[i] = btn
        self._btnList[i]:getChild("name"):setText(wareHouseTips.StringTips1 .. i)
        self._btnList[i]:getChild("nameSelect"):setText(wareHouseTips.StringTips1 .. i)
    end

    -- 初始化操作
    self:initTouchOperate()

    -- 仓库物品列表
    self._itemList = {}
    local numbers = {}
    self._listView = self:getChild("listview")
    local itemParent = self._listView:getChildAt(0)
    for i = 1, numberWH do
        table.insert(numbers, i)
    end
    for i = 1, #numbers, 4 do
        local row = {}
        for j = i, math.min(i + 3, #numbers) do
            table.insert(row, numbers[j])
        end

        for j, num in ipairs(row) do
            local row = j
            local col = math.floor((i - 1) / 4) + 1

            local itemPanel = fgui.UIPackage:createObject("WareHouse", "ItemWH")
            itemPanel:getChild("selectFrame"):setVisible(false)
            local size = itemPanel:getSize()
            itemPanel.index = num
            itemPanel:setPivot(0.5, 0.5)
            itemPanel:setPosition((row-1)*(size.width)+6, (col-1)*(size.height+8.5)+5)
            local itemPanelSize = itemPanel:getSize()

            -- 图标缩放
            local item = fgui.UIPackage:createObject("Item", "Item");
            item:insertObjectToFactory(self)
            item:setPivot(0.5, 1, true)
            -- local itemSize = item:getSize()
            -- local heightS = itemSize.height/itemPanelSize.height
            -- local widthS = itemSize.width/itemPanelSize.width
            -- local scale = heightS
            -- if widthS < heightS then
            --     scale = widthS
            -- end
            -- item:setScale(scale,scale)
            item:setPosition(itemPanelSize.width/2, itemPanelSize.height)
            item:setTouchable(false)
            -- item:setItemInfo(setItemInfo, self.openViewType)
            -- item:setSortingOrder(10)
            itemPanel.item = item
            itemPanel:addChild(item)

            itemParent:addChild(itemPanel)
            self._itemList[num] = itemPanel

            local function btnClik()
                local depositData = itemPanel.depositData
                -- 可存入的操作
                if depositData and depositData.isDeposit and depositData.itemInfo then
                    local depositItemInfo = depositData.itemInfo:getItemMeta()
                    local addLimit = depositItemInfo:getAddLimit()
                    local depositDataNum = depositData.itemInfo:getNum()
                    local curPos = (self._curSelectWH-1)*numberWH+itemPanel.index - 1
                    local maxNum = depositDataNum
                    if itemPanel.itemInfo then -- 仓库已有物品堆叠逻辑
                        local needNum = addLimit - itemPanel.itemInfo:getNum()
                        maxNum = math.min(depositDataNum,needNum)
                    end

                    if depositDataNum > 1 then
                        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MESSAGEBOX_NUM, 
                        {
                            content = GReadText.KEY_WAREHOUSE_DEPOSIT_NUM1,
                            confirmCallback = function(curNum)
                                ItemModule:sendToDepot(depositData.itemInfo:getObjId(),curPos or 0,curNum)
                                self:cancelOperate()
                            end,
                            param = {
                                maxNum = maxNum, -- 物品数量和需求数取最小值
                            }
                        })
                    else
                        ItemModule:sendToDepot(depositData.itemInfo:getObjId(),curPos or 0,1)
                        self:cancelOperate()
                    end
                else
                    local target = itemPanel
                    if WndLockManager:getWarehouseQuick() then
                        if target.itemInfo then -- 取出物品快捷操作
                            ItemModule:sendFromDepotOut(target.itemInfo:getObjId(),target.itemInfo:getPos(),target.itemInfo:getNum())
                        end
                    else
                        -- 取消存入操作
                        if self._touch:isVisible() then
                            self:cancelOperate(true)
                            return
                        end
                        self:showTips(target.itemInfo)
                        target.item:loadShader(true)
                        self._preNode = target.item
                    end
                end
            end
            itemPanel:addClickListener(handler(self, btnClik))
        end
    end

    -- 快捷按钮
    self._btnQuick = self:getChild("btnQuick")
    self._btnQuickSelect = self._btnQuick:getChild("select")
    local function btnQuickClik()
        local warehouseQuick = WndLockManager:getWarehouseQuick()
        if warehouseQuick then
            WndLockManager:clearWarehouseQuick()
        elseif not warehouseQuick then
            WndLockManager:setWarehouseQuick(true)
        end
        self:refreshBtnQuick()
    end
    self._btnQuick:addClickListener(handler(self, btnQuickClik))

    -- 取钱按钮
    self._btnMoney = self:getChild("btnMoney")
    local function btnMoneyClik()
        local heroData = GameModule:getHeroData()
        local jinBi = heroData:getJinBiInStorage()
        if jinBi <= 0 then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_INVENTORY_TIPS19})
            return
        end
        local storeMaxCoin = lt.CacheManager:getValueById(Constant.Variable.BagMaxCoin)
        yflog:Info("storeMaxCoin--->>>>%s,%s",type(storeMaxCoin),storeMaxCoin)
        local maxNum = math.min(jinBi, storeMaxCoin - heroData:getJinBi())
        local minNum = jinBi > 0 and 1 or 0
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MESSAGEBOX_NUM, 
        {
            content = wareHouseTips.StringTips5,
            confirmCallback = function(curNum)
                ItemModule:sendFromDepotOut(0,0,curNum or 0)
                -- print("------------------->>>>>btnMoneyClik" .. curNum)
            end,
            param = {
                maxNum = maxNum,
                minNum = minNum,
            }
        })
    end
    self._btnMoney:addClickListener(handler(self, btnMoneyClik))

    -- 第一次刷新
    self:refreshPanel(self._curSelectWH)
    self:refreshBtnQuick()
    self:refreshWHBtnList()
end

function UIWndWareHouse:initCloseBtn()
    self._closeBtn = self:getChild("frame"):getChild("closeButton")
    self._closeBtn:addClickListener(function()
        if WndLockManager:getWndLockType() == Constant.WndLockType.WareHouse then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndLock", close = true})
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndWareHouse", close = true})
        end
    end)
end

function UIWndWareHouse:refreshWHBtnList()
    local heroData = GameModule:getHeroData()
    for i= 1, 5 do
        local getMaxDepotPos = heroData:getMaxDepot()
        local btn = self:getChild("btn" .. i)
        local lock = btn:getChild("lock")
        lock:setVisible(not (getMaxDepotPos/numberWH >= i))
    end
end

function UIWndWareHouse:refreshBtnQuick()
    local select = self._btnQuickSelect
    if WndLockManager:getWarehouseQuick() then
        self._btnQuick:setTitle(GReadText.KEY_WAREHOUSE_TIPS10)
        select:setVisible(true)
    else
        self._btnQuick:setTitle(GReadText.KEY_WAREHOUSE_TIPS11)
        select:setVisible(false)
    end
end

function UIWndWareHouse:onItemClick(target)
    local btn = target:getSender()
    yflog:Info("ItemClick index " .. (self._curSelectWH-1)*numberWH+btn.index)
end

function UIWndWareHouse:onBtnClick(target)
    local costNum = lt.CacheManager:getValueById(Constant.Variable.StorePrice)
    yflog:Info("costNum--->>>>%s,%s",type(costNum),costNum)
    local btn = target:getSender()
    local lock = btn:getChild("lock")
    if lock:isVisible() then
        self._control:setSelectedIndex(self._curSelectWH-1)
        local heroData = GameModule:getHeroData()
        local getMaxDepotPos = heroData:getMaxDepot()
        local buyIndx = math.floor(getMaxDepotPos/numberWH) + 1
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
            content = string.format(wareHouseTips.StringTips4 .. buyIndx .. "?", costNum),
            confirmCallback = function()
                lt.NpcModule:sendBuyStorge(0)
            end,
            closeLimitFunc = function()
                local heroData = GameModule:getHeroData()
                local jinBi = heroData:getJinBi()
                if jinBi < costNum then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = string.format(wareHouseTips.StringTips6, costNum)})
                    return true
                end
            end,
        })
        return
    end
    self:refreshPanel(btn.index)
end

-- 仓库页面刷新逻辑
function UIWndWareHouse:refreshPanel(index, depositData)
    local depositData = depositData
    local curSelect = index
    local pos = nil
    if depositData and depositData.isDeposit then
        local itemInfo = depositData.itemInfo
        -- 检查当前物品是否可堆叠
        local stackItemPos = nil
        if itemInfo then
            local targetItemMeta = itemInfo:getItemMeta()
            local targetItemNum = itemInfo:getNum()
            local addLimit = targetItemMeta:getAddLimit()
            local stackable = false
            if addLimit > 1 then -- 可堆叠
                stackable = true
            end
    
            if stackable then -- 可堆叠数-当前数量 = 需求最大数量
                local depot = lt.ItemModule:getSortDepotArray() -- 仓库数据
                for _,v in pairs(depot) do
                    local itemMeta = v:getItemMeta()
                    if targetItemMeta:getItemId() == itemMeta:getItemId() then
                        local itemNum = v:getNum()
                        local needNum = addLimit - itemNum
                        if needNum > 0 and targetItemNum > 0 then
                            stackItemPos = v:getPos() or 0
                            break
                        end
                    end
                end
            end
        end

        -- 空位刷新逻辑
        local emptyPos = ItemModule:getDepotEmptyPos(self._curSelectWH)
        if stackItemPos then
            emptyPos = stackItemPos
        end
        if emptyPos then
            pos = emptyPos
            local group = math.floor(emptyPos / 20) + 1
            if group ~= self._curSelectWH then
                self._control:setSelectedIndex(group-1)
                curSelect = group
            end
            self._touch:setVisible(true)
            local visibleSize = cc.Director:getInstance():getVisibleSize()
            local width, height = visibleSize.width, visibleSize.height
            self._touch:setSize(width*4,height*4)
            self._touch:setPosition(0,0)
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = wareHouseTips.StringTips2})
            self._touch:setVisible(false)
        end
    elseif depositData and depositData.pos then
        pos = depositData.pos
        local group = math.floor(depositData.pos / 20) + 1
        if group ~= self._curSelectWH then
            self._control:setSelectedIndex(group-1)
            curSelect = group
        end
    end

    if pos then
        local scrollPane = self._listView:getScrollPane()
        scrollPane:setPercY(pos%20 < 12 and 0 or 1, true)
    end
    
    -- 当前仓库位
    for k,v in pairs(self._btnList) do
        if v.index == curSelect then
            v:getChild("name"):setVisible(true)
            v:getChild("nameSelect"):setVisible(false)
        else
            v:getChild("name"):setVisible(false)
            v:getChild("nameSelect"):setVisible(true)
        end
    end
    self._curSelectWH = curSelect

    -- 20个位置
    -- print("curClick" .. curSelect)
    for i = 1, numberWH do
        local itemData = self:GetDepotByPos((self._curSelectWH-1)*numberWH+i-1)
        local item = self._itemList[i].item
        if itemData then
            item:setVisible(true)
            item:setItemInfo(itemData, self.openViewType)
            item:setRed(not itemData:isWearable())
            item:loadShader(false)
            
            --图标缩放
            local scale = 1
            if itemData:getItemType() == Constant.ItemType.ITEM_TYPE_EQUIP then
                scale = lt.CacheManager:getVariableById(Constant.Variable.EquipIconScale)
            elseif itemData:getItemType() == Constant.ItemType.ITEM_TYPE_PROP then
                scale = lt.CacheManager:getVariableById(Constant.Variable.ItemIconScale)
            end
            if not scale or scale == 0 then 
                scale = 1 
            end
            item:setSpritePos(0, -(item:getSize().height-item:getSpriteSize().height*scale)/2+10)
            item:setScale(0.62, 0.62)

            -- item:getChild("btn"):setVisible(false)
            self._itemList[i].itemInfo = itemData
            self._itemList[i]:getChild("selectFrame"):setVisible(false)
            self._itemList[i].depositData = nil

            local depositItem = (depositData or {}).itemInfo
            if depositItem then
                -- yflog:Info("------------------------------start--------------------------------")
                -- yflog:Info("ObjId" .. itemData:getObjId() .. "--->" .. depositItem:getObjId())
                local itemMeta = itemData:getItemMeta()
                local depositItemInfo = depositItem:getItemMeta()
                -- yflog:Info("ItemId" .. itemMeta:getItemId() .. "--->" .. depositItemInfo:getItemId())
                -- yflog:Info("ItemNum" .. itemData:getNum() .. "--->" .. depositItem:getNum())
                -- yflog:Info("------------------------------end--------------------------------")
                local addLimit = depositItemInfo:getAddLimit()
                -- yflog:Info("addLimit%s" , addLimit)
                if itemMeta:getItemId() == depositItemInfo:getItemId() and itemData:getNum() < addLimit then
                    self._itemList[i]:getChild("selectFrame"):setVisible(true)
                    self._itemList[i].depositData = depositData
                end
            end
        else
            self._itemList[i].itemInfo = nil
            item:setVisible(false)
            self._itemList[i]:getChild("selectFrame"):setVisible((depositData or {}).isDeposit or false)
            self._itemList[i].depositData = depositData
        end
    end
end

function UIWndWareHouse:refreshWareHouse()
    self:refreshPanel(self._curSelectWH)
end

function UIWndWareHouse:refreshWareHouseDeposit(target)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_WAREHOUSE_TIPS12})
    local param = target.param
    if param and param.itemInfo then
        self:refreshPanel(self._curSelectWH, {isDeposit = true, itemInfo = param.itemInfo})
        self:show()
    end
end

-- 快捷存入刷新
function UIWndWareHouse:refreshWareHouseByPos(target)
    local param = target.param or {}
    local itemInfo = param.itemInfo
    -- if param and param.pos then
    --     self:refreshPanel(self._curSelectWH, {pos = param.pos})
    -- end
    -- 检查当前物品是否可堆叠
    if itemInfo then
        local targetItemMeta = itemInfo:getItemMeta()
        local targetItemNum = itemInfo:getNum()
        local addLimit = targetItemMeta:getAddLimit()
        local stackable = false
        if addLimit > 1 then -- 可堆叠
            stackable = true
        end

        if stackable then -- 可堆叠数-当前数量 = 需求最大数量
            local depot = lt.ItemModule:getSortDepotArray() -- 仓库数据
            for _,v in pairs(depot) do
                local itemMeta = v:getItemMeta()
                if targetItemMeta:getItemId() == itemMeta:getItemId() then
                    local itemNum = v:getNum()
                    local needNum = addLimit - itemNum
                    if needNum > 0 and targetItemNum > 0 then
                        local pos = v:getPos() or 0
                        ItemModule:sendToDepot(itemInfo:getObjId(),pos,math.min(needNum,targetItemNum))
                        self:refreshPanel(self._curSelectWH, {pos = pos})
                        return
                    end
                end
            end
        end
    end

    -- 不可堆叠逻辑
    local emptyPos = ItemModule:getDepotEmptyPos(self._curSelectWH)
    if not emptyPos then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = wareHouseTips.StringTips2})
        return
    end
    if param.itemInfo then
        ItemModule:sendToDepot(param.itemInfo:getObjId(),emptyPos or 0,param.itemInfo:getNum())
        self:refreshPanel(self._curSelectWH, {pos = emptyPos})
    end
end

function UIWndWareHouse:GetDepotByPos(pos)
    local depotArray = ItemModule:getDepotArray()
    for k,v in pairs(depotArray) do
        local depotPos = v:getPos()
        if pos == depotPos then
            return v
        end
    end
end

function UIWndWareHouse:showTips(itemInfo)
    if not itemInfo then
        return
    end
    local itemType = itemInfo:getItemType()
    if itemType ==  Constant.ItemType.ITEM_TYPE_PROP then
        self:showPropTips(itemInfo)
    elseif itemType ==  Constant.ItemType.ITEM_TYPE_EQUIP then
        self:showEquipTips(itemInfo)
    end
end

function UIWndWareHouse:showPropTips(itemInfo)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemInfo, tipsType = Constant.PROPTIPS_FORM.WAREHOUSE})
end

function UIWndWareHouse:showEquipTips(itemInfo)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo,tipsType = Constant.EquipShowTipsType.WareHouse})
end

function UIWndWareHouse:refreshMoney()
    local heroData = GameModule:getHeroData()
    local jinBi = heroData:getJinBiInStorage()
    self:getChild("textMoney"):setText(jinBi)

    self._btnMoney:getChild("bgdis"):setVisible(jinBi == 0)
    self._btnMoney:getChild("icondis"):setVisible(jinBi == 0)
    self._btnMoney:setGrayed(jinBi == 0)
end

function UIWndWareHouse:cancelSelectItem()
    if self._preNode then
        self._preNode:loadShader(false)
        self._preNode = nil 
    end
end

return UIWndWareHouse