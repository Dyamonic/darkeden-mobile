---@class UIWndTransactionBidTips:UIWindowBase
---交易行 竞价 tips
local UIWndTransactionBidTips = class("UIWndTransactionBidTips", lt.UIWindowBase)

local Constant                = lt.Constant
local CacheManager            = lt.CacheManager
local NtfManager              = lt.NtfManager
local TransactionModule       = lt.TransactionModule
local ItemModule              = lt.ItemModule
local TimeCounter             = lt.TimeCounter
local CommonFunc              = lt.CommonFunc
local GameModule              = lt.GameModule
local RechargeModule          = lt.RechargeModule


UIWndTransactionBidTips.ChangeSkinConf = {
    ["Transaction"] = {
        ["n1"] = "bg_pmh_cztc",
        ["btn_sub"] = { icon = "btn_pmh_jianhao" },
        ["btn_add"] = { icon = "btn_pmh_jiahao" },
    },
    ["CommonTL"] = {
        ["frame"] = {
            closeButton = { bg = "bg_beibao_anniu01", bgup = "bg_beibao_anniu02" },
        },
        ["btn_up"] = { bg = "bg_youjian_changanniu01", disabled = "bg_youjian_changanniu02" },
    }
}

function UIWndTransactionBidTips:ctor(param)
    UIWndTransactionBidTips.super.ctor(self, param)
end

function UIWndTransactionBidTips:onClear()
    self._lblTime    = nil
    self._lblCost    = nil
    self._iconItem   = nil
    self._rareImg    = nil
    self._lblName    = nil
    self._btnBid     = nil
    self._btnSub     = nil
    self._btnAdd     = nil
    if self._numInput then
        self._numInput:removeEditHandler()
        self._numInput:removeSelf()
        self._numInput = nil
    end
    self._meta   = nil
    self._data   = nil
    self._sprite = nil

    UIWndTransactionBidTips.super.onClear(self)
end

function UIWndTransactionBidTips:onHide()
    self._btnSub:removeClickListener()
    self._btnBid:removeClickListener()
    self._btnAdd:removeClickListener()
    self._iconItem:removeClickListener()
    UIWndTransactionBidTips.super.onHide(self)
end

function UIWndTransactionBidTips:onShown()
    self._btnBid:addClickListener(handler(self, self.openBidBtnClick))
    self._btnSub:addClickListener(handler(self, self.openSubBtnClick))
    self._btnAdd:addClickListener(handler(self, self.openAddBtnClick))
    self._iconItem:addClickListener(handler(self, self.onShowTipClick))
    self:refreshView()
end

function UIWndTransactionBidTips:onInit()
    UIWndTransactionBidTips.super.onInit(self, _GURL.WndTransactionBidTips)
    self._lblTime    = self:getChild("lbl_time")
    self._lblCost    = self:getChild("lbl_cost")
    self._iconItem   = self:getChild("icon_item")
    self._rareImg    = self:getChild("img_rare")
    self._lblName    = self:getChild("lbl_itemName")
    self._btnBid     = self:getChild("btn_up")
    self._btnSub     = self:getChild("btn_sub")
    self._btnAdd     = self:getChild("btn_add")
    self:initCocosInputUI()
end

function UIWndTransactionBidTips:refreshView()
    local param = self:getParam() or {}
    local data = param.data
    local cofingId = data.cofingId

    local itemMeta = nil
    local sid = nil
    local itemType = nil
    local itemInfo = nil

    if self._sprite then
        self._sprite:removeFromParent()
        self._sprite = nil
    end

    if cofingId then
        local meta = CacheManager:getTransactionsById(cofingId)
        sid = meta:getItemId()
        itemType = meta:getType()
        if itemType == Constant.ItemType.ITEM_TYPE_PROP then
            itemMeta = CacheManager:getItemMeta(sid)
            itemInfo = ItemModule:getItemDataByConfig(itemMeta, nil, nil)
            self._iconItem:setURL(string.format("ui://Item/prop_%s", itemMeta and itemMeta:getIconId() or ""))
            self._iconItem:setAlpha(1)
        else
            yflog:Info("---------------------UIWndTransactionBidTips--NOT--ITEM_TYPE_EQUIP-----")
        end
    else
        itemInfo = ItemModule:getItemDataByProperty(data.objProperty)
        itemMeta = itemInfo:getItemMeta()
        sid = itemInfo:getItemId()
        itemType = itemInfo:getItemType()
        self._iconItem:setURL(string.format("ui://Item/equip_%s", itemMeta and itemMeta:getIconId() or ""))
        self._iconItem:setAlpha(0)

        local iconId = itemMeta:getIconId()
        if iconId then
            local affixId = itemInfo:getFirstAffixId() or 0
            local affixLevel = itemInfo:getFirstAffixLevel() or 0
            local sprite = lt.CommonFunc.createEquipById(iconId, affixId, affixLevel)
            self:displayObject():addChild(sprite)
            local pos = self._iconItem:getPosition()
            sprite:setPosition(pos.x, self:getSize().height - pos.y)
            self._sprite = sprite
        end
    end
    self._iconItem.itemMeta = itemInfo

    local meta = TransactionModule:getTransactionDataByItemIdAndType(sid, itemType)

    self._meta = meta
    self._lblName:setText(itemMeta and itemMeta:getName() or "")

    --缩放尺寸
    local itemSize = self._iconItem:getSize()
    local heightS = 50 / itemSize.height
    local widthS = 50 / itemSize.width
    local scale = heightS
    if widthS < heightS then
        scale = widthS
    end
    self._iconItem:setScale(scale, scale)

    if self._sprite then
        self._sprite:setScale(scale)
    end

    --公示时间
    local announce = meta:getAnnounce()
    self._rareImg:setVisible(announce == 1)
    local serverTime = TimeCounter:serverTime()
    local lastSeconds = data.downTimeStamp - serverTime
    self._lblTime:setText(CommonFunc:secondsToTime4(lastSeconds))

    local playerId = GameModule:getHeroData():getPlayerId()
    local curBiddingPlayerId = data.curBiddingPlayerId
    self._btnBid:setGrayed(curBiddingPlayerId == tostring(playerId))
    --阈值
    local heroData = GameModule:getHeroData()
    local goldMax = heroData:getGold()
    self._price = data.curBiddingPrice
    self._lblCost:setText(self._price .. "[size=22]" .. GReadText.KEY_SHOPPING_TIPS1 .. "[/size]")
    local tradingUpper = CacheManager:getVariableById(Constant.Variable.TradingUpper) or TransactionModule.MAXSELLPRICE
    self._maxPrice = tonumber(tradingUpper)
    self._lowPrice = math.floor(1.1 * self._price)
    if self._lowPrice > self._maxPrice then
        self._lowPrice = self._maxPrice
    end
    self._costPrice = self._lowPrice
    if self._costPrice > self._maxPrice then
        self._costPrice = self._maxPrice
    end
    self._data = data
    self:refreshBidPrice()
end

function UIWndTransactionBidTips:initCocosInputUI()
    if not self._numInput then
        self._numInput = ccui.EditBox:create(cc.size(80, 29), "", ccui.TextureResType.localType)
        self._numInput:setAnchorPoint(cc.p(0, 0))
        self._numInput:setFontName(lt.Constant.FONT_4)
        self._numInput:setFontSize(20)
        self._numInput:setReturnType(cc.KEYBOARD_RETURNTYPE_SEND)
        self._numInput:setInputMode(cc.EDITBOX_INPUT_MODE_SINGLELINE)
        self._numInput:registerScriptEditBoxHandler(handler(self, self.editBoxEvent))
        self._numInput:setPosition(cc.p(64, 1))
        self:getChild("n12"):displayObject():addChild(self._numInput)
    end
end

--竞价
function UIWndTransactionBidTips:openBidBtnClick()
    local isMonthCard = RechargeModule:checkMonthCard(true)
    if not isMonthCard then
        return
    end
    local playerId = GameModule:getHeroData():getPlayerId()
    local curBiddingPlayerId = self._data.curBiddingPlayerId
    if tostring(playerId) == curBiddingPlayerId then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = "已经竞价过此物品" })
        return
    end

    local enoughMoney = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.TICKET,
        self._costPrice, { tips = true })
    if enoughMoney then
        local param = self:getParam() or {}
        local data = param.data
        TransactionModule:sendBiddingReq(data.itemUniqueId, self._costPrice)
        self:hideSelectView()
    end
end

function UIWndTransactionBidTips:openAddBtnClick()
    local defaultPrice = self._meta:getDefaultPrice()[3]
    self._costPrice = math.floor(self._costPrice + 0.1 * defaultPrice)
    if self._costPrice > self._maxPrice then
        self._costPrice = self._maxPrice
    end
    self:refreshBidPrice()
end

function UIWndTransactionBidTips:openSubBtnClick()
    local defaultPrice = self._meta:getDefaultPrice()[3]
    self._costPrice = math.floor(self._costPrice - 0.1 * defaultPrice)
    if self._costPrice < self._lowPrice then
        self._costPrice = self._lowPrice
        local str = string.format("不能低于%s", self._lowPrice)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = str })
    end
    self:refreshBidPrice()
end

function UIWndTransactionBidTips:editBoxEvent(eventType, sender)
    if eventType == "began" then
    elseif eventType == "ended" then
        --过滤无效字符
        self._costPrice = tonumber(sender:getText())
        if self._costPrice == nil then
            self._costPrice = self._lowPrice
        else
            --判断上下限
            if self._costPrice < self._lowPrice then
                self._costPrice = self._lowPrice
            elseif self._costPrice > self._maxPrice then
                self._costPrice = self._maxPrice
            end
        end
        sender:setText("")
        --刷新界面
        self:refreshBidPrice()
    elseif eventType == "changed" then
        local str = sender:getText()
        str = string.gsub(str, "[^0-9]", "")
        sender:setText(str)
    elseif eventType == "return" then
    end
end

function UIWndTransactionBidTips:hideSelectView()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndTransactionBidTips", close = true })
end

function UIWndTransactionBidTips:refreshBidPrice()
    self._numInput:setText(self._costPrice)
end

function UIWndTransactionBidTips:onShowTipClick(target)
    local itemMeta = target:getSender().itemMeta
    if itemMeta then
        ItemModule:showTipsByType(itemMeta)
    end
end

return UIWndTransactionBidTips
