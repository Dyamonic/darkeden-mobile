local ActionNpc = class("ActionNpc", lt.ActionBase)


function ActionNpc:ctor(modelName, modelId, actionId, direction, loop, isShadow, agentType)
    self._actionType = self.ACTION_TYPE.NPC

    ActionNpc.super.ctor(self, modelName, modelId, actionId, direction, loop, isShadow)
end

--NPC动态=3秒间隔时间，4秒播放时长。
function ActionNpc:getActionStep(actionId)
    return 0.08
end

function ActionNpc:loadActionData()
    local modelId = self._modelId
    -- 怪物目前用 creature.cfpk  后续需要写脚本拆分cfpk 每个id模型对应一个
    local name = "creature"
    if self._isShadow then
        name = "creatureshadow"
    end

    self._actionData = lt.ActionManager:getActionData(name, modelId)
    local dataFrameArr = self._actionData:getDirection(self._actionId, self._direction)
    if not dataFrameArr then
        yflog:Error("dataFrameArr is nil")
        return
    end

    self._dataFrameArray = dataFrameArr
    self._frameCount = #dataFrameArr
end

return ActionNpc