local MapObjectTexture = class("MapObjectTexture")

local NtfManager = lt.NtfManager
local Constant = lt.Constant

MapObjectTexture._waitSpriteFrameTable = nil
MapObjectTexture._loadSpriteQueue = nil

function MapObjectTexture:ctor(mapcode)
    self._tag = string.format("MapObjectTexture_%s", mapcode)
    yflog:Info("MapObjectTexture ctor self._tag = %s", self._tag)

    self._waitSpriteFrameTable = {}
    self._loadSpriteQueue = {}

    -- 默认1
    self._atlasSum = Constant.MAP_OBJ_ATLAS_COUNT[tonumber(mapcode)] or 1
    self._atlasCur = 0

    -- 加载图集
    self:loadAtlas(mapcode)
end

function MapObjectTexture:clear()
    self._waitSpriteFrameTable = nil
    self._loadSpriteQueue = {}
end

-- 加载图集
function MapObjectTexture:loadAtlas(mapcode)
    for i=1, self._atlasSum do
        local dataFilename = string.format("map/spk_plist/map_obj_%s_%d.plist", mapcode, i)
        local imageFilename = string.format("map/spk_plist/map_obj_%s_%d.pvr.ccz", mapcode, i)

        -- yflog:Info("MapObjectTexture loadAtlas dataFilename = %s", dataFilename)

        if lt.MapManager:loadAtlas(dataFilename, imageFilename) then
            -- 取缓存的图集
            self:loadAtlasStep()
        else
            self._waitSpriteFrameTable[dataFilename] = true
        end
    end

    -- 等待加载完成后的监听
    if next(self._waitSpriteFrameTable) ~= nil then
        NtfManager:addNtfListener(NtfManager.NTF.MAP_SPRITE_FRAME_LOADED, handler(self, self.spriteFrameLoadedNtf), self._tag)
    end
end

-- 图集加载完成通知
function MapObjectTexture:spriteFrameLoadedNtf(event)
    event = event or {}
    event.param = event.param or {}
    local dataFilename = event.param.dataFilename or ""

    if self._waitSpriteFrameTable and self._waitSpriteFrameTable[dataFilename] then
        self._waitSpriteFrameTable[dataFilename] = nil

        self:loadAtlasStep()

        if next(self._waitSpriteFrameTable) == nil and self._tag then
            NtfManager:removeNtfListenerByTag(self._tag)
            self._tag = nil
        end
    end
end

-- 图集全部加载完成
function MapObjectTexture:loadAtlasStep()
    self._atlasCur = self._atlasCur + 1
    if self._atlasCur == self._atlasSum then
        self._loadAtlasFinish = true
        self:loadSpriteFrame()
    end
end

function MapObjectTexture:loadImage(path, callback)
    if self._loadAtlasFinish then
        local spriteFrame = cc.SpriteFrameCache:getInstance():getSpriteFrame(path)
        if spriteFrame then
            spriteFrame:retain()
            callback(spriteFrame)
        else
            callback(nil)
        end
    else
        -- 将资源加入队列
        self._loadSpriteQueue[#self._loadSpriteQueue + 1] = {path = path, callback = callback}
    end
end

function MapObjectTexture:loadSpriteFrame()
    if not self._loadSpriteQueue or #self._loadSpriteQueue == 0 then
        return
    end

    -- yflog:Info("MapObjectTexture:loadSpriteFrame() #self._loadSpriteQueue:%s", #self._loadSpriteQueue)

    for _, frame in ipairs(self._loadSpriteQueue) do
        local path = frame.path
        local callback = frame.callback
        local spriteFrame = cc.SpriteFrameCache:getInstance():getSpriteFrame(path)
        if spriteFrame then
            spriteFrame:retain()
            callback(spriteFrame)
        else
            callback(nil)
        end
    end
end

return MapObjectTexture