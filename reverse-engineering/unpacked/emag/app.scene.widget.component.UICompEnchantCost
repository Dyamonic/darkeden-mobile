---@class UICompEnchantCost
---
local UICompEnchantCost = class("UICompEnchantCost", lt.UIGButtonBase, lt.UICompChangeSkin)

local Constant = lt.Constant
local CacheManager = lt.CacheManager
local ItemModule = lt.ItemModule

UICompEnchantCost.ChangeSkinConf = {
    ["Strengthen"] = {
        ["img_bg"] = "bg_zhuangbei_di",
    },
}

function UICompEnchantCost:ctor()
    UICompEnchantCost.super.ctor(self)
    --UI
    self._nameLabel = nil
    self._selectImg = nil
    self._item = nil
    --数据
    self._id = nil
end

function UICompEnchantCost:onClear()
    --UI
    self._nameLabel = nil
    self._selectImg = nil
    self._item = nil
    --数据
    self._id = nil
end

function UICompEnchantCost:onConstruct()
    self._nameLabel = self:getChild("label_name")
    self._selectImg = self:getChild("img_select")
    self._item = fgui.UIPackage:createObject("Item", "Item")
    self._item:setPosition(24, 10)
    self:addChild(self._item)
    self:startSkin()
end

function UICompEnchantCost:setInfo(cost)
    self._item:insertObjectToFactory(self:getRegClass())
    self._id = cost[2]
    local num = cost[3]
    local itemMeta = CacheManager:getItemMeta(self._id)
    self._nameLabel:setText(itemMeta:getName())
    self._item:setInfo(string.format(_GURL.GetImageItem, itemMeta:getIconId()))
    self._item:setItemNums("")
    self._item:setNeedNum(ItemModule:getItemNum(self._id), num)
    self._item:setIconScale(1.5, 1.5)
    self._selectImg:setVisible(false)
    self._nameLabel:setColor(Constant.COLOR_TEXT_WHITE_PURE)
end

function UICompEnchantCost:setSelect(select)
    self._selectImg:setVisible(select)
    self._nameLabel:setColor(select and Constant.COLOR_TEXT_GOLD_H or Constant.COLOR_TEXT_WHITE_PURE)
end

function UICompEnchantCost:getCostId()
    return self._id
end

return UICompEnchantCost