-- 总属性
---@class UICompAllAttrsTips
local UICompAllAttrsTips = class("UICompAllAttrsTips", lt.UICompBase)

local CacheManager       = lt.CacheManager

function UICompAllAttrsTips:ctor()
    UICompAllAttrsTips.super.ctor(self)
    self:makeFullScreen()
end

function UICompAllAttrsTips:onConstruct()
    self._attr = self:getChild("attr")
    self._list = self._attr:getChild("list")
    self._list:setItemRenderer(handler(self, self.renderItem))

    local visibleSize = cc.Director:getInstance():getVisibleSize()
    self:setSize(visibleSize.width, visibleSize.height)
end

function UICompAllAttrsTips:onEnter()
    UICompAllAttrsTips.super.onEnter(self)

    self:addClickListener(handler(self, self.onLayerClick))
end

function UICompAllAttrsTips:onExit()
    UICompAllAttrsTips.super.onExit(self)

    self:removeClickListener()
end

function UICompAllAttrsTips:onClear()
end

function UICompAllAttrsTips:refreshTips(param)
    self._attr:setPivot(1, 0, true)
    local pt = param.pt -- 位置
    if pt then
        self._attr:setPosition(math.floor(pt.x), math.floor(pt.y))
    end
    self._attrArrs = param.attrArrs or {}
    self._list:setNumItems(#self._attrArrs)
end

function UICompAllAttrsTips:renderItem(index, obj)
    local attr        = self._attrArrs[index + 1]
    local optionInfo  = CacheManager:getOptionInfoMeta(attr.propId)
    local attrName    = optionInfo:getName()
    local isPer       = optionInfo:getPercentage()
    local isPermyriad = optionInfo:getPermyriad()
    local propValue   = attr.propValue
    if isPermyriad == 1 then
        propValue = propValue / 100
    end

    local value = ""
    if isPer == 1 then
        value = attrName .. "：" .. propValue .. "%"
    else
        value = attrName .. "：" .. propValue
    end
    obj:getChild("title"):setText(value)
end

function UICompAllAttrsTips:onLayerClick()
    self:setVisible(false)
    self._skinAttrList = nil
end

return UICompAllAttrsTips
