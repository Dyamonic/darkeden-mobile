--- 广告牌
---@class UIWndCustomize:UIWindowBase
local UIWndCustomize = class("UIWndCustomize", lt.UIWindowBase)
local Constant = lt.Constant
local CommonUtil = lt.CommonUtil
local NtfManager = lt.NtfManager
local MaskWordUtil = lt.MaskWordUtil
local GameModule = lt.GameModule
local ChatModule = lt.ChatModule

function UIWndCustomize:ctor(param)
    UIWndCustomize.super.ctor(self, param)
end

function UIWndCustomize:onInit()
    UIWndCustomize.super.onInit(self, _GURL.GetCustomizePanel)
    self._compEdit = self:getChild("bg_edit")
    self._lbl_msg = self:getChild("txt_msg")
    self._btn = self:getChild("btn_send")
    self._lblName = self:getChild("txt_name")

    self:initCocosInputUI()
end

function UIWndCustomize:onShown()
    self._btn:addClickListener(handler(self, self.onBtnFncClick))

    local sendman = GameModule:getHeroData():getName()
    self._lblName:setText(sendman)
end

function UIWndCustomize:onHide()
    self._btn:removeClickListener()
    UIWndCustomize.super.onHide(self)
end

function UIWndCustomize:onClear()
    self._compEdit = nil
    self._lbl_msg  = nil
    self._lblName  = nil
    self._Input    = nil
    self._btn      = nil
    UIWndCustomize.super.onClear(self)
end

function UIWndCustomize:initCocosInputUI()
    if not self._Input then
        self._Input = ccui.EditBox:create(cc.size(378, 101), "", ccui.TextureResType.localType)
        self._Input:setAnchorPoint(cc.p(0, 0))
        -- self._Input:setPosition(65, 139)
        self._Input:setFontName(Constant.FONT_4)
        self._Input:setFontSize(24)
        self._Input:setReturnType(cc.KEYBOARD_RETURNTYPE_SEND)
        self._Input:setInputMode(cc.EDITBOX_INPUT_MODE_ANY)
        self._Input:registerScriptEditBoxHandler(handler(self, self.editBoxEvent))
        self._compEdit:displayObject():addChild(self._Input)
    end
end

function UIWndCustomize:editBoxEvent(eventType, sender)
    if eventType == "began" then
        local str = self._lbl_msg:getText()
        sender:setText(str)
    elseif eventType == "ended" then
        local str = self._Input:getText()
        self._Input:setText("")
        self._lbl_msg:setText(str)
    elseif eventType == "changed" then
        local str = sender:getText()
        str = string.gsub(str, " ", "") --过滤掉空格
        str = CommonUtil:rmSpecChars(str)
        local count = string.len(str)
        local reCount = 0
        local beginIndex = -1
        local reString = ""
        for i = 1, count do
            local s = string.sub(str, i, i)
            local t = string.byte(s)
            if t < 128 then
                reCount = reCount + 1 --1字节文字，长度加1
            elseif t >= 192 then
                reCount = reCount + 2 --1字节以上文字，长度加2
            end
            if reCount > 50 then
                beginIndex = i - 1
                break
            end
            beginIndex = i
        end
        reString = string.sub(str, 1, beginIndex)
        sender:setText("")
        self._Input:setText(reString)
    elseif eventType == "return" then
    end
end

function UIWndCustomize:onBtnFncClick(target)
    self:onClickSend()
end

function UIWndCustomize:onClickSend(addlinkstr)
    local msg = ""
    if type(addlinkstr) == "string" then
        msg = addlinkstr
    else
        msg = self._lbl_msg:getText()
    end

    if msg == "" then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = GReadText.KEY_CHAT_TIPS2 })
        return
    end

    if CommonUtil:GetUTFWidth(msg) > 100 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = string.format(GReadText.KEY_CHAT_TIPS5, 100) })
        return
    end

    self._lbl_msg:setText("")
    msg = MaskWordUtil:process(msg, "**")
    msg = string.gsub(msg, "[\n\r]", '')


    yflog:Info("-----------------msg-" .. msg)

    local itemObjID = self:getParam().itemObjID
    ChatModule:sendHornMsg(itemObjID, msg)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndCustomize", close = true })
end

return UIWndCustomize
