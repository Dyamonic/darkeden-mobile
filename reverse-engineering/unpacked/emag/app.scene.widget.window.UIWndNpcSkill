--- Npc技能学习
---@class UIWndNpcSkill:UIWindowBase
local UIWndNpcSkill = class("UIWndNpcSkill", lt.UIWindowBase)

UIWndNpcSkill.ChangeSkinConf = {
    ["CommonTL"] = {
        ["frame"] = {
            bg = "bg_common_dahaobg_01"
        }
    }
}

local CacheManager = lt.CacheManager
local AgentManager = lt.AgentManager
local Constant = lt.Constant
local GameModule = lt.GameModule
local SkillModule = lt.SkillModule
local NtfManager = lt.NtfManager

function UIWndNpcSkill:ctor(param)
    self:registerComponent("UICompNpcSkillItem","UICompSkillTips")
    UIWndNpcSkill.super.ctor(self, param)

    self._npcId = nil
    self._skillList = nil
    self._skillDataRace = nil
    self._domain = nil
    self._domainLvl = nil
    -- UI
    self._npcHead = nil
    self._npcName = nil
    self._npcIntro = nil
    self._selectItem = nil
end

function UIWndNpcSkill:onClear()
    self:unregisterAllComponent()

    self._npcId = nil
    self._skillList = nil
    self._skillDataRace = nil
    self._domain = nil
    self._domainLvl = nil
    -- UI
    self._npcHead = nil
    self._npcName = nil
    self._npcIntro = nil
    self._selectItem = nil

    if self._list then
        self._list:removeChildrenToPool()
        self._list:removeItemRenderer()
        self._list = nil
    end
    UIWndNpcSkill.super.onClear(self)
end

function UIWndNpcSkill:onInit()
    UIWndNpcSkill.super.onInit(self, _GURL.WndNpcSkill)

    self._npcHead = self:getChild("npcHead")
    self._npcName = self:getChild("title")
    self._npcIntro = self:getChild("intro")
    self._list = self:getChild("list")
    self._list:setItemRenderer(handler(self, self.renderListItem))
end

function UIWndNpcSkill:onShown()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_INIT_SKILL_LIST, handler(self, self.initNpcInfo), "UIWndNpcSkill:RefreshSkillList")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CLOSE_SKILL_TIPS, handler(self, self.closeSkillTips), "UIWndNpcSkill:closeSkillTips")

    self:initNpcInfo()
    self._list:scrollToView(0)
end

function UIWndNpcSkill:onHide()
    NtfManager:removeNtfListenerByTag("UIWndNpcSkill:RefreshSkillList")
    NtfManager:removeNtfListenerByTag("UIWndNpcSkill:closeSkillTips")
end

function UIWndNpcSkill:initNpcInfo()
    local param = (self:getParam() or {}).param
    if not param then
        return
    end
    -- dump(param)
    local viewParam = param.viewParam
    self._npcId = lt.NpcModule:getNpcId()--tonumber((viewParam.NpcId or {})[2])
    if type(self._npcId) ~= "number" then
        yflog:Info("------------>>>npcId error")
        return
    end
    
    -- npc 信息显示
    local worldAgent = AgentManager:getWorldAgent()
    local agent = worldAgent:getAgent(self._npcId)
    local npcName = worldAgent:getNpcNameById(self._npcId)
    local name,_ = unpack(string.split(npcName, "-"))
    -- 括号判断换行
    local index = string.find(name, "%（")
    if index then
        name = string.sub(name, 1, index - 1) .. "<br/>" .. string.sub(name, index)
    end
    self._npcName:setText(name)
    local meta = CacheManager:queryNpc(self._npcId)
    local headId = meta:getNpcHeadId()
    self._npcHead:setURL(string.format(_GURL.NPCHeadURL, headId))

    -- 下次再来
    local back = self:getChild("back")
    back:setObjInfo({content = GReadText.KEY_NPC_SKILL_TIPS2, index = 1, callback = handler(self, self.onClickCallback)})

    -- 提示信息
    local race = tonumber((viewParam.Race or {})[2])
    self._race = race
    local domain = tonumber((viewParam.Domain or {})[2])
    local raceStr = ""
    if race == Constant.RaceType.Slayer and domain then
        raceStr = GReadText["KEY_NPC_DOMAIN_NAME" .. domain]
    elseif race == Constant.RaceType.Vampire then
        raceStr = GReadText.KEY_NPC_SKILL_TIPS3
    end
    self._npcIntro:setText(string.format(GReadText.KEY_NPC_SKILL_TIPS1,raceStr))

    -- 技能列表
    local skillList = {}
    self._skillDataRace = race
    self._domain = domain
    self._domainLvl = nil
    if race == Constant.RaceType.Slayer then -- 人族技能筛选
        local curSkills = CacheManager:getSkillByRace(race)
        -- 转职技能不显示
        -- SkillMenu==1 标识显示在技能列表
        -- domain 分类类型
        for k,v in pairs(curSkills) do
            local skillId = v:getSkillId() or 0
            local domainTemp = math.floor(skillId/1000)
            if v:getNeedLevel() <= Constant.TransferLevel and v:getSkillMenu() == 1 and domain == domainTemp then
                table.insert(skillList, v)
            end
        end

        -- 各个领域等级
        local heroData = GameModule:getHeroData()
        local levelTable = heroData:getSlayerLevelTable()

        self._domainLvl = levelTable[self._domain] or 0
    elseif race == Constant.RaceType.Vampire then --  鬼族技能筛选
        local curSkills = CacheManager:getSkillByRace(race)
        -- 转职技能不显示
        -- SkillMenu==1 标识显示在技能列表
        for k,v in pairs(curSkills) do
            if v:getNeedLevel() <= Constant.TransferLevel and v:getSkillMenu() == 1 then
                table.insert(skillList, v)
            end
        end
    end

    -- 通用技能插入最后一个
    local commonSkill = CacheManager:getShowCommonSkill()
    for k,v in pairs(commonSkill) do
        table.insert(skillList, v)
    end

    -- 每个数据排序
    table.sort(skillList, function(a,b)
        if a:getNeedLevel() == b:getNeedLevel() then
            return a:getSkillId() < b:getSkillId()
        else
            return a:getNeedLevel() < b:getNeedLevel()
        end
    end)
    self._skillList = skillList or {}
    self._list:setNumItems(#skillList)
end

function UIWndNpcSkill:onClickCallback()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndNpcSkill", close = true})
end

function UIWndNpcSkill:renderListItem(index, obj)
    local skillCfg = self._skillList[index+1]
    if not skillCfg then
        return
    end
    
    obj:setItemInfo(skillCfg, self._skillDataRace, self._domain, self._domainLvl)
    obj:insertObjectToFactory(self)
end

function UIWndNpcSkill:closeSkillTips()
    if self._selectItem then
        self._selectItem.select:setVisible(false)
        self._selectItem = nil
    end
end

return UIWndNpcSkill