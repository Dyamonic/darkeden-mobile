-- end

function TrapAgent:getCmdSystem()
    return self._cmdSystem
end

function TrapAgent:handleCmd(cmd)
    if cmd:getCmdId() == Constant.CmdId.CMD_MOVE then
        self:move(cmd:getMoveType(), cmd:getDirection(), cmd:getMNext(), cmd:getNNext())
    elseif cmd:getCmdId() == Constant.CmdId.CMD_IDLE then
        self:idle()
    end
end

function TrapAgent:move(moveType, direction, mNext, nNext)
    self:changeState(lt.TrapStateMove.new(self, moveType, direction, mNext, nNext))
end

function TrapAgent:idle()
    self:changeState(lt.TrapStateIdle.new(self))
end

function TrapAgent:changeState(newState)
    if not self._stateMachine then
       return 
    end
    self._stateMachine:changeState(newState)
end

function TrapAgent:getMoveSpeed()
    return self._trapData:getMoveSpeed()
end

return TrapAgent
