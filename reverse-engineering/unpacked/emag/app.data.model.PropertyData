
local PropertyData = class("PropertyData")

PropertyData._propertyArray = nil
PropertyData._prePropertyArray = nil

function PropertyData:ctor(propertyArray,propertyTable)
    self._propertyArray = {}
    self._prePropertyArray = {}
    self:setPropertyArray(propertyArray)
    if propertyTable then
        self:setPropertyTable(propertyTable)
    end
end

function PropertyData:setPropertyArray(propertyArray)
    if not propertyArray then return end
    for i, v in ipairs(propertyArray) do
        if v.strValue and v.strValue ~= "" then
            self:setValue(v.properCode, v.strValue)
        elseif v.intValue then
            self:setValue(v.properCode, v.intValue)
        end
    end
    -- self:dump()
end

function PropertyData:setValue(key, value)
    local temp = self._propertyArray[key]
    if type(value) == "string" and value == "nil" then
        value = ""
    end

    self._prePropertyArray[key] = temp
    self._propertyArray[key] = value
end

function PropertyData:getValue(key)
    return self._propertyArray[key]
end

function PropertyData:getPreValue(key)
    return self._prePropertyArray[key]
end

function PropertyData:getChangeValueByKey(key)
    local cur = self._propertyArray[key] or 0
    local pre = self._prePropertyArray[key] or 0
    -- pre and cur and
    if type(pre) == "number" and type(cur) == "number" then
        return cur - pre
    end
    return nil
end

function PropertyData:restoreChangeValueByKey(key)
    self._prePropertyArray[key] = self._propertyArray[key]
end

function PropertyData:setPropertyTable(Tables)
    self._propertyArray = Tables
end

function PropertyData:getPropertyTable()
    return self._propertyArray
end
function PropertyData:dump()
    lt.LogUtil:debug(">>>>>>>>>>>>>>>>>>>> PropertyData >>>>>>>>>>>>>>>>>>>>")
    lt.LogUtil:debugTable(self._propertyArray, "propertyArray = ", 6)
    lt.LogUtil:debug("<<<<<<<<<<<<<<<<<<<< PropertyData <<<<<<<<<<<<<<<<<<<<")
end

return PropertyData
