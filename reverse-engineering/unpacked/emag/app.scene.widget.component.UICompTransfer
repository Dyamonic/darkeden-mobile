---@class UICompTransfer 角色阶级技能界面
local UICompTransfer = class("UICompTransfer", lt.UICompBase, lt.UICompChangeSkin)
UICompTransfer.ChangeSkinConf = {
   ["RoleInfo"] = {
        ["bg1"] = "bg_jineng_zhuanzhi_wbk_chang",
        ["bg2"] = "bg_jineng_jdtdi_01",
        ["bg3"] = "bg_jineng_zhuanzhi_wbk_chang",
        ["bar"] = "bg_jineng_jdtdi_02",
   } 
}

local Constant = lt.Constant
local RaceSkinRes = lt.Constant.RaceSkinRes
local GameModule = lt.GameModule
local NtfManager = lt.NtfManager
local CacheManager = lt.CacheManager
local SkillModule = lt.SkillModule

function UICompTransfer:ctor()
    self:registerComponent("UICompTSkillItem")
    self._skillData = nil
    UICompTransfer.super.ctor(self)
end

function UICompTransfer:onClear()
    self:unregisterAllComponent()
    self._skillData = nil
    UICompTransfer.super.onClear(self)
end

function UICompTransfer:onConstruct()
    -- 技能列表
    self:startSkin()

    self._transferList = self:getChild("skilllist")
    self._transferList:setItemRenderer(handler(self, self.renderListItem))
end

function UICompTransfer:onEnter()
    self._transferList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    
    local bg2 = self:getChild("bg2")
    bg2:addClickListener(handler(self, self.itemTouchFunc))
end

function UICompTransfer:onExit()
    self._transferList:removeEventListener(fgui.UIEventType.ClickItem)
    
    local bg2 = self:getChild("bg2")
    bg2:removeClickListener()
end

function UICompTransfer:initUI()
    local bar = self:getChild("bar")
    bar:setFillAmount(0.6)
end

function UICompTransfer:itemTouchFunc(context)
    local infoAttr = context:getSender()
    local itemSize = infoAttr:getSize()
    local point = infoAttr:localToGlobal({x=itemSize.width/2,y=0})
    local heroData = GameModule:getHeroData()
    local curAdvLvl = heroData:getAdvanceLevel()
    local advLevelInfo = CacheManager:getAdvLevelExpInfoMeta(curAdvLvl)
    local maxExp = advLevelInfo:getExp() or 1
    local curExp = heroData:getAdvanceExp()
    local exp = lt.CommonFunc:changeNumberShow(maxExp - curExp)
    local precent = curExp/maxExp
    local content = table.concat({
        GReadText["KEY_ROLE_INFO_TIPS41"] , exp , "(" , math.floor(precent*100) , "%)"
    })

    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SHOW_TEXT_TIPS, 
    {
        content = content,
        pt = point
    })

end

function UICompTransfer:refreshCurInfo(isSelect)
    local heroData = GameModule:getHeroData()
    -- 转职等级
    local levelValue = self:getChild("value1")
    local levelStr = heroData:getAdvanceLevelName()
    levelValue:setText(levelStr)

    -- 称号经验
    local expValue = self:getChild("value2")
    local expStr = heroData:getAdvanceExp()
    expValue:setText(expStr)

    local bar = self:getChild("bar")
    local curAdvLvl = heroData:getAdvanceLevel()
    local advLevelInfo = CacheManager:getAdvLevelExpInfoMeta(curAdvLvl)
    local percent = 0
    if advLevelInfo then
        percent = math.floor(heroData:getAdvanceExp() / advLevelInfo:getExp() * 100) / 100
    end
    if percent > 1 then
        percent = 1
    end
    bar:setFillAmount(percent)
    expValue:setText(table.concat({ percent*100 , "%/100%" }))

    -- 称号
    local nameValue = self:getChild("value3")
    local nameStr = ""
    local race = GameModule:getHeroRace()
    if race == Constant.RaceType.Slayer then
        nameStr = GReadText.KET_ADVANCE_TIPS6
    elseif race == Constant.RaceType.Vampire then
        nameStr = GReadText.KET_ADVANCE_TIPS1
    elseif race == Constant.RaceType.Ousters then
        nameStr = GReadText.KET_ADVANCE_TIPS2
    end
    nameValue:setText(nameStr)

    -- 转职技能
    local race = GameModule:getHeroRace()
    local curSkills = CacheManager:getSkillByRace(race)
    local tempSkillData = {}
    local heroData = GameModule:getHeroData()
    local levelTable = heroData:getSlayerLevelTable()
    for k,v in pairs(curSkills) do
        local needLevel = v:getNeedLevel() or 0
        if needLevel > Constant.TransferLevel then
            if race == Constant.RaceType.Slayer then
                local curDomainLvl = levelTable[v:getDomain()]
                if curDomainLvl >= Constant.TransferLevel then
                    table.insert(tempSkillData, v)
                end
            else
                table.insert(tempSkillData, v)
            end
        end
    end

    table.sort(tempSkillData, function(a,b)
        return a:getSkillId() < b:getSkillId()
    end)

    self._skillData = tempSkillData
    self._transferList:setNumItems(#tempSkillData)
    if isSelect then
        self._transferList:scrollToView(0)
    end
end

function UICompTransfer:renderListItem(index, obj)
    obj.index = index
    -- print("renderListItem" .. index)

    local bg = obj:getChild("bg")
    local race = GameModule:getHeroRace()
    local imageName = string.format("bg_jineng_zhuanzhi_wb01%s",RaceSkinRes[race])
    bg:setURL(string.format(_GURL.GetCompRoleInfo,imageName))
    
    local skillCfg = self._skillData[index+1]
    if not skillCfg then
        return
    end

    local heroData = GameModule:getHeroData()
    local curBtnState = Constant.SkillState.NotLearnable
    local needLvl = skillCfg:getNeedLevel()
    local skillId = skillCfg:getSkillId()
    local playerlv = heroData:getLevel() + heroData:getAdvanceLevel()
    local hasSkill = SkillModule:hasSkill(skillId)
    -- local skillLevel = SkillModule:getSkillLevel(skillId)
    if playerlv >= needLvl then
        curBtnState = Constant.SkillState.Learnable
    end

    if hasSkill then
        curBtnState = Constant.SkillState.Learned
    end
    
    obj:initItem(skillCfg, curBtnState)
    obj:insertObjectToFactory(self)
end

function UICompTransfer:onClickItem(context)
    local data = context:getData()

    local skillCfg = data:getSkillCfg()
    if not skillCfg then
        return
    end

    local btnList = { Constant.SkillTipBtns.Detail }
    if data:getCurState() == Constant.SkillState.Learnable then
        table.insert(btnList, Constant.SkillTipBtns.Study)
    end

    local descTips = string.format(GReadText.KET_SKILL_TIPS2, skillCfg:getName())
    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SHOW_SKILL_TIPS, 
    {
        skillInfo = skillCfg,
        btnList = btnList,
        btnState = data:getCurState(),
        studyCallback = function()
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {content = descTips, confirmCallback = function()
                local magic = nil
                local heroData = GameModule:getHeroData()
                if heroData:isOusters() then
                    magic = skillCfg:getSkillGenreType()
                end
                SkillModule:sendLearnSkill(0,skillCfg:getSkillId(),magic)
            end})
        end
    })
end


return UICompTransfer