local UIWndRecharge = class("UIWndRecharge", lt.UIWindowBase)
local NtfManager = lt.NtfManager
local CacheManager = lt.CacheManager
local Constant = lt.Constant
local RechargeModule = lt.RechargeModule
local GameModule = lt.GameModule
local RechargeShopType = Constant.RechargeShopType
local CommonFunc = lt.CommonFunc
local FunctionToggleModule = lt.FunctionToggleModule

function UIWndRecharge:ctor(param)
    self:registerComponent("UICompRechargeCell","UICompRechargeItem","UICompRechargeRmbCell","UICompRechargeBuy","UICompItem")
    UIWndRecharge.super.ctor(self, param)

    self._mainIdx = 0
    self._subIdx = 0
    self._index  = nil
    self._curMainIdx = nil
    self._curSubIdx = nil
    self._type = nil
    self._rechargeArray = CacheManager:getRechargeArrayByShopType(RechargeShopType.POINT)
    self._rechargeVoucherArray = CacheManager:getRechargeArrayByShopType(RechargeShopType.VOUCHER)
    self._rechargeType = RechargeShopType.POINT

    self._fiterBtns  = nil
    self._controlTab = nil
    self._targetList = nil
    self._itemList   = nil
    self._rechargeBtn  = nil
    self._rechargeList = nil
    self._selectItem   = nil
    self._shppingBuyPanel = nil
end

function UIWndRecharge:onClear()
    if self._targetList then
        self._targetList:removeChildrenToPool()
        self._targetList:removeItemRenderer()
        self._targetList = nil
    end
    if self._itemList then
        self._itemList:removeChildrenToPool()
        self._itemList:removeItemRenderer()
        self._itemList = nil
    end
    if self._rechargeList then
        self._rechargeList:removeChildrenToPool()
        self._rechargeList:removeItemRenderer()
        self._rechargeList = nil
    end
    self._rechargeArray  = nil
    self._rechargeVoucherArray = nil
    self._rechargeType = nil
    self._fiterBtns    = nil
    self._controlTab   = nil
    self._rechargeBtn  = nil
    self._selectItem   = nil
    self._shppingBuyPanel = nil
    self:unregisterAllComponent()
    UIWndRecharge.super.onClear(self)
end

function UIWndRecharge:onInit(url)
    UIWndRecharge.super.onInit(self, _GURL.UIWndRecharge)
    self._fiterBtns = {}
    for fiterType = 1, table.nums(Constant.RECHARGE_TYPE) do
        local obj = self:getChild("btnFiter" .. fiterType)
        obj.fiterType = fiterType
        self._fiterBtns[fiterType] = obj
    end

    self._fiterBtns[Constant.RECHARGE_TYPE.RECHARGE]:setVisible(FunctionToggleModule:checkEnterVisible(FunctionToggleModule.FunctionHelpId.RechargePage))
    self._controlTab = self:getController("tabs")

    --商城
    self._targetList = self:getChild("targetList")
    self._targetList:setItemRenderer(handler(self, self.targetRender))
    self._itemList = self:getChild("itemList")
    self._itemList:setItemRenderer(handler(self, self.shopItemRender))
    self._rechargeBtn = self:getChild("btn_recharge")

    --充值
    self._rechargeList = self:getChild("rechargeList")
    self._rechargeList:setItemRenderer(handler(self, self.rechargeRender))
    self._btnPoint   = self:getChild("BtnPoint")
    self._btnPoint:getChild("title"):setText(GReadText.KEY_SHOPPING_TIPS19)
    self._btnPoint:getChild("title2"):setText(GReadText.KEY_SHOPPING_TIPS19)
    self._btnVoucher = self:getChild("BtnVoucher")
    self._btnVoucher:getChild("title"):setText(GReadText.KEY_SHOPPING_TIPS20)
    self._btnVoucher:getChild("title2"):setText(GReadText.KEY_SHOPPING_TIPS20)
    self._controlRecharge = self:getController("rechange")

    -- 货币显示
    local currency1 = self:getChild("currency1")
    local currency2 = self:getChild("currency2")
    local currency3 = self:getChild("currency3")
    self._numVoucher = currency1:getChild("num")-- 代金券
    self._numPoint   = currency2:getChild("num")-- 点券
    self._numJinBi   = currency3:getChild("num")-- 金币
    self._addVoucher = currency1:getChild("add")-- 代金券
    self._addPoint   = currency2:getChild("add")-- 点券
    self._addJinBi   = currency3:getChild("add")-- 金币

    currency1:getChild("icon"):setURL(string.format(_GURL.GetImageItem,Constant.TYPE_VAULE_ITEM.VOUCHER))
    currency2:getChild("icon"):setURL(string.format(_GURL.GetImageItem,Constant.TYPE_VAULE_ITEM.TICKET))
    currency3:getChild("icon"):setURL(string.format(_GURL.GetImageItem,Constant.TYPE_VAULE_ITEM.COIN))
    
    self:refreshCost()

    self:resetPanel()

end

function UIWndRecharge:fixReview()
    if _G_IS_EXAMINE then
        local currency1 = self:getChild("currency1")
        currency1:setVisible(false)
        self._btnVoucher:setVisible(false)

        local currency2 = self:getChild("currency2")
        local currency3 = self:getChild("currency3")
        local currency1Pos = currency1:getPosition()
        local currency2Pos = currency2:getPosition()
        local currency3Pos = currency3:getPosition()

        local leftOffset = currency2Pos.x - currency1Pos.x
        currency2:setPosition(currency2Pos.x - leftOffset, currency2Pos.y)
        currency3:setPosition(currency3Pos.x - leftOffset, currency3Pos.y)
    end
end

function UIWndRecharge:refreshCost()
    local heroData = lt.GameModule:getHeroData()
    self._numVoucher:setText(CommonFunc:changeNumberShow(heroData:getVoucher()))
    self._numPoint:setText(CommonFunc:changeNumberShow(heroData:getGold()))
    self._numJinBi:setText(CommonFunc:changeNumberShow(heroData:getJinBi()))
end

