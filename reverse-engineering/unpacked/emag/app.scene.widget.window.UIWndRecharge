function UIWndRecharge:onShown()
    UIWndRecharge.super.onShown(self)
    NtfManager:addNtfListener(NtfManager.NTF.NTF_RECHARGE_SELECT_MAINIDX, handler(self, self.selectMainIdx),
        "UIWndRecharge:selectMainIdx")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_RECHARGE_SELECT_SUBIDX, handler(self, self.selectSubIdx),
        "UIWndRecharge:selectSubIdx")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_RECHARGE_OPEN_BUY, handler(self, self.onOpenBuyPanel),
        "UIWndRecharge:onOpenBuyPanel")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_RECHARGE_GORO, handler(self, self.onRechargeBtnClick),
        "UIWndRecharge:onRechargeBtnClick")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_SHOPPING_MALL, handler(self, self.refreshShoppingMall),
        "UIWndRecharge:refreshShoppingMall")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_MONEY_EVENT, handler(self, self.refreshItemInfo),
        "UIWndRecharge:refreshItemInfo")
    if self._fiterBtns then
        for _,obj in pairs(self._fiterBtns) do
            obj:addClickListener(handler(self, self.openFiterBtnClick))
        end
    end
    self._itemList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    self._rechargeBtn:addClickListener(handler(self, self.onRechargeBtnClick))
    --请求数据
    RechargeModule:sendShoppingMallList()
    local param = self:getParam().param
    if param then
        self._curMainIdx = param.mainIdx
        self._curSubIdx = param.subIdx
        self._index  = param.index
        self._type = param.type
    end
    if self:getContentPane() then
        self:resetPanel()
    end
    self:setVisible(true)

    self._btnPoint:addClickListener(handler(self, self.onSwitchRechargePoint))
    self._btnVoucher:addClickListener(handler(self, self.onSwitchRechargeVoucher))

    self._addVoucher:addClickListener(handler(self, self.onRechargeVoucherBtnClick))
    self._addPoint:addClickListener(handler(self, self.onRechargePointBtnClick))
    self._addJinBi:addClickListener(handler(self, self.onRechargeJinBiBtnClick))
    self:fixReview()
end

function UIWndRecharge:onHide()
    NtfManager:removeNtfListenerByTag("UIWndRecharge:selectMainIdx")
    NtfManager:removeNtfListenerByTag("UIWndRecharge:selectSubIdx")
    NtfManager:removeNtfListenerByTag("UIWndRecharge:onOpenBuyPanel")
    NtfManager:removeNtfListenerByTag("UIWndRecharge:onRechargeBtnClick")
    NtfManager:removeNtfListenerByTag("UIWndRecharge:refreshShoppingMall")
    NtfManager:removeNtfListenerByTag("UIWndRecharge:refreshItemInfo")
    if self._targetList then
        self._targetList:removeChildrenToPool()
        self._targetList:removeItemRenderer()
        self._targetList = nil
    end
    
    if self._itemList then
        self._itemList:removeChildrenToPool()
        self._itemList:removeItemRenderer()
        self._itemList:removeEventListener(fgui.UIEventType.ClickItem)
        self._itemList = nil
    end
    if self._rechargeList then
        self._rechargeList:removeChildrenToPool()
        self._rechargeList:removeItemRenderer()
        self._rechargeList = nil
    end
    if self._fiterBtns then
        for _,obj in pairs(self._fiterBtns) do
            obj:removeClickListener()
        end
    end
    self._rechargeBtn:removeClickListener()
    
    self._curMainIdx = nil
    self._curSubIdx = nil
    self._type = nil
    self._index = nil

    self._btnPoint:removeClickListener()
    self._btnVoucher:removeClickListener()

    self._addVoucher:removeClickListener()-- 代金券
    self._addPoint:removeClickListener()-- 点券
    self._addJinBi:removeClickListener()-- 金币

    UIWndRecharge.super.onHide(self)
end

function UIWndRecharge:targetRender(index, obj)
    local shoppingList = RechargeModule:getShoppingMeta(self._openViewType)
    obj:getChild("title"):setText(shoppingList[index + 1][1][1]:getType1Name())
    obj:setObjInfo(shoppingList[index + 1])
    obj.index = index + 1
end

--选中一级按钮回调
function UIWndRecharge:selectMainIdx(event)
    local param = event.param or {}
    local shoppingList = RechargeModule:getShoppingMeta(self._openViewType)

    if self._mainIdx == param.mainIdx then
        local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx-1)
        local context = self._targetList:getChildAt(childIndex)
        if context:getSize().height > 50 then
            context:getChild("icon"):setURL(string.format(_GURL.GetRechargeFGUI, "btn_sdiancz_zuoyeqian_02"))
            context:setSize(222, 50)
            context:getChild("list"):setVisible(false)
        else
            local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx-1)
            local context = self._targetList:getChildAt(childIndex)
            context:getChild("icon"):setURL(string.format(_GURL.GetRechargeFGUI, "btn_sdiancz_zuoyeqian_01"))
            local newShoppingList = context._shoppingList
            context:setSize(222, 50 + #newShoppingList * 50)
            context:getChild("list"):setVisible(true)
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_RECHARGE_SELECT_SUBIDX, { subIdx = self._curSubIdx or 1 })
        return
    end

    if self._mainIdx > 0 and self._mainIdx <= #shoppingList then
        local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
        local context = self._targetList:getChildAt(childIndex)
        context:getChild("icon"):setURL(string.format(_GURL.GetRechargeFGUI, "btn_sdiancz_zuoyeqian_02"))
        context:setSize(222, 50)
        context:getChild("list"):setVisible(false)
    end

    self._mainIdx = param.mainIdx

    local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
    local newContext = self._targetList:getChildAt(childIndex)
    local newShoppingList = newContext._shoppingList
    newContext:getChild("icon"):setURL(string.format(_GURL.GetRechargeFGUI, "btn_sdiancz_zuoyeqian_01"))
    newContext:setSize(222, 50 + #newShoppingList * 50)
    newContext:getChild("list"):setVisible(true)
    self._targetList:scrollToView(childIndex)

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_RECHARGE_SELECT_SUBIDX, { subIdx = self._curSubIdx or 1 })
end

--选中二级按钮回调
function UIWndRecharge:selectSubIdx(event)
    local param = event.param or {}
    self._subIdx = param.subIdx

    local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
    local context = self._targetList:getChildAt(childIndex)
    context:selectSubIdx(self._subIdx)

    self._itemMap = RechargeModule:getItemListMeta(self._openViewType, self._mainIdx, self._subIdx)
    self._itemList:setNumItems(#self._itemMap)

    if self._selectItem then
        self._selectItem:getChild("img_select"):setVisible(false)
    end
    if #self._itemMap == 0 then
        return
    end
    childIndex = self._itemList:itemIndexToChildIndex(0)
    context = self._itemList:getChildAt(childIndex)
    context:getChild("img_select"):setVisible(true)
    self._selectItem = context

    self._itemList:scrollToView(0)
end

--刷新商品
function UIWndRecharge:refreshShoppingMall()
    self._itemMap = RechargeModule:getItemListMeta(self._openViewType, self._mainIdx, self._subIdx) or {}
    self._itemList:setNumItems(#self._itemMap)
    if self._index and self._index > 0 and self._index <= #self._itemMap then
        self._itemList:scrollToView(self._index - 1)
        local childIndex = self._itemList:itemIndexToChildIndex(self._index - 1)
        local context = self._itemList:getChildAt(childIndex)
        if self._selectItem then
            self._selectItem:getChild("img_select"):setVisible(false)
        end
        context:getChild("img_select"):setVisible(true)
        local itemMeta = context._itemMeta
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_RECHARGE_OPEN_BUY, {itemMeta = itemMeta})
        self._selectItem = context
        self._index = nil
        self._curMainIdx = nil
        self._curSubIdx = nil
        self._type = nil
    end
end

function UIWndRecharge:shopItemRender(index, obj)
    obj:setRegClass(self)
    obj:setObjInfo(self._itemMap[index + 1])
    obj.index = index + 1
end

function UIWndRecharge:rechargeRender(index, obj)
    local rechargeArray = self._rechargeArray
    if self._rechargeType == RechargeShopType.POINT then
        rechargeArray = self._rechargeArray
    elseif self._rechargeType == RechargeShopType.VOUCHER then
        rechargeArray = self._rechargeVoucherArray
    end

    local info = rechargeArray[index + 1]
    obj:setInfo(info, index + 1)
    obj.index = index + 1
end

function UIWndRecharge:openFiterBtnClick(context)
    local sender = context:getSender()
    for fiterType = 1, table.nums(Constant.RECHARGE_TYPE) do
        if fiterType == sender.fiterType then
            self._fiterBtns[fiterType]:setSortingOrder(table.nums(Constant.RECHARGE_TYPE))
        else
            self._fiterBtns[fiterType]:setSortingOrder(table.nums(Constant.RECHARGE_TYPE) - fiterType)
        end
    end
    self:openFiterView(sender)
end

function UIWndRecharge:openFiterView(sender)
    self._openViewType = sender.fiterType
    self._controlTab:setSelectedIndex(self._openViewType - 1)
    if self._openViewType == Constant.RECHARGE_TYPE.RECHARGE then
        self:refreshChargeCurrency()
    else
        --点券/积分商城
        if #self._targetList:getChildren() > 0 and self._mainIdx > 0 then
            local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
            local context = self._targetList:getChildAt(childIndex)
            context:getChild("icon"):setURL(string.format(_GURL.GetRechargeFGUI, "btn_sdiancz_zuoyeqian_02"))
            context:setSize(222, 50)
            context:getChild("list"):setVisible(false)
        end
        local shoppingList = RechargeModule:getShoppingMeta(self._openViewType)
        self._targetList:setNumItems(#shoppingList)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_RECHARGE_SELECT_MAINIDX, { mainIdx = self._curMainIdx or 1 })
    end
end

function UIWndRecharge:refreshChargeCurrency()
    -- self._rechargeVoucherArray
    -- self._rechargeArray
    local rechargeArray = self._rechargeArray
    if self._rechargeType == RechargeShopType.POINT then
        rechargeArray = self._rechargeArray
    elseif self._rechargeType == RechargeShopType.VOUCHER then
        rechargeArray = self._rechargeVoucherArray
    end
    self._rechargeList:setNumItems(#rechargeArray)
end

function UIWndRecharge:resetPanel()
    local sender = {}
    sender.fiterType = self._type or Constant.RECHARGE_TYPE.POINT
    for fiterType = 1, table.nums(Constant.RECHARGE_TYPE) do
        if fiterType == sender.fiterType then
            self._fiterBtns[fiterType]:setSortingOrder(table.nums(Constant.RECHARGE_TYPE))
        else
            self._fiterBtns[fiterType]:setSortingOrder(table.nums(Constant.RECHARGE_TYPE) - fiterType)
        end
    end
    self:openFiterView(sender)
end

--跳转充值界面
function UIWndRecharge:onRechargeBtnClick()
    local open,tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.RechargePage) 
    if not open then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
        return
    end
    local sender = {}
    sender.fiterType = Constant.RECHARGE_TYPE.RECHARGE
    self:openFiterView(sender)
end

-- 跳转充值代金券界面
function UIWndRecharge:onRechargeVoucherBtnClick()
    local open,tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.RechargePage) 
    if not open then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
        return
    end
    local sender = {}
    sender.fiterType = Constant.RECHARGE_TYPE.RECHARGE
    self._rechargeType = RechargeShopType.VOUCHER
    self._controlRecharge:setSelectedIndex(1)
    self:openFiterView(sender)
end

-- 跳转充值点券界面
function UIWndRecharge:onRechargePointBtnClick()
    local open,tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.RechargePage) 
    if not open then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
        return
    end
    local sender = {}
    sender.fiterType = Constant.RECHARGE_TYPE.RECHARGE
    self._rechargeType = RechargeShopType.POINT
    self._controlRecharge:setSelectedIndex(0)
    self:openFiterView(sender)
end

-- 跳转交易行界面
function UIWndRecharge:onRechargeJinBiBtnClick()
    local open,tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.TradingPost)
    if not open then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = tips})
        return
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndTransactionMain", reopen = true })
end

function UIWndRecharge:onOpenBuyPanel(event)
    if not self._shppingBuyPanel then
        self._shppingBuyPanel = fgui.UIPackage:createObject("Recharge", "RechargeBuyPanel")
        self._shppingBuyPanel:insertObjectToFactory(self)
        self._shppingBuyPanel:setRegClass(self)
        self._shppingBuyPanel:setPosition(287, 51)
        self:addChild(self._shppingBuyPanel)
    end
    local param = event.param or {}
    local itemMeta = param.itemMeta
    self._shppingBuyPanel:refreshUI(itemMeta)
    self._shppingBuyPanel:setVisible(true)
end

function UIWndRecharge:onClickItem(context)
    if self._selectItem then
        self._selectItem:getChild("img_select"):setVisible(false)
    end
    local data = context:getData()
    data:getChild("img_select"):setVisible(true)
    self._selectItem = data
end

function UIWndRecharge:refreshItemInfo()
    self:refreshCost()
end

function UIWndRecharge:onLayerClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndRecharge", close = true })
end

function UIWndRecharge:onSwitchRechargePoint()
    self._controlRecharge:setSelectedIndex(0)
    self._rechargeType = RechargeShopType.POINT

    self:refreshChargeCurrency()
end

function UIWndRecharge:onSwitchRechargeVoucher()
    self._controlRecharge:setSelectedIndex(1)
    self._rechargeType = RechargeShopType.VOUCHER

    self:refreshChargeCurrency()
end

return UIWndRecharge
