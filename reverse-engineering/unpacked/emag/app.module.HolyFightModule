-- 圣战
local HolyFightModule = {}

local SocketApi     = lt.SocketApi
local netcmd_pb     = lt.netcmd_pb
local CommonModule  = lt.CommonModule
local ServerCmdDef  = lt.ServerCmdDef
local ClientCmdDef  = lt.ClientCmdDef
local NtfManager    = lt.NtfManager
local CacheManager  = lt.CacheManager
local Constant      = lt.Constant
local GameModule    = lt.GameModule
local ItemModule    = lt.ItemModule
local RedDotModule  = lt.RedDotModule

function HolyFightModule:init()
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.CS_WORLD_BOSS_LIST_RESP), handler(self, self.onWorldBossList), "HolyFightModule:onWorldBossList")
end

function HolyFightModule:clear()
    SocketApi:removeProtoListenerByTag("HolyFightModule:onWorldBossList")
    self._bossInfoArray = nil
    self._leaderMeta = nil
end

--世界boss列表请求
function HolyFightModule:sendWorldBossListReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_WORLD_BOSS_LIST_REQ))
end

function HolyFightModule:onWorldBossList(event)
    lt.LogUtil:debugInfo("HolyFightModule:onWorldBossList")
    local proto = event.param
    --有老数据时需要计算差量显示红点
    for k, v in ipairs(proto.worldBossKilledInfoList) do
        local data = self:getWorldBossById(v.tid)
        if data then
            if v.killedTime == 0 and data.killedTime ~= 0 then
                --复活显示红点
                local meta = self:getLeaderMetaById(v.tid)
                self:setRedTips(meta:getMonsterType(), v.tid, true)
            elseif v.killedTime ~= 0 and data.killedTime == 0 then
                --击杀删除红点
                local meta = self:getLeaderMetaById(v.tid)
                self:setRedTips(meta:getMonsterType(), v.tid, false)
            end
        else
            local meta = self:getLeaderMetaById(v.tid)
            self:setRedTips(meta:getMonsterType(), v.tid, v.killedTime == 0)
        end
    end
    self._bossInfoArray = proto.worldBossKilledInfoList
    --刷新界面
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_WORLD_BOSS)
end

function HolyFightModule:getLeaderMetas()
    if self._leaderMeta == nil then
        self._leaderMeta = CacheManager:getWorldBossMap()
        for k, v in pairs(self._leaderMeta) do
            table.sort(v, function (a, b)
                return a:getSort() < b:getSort()
            end)
        end
    end
    return self._leaderMeta or {}
end

--获得相关boss精英数据
function HolyFightModule:getLeaderMeta(leaderType)
    local leaderMeta = self:getLeaderMetas()
    return leaderMeta[leaderType] or {}
end

--通过id获得单个boss精英数据
function HolyFightModule:getLeaderMetaById(id)
    local leaderMeta = self:getLeaderMetas()
    for k, v in ipairs(leaderMeta) do
        for kk, vv in ipairs(v) do
            if vv:getId() == id then
                return vv
            end
        end
    end
    return nil
end

--获得相关boss精英掉落数据
function HolyFightModule:getLeaderDrops(leaderType, idx)
    local leaderArray = self:getLeaderMeta(leaderType)
    local race = GameModule:getHeroRace()
    local data = leaderArray[idx]
    local dropArray = data:getSlayerDroppedItems()
    if race == Constant.RaceType.Vampire then
        dropArray = data:getVampireDroppedItems()
    elseif race == Constant.RaceType.Ousters then
        dropArray = data:getOustersDroppedItems()
    end
    local itemInfoArray = {}
    for k, v in ipairs(dropArray) do
        if v[1] == Constant.ItemType.ITEM_TYPE_PROP then
            local itemMeta = CacheManager:getItemMeta(v[2])
            local itemInfo = ItemModule:getItemDataByConfig(itemMeta)
            table.insert(itemInfoArray, itemInfo)
        elseif v[1] == Constant.ItemType.ITEM_TYPE_EQUIP then
            local itemMeta = CacheManager:queryEquipMeta(v[2])
            local itemInfo = ItemModule:getItemDataByConfig(itemMeta)
            table.insert(itemInfoArray, itemInfo)
        end
    end
    return itemInfoArray or {}
end

--根据id获得世界Boss数据
function HolyFightModule:getWorldBossById(bossId)
    if self._bossInfoArray then
        for k, v in ipairs(self._bossInfoArray) do
            if v.tid == bossId then
                return v
            end
        end
    end
    return nil
end

------------------红点------------------
function HolyFightModule:setRedTips(main, sub, bool)
    RedDotModule:setTipsStateByName("WorldBossRedTips_"..main.."_"..sub, bool)
end

function HolyFightModule:getRedPoint(main, sub)
    local leaderMeta = self:getLeaderMetas()
    if main == nil and sub == nil then
        for k, v in ipairs(leaderMeta) do
            for kk, vv in ipairs(v) do
                local bossId = vv:getId()
                local red = self:getRedPoint(k, bossId)
                if red then
                    return true
                end
            end
        end
        return false
    elseif main ~= nil and sub == nil then
        local meta = leaderMeta[main]
        if meta then
            for k, v in ipairs(meta) do
                local bossId = v:getId()
                local red = self:getRedPoint(main, bossId)
                if red then
                    return true
                end
            end
        end
        return false
    end
    local isShowRedDot = lt.RedDotModule:getTipsStateByName("WorldBossRedTips_"..main.."_"..sub)
    --没解锁不显示红点
    if main == 1 then
        isShow = lt.FunctionToggleModule:checkEnterVisible(lt.FunctionToggleModule.FunctionHelpId.WorldBoss)
        if not isShow then
            return false
        end
    elseif main == 2 then
        isShow = lt.FunctionToggleModule:checkEnterVisible(lt.FunctionToggleModule.FunctionHelpId.EliteMonster)
        if not isShow then
            return false
        end
    end
    return isShowRedDot
end

return HolyFightModule