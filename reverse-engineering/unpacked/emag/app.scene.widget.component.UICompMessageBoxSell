---@通用提示框(+1,-1.min,max)
---@class UICompMessageBoxSell
local UICompMessageBoxSell = class("UICompMessageBoxSell", lt.UIGButtonBase, lt.UICompChangeSkin)

local NtfManager = lt.NtfManager

UICompMessageBoxSell.ChangeSkinConf = {
    ["MessageBox"] = {
        ["bg"] = "bg_tytanchuang_02",
        ["numbg"] = "bg_maimai_di",
    },
    ["CommonTL"] = {
        closeButton = {bg  = "sort"},
        confirm = {bg  = "sort"},
    } 
}

function UICompMessageBoxSell:ctor()
    UICompMessageBoxSell.super.ctor(self)
    self._data = nil
    self._num = 1
    self._maxNum = 1
end

function UICompMessageBoxSell:onClear()
    self._data = nil
    self._num = nil
    self._maxNum = nil
end

function UICompMessageBoxSell:onConstruct()
    self:startSkin()
    
    self._desc = self:getChild("desc")
    self._need = self:getChild("need")
end

function UICompMessageBoxSell:onEnter()
    local confirm = self:getChild("confirm")
    confirm:addClickListener(handler(self, self.onBtnClick))

    local closeButton = self:getChild("closeButton")
    closeButton:addClickListener(handler(self, self.onCloseBtnClick))

    local add = self:getChild("add")
    add:addClickListener(handler(self, self.onAddClick))

    local sub = self:getChild("sub")
    sub:addClickListener(handler(self, self.onSubClick))
    
    local max = self:getChild("max")
    max:addClickListener(handler(self, self.onMaxClick))

    local min = self:getChild("min")
    min:addClickListener(handler(self, self.onMinClick))

    self:initCocosInputUI()
end

function UICompMessageBoxSell:onExit()
    local confirm = self:getChild("confirm")
    confirm:removeClickListener()

    local closeButton = self:getChild("closeButton")
    closeButton:removeClickListener()

    local add = self:getChild("add")
    add:removeClickListener()

    local sub = self:getChild("sub")
    sub:removeClickListener()
    
    local max = self:getChild("max")
    max:removeClickListener()

    local min = self:getChild("min")
    min:removeClickListener()

    self._numInput:unregisterScriptEditBoxHandler()
end

function UICompMessageBoxSell:initUI()
    self._num = 1
    self._maxNum = 1
end

function UICompMessageBoxSell:refreshUI(data)
    self._data = data or {}
    self._num = 1
    self:calculateMaxNum()
    self:refreshInfo()
end

function UICompMessageBoxSell:initCocosInputUI()
    if not self._numInput then
        self._numInput = ccui.EditBox:create(cc.size(180, 44),"", ccui.TextureResType.localType)
        self._numInput:setAnchorPoint(cc.p(0, 0))
        self._numInput:setFontName(lt.Constant.FONT_4)
        self._numInput:setFontSize(26)
        self._numInput:setReturnType(cc.KEYBOARD_RETURNTYPE_SEND)
        self._numInput:setInputMode(cc.EDITBOX_INPUT_MODE_NUMERIC)
        self._numInput:registerScriptEditBoxHandler(handler(self, self.editBoxEvent))
        self:getChild("numbg"):displayObject():addChild(self._numInput)
    end
end

function UICompMessageBoxSell:onAddClick()
    self._num = self._num + 1
    if self._num > self._maxNum then
        self._num = self._maxNum
    end
    self:refreshInfo()
end

function UICompMessageBoxSell:onSubClick()
    self._num = self._num - 1
    if self._num < 1 then
        self._num = 1
    end
    self:refreshInfo()
end

function UICompMessageBoxSell:onMaxClick()
    self._num = self._maxNum
    self:refreshInfo()
end

function UICompMessageBoxSell:onMinClick()
    self._num = 1
    self:refreshInfo()
end

function UICompMessageBoxSell:editBoxEvent(eventType, sender)
    if eventType == "began" then
    elseif eventType == "ended" then
        --过滤无效字符
        self._num = tonumber(sender:getText())
        if self._num == nil then
            self._num = 1
        else
            --判断上下限
            if self._num <= 0 then
                self._num = 1
            elseif self._num > self._maxNum then
                self._num = self._maxNum
            end
        end
        sender:setText("")
        --刷新界面
        self:refreshInfo()
    elseif eventType == "changed" then
        self._num = tonumber(sender:getText())
        if self._num == nil then
            self._num = 1
        end
    elseif eventType == "return" then
    end
end

function UICompMessageBoxSell:refreshInfo()
    local descStr = ""
    local needStr = ""
    local refreshInfo = self._data.refreshInfo
    if refreshInfo then
        descStr, needStr = refreshInfo(self._num)
    end
    self._desc:setText(descStr)
    self._need:setText(needStr)
    self._numInput:setText(self._num)
end

function UICompMessageBoxSell:calculateMaxNum()
    local calculateMaxNum = self._data.calculateMaxNum
    if calculateMaxNum then
        self._maxNum = calculateMaxNum()
        return
    end
    self._maxNum = 1
end

function UICompMessageBoxSell:onCloseBtnClick()
    local closeCallback = self._data.closeCallback
    if closeCallback then
        closeCallback()
    end
    self:hideSelf()
end

function UICompMessageBoxSell:onBtnClick()
    local confirmCallback = self._data.confirmCallback
    if confirmCallback then
        confirmCallback(self._num)
    end
    self:hideSelf()
end

function UICompMessageBoxSell:hideSelf()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SELL)
end

return UICompMessageBoxSell