---@class UICompActivityItemCell
--活动奖励道具单元对象
local UICompActivityItemCell = class("UICompActivityItemCell", lt.UICompBase)

function UICompActivityItemCell:ctor(param)
    UICompActivityItemCell.super.ctor(self,param)
end

function UICompActivityItemCell:onClear()
    self._icon          = nil
    self._labelCount    = nil
    self._sprite        = nil
    UICompActivityItemCell.super.onClear(self)
end

function UICompActivityItemCell:onConstruct()
    self._icon           = self:getChild("icon")
    self._labelCount     = self:getChild("lbl_count")
end

function UICompActivityItemCell:setInfo(respath,iconPath,iconId)
    if self._sprite then
        self._sprite:removeFromParent()
        self._sprite = nil
    end
    if self._icon then
        self._icon:setURL(respath)
    end

    if iconPath == "equip" then
        if iconId then
            local sprite = lt.CommonFunc.createEquipById(iconId,0,0)
            self:displayObject():addChild(sprite)
            local pos = self._icon:getPosition()
            sprite:setPosition(pos.x,pos.y-4)
            self._sprite = sprite
        end
        self._icon:setVisible(false)
    else
        self._icon:setVisible(true)
    end
end

function UICompActivityItemCell:setItemNums(num)
    self._labelCount:setText(num)
end

--图标置灰
function UICompActivityItemCell:setGrayed(gray)
    if self._icon then
        self._icon:setGrayed(gray)
    end

    if self._sprite then
        self._sprite:setVisible(not gray)
        self._icon:setVisible(gray)
    else
        self._icon:setVisible(true)
    end
end

return UICompActivityItemCell
