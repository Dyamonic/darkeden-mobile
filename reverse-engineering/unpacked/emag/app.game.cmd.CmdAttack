
local CmdAttack = class("CmdAttack", lt.CmdBase)

CmdAttack._skillId     = nil
CmdAttack._skillLevel  = nil
CmdAttack._direction   = nil
CmdAttack._targetObjId = nil
CmdAttack._targetM     = nil
CmdAttack._targetN     = nil
CmdAttack._code        = nil  -- 用于广播其他人是否释放成功相关特效
CmdAttack._extraCode    = nil -- 额外效果（目前用于检测背刺是否触发，属于单独机制）

function CmdAttack:ctor(skillId, skillLevel, direction, targetObjId, targetM, targetN, code, extraCode)
    CmdAttack.super.ctor(self, lt.Constant.CmdId.CMD_ATTACK)

    self._skillId     = skillId
    self._skillLevel  = skillLevel
    self._direction   = direction
    self._targetObjId = targetObjId
    self._targetM     = targetM
    self._targetN     = targetN
    self._code        = code
    self._extraCode   = extraCode
end

-- Setter && Getter
function CmdAttack:getSkillId()
    return self._skillId
end

function CmdAttack:getSkillLevel()
    return self._skillLevel
end

function CmdAttack:getDirection()
    return self._direction
end

function CmdAttack:getTargetObjId()
    return self._targetObjId
end

function CmdAttack:getTargetM()
    return self._targetM
end

function CmdAttack:getTargetN()
    return self._targetN
end

function CmdAttack:getCode()
    return self._code
end

function CmdAttack:getExtraCode()
    return self._extraCode
end

return CmdAttack
