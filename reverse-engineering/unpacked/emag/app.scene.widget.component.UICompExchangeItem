---@class UICompExchangeItem
---
local UICompExchangeItem = class("UICompExchangeItem", lt.UIGButtonBase, lt.UICompChangeSkin)

local Constant = lt.Constant
local NpcModule = lt.NpcModule
local ItemModule = lt.ItemModule
local CacheManager = lt.CacheManager
local NtfManager = lt.NtfManager

UICompExchangeItem.ChangeSkinConf = {
    ["NPC"] = {
        ["bg"] = "bg_daojudh_kuang_02",
    },
    ["CommonTL"] = {
        ["btn_exchange"] = {
            icon = "bth_common_anniu05"
        }
    }
}

function UICompExchangeItem:ctor()
    UICompExchangeItem.super.ctor(self)
    --UI
    self._item = nil
    self._costItem = nil
    self._exchangeBtn = nil
    self._mainSelect = nil
    self._subSelect = nil
    --数据
    self._exchangeCfg = nil
    self._itemMeta = nil
    self._costMeta = nil
end

function UICompExchangeItem:onClear()
    --UI
    self._item = nil
    self._costItem = nil
    self._exchangeBtn = nil
    self._mainSelect = nil
    self._subSelect = nil
    self._name = nil
    self._prop = nil
    --数据
    self._exchangeCfg = nil
    self._itemMeta = nil
    self._costMeta = nil
end

function UICompExchangeItem:onConstruct()
    self:startSkin()
    self._item = fgui.UIPackage:createObject("Item", "Item")
    self:getChild("node_item1"):addChild(self._item)
    self._item:setItemNums("")

    self._costItem = fgui.UIPackage:createObject("Item", "Item")
    self:getChild("node_item2"):addChild(self._costItem)
    self._costItem:setItemNums("")
    self._costItem:setScale(0.6, 0.6)
    self._costItem:getChild("neednum"):setScale(1.5, 1.5)
    
    self._exchangeBtn = self:getChild("btn_exchange")
    self._mainSelect = self:getChild("img_select1")
    self._subSelect = self:getChild("img_select2")
    self._name = self:getChild("name")
    self._prop = self:getChild("prop")
end

function UICompExchangeItem:onEnter()
    self._item:addClickListener(function()
        if self._itemMeta:getItemType() == Constant.ItemType.ITEM_TYPE_PROP then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = self._itemMeta, tipsType = Constant.PROPTIPS_FORM.Display})
        else
            local itemInfo = ItemModule:getItemDataByConfig(self._itemMeta)
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo, tipsType = Constant.EquipShowTipsType.Display})
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_EXCHANGE_MAINSELECT,{index = self.index})
    end)
    self._costItem:addClickListener(function()
        if self._costMeta:getItemType() == Constant.ItemType.ITEM_TYPE_PROP then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = self._costMeta, tipsType = Constant.PROPTIPS_FORM.Display})
        else
            local itemInfo = ItemModule:getItemDataByConfig(self._costMeta)
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo, tipsType = Constant.EquipShowTipsType.Display})
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_EXCHANGE_SUBSELECT,{index = self.index})
    end)
    self._exchangeBtn:addClickListener(handler(self, self.onExchangeBtnClick))
    self._item:insertObjectToFactory(self:getRegClass())
    self._costItem:insertObjectToFactory(self:getRegClass())
end

function UICompExchangeItem:onExit()
    self._item:removeClickListener()
    self._costItem:removeClickListener()
    self._exchangeBtn:removeClickListener()
end

function UICompExchangeItem:setInfo(exchangeCfg)
    self._exchangeCfg = exchangeCfg
    --礼包道具
    local giftItem = exchangeCfg:getPriceItem()
    if tonumber(giftItem[1]) == Constant.ItemType.ITEM_TYPE_PROP then
        self._itemMeta = CacheManager:getItemMeta(tonumber(giftItem[2]))
        self._item:setInfo(string.format(_GURL.GetImageItem, self._itemMeta:getIconId()))
    else
        self._itemMeta = CacheManager:queryEquipMeta(tonumber(giftItem[2]))
        self._item:setInfo(string.format(_GURL.GetImageItemEquip, self._itemMeta:getIconId()))
    end
    self._name:setText(self._itemMeta:getName())
    self._item:setItemNums(giftItem[3])
    self._item:setIconScale(1.5, 1.5)
    --消耗道具
    local costItem = exchangeCfg:getExchangeItem()
    if tonumber(costItem[1]) == Constant.ItemType.ITEM_TYPE_PROP then
        self._costMeta = CacheManager:getItemMeta(tonumber(costItem[2]))
        self._costItem:setInfo(string.format(_GURL.GetImageItem, self._costMeta:getIconId()))
    else
        self._costMeta = CacheManager:queryEquipMeta(tonumber(costItem[2]))
        self._costItem:setInfo(string.format(_GURL.GetImageItemEquip, self._costMeta:getIconId()))
    end
    local haveNum = ItemModule:getItemNum(tonumber(costItem[2]))
    local needNum = tonumber(costItem[3])
    self._costItem:setNeedNum(haveNum, needNum)
    self._costItem:setIconScale(1.5, 1.5)
    -- 属性
    local itemInfo = ItemModule:getItemDataByConfig(self._itemMeta)
    local suitTableStr = ItemModule:getSuitEquipAttr(itemInfo)
    self._prop:setText(suitTableStr)
end

function UICompExchangeItem:onExchangeBtnClick()
    local costItem = self._exchangeCfg:getExchangeItem()
    local needNum = tonumber(costItem[3])
    local enoughMoney = ItemModule:enoughItem(tonumber(costItem[1]), tonumber(costItem[2]), needNum, {tips = true})
    if enoughMoney then
       --服务器交互
        NpcModule:sendExchangeItem(self._exchangeCfg:getItemIdx(), Constant.ExchangeType.EXCHANGE, self._exchangeCfg:getSite(), 1)
    end
end

function UICompExchangeItem:setMainSelect(select)
    self._mainSelect:setVisible(select)
end

function UICompExchangeItem:setSubSelect(select)
    self._subSelect:setVisible(select)
end

function UICompExchangeItem:getExchangeCfg()
    return self._exchangeCfg
end

return UICompExchangeItem