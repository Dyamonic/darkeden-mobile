function DailyRechargeDao:queryById(rewardStoreId)
    local db = lt.DbManager:getDb()
    local dailyRechargeArray = {}
    for row in db:nrows(string.format("SELECT * FROM DailyRecharge WHERE RewardStoreID=%d ;", rewardStoreId)) do
    	local dailyRechargeMeta = lt.DailyRechargeMeta.new(row)
        table.insert(dailyRechargeArray,dailyRechargeMeta)
    end
