local BulletParallelEffect = class("BulletParallelEffect", lt.BulletBase)

--[[
    多个平行弹道,并向中间聚拢

    -- 卡萨之箭
]]

local AgentManager = lt.AgentManager
local Constant = lt.Constant
local GameBoard = lt.GameBoard
local CacheManager = lt.CacheManager
local EffectEnum = lt.EffectEnum
local EffectActor = lt.EffectActor
local SkillModule = lt.SkillModule

BulletParallelEffect._targetAgentId  = nil
BulletParallelEffect._direction      = nil
BulletParallelEffect._effectActorMap = nil
BulletParallelEffect._startPos       = nil
BulletParallelEffect._arrowNum       = nil

BulletParallelEffect._bulletOffsetType = nil

function BulletParallelEffect:ctor(skillId, targetAgentId, startPos, direction, arrowNum)
    BulletParallelEffect.super.ctor(self, skillId)

    self._targetAgentId = targetAgentId
    self._direction = direction

    self._startPos = startPos
    self:setPosition(self._startPos)

    self._arrowNum = arrowNum or 1

    -- 计算方向
    local targetAgent = AgentManager:getAgent(targetAgentId)
    if not targetAgent then
        self._waitingForClear = true
        return
    end

    self._targetAgent = targetAgent
    
    local offsetX = -25
    local offsetY = -Constant.MODEL_HERO_Y/2
    self._effectNode = display.newNode()
    self._effectNode:setPosition(offsetX, offsetY)
    self:addChild(self._effectNode)

    self._isEndEffect = false

    self:addEffectActor(skillId)
end

function BulletParallelEffect:onClear()
    if type(self._effectActorMap) == "table" then
        for _,v in pairs(self._effectActorMap) do
            v:onClear()
        end
    end
    self._effectActorMap = nil
    
    self:removeAllChildren()

    self._isEndEffect = nil
    self._effectNode = nil
end

function BulletParallelEffect:addEffectActor(skillId)
    local actionInfoMetas = CacheManager:getSkillEffectBySkillIdAndGenerator(skillId, EffectEnum.EFFECTGENERATORID_ATTACK_CREATURE)
    -- 新技能配置
    if SkillModule:checkSkillNew(skillId) then
        actionInfoMetas = CacheManager:getBulletMetas(skillId,1)
    end

    if not actionInfoMetas or #actionInfoMetas < 1 then
        yflog:InfoLine(" BulletParallelEffect the skill:%d has no skill effect meta", skillId)
        return
    end

    local targetAgent = AgentManager:getAgent(self._targetAgentId)
    if not targetAgent then
        self._waitingForClear = true
        return
    end
    local endX, endY = targetAgent:getPosition()

    local meta = actionInfoMetas[1]
    if not self._effectActorMap then
        self._effectActorMap = {}
    end

    local effectCfg = {
        [1] = {posX = 0, posY = 0},
    }
    local gatheringTime = 0 -- 聚拢时间
    local arrowDistance = 16 -- 弹道距离
    if self._arrowNum > 0 then
        local offsetSpeed = meta.getBulletOffsetMoveSpeed and meta:getBulletOffsetMoveSpeed(1) or 0
        local speed = Constant.MODEL_BULLET_SPEED + offsetSpeed

        -- 新技能配置
        if SkillModule:checkSkillNew(meta:getSkillId()) then
            speed = meta:getSpeed()
        end

        gatheringTime = math.sqrt((endY-self._startPos.y)^2 + (endX-self._startPos.x)^2)/speed
        local isY = self:checkNeedOffsetXY(endX, endY, self._startPos.x, self._startPos.y)
        local offsetX,offsetY = 0,0
        if isY then offsetY = arrowDistance else offsetX = arrowDistance end

        if self._arrowNum == 2 then
            effectCfg = {
                [2] = {posX = offsetX/2, posY = offsetY/2},
                [3] = {posX =-offsetX/2, posY =-offsetY/2},
            }
        elseif self._arrowNum > 2 then
            effectCfg = {
                [1] = {posX = 0, posY = 0},
                [2] = {posX = offsetX, posY = offsetY},
                [3] = {posX =-offsetX, posY =-offsetY},
            }
        end
    end

    -- 存在旋转 所以需要加上锚点
    local anchorPoint = self:getAnchorPointByDirection(self._direction)
    for k,v in pairs(effectCfg) do
        local effectActor = EffectActor.new(meta, self._direction, anchorPoint, true)
        effectActor:setPosition(v.posX, v.posY)
        if gatheringTime > 0 then
            effectActor:runAction(cc.MoveTo:create(gatheringTime, cc.p(0,0)))
        end
        self._effectNode:addChild(effectActor)
        table.insert(self._effectActorMap, effectActor)
    end

    self._actionInfoMeta = meta

    self._isEndEffect = true
end

function BulletParallelEffect:onUpdate()
    self:onUpdateMove()
    self:onUpdateEffect()
end

function BulletParallelEffect:onUpdateMove()
    -- 只做距离移动
    local targetAgent = AgentManager:getAgent(self._targetAgentId)
    if not targetAgent then
        self._waitingForClear = true
        return
    end
    local endX, endY = targetAgent:getPosition()

    local offsetXY = self:getOffectXYByDir(self._direction,self._bulletOffsetType)

    local endPos = cc.p(endX+offsetXY.x, endY+offsetXY.y)
    local curX, curY = self:getPosition()

    local meta = self._actionInfoMeta
    local offsetSpeed = meta.getBulletOffsetMoveSpeed and meta:getBulletOffsetMoveSpeed(1) or 0
    local speed = Constant.MODEL_BULLET_SPEED + offsetSpeed

    -- 新技能配置
    if SkillModule:checkSkillNew(self._actionInfoMeta:getSkillId()) then
        speed = self._actionInfoMeta:getSpeed()
    end

    local step = speed * GameBoard:getDeltaTime()
    local directionV = cc.pSub(endPos, cc.p(curX, curY))
    
    if cc.pGetLength(directionV) < step then
        -- 到达
        self:setPosition(endPos)

        self._waitingForClear = true
    else
        directionV = cc.pMul(cc.pNormalize(directionV), step)
        self:setPosition(curX + directionV.x, curY + directionV.y)
    end
end

function BulletParallelEffect:onEnd(isLastGroupMember)
    if isLastGroupMember then
        if self._skillId == lt.SkillEnum.SKILL_KASAS_ARROW then    -- 卡萨之箭
        -- if self._skillId == lt.SkillEnum.SKILL_KASAS_ARROW and self._targetAgent then    -- 卡萨之箭
            if self._targetAgent then
                lt.SkillManager:playParallelEffectByLv(self._skillId,self._targetAgent:getAgentId(),1,Constant.EFFECT.HIT)
            end
        end
    end

    self:onClear()
end

function BulletParallelEffect:onUpdateEffect()
    if not self._isEndEffect then
		return
	end

    if type(self._effectActorMap) == "table" then
        for _,v in pairs(self._effectActorMap) do
            v:onUpdateEffect()
        end
    end
end

function BulletParallelEffect:getAnchorPointByDirection(direction)
    local anchorPoint = cc.p(0.5,0.5)
    if direction == Constant.DIRECTION_LEFT then
        anchorPoint = cc.p(0, 0.5)
    elseif direction == Constant.DIRECTION_RIGHT then
        anchorPoint = cc.p(1, 0.5)
    elseif direction == Constant.DIRECTION_DOWN then
        anchorPoint = cc.p(0.5, 0)
    elseif direction == Constant.DIRECTION_UP then
        anchorPoint = cc.p(0.5, 1)
    elseif direction == Constant.DIRECTION_LEFT_DOWN then
        anchorPoint = cc.p(0, 0)
    elseif direction == Constant.DIRECTION_LEFT_UP then
        anchorPoint = cc.p(0, 1)
    elseif direction == Constant.DIRECTION_RIGHT_DOWN then
        anchorPoint = cc.p(1, 0)
    elseif direction == Constant.DIRECTION_RIGHT_UP then
        anchorPoint = cc.p(1, 1)
    end

    return anchorPoint
end

function BulletParallelEffect:setOffectXYByDir(curType)
    self._bulletOffsetType = curType
end

function BulletParallelEffect:getOffectXYByDir(direction, curType)
    local offsetXY = nil
    if curType == lt.SkillEnum.BULLET_PARALLEL_TYPE.TYPE2 then
        offsetXY = self:getOffectXYByDirType2(direction)
    elseif curType == lt.SkillEnum.BULLET_PARALLEL_TYPE.TYPE3 then
        offsetXY = self:getOffectXYByDirType3(direction)
    else
        offsetXY = self:getOffectXYByDirType1(direction)
    end

    return offsetXY
end

function BulletParallelEffect:getOffectXYByDirType3(direction)
    local offsetXY = cc.p(0,0)
    local hitY = 75
    if direction == Constant.DIRECTION_LEFT then
        offsetXY = cc.p(0, hitY)
    elseif direction == Constant.DIRECTION_RIGHT then
        offsetXY = cc.p(0, hitY)
    elseif direction == Constant.DIRECTION_DOWN then
        offsetXY = cc.p(0, hitY )
    elseif direction == Constant.DIRECTION_UP then
        offsetXY = cc.p(0, hitY)
    elseif direction == Constant.DIRECTION_LEFT_DOWN then
        offsetXY = cc.p(0, hitY)
    elseif direction == Constant.DIRECTION_LEFT_UP then
        offsetXY = cc.p(0, hitY)
    elseif direction == Constant.DIRECTION_RIGHT_DOWN then
        offsetXY = cc.p(-0, hitY)
    elseif direction == Constant.DIRECTION_RIGHT_UP then
        offsetXY = cc.p(-0, hitY)
    end

    return offsetXY
end

function BulletParallelEffect:getOffectXYByDirType2(direction)
    local offsetXY = cc.p(0,0)
    local hitY = 75
    if direction == Constant.DIRECTION_LEFT then
        offsetXY = cc.p(48, hitY)
    elseif direction == Constant.DIRECTION_RIGHT then
        offsetXY = cc.p(-48, hitY)
    elseif direction == Constant.DIRECTION_DOWN then
        offsetXY = cc.p(0, hitY + 42)
    elseif direction == Constant.DIRECTION_UP then
        offsetXY = cc.p(0, hitY - 51)
    elseif direction == Constant.DIRECTION_LEFT_DOWN then
        offsetXY = cc.p(0, hitY + 28)
    elseif direction == Constant.DIRECTION_LEFT_UP then
        offsetXY = cc.p(0, hitY - 34)
    elseif direction == Constant.DIRECTION_RIGHT_DOWN then
        offsetXY = cc.p(-0, hitY + 28)
    elseif direction == Constant.DIRECTION_RIGHT_UP then
        offsetXY = cc.p(-0, hitY - 34)
    end

    return offsetXY
end

function BulletParallelEffect:getOffectXYByDirType1(direction)
    local offsetXY = cc.p(0,0)
    local hitY = 75
    if direction == Constant.DIRECTION_LEFT then
        offsetXY = cc.p(65, hitY)
    elseif direction == Constant.DIRECTION_RIGHT then
        offsetXY = cc.p(-65, hitY)
    elseif direction == Constant.DIRECTION_DOWN then
        offsetXY = cc.p(0, hitY + 42)
    elseif direction == Constant.DIRECTION_UP then
        offsetXY = cc.p(0, hitY - 51)
    elseif direction == Constant.DIRECTION_LEFT_DOWN then
        offsetXY = cc.p(55, hitY + 28)
    elseif direction == Constant.DIRECTION_LEFT_UP then
        offsetXY = cc.p(55, hitY - 34)
    elseif direction == Constant.DIRECTION_RIGHT_DOWN then
        offsetXY = cc.p(-55, hitY + 28)
    elseif direction == Constant.DIRECTION_RIGHT_UP then
        offsetXY = cc.p(-55, hitY - 34)
    end

    return offsetXY
end

function BulletParallelEffect:checkNeedOffsetXY(x1, y1, x2, y2)
    local isY = false
    local x = x2 - x1
    local y = y2 - y1
    if y > -x and y > x then
        isY = false
    elseif y > -x and y < x then
        isY = true
    elseif y < -x and y < x then
        isY = false
    elseif y < -x and y > x then
        isY = true
    end
    return isY
end

return BulletParallelEffect
