---@class UICompStrongFilterCell
---
local UICompStrongFilterCell = class("UICompStrongFilterCell", lt.UIGButtonBase, lt.UICompChangeSkin)

UICompStrongFilterCell.ChangeSkinConf = {
    ["Strong"] = {
        ["n0"] = "bg_zuduixitong_yeqiandi",
    },
}

function UICompStrongFilterCell:ctor()
    UICompStrongFilterCell.super.ctor(self)
    --UI
    self._title = nil
end

function UICompStrongFilterCell:onClear()
    --UI
    self._title = nil
end

function UICompStrongFilterCell:onConstruct()
    self:startSkin()
    self._title = self:getChild("title")
end

function UICompStrongFilterCell:setObjInfo(data, index)
    self._title:setText(data.name)
end

return UICompStrongFilterCell