-- 天天充值奖励配置meta
local DailyRechargeMeta = class("DailyRechargeMeta")

function DailyRechargeMeta:ctor(row)
	self:initWithRow(row)
end

function DailyRechargeMeta:initWithRow(row)
    self._rewardStoreId = row.RewardStoreID
    self._day           = row.Day
    if row.SlayerItems and row.SlayerItems ~= "" then
        self._slayerItems   = json.decode(row.SlayerItems)
    end
    if row.VampireItems and row.VampireItems ~= "" then
        self._vampireItems  = json.decode(row.VampireItems)
    end
    if row.OustersItems and row.OustersItems ~= "" then
        self._oustersItems  = json.decode(row.OustersItems)
    end
    self._display       = row.Display
end

function DailyRechargeMeta:getRewardStoreId() return self._rewardStoreId end
function DailyRechargeMeta:getDay() return self._day end
function DailyRechargeMeta:getSlayerItems() return self._slayerItems end
function DailyRechargeMeta:getVampireItems() return self._vampireItems end
function DailyRechargeMeta:getOustersItems() return self._oustersItems end
function DailyRechargeMeta:getDisplay() return self._display end

function DailyRechargeMeta:getRewardByRace(race)
	if race == lt.Constant.RaceType.Slayer then
		return self._slayerItems or {}
	end
	if race == lt.Constant.RaceType.Vampire then
		return self._vampireItems or {}
	end
	if race == lt.Constant.RaceType.Ousters then
		return self._oustersItems or {}
	end
end

return DailyRechargeMeta