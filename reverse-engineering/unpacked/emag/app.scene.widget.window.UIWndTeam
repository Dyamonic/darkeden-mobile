--- 组队界面
---@class UIWndTeam:UIWindowBase
local UIWndTeam = class("UIWndTeam", lt.UIWindowBase)

local FITER_TYPES = {
    HALL = 1,       --大厅
    TEAM = 2,       --组队
}

local CacheManager = lt.CacheManager
local NtfManager = lt.NtfManager
local Constant = lt.Constant
local TeamModule = lt.TeamModule

UIWndTeam.ChangeSkinConf = {
    ["Team"] = {
        ["frame"] = {n1 = "bg_zuduixitong_tanchuangdi"},
    },
    ["CommonTL"] = {
        ["btnFiter1"] = {n0 = "tab_normal", n1 = "tab_select", n2 = "tab_select", n3 = "tab_select"},
        ["btnFiter2"] ={n0 = "tab_normal", n1 = "tab_select", n2 = "tab_select", n3 = "tab_select"},
        ["closeButton"] = {bg  = "bg_beibao_anniu01", bgup  = "bg_beibao_anniu02"},
    }
}

function UIWndTeam:ctor(param)
    self:registerComponent("UICompTeamHall","UICompTeamMy","UICompTeamCreate","UICompTeamApply")
    UIWndTeam.super.ctor(self, param)
    self._fiterBtns = {}
    self._hallTeamPanel = nil
    self._myTeamPanel = nil
    self._controlTab = nil
    self._emptyNode = nil
    self._craeteTeamPanel = nil
    self._applyTeamPanel = nil
end

function UIWndTeam:onClear()
    self._fiterBtns = nil
    self._hallTeamPanel = nil
    self._myTeamPanel = nil
    self._controlTab = nil
    self._emptyNode = nil
    self._craeteTeamPanel = nil
    self._applyTeamPanel = nil
    self:unregisterAllComponent()
    UIWndTeam.super.onClear(self)
end

function UIWndTeam:onInit()
    UIWndTeam.super.onInit(self, _GURL.TeamPanel)
    self._controlTab = self:getController("tabs")
    self._emptyNode = self:getChild("emptyNode")
    self._emptyNode:setSortingOrder(99)

    local closeButton = self:getChild("closeButton")
    closeButton:setSortingOrder(100)
    
    for fiterType = 1, table.nums(FITER_TYPES) do
        local obj = self:getChild("btnFiter"..fiterType)
        obj.fiterType = fiterType
        self._fiterBtns[fiterType] = obj
    end
end

function UIWndTeam:onShown()
    UIWndTeam.super.onShown(self)
    NtfManager:addNtfListener(NtfManager.NTF.NTF_OPEN_CREATE_TEAM, handler(self, self.openCreateTeam), "UIWndTeam:openCreateTeam")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_OPEN_APPLY_LIST, handler(self, self.openApplyTeam), "UIWndTeam:openApplyTeam")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CLOSE_PLAYER_TIPS, handler(self, self.closePlayerTips), "UIWndTeam:closePlayerTips")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_MY_TEAM_SELECT, handler(self, self.selectMyTeam), "UIWndTeam:selectMyTeam")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_RED_DOT_EVENT, handler(self, self.uptRedDotEvt), "UIWndTeam:uptRedDotEvt")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_NEW_TEAM_CHANGE, handler(self, self.newTeamChange), "UIWndTeam:newTeamChange")
    --服务器回调相关
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_TEAM_HALL, handler(self, self.refreshTeamHall), "UIWndTeam:refreshTeamHall")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_TEAM_MY, handler(self, self.refreshTeamMy), "UIWndTeam:refreshTeamMy")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_TEAM_SELECT, handler(self, self.refreshTeamSelect), "UIWndTeam:refreshTeamSelect")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_TEAM_APPLY_LIST, handler(self, self.openApplyTeamView), "UIWndTeam:openApplyTeamView")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_APPLY_LIST, handler(self, self.refreshApplyTeam), "UIWndTeam:refreshApplyTeam")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_TEAM_OTHER, handler(self, self.refreshTeamOther), "UIWndTeam:refreshTeamOther")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_ONE_KEY_APPLY, handler(self, self.startApplyCountDown), "UIWndTeam:startApplyCountDown")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_FAST_JOIN_TEAM, handler(self, self.startFastCountDown), "UIWndTeam:startFastCountDown")

    self:getChild("closeButton"):addClickListener(handler(self, self.onCloseBtnClick))

    if self._fiterBtns then
        for _,obj in pairs(self._fiterBtns) do
            obj:addClickListener(handler(self, self.openFiterBtnClick))
        end
    end
    local param = self:getParam().param or {}
    local teamId = TeamModule:getTeamId()
    local mainIdx = param.index or (teamId == 0 and FITER_TYPES.HALL or FITER_TYPES.TEAM)
    local defaultView = self._fiterBtns[mainIdx]
    defaultView:setSortingOrder(3)
    self:openFiterView(defaultView)

    --是否需要打开申请列表
    if param.openApply then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_OPEN_APPLY_LIST)
    end
end

function UIWndTeam:onHide()
    NtfManager:removeNtfListenerByTag("UIWndTeam:openCreateTeam")
    NtfManager:removeNtfListenerByTag("UIWndTeam:openApplyTeam")
    NtfManager:removeNtfListenerByTag("UIWndTeam:closePlayerTips")
    NtfManager:removeNtfListenerByTag("UIWndTeam:selectMyTeam")
    NtfManager:removeNtfListenerByTag("UIWndTeam:uptRedDotEvt")
    NtfManager:removeNtfListenerByTag("UIWndTeam:newTeamChange")
    --服务器回调相关
    NtfManager:removeNtfListenerByTag("UIWndTeam:refreshTeamHall")
    NtfManager:removeNtfListenerByTag("UIWndTeam:refreshTeamMy")
    NtfManager:removeNtfListenerByTag("UIWndTeam:refreshTeamSelect")
    NtfManager:removeNtfListenerByTag("UIWndTeam:openApplyTeamView")
    NtfManager:removeNtfListenerByTag("UIWndTeam:refreshApplyTeam")
    NtfManager:removeNtfListenerByTag("UIWndTeam:refreshTeamOther")
    NtfManager:removeNtfListenerByTag("UIWndTeam:startApplyCountDown")
    NtfManager:removeNtfListenerByTag("UIWndTeam:startFastCountDown")

    self:getChild("closeButton"):removeClickListener()
    if self._fiterBtns then
        for _,obj in pairs(self._fiterBtns) do
            obj:removeClickListener()
        end
    end
    --初始化
    if self._hallTeamPanel then
        self._hallTeamPanel:resetIndex()
    end
    if self._myTeamPanel then
        self._myTeamPanel:onExit()
    end
    UIWndTeam.super.onHide(self)
end

function UIWndTeam:openFiterView(sender)
    self._openViewType = sender.fiterType
    self._controlTab:setSelectedIndex(self._openViewType - 1)
    self:showCurPanel()
end

function UIWndTeam:showCurPanel()
    if self._openViewType == FITER_TYPES.HALL then
        --大厅界面

        local param = self:getParam().param or {}
        local mapCode = param and param.mapCode or nil
        if not self._hallTeamPanel then
            self._hallTeamPanel = fgui.UIPackage:createObject("Team", "TeamHallPanel")
            self._hallTeamPanel:insertObjectToFactory(self)
            self._hallTeamPanel:setPosition(42, 48)
            self._emptyNode:addChild(self._hallTeamPanel)
            self._hallTeamPanel:initUI(mapCode)
        else
            if mapCode then
                self._hallTeamPanel:resetIndex(mapCode)
            else
                self._hallTeamPanel:refreshLeftView()
            end
        end
    elseif self._openViewType == FITER_TYPES.TEAM then
        --我的队伍界面
        if not self._myTeamPanel then
            self._myTeamPanel = fgui.UIPackage:createObject("Team", "TeamMyPanel")
            self._myTeamPanel:insertObjectToFactory(self)
            self._myTeamPanel:setPosition(42, 48)
            self._emptyNode:addChild(self._myTeamPanel)
            self._myTeamPanel:initUI()
        end
        --有队伍
        TeamModule:sendMyTeamInfo()
    end
    --显示
    if self._hallTeamPanel then
        self._hallTeamPanel:setVisible(self._openViewType == FITER_TYPES.HALL)
    end
    if self._myTeamPanel then
        self._myTeamPanel:setVisible(self._openViewType == FITER_TYPES.TEAM)
    end
end

function UIWndTeam:openCreateTeam()
    --创建队伍界面
    if not self._craeteTeamPanel then
        self._craeteTeamPanel = fgui.UIPackage:createObject("Team", "TeamCreatePanel")
        self._craeteTeamPanel:insertObjectToFactory(self)
        self._craeteTeamPanel:setPosition(216, 85)
        self:addChild(self._craeteTeamPanel)
        self._craeteTeamPanel:initUI()
    end
    self._craeteTeamPanel:refreshView()
    self._craeteTeamPanel:setVisible(true)
    self._craeteTeamPanel:setSortingOrder(101)
end

function UIWndTeam:openApplyTeam()
    TeamModule:checkRedTips(false)
    TeamModule:sendApplyTeamList()
end

function UIWndTeam:uptRedDotEvt(event)
    local param = event.param
    if param.name ~= "TeamApplyRedTips" then
        return
    end
    if self._myTeamPanel then
        self._myTeamPanel:uptRedDotEvt()
    end
    if self._applyTeamPanel then
        self._applyTeamPanel:uptRedDotEvt()
    end
end

function UIWndTeam:closePlayerTips(event)
    if self._myTeamPanel then
        self._myTeamPanel:clearSelect()
    end
end

function UIWndTeam:selectMyTeam(event)
    local param = event.param
    if self._myTeamPanel then
        self._myTeamPanel:onClickItem(param.data)
    end
end

------------------------------- event listener--------------------------

function UIWndTeam:onCloseBtnClick()
    --检查是否在筛选
    if self._myTeamPanel and self._myTeamPanel:checkMaskVisible() then
        self._myTeamPanel:onMaskClick()
        return
    end
    --关闭界面
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTeam", close = true})
end

function UIWndTeam:openFiterBtnClick(context)
    local sender = context:getSender()
    for fiterType = 1, table.nums(FITER_TYPES) do
        if fiterType == sender.fiterType then
            self._fiterBtns[fiterType]:setSortingOrder(3)
        else
            self._fiterBtns[fiterType]:setSortingOrder(1)
        end
    end
    self:openFiterView(sender, 1)
end

--------------------服务器回调--------------------
function UIWndTeam:refreshTeamHall(event)
    if self._hallTeamPanel then
        self._hallTeamPanel:refreshView(event.param)
        self._hallTeamPanel:refreshLeftList() -- 刷新队列队伍数量
    end
end

function UIWndTeam:refreshTeamMy(event)
    if self._myTeamPanel then
        self._myTeamPanel:refreshView(event.param)
    end
end

function UIWndTeam:refreshTeamSelect(event)
    if self._myTeamPanel then
        self._myTeamPanel:refreshSelect(event.param)
    end
end

function UIWndTeam:refreshTeamOther(event)
    if self._myTeamPanel then
        self._myTeamPanel:refreshOtherTeam(event.param)
    end
end

function UIWndTeam:openApplyTeamView(event)
    --创建申请列表界面
    if not self._applyTeamPanel then
        self._applyTeamPanel = fgui.UIPackage:createObject("Team", "TeamApplyPanel")
        self._applyTeamPanel:insertObjectToFactory(self)
        self._applyTeamPanel:setPosition(14, 17)
        self:addChild(self._applyTeamPanel)
        self._applyTeamPanel:initUI()
    end
    self._applyTeamPanel:refreshView()
    self._applyTeamPanel:setVisible(true)
    self._applyTeamPanel:setSortingOrder(101)
end

function UIWndTeam:refreshApplyTeam(event)
    if self._applyTeamPanel then
        self._applyTeamPanel:refreshView()
    end
end

function UIWndTeam:startApplyCountDown(event)
    if self._hallTeamPanel then
        self._hallTeamPanel:startApplyCountDown()
    end
end

function UIWndTeam:startFastCountDown(event)
    if self._myTeamPanel then
        self._myTeamPanel:startFastCountDown()
    end
end

function UIWndTeam:newTeamChange(event)
    self._openViewType = FITER_TYPES.TEAM
    self:openFiterView(self._fiterBtns[self._openViewType])
end

return UIWndTeam