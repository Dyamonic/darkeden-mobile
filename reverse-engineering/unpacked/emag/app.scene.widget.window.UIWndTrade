---@npc买卖界面
---@class UIWndTrade:UIWindowBase
local UIWndTrade = class("UIWndTrade", lt.UIWindowBase)

local ItemModule = lt.ItemModule
local NtfManager = lt.NtfManager
local Constant = lt.Constant
local WndLockManager = lt.WndLockManager
local NpcModule = lt.NpcModule
local CacheManager = lt.CacheManager
local GuideModule = lt.GuideModule
local TimeCounterManager = lt.TimeCounterManager

UIWndTrade.ChangeSkinConf = {
    ["NPC"] = {
        ["bg"] = "bg_maimai_dikuang",
    },
    ["CommonTL"] = {
        ["frame"] = {
            closeButton = {bg  = "bg_beibao_anniu01", bgup  = "bg_beibao_anniu02"},
        },
        ["btn1"] = {n0 = "bth_maimai_anniu", n1 = "bth_maimai_anniu"},
        ["btn2"] = {n0 = "bth_maimai_anniu", n1 = "bth_maimai_anniu"},
        ["btn3"] = {n0 = "bth_maimai_anniu", n1 = "bth_maimai_anniu"},
    }
}

local NUMBERWH = 20     --货架最大位置
local TRADELIST = {GReadText.KEY_NPC_TRADE_TIPS6, GReadText.KEY_NPC_TRADE_TIPS7, GReadText.KEY_NPC_TRADE_TIPS8}   --普通道具,特殊道具,乐透道具

--商店页签是否开启
UIWndTrade.SHOP_OPEN = {
    CLOSE = 0,    --关闭
    OPEN = 1,     --开启
}

function UIWndTrade:ctor(param)
    self:registerComponent("UICompItem")
    UIWndTrade.super.ctor(self, param)
    self._type = nil
    self._curSelectWH = 1
    self._control = nil
    self._btnList = nil  -- 3个商店按钮
    self._itemList = nil -- 商店物品列表
    self._emptyNode = nil
    self._buyNode = nil
    self._sellNode = nil
    self._exchangeNode = nil
    self._times = nil
end

function UIWndTrade:onClear()
    self._type = nil
    self._curSelectWH = nil
    self._control = nil
    self._btnList = nil
    self._itemList = nil
    self._emptyNode = nil
    self._buyNode = nil
    self._sellNode = nil
    self._exchangeNode = nil
    self._times = nil
    self:unregisterAllComponent()
    UIWndTrade.super.onClear(self)
end

function UIWndTrade:onInit()
    UIWndTrade.super.onInit(self, _GURL.TradePanel)
    --只需初始化一次
    self:initUI()
end

function UIWndTrade:onShown()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOP_REFRESH, handler(self, self.refreshTrade), "UIWndTrade:refreshTrade")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CANCEL_TRADE_CHOOSE, handler(self, self.cancelTradeChoose), "UIWndTrade:cancelTradeChoose")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_EXCHANGE_ITEM, handler(self, self.buyItemResult), "UIWndTrade:buyItemResult")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CHECK_GUIDE_EVENT, handler(self, self.checkGuide), "UIWndTrade:checkGuide")

    for k, v in ipairs(self._btnList) do
        v:addClickListener(handler(self, self.onBtnClick))
    end

    local closeBtn = self:getChild("frame"):getChild("closeButton")
    closeBtn:addClickListener(function()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndLock", close = true})
    end)

    for k, v in pairs(self._itemList) do
        local function btnClik()
            local target = v
            if target.itemInfo then
                local oldTarget = WndLockManager:getTradeItemInfo()
                if oldTarget and oldTarget.item then
                    oldTarget:getChild("selectFrame"):setVisible(false)
                    oldTarget.item:loadShader(false)
                end
                target:getChild("selectFrame"):setVisible(true)
                target.item:loadShader(true)
                WndLockManager:setTradeItemInfo(target)
                self:showTips(target.itemInfo)
            end
        end
        v:addClickListener(handler(self, btnClik))
    end
    
    self._curSelectWH = 1
    self._control:setSelectedIndex(self._curSelectWH-1)
    self._type = self:getParam().param.tabId or Constant.FiterType.Buy
    WndLockManager:setTradeType(self._type)
    if self._type == Constant.FiterType.Buy then
        self:refreshTabState()
    end
    self:refreshPanel(self._curSelectWH)

    --定时器(三秒一次)
    self._times = 0
    TimeCounterManager:startTimeCounter(TimeCounterManager.TC.TRADE_SPECIAL_REFRESH, {callback = function()
        self._times = self._times + 1
        if self._times >= 3 then
            self._times = 0
            self:sendSpecialGoods()
        end
    end})
end

function UIWndTrade:onHide()
    WndLockManager:clearTradeItemInfo()
    NtfManager:removeNtfListenerByTag("UIWndTrade:refreshTrade")
    NtfManager:removeNtfListenerByTag("UIWndTrade:cancelTradeChoose")
    NtfManager:removeNtfListenerByTag("UIWndTrade:buyItemResult")
    NtfManager:removeNtfListenerByTag("UIWndTrade:checkGuide")

    for k, v in ipairs(self._btnList) do
        v:removeClickListener()
    end

    for k, v in pairs(self._itemList) do
        v:removeClickListener()
    end

    local closeBtn = self:getChild("frame"):getChild("closeButton")
    closeBtn:removeClickListener()

    TimeCounterManager:stopTimeCounter(TimeCounterManager.TC.TRADE_SPECIAL_REFRESH)

    UIWndTrade.super.onHide(self)
end

function UIWndTrade:initUI()
    self._control = self:getController("c1")
    self._control:setSelectedIndex(self._curSelectWH-1)

    self._emptyNode = self:getChild("node_empty")

    --3个商店按钮
    self._btnList = {}
    for i = 1, #TRADELIST do
        local btn = self:getChild("btn" .. i)
        btn.index = i
        btn:setVisible(false)
        self._btnList[i] = btn
        self._btnList[i]:getChild("name"):setText(TRADELIST[i])
        self._btnList[i]:getChild("nameSelect"):setText(TRADELIST[i])
    end

    self._buyNode = self:getChild("node_buy")
    self._sellNode = self:getChild("node_sell")
    self._exchangeNode = self:getChild("node_exchange")

    -- 物品列表
    self._itemList = {}
    local numbers = {}
    for i = 1, NUMBERWH do
        table.insert(numbers, i)
    end
    for i = 1, #numbers, 5 do
        local row = {}
        for j = i, math.min(i + 4, #numbers) do
            table.insert(row, numbers[j])
        end
        for j, num in ipairs(row) do
            local row = j
            local col = math.floor((i - 1) / 5) + 1

            --生成cell
            local itemsPanel = fgui.UIPackage:createObject("NPC", "TradeItem")
            itemsPanel:getChild("selectFrame"):setVisible(false)
            local size = itemsPanel:getSize()
            itemsPanel.index = num
            itemsPanel:setPivot(0.5,0.5)
            itemsPanel:setPosition((row-1)*(size.width+2)+45, (col-1)*(size.height)+80)
            local itemsPanelSize = itemsPanel:getSize()

            -- 图标缩放
            local item = fgui.UIPackage:createObject("Item", "Item")
            item:insertObjectToFactory(self)
            item:setVisible(false)
            item:setPivot(0.5,1, true)
            item:setPosition(itemsPanelSize.width/2,itemsPanelSize.height)
            itemsPanel.item = item
            itemsPanel:getChild("itemNode"):addChild(item)

            self._emptyNode:addChild(itemsPanel)
            self._itemList[num] = itemsPanel
        end
    end
end

function UIWndTrade:sendSpecialGoods()
    --进入商店要给服务器发协议
    if self._type == Constant.FiterType.Buy and self._curSelectWH == NpcModule.SHOP_TYPE.SPECIAL then
        NpcModule:sendShopOpen()
    end
end

function UIWndTrade:onBtnClick(target)
    local btn = target:getSender()
    self:refreshPanel(btn.index)
    self:sendSpecialGoods()
end

-- 买卖页面刷新逻辑
function UIWndTrade:refreshPanel(index)
    local curSelect = index
    self._curSelectWH = curSelect

    if self._type == Constant.FiterType.Buy then
        -- 20个位置
        for i = 1, NUMBERWH do
            local meta = self:GetDepotByPos(i)
            local item = self._itemList[i].item
            if meta then
                local itemData = meta
                if self._curSelectWH == NpcModule.SHOP_TYPE.NORMAL then
                    local commodity = meta:getCommodity()
                    if tonumber(commodity[1]) == Constant.ItemType.ITEM_TYPE_PROP then
                        local itemConfig = CacheManager:getItemMeta(tonumber(commodity[2]))
                        itemData = ItemModule:getItemDataByConfig(itemConfig)
                        item:setItemInfo(itemData)
                    elseif tonumber(commodity[1]) == Constant.ItemType.ITEM_TYPE_EQUIP then
                        local itemConfig = CacheManager:queryEquipMeta(tonumber(commodity[2]))
                        itemData = ItemModule:getItemDataByConfig(itemConfig)
                        item:setItemInfo(itemData)
                    end
                    item:setGrayed(false)
                    item:setRed(not itemData:isWearable())
                elseif self._curSelectWH == NpcModule.SHOP_TYPE.SPECIAL then
                    item:setItemInfo(itemData)
                    item:setGrayed(false)
                    item:setRed(not itemData:isWearable())
                elseif self._curSelectWH == NpcModule.SHOP_TYPE.LOTTO then
                    local itemId = meta:getItemIdx()
                    local itemConfig = CacheManager:queryEquipMeta(itemId)
                    itemData = ItemModule:getItemDataByConfig(itemConfig)
                    item:setItemInfo(itemData)
                    item:setRed(false)
                    item:setGrayed(true)
                end
                item:setItemNums("")
                --乐透问号
                self._itemList[i]:getChild("img_wenhao"):setVisible(self._curSelectWH == NpcModule.SHOP_TYPE.LOTTO)

                --图标缩放
                local scale = 1
                if itemData:getItemType() == Constant.ItemType.ITEM_TYPE_EQUIP then
                    scale = CacheManager:getVariableById(Constant.Variable.EquipIconScale)
                elseif itemData:getItemType() == Constant.ItemType.ITEM_TYPE_PROP then
                    scale = CacheManager:getVariableById(Constant.Variable.ItemIconScale)
                end
                if not scale or scale == 0 then 
                    scale = 1
                end
                item:setSpritePos(0, -(item:getSize().height-item:getSpriteSize().height*scale)/2+10)
                item:setScale(0.55, 0.55)

                self._itemList[i].itemInfo = itemData
                self._itemList[i].types = self._curSelectWH
                self._itemList[i].meta = NpcModule:getMetaByShopTypeAndSite(self._curSelectWH, i)
                self._itemList[i]:setVisible(true)
                item:setVisible(true)
            else
                self._itemList[i]:setVisible(false)
                self._itemList[i].itemInfo = nil
                self._itemList[i].types = nil
                self._itemList[i].meta = nil
                item:setVisible(false)
            end
        end
    end
    self._buyNode:setVisible(self._type == Constant.FiterType.Buy)
    self._sellNode:setVisible(self._type == Constant.FiterType.Sell)
    self._exchangeNode:setVisible(self._type == Constant.FiterType.Exchange)
end

function UIWndTrade:refreshTrade()
    --只有处于特殊道具界面才更新
    if self._type == Constant.FiterType.Buy and self._curSelectWH == NpcModule.SHOP_TYPE.SPECIAL then
        self:refreshPanel(self._curSelectWH)
    end
end

--刷新商店页签
function UIWndTrade:refreshTabState()
    local shopTypeMeta = CacheManager:queryShopTypeMeta(NpcModule:getNpcId())
    if not shopTypeMeta then
        yflog:Error("UIWndTrade:refreshTabState not found npc info: %s", NpcModule:getNpcId())
        return 
    end
    local shelfs = shopTypeMeta:getShelfType()
    local idx = 0
    for i = 1, #self._btnList do
        local isVisible = tonumber(shelfs[i]) == self.SHOP_OPEN.OPEN
        self._btnList[i]:setPosition(38 + 109 * idx, 41)
        self._btnList[i]:setVisible(isVisible)
        if isVisible then
            idx = idx + 1
        end
    end
end

--取消选中
function UIWndTrade:cancelTradeChoose()
    if WndLockManager:getTradeType() == Constant.FiterType.Buy then
        local oldTarget = WndLockManager:getTradeItemInfo()
        if oldTarget and oldTarget.item then
            oldTarget:getChild("selectFrame"):setVisible(false)
            oldTarget.item:loadShader(false)
            WndLockManager:setTradeItemInfo(nil)
        end
    end
end

function UIWndTrade:GetDepotByPos(idx)
    local meta = NpcModule:getItemByShopTypeAndSite(self._curSelectWH, idx)
    return meta
end

function UIWndTrade:showTips(itemInfo)
    if not itemInfo then
        return
    end
    local itemType = itemInfo:getItemType()
    if itemType == Constant.ItemType.ITEM_TYPE_PROP then
        self:showPropTips(itemInfo)
    elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
        self:showEquipTips(itemInfo)
    end
end

function UIWndTrade:showPropTips(itemInfo)
    local tipsType = Constant.PROPTIPS_FORM.BUY
    if self._type == Constant.FiterType.Sell then
        tipsType = Constant.PROPTIPS_FORM.SELL
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemInfo, tipsType = tipsType})
end

function UIWndTrade:showEquipTips(itemInfo)
    local tipsType = Constant.EquipShowTipsType.Buy
    if self._type == Constant.FiterType.Sell then
        tipsType = Constant.EquipShowTipsType.Sell
    end
    if self._curSelectWH == NpcModule.SHOP_TYPE.NORMAL then
        --只有equipMeta
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo, tipsType = tipsType})
    elseif self._curSelectWH == NpcModule.SHOP_TYPE.SPECIAL then
        --只有equipData
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo, tipsType = tipsType})
    elseif self._curSelectWH == NpcModule.SHOP_TYPE.LOTTO then
        --乐透配置
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo, tipsType = tipsType, isLotto = true})
    end
end

--购买回调
function UIWndTrade:buyItemResult()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_TRADE_CHOOSE)
end

--检查引导
function UIWndTrade:checkGuide()
    --人族地图传送引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.SLAYER_TRANSMIT2) then
        for k, v in pairs(self._itemList) do
            local itemInfo = v.itemInfo
            if itemInfo then
                if itemInfo:getItemId() == 601001 then
                    local btn = v
                    local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
                    pos = cc.p(pos.x, pos.y)
                    GuideModule:triggerGuide(Constant.GUIDE_ID.SLAYER_TRANSMIT2, btn, pos)
                    return
                end
            end
        end
    end
end

return UIWndTrade