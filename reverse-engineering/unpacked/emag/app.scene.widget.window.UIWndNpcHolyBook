-- NPC 圣书
---@class UIWndNpcHolyBook:UIWindowBase
local UIWndNpcHolyBook          = class("UIWndNpcHolyBook", lt.UIWindowBase)

local NtfManager                = lt.NtfManager
local CacheManager              = lt.CacheManager
local AgentManager              = lt.AgentManager
local NpcModule                 = lt.NpcModule

UIWndNpcHolyBook.ChangeSkinConf = {
    ["CommonTL"] = {
        ["frame"] = {
            bg = "bg_common_dahaobg_01"
        }
    }
}

function UIWndNpcHolyBook:ctor(param)
    self:registerComponent("UICompHolyBookCell")
    UIWndNpcHolyBook.super.ctor(self, param)
end

function UIWndNpcHolyBook:onInit()
    UIWndNpcHolyBook.super.onInit(self, _GURL.WndNpcSkillBox)
    self._npcHead  = self:getChild("npcHead")
    self._npcName  = self:getChild("title")
    self._npcIntro = self:getChild("intro")
    self._list     = self:getChild("list")
    self._list:setItemRenderer(handler(self, self.renderListItem))
    self:initNpcInfo()
end

function UIWndNpcHolyBook:onShown()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_HOLYBOOK_LIST_CHANGE, handler(self, self.RefreshHolyBookList),
        "UIWndNpcHolyBook:RefreshHolyBookList")
    NpcModule:onHolyBook_ListReq()
end

function UIWndNpcHolyBook:onHide()
    NtfManager:removeNtfListenerByTag("UIWndNpcHolyBook:RefreshHolyBookList")
    UIWndNpcHolyBook.super.onHide(self)
end

function UIWndNpcHolyBook:onClear()
    self._list:setNumItems(0)
    self._npcHead  = nil
    self._npcName  = nil
    self._npcIntro = nil
    self._list     = nil
    self:unregisterAllComponent()
    UIWndNpcHolyBook.super.onClear(self)
end

function UIWndNpcHolyBook:initNpcInfo()
    self._npcId = NpcModule:getNpcId()
    if type(self._npcId) ~= "number" then
        yflog:Info("------------>>>npcId error" .. self._npcId)
        return
    end

    -- npc 信息显示
    local worldAgent = AgentManager:getWorldAgent()
    local npcName = worldAgent:getNpcNameById(self._npcId)
    local name, _ = unpack(string.split(npcName, "-"))
    -- 括号判断换行
    local index = string.find(name, "%（")
    if index then
        name = string.sub(name, 1, index - 1) .. "<br/>" .. string.sub(name, index)
    end
    self._npcName:setText(name)
    local meta = CacheManager:queryNpc(self._npcId)
    local headId = meta:getNpcHeadId()
    self._npcHead:setURL(string.format(_GURL.NPCHeadURL, headId))

    -- 下次再来
    local back = self:getChild("back")
    back:setObjInfo({ content = GReadText.KEY_HOLYBOOK_TIPS1, index = 1, callback = handler(self, self.onClickCallback) }) --下次再借
    self._npcIntro:setText(GReadText.KEY_HOLYBOOK_TIPS2)                                                                   --借你“血的圣经”标志
end

function UIWndNpcHolyBook:RefreshHolyBookList()
    local holyBookList = NpcModule:getHolyBookList() or {}
    self._list:setNumItems(#holyBookList)
end

function UIWndNpcHolyBook:renderListItem(index, obj)
    local holyBookList = NpcModule:getHolyBookList() or {}
    local info = holyBookList[index + 1]
    obj:setInfo(index, info)
end

function UIWndNpcHolyBook:onClickCallback()
    self._list:setNumItems(0) -- 说按钮闪了一下
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndNpcHolyBook", close = true})

end

return UIWndNpcHolyBook
