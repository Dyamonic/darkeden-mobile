function MonsterStateBack:onExit()
end

function MonsterStateBack:onUpdate()
    local deltaTime = lt.GameBoard:getDeltaTime()
    self._timeElapsed = self._timeElapsed + deltaTime

    local xMonster, yMonster = self._monsterAgent:getPosition()
    local directionV = cc.pSub(cc.p(self._xTarget, self._yTarget), cc.p(xMonster, yMonster))

    local step = Constant:getStateBackSpeed(lt.MapUtil:calcDirectionXY(directionV.x, directionV.y)) * deltaTime
    if cc.pGetLength(directionV) < step then
        -- 到达
        self._monsterAgent:setPosition(self._xTarget, self._yTarget)

        if self._needDisappear then
            local worldAgent = lt.AgentManager:getWorldAgent()
            worldAgent:deleteAgent(self._monsterAgent:getObjId())
        else
            local delta = Constant.SHOULDERDASH_DELAYTIME - self._timeElapsed
            if delta > 0 then
                self._monsterAgent:changeState(lt.MonsterStateDizzy.new(self._monsterAgent, delta))
            else
                self._monsterAgent:changeState(lt.MonsterStateIdle.new(self._monsterAgent))
            end
        end
    else
        -- 未到
        directionV = cc.pMul(cc.pNormalize(directionV), step)
        self._monsterAgent:setPosition(xMonster + directionV.x, yMonster + directionV.y)
    end
end

function MonsterStateBack:onMessage(msg)
end

function MonsterStateBack:getStateId()
    return Constant.MONSTER_STATE_BACK
end

function MonsterStateBack:getStateName()
    return "MonsterStateBack"
end

function MonsterStateBack:initMove(mNext, nNext)
    self._mTarget = mNext
    self._nTarget = nNext
    self._xTarget, self._yTarget = lt.MapUtil:calcMNMid(self._mTarget, self._nTarget)

    -- 设置方向
    local xMonster, yMonster = self._monsterAgent:getPosition()
    local direction = lt.MapUtil:calcDirectionXY(xMonster - self._xTarget, yMonster - self._yTarget)
    self._monsterAgent:setDirection(direction)

    -- 修改MapAgent的AgentSystem
    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
    mapAgent:changeAgentMN(self._monsterAgent, self._mTarget, self._nTarget)

    -- 播放动画
    self._monsterAgent:playAction(Constant.ROLE_ACTION_IDLE)
end

return MonsterStateBack
