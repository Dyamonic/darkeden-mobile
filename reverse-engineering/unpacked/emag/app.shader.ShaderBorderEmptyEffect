
-- 物品描边
---@class ShaderBorderEmptyEffect

local ShaderBorderEmptyEffect = class("ShaderBorderEmptyEffect", lt.ShaderBaseEffect)

function ShaderBorderEmptyEffect:ctor(node, program)
    ShaderBorderEmptyEffect.super.ctor(self, node, program)
end

---@param node cc.Node 需要修改的纹理节点
---@param color cc.vec3 基础颜色值 
---@param isBlink number 是否闪烁
---@param outLineWidth number 边缘线宽度
function ShaderBorderEmptyEffect:render(param)

    self.lineColor = param.bColor 
    self.tColor = param.tColor 
    self.isBlink = param.isBlink or 0 -- 1:open other:close
    self.outLineWidth = param.outLineWidth or 0.5
    self.isBorder = param.isBorder or 0
    self.allColor = param.allColor
    self.colorOffset = param.colorOffset or 1.0

    -- 刷新shader
    self:setNodeShader()
end

function ShaderBorderEmptyEffect:setUniform(glState, time, node)
    local size = node:getContentSize()
    glState:setUniform("u_sprite_size", cc.bytearray.from_vec2(cc.p(size.width, size.height)))
    glState:setUniform("u_OutlineWidth", cc.bytearray.from_float(self.outLineWidth))
    glState:setUniform("u_isBorder",cc.bytearray.from_int(self.isBorder))
    if self.tColor then
        glState:setUniform("u_tColor", cc.bytearray.from_vec3(self.tColor))
    end
    if self.allColor then
        glState:setUniform("allColor", cc.bytearray.from_vec3(self.allColor))
    end
    if self.colorOffset then
        glState:setUniform("u_colorOffset", cc.bytearray.from_float(self.colorOffset))
    end


    glState:setUniform("u_color", cc.bytearray.from_vec3(self.lineColor))

    glState:setUniform("u_flash", cc.bytearray.from_float(0))
    glState:setUniform("u_isFlashing", cc.bytearray.from_int(self.isBlink))
end

function ShaderBorderEmptyEffect:resetUniform(glState, time)

end

function ShaderBorderEmptyEffect.needRefresh()
    return false
end

function ShaderBorderEmptyEffect:resetTime(time)
    return time + 0.05
end

return ShaderBorderEmptyEffect

