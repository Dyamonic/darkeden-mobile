---@class UICompRewardTips
--活动奖励道具提示
local UICompRewardTips = class("UICompRewardTips", lt.UICompBase)

local Constant     = lt.Constant
local NtfManager   = lt.NtfManager
local CacheManager = lt.CacheManager
local ItemModule   = lt.ItemModule
local CommonFunc   = lt.CommonFunc

function UICompRewardTips:ctor(param)
    UICompRewardTips.super.ctor(self,param)
    self:makeFullScreen()
end

function UICompRewardTips:onClear()
    UICompRewardTips.super.onClear(self)
    self:clearRewardArray()
    self._rewardComp  = nil
    self._background  = nil
    if self._rewardList then
        self._rewardList:removeChildrenToPool()
        self._rewardList:removeItemRenderer()
        self._rewardList = nil
    end
end

function UICompRewardTips:onConstruct()
    local visibleSize = cc.Director:getInstance():getVisibleSize()
    self:setSize(visibleSize.width, visibleSize.height)
    
    self._rewardComp = self:getChild("rewardComp")

    self._background = self:getChild("background")
    self._background:setSize(visibleSize.width, visibleSize.height)

    self._rewardList = self._rewardComp:getChild("rewardList")
    self._rewardList:setItemRenderer(handler(self, self.rewardItemRender))
end

function UICompRewardTips:clearRewardArray()
    if self._rewardArray then
        for i=1,#self._rewardArray do
            self._rewardArray[i].itemId     = nil
            self._rewardArray[i].itemType   = nil
            self._rewardArray[i].itemAddNum = nil
            self._rewardArray[i].isValue    = nil
            self._rewardArray[i].itemInfo   = nil
            self._rewardArray[i] = nil
        end
        self._rewardArray = nil
    end
end

function UICompRewardTips:refreshTips()
    local rewardInfo = ItemModule:getFirstReward() or {}
    self:clearRewardArray()
    self._rewardArray = {}
    local rewardArray = rewardInfo.rewardArray or {}
    for k, v in ipairs(rewardArray) do
        local isValue  = 0
        local itemId   = v.itemId
        local itemType = v.itemType
        local itemAddNum = v.itemAddNum
        local itemInfo = nil
        local itemMeta = nil
        if v.itemType == Constant.ItemType.ITEM_TYPE_PROP then
            itemMeta = CacheManager:getItemMeta(v.itemId)
            if itemMeta:getKind() == Constant.PropType.VALUE then
                isValue = 1
            end
        elseif v.itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
            itemMeta = CacheManager:queryEquipMeta(v.itemId)
        end

        if (v.objProperty and v.objProperty.objprops and #v.objProperty.objprops > 0) and isValue ~= 1 then
            itemInfo = ItemModule:getItemDataByProperty(v.objProperty)
        elseif itemMeta then
            itemInfo = ItemModule:getItemDataByConfig(itemMeta, nil, v.itemAddNum)
        end

        table.insert(self._rewardArray, {itemId = itemId, itemType = itemType, itemAddNum = itemAddNum, isValue = isValue, itemInfo = itemInfo})
    end

    -- 优先显示值类型道具（道具类型下，14号大类）；
    -- 其次道具 ＞ 装备；
    -- 然后按照物品ID从小到大排序
    table.sort(self._rewardArray, function(a,b)
        if a.isValue ~= b.isValue then   -- 14号大类
            return a.isValue > b.isValue
        elseif a.itemType ~= b.itemType then
            return a.itemType < b.itemType
        else
            return a.itemId < b.itemId
        end
    end)
    

    -- local systemId = rewardInfo.systemId or 0
    self._rewardList:setNumItems(#self._rewardArray)
end

function UICompRewardTips:onEnter()
    UICompRewardTips.super.onEnter(self)
    
    self._background:addClickListener(handler(self, self.onLayerClick))

    self._rewardList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
end

function UICompRewardTips:onExit()
    UICompRewardTips.super.onExit(self)

    self._background:removeClickListener()

    self._rewardList:removeEventListener(fgui.UIEventType.ClickItem)

    self._rewardList:removeChildrenToPool()
end

function UICompRewardTips:onLayerClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_REWARD_TIPS)
    self._rewardArray = nil

end

function UICompRewardTips:rewardItemRender(index, obj)
    local curIndex = index+1

    local rewardInfo = self._rewardArray[curIndex]
    if not rewardInfo then
        return
    end

    if obj.sprite then
        obj.sprite:removeFromParent()
        obj.sprite = nil
    end

    local itemMeta = ""
    local sprite = nil
    if rewardInfo.itemType == Constant.ItemType.ITEM_TYPE_PROP then
        itemMeta = CacheManager:getItemMeta(rewardInfo.itemId)
        sprite = CommonFunc.createPropById(itemMeta:getIconId())
    elseif rewardInfo.itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
        itemMeta = CacheManager:queryEquipMeta(rewardInfo.itemId)
        local affixId = 0
        local affixLevel = 0
        if rewardInfo.itemInfo then
            affixId = rewardInfo.itemInfo:getFirstAffixId() or 0
            affixLevel = rewardInfo.itemInfo:getFirstAffixLevel() or 0
        end
        sprite = CommonFunc.createEquipById(itemMeta:getIconId(),affixId,affixLevel)
    end

    if sprite then
        sprite:setPosition(29,29)
        obj:getChild("img"):displayObject():addChild(sprite)

        --缩放尺寸
        local itemSize = sprite:getContentSize()
        local heightS = 50 / itemSize.height
        local widthS = 50 / itemSize.width
        local scale = heightS
        if widthS < heightS then
            scale = widthS
        end
        sprite:setScale(scale,scale)
        obj.sprite = sprite
    end
    
    local itemNum = obj:getChild("item_num")
    itemNum:setText(rewardInfo.itemAddNum)
    local size =  itemNum:getSize()
    local scale = 1
    if size.width > 52 then
        scale = 52/size.width
    end
    itemNum:setScale(scale,scale)
    obj.rewardInfo = rewardInfo
end

function UICompRewardTips:onClickItem(context)
    local btn     = context:getData()
    local rewardInfo = btn.rewardInfo
    if not rewardInfo then
        return
    end
    local itemId = rewardInfo.itemId
    local itemType = rewardInfo.itemType
    if itemType == Constant.ItemType.ITEM_TYPE_PROP then
        local itemInfo = rewardInfo.itemInfo
        if not itemInfo then
            local itemMeta = CacheManager:getItemMeta(itemId)
            itemInfo = itemMeta
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS, { itemInfo = itemInfo, tipsType = Constant.PROPTIPS_FORM.DisplayShop })
    elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS, { itemInfo = rewardInfo.itemInfo, tipsType = Constant.EquipShowTipsType.Display })
    end
end

return UICompRewardTips
