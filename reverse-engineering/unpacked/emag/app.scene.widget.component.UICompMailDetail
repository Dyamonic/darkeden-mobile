---@class UICompMailDetail 邮件详情界面
local UICompMailDetail = class("UICompMailDetail", lt.UIGButtonBase, lt.UICompChangeSkin)
UICompMailDetail.ChangeSkinConf = {
    ["Mail"] = {
        ["bg"] = "bg_youjian_tanchuangdi",
        ["frame"] = "bg_yjxt_neikuang",
    },
    ["CommonTL"] = {
        ["closeButton"] = {
            ["bg"] = "bg_beibao_anniu01",
            ["bgup"] = "bg_beibao_anniu02",
        },
        ["btn_delete"] = {
            ["bg"] = "sort",
        },
        ["btn_achieve"] = {
            ["bg"] = "sort",
        },
    }
}

local Constant      = lt.Constant
local NtfManager    = lt.NtfManager
local MailModule    = lt.MailModule
local ItemModule    = lt.ItemModule
local CacheManager = lt.CacheManager
local GameModule = lt.GameModule

function UICompMailDetail:ctor()
    self:registerComponent("UICompMailContent", "UICompItem")
    UICompMailDetail.super.ctor(self)
    --UI
    self._content = nil
    self._itemPanel = nil
    self._gotoBtn = nil
    self._deleteBtn = nil
    self._achieveBtn = nil
    --数据
    self._curCls = nil
    self._itemData = nil
end

function UICompMailDetail:onClear()
    self:unregisterAllComponent()
    --UI
    self._itemPanel = nil
    self._gotoBtn = nil
    self._deleteBtn = nil
    self._achieveBtn = nil
    --数据
    self._curCls = nil
    self._itemData = nil

    if self._content then
        self._content:removeChildrenToPool()
        self._content:removeItemRenderer()
        self._content = nil
    end
end

function UICompMailDetail:initUI()
    self._content = self:getChild("content")
    self._content:setItemRenderer(handler(self, self.renderListItem))
    self._itemPanel = self:getChild("panel_item")
    self._gotoBtn = self:getChild("btn_goto")
    self._gotoBtn:setVisible(false)
    self._deleteBtn = self:getChild("btn_delete")
    self._achieveBtn = self:getChild("btn_achieve")

    for i = 1, 7 do
        local sprite = fgui.UIPackage:createObject("Mail", "MailRewardItem")
        local item = fgui.UIPackage:createObject("Item", "Item")
        item:insertObjectToFactory(self)
        sprite:addChild(item)
        sprite:setVisible(false)
        self._itemPanel:addChild(sprite)
    end
end

function UICompMailDetail:onConstruct()
    self:startSkin()
    self:initUI()
end

function UICompMailDetail:onEnter()
    self._gotoBtn:addClickListener(handler(self, function()
        self:gotoBtnClick()
    end))
    self._deleteBtn:addClickListener(handler(self, function()
        self:deleteMailClick()
    end))
    self._achieveBtn:addClickListener(handler(self, function()
        self:achieveMailClick()
    end))
    self:getChild("closeButton"):addClickListener(handler(self, function()
        self:setVisible(false)
    end))

    local childs = self._itemPanel:getChildren()
    for i = 1, #childs do
        local sprite = childs[i]
        local item = sprite:getChildAt(1)
        local itemMeta = ""
        item:addClickListener(function()
            local rewards = self._itemData:getMailAttachment() or {}
            if rewards[i].itemType == Constant.ItemType.ITEM_TYPE_PROP then
                itemMeta = CacheManager:getItemMeta(rewards[i].itemId)
            elseif rewards[i].itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
                itemMeta = CacheManager:queryEquipMeta(rewards[i].itemId)
            end
            self:showTips(rewards[i], itemMeta)
        end)
    end
end

function UICompMailDetail:onExit()
    self._gotoBtn:removeClickListener()
    self._deleteBtn:removeClickListener()
    self._achieveBtn:removeClickListener()
    self:getChild("closeButton"):removeClickListener()

    local childs = self._itemPanel:getChildren()
    for i = 1, #childs do
        local sprite = childs[i]
        local item = sprite:getChildAt(1)
        item:removeClickListener()
    end
end

function UICompMailDetail:renderListItem(index, obj)
    obj:setContent(self._itemData:getMailContent())
    obj:insertObjectToFactory(self)
end

function UICompMailDetail:refreshPanelByCls(curCls, itemData)
    self._curCls = curCls
    self._itemData = itemData

    self._content:setNumItems(1)
    -- self._gotoBtn:setVisible(true)
    self:getChild("label_name"):setText(itemData:getTitle())

    ---附件
    local rewards = itemData:getMailAttachment() or {}
    local hasRewards = #rewards > 0
    self._achieveBtn:setVisible(hasRewards and itemData:getDrawFlag() ~= MailModule.DRAW_STATE.DRAW)
    self._achieveBtn:setText(itemData:getDrawFlag() == MailModule.DRAW_STATE.DRAW and GReadText.KET_MAIL_TIPS10 or GReadText.KET_MAIL_TIPS11)
    self._achieveBtn:setGrayed(itemData:getDrawFlag() == MailModule.DRAW_STATE.DRAW)
    self._deleteBtn:setVisible(not self._achieveBtn:isVisible())
    self._itemPanel:setVisible(hasRewards)
    local race = GameModule:getHeroRace()
    if hasRewards then
        local childs = self._itemPanel:getChildren()
        for i = 1, #childs do
            local sprite = childs[i]
            local item = sprite:getChildAt(1)
            sprite:setVisible(i <= #rewards)
            if i <= #rewards then
                sprite:getChild("n10"):setURL(string.format(_GURL.GetTaskPath, "bg_cwrw_djk"..Constant.RaceSkinRes[race]))
                local itemMeta = ""
                local iconPath = ""
                if rewards[i].itemType == Constant.ItemType.ITEM_TYPE_PROP then
                    iconPath = "prop"
                    itemMeta = CacheManager:getItemMeta(rewards[i].itemId)
                    local resUrl = string.format("ui://Item/%s_%s", iconPath,itemMeta:getIconId())
                    item:setInfo(resUrl)
                elseif rewards[i].itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
                    iconPath = "equip"
                    itemMeta = CacheManager:queryEquipMeta(rewards[i].itemId)
                    local resUrl = string.format("ui://Item/%s_%s", iconPath,itemMeta:getIconId())
                    local affixId = 0
                    if rewards[i].data then
                        affixId = rewards[i].data:getFirstAffixId()
                    end
                    item:setEquipInfo(resUrl,affixId)
                end
                
                local scaleX = 60/item:size().width
                local scaleY = 60/item:size().height
                local scale = scaleX < scaleY and scaleX or scaleY
                if scale > 1 then scale = 1 end
                item:setIconScale(scale, scale)
                item:setItemNums(rewards[i].itemNum)
                item:setGrayed(itemData:getDrawFlag() == MailModule.DRAW_STATE.DRAW)
            end
        end
    end
end

------------------------- tips ---------------------------------
function UICompMailDetail:showTips(reward, itemMeta)
    local itemType = itemMeta:getItemType()
    if itemType ==  Constant.ItemType.ITEM_TYPE_PROP then
        self:showPropTips(itemMeta)
    elseif itemType ==  Constant.ItemType.ITEM_TYPE_EQUIP then
        self:showEquipTips(reward.data and reward.data or ItemModule:getItemDataByConfig(itemMeta))
    end
end

function UICompMailDetail:showPropTips(itemInfo)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemInfo, tipsType = Constant.PROPTIPS_FORM.Display})
end

function UICompMailDetail:showEquipTips(itemInfo)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo,tipsType = Constant.EquipShowTipsType.Display})
end

------------------------- callback ---------------------------------
function UICompMailDetail:gotoBtnClick()
    self:setVisible(false)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndMail", close = true})
end

function UICompMailDetail:deleteMailClick()
    local hasDraw = self._itemData:getDrawFlag() == MailModule.DRAW_STATE.DRAW
    local mailType = self._itemData:getEmailType()
    if mailType > 2 and not hasDraw then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KET_MAIL_TIPS4})
        return
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {type = 2, content = GReadText.KET_MAIL_TIPS9, confirmCallback = function()
        --发送删除附件
        MailModule:reqDelMail({self._itemData:getRowID()})
        self:setVisible(false)
    end})
end

