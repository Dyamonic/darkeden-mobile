function BuffObservingEye:ctor(time, actor, skilllevel)    
    BuffObservingEye.super.ctor(self, BuffEnum.EFFECT_CLASS_OBSERVING_EYE, time, actor)

    local metas = CacheManager:getBuffMetas(SkillEnum.SKILL_OBSERVING_EYE,skilllevel)
    if metas[1] then
        self._actor:playSoleEffectByMetas({metas[1]})
    end

    if metas[2] then
        metas[2]:setOrder(1)
        self._actor:playParallelEffectSpecial(SkillEnum.SKILL_OBSERVING_EYE,{metas[2]})
