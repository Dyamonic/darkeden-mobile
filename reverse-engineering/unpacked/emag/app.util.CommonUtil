
local CommonUtil = {}

local socket = require "socket"
local NtfManager = lt.NtfManager

CommonUtil.data32 = {}
for i=1,32 do
    CommonUtil.data32[i] = 2 ^ (32 - i)
end

-- 十进制转二进制
function CommonUtil:d2b(arg)
    local temp = {}
    for i=1,32 do
        if (arg >= self.data32[i]) then
            temp[i] = 1
            arg = arg - self.data32[i]
        else
            temp[i] = 0
        end
    end
    return temp
end

--二进制转十进制
function CommonUtil:b2d(arg)
    local temp = 0
    for i=1,32 do
        if (arg[i] == 1) then
            temp = temp + 2 ^ (32 - i)
        end
    end
    return temp
end

function CommonUtil:isTableEmpty(theTable)
    if not theTable then
        return true
    end

    return next(theTable) == nil
end

function CommonUtil:safeRetain(obj)
    if obj then
        obj:retain()
    end
end

function CommonUtil:safeRelease(obj)
    if obj then
        obj:release()
    end
end

function CommonUtil:SplitStr(input,str)
    input = tostring(input)
    str = tostring(str)
    if (str=='') then return false end
    local pos,arr = 0, {}
    -- for each divider found
    for st,sp in function() return string.find(input, str, pos, true) end do
        table.insert(arr, string.sub(input, pos, st - 1))
        pos = sp + 1
    end
    table.insert(arr, string.sub(input, pos))
    return arr
end

function CommonUtil:StringToTable(s)  
    local tb = {}  
    --[[  
    UTF8的编码规则：  
    1. 字符的第一个字节范围： 0x00—0x7F(0-127),或者 0xC2—0xF4(194-244); UTF8 是兼容 ascii 的，所以 0~127 就和 ascii 完全一致  
    2. 0xC0, 0xC1,0xF5—0xFF(192, 193 和 245-255)不会出现在UTF8编码中   
    3. 0x80—0xBF(128-191)只会出现在第二个及随后的编码中(针对多字节编码，如汉字)   
    --]]  
    for utfChar in string.gmatch(s, "[%z\1-\127\194-\244][\128-\191]*") do  
        table.insert(tb, utfChar)  
    end  
    return tb  
end
 
-- 计算字符数
function CommonUtil:GetUTFLen(s)  
    local sTable =  self:StringToTable(s)  
  
    return #sTable  
end

-- 获取指定字符个数的字符串的实际长度
function CommonUtil:GetUTFLenWithCount(s,index,count)  
    local sTable =  self:StringToTable(s)  
    local len = 0  
    local charLen = 0  
    for i=index,#sTable do  
        local utfCharLen = string.len(sTable[i])  
        len = len + utfCharLen  
        count = count -1
        if count <= 0 then  
            break  
        end  
    end  
    return len  
end  

function CommonUtil:GetUTFWidth(s)  
    local sTable =  self:StringToTable(s)  
    local len = 0  
    local charLen = 0  
    for i=1,#sTable do  
        local utfCharLen = string.len(sTable[i])  
        if utfCharLen > 1 then -- 长度大于1的就认为是中文  
            charLen = 2  
        else  
            charLen = 1  
        end 
        len = len + charLen  
    end  
    return len  
end 

--cutname mean addlink
function CommonUtil:getStrNum(s,index,cutLen,cutname,cutnum)
    local sTable =  self:StringToTable(s)
    local charLen = 0 
    local num = 0 
    local len = 0 
     local cutarray = {}
    if cutname then
        cutarray = string.split(s,cutname)
    end
    local cutType = false
    if #cutarray > 1 then
        cutType = true
    end
    for i=index,#sTable do  
        local utfCharLen = string.len(sTable[i])  
        if utfCharLen > 1 then -- 长度大于1的就认为是中文  
            charLen = 2  
        else  
            charLen = 1  
        end 
        len = len + charLen  
        num = num + 1
        if len > cutLen or len == cutLen then
            if cutType then
                if num +cutnum > self:GetUTFLen(cutarray[1]) and num +cutnum < self:GetUTFLen(cutarray[1])+self:GetUTFLen(cutname) then
                    return self:GetUTFLen(cutarray[1])-cutnum
                else
                    return num
                end
            else
                return num
            end
        end
    end
    return num   
end

-- 截取指定长度
function CommonUtil:GetMaxLenString(s, cutLen,cutname)  
    local len =  self:GetUTFLen(s)
    local lastlen = len   
    local index = 1
    local width = 1
    local array = {}
    local finalwidth = 0
    local num = self:getStrNum(s,index,cutLen,cutname,finalwidth)
    
    -- 超长，裁剪，加... 
    while(lastlen > num)
    do
        finalwidth = self:GetUTFLenWithCount(s,index,num)+finalwidth
        array[#array+1] = string.sub(s, width, finalwidth)
        lastlen = lastlen -num
        width = finalwidth + 1
        index = num +index
        num = self:getStrNum(s,index,cutLen,cutname,finalwidth)
    end 
    if lastlen ~= 0 then
        array[#array+1] = string.sub(s, width, self:GetUTFLenWithCount(s,1,len))
    end
    --[[
    if len > num then  
        array[#array+1] = string.sub(s, 1, self:GetUTFLenWithCount(s, num))  
        --dstString = dstString.."..." 
        array[#array+1] = string.sub(s, self:GetUTFLenWithCount(s, num)+1, self:GetUTFLenWithCount(s, len))
    else
        array[#array+1] = s
    end
    ]]  
    return array  
end 

function CommonUtil:GetSpecialLenString(strs,nums)  
    local array = {}
    strs = string.gsub(strs,"\\n", "\n")
    local strarray = string.split(strs, "\n")
    for k,v in ipairs(strarray) do
        if v and v ~="" then
            local data = self:GetMaxLenString(v, nums)
            for j,h in ipairs(data) do
                if h and h ~= "" then
                    array[#array+1] = h
                end
            end
        end
    end
    return array
end 

function CommonUtil:calcColor(intValue)
    if not intValue or intValue == 0 then
        return lt.Constant.COLOR_TEXT_WHITE
    end

    if intValue > 255 then
        local r = math.min(math.floor(intValue % 0x1000000 / 0xFFFF), 255)
        local g = math.min(math.floor(intValue % 0x10000 / 0xFF), 255)
        local b = math.min(math.floor(intValue % 0x100), 255)
        return cc.c3b(r, g, b)
    else
        return lt.Constant.GAME_COLOR_ARRAY[intValue + 1]
    end
end

function CommonUtil:string2time(timeString)
    if type(timeString) ~= 'string' then
        return 0
    end
    local fun = string.gmatch( timeString, "%d+")
    local y = fun() or 0
    if y == 0 then return 0 end
    local m = fun() or 0
    if m == 0 then return 0 end
    local d = fun() or 0
    if d == 0 then return 0 end
    local H = fun() or 0
    if H == 0 then return 0 end
    local M = fun() or 0
    if M == 0 then return 0 end
    local S = fun() or 0
    if S == 0 then return 0 end
    return os.time({year=y, month=m, day=d, hour=H,min=M,sec=S})
end

--转化时区后的os.date
function CommonUtil:date(format, time)
    if time == nil then
        time = os.time()
    end
    time = time + UTC * HOUR
    if format ~= nil then
        if string.sub(format,1,1) ~= "!" then
            format = "!"..format
        end
    else
        format = "!%c"
    end
    return os.date(format, time)
end

--转化时区的time 取代os.time()
local _UTC_TIME
function CommonUtil:OSTime(date)
    if _UTC_TIME == nil then
        local time = os.time()
        local date1 = os.date("*t", time)
        local date2 = os.date("!*t", time)
        _UTC_TIME = os.time(date2) - os.time(date1)
    end
    return os.time(date) -(_UTC_TIME + UTC * HOUR)
end

function CommonUtil:convertColorWithX(colorStr)
    -- 去掉前面的 # 符号
    if colorStr:sub(1, 1) == "#" then
        colorStr = colorStr:sub(2)
    end

    -- 将十六进制字符串转换为数字
    local color = tonumber(colorStr, 16)
    if not color then
        error("Invalid color string")
    end

    local r = 0 
    local g = 0 
    local b = 0

    -- 提取 RGB 值
    b = color % 256
    color = math.floor(color / 256)
    g = color % 256
    color = math.floor(color / 256)
    r = color % 256

    return cc.c3b(r, g, b)
end

function CommonUtil:rmSpecChars(str)
    local ss = {}
    local k = 1 
    while true do
        if k > #str then break end
        local c = string.byte(str, k)
        if not c then break end
        if c < 192 then
            if (c >= 48 and c <= 57) then -- 数字
                table.insert(ss, string.char(c))
            elseif (c >= 65 and c <= 90) or (c >= 97 and c <= 122) then  -- 英文
                table.insert(ss, string.char(c))    
            end
            k = k + 1
        elseif c < 224 then  
            k = k + 2
        elseif c < 240 then  
            if c >= 228 and c <= 233 then  
                local c1 = string.byte(str, k + 1)  
                local c2 = string.byte(str, k + 2)  
                if c1 and c2 then  
                    local a1, a2, a3, a4 = 128, 191, 128, 191  
                    if c == 228 then a1 = 184
                    elseif c == 233 then a2,a4 = 190,c1 ~= 190 and 191 or 165  
                    end  
                    if c1 >= a1 and c1 <= a2 and c2 >= a3 and c2 <= a4 then -- 中文
                        table.insert(ss, string.char(c, c1, c2))
                    end  
                end  
            end  
            k = k + 3
        elseif c < 248 then  
            k = k + 4  
        elseif c < 252 then  
            k = k + 5  
        elseif c < 254 then  
            k = k + 6 
        end
    end
    return table.concat(ss)
end

function CommonUtil:rad(d)
    return d * math.pi / 180.0
end

function CommonUtil:getDistance(a, b)
    local r1 = self:rad(a.x)
    local r2 = self:rad(b.x)
    local lx = r1 - r2
    local ly = self:rad(b.x) - self:rad(b.y)
    local s = 2*math.asin(math.sqrt(math.pow(math.sin(lx/2),2) + math.cos(r1)*math.cos(r2)*math.pow(math.sin(ly/2),2)))
    return s
end

function CommonUtil:tableToString(tbl, indent)
    indent = indent or 0
    local result = "{\n"
    for k, v in pairs(tbl) do
        if type(k) == "string" then
            k = "\"" .. k .. "\""
        end
        if type(v) == "table" then
            -- 如果元素是table,则递归调用
            result = result .. string.rep(" ", indent + 2) .. "[" .. k .. "] = " .. CommonUtil:tableToString(v, indent + 2) .. ",\n"
        elseif type(v) == "string" then
            v = "\"" .. "string" .. "\""
            result = result .. string.rep(" ", indent + 2) .. "[" .. k .. "] = " .. v .. ",\n"
        elseif type(v) == "number" then
            v = 123
            result = result .. string.rep(" ", indent + 2) .. "[" .. k .. "] = " .. v .. ",\n"
        end
    end
    -- 移除最后的逗号和换行
    result = result:sub(1, -3) .. "\n" .. string.rep(" ", indent) .. "}"
    return result

end


---fmt
---- 格式化字符串方法的扩展和封装。
---- [用法1] format 后面跟一个 hashMap。会以后面的tabel的key查找format，替换成对应的value。
----
---- 例子1：fmt('_name_ get a _goods_', {['_name_'] = 'test', ['_goods_'] = 'apple'})
---- 结果1：test get a apple
---@param format string
---@vararg any
---@return string
local function fmt(format, ...)
    local n = select("#", ...)
    local result = tostring(format)
    -- 以hashMap结构，自定义key替换value   
    if n == 1 and type(select(1, ...)) == 'table' then
        for k,v in pairs(select(1, ...)) do
            local vstr = tostring(v)
            if type(v) == 'table' then
                vstr = string.format(tostring(v[1]), tostring(v[2]))
            end
            result = (string.gsub(result, tostring(k), vstr))           
        end
    end
    return result
end

