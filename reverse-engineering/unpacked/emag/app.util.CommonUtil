function CommonUtil:GetUTFLen(tbl, indent)
    indent = indent or 0
    local result = "{\n"
    for k, v in pairs(tbl) do
        if type(k) == "string" then
            k = "\"" .. k .. "\""
        end
        if type(v) == "table" then
            -- 如果元素是table,则递归调用
            result = result .. string.rep(" ", indent + 2) .. "[" .. k .. "] = " .. CommonUtil:tableToString(v, indent + 2) .. ",\n"
        elseif type(v) == "string" then
            v = "\"" .. "string" .. "\""
            result = result .. string.rep(" ", indent + 2) .. "[" .. k .. "] = " .. v .. ",\n"
        elseif type(v) == "number" then
            v = 123
            result = result .. string.rep(" ", indent + 2) .. "[" .. k .. "] = " .. v .. ",\n"
        end
    end
    -- 移除最后的逗号和换行
    result = result:sub(1, -3) .. "\n" .. string.rep(" ", indent) .. "}"
    return result

end

function CommonUtil:isBitSet(num, bit_pos)
    return math.floor(num / (2^bit_pos)) % 2
end

return CommonUtil
