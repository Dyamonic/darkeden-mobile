-- 坐骑界面
---@class UIWndMountMain:UIWindowBase
local UIWndMountMain          = class("UIWndMountMain", lt.UIWindowBase)

local NtfManager              = lt.NtfManager
local GameModule              = lt.GameModule
local Constant                = lt.Constant
local RaceType                = Constant.RaceType
local CacheManager            = lt.CacheManager
local MountModule             = lt.MountModule

UIWndMountMain.ChangeSkinConf = {
    ["Mount"] = {
        ["bg"] = "bg_zhuangbei_beijinban",
    },
    ["CommonTL"] = {
        ["btnFiter1"] = { n0 = "tab_normal", n1 = "tab_select", n2 = "tab_select", n3 = "tab_select" },
        ["btnFiter2"] = { n0 = "tab_normal", n1 = "tab_select", n2 = "tab_select", n3 = "tab_select" },
        ["frame"] = {
            closeButton = { bg = "bg_beibao_anniu01", bgup = "bg_beibao_anniu02" },
        },
    }
}

function UIWndMountMain:ctor(param)
    self:registerComponent("UICompMount", "UICompMountItem", "UICompMountNumbCell")
    UIWndMountMain.super.ctor(self, param)
    self._fiterBtns  = {}
    self._mountPanel = nil
    self._haloPanel  = nil
end

function UIWndMountMain:onShown()
    self:enableUpdateEvent(true)

    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATA_MOUNTEORHALO_CHANGE,
        handler(self, self.refreshDataUpdatas), "UIWndMountMain:refreshDataUpdatas")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_RED_DOT_EVENT,
        handler(self, self.uptRedDotEvt), "UIWndMountMain:uptRedDotEvt")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CHECK_GUIDE_EVENT,
        handler(self, self.checkGuide), "UIWndMountMain:checkGuide")
    
    local len = table.nums(Constant.FITER_MOUNT_TYPE) 
    for fiterType = 1, len do
        self._fiterBtns[fiterType]:addClickListener(handler(self, self.openFiterBtnClick))
    end
    -- self._touchLayer:addClickListener(handler(self, self.onLayerClick))

    local param = self:getParam().param or {}
    local mainIdx = param.index or Constant.FITER_MOUNT_TYPE.MOUNT
    local defaultView = self._fiterBtns[mainIdx]
    defaultView:setSortingOrder(3)
    self:openFiterView(defaultView)
end

function UIWndMountMain:onHide()
    NtfManager:removeNtfListenerByTag("UIWndMountMain:refreshDataUpdatas")
    NtfManager:removeNtfListenerByTag("UIWndMountMain:uptRedDotEvt")
    NtfManager:removeNtfListenerByTag("UIWndMountMain:checkGuide")
    local len = table.nums(Constant.FITER_MOUNT_TYPE) 
    for fiterType = 1, len do
        self._fiterBtns[fiterType]:removeClickListener()
    end
    UIWndMountMain.super.onHide(self)
end

function UIWndMountMain:onClear()
    local len = table.nums(Constant.FITER_MOUNT_TYPE)
    for fiterType = 1, len do
        self._fiterBtns[fiterType] = nil
    end
    self._fiterBtns  = {}
    self._mountPanel = nil
    self._emptyNode  = nil
    self._controlTab = nil
    self._touchLayer = nil
    self:unregisterAllComponent()
    UIWndMountMain.super.onClear(self)
end

function UIWndMountMain:doShowAnimation()
    MountModule:onQueryMountReq()
    MountModule:onQueryHaloReq()
    UIWndMountMain.super.doShowAnimation(self)
end

function UIWndMountMain:onInit()
    UIWndMountMain.super.onInit(self, _GURL.MountMainPanel)
    self._emptyNode = self:getChild("emptyNode")
    self._controlTab = self:getController("tabs")

    local len = table.nums(Constant.FITER_MOUNT_TYPE)
    for fiterType = 1, len do
        local obj = self:getChild("btnFiter" .. fiterType)
        obj.fiterType = fiterType
        self._fiterBtns[fiterType] = obj
    end
    -- self._emptyNode:setSortingOrder(99)
end

function UIWndMountMain:openFiterBtnClick(context)
    local sender = context:getSender()
    local len = table.nums(Constant.FITER_MOUNT_TYPE)
    for fiterType = 1, len do
        if fiterType == sender.fiterType then
            self._fiterBtns[fiterType]:setSortingOrder(3)
        else
            self._fiterBtns[fiterType]:setSortingOrder(1)
        end
    end
    self:openFiterView(sender)
end

function UIWndMountMain:openFiterView(sender)
    if self._openViewType == sender.fiterType then
        return
    end
    self._openViewType = sender.fiterType
    self._controlTab:setSelectedIndex(self._openViewType - 1)
    self:showCurPanel()
end

function UIWndMountMain:showCurPanel()
    local metadatas = {}
    local show_tab = {}
    if self._openViewType == Constant.FITER_MOUNT_TYPE.MOUNT then
        local level = 1
        metadatas = MountModule:getMountMapData()
        local temp = {}
        local param = self:getParam().param or {}
        local itemId = param.itemId 
        for _, v in pairs(metadatas) do
            table.insert(temp, v.metas[level])
        end
        table.sort(temp, function(a, b)
            return a._type < b._type
        end)
        local curIndex = 1
        for key, item in ipairs(temp) do  
            table.insert(show_tab, item)
            local costArray = item:getCost()
            if tonumber(costArray[1][2]) == tonumber(itemId) then
                curIndex = key
            end
        end
        
        if not self._mountPanel then
            self._mountPanel = fgui.UIPackage:createObject("Mount", "MountPanel")
            self._mountPanel:setRegClass(self)
            self._mountPanel:insertObjectToFactory(self)
            self._mountPanel:setPosition(37, 42)
            self._emptyNode:addChild(self._mountPanel)
        end
        self._mountPanel:refreshView(self._openViewType, show_tab ,curIndex)
    elseif self._openViewType == Constant.FITER_MOUNT_TYPE.HALO then
        metadatas = MountModule:getHaloMapData()
        local level = 1
        local temp = {}
        local param = self:getParam().param or {}
        local itemId = param.itemId 
        for _, v in pairs(metadatas) do
            table.insert(temp, v.metas[level])
        end
        table.sort(temp, function(a, b)
            return a._type < b._type
        end)
        local curIndex = 1
        for key, item in ipairs(temp) do
            table.insert(show_tab, item)
            local costArray = item:getCost()
            if tonumber(costArray[1][2]) == tonumber(itemId) then
                curIndex = key
            end
        end
        if not self._mountPanel then
            self._mountPanel = fgui.UIPackage:createObject("Mount", "MountPanel")
            self._mountPanel:setRegClass(self)
            self._mountPanel:insertObjectToFactory(self)
            self._mountPanel:setPosition(37, 42)
            self._emptyNode:addChild(self._mountPanel)
        end
        self._mountPanel:refreshView(self._openViewType, show_tab ,curIndex)
    end

    --显示
    if self._mountPanel then
        -- self._mountPanel:setVisible(self._openViewType == Constant.FITER_MOUNT_TYPE.MOUNT)
    end
end

function UIWndMountMain:onUpdate(dt)
    if self._mountPanel then
        self._mountPanel:onUpdate(dt)
    end
end

function UIWndMountMain:uptRedDotEvt(event)
    local param = event.param
    if param.name ~= "MountRedTips" and param.name ~= "HaloRedTips" then
        return
    end
    self:refreshDataUpdatas()
end

function UIWndMountMain:refreshDataUpdatas()
    local len = table.nums(Constant.FITER_MOUNT_TYPE)
    for fiterType = 1, len do
        local red = MountModule:getRedByType(fiterType)
        self._fiterBtns[fiterType]:getChild("red"):setVisible(red)
    end
end

function UIWndMountMain:onLayerClick()
end

function UIWndMountMain:checkGuide()
    --坐骑系统引导
    if self._mountPanel then
        self._mountPanel:checkGuide()
    end
end

return UIWndMountMain
