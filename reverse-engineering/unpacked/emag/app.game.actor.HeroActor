HeroActor._isSelf   = nil

HeroActor._hair        = nil
HeroActor._hairColor   = nil
HeroActor._skinColor   = nil
HeroActor._clothColor  = nil
HeroActor._weaponId    = nil

-- 动作信息
HeroActor._actionInfo       = nil
HeroActor._shadowActor      = nil
HeroActor._actionHairInfo   = nil
HeroActor._actionWeaponInfo = nil
HeroActor._actionShieldInfo = nil
