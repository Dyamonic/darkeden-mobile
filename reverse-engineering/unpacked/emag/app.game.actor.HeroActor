-- 人形npc
function HeroActor:loadNameNode(name)
    if not self._nameNode then
        self._nameNode = display.newNode()
    end
    local ResManager = lt.ResManager
    local NAME_TO_MODEL = 30
    -- local modelMeta = lt.CacheManager:getModelMeta(self._modelId)
    local npcId = self._roleData:getNpcId()
    local npcMeta = lt.CacheManager:queryNpc(npcId)
    --文本
    self._textName = lt.UIManager:createTextNameNodeNpc(npcMeta:getNpcName())
    self._textName:setAnchorPoint(0.5, 0.5)

    --npc 职业标记
    local raceType = lt.GameModule:getHeroRace()
    local resPath = ResManager:getRoleModelTitleTag(raceType)
    local npcTag = display.newSprite(resPath)
    local scale = 0.6
    local npcTagH = npcTag:getContentSize().height * scale
    npcTag:setAnchorPoint(cc.p(0.5, 0.5))
    npcTag:setScale(scale)
    local textBgW = self._textName:getContentSize().width
    if textBgW < 120 then
        textBgW = 120
    end

    --文本框
    local textbg = display.newSprite(ResManager._NPC_Title_Bg, 0, 0,{scale9 = true, size = cc.size(textBgW, npcTagH), capInsets = cc.rect(14, 8, 2, 12)})

    local titleBGY = 80 + textbg:getContentSize().height/2 + NAME_TO_MODEL
    textbg:setPosition(0, titleBGY)
    self._nameNode:addChild(textbg)
    self._textName:setPosition(cc.p(0, titleBGY))
    self._nameNode:addChild(self._textName)

    local npcTagX = - textbg:getContentSize().width/2 - 12.5
    npcTag:setPosition(npcTagX, titleBGY)
    self._nameNode:addChild(npcTag)

    --任务目标箭头ICON
    -- self._targetIcon = display.newSprite("ui/common/icon_cwrw_jiantou.png")
    -- self._targetIcon:setAnchorPoint(cc.p(0.5, 0))
    -- self._targetIcon:setPosition(cc.p(0, titleBGY + 20))
    -- self._targetIcon:setScale(0.6)
    -- self._targetIcon:setVisible(false)
    -- self._nameNode:addChild(self._targetIcon)

    local meta = lt.EffectMeta.new({
        SkillId          = 0,
        OrderId          = 1,
        EffectSpriteType = 2503,
        BltType          = 4,
        Step             = 0.07,
        DelayFrame       = 0,
        Owner            = 0,
        LoopCount        = 1
    })
    self._targetIcon = lt.CompEffectActor.new(meta, 1, true)
    self._targetIcon:setPosition(cc.p(0, titleBGY + 35))
    self._targetIcon:setScale(0.6)
    self._targetIcon:setVisible(false)
    self._nameNode:addChild(self._targetIcon)
end

--更新箭头
function HeroActor:updateTargetArrow(show)
    if not self._targetIcon then
        return
    end
    self._targetIcon:setVisible(show)
end

function HeroActor:clearNpcNameNode()
    self._textName = nil
    self._targetIcon = nil
end


function HeroActor:removeAllQueueEffect()
    if not self._queueEffectActorArr then 
        return
    end
    for i = #self._queueEffectActorArr, 1, -1 do
        local effectActor = self._queueEffectActorArr[i]
        if effectActor then
            effectActor:onClear()
        end
        self._queueEffectActorArr[i] = nil 
    end
    self._queueEffectActorArr = nil

end

function HeroActor:removeAllZorderEffect()
    if not self._zorderEffectActorArr then 
        return
    end
    for i = #self._zorderEffectActorArr, 1, -1 do
        local effectActor = self._zorderEffectActorArr[i]
        if effectActor then
            effectActor:onClear()
        end
        self._zorderEffectActorArr[i] = nil 
    end
    self._zorderEffectActorArr = nil
end

-- 清除某个持续特效
function HeroActor:removeParalEffect(skillId)
    for i, effectActor in ipairs(self._parabEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            effectActor:onClear()
            table.remove(self._parabEffectActorArr, i)
            break
        end
    end
end

function HeroActor:changeRotateEffectDir()
    if type(self._rotateEffectActorArr) ~= "table" then
        return 
    end
    local buff = self:hasBuffer(BuffEnum.EFFECT_CLASS_HALO_SHOW)
    if buff then
        for _,v in ipairs(self._rotateEffectActorArr or {}) do
            --翅膀与尾巴跟随面向调整层级与方向
            if not v:isEndEffect() and v:getSkillId() and SkillEnum.IS_HALO_WINGS_OR_TAIL_SKILL[v:getSkillId()] then
                v:changeDirection(self._direction)
                if self._direction == Constant.DIRECTION_LEFT_DOWN or self._direction == Constant.DIRECTION_DOWN or self._direction == Constant.DIRECTION_RIGHT_DOWN then
                    v:setEffectInfoZorder(1)
                else
                    v:setEffectInfoZorder(3)
                end
            end
        end
    end
end

function HeroActor:playSoleParalSpecail(skillId, metas)
    local effectParallelActor = EffectParallelActor.new(self, skillId, self._direction)
    self._soleEffectNode:addChild(effectParallelActor)
    table.insert(self._parabEffectActorArr, effectParallelActor)
    effectParallelActor:addEffect(skillId, metas)
end


function HeroActor:getOpacitySkillActor()
    return self._opacitySkillActor
end

return HeroActor
