--[[
    *************************** 天炼播放技能特效 ********************************

    注：目前版本只用于英雄测试，后期如使用需要移动至RoleActor
]]
function HeroActor:onUpdateEffect()
    if not self._endEffect then
        return
    end

    -- 死亡对象停止当前所有特效
    if self:isDie() then 
        self:closeLoopEffect()
        return
    end

    if not self._effectInfo or not self._effectInfo:getLoop() then
        return
    end

    -- 默认循环1次
    local loop = self._effectInfo:getLoop()
    local frameCount = self._effectInfo:getSpriteFrameCount()

    if loop ~= -1 and (self._effectLoopCount >= loop or self._nextEffectFrameIndex > frameCount) then
        return
    end

    if self._timeEffectTrigger:tick() then
        self:gotoNextEffectFrame()

        -- 循环数已到,添加循环次数
        if self._nextEffectFrameIndex > frameCount then
            self._nextEffectFrameIndex = 1
            self._effectLoopCount = self._effectLoopCount + 1

            if self:loopEnd(self._effectLoopCount, loop) then
                -- 关闭显示 
                self:closeLoopEffect()
            end
        end
    end
end

-- 循环次数是否结束
function HeroActor:loopEnd(loop, maxLoop)
    if maxLoop ~= -1 and loop >= maxLoop then
        return true
    end

    return false
end

-- override
function HeroActor:gotoNextEffectFrame()
    if self._actionPause then
        return
    end

    self:updateEffectFrame(self._spriteEffect, self._nextEffectFrameIndex, self._effectInfo)
    
    self._nextEffectFrameIndex = self._nextEffectFrameIndex + 1
end

function HeroActor:closeLoopEffect()
    self._spriteEffect:setVisible(false)

    -- 随时清理
    self:endEffect()
end

-- 显示角色特效
function HeroActor:updateEffectFrame(effectSprite, frameIdx, effectInfo)
    effectSprite:setVisible(true)
    
    local frame = effectInfo:getSpriteFrame(frameIdx)
    local bltType = effectInfo:getBltType()
    if frame then
        local sprite = frame.sprite
        if sprite == nil then
            return
        end

        effectSprite:setSpriteFrame(sprite)
        if bltType == lt.Constant.BLT_TYPE.BLT_SCREEN then
            effectSprite:setBlendFunc(({src = ccb.BlendFactor.ONE, dst = ccb.BlendFactor.ONE}))
        end

        -- local fx = frame.x + frame.width/2
        -- local fy = -frame.y - frame.height/2
        local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
        effectSprite:setPosition(pos)
    end
end

-- 加入播放列表  isScreen可从Skill表中获得 bltType=3 FIXME isScreen先走传参
function HeroActor:playEffect(skillId, index, isLoop)
    if self._endEffect then
        yflog:Info("playEffect endeffect is true")
        return
    end

    if skillId == 0 then
        return
    end
    local effectMetas = nil
    if skillId == SkillEnum.SKILL_POISON_STRIKE -- 毒性攻击
    or skillId == SkillEnum.SKILL_GREEN_STALKER -- 毒雾
    then
    
    elseif skillId == SkillEnum.RING_OF_FLARE then
        effectMetas = CacheManager:getSkillEffectBySkillIdAndEName(skillId, "result_skill_ring_of_flare_damage_1")
    else
        effectMetas = CacheManager:getSkillEffectBySkillId(skillId)
    end

    if not effectMetas or table.nums(effectMetas) < 1 then
        yflog:InfoLine("HeroActor:playEffect the skill:%d has no skill effect meta", skillId)
        return
    end

    -- bltType
    local bltType = effectMetas[1]:bltType()
    local effectId =  effectMetas[1]:getEffectId()
    if index and effectMetas[index] then
        bltType = effectMetas[index]:bltType()
        effectId =  effectMetas[index]:getEffectId()
    end
        


    self._effectInfo = EffectManager:getEffectInfo(effectId, self._direction, bltType)

    if isLoop then
        self._effectInfo:setLoop(-1)
    end

    self._timeEffectTrigger:reset(self._effectInfo:getStep())
    self:startEffect()
end

function HeroActor:startEffect(bltType)
    self._effectLoopCount = 0
    self._nextEffectFrameIndex = 1

    self._endEffect = true
end

function HeroActor:endEffect()
    self._endEffect = false
    self._effectInfo = nil
end

function HeroActor:stopEffect()
    self._effectInfo:setLoop(1)
end

-- ********** 延时特效播放方式 ***********
function HeroActor:onUpdateDelayEffect()
    if not self._isEndDelayEffect then
        return
    end

     -- 死亡对象停止当前所有特效
     if self:isDie() then 
        self:closeDelayEffect()
        return
    end

    local infoMap = self._delayEffectInfoMap
    if not infoMap then
        return
    end

    local delayEffectInfo = infoMap[self._delayEffectStep]
    if not delayEffectInfo then
        return
    end

    -- 默认循环1次
    local loop = delayEffectInfo:getLoop()
    local frameCount = delayEffectInfo:getSpriteFrameCount()

    if loop ~= -1 and (self._delayEffectLoopCount >= loop or self._nextDelayEffectFrameIndex > frameCount) then
        self:closeLoopDelayEffect()
        return
    end

    if self._timeDelayTrigger:tick() then
        self:gotoNextDelayEffectFrame(delayEffectInfo)

        -- 循环数已到,添加循环次数
        if self._nextDelayEffectFrameIndex > frameCount then
            self._nextDelayEffectFrameIndex = 1
            self._delayEffectLoopCount = self._delayEffectLoopCount + 1

            if self:loopEnd(self._delayEffectLoopCount, loop) then
                -- 关闭显示 
                self:closeLoopDelayEffect()
            end
        end
    end
end

-- 关闭当前已播放完成的特效，并到队列中找寻下一个特效，如果队列为空了，则停止播放并 endDelayEffect
function HeroActor:closeLoopDelayEffect()
    -- 清除当前播放完的队列
    self:PopQueue(self._delayEffectStepQueue)

    -- 部分技能需要根据技能阶段改变玩家本身颜色
    self:checkDelayEffectColor(self._delayEffectStepQueue)

    if self:IsQueueEmpty(self._delayEffectStepQueue) then
        self._spriteDelayEffect:setVisible(false)
        self:endDelayEffect()
        return
    end

    -- 播放队列不为空时则播放下一条
    self:RefreshDelayEffectStep()
    self:startDelayEffect()
end

function HeroActor:closeDelayEffect()
    self._delayEffectStepQueue = {}

    self._spriteDelayEffect:setVisible(false)
    self:endDelayEffect()
end

-- override
function HeroActor:gotoNextDelayEffectFrame(delayEffectInfo)
    if self._actionPause then
        return
    end

    self:updateDelayEffectFrame(self._spriteDelayEffect, delayEffectInfo, self._nextDelayEffectFrameIndex)
    self._nextDelayEffectFrameIndex = self._nextDelayEffectFrameIndex + 1
end

-- 显示延迟特效
function HeroActor:updateDelayEffectFrame(sprite, effectInfo, nextFrameIndex)
    if not self._isEndDelayEffect then
        return
    end

    sprite:setVisible(true)

    local frame = effectInfo:getSpriteFrame(nextFrameIndex)
    local bltType = effectInfo:getBltType()

    if frame then
        local spriteFrame = frame.sprite
        if spriteFrame == nil then
            return
        end

        sprite:setSpriteFrame(spriteFrame)
        if bltType == lt.Constant.BLT_TYPE.BLT_SCREEN then
            sprite:setBlendFunc(({src = ccb.BlendFactor.ONE, dst = ccb.BlendFactor.ONE}))
        end
        -- local fx = frame.x + frame.width/2
        -- local fy = -frame.y - frame.height/2
        local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
        sprite:setPosition(pos)
    end
end

--[[
    延迟技能需要加载多段，资源提前加载完，再播放
    如:点燃
    [
        start: 554 
        doing: 555 
        end:   556
    ]
]]
function HeroActor:playDelayEffect(skillId, effectSpriteInfos)
    if skillId == SkillEnum.SKILL_SET_AFIRE then
        self._delayEffectInfoMap = EffectManager:getEffectInfos(effectSpriteInfos, self._direction)
        
        local effectSpriteIds = {}
        for _, infos in pairs(effectSpriteInfos) do
            table.insert(effectSpriteIds, infos.spriteId)
        end

        -- 写入播放队列
        self:StartDelayEffectStepQueue(effectSpriteIds)

        self:checkDelayEffectColor(self._delayEffectStepQueue)
    end

    self:startDelayEffect()
end

function HeroActor:addDelayEffect(skillId)
    local delayEffectInfoMap = self._delayEffectInfoMap
    local effectMetas = CacheManager:getSkillEffectBySkillId(skillId)

    if not effectMetas then
        yflog:Info("HeroActor addDelayEffect the skill:%d has no skill effect meta", skillId)
        return
    end

    table.sort(effectMetas, function (a, b)
        return a:getOrder() < b:getOrder()
    end)

    -- 三阶段播放效果 start loop end 
    if skillId == SkillEnum.SKILL_SET_AFIRE then
        if #effectMetas < 3 then
            return
        end
        local spriteInfos = {}
        -- {554, 555, 556}
        for i, meta in ipairs(effectMetas) do
            table.insert(spriteInfos, {spriteId = meta:getSpriteId(), bltType = meta:getBltType()})
        end

        -- 队列为空时，从头播放
        if self:IsQueueEmpty(delayEffectInfoMap) then
            self:playDelayEffect(skillId, spriteInfos)
            return
        end

        -- 队列中无中间段，则重新从头播放
        local effectInfo = delayEffectInfoMap[spriteInfos[2]]
        if effectInfo == nil then
            self:playDelayEffect(skillId, spriteInfos)
            return
        end

        -- 当前播放队列为空 则从头播放
        if self:IsQueueEmpty(self._delayEffectStepQueue) then
            self:playDelayEffect(skillId, spriteInfos)
            return
        end

        -- 如果播放已经到最后消失，则再插入一次，并且中间循环帧loop设置为了1
        local curStep = self._delayEffectStepQueue[1]
        if curStep == spriteInfos[3] then
            effectInfo:setLoop(1)
            self:PushDelayEffectStepQueue(spriteInfos)
        end

        effectInfo:addLoop()
    end
end

-- 起始队列
function  HeroActor:StartDelayEffectStepQueue(queue)
    self._delayEffectStepQueue = queue

    self:RefreshDelayEffectStep()
end

-- 加入队列
function HeroActor:PushDelayEffectStepQueue(queue)
    if not self:IsQueueEmpty(queue) then
        return
    end

    for i, v in ipairs(queue) do
        table.insert(self._delayEffectStepQueue, v)
    end
end

-- check 队列
function HeroActor:RefreshDelayEffectStep()
    if self:IsQueueEmpty(self._delayEffectStepQueue) then
        self:ResetDelayEffectStep()
        return
    end

    self._delayEffectStep =  self._delayEffectStepQueue[1]
end

-- 重置特效步骤
function HeroActor:ResetDelayEffectStep()
    self._delayEffectStep = -1
end

function HeroActor:startDelayEffect(bltType)
    -- 获取当前的actionInfo 
    local effectInfo = self._delayEffectInfoMap[self._delayEffectStep]
    if not effectInfo then
        return
    end

    self._timeDelayTrigger:reset(effectInfo:getStep())

    self._delayEffectLoopCount = 0
    self._nextDelayEffectFrameIndex = 1

    self._isEndDelayEffect = true
end

function HeroActor:endDelayEffect()
    self._isEndDelayEffect = false
    self._delayEffectInfoMap = nil
end

-- 部分技能需要根据技能阶段改变玩家本身颜色
function HeroActor:checkDelayEffectColor(delayEffectStepQueue)
    local color = SkillEnum.EFFECT_PLAYER_DEFAULT_COLOR
    if self:IsQueueEmpty(delayEffectStepQueue) then
        self:setColorAll(color)
        return
    end

    -- effect 特殊改变角色颜色的特效{spriteId(555), color}
    local colorArray = SkillEnum.EFFECT_SET_PLAYER_COLOR

    for _, colorInfo in ipairs(colorArray) do
        if delayEffectStepQueue[1] == colorInfo[1] then
            color = colorInfo[2]
            break
        end
    end

    self:setColorAll(color)
end

-- *************** end ***************

--[[****************** 持续特效 ******************]]
--[[
    正在命中的效果id(毒物，持续效果)特效
    changeRemoveEffectId: 删除身上已有的
    changeAddEffectId: 新增

    服务器控制删除 HeroAgent:updateHitEffect

    effectId与skillId一致
]]
function HeroActor:updateHitEffect(changeRemoveEffectId, changeAddEffectId)
    for i, effectId in ipairs(changeRemoveEffectId) do
        self:removeRunningEffect(effectId)
    end

    for i, effectId in ipairs(changeAddEffectId) do
        self:addRunningEffect(effectId)
    end
end

-- 添加持续特效
function HeroActor:addRunningEffect(skillId)
    local actionInfoMetas = CacheManager:getSkillEffectBySkillId(skillId)
    if not actionInfoMetas or table.nums(actionInfoMetas) < 1 then
        yflog:InfoLine(" HeroActor addRunningEffect the skill:%d has no skill effect meta", skillId)
        return
    end

	for i, meta in ipairs(actionInfoMetas) do
		local effectActor = EffectActor.new(meta, self._direction)
		self._runningEffectNode:addChild(effectActor)
		
		table.insert(self._runningEffectActorArr, effectActor)
	end
end

-- 清除某个持续特效
function HeroActor:removeRunningEffect(skillId)
    for i, effectActor in ipairs(self._runningEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            effectActor:onClear()
            table.remove(self._runningEffectActorArr, i)
            break
        end
    end
end

function HeroActor:onUpdateRunningEffect()
	local runningEffectActorArr = self._runningEffectActorArr 
	if not runningEffectActorArr or #runningEffectActorArr == 0 then
		return
	end

    if self:isDie() then
        local removeEffectIds = {}
        for _, effectActor in pairs(runningEffectActorArr) do
            effectActor:stopEffect()
            table.insert(removeEffectIds, effectActor:getSkillId())
        end

        for i, effectId in ipairs(removeEffectIds) do
            self:removeRunningEffect(effectId)
        end
        return
    end

    local removeTable = {}
	for index, effectActor in pairs(runningEffectActorArr) do
        if effectActor then
            if effectActor:isEndEffect() then
                removeTable[index] = true
            else
                effectActor:onUpdateEffect()
            end
        end
	end

    self:removeEffectFromRemoveTable(runningEffectActorArr, removeTable)
end

-- ****************** 持续特效 end********************

-- ***************** 列表式播放特效 ************************
function HeroActor:playQueueEffect(skillId, owner, skillGrade)
    if not skillGrade then
        skillGrade = 1 
    end
    local effectQueueActor = EffectQueueActor.new(self, skillId, self._direction)
    self._queueEffectNode:addChild(effectQueueActor)

    -- 此处存在2个一样的技能效果 移除时会出问题，存在不及时移除
    table.insert(self._queueEffectActorArr, effectQueueActor)

    if skillId == SkillEnum.SKILL_POISON_STRIKE then
        -- 毒性攻击 最终阶段
        effectQueueActor:addEffectEName(skillId, "result_skill_poison_strike")
    elseif skillId == SkillEnum.SKILL_ACID_HANDS or 
        skillId == SkillEnum.MAGIC_BLOODY_NAIL  or 
        skillId ==  SkillEnum.MAGIC_ACID_BOLT  or
        skillId == SkillEnum.SKILL_HANDS_OF_WISDOM or
        skillId == SkillEnum.SKILL_TRIPLE_BREAK 
        or skillId == SkillEnum.SKILL_DOUBLE_IMPACT  
        or skillId == SkillEnum.SKILL_TRIPLE_SLASHER 
        then 
        -- 酸性之触
        effectQueueActor:addEffectGenerator(skillId, EffectEnum.EFFECTGENERATORID_ATTACH_CREATURE, owner)
    elseif skillId == SkillEnum.SKILL_ACID_STRIKE then
        -- 酸性攻击 最终阶段
        effectQueueActor:addEffectEName(skillId, "result_skill_acid_strike")
    elseif skillId == SkillEnum.SKILL_DARKBLUE_POISON then
        -- 幽暗之毒
        effectQueueActor:setLoopOrder(2) -- 循环的队列顺序
        effectQueueActor:addEffectEName(skillId, "result_magic_darkblue_poison")
    elseif skillId == SkillEnum.SKILL_GREEN_STALKER then
        -- 毒物
        effectQueueActor:setLoopOrder(2) -- 循环的队列顺序
        effectQueueActor:addEffectGenerator(skillId, EffectEnum.EFFECTGENERATORID_ATTACH_CREATURE)
    elseif skillId == SkillEnum.SKILL_MAGIC_PARALYZE then
        -- 麻痹
        effectQueueActor:setLoopOrder(2)
        effectQueueActor:addEffectGenerator(skillId, EffectEnum.EFFECTGENERATORID_ATTACH_CREATURE)

    elseif skillId == SkillEnum.SKILL_MAGIC_SEDUCTION then
        -- 诱惑
        effectQueueActor:setLoopOrder(1)
        effectQueueActor:addEffectGenerator(skillId, EffectEnum.EFFECTGENERATORID_ATTACH_CREATURE)
    elseif skillId == SkillEnum.RING_OF_FLARE then
        effectQueueActor:setLoopOrder(1)
        if not skillGrade then
            skillGrade = 1 
        end
        effectQueueActor:addEffectEName(skillId, "result_skill_ring_of_flare_buff_" .. skillGrade)
    elseif skillId == SkillEnum.SKILL_WATER_BARRIER then
        effectQueueActor:addEffectEName(skillId, "result_skill_water_barrier")
    elseif skillId == SkillEnum.SKILL_VINE then
        effectQueueActor:setLoopOrder(1)
        effectQueueActor:addEffectEName(skillId, "result_skill_tendril")
    
    elseif skillId == SkillEnum.SKILL_HANDS_OF_FIRE then
        -- 火焰之触
        effectQueueActor:setLoopOrder(1)
        effectQueueActor:addEffectEName(skillId, "result_skill_hands_of_fire")
    elseif skillId == SkillEnum.SKILL_GNOMES_WHISPER then
        -- 真实视野
        effectQueueActor:setLoopOrder(1)
        effectQueueActor:addEffectEName(skillId, "result_skill_gnomes_whisper")
    -- elseif skillId == SkillEnum.SKILL_SINGLE_BLOW   -- 精准打击
    --     or skillId == SkillEnum.SKILL_SPIRAL_SLAY   -- 罗旋一击
    --     or skillId == SkillEnum.SKILL_WILD_SMASH    -- 野蛮爆击
    --     or skillId == SkillEnum.SKILL_THUNDER_SPARK -- 雷光闪电
    --     then
    --     local skillToName = SkillEnum.SKILL_TO_NAME_RESULT or {}
    --     if skillToName[skillId] then
    --         effectQueueActor:addEffectEName(skillId, skillToName[skillId])
    --     end
    elseif skillId == SkillEnum.SKILL_HOLY_ARROW            -- 神圣箭矢
        or skillId == SkillEnum.SKILL_CAUSE_LIGHT_WOUNDS    -- 光击术
        or skillId == SkillEnum.SKILL_CURE_LIGHT_WOUNDS     -- 治疗术
        or skillId == SkillEnum.SKILL_CURE_POISON           -- 解毒
        or skillId == SkillEnum.SKILL_REMOVE_CURSE          -- 解除诅咒
        or skillId == SkillEnum.SKILL_PROTECTION_FROM_CURSE -- 诅咒抗力
        or skillId == SkillEnum.SKILL_LIGHT_BALL            -- 光球
        or skillId == SkillEnum.SKILL_AURA_BALL             -- 圣光弹
        then
        if owner == SkillEnum.EFFECT_OWNER.OTHER then
            effectQueueActor:addEffectGenerator(skillId, EffectEnum.EFFECTGENERATORID_ATTACH_CREATURE, owner)
        end
    elseif skillId == SkillEnum.SKILL_ABSORB_SOUL then
        effectQueueActor:addEffectEName(skillId,"skill_absorb_soul") 
    elseif skillId == SkillEnum.SKILL_FLOURISH then
        if not skillGrade then
            skillGrade = 1 
        end
        effectQueueActor:addEffectEName(skillId,"step_skill_flourish_"..skillGrade)

    elseif skillId == SkillEnum.SKILL_SUMMON_SYLPH then
        -- 召唤-精灵
        effectQueueActor:addEffectEName(skillId, "skill_client_advancement_summon_sylph_end")
    elseif skillId == SkillEnum.MAGIC_BLOODY_KNIFE then
        effectQueueActor:addEffectEName(skillId, "result_magic_bloody_knife", owner)
    else
        effectQueueActor:addEffectGenerator(skillId, 0) 
    end
end

function HeroActor:playQueueEffectByLv(skillId, skillLevel, effectName)
    HeroAndMonsterEffect:playQueueEffectByLv(self, skillId, skillLevel, effectName)
end



-- 主要是停止循环播放的队列
function HeroActor:stopQueueEffect(skillId)
    for i, effectActor in ipairs(self._queueEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            effectActor:stopQueueEffect()
        end
    end
end

-- 清除某个持续特效
function HeroActor:removeQueueEffect(skillId)
    for i, effectActor in ipairs(self._queueEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            effectActor:onClear()
            table.remove(self._queueEffectActorArr, i)
            break
        end
    end
end

function HeroActor:onUpdateQueueEffect()
	local queueEffectActorArr = self._queueEffectActorArr 
	if not queueEffectActorArr or #queueEffectActorArr == 0 then
		return
	end
    local removeTable = {}
	for index, effectActor in ipairs(queueEffectActorArr) do
        if effectActor:isEndEffect() then
            removeTable[index] = true
        else
		    effectActor:onUpdate()
        end
	end
    self:removeEffectFromRemoveTable(queueEffectActorArr, removeTable)
end
-- ***************** 列表特效 end ************************

-- 野蛮冲撞、突斩
function HeroActor:showRushSprite()
    local xStep = 0
    local yStep = 0
    local isShadowUp = true

    if self._direction == Constant.DIRECTION_UP then
        yStep = -10
    elseif self._direction == Constant.DIRECTION_RIGHT_UP then
        xStep = -5
        yStep = -5
    elseif self._direction == Constant.DIRECTION_RIGHT then
        xStep = -10
    elseif self._direction == Constant.DIRECTION_RIGHT_DOWN then
        xStep = -5
        yStep = 5
        isShadowUp = false
    elseif self._direction == Constant.DIRECTION_DOWN then
        yStep = 10
        isShadowUp = false
    elseif self._direction == Constant.DIRECTION_LEFT_DOWN then
        xStep = 5
        yStep = 5
        isShadowUp = false
    elseif self._direction == Constant.DIRECTION_LEFT then
        xStep = 10
    elseif self._direction == Constant.DIRECTION_LEFT_UP then
        xStep = 5
        yStep = -5
    end

    -- 急行幻影效果
    if isShadowUp then
        for i = 1, 4 do
            local heroActor = lt.HeroActor.new(self._roleData, self._direction)
            heroActor:playAction(Constant.ACTION_RUSH)
            heroActor:setPosition(i * xStep * 3, i * yStep * 3)
            heroActor:setAlpha(0.5)
            heroActor:setLocalZOrder(5)
            self:addChild(heroActor)

            self._rushSpriteArray[#self._rushSpriteArray + 1] = heroActor
        end
    else
        for i = 4, 1, -1 do
            local heroActor = lt.HeroActor.new(self._roleData, self._direction)
            heroActor:playAction(Constant.ACTION_RUSH)
            heroActor:setPosition(i * xStep * 3, i * yStep * 3)
            heroActor:setAlpha(0.5)
            heroActor:setLocalZOrder(0)
            self:addChild(heroActor)

            self._rushSpriteArray[#self._rushSpriteArray + 1] = heroActor
        end
    end
end
 
function HeroActor:playHandEffect(skillId)
    self:removeHandEffect(skillId)
    if skillId == SkillEnum.SKILL_ACTIVATION then
        local effectName = lt.SkillDao:getEffectNameByActionId(skillId, self:getActionId())
        local effectMetas = CacheManager:getSkillEffectBySkillIdAndEName(skillId, effectName)
        for index, meta in ipairs(effectMetas) do
            local direction = self._direction
            if effectName == "result_skill_activation" then
                direction = SkillEnum.EXTREME_DIR[direction][index]
            end
            local effectActor = EffectActor.new(meta, self._direction)
            if self._handsNode[index]:getChildrenCount() == 0 then
                self._handsNode[index]:addChild(effectActor)
            end
            effectActor:setLoop(-1)
            self._handEffectActors[index] = effectActor
        end
    end
end

----------------------------------------------------------------------
-- 绑定动画
function HeroActor:playChargingEffect() -- 能量补充
    if not self._actionId then
       return 
    end
    local sex = 0
    if self._roleData then
        sex = self._roleData:getSex()
    end

    local chargingTable = Constant.ACTION2CHARGINGMALE
    if sex == 1 then
        chargingTable = Constant.ACTION2CHARGINGFEMALE
    end
    
    self:removeBindingEffect(SkillEnum.SKILL_CHARGING_POWER)
    
    local buffMetas = CacheManager:getBuffMetas(SkillEnum.SKILL_CHARGING_POWER,1)
    local index = Constant.CHARGING2INDEX[chargingTable[self._actionId] or 1] or 1
    for _,v in ipairs(buffMetas) do
        v:setEffectId(v:getOriginalSpriteId() + (index-1)*5)
        local effectActor = EffectActor.new(v, self._direction,  nil, true)
        effectActor:setPosition(-25, 15)
        self:addChild(effectActor,3)

        table.insert(self._bingdingEffectArr, effectActor)
    end
end

function HeroActor:playBuffSummonSylphEffect()
    local summonSylphId = self._roleData:getSummonSylphId()
    if summonSylphId == Constant.OUTSET_MOUNTID.FAIRY then
        self:playFairyEffect()
    elseif summonSylphId == Constant.OUTSET_MOUNTID.PEGASUS then
        self:playPegasusEffect()
    end
end

 -- 蝴蝶
function HeroActor:playFairyEffect()
    if not self._actionId then
       return 
    end
    if self._actionId ~= Constant.ACTION_OUSTERS_FAIRY_MOVE_STAND and  
        self._actionId ~= Constant.ACTION_OUSTERS_FAIRY_MOVE_MOVE then
        return
    end
    self:removeBindingEffect(SkillEnum.SKILL_SUMMON_FAIRY)
    local buffMetas = CacheManager:getBuffMetas(SkillEnum.SKILL_SUMMON_FAIRY, 0)
    local actionInfoMetas = {buffMetas[1]}
    if self._actionId == Constant.ACTION_OUSTERS_FAIRY_MOVE_MOVE then
        actionInfoMetas = {buffMetas[2] }
    end
    for _,v in ipairs(actionInfoMetas) do
        local effectActor = EffectActor.new(v, self._direction,  nil, true)
        effectActor:setPosition(-25, 15)
        self:addChild(effectActor,3)
        table.insert(self._bingdingEffectArr, effectActor)
    end
end

-- 独角兽
function HeroActor:playPegasusEffect()
    if not self._actionId then
       return 
    end
    if self._actionId ~= Constant.ACTION_OUSTERS_PEGASUS_MOVE_STAND and  
        self._actionId ~= Constant.ACTION_OUSTERS_PEGASUS_MOVE_MOVE then
        return
    end
    self:removeBindingEffect(SkillEnum.SKILL_SUMMON_PEGASUS)
    local buffMetas = CacheManager:getBuffMetas(SkillEnum.SKILL_SUMMON_PEGASUS, 0)
    local actionInfoMetas = {buffMetas[1]}
    if self._actionId == Constant.ACTION_OUSTERS_PEGASUS_MOVE_MOVE then
        actionInfoMetas = {buffMetas[2] }
    end
    for _,v in ipairs(actionInfoMetas) do
        local effectActor = EffectActor.new(v, self._direction,  nil, true)
        effectActor:setPosition(-25, 15)
        self:addChild(effectActor,3)
        table.insert(self._bingdingEffectArr, effectActor)
    end
end

function HeroActor:playBeserkerEffect(skillId)
    if not self._actionId then
       return 
    end
    local effectTypeTable
    if self._sexType == Constant.SexType.MALE then
        effectTypeTable = EffectEnum.ACTION_BERSERKER_MALE
    elseif self._sexType == Constant.SexType.FEMALE then
        effectTypeTable = EffectEnum.ACTION_BERSERKER_FEMALE
    else
        return 
    end
    self:removeBindingEffect(skillId)

    local effectID = effectTypeTable[self._actionId + 1]
    if effectID then
        local berserkerPairList = CacheManager:getBerserkerPairList(effectID)
        local buffMetas = CacheManager:getBuffMetas(skillId)
        for index, meta in ipairs(buffMetas) do
            meta:setEffectId(berserkerPairList[index])
            local effectActor = EffectActor.new(meta, self._direction,  nil, true)
            effectActor:setPosition(-25, 15)
            self:addChild(effectActor,3)
            table.insert(self._bingdingEffectArr, effectActor)
        end
    end
end

function HeroActor:playExtremeEffect(skillId)
    if not self._actionId then
       return 
    end
    local effectTypeTable
    if self._sexType == Constant.SexType.MALE then
        effectTypeTable = EffectEnum.ACTION_EXTREME_MALE
    elseif self._sexType == Constant.SexType.FEMALE then
        effectTypeTable = EffectEnum.ACTION_EXTREME_FEMALE
    else
        return 
    end
    self:removeBindingEffect(skillId)

    local effectID = effectTypeTable[self._actionId + 1]
    if effectID and effectID ~= EffectEnum.EFFECTSPRITETYPE_NULL then
        local extremePairList = CacheManager:getExtremePairList(effectID)
        local buffMetas = CacheManager:getBuffMetas(skillId)
        for index, meta in ipairs(buffMetas) do
            local effectTypeID = extremePairList[index]
            if effectTypeID and effectTypeID ~= EffectEnum.EFFECTSPRITETYPE_NULL then
                meta:setEffectId(effectTypeID)
                local effectActor = EffectActor.new(meta, self._direction, nil, true)
                self._darkRevengeNode:addChild(effectActor,3)
                table.insert(self._bingdingEffectArr, effectActor)
            end
        end
    end
end

function HeroActor:setHideDarkRevengeNode(isHide)
    self._darkRevengeNode:setVisible(not isHide)
end

-- 激发特效
function HeroActor:playRediance()
    if not self._actionId then
        return 
    end
    self._syncWeaponFrameOffset = 0
    self:removeBindingEffect(SkillEnum.SKILL_REDIANCE)
    local curSpriteId = nil
    for spriteId, actionTable in pairs(SkillEnum.SKILL_REDIANCE_EFFECT) do
       if table.indexof(actionTable, self._actionId) then
            curSpriteId = spriteId
       end
    end


    if not curSpriteId then return end
    local buffMetas = CacheManager:getBuffMetas(SkillEnum.SKILL_REDIANCE, 1)
    local sex = Constant.SexType.MALE
    if self._roleData then
        sex = self._roleData:getSex()
    end
  
    local attachMeta = buffMetas[1]
    local spriteId = sex == Constant.SexType.MALE and curSpriteId or curSpriteId + 3
    local isSpecial = spriteId > 710
    if sex == Constant.SexType.FEMALE and isSpecial then
        self._syncWeaponFrameOffset = 2
    end
    attachMeta:setEffectId(spriteId)
    local effectActor = EffectActor.new(attachMeta, self._direction,  nil, true)
    effectActor:setPosition(-25, 15)
    self:addChild(effectActor,3)
    table.insert(self._bingdingEffectArr, effectActor)
end

function HeroActor:playBindingEffectByLv(skillId, skillLevel, effectName, param)
    local metas = {}
    if effectName == Constant.EFFECT.PROCESS then
        metas = CacheManager:getProcessMetas(skillId,skillLevel)
    elseif effectName == Constant.EFFECT.ACTION then
        metas = CacheManager:getActionMetas(skillId,skillLevel)
    end

    if skillId == SkillEnum.MAGIC_BLOODY_NAIL
    or skillId == SkillEnum.SKILL_ACID_HANDS
    or skillId == SkillEnum.SKILL_BLAZE_WALK
    or skillId == SkillEnum.SKILL_BLITZ_SLIDING then
        local sex = 0
        if self._roleData then
            sex = self._roleData:getSex()
        end
        local tempMetas = {}
        table.insert(tempMetas,metas[sex+1])
        metas = tempMetas or {}
    end

    if skillId == SkillEnum.SKILL_DISTANCE_BLITZ then
        --509=2格、510=3格、511=4格、512=5格、513=6格
        local distance = param.distance
        local index = distance - 1
        local meta = metas[index] and metas[index] or metas[1]
        local tempMetas = {}
        table.insert(tempMetas,meta)
        metas = tempMetas or {}
    end

    for _,v in ipairs(metas) do
        local effectActor = EffectActor.new(v, self._direction, nil, false)
        effectActor:setPosition(-25, 15)
        self:addChild(effectActor,3)

        table.insert(self._bingdingEffectArr, effectActor)
    end
end

function HeroActor:playBindingEffectNext()
    if type(self._bingdingEffectArr) ~= "table" then
       return 
    end

    local removeTable = {}
    for k,v in ipairs(self._bingdingEffectArr) do
        if (v:getLoop() ~= -1) and (self._nextFrameIndex < v:getNextEffectFrameIndex()) then
            v:endEffect()
        end
        if not v:isEndEffect() then
            v:setNextEffectFrameIndex(self._nextFrameIndex + self._syncWeaponFrameOffset)
            v:setLocalZOrder(v:getEffectInfoZorder() or 3)
        else
            removeTable[k] = true
        end
    end

    self:removeEffectFromRemoveTable(self._bingdingEffectArr, removeTable)
end

function HeroActor:removeBindingEffect(skillId)
    if type(self._bingdingEffectArr) ~= "table" then
        return 
    end

    for i = #self._bingdingEffectArr, 1, -1 do
        local effectActor = self._bingdingEffectArr[i]
        if skillId == effectActor:getSkillId() then
            effectActor:onClear()
            -- effectActor:removeFromParent()
            table.remove(self._bingdingEffectArr, i)
        end
    end
end

function HeroActor:changeBindingEffectDir()
    if type(self._bingdingEffectArr) ~= "table" then
        return 
    end

    for _,v in ipairs(self._bingdingEffectArr or {}) do
        if not v:isEndEffect() then
            v:changeDirection(self._direction)
        end
    end
end

----------------------------------------------------------------------

-- TODO 验证是否是所有action入口
function HeroActor:playAction(actionId)
    -- actionId = ActionManager:getAdvancedActorAction(self._raceType, true, actionId)
    -- yflog:Info("---------------------actionId=%s.._preActionId=%s",actionId,self._preActionId)
    HeroActor.super.playAction(self, actionId)
    if self._preActionId == actionId then
        return
    end

    if self:hasBuffer(BuffEnum.EFFECT_CHARGING_POWER) then -- 能量补充
        self:playChargingEffect()
    end
    if self:hasBuffer(BuffEnum.EFFECT_CLASS_REDIANCE) then
        self:playRediance()
    end
    if self:hasBuffer(BuffEnum.EFFECT_CLASS_DARK_REVENGE) then
        self:playHandEffect(SkillEnum.SKILL_EXTREME)

    end
    if self:hasBuffer(BuffEnum.EFFECT_CLASS_BERSERKER) then
        self:playBeserkerEffect(SkillEnum.SKILL_BERSERKER)
    end

    if self:hasBuffer(BuffEnum.EFFECT_CLASS_ACTIVATION) then
        self:playHandEffect(SkillEnum.SKILL_ACTIVATION)
    end

    if self:hasBuffer(BuffEnum.EFFECT_SUMMON_SYLPH) then
        self:playBuffSummonSylphEffect()
    end

    self._preActionId = actionId
end

function HeroActor:playUIAction(actionId)
    HeroActor.super.playUIAction(self, actionId)
end

function HeroActor:stopHandAction(skillId)
    for i, effectActor in ipairs(self._handEffectActors) do
        if skillId == effectActor:getSkillId() then
            effectActor:setLoop(1)
        end
    end
end

function HeroActor:onUpdataHandEffect()
    local isTransforming = false
    if (self._agent and self._agent:getTransformId() > 0) or self._roleData:isSkillHide() then
        isTransforming = true
    end
    
    local removeTable = {}
    if self._handEffectActors and #self._handEffectActors > 0 then
        for orderId, effectActor in pairs(self._handEffectActors) do
            if effectActor and not tolua.isnull(effectActor) then
                if effectActor:isEndEffect() then
                    removeTable[orderId] = true
                else
                    effectActor:setVisible(not isTransforming)
                    effectActor:onUpdateEffect()
                end
            end
        end
    end
    self:removeEffectFromRemoveTable(self._handEffectActors, removeTable)

end

-- 移除手技能特效
function HeroActor:removeHandEffect(skillId)
    for i = #self._handEffectActors, 1, -1 do
        local effectActor = self._handEffectActors[i]
        if skillId == effectActor:getSkillId() then
            effectActor:onClear()
            table.remove(self._handEffectActors, i)
        end
    end
end


-- -- ***************** 并列式播放特效 ************************
function HeroActor:playParallelEffect(skillId, owner, skillGrade)
    local effectParabolaActor = EffectParallelActor.new(self, skillId, self._direction)
    self._queueEffectNode:addChild(effectParabolaActor)

    table.insert(self._parabEffectActorArr, effectParabolaActor)
    if skillId == SkillEnum.MAGIC_ACID_BOLT 
        or skillId == SkillEnum.MAGIC_ACID_BALL
        then
    elseif skillId == SkillEnum.SKILL_MAGIC_DOOM  then
        -- 毁灭
        effectParabolaActor:setLoopOrder(1)
        effectParabolaActor:addEffectGenerator(skillId, EffectEnum.EFFECTGENERATORID_ATTACH_CREATURE)
    elseif skillId == SkillEnum.SKILL_CASTING_FIRE
        or  skillId == SkillEnum.RING_OF_FLARE
        or skillId == SkillEnum.SKILL_HANDS_OF_FIRE then
        effectParabolaActor:addEffectEName(skillId, "casting_fire")
    elseif skillId == SkillEnum.SKILL_ICE_FIELD
        or skillId == SkillEnum.SKILL_WATER_BARRIER 
        then
        effectParabolaActor:addEffectEName(skillId, "casting_water")
    elseif skillId == SkillEnum.SKILL_VINE 
        or skillId == SkillEnum.STONE_AUGER
        or skillId == SkillEnum.SKILL_GNOMES_WHISPER
        then
        if skillId == SkillEnum.SKILL_VINE  and owner ==  SkillEnum.EFFECT_OWNER.OTHER then
            effectParabolaActor:addEffectEName(skillId, "result_skill_tendril_single")
        else
            effectParabolaActor:addEffectEName(skillId, "casting_ground")
        end
        
    elseif skillId == SkillEnum.SKILL_HIDE then
        -- 隐蔽
        effectParabolaActor:addEffectEName(skillId, "result_magic_hide")
    elseif skillId == SkillEnum.SKILL_KASAS_ARROW then
        effectParabolaActor:addEffectGeneratorByIndex(skillId, EffectEnum.EFFECTGENERATORID_ATTACH_CREATURE, owner)
    elseif skillId == SkillEnum.SKILL_SINGLE_BLOW   -- 精准打击
        or skillId == SkillEnum.SKILL_SPIRAL_SLAY   -- 罗旋一击
        or skillId == SkillEnum.SKILL_WILD_SMASH    -- 野蛮爆击
        or skillId == SkillEnum.SKILL_THUNDER_SPARK -- 雷光闪电
        then
        local skillToName = SkillEnum.SKILL_TO_NAME_ATK or {}
        if skillToName[skillId] then
            -- local directionArr = lt.CommonFunc:randomArray(Constant.DIRECTION_LEFT, Constant.DIRECTION_LEFT_UP, 1)
            -- effectParabolaActor:setEffectDirection(directionArr)
            effectParabolaActor:addEffectEName(skillId, skillToName[skillId])
        end
    elseif skillId == SkillEnum.SKILL_BLESS then
        if owner == SkillEnum.EFFECT_OWNER.SELF then
            effectParabolaActor:addEffectEName(skillId, "magic_bless")
        elseif owner == SkillEnum.EFFECT_OWNER.OTHER then
            effectParabolaActor:setLoopOrder(2)
            effectParabolaActor:addEffectGenerator(skillId, EffectEnum.EFFECTGENERATORID_ATTACH_CREATURE, owner)
        end
    elseif skillId == SkillEnum.SKILL_PROTECTION_FROM_POISON then
        -- 毒液抵抗
        effectParabolaActor:addEffectEName(skillId, "result_magic_protection_from_poison")
    elseif skillId == SkillEnum.SKILL_SLAYER_FLARE then
        if owner == SkillEnum.EFFECT_OWNER.OTHER then
            effectParabolaActor:addEffectEName(skillId, "result_magic_flare_damage",owner)
        elseif owner == SkillEnum.EFFECT_OWNER.SELF then
            effectParabolaActor:addEffectEName(skillId, "magic_continual_light",owner)
        end
    elseif skillId == SkillEnum.SKILL_PROTECTION_FROM_CURSE then
        -- 诅咒抗力
        effectParabolaActor:addEffectEName(skillId, "result_magic_protection_from_curse")
    elseif skillId == SkillEnum.SKILL_SUMMON_SYLPH then
        -- 召唤-精灵
        effectParabolaActor:setLoopOrder(2)
        effectParabolaActor:addEffectEName(skillId, "skill_client_advancement_summon_sylph")
    elseif skillId == SkillEnum.SKILL_EMISSION_WATER then
        -- 液体喷发
        if owner == SkillEnum.EFFECT_OWNER.SELF then
            effectParabolaActor:addEffectEName(skillId, "skill_emission_water_" .. skillGrade)
        elseif owner == SkillEnum.EFFECT_OWNER.OTHER then
            effectParabolaActor:addEffectEName(skillId, "result_skill_emission_water_" .. skillGrade)
        end
    elseif skillId == SkillEnum.SKILL_BEAT_HEAD then
        -- 致命打击
        if owner == SkillEnum.EFFECT_OWNER.SELF then
            effectParabolaActor:addEffectEName(skillId, "casting_ground")
        elseif owner == SkillEnum.EFFECT_OWNER.OTHER then
            effectParabolaActor:addEffectEName(skillId, "result_skill_beat_head_" .. skillGrade)
        end
    elseif skillId == SkillEnum.SKILL_EVADE     -- 回避术
        or skillId == SkillEnum.SKILL_BLUNTING  -- 防御崩坏
        then
            effectParabolaActor:addEffectGenerator(skillId, EffectEnum.EFFECTGENERATORID_ATTACH_CREATURE)
    elseif skillId == SkillEnum.SKILL_SHARP_ROUND then
        if not skillGrade then
            skillGrade = 1 
        end
        effectParabolaActor:addEffectEName(skillId,"result_skill_sharp_round_"..skillGrade, owner)
    else
        effectParabolaActor:addEffectGenerator(skillId, 0) 
    end
end

function HeroActor:playParallelEffectByLv(skillId, skillLevel, effectName, fromObjId)
    HeroAndMonsterEffect:playParallelEffectByLv(self,skillId, skillLevel, effectName, fromObjId)
end

function HeroActor:playParallelEffectSpecial(skillId, metas)
    local effectParabolaActor = EffectParallelActor.new(self, skillId, self._direction)
    self._queueEffectNode:addChild(effectParabolaActor)
    table.insert(self._parabEffectActorArr, effectParabolaActor)

    effectParabolaActor:addEffect(skillId, metas)
end

function HeroActor:playQueueEffectSpecial(skillId, metas)
    local effectQueueActor = EffectQueueActor.new(self, skillId, self._direction)
    self._queueEffectNode:addChild(effectQueueActor)
    table.insert(self._queueEffectActorArr, effectQueueActor)
    effectQueueActor:addEffect(skillId, metas)
end
function HeroActor:playSoleQueueSpecail(skillId, metas)
    local effectQueueActor = EffectQueueActor.new(self, skillId, self._direction)
    self._soleEffectNode:addChild(effectQueueActor)
    table.insert(self._queueEffectActorArr, effectQueueActor)
    effectQueueActor:addEffect(skillId, metas)
end

-- 主要是停止循环播放的队列
function HeroActor:stopParallelEffect(skillId)
    for i, effectActor in ipairs(self._parabEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            effectActor:stopParallelEffect()
        end
    end
end

--清掉所有持续特效
function HeroActor:removeAllParalEffect()
    if self._parabEffectActorArr then
        for i = #self._parabEffectActorArr, 1, -1 do
            if self._parabEffectActorArr[i].onClear then
                self._parabEffectActorArr[i]:onClear()
            end
            table.remove(self._parabEffectActorArr, i)
        end
    end
    self._parabEffectActorArr = nil

    if self._bingdingEffectArr then
        for k = #self._bingdingEffectArr, 1, -1 do
            if self._bingdingEffectArr[k].onClear then
                self._bingdingEffectArr[k]:onClear()
            end
            table.remove(self._bingdingEffectArr,k)
        end
    end
    self._bingdingEffectArr = nil
end

function HeroActor:removeAllRotateEffect()
    if self._rotateEffectActorArr then
        for j = #self._rotateEffectActorArr, 1, -1 do
            if self._rotateEffectActorArr[j].onClear then
                self._rotateEffectActorArr[j]:onClear()
            end
            table.remove(self._rotateEffectActorArr,j)
        end
    end
    self._rotateEffectActorArr = nil
end

function HeroActor:onUpdateParalEffect()
	local parabEffectActorArr = self._parabEffectActorArr 
	if not parabEffectActorArr or #parabEffectActorArr == 0 then
		return
	end

    local removeTable = {}
	for index, parabEffectActor in pairs(parabEffectActorArr) do
        if parabEffectActor:isCloseEffect() then
            removeTable[index] = true
        else
            parabEffectActor:onUpdate()
        end
	end

    self:removeEffectFromRemoveTable(parabEffectActorArr, removeTable)
end

-- *****************  并列式特效 end ************************

-- ***************** 可改变层级特效 ************************
-- 目前只有 快速恢复 添加到此节点
-- buff移除时会调用 removeZorderEffect
function HeroActor:playZorderEffect(skillId, isLoop)
    local actionInfoMetas = nil
    if skillId == SkillEnum.SKILL_SUMMON_SYLPH then
        -- 召唤-精灵 转职前
        actionInfoMetas = CacheManager:getSkillEffectBySkillIdAndEName(skillId, "skill_client_summon_sylph_prohibit")
    else
        actionInfoMetas = CacheManager:getSkillEffectBySkillId(skillId)
    end

    if not actionInfoMetas or table.nums(actionInfoMetas) < 1 then
        yflog:InfoLine(" HeroActor playZorderEffect the skill:%d has no skill effect meta", skillId)
        return
    end

    if skillId == SkillEnum.SKILL_HEART_CATALYST then
        -- 快速恢复初始化层级
        self:updateZorderEffectZorder()
    end
    
	for i, meta in ipairs(actionInfoMetas) do
		local effectActor = EffectActor.new(meta, self._direction,  nil, isLoop)
		self._zorderEffectNode:addChild(effectActor)
		
		table.insert(self._zorderEffectActorArr, effectActor)
	end
end

function HeroActor:removeZorderEffect(skillId)
    for i, effectActor in ipairs(self._zorderEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            effectActor:onClear()
            table.remove(self._zorderEffectActorArr, i)
            break
        end
    end
end

function HeroActor:getZorderEffect(skillId)
    for i, effectActor in ipairs(self._zorderEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            return effectActor
        end
    end
end

function HeroActor:onUpdateZorderEffect()
	local zorderEffectActorArr = self._zorderEffectActorArr
	if not zorderEffectActorArr or #zorderEffectActorArr == 0 then
		return
	end

    local removeTable = {}
	for i, effectActor in ipairs(zorderEffectActorArr) do
		if effectActor:isEndEffect() then
            removeTable[i] = true
        else
		    effectActor:onUpdateEffect()
        end
	end

    self:removeEffectFromRemoveTable(zorderEffectActorArr, removeTable)
end
-- ***************** 可改变层级特效 end ************************


-- ***************** 脚底特效特效 ************************
-- isLoop 为true 循环特效，要在对应逻辑里面移除 如buff，在删除buff的时候要移除特效 removeSoleEffect
-- isLoop 为false，只播放一次特效，播放完每次update会删除一个停止的特效
function HeroActor:playSoleEffect(skillId, owner, isLoop)
    local actionInfoMetas = nil
    if skillId == SkillEnum.SKILL_HOLY_ARROW             -- 神圣箭矢
    or skillId == SkillEnum.SKILL_PROTECTION_FROM_POISON -- 毒液抵抗
    or skillId == SkillEnum.SKILL_CAUSE_LIGHT_WOUNDS     -- 光击术
    or skillId == SkillEnum.SKILL_CURE_LIGHT_WOUNDS      -- 治疗术
    or skillId == SkillEnum.SKILL_CURE_POISON            -- 解毒
    or skillId == SkillEnum.SKILL_REMOVE_CURSE           -- 解除诅咒
    or skillId == SkillEnum.SKILL_PROTECTION_FROM_CURSE  -- 诅咒抗力
    or skillId == SkillEnum.SKILL_LIGHT_BALL             -- 光球
    or skillId == SkillEnum.SKILL_AURA_BALL              -- 圣光弹
    then
        if owner == SkillEnum.EFFECT_OWNER.SELF then
            actionInfoMetas = CacheManager:getSkillEffectBySkillIdAndGenerator(skillId, EffectEnum.EFFECTGENERATORID_ATTACH_ZONE, owner)
        elseif owner == SkillEnum.EFFECT_OWNER.OTHER then
            if skillId == SkillEnum.SKILL_PROTECTION_FROM_POISON then
                actionInfoMetas = CacheManager:getSkillEffectBySkillIdAndEName(skillId, "result_magic_protection_from_poison_loop")
            elseif skillId == SkillEnum.SKILL_PROTECTION_FROM_CURSE then
                actionInfoMetas = CacheManager:getSkillEffectBySkillIdAndEName(skillId, "result_magic_protection_from_curse_loop")
            end
        end
    elseif skillId == SkillEnum.SKILL_DETECT_HIDDEN then
        -- 探测术
        if owner == SkillEnum.EFFECT_OWNER.SELF then
            actionInfoMetas = CacheManager:getSkillEffectBySkillIdAndEName(skillId, "magic_light")
        elseif owner == SkillEnum.EFFECT_OWNER.OTHER then
            actionInfoMetas = CacheManager:getSkillEffectBySkillIdAndEName(skillId, "result_result_magic_detect_hidden")
        end
    elseif skillId == SkillEnum.SKILL_CURE_SERIOUS_WOUNDS then
        -- 伤害治疗术
        actionInfoMetas = CacheManager:getSkillEffectBySkillIdAndEName(skillId, "magic_cure_serious_wounds")
    else
        actionInfoMetas = CacheManager:getSkillEffectBySkillId(skillId)
    end

    if not actionInfoMetas or table.nums(actionInfoMetas) < 1 then
        yflog:InfoLine(" HeroActor playSoleEffect the skill:%d has no skill effect meta", skillId)
        return
    end

	for i, meta in ipairs(actionInfoMetas) do
		local effectActor = EffectActor.new(meta, self._direction,  nil, isLoop)
		self._soleEffectNode:addChild(effectActor)
		
		table.insert(self._soleEffectActorArr, effectActor)
	end
end

function HeroActor:playSoleEffectByMetas(metas)
    if not metas or table.nums(metas) < 1 then
        yflog:InfoLine(" HeroActor playSoleEffectByMetas metas is empty")
        return
    end

	for i, meta in ipairs(metas) do
		local effectActor = EffectActor.new(meta, self._direction,  nil, false)
		self._soleEffectNode:addChild(effectActor)
		
		table.insert(self._soleEffectActorArr, effectActor)
	end
end

function HeroActor:playSoleParallelEffectByMetas(metas)
    if not metas or table.nums(metas) < 1 then
        yflog:InfoLine(" HeroActor playSoleParallelEffectByMetas metas is empty")
        return
    end

	for i, meta in ipairs(metas) do
		local effectActor = EffectActor.new(meta, self._direction,  nil, false)
		self._soleEffectNode:addChild(effectActor)
		
		table.insert(self._soleEffectActorArr, effectActor)
	end
end

function HeroActor:removeSoleEffect(skillId, isLoop)
    for i, effectActor in ipairs(self._soleEffectActorArr) do
        if skillId == effectActor:getSkillId() and effectActor._isloop == isLoop then
            effectActor:onClear()
            table.remove(self._soleEffectActorArr, i)
            break
        end
    end
end

-- 检查特效是否存在
function HeroActor:checkSoleEffect(skillId)
    for i, effectActor in ipairs(self._soleEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            return true
        end
    end

    return false
end

function HeroActor:onUpdateSoleEffect()
	local soleEffectActorArr = self._soleEffectActorArr
	if not soleEffectActorArr or #soleEffectActorArr == 0 then
		return
	end

    local removeTable = {}
	for i, effectActor in pairs(soleEffectActorArr) do
        if effectActor:isEndEffect() then
            removeTable[i] = true
        else
		    effectActor:onUpdateEffect()
        end
	end
    self:removeEffectFromRemoveTable(soleEffectActorArr, removeTable)

end
-- ***************** 脚底特效特效 end ************************

-- ***************** 旋转改变层级特效 start ************************
function HeroActor:playRotateEffect(metas,skillId)
    HeroAndMonsterEffect:playRotateEffect(self, metas, skillId,self._offsetHeight)
end

function HeroActor:addRotateEffect(effectActor)
    table.insert(self._rotateEffectActorArr, effectActor)
end

function HeroActor:playRotateEffectQueue(metas,skillId)
    if not metas or table.nums(metas) < 1 then
        yflog:InfoLine(" HeroActor playRotateEffectQueue metas is empty")
        return
    end
    
    local offsetX, offsetY = -25, 15
    local effectQueueActor = EffectQueueActor.new(self, skillId, self._direction)
    effectQueueActor:setPosition(offsetX, offsetY)
    self:addChild(effectQueueActor)

    table.insert(self._rotateEffectActorArr, effectQueueActor)

    effectQueueActor:addEffect(skillId, metas)
end

function HeroActor:onUpdateRotateEffect()
    local rotateEffectActorArr = self._rotateEffectActorArr
	if not rotateEffectActorArr or #rotateEffectActorArr == 0 then
		return
	end

    local removeTable = {}
    for i, rotateEffectActor in ipairs(rotateEffectActorArr) do
        if rotateEffectActor:isEndEffect() then
            removeTable[i] = true
        else
            rotateEffectActor:onUpdate()
            rotateEffectActor:setLocalZOrder(rotateEffectActor:getEffectInfoZorder() or 3)
        end
	end
    self:removeEffectFromRemoveTable(rotateEffectActorArr, removeTable)
end


function HeroActor:removeRotateEffectByIndex(index)
    if #self._rotateEffectActorArr < index or #self._rotateEffectActorArr == 0 then
        return
    end

    if index and self._rotateEffectActorArr[index] then
        self._rotateEffectActorArr[index]:onClear()
        table.remove(self._rotateEffectActorArr, index)
    end
end

function HeroActor:removeRotateEffect(skillId)
    for i, effectActor in ipairs(self._rotateEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            if effectActor.stopEffect then
                effectActor:stopEffect()
            end

            if effectActor.stopQueueEffect then
                effectActor:stopQueueEffect()
            end
        end
    end
end

function HeroActor:setRotateEffectVisible(skillId,isVisible)
    for i, effectActor in ipairs(self._rotateEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            if effectActor then
                effectActor:setVisible(isVisible or false)
            end
        end
    end
end

-- ***************** 旋转改变层级特效 end ************************

-- 播放复活特效
function HeroActor:playReviveEffect()
    local offsetX, offsetY = -25, 15

    local effectSpriteType = nil
    local bltType = nil
    if self._raceType == RaceType.Slayer then
        effectSpriteType = 1349
        bltType = 1
    elseif self._raceType == RaceType.Vampire then
        effectSpriteType = 1461
        bltType = 1
    elseif self._raceType == RaceType.Ousters then
        effectSpriteType = 482
        bltType = 3
    end
    
    if (not effectSpriteType) or (not bltType) then
        return
    end

    local meta = lt.EffectMeta.new({
        SkillId          = 0,
        OrderId          = 1,
        EffectSpriteType = effectSpriteType,
        BltType          = bltType,
        Step             = 0.06,
        DelayFrame       = 0,
        Owner            = 0,
        LoopCount        = 1
    })
    local effectActor = EffectActor.new(meta, self._direction,  nil, false)
    effectActor:setPosition(offsetX, offsetY)
    self:addChild(effectActor)

    table.insert(self._rotateEffectActorArr, effectActor)
end

function HeroActor:hideRushSprite()
    for _, sprite in ipairs(self._rushSpriteArray) do
        sprite:removeSelf()
    end

    self._rushSpriteArray = {}
end

