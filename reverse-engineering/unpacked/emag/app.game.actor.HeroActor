end

function HeroActor:changeSummonSylphId()
    local summonSylphId = self._roleData:getSummonSylphId()
    if summonSylphId == 0 then
        
    else
        self._actionWeaponInfo = nil
    end
end

function HeroActor:changeShield(shieldId)
