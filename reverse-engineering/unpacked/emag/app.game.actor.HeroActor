function HeroActor:showFoundBoss(data)
    if not self._foundBossData then
        self._foundBossData = data
    end

    self._nameNode:visibleFoundBoss(true)
    self._uptFoundBoss = true
end

function HeroActor:HideFoundBoss(data)
    if self._foundBossData and self._foundBossData:getObjId() == data:getObjId() then
        self._nameNode:visibleFoundBoss(false)

        self._uptFoundBoss = false
        self._foundBossData = nil
    end
end

