end

-- override
function HeroActor:showSprite()
    HeroActor.super.showSprite(self)

    self._spriteHero:setVisible(true)
    self._spriteWeapon:setVisible(true)
    self._spriteShield:setVisible(true)
    self:showLevelEffect()
end

-- override
function HeroActor:hideSprite()
    HeroActor.super.hideSprite(self)
    
    self._spriteHero:setVisible(false)
    self._spriteWeapon:setVisible(false)
    self._spriteShield:setVisible(false)
    self:hideLevelEffect()
end

function HeroActor:hideNodeSprite()
    if self._heroSlayerActor then
        self._heroSlayerActor:hideNode()
        self._heroSlayerActor:setPause()
    end
end

function HeroActor:resumeNodeSpriteByRoot()
    if self._heroSlayerActor then
        self._heroSlayerActor:setResume()
    end
end

function HeroActor:initActionInfoHair()

end

function HeroActor:initActionInfoHero()

    -- 骑摩托车后高度变化
    self._offsetH = 0
    --------------------------------------------------------------------------------------------------------------------
    -- 迷幻术
    if self:getIsHallu() then
        local modelId = self:getIsHallu()
        self._actionInfo = lt.ActionManager:getActionMonsterInfo("monster", modelId, self._actionId, self._direction)
        self._actionInfo:setActionStep()
        self._shadowActor:LoadMonsterActionInfo(modelId, self._actionId, self._direction) 
        self._offsetHeight = 65
        return
    end

    --------------------------------------------------------------------------------------------------------------------
    -- transform 变身相关
    local transform = 0
    if self._agent then
        local transform = self._agent:getTransformId()
        if (transform > 0 and transform <= 6) and transform ~= SkillEnum.TRANSFORM.CASKET then
            local modelId = SkillEnum.TRANSFORM_MODELID[transform]
            self._actionInfo = lt.ActionManager:getActionMonsterInfo("monster", modelId, self._actionId, self._direction)
            self._actionInfo:setActionStep()
            self._shadowActor:LoadMonsterActionInfo(modelId, self._actionId, self._direction)
            if SkillEnum.TRANSFORM_EFFECTHIGHT[transform] then
                self._offsetHeight = SkillEnum.TRANSFORM_EFFECTHIGHT[transform]
            else
                self._offsetHeight = 65
            end
            if self.transformId ~= transform then
                self.transformId = transform
                self:showEffectByLevel(true)
                self._nameNode:setPositionY(self._namePosY + self._offsetHeight)
                self._queueEffectNode:setPositionY(self._offsetY + self._offsetHeight)
                self._soleEffectNode:setPositionY(self._offsetY + self._offsetHeight)
            end
            return
        end
    end
    --------------------------------------------------------------------------------------------------------------------
    -- buff 变身相关
    if self:hasBuffer(BuffEnum.EFFECT_INSTALL_TURRET) then -- 安装炮塔
        self:createTurret()
        return
    end
    --------------------------------------------------------------------------------------------------------------------

    -- 摩托车变身 
    local mountId = self._roleData:getMountId()
    if Constant.MOUNT_ADVANCED_ITEMS3[mountId] then
        local mountModelName = self._roleData:getMountModelName()
        local mountModelShadowName = self._roleData:getMountModelShadowName()
        self._actionInfo = ActionManager:getActionMountInfo(mountModelName, self._actionId, self._direction)
        if self._shadowActor.LoadHeroMountActionInfoAdvance then
            self._shadowActor:LoadHeroMountActionInfoAdvance(mountModelShadowName, self._actionId, self._direction)
        end
        return
    end

    -- 魔族坐骑
    local summonSylphId = self._roleData:getSummonSylphId()
    -- yflog:Info("------------summonSylphId----"..summonSylphId)
    if summonSylphId == Constant.OUTSET_MOUNTID.FAIRY or summonSylphId == Constant.OUTSET_MOUNTID.PEGASUS then
        local id = summonSylphId - Constant.OUTSET_MOUNTID.FAIRY + 1
        local baseName = string.format("%d_%d_%d_%d", 3, 0, 0, id)
        local sModelName = string.format("mount_%s", baseName)
        local sModelShadowName = string.format("mount_s_%s", baseName)
        self._actionInfo = ActionManager:getActionMountInfo(sModelName, self._actionId, self._direction)
        if self._shadowActor.LoadHeroMountActionInfoAdvance then
            self._shadowActor:LoadHeroMountActionInfoAdvance(sModelShadowName, self._actionId, self._direction)
        end
        return
    end

    self._actionInfo = ActionManager:getAcitonHeroInfo(self._modelName, self._actionId, self._direction)
    if self._shadowActor.LoadHeroActionInfo then
        self._shadowActor:LoadHeroActionInfo(self._modelShadowName, self._actionId, self._direction)
    end

    if self._heroSlayerActor then
        self._heroSlayerActor:LoadHeroActionInfo(self._actionId, self._direction)
    end
    
    self._offsetHeight = self._offsetH
    if self.transformId and self.transformId ~= transform then
        self.transformId = transform
        self:showEffectByLevel(true)
        self._nameNode:setPositionY(self._namePosY + self._offsetHeight)
        self._queueEffectNode:setPositionY(self._offsetY + self._offsetHeight)
        self._soleEffectNode:setPositionY(self._offsetY + self._offsetHeight)
    end
end

-- 有武器普攻和没武器普攻动作不同 FIXME
function HeroActor:initActionInfoWeapon()
    self._weaponId = self._roleData:getWeapon()

    -- 鬼族转职前不显示装备,暂时去除鬼族武器
    if self._roleData:isVampire() then
        self._actionWeaponInfo = nil
        return
    end
    if self._roleData:isOusters() then
        if self._actionId == Constant.ACTION_OUSTERS_FAIRY_MOVE_STAND 
            or self._actionId == Constant.ACTION_OUSTERS_FAIRY_MOVE_MOVE then
            self._actionWeaponInfo = nil
            return
        end

        if self._actionId == Constant.ACTION_OUSTERS_PEGASUS_MOVE_STAND 
            or self._actionId == Constant.ACTION_OUSTERS_PEGASUS_MOVE_MOVE then
            self._actionWeaponInfo = nil
            return
        end
    end

    -- 魔族护腕 == 没带装备
    if self._roleData:isOusters() and self._roleData:isWristGuard() then
        self._actionWeaponInfo = nil
        return
    end

    local weaponModelLv = self._roleData:getWeaponModelLevel()
    if weaponModelLv == 0 then
        self._actionWeaponInfo = nil
        return
    end

    local action = self._actionId
    -- 给与策划测试专用 配置在env文件中 FIXME后期需要删除
    if _G_ACTION_WEAPON then
        action = _G_ACTION_WEAPON
    end
    for i,v in ipairs(self._weaponSpriteEffects) do
        v:setVisible(false)
    end

    self._actionWeaponInfo = ActionManager:getActionWeaponInfo(self._weaponModelName, action, self._direction, false)
    if self._shadowActor.LoadHeroWeaponActionInfo then
        self._shadowActor:LoadHeroWeaponActionInfo(self._weaponModelShadowName, action, self._direction)
    end
end

function HeroActor:initActionInfoShield()
    self._shieldId = self._roleData:getShield()
     if self._shieldId ~= 0 then
        self._actionShieldInfo = ActionManager:getActionShieldInfo(self._shieldModelName, self._actionId, self._direction)
        self._shadowActor:LoadHeroShieldActionInfo(self._shieldModelShadowName, self._actionId, self._direction)
    else
        self._actionShieldInfo = nil
    end
end

-- 坐骑
function HeroActor:initActionInfoMount()
    local mountId = self._roleData:getMountId()
    if mountId == 0 then
        self._actionMountInfo = nil
        self:resumeNodeSpriteByRoot()
        return
    end
    if Constant.MOUNT_ADVANCED_ITEMS3[mountId] then
        self._actionMountInfo = nil
        self._actionWeaponInfo = nil
        self:hideNodeSprite()
        return
    elseif Constant.MOUNT_ADVANCED_ITEMS2[mountId] then
        self:hideNodeSprite()
    else
        self:resumeNodeSpriteByRoot()
    end
    local advance = true
    if mountId == Constant.SLAYER_MOUNTID.SCORPION_KEY then
        advance = false
    end
    
    local mountModelName = self._roleData:getMountModelName()
    local mountModelShadowName = self._roleData:getMountModelShadowName()
    local actionId = ActionManager:getAdvancedActorAction(self._raceType, advance, self._actionId)
    -- yflog:Info("---initActionInfoMount-mountModelName =%s--mountModelShadowName =%s",mountModelName,mountModelShadowName)
    self._actionMountInfo = ActionManager:getActionMountInfo(mountModelName, actionId, self._direction)
    self._shadowActor:LoadHeroMountActionInfo(mountModelShadowName, actionId, self._direction)
end

-- override
function HeroActor:setColor(color)
    self._spriteHero:setColor(color)
end

function HeroActor:setColorAll(colorList, weaponColorList)
    self._colorList = colorList or {}
    self._weaponColorList = weaponColorList or {}

    self:processColorList("_colorList", "_buffDurations", "_currentColorIndex")

    self:processColorList("_weaponColorList", "_weaponBuffDurations", "_currentWeaponColorIndex") 

    if #self._colorList < 2 then
        self._skillColor = self._colorList[1]
    end
    if #self._weaponColorList < 2 then
        self._weaponSkillColor = self._weaponColorList[1]
    end
    self:changeModelColor(self._spriteHero)
end

function HeroActor:processColorList(listKey, buffKey, indexKey)
    local list = self[listKey]
    if not list or #list == 0 then return end

    self[buffKey] = self[buffKey] or {}

    if #list >= 2 then
        self[indexKey] = 2
    end

    for index, color in pairs(list) do
        if index == 2 then
            self[buffKey][index] = 80
        else
            self[buffKey][index] = 600 / (#list - 1)
        end
    end
end

--技能变色
function HeroActor:updateBuffColor(dt)
    self:updateSingleBuffColor(dt, "_colorList", "_buffDurations", "_currentColorIndex", "_elapsedTime")
    self:updateSingleBuffColor(dt, "_weaponColorList", "_weaponBuffDurations", "_currentWeaponColorIndex", "_weaponElapsedTime")
end

function HeroActor:updateSingleBuffColor(dt, listKey, buffKey, indexKey, elapsedTimeKey)
    local colorList = self[listKey]
    if #colorList < 2 then
        self[elapsedTimeKey] = 0
        return
    end

    self[indexKey] = self[indexKey] or 2
    self[elapsedTimeKey] = (self[elapsedTimeKey] or 0) + dt

    local function changeColor()
        if listKey == "_colorList" then
            self._skillColor = colorList[self[indexKey]]
            self:changeModelColor(self._spriteHero)
        elseif listKey == "_weaponColorList" then
            self._weaponSkillColor = colorList[self[indexKey]]
            self:changeModelColor(self._spriteHero)
        end

        self[indexKey] = self[indexKey] + 1
        if self[indexKey] > #colorList then
            self[indexKey] = 1
        end
    end

    if self[elapsedTimeKey] >= (self[buffKey][self[indexKey]] or 0) / 1000 then
        changeColor()
        self[elapsedTimeKey] = 0
    end
end


-- 隐身术
function HeroActor:setAlpha(alpha)
    self._spriteHero:setOpacity(255 * alpha)
    self._spriteWeapon:setOpacity(255 * alpha)
    self._spriteShield:setOpacity(255 * alpha)
end

