end

function HeroActor:PopQueue()
    table.remove(self._delayEffectStepQueue, 1)
end

function HeroActor:IsQueueEmpty(queue)
    if not queue then
        return true
    end

    return next(queue) == nil
end

-- 获取遮罩层 后期移动到地图actor里
function HeroActor:getSelfMaskSp()
    if not self._isSelf then
        return
    end

    if tolua.isnull(self._maskGlProgramSp) then
        self._maskGlProgramSp = display.newSprite("game/common/obj_mask.png")
    end

    return self._maskGlProgramSp
end

-- 修改模型颜色
function HeroActor:changeModelColor(node, params, isClone)
    params = params or {}
    local destHairColor = RoleColor:getHairColorById(self._hairColor, true)
    local destSkinColor = RoleColor:getSkinColorById(self._skinColor, true)

    local darkFactor = self._darkFactor
    if params.cloneDarkFactor then
        darkFactor = params.cloneDarkFactor -- 复制sprite设置的dark值
    end
    local skillColor = self._skillColor
    if isClone then
        skillColor = nil
    end

    local helmet, hair, pants
    local uvPixel = {}
    if self._heroSlayerActor then
        helmet, pants, hair = self._heroSlayerActor:getOtherNode()
        uvPixel = self._heroSlayerActor:getPixelSlayerInfo()
        
    end
    local _,helmetColor, helmetLevel = self._roleData:getHelmet()
    local _,pantsColor, pantsLevel = self._roleData:getTrousers()
    local _,shieldColor, shieldLevel = self._roleData:getShield()
    local _,bodyColor, bodyLevel = self._roleData:getBodyAppr()
    local _,weaponColor, weaponLevel =self._roleData:getWeapon()

    local nodes = {
        [RaceType.Slayer] = {
            [1] = {node = node, colorB = destSkinColor, colorG32B = bodyColor, powerG32B = bodyLevel}, -- 上身
            [2] = {node = helmet, colorB = helmetColor, powerB = helmetLevel, pixelSize = uvPixel[SlayerPos.HelMet]}, -- 头盔
            [3] = {node = pants, colorB = destSkinColor, colorG32B = pantsColor, powerG32B = pantsLevel, pixelSize = uvPixel[SlayerPos.Pants]}, -- 裤子
            [4] = {node = self._spriteShield, colorB = shieldColor, powerB = shieldLevel,pixelSize = self._shieldPixelSize}, --盾牌
            [5] = {node = hair, colorB = destHairColor, colorOffset = Constant.GL_COLOR_OFFSET.ZERO, pixelSize = uvPixel[SlayerPos.Hair]},-- 头发
        },
        [RaceType.Vampire] = {
            [1] = {node = node, colorB = destSkinColor, colorG32B = bodyColor,  powerG32B = bodyLevel },
        },
        [RaceType.Ousters] = {
            [1] = {node = node, colorB = destHairColor, colorG32B = bodyColor, powerG32B = bodyLevel, colorOffset = Constant.GL_COLOR_OFFSET.BIT16,colorG96B = pantsColor, powerG96B = pantsLevel}, --魔族靴子=人族裤子
        }
    }

    for _,nodeInfo in ipairs(nodes[self._raceType] or {}) do
        local param = {
            node = nodeInfo.node,
            colorB = nodeInfo.colorB,
            colorG32B = nodeInfo.colorG32B,
            colorG64B = nodeInfo.colorG64B,
            colorG96B = nodeInfo.colorG96B,
            darkFactor = darkFactor,
            colorOffset = params.colorOffset,
            visibleCount = 1 - (self._pCreature:getInvisibleCount() / 64), --隐身
            wipeAmount = self._pCreature:getInvisibleCount(),
            skillColor = skillColor,
            powerB = nodeInfo.powerB,
            powerG32B = nodeInfo.powerG32B,
            powerG64B = nodeInfo.powerG64B,
            powerG96B = nodeInfo.powerG96B,
            pixelSize = nodeInfo.pixelSize or self._pixelSize,
            selectColor = self._selectColor
        }
        
        ShaderBackendUtil:makeMulModelEffect(nodeInfo.node, param)
    end

    ShaderBackendUtil:makeWeaponEffect(self._spriteWeapon, {targetColor = weaponColor, powerB = weaponLevel, pixelSize = self._weaponPixelSize, skillColor = self._weaponSkillColor, selectColor = self._selectColor})

end


function HeroActor:setEffectZOrder(singleEffectZ, queueEffectZ)
    self._effectNode:setLocalZOrder(singleEffectZ)
    self._queueEffectNode:setLocalZOrder(queueEffectZ)
end

function HeroActor:clone(step)
    if self._raceType == Constant.RaceType.Slayer then
        return self:cloneSlayer(step)
    end
    local cloneNode = lt.CommonFunc:deepCopySprite(self._spriteHero)
    local blacks = {0.5, 0.2}
    -- self._shaderActor:setFastMoveBlack(blacks[step])
    self:changeModelColor(cloneNode,{cloneDarkFactor = blacks[step] or 0.2}, true)
    return cloneNode
end

function HeroActor:cloneSlayer(step,isMount)
    local node = display.newNode()
    local destHairColor = RoleColor:getHairColorById(self._hairColor, true)
    local destSkinColor = RoleColor:getSkinColorById(self._skinColor, true)


    
    local helmet, hair, pants
    if self._heroSlayerActor then
        helmet, pants, hair = self._heroSlayerActor:getOtherNode()
        
    end


    local _,helmetColor = self._roleData:getHelmet()
    local _,pantsColor = self._roleData:getTrousers()
    local _,shieldColor = self._roleData:getShield()
    local _,bodyColor = self._roleData:getBodyAppr()
    local cloneNodes = {
        {node = self._spriteHero, colorB = destSkinColor,colorG32B = bodyColor}, -- 上身
        {node = helmet, colorB = helmetColor}, -- 头盔
        {node = pants, colorB = destSkinColor, colorG32B = pantsColor}, -- 裤子
        {node = self._spriteShield, colorB = shieldColor}, --盾牌
        {node = hair, colorB = destHairColor, colorOffset = Constant.GL_COLOR_OFFSET.ZERO},-- 头发
    }

    if isMount then
        table.insert(cloneNodes, {node = self._spriteMount})
    end

    table.insert(cloneNodes, {node = self._spriteWeapon}) -- 武器放最后

    local weaponIndex = nil
    if self._spriteWeapon then
        weaponIndex = #cloneNodes
    end

    for k,v in ipairs(cloneNodes) do
        local cloneNode = lt.CommonFunc:deepCopySprite(v.node)
        cloneNode:setAnchorPoint(v.node:getAnchorPoint())
        cloneNode:setPosition(v.node:getPosition())
        node:addChild(cloneNode)

        -- 武器颜色
        local parameter = 1 - 0.3*step
        if k == weaponIndex then
            -- TODO 武器颜色后面需要根据装备上的属性来获取
            local _,weaponColor, weaponLevel =self._roleData:getWeapon()

            if weaponColor then
                weaponColor = cc.vec3(weaponColor.x*parameter, weaponColor.y*parameter, weaponColor.z*parameter)
                ShaderBackendUtil:makeWeaponEffect(cloneNode, {targetColor = weaponColor, powerB = weaponLevel, pixelSize = self._weaponPixelSize})
            end
        else
            local param = {
                node = cloneNode,
                colorB = v.colorB,
                colorG32B = v.colorG32B,
                colorG64B = v.colorG64B,
                colorG96B = v.colorG96B,
                darkFactor = parameter,
            }
            ShaderBackendUtil:makeMulModelEffect(cloneNode, param)
        end
    end

    return node
end

function HeroActor:isSelf()
    return self._isSelf
end

function HeroActor:createEyeShot()
    if not self._eyeMask then
        self._eyeMask = display.newSprite("ui/common/black_darkness.png")
        self._eyeMask:setScale(Constant.SIGHT_SCALE)
        self._eyeMaskNode:addChild(self._eyeMask)
        self._eyeMask.useCount = 0
    end
    self._eyeMask:setVisible(true)
    self._eyeMask.useCount = self._eyeMask.useCount + 1
    local param = {
        eyeWidth = 21,
        scaleAction = 5
    }
    
    if self._shaderDarknessEffect then
        self._shaderDarknessEffect:render(self._eyeMask, param)
        return
    end

    self._shaderDarknessEffect = ShaderBackendUtil:makeDarknessEffect(self._eyeMask, param)
end

function HeroActor:createBlindShot()
    if not self._bindMask then
        self._bindMask = display.newSprite("ui/common/blind.png")
        self._eyeMaskNode:addChild(self._bindMask)
        self._bindMask:setOpacity(242)
    end
    self._bindMask:setVisible(true)
end

function HeroActor:removeBlindShot()
    if self._bindMask and not tolua.isnull(self._bindMask) then
        self._bindMask:setVisible(false)
    end
end

function HeroActor:createCasketShot()
    if not self._casketMask then
        self._casketMask = display.newSprite("ui/common/black_darkness.png")
        self._casketMask:setScale(Constant.SIGHT_SCALE)
        self._eyeMaskNode:addChild(self._casketMask)
        self._casketMask:setOpacity(50)
    end
    self._casketMask:setVisible(true)
end

function HeroActor:removeCasketShot()
    if self._casketMask and not tolua.isnull(self._casketMask) then
        self._casketMask:setVisible(false)
    end
end

---视野效果（TODO 等待日夜系统）
function HeroActor:changeSightNode(lightTimeLevel, darkLevel, sight)
    if not self._isSelf then
        return 
    end
    if not self._visibleNode then
        self._visibleNode = display.newSprite("ui/common/black_pixel.png")
        self._visibleNode:setScale(Constant.SIGHT_SCALE)
        self._eyeMaskNode:addChild(self._visibleNode)
    end
    local itemLightLevel = 0 -- TODO 装备照明
    local lightLevel = lightTimeLevel + itemLightLevel
    local myMapMeta = lt.AgentManager:getWorldAgent():getMapAgent():getMapMeta()
    local mapArea = myMapMeta:getMapArea()
    local baseHeightRatio = 0.5
    if mapArea then
        if mapArea == Constant.MapArea.UnderGround then
            baseHeightRatio = self._underGroundSightHeightRatio
        end
    end
    local param = {
        eyeWidth = sight or self:getRoleData():getSight(),
        opacity = math.max(0, darkLevel - (lightLevel - lightTimeLevel)) / 10,
        baseHeightRatio = baseHeightRatio
    }

    if self._shaderLightEffect then
        self._shaderLightEffect:render(self._visibleNode, param)
        return
    end

    self._shaderLightEffect = ShaderBackendUtil:makeLightEffect(self._visibleNode, param)
end

function HeroActor:getSightNode()
    return self._visibleNode
end

function HeroActor:getEyeMaskNode()
    return self._eyeMaskNode
end

function HeroActor:getQueueEffectNode()
    return self._queueEffectNode
end

function HeroActor:removeEyeShot()
    if self._eyeMask and not tolua.isnull(self._eyeMask) then
        local param = {
            eyeWidth = 5,
            scaleAction = 21
        }

        if self._shaderDarknessEffect then
            self._shaderDarknessEffect:render(self._eyeMask, param)
        else
            self._shaderDarknessEffect = ShaderBackendUtil:makeDarknessEffect(self._eyeMask, param)
        end

        ScheduleUtil:performWithDelayGlobal(function()
            if self._eyeMask and not tolua.isnull(self._eyeMask) then
                self._eyeMask.useCount = self._eyeMask.useCount - 1
                if self._eyeMask.useCount and self._eyeMask.useCount == 0 then
                    self._eyeMask:setVisible(false)
                end
            end
        end, 0.4)
    end
end

function HeroActor:hasBuffer(buffId)
    if not self:getAgent() then
        return false
    end
    return self:getAgent():hasBuffer(buffId)
end

function HeroActor:getIsHallu()
    if not self:getAgent() then
        return false
    end
    
    return self:getAgent():getIsHallu()
end

function HeroActor:shaderInit()

    local roleData = self:getRoleData()
    if roleData:isCrossCount() or roleData:getFakeCreatureType() == Constant.FAKE_CREATURE_TYPE.FAST_MOVE_ACTION or roleData:isDivine() then
        self._darkFactor = 0.4
    end

    self:updateCreature()
end

--- 更新外显
function HeroActor:updateCreature(param)
    local isStriking = false
    if param and param.isStriking then
        isStriking = param.isStriking
    end

    local isRediance = false
    if param and param.isRediance then
        isRediance = param.isRediance
    end

    -- local weaponColor = self:getWeaponColor()
    local _,weaponColor, weaponLevel =self._roleData:getWeapon()

    if weaponColor and self._raceType ~= RaceType.Vampire then
        ShaderBackendUtil:makeWeaponEffect(self._spriteWeapon, {targetColor = weaponColor,isStriking = isStriking, isRediance = isRediance, powerB = weaponLevel, black = self._darkFactor})
    end
    self:changeModelColor(self._spriteHero)
end

-- 获取武器颜色
function HeroActor:getWeaponColor()
    local _,weaponColor = self._roleData:getWeaponAppr()
    return weaponColor
end

--- 狙击模式
function HeroActor:snipingEffect()
    self._pCreature:setInvisible()
end
function HeroActor:stopSnipingEffect()
    self._pCreature:setVisibleSoon()
end

function HeroActor:setStopBloodDrain()
    if self._pCreature then
        self._pCreature:setStopBloodDrain()
    end
end

-- 神之诅咒旋转
function HeroActor:divineUpdate()
    if self._openRotateDivine then
        self._divineCounter =  self._divineCounter + 1
        if self._divineCounter > 10 then
            local direction = self._divineActor:getDirection()
            direction = direction + 1
            if direction > 7 then
                direction = 0
            end
            if self._divineActor then
                self._divineActor:_setDirection(direction)
            end
            self._divineCounter = 0
        end
    end
end

--- 神之诅咒
function HeroActor:createDivineGuidance()
    local heroData = clone(self._roleData)
    heroData:setDivine(true)
    self._divineActor = lt.HeroActor.new(heroData, self._direction)
    self._divineActor:playAction(Constant.ROLE_ACTION_FLY)
    local divineZ = CacheManager:getVariableById(Constant.Variable.DivineZ) or 70
    self._divineActor:setPosition(cc.p(0, tonumber(divineZ)))
    self._divineActor:setLocalZOrder(5)

    self._openRotateDivine = true
    self:addChild(self._divineActor)
end
function HeroActor:removeDivineGuidance()
    self._openRotateDivine = false
    if self._divineActor then
        self._divineActor:onClear()
        self._divineActor = nil
    end
end

function HeroActor:setSpriteOffsetY(offsetY)
    self._spriteOffsetY = offsetY
end

----------------------------------------------------------------------------------------------
-- 安装炮塔 炮塔火力
function HeroActor:createTurret()
    local modelId = 222
    local direction = self._direction
    if self._actionId == Constant.ACTION_IDLE then
        direction = Constant.DIRECTION_DOWN
    elseif self._actionId ~= Constant.ACTION_ATTACK then
        self._actionId = Constant.ACTION_IDLE
        direction = Constant.DIRECTION_DOWN
    end
    
    self._actionInfo = lt.ActionManager:getActionMonsterInfo("monster", modelId, self._actionId, direction)
    self._actionInfo:setActionStep()
    
    if not self._spriteTurret then
        self._spriteTurret = self:CreateSprite(self.ANCHOR_MIDDLE, self.ANCHOR_MIDDLE, 0, self._heroNode)
    end

    if not self._shadowActorTurret then
        self._shadowActorTurret = ShadowActor.new(2)

        local worldAgent = lt.AgentManager:getWorldAgent()
        if worldAgent then
            local mapActor = worldAgent:getMapAgent():getMapActor()
            mapActor:addMonsterShadowActor(self._shadowActorTurret)
        end
    end
    
    self._shadowActorTurret:LoadMonsterActionInfo(modelId, self._actionId, direction)
    self._shadowActorTurret:setPosition(self._shadowActor:getPosition())

    self._offsetHeight = 65
end

function HeroActor:updateTurretFrame(frameIndex)
    if not self._spriteTurret then return end
    if not self._shadowActorTurret then return end
    
    if self._actionId == Constant.ACTION_IDLE then
        frameIndex = self:changeDirToFrame(self._direction)
    elseif self._actionId == Constant.ACTION_ATTACK then
    end

    local frame = self._actionInfo:getSpriteFrame(frameIndex)
    if frame then
        local sprite = frame.sprite
        self._spriteTurret:setSpriteFrame(sprite)
        local texture = self._spriteTurret:getTexture()
        texture:setAliasTexParameters()
        local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
        self._spriteTurret:setPosition(pos)
        self._spriteTurret:setVisible(true)
        if self._shadowActorTurret and self._shadowActorTurret.onUpdateFrame then
            self._shadowActorTurret:onUpdateFrame(frameIndex)
        end
    end
end

function HeroActor:clearTurret()
    if self._spriteTurret then
        self._spriteTurret:removeFromParent()
        self._spriteTurret = nil
    end
    if self._shadowActorTurret then
        self._shadowActorTurret:removeFromParent()
        self._shadowActorTurret = nil
    end
end

function HeroActor:changeDirToFrame(dir)
    if dir == Constant.DIRECTION_LEFT_DOWN then
        return 15
    elseif dir == Constant.DIRECTION_LEFT then
        return 13
    elseif dir == Constant.DIRECTION_DOWN then
        return 1
    elseif dir == Constant.DIRECTION_RIGHT_DOWN then
        return 3
    elseif dir == Constant.DIRECTION_RIGHT then
        return 5
    elseif dir == Constant.DIRECTION_RIGHT_UP then
        return 7
    elseif dir == Constant.DIRECTION_UP then
        return 9
    elseif dir == Constant.DIRECTION_LEFT_UP then
        return 11
    end
end

----------------------------------------------------------------------------------------------
-- 100 130 150 特效
function HeroActor:showEffectByLevel(needRefresh)
    local isFake = self._roleData:getFakeCreatureType() == Constant.FAKE_CREATURE_TYPE.FAST_MOVE_ACTION or self._roleData:isCrossCount() or self._roleData:isDivine() -- 假身不带等级特效
    if isFake  then
        return
    end

    local heroLevel = self._roleData:getLevel()
    local curEffectState = 0
    if heroLevel >= 100 and heroLevel < 130 then
        curEffectState = curEffectState + 1
    elseif heroLevel >= 130 and heroLevel < 150 then
        curEffectState = curEffectState + 2
    elseif heroLevel >= 150 then
        curEffectState = curEffectState + 3
    end

    if curEffectState == 0 then
        self:clearLevelEffect()
        return
    end

    curEffectState = curEffectState + (self._raceType - 1) * 3
    local curEffectId = Constant.ROLEEFFECT[curEffectState]
    if not curEffectId then
        self:clearLevelEffect()
        return
    end

    if self._perEffectState and self._perEffectState == curEffectState and not needRefresh then
        return
    end
    
    self:clearLevelEffect()

    local actionInfoMetas = CacheManager:getBuffMetas(curEffectId)
    if self._roleData:isSlayer() then
        self:playRotateEffect(actionInfoMetas,curEffectId)
    else
        local metasNum = #actionInfoMetas
        local tempMetas = {}
        if self._roleData:isAlive() then
            for i=1,metasNum/2 do
                table.insert(tempMetas,actionInfoMetas[i])
            end
        else
            for i=metasNum/2,metasNum do
                table.insert(tempMetas,actionInfoMetas[i])
            end
        end
        self:playRotateEffect(tempMetas,curEffectId)
    end
    self._perEffectState = curEffectState
end

function HeroActor:clearLevelEffect()
    local perEffectId = self:getPerEffectId()
    if perEffectId then
        self:removeRotateEffect(perEffectId)
    end
    
    self._perEffectState = nil
end

function HeroActor:showLevelEffect()
    local perEffectId = self:getPerEffectId()
    if perEffectId then
        self:setRotateEffectVisible(perEffectId,true)
    end
end

function HeroActor:hideLevelEffect()
    local perEffectId = self:getPerEffectId()
    if perEffectId then
        self:setRotateEffectVisible(perEffectId,false)
    end
end

function HeroActor:getPerEffectId()
    local perEffectId = nil
    if self._perEffectState then
        perEffectId = Constant.ROLEEFFECT[self._perEffectState]
    end

    return perEffectId
end

function HeroActor:showLevelUpSpine()
    if not self._levelUpSpine then
        self._levelUpSpine = lt.SkeletonManager:createSkeletonEffectWithFile("shengji", "shengji_skeleton")
        self:addChild(self._levelUpSpine,self._heroNode:getLocalZOrder()+1)
    end

    local skeletonName = nil
    if self._raceType == RaceType.Ousters then
        skeletonName = "ShengJi_Skeleton_Ouster"
    elseif self._raceType == RaceType.Vampire then
        skeletonName = "ShengJi_Skeleton_Vampire"
    elseif  self._raceType == RaceType.Slayer then
        skeletonName = "ShengJi_Skeleton_Slayer"
    end
    
    self._levelUpSpine:stopAllActions()
    self._levelUpSpine:runAction(cc.Sequence:create(cc.DelayTime:create(0.3), cc.CallFunc:create(function()
        if skeletonName then
            self._levelUpSpine:setAnimation(0, skeletonName, false)
        end
    end)))
end

function HeroActor:clearLevelUpSpine()
    if self._levelUpSpine then
        self._levelUpSpine:stopAllActions()
        self._levelUpSpine:removeFromParent()
        self._levelUpSpine = nil
    end
end

