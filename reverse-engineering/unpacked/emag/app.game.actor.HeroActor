--转换id
HeroActor.transformId = nil

local ADDON_LEFTHAND= 1		-- 왼손			
local ADDON_RIGHTHAND= 2	-- 오른손

local AddonOrder = 
{
	[Constant.DIRECTION_LEFT] = {ADDON_RIGHTHAND, ADDON_LEFTHAND },	-- LEFT
	[Constant.DIRECTION_LEFT_DOWN] = {ADDON_RIGHTHAND, ADDON_LEFTHAND },	-- LEFTDOWN
	[Constant.DIRECTION_DOWN] = {ADDON_LEFTHAND, ADDON_RIGHTHAND },	-- DOWN	
	[Constant.DIRECTION_RIGHT_DOWN] = {ADDON_LEFTHAND, ADDON_RIGHTHAND },	-- RIGHTDOWN	
	[Constant.DIRECTION_RIGHT] = {ADDON_LEFTHAND, ADDON_RIGHTHAND },	-- RIGHT
	[Constant.DIRECTION_RIGHT_UP] = {ADDON_LEFTHAND, ADDON_RIGHTHAND },	-- RIGHTUP
	[Constant.DIRECTION_UP] = {ADDON_RIGHTHAND, ADDON_LEFTHAND },	-- UP
	[Constant.DIRECTION_LEFT_UP] = {ADDON_RIGHTHAND, ADDON_LEFTHAND }	-- LEFTUP
};

  

function HeroActor:ctor(roleData, direction, isSelf)
    HeroActor.super.ctor(self, roleData, direction)

    self._isSelf = isSelf
    local isSlayer = roleData:isSlayer()

    self._currentColorIndex = 1
    self._currentWeaponColorIndex = 1
    self._buffDurations = {}
    self._colorList = {}
    self._weaponColorList = {}
    self._weaponBuffDurations = {}
    self._syncWeaponFrameOffset = 0
    self._elapsedTime = 0
    self._weaponElapsedTime = 0
    self._weaponSkillColor = nil
    self._openRotateDivine = false

    if isSlayer then
        self._helmetName, self._modelName, self._pantsName, self._hairName = roleData:getModelName()
        self._helmetShadowName, self._modelShadowName, self._pantsShadowName, self._hairShadowName = roleData:getModelShadowName()
    else
        self._modelName = roleData:getModelName()
        self._modelShadowName = roleData:getModelShadowName()
    end

    self._weaponModelName = roleData:getWeaponModelName()
    self._weaponModelShadowName = roleData:getWeaponModelShadowName()
    self._shieldModelName = roleData:getShieldModelName()
    self._shieldModelShadowName = roleData:getShieldModelShadowName()

    self._hair        = roleData:getHair()
    self._hairColor   = roleData:getHairColor()
    self._skinColor   = roleData:getSkinColor()
    self._clothColor  = roleData:getClothColor()
    self._raceType    = roleData:getRace()
    self._sexType     = roleData:getSex()

    self._weaponId    = roleData:getWeapon()
    self._curShotCount = 1
    self._curShotEnd = false


    local ANCHOR_MIDDLE = self.ANCHOR_MIDDLE

    -- 天炼pc端转换坐标会有一个偏移值offsetX = -25, offsetY = 15
    local offsetX, offsetY = -25, 15
    local zorder = 2
    -- 人物模型
    self._heroNode = display.newNode()
    self._heroNode:setPosition(offsetX, offsetY)
    self:addChild(self._heroNode, zorder)

    

    -- 坐骑在最下面
    self._spriteMount = self:CreateSprite(ANCHOR_MIDDLE, ANCHOR_MIDDLE, 0, self._heroNode)

    zorder = zorder + 1

    -- Slayer 人族 Helmet 头盔  pants 裤子
    if isSlayer then
        -- 裤子
        self._heroSlayerActor = HeroSlayerActor.new(roleData, self._heroNode, zorder)
        self._heroNode:addChild(self._heroSlayerActor, zorder)

        zorder = zorder + 1
    end

    self._spriteHero = self:CreateSprite(ANCHOR_MIDDLE, ANCHOR_MIDDLE, zorder, self._heroNode)

    self._casketNode = self:CreateSprite(ANCHOR_MIDDLE, ANCHOR_MIDDLE, zorder, self)
 
    -- 模型影子
    -- self._shadowActor = ShadowActor.new(1)

    self._eyeMaskNode = display.newNode()

    -- 模型影子 1为英雄
    self._shadowActor = ShadowActor.new(1, roleData)

    --技能范围
    if self._isSelf then
        self._skillActor = SkillActor.new(1)
        self._opacitySkillActor = SkillActor.new(2)
    end
    --[[ 测试用 十字线
        local lineNode = display.newNode()
        self:addChild(lineNode)
        lt.ResManager:DrawCrossLine(lineNode)
    ]]

    -- 根据人物朝向改变层级特效 改变方向
    -- 快速恢复
    self._zorderEffectNode = display.newNode()
    self._zorderEffectNode:setPosition(offsetX, offsetY)
    self:addChild(self._zorderEffectNode, zorder)
    self._zorderEffectActorArr = {}

    -- 旋转特效列表，根据旋转的位置调整层级
    self._rotateEffectActorArr = {}

    -- 脚底特效
    self._soleEffectNode = display.newNode()
    self._soleEffectNode:setPosition(offsetX, offsetY)
    self:addChild(self._soleEffectNode, 1)
    self._soleEffectActorArr = {}


    self._weaponSpriteEffects = {}
    for i = 1, #EffectEnum.DARKBITS do
        self._weaponSpriteEffects[i] = self:CreateSprite(ANCHOR_MIDDLE, ANCHOR_MIDDLE, zorder, self._heroNode)
    end

    -- 3
    zorder = zorder + 1
    self._spriteWeapon = self:CreateSprite(ANCHOR_MIDDLE, ANCHOR_MIDDLE, zorder, self._heroNode)
    self._spriteShield = self:CreateSprite(ANCHOR_MIDDLE, ANCHOR_MIDDLE, zorder, self._heroNode)
    self._weaponZorder = zorder -- 记录武器层级

    -- 4
    zorder = zorder + 1
    self._effectNode = display.newNode()
    -- self._effectNode:setAnchorPoint(ANCHOR_TOP, ANCHOR_TOP)
    self._effectNode:setPosition(offsetX, offsetY)
    self:addChild(self._effectNode, zorder)

    self._spriteEffect = self:CreateSprite(ANCHOR_MIDDLE, ANCHOR_MIDDLE, zorder, self._effectNode)
    self._spriteDelayEffect = self:CreateSprite(ANCHOR_MIDDLE, ANCHOR_MIDDLE, zorder, self._effectNode)

    zorder = zorder + 1
    -- 持续特效
    self._runningEffectNode = display.newNode()
    self._runningEffectNode:setPosition(offsetX, offsetY)
    self:addChild(self._runningEffectNode, zorder)
    self._runningEffectActorArr = {}

    self._queueEffectNode = display.newNode()
    self._queueEffectNode:setPosition(offsetX, offsetY)
    self:addChild(self._queueEffectNode, zorder)
    self._queueEffectActorArr = {}
    self._parabEffectActorArr = {}

    --- 技能挂载人物左右手动画(天使赐福)
    self._handsNode = {}
    self._handsNode[ADDON_LEFTHAND] = display.newNode()
    self:addChild(self._handsNode[ADDON_LEFTHAND], zorder)
    self._handsNode[ADDON_LEFTHAND]:setPosition(offsetX, offsetY)

    self._handsNode[ADDON_RIGHTHAND] = display.newNode()
    self:addChild(self._handsNode[ADDON_RIGHTHAND], zorder)
    self._handsNode[ADDON_RIGHTHAND]:setPosition(offsetX, offsetY)


    -- 黑暗复仇者节点
    self._darkRevengeNode = self:CreateSprite(ANCHOR_MIDDLE, ANCHOR_MIDDLE, zorder, self._heroNode)

    self._handEffectActors = {}

    -- 5
    zorder = zorder + 1
    -- 遮罩区域
    -- self._maskGlProgramSp = display.newSprite("game/common/obj_mask.png")

    -- self:addChild(self._maskGlProgramSp, zorder)
    -- -- 5
    -- zorder = zorder + 1
    -- -- 遮罩区域
    if self._isSelf then
        self._maskGlProgramSp = display.newSprite("game/common/obj_mask.png")
        -- self:addChild(self._maskGlProgramSp, 0)
    end


    self._effectLoopCount = 0
    self._nextEffectFrameIndex = 1
    self._timeEffectTrigger = TimeTrigger.new()

    self._delayEffectLoopCount = 0
    self._nextDelayEffectFrameIndex = 1
    self._timeDelayTrigger = TimeTrigger.new()

    if roleData:getNpcId() then -- NPC
        self:loadNameNode()
    else
        if self._isSelf then
            self._nameNode = lt.NameNode.new(self._roleData, Constant.NameNodeType.HERO_SELF)
        else
            self._nameNode = lt.NameNode.new(self._roleData, Constant.NameNodeType.HERO_OTHER)
        end
    end

    self._rushSpriteArray = {}

    -- 设置层级
    self:updateFrameZOrder()

    -- self:setCascadeColorEnabled(true)
    -- self:setColor(display.COLOR_GREEN)

    self._zOrderDeltaM = 0
    self._zOrderDeltaN = 0

    self._uptFoundBossTime = 0
    self._visibleFoundBossTime = 0

    self._offsetHeight = 0

    self._actionPause = false
    
    -- 烈炎剑
    self._isLarSlashMultip = false
    self._weaponEffect = nil

    self._divineCounter = 0

    -- 绑定动画列表
    self._bingdingEffectArr = {}


    -- self:changeSightNode()
    
    self:shaderInit()

    --------------------------------
    -- 安装炮塔 创建炮塔和炮塔影子
    self._spriteTurret = nil
    self._shadowActorTurret = nil
    --------------------------------
    self._spriteSkillHide = display.newSprite("game/common/hide_icon.png")
    self._spriteSkillHide:setVisible(false)
    self:addChild(self._spriteSkillHide)
    
    self:showEffectByLevel()
    self._fastMoveTrigger = TimeTrigger.new()
    if self._isSelf then
	    self._underGroundSightHeightRatio = CacheManager:getVariableById(Constant.Variable.UnderGroundSightHeightRatio) or 0.54
    end

    self._offsetY = offsetY
    -- self:registerScriptHandler(function(state)
    --     if state == "cleanup" then
    --         if self._heroSlayerActor then
    --             self:onClear()
    --         end
    --     end
    -- end)
end

function HeroActor:onClear()
    self:stopAllActions()
    
    self:clearLevelUpSpine()
    self:clearTurret()
    self:removeAllParalEffect()
    self:removeAllQueueEffect()
    self:removeAllRotateEffect()
    self:removeAllZorderEffect()

    if self._queueEffectNode then
        self._queueEffectNode:removeFromParent()
        self._queueEffectNode = nil
    end
    if self._heroSlayerActor then
        self._heroSlayerActor:onClear()
        self._heroSlayerActor = nil
    end
    if self._visibleNode then
        self._visibleNode:removeSelf()
        self._visibleNode = nil
    end

    if self._shaderLightEffect then
        self._shaderLightEffect:onClear()
        self._shaderLightEffect = nil
    end
    if self._eyeMask then
        self._eyeMask.useCount = nil
        self._eyeMask:removeSelf() 
        self._eyeMask = nil
    end

    if self._shaderDarknessEffect then
        self._shaderDarknessEffect:onClear()
        self._shaderDarknessEffect = nil
    end

    if self._bindMask then
        self._bindMask:removeSelf() 
        self._bindMask = nil
    end

     if self._casketMask then
        self._casketMask:removeSelf() 
        self._casketMask = nil
    end

    if self._skillActor then
        self._skillActor:onClear()
        self._skillActor = nil
    end

    if self._opacitySkillActor then
        self._opacitySkillActor:onClear()
        self._opacitySkillActor = nil
    end

    -- self:removeShadowActor()
    self:removeDivineGuidance()

    self:removeAllChildren()

    self._spriteEffect      = nil
    self._spriteDelayEffect = nil
    self._spriteHero        = nil
    self._spriteWeapon      = nil
    self._spriteShield      = nil
    self._casketNode        = nil

    self._actionInfo        = nil
    self._actionHairInfo    = nil
    self._actionWeaponInfo  = nil
    self._actionShieldInfo  = nil 
    self._actionMountInfo  = nil
    self._effectInfo        = nil
    self._delayEffectInfoMap  = nil

    self._rushSpriteArray   = nil

    self._hair              = nil
    self._hairColor         = nil
    self._weaponId          = nil

    self._runningEffectNode = nil
    self._runningEffectActorArr = nil
    self._queueEffectNode = nil
    self._queueEffectActorArr = nil
    self._timeEffectTrigger = nil
    self._timeDelayTrigger = nil

    self._zorderEffectNode = nil
    self._zorderEffectActorArr = nil
    self._soleEffectNode = nil
    self._soleEffectActorArr = nil

    self._maskGlProgramSp = nil
    self._pCreature = nil

    self._rotateEffectActorArr = nil

    self._isLarSlashMultip = nil
    self._weaponEffect = nil

    self._bingdingEffectArr = nil
    self._divineActor = nil
    self._colorList = nil
    self._weaponColorList = nil
    self._weaponBuffDuration = nil
    self._skillColor = nil
    self._skillActor = nil
    self._opacitySkillActor = nil
    self:clearNpcNameNode()
    
    -- 先移除继承添加的 在调用超类清楚
    HeroActor.super.onClear(self)
end

function HeroActor:onUpdate(delta)
    HeroActor.super.onUpdate(self)
    self._zOrderDeltaM = 0
    self._zOrderDeltaN = 0
    self._delayLevel = 0
    self:changeShot2Idle() -- 需在onUpdateAction之前调用，确保最后一帧正常播放
    self:onUpdateAction()

    self:onUpdateEffect()
    self:onUpdateDelayEffect()
    self:onUpdateRunningEffect()
    self:onUpdateQueueEffect()
    self:onUpdateParalEffect()
    self:onUpdataHandEffect()
    self:onUpdateZorderEffect()
    self:onUpdateSoleEffect()
    self:onUpdateRotateEffect()
    self._pCreature:updateInvisible()
    if self._selectColor or self._pCreature:getInvisibleStep() then
        self:changeModelColor(self._spriteHero)
    end
    self:updateBuffColor(delta)
    self:divineUpdate(delta)
end
--FPS掉帧严重【暂定小于20帧】距离自己远端的玩家绑定的特效不立刻更新，待靠近角色会切换执行onUpdate刷新特效
function HeroActor:onDelayUpdate(dt,delaylevel)
    HeroActor.super.onUpdate(self)
    self._zOrderDeltaM = 0
    self._zOrderDeltaN = 0
    self:changeShot2Idle() -- 需在onUpdateAction之前调用，确保最后一帧正常播放
    self:onUpdateAction()
    self._delayLevel = delaylevel--暂标数据，用于记录刷新阻塞的级别。做深度优化使用
    if delaylevel >= 3 then
        return
    end
    self:onUpdateEffect()
    self:onUpdateDelayEffect()
    self:onUpdateRunningEffect()
    self:onUpdateQueueEffect()
    self:onUpdateParalEffect()
    self:onUpdataHandEffect()
    self:onUpdateZorderEffect()
    self:onUpdateSoleEffect()
    self:onUpdateRotateEffect()
    self._pCreature:updateInvisible()
    if self._selectColor or self._pCreature:getInvisibleStep() then
        self:changeModelColor(self._spriteHero)
    end
    self:updateBuffColor(delta)
end

function HeroActor:resetActionStep()
    ----------------------------------------------------------------------
    -- 设置step倍率
    local agent = self:getAgent()
    local param = 1
    if agent and agent.getCurStepMultiple then--buff冰冻等慢动作播放
        param = agent:getCurStepMultiple() or 1
    end
    local speedRate = 1
    if agent and agent.getCurSpeedRate then--客户端掉帧快速追帧参数
        speedRate = agent:getCurSpeedRate()
    end
    ----------------------------------------------------------------------
    
    self._timeTrigger:reset(self._actionInfo:getStep()*param/speedRate)
end

function HeroActor:hideTargetMark()
    HeroActor.super.hideTargetMark(self)
    self:changeModelColor(self._spriteHero) --取消描边效果
end

-- 枪技能切回正常状态
function HeroActor:changeShot2Idle()
    if self._curShotEnd then
        local agent = self:getAgent()
        if agent then
            agent:changeState(lt.HeroStateIdle.new(agent))
        end

        self._curShotCount = 1
        self._curShotEnd = false
    end
end

-- 获取当前枪动画播放的次数
function HeroActor:getCurShotCount()
    return self._curShotCount
end

function HeroActor:setCurShotCount(count)
    self._curShotCount = count
end

-- override
function HeroActor:setPositionEx(x, y)
    -- HeroActor.super.setPositionEx(self, x, y)
    -- --------- parent -----------

    self:setPosition(x, y)
    if self._shadowActor then
        self._shadowActor:setPosition(x, y)
    end
    if self._skillActor then
        self._skillActor:setPosition(x, y)
    end
    if self._opacitySkillActor then
        self._opacitySkillActor:setPosition(x, y)
    end
    if self._eyeMaskNode then
       self._eyeMaskNode:setPosition(x, y)
    end

    local m, n = lt.MapUtil:calcMN(x, y)

    self:setMapPos(m, n)
    self._nameNode:setPosition(x, y + self._offsetHeight)
    self._namePosY = y + self._offsetHeight
    self._nameNode:setLocalZOrder(n)
    -- --------- parent -----------
end

function HeroActor:setMapPos(m, n)
    if not self._pos then
        self._pos = {}
    end
    self._pos.x = m
    self._pos.y = n
end

function HeroActor:getMapPos()
    return self._pos
end

function HeroActor:getPos()
    return cc.p(self:getPositionX(), self:getPositionY())
end

function HeroActor:refreshNameNodeHeight()
    local y = self._nameNode:getPositionY()

    y = y -self._offsetH
    self._offsetH = 0

    self._nameNode:setPositionY(y + self._offsetHeight)
end

-- override
function HeroActor:initActionInfo()
    self:initActionInfoHero()
end

function HeroActor:initExtraActionInfo()
    self:initActionInfoHair()
    self:initActionInfoWeapon()
    self:initActionInfoShield()
    self:initActionInfoMount()
end

--- 技能相关帧数设置
function HeroActor:updateSkillFramePrevious()
    -- 连击技能  1.人族枪
    local agent = self:getAgent()
    if agent and agent:isStateShot() then
        local skillId = (agent:getCurState() or {})._skillCode
        if skillId and SkillEnum.REPEATED_SKILL_ID_TABLE[skillId] then
            self:resetFrameIndex()
        end
    end

    --停止吸血
    if self._roleData and self._pCreature and self._pCreature:isStopDrain() and (self._actionId == Constant.ACTION_VAMPIRE_DRAIN or self._actionId == Constant.ACTION_OUSTERS_DRAIN) then
        self._nextFrameIndex = self._pCreature:stopBloodDrain(self._nextFrameIndex, self._actionId)
        if self._nextFrameIndex > 29 then
            if self._actionId == Constant.ACTION_OUSTERS_DRAIN then
                self:removeQueueEffect(SkillEnum.SKILL_ABSORB_SOUL)
            end
            self._pCreature:setStopped(true)
        end
        if self._actionId == Constant.ACTION_VAMPIRE_DRAIN then
            self._pCreature:setStopped(true)
        end
    end

    if self._pCreature and self._pCreature:getStopped() and (self._actionId == Constant.ACTION_VAMPIRE_DRAIN or self._actionId == Constant.ACTION_OUSTERS_DRAIN) then
        if self._nextFrameIndex == 1 then
            self._pCreature:setStopped(false)
            local curState = self:getAgent():getCurState()
            if curState then
                if curState.getStateId then
                    if curState:getStateId() == Constant.HERO_STATE_SKILL then
                        curState:checkRoute()
                    end
                end
            end
            lt.GameModule:clearAttackCd()
        end
    end
    if self._roleData:isDivine() then
        self._nextFrameIndex = 10
    end
end

--- 技能相关帧数设置，在updateFrame后执行
function HeroActor:updateSkillFrameAfter()
    ------------------------------------------------------------
    -- 烈炎剑 需在self:updateFrame(true)之后，涉及到装备的隐藏
    self:updateWeaponEffect()
    ------------------------------------------------------------
    self:playBindingEffectNext()
end

-- override
function HeroActor:gotoNextFrame()
    -- HeroActor.super.gotoNextFrame(self)
    if self._actionPause and self._initFrame then
        return
    end

    -- 技能帧数相关
    self:updateSkillFramePrevious()

    self:updateFrame(true)

    --技能相关刷新
    self:updateSkillFrameAfter()

    self._nextFrameIndex = self._nextFrameIndex + 1
end

function HeroActor:updateWeaponEffect()
    if not self._roleData then
        return
    end

    if not self._roleData:isSlayer() then
        return
    end

    local agent = self:getAgent()
    if not agent then
       return 
    end

    if not agent:isStateShot() then--(not agent:isStateSkill()) and (not agent:isAttackDummy()) then
        self:clearWeaponEffect()
        return
    end

    local curState = agent:getCurState() or {}
    local skillId = curState._skillCode or curState._skillId
    local frameCount = self._actionInfo:getSpriteFrameCount() or 0

    local single = self._nextFrameIndex >= (frameCount - 2)
    if (self._curShotCount or 0) > 1 then
        self._isLarSlashMultip = true
    end

    if skillId == SkillEnum.SKILL_LAR_SLASH and self._actionId == Constant.ACTION_SLAYER_SWORD_2 and (self._isLarSlashMultip or single) then
        if not self._weaponEffect then
            local sex = 0
            if self._roleData then
                sex = self._roleData:getSex()
            end
            sex = sex + 1
            local processMetas = CacheManager:getProcessMetas(SkillEnum.SKILL_LAR_SLASH,1)
            self._weaponEffect = EffectActor.new(processMetas[sex], self._direction,  nil, false)
            self._weaponEffect:setPosition(-25, 15)
            self:addChild(self._weaponEffect)
        end
        self._weaponEffect:setNextEffectFrameIndex(self._nextFrameIndex)
        if self._spriteWeapon then
            self._spriteWeapon:setVisible(false)
        end
    else
        self:clearWeaponEffect()
    end
end

function HeroActor:clearWeaponEffect()
    if not self._weaponEffect then
        return
    end

    self._weaponEffect:removeFromParent()
    self._weaponEffect = nil

    if self._spriteWeapon and self._spriteHero:isVisible() and self._actionWeaponInfo then
        self._spriteWeapon:setVisible(true)
    end
end

function HeroActor:clearLarSlashMultip()
    self._isLarSlashMultip = false
end

function HeroActor:resetFrameIndex()
    local agent = self:getAgent()
    if not agent then
        return
    end

    if not agent:isStateShot() then
        return
    end
    
    local count = agent:getShotTime()
    local curState = agent:getCurState() or {}
    local skillId = curState._skillCode

    local targetAgent = agent:getTargetAgent()
    local skillMeta = lt.CacheManager:querySkillMeta(skillId)

    if SkillEnum.REPEATED_SKILL_ID_TABLE[skillId] and self._actionId > 0 then
        local mulFrame, repeatCount, repeatStart = SkillModule:getRepeatConfig(self._actionId,skillId)
        
        if self._curShotCount < count then
            if self._nextFrameIndex > (repeatStart + repeatCount - 1) then 
                self._nextFrameIndex = repeatStart
                self._curShotCount = self._curShotCount + 1
                
                local needTargetSkill = skillMeta:getTargetType() == Constant.SkillTargetType.ONE
                if needTargetSkill  and (not targetAgent or targetAgent:getIsOutOfGame()) then
                    self._curShotEnd = true
                end
            end
            
        else
            local frameCount = self._actionInfo:getSpriteFrameCount() or 0
            if self._nextFrameIndex >= frameCount then
                self._curShotEnd = true
            end
        end
        ----------------------------------------------------------------------------
        -- 连击时候对应帧数开始发送攻击
        local shotRepeatSkill = SkillEnum.GUN_SHOT_SKILL_REPEATED_TIMES_TABLE[skillId]
        local changeDirection = false
        if shotRepeatSkill and (shotRepeatSkill == -1 or shotRepeatSkill > 1) and self._curShotCount ~= 1 then
            if agent:getIsSelf() and (mulFrame) == self._nextFrameIndex then
                -- 判断是否满足释放条件
                local isCanAttack, msg = agent:checkSkillCondition(skillId,skillMeta)
                if isCanAttack then
                    changeDirection = agent:repeatSendAttack(skillId)
                else
                    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = msg})
                    self._curShotEnd = true
                end
            end
        end
        ----------------------------------------------------------------------------
        -- 到达特定帧播放特效
        local effectFrame = mulFrame == self._nextFrameIndex
        if effectFrame and not self._curShotEnd then
            
            local isGun = (Constant.IsGun[agent:getWeaponType() or -1] or false)
            if isGun then
                self:playParallelEffectByLv(skillId, 1, Constant.EFFECT.PROCESS)
                self:playParallelEffectByLv(skillId, 1, Constant.EFFECT.ACTION)
                if skillId == SkillEnum.SKILL_BULLET_OF_LIGHT then
                    -- 目标身上的Effect
                    local targetAgentId = self:getAgent():getTargetAgentId()
                    local targetAgent = lt.AgentManager:getAgent(targetAgentId)
                    if targetAgent then
                        local tM, tN = targetAgent:getMNExactly()
                        local effectMetas = CacheManager:getProcessMetas(skillId)
                        local x, y = lt.MapUtil:calcMNMid(tM, tN)
                        local offsetX, offsetY = -25, 15
                        local reX, reY = x + offsetX, y + offsetY
                        local bullet = lt.BullectScreenEffect.new(skillId, 0, cc.p(reX, reY))
                        local random = math.random(1, #effectMetas)
                        bullet:addEffect(skillId, effectMetas[random])
                        lt.BulletManager:addBulletToMap(bullet)
                    end
                elseif skillId == SkillEnum.SKILL_ULTIMATE_BLOW then
                    local targetAgentId = self:getAgent():getTargetAgentId()
                    local targetAgent = lt.AgentManager:getAgent(targetAgentId)
                    if targetAgent then
                        local tM, tN = targetAgent:getMNExactly()
                        local effectMetas = CacheManager:getProcessMetas(skillId)
                        local x, y = lt.MapUtil:calcMNMid(tM, tN)
                        local offsetX, offsetY = -25, 15
                        local reX, reY = x + offsetX, y + offsetY
                        local direction = targetAgent:getDirection()
                        local bullet = lt.BullectScreenEffect.new(skillId, direction, cc.p(reX, reY))
                        bullet:addEffect(skillId, effectMetas[1])
                        lt.BulletManager:addBulletToMap(bullet)
                    end
                elseif skillId == SkillEnum.SKILL_MOLE_SHOT or skillId == SkillEnum.SKILL_MULTI_SHOT then
                    local mTarget, nTarget = self:getAgent():getRotateShotMN()
                    lt.SkillManager:playMoleShot(skillId, 0, self:getAgent():getAgentId(), self:getAgent():getTargetAgentId(), mTarget, nTarget)
                end
            
            elseif skillId == SkillEnum.SKILL_VIOLENT_PHANTOM then
                self:getAgent():playParallelEffectByLv(skillId, 1, Constant.EFFECT.PROCESS)
            elseif skillId == SkillEnum.SKILL_INNATE_DEADLY_CLAW then --至伤裂爪
                agent:playParallelEffectByLv(skillId, 1, Constant.EFFECT.PROCESS)
            end
        end
        ----------------------------------------------------------------------------

        if changeDirection then
            self:setNextFrameIndex(mulFrame+1)
        end
    else
        self._curShotCount = 1
        self._curShotEnd = false
    end
end

function HeroActor:getShadowPoint()
    local point = {x=0, y=0}
    
    return point
end

function HeroActor:updateFrame(update)
    if not self._actionInfo then
        return
    end

    local isHide = false
    local mountId = self._roleData:getMountId()
    if Constant.MOUNT_ADVANCED_ITEMS2[mountId] then
        isHide = true
    end
    
    -- hero action
    if not self:getHideSprite() and not isHide then
        self._spriteHero:setVisible(true)
        if update then
            local frameIndex = self._nextFrameIndex
            if self._actionId == Constant.ACTION_ATTACK then
                local curState = self._agent:getCurState() or nil
                local skillId = curState._skillCode or curState._skillId
                if skillId == SkillEnum.SKILL_SET_AFIRE then 
                    frameIndex = 4+((self._nextFrameIndex)%4)
                end
            end
            local frame = self._actionInfo:getSpriteFrame(frameIndex)
            if frame then
                self._initFrame = true
                local sprite = frame.sprite
                -- print("self._spriteHero:setSpriteFrame",frame.path)
                self._spriteHero:setSpriteFrame(sprite)
                if self._selectColor then
                    self._pixelSize = ResUtil:getPlistPixelSize(sprite)
                end
                local texture = self._spriteHero:getTexture()
                texture:setAliasTexParameters()

                -- 偏移值坐标
                local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
                -- if self._agent and self._agent:getTransformId() == SkillEnum.TRANSFORM.BAT then
                --     -- local transformZ = CacheManager:getVariableById(Constant.Variable.TransformZ) or 120
                --     -- local transformZ = SkillEnum.TRANSFORM_EFFECTHIGHT[transform]
                --     pos.y = pos.y + transformZ
                -- end
                if self._agent and self._agent:getTransformId() > 0 then
                    local transformZ = SkillEnum.TRANSFORM_EFFECTHIGHT[self._agent:getTransformId()]
                    pos.y = pos.y + transformZ
                end
                if type(self._spriteOffsetY) == "number" then
                    pos.y = pos.y + self._spriteOffsetY
                end
                self._spriteHero:setPosition(pos)
                if self._shadowActor and self._shadowActor.onUpdateFrame then
                    self._shadowActor:onUpdateFrame(self._nextFrameIndex)
                end
                
                -- if self._fastMoveTrigger:tick() then
                    self:updateFastMove()
                -- end

                if self._heroSlayerActor then
                    self._heroSlayerActor:onUpdateFrame(self._nextFrameIndex)
                end
            end
        end
    else
        self._spriteHero:setVisible(false)
        self._shadowActor:hideSprite()
        if self._heroSlayerActor then
            self._heroSlayerActor:hideNode()
        end
    end


    self:updateTurretFrame(self._nextFrameIndex)

    -- weapon action
    self:updateWeaponFrame(update)

    -- shield action
    self:updateShieldFrame(update)

    -- mount action
    self:updateMountFrame(update)
end

-- weapon action
function HeroActor:updateWeaponFrame(update)
    ---------------------------------------------------------------------------------------------
    local isHide = false
    if self._raceType == RaceType.Ousters and self._actionId == Constant.ROLE_ACTION_BEAT then  -- 魔族动作3不显示武器
        isHide = true
    end
    local mountId = self._roleData:getMountId()
    if Constant.MOUNT_ADVANCED_ITEMS2[mountId] then
        isHide = true
    end

    local agent = self:getAgent()
    if agent then
        if agent:isStateSkill() or agent:isAttackDummy() then  -- 雷神斩 不显示武器
            local curState = agent:getCurState() or nil
            local skillId = curState._skillCode or curState._skillId
            if skillId == SkillEnum.SKILL_DISTANCE_BLITZ then 
                isHide = true
            end
        end

        if agent:getIsHallu() then  -- 迷幻术 不显示武器
            isHide = true
        end
    end
   
    ---------------------------------------------------------------------------------------------

    if self._weaponId ~= 0 and self._actionWeaponInfo and (not self:getHideSprite()) and (not isHide) then
        self._spriteWeapon:setVisible(true)
    
        if update and self._actionWeaponInfo then
            local frame = self._actionWeaponInfo:getSpriteFrame(self._nextFrameIndex)
            if frame then                
                -- frame.path frame.sprite
                local sprite = frame.sprite

                if self:hasBuffer(BuffEnum.EFFECT_CLASS_DANCING_SWORD) 
                    or self:hasBuffer(BuffEnum.EFFECT_CLASS_GHOST_BLADE) then
                    self:weaponFadeOutEffect(self._nextFrameIndex)
                end

                self._spriteWeapon:setSpriteFrame(sprite)
                self._weaponPixelSize = ResUtil:getPlistPixelSize(sprite)
                local texture = self._spriteWeapon:getTexture()
                texture:setAliasTexParameters()

                local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
                self._spriteWeapon:setPosition(pos)

                -- 更新武器影子
                if self._shadowActor and self._shadowActor.onUpdateWeaponFrame then
                    self._shadowActor:onUpdateWeaponFrame(self._nextFrameIndex)
                end
            end
        end
    else
        self._spriteWeapon:setVisible(false)
        if self._shadowActor and self._shadowActor.hideWeaponSprite then
            self._shadowActor:hideWeaponSprite()
        end
        for k, v in pairs(self._weaponSpriteEffects) do
            v:setVisible(false)
        end
    end
end


function HeroActor:weaponFadeOutEffect(frame)
    
    local maxShadow = math.min( frame, 5 );
    --1
    for f=1, maxShadow do
        local frame = self._actionWeaponInfo:getSpriteFrame(self._nextFrameIndex - f)

        -- if not frame then 
        --     -- frame = self._actionWeaponInfo:getSpriteFrame(self._nextFrameIndex)
        --     print("当前f",f,self._nextFrameIndex, self._nextFrameIndex - f)
        -- end

        if frame then
            self._weaponSpriteEffects[f]:setSpriteFrame(frame.sprite)
            local texture = self._weaponSpriteEffects[f]:getTexture()
            texture:setAliasTexParameters()
            local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
            self._weaponSpriteEffects[f]:setPosition(pos)

            ShaderBackendUtil:makeWeaponEffect(self._weaponSpriteEffects[f], {targetColor = cc.vec3(0.0, 1.0, 0.0), black = EffectEnum.DARKBITS[f]})

            self._weaponSpriteEffects[f]:setVisible(true)
        else
            self._weaponSpriteEffects[f]:setVisible(false)
        end

    end
  
end

-- shield action
function HeroActor:updateShieldFrame(update)
    local isHide = false
    local agent = self:getAgent()
    if agent then
        if agent:getIsHallu() then  -- 迷幻术 不显示盾
            isHide = true
        end
    end
    local mountId = self._roleData:getMountId()
    if Constant.MOUNT_ADVANCED_ITEMS2[mountId] then
        isHide = true
    end

    if  self._shieldId ~= 0 and (not self:getHideSprite()) and (not isHide) then 
        self._spriteShield:setVisible(true)
        if update then
            local frame = self._actionShieldInfo:getSpriteFrame(self._nextFrameIndex)
            if frame then
                -- self._spriteShield:setSpriteFrame(frame)
                -- frame.path frame.sprite
                local sprite = frame.sprite
                self._spriteShield:setSpriteFrame(sprite)
                self._shieldPixelSize = ResUtil:getPlistPixelSize(sprite)

                local texture = self._spriteShield:getTexture()
                texture:setAliasTexParameters()

                local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
                self._spriteShield:setPosition(pos)

                -- 更新盾牌影子
                if self._shadowActor and self._shadowActor.onUpdateShieldFrame then
                    self._shadowActor:onUpdateShieldFrame(self._nextFrameIndex)
                end
            end
        end
    else
        self._spriteShield:setVisible(false)
        if self._shadowActor and self._shadowActor.hideShieldSprite then
            self._shadowActor:hideShieldSprite()
        end
    end
end

-- 坐骑
function HeroActor:updateMountFrame(update)
    local isHide = false
    local agent = self:getAgent()
    if agent then
        if agent:getIsHallu() then  -- 迷幻术 不显示坐骑
            isHide = true
        end
    end
    
    local mountId = self._roleData:getMountId()
    if mountId ~= 0 and self._actionMountInfo and (not self:getHideSprite()) and (not isHide) then 
        self._spriteMount:setVisible(true)
        if update then
            local frame = self._actionMountInfo:getSpriteFrame(self._nextFrameIndex)
            if frame then
                local sprite = frame.sprite
                self._spriteMount:setSpriteFrame(sprite)

                local texture = self._spriteMount:getTexture()
                texture:setAliasTexParameters()

                local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
                self._spriteMount:setPosition(pos)
                

                -- 更新坐骑影子
                if self._shadowActor and self._shadowActor.onUpdateMountFrame then
                    self._shadowActor:onUpdateMountFrame(self._nextFrameIndex)
                end
            end
        end
    else
        self._spriteMount:setVisible(false)
        if self._shadowActor and self._shadowActor.hideMountSprite then
            self._shadowActor:hideMountSprite()
        end
    end
end

-- override
function HeroActor:_setDirection(direction)
    HeroActor.super._setDirection(self, direction)

    -- 设置层级
    self:updateFrameZOrder()
    self:changeBindingEffectDir()
    self:changeRotateEffectDir()
end

-- 设置层级
function HeroActor:updateFrameZOrder()
    local baseZOrder = 2 --基础模型层级
    for order, nodeIndex in ipairs(AddonOrder[self._direction] or {}) do
        local zorder = nil
        if self._direction == 2 or self._direction == 6 then
            zorder = baseZOrder + 1
        else
            if order == 1 then
                zorder = baseZOrder - 1 
            elseif order == 2 then
                zorder = baseZOrder + 1
            end
        end
        self._handsNode[nodeIndex]:setLocalZOrder(zorder)
    end

    ----------------------------------------------------------------------------------
    -- 非盾牌武器层级设置
    if self._roleData:isOusters() then
        -- 魔族层级限制
        self._spriteWeapon:setLocalZOrder(self._weaponZorder)
    else
        -- 非魔族层级限制
        if self._direction == Constant.DIRECTION_UP or
        self._direction == Constant.DIRECTION_LEFT_UP or
        self._direction == Constant.DIRECTION_LEFT or
        self._direction == Constant.DIRECTION_LEFT_DOWN then
            local  weaponZOrdr = 0
            if self._direction == Constant.DIRECTION_UP then
                weaponZOrdr = self._weaponZorder
            else
                weaponZOrdr = 1
            end
            self._spriteWeapon:setLocalZOrder(weaponZOrdr)
            for i,v in ipairs(self._weaponSpriteEffects) do
                v:setLocalZOrder(weaponZOrdr - 1)
            end
        else
            self._spriteWeapon:setLocalZOrder(self._weaponZorder)
            for i,v in ipairs(self._weaponSpriteEffects) do
                v:setLocalZOrder(2)
            end
        end
    end

    ----------------------------------------------------------------------------------
    -- 盾牌武器层级设置
    if self._direction == Constant.DIRECTION_DOWN or
       self._direction == Constant.DIRECTION_LEFT_DOWN or
       self._direction == Constant.DIRECTION_LEFT or
       self._direction == Constant.DIRECTION_LEFT_UP or
       self._direction == Constant.DIRECTION_UP then
        self._spriteShield:setLocalZOrder(self._weaponZorder)
    else
        self._spriteShield:setLocalZOrder(1)
    end

    self:updateEffectZOrder()
end

function HeroActor:updateZorderEffectZorder()
    if self._direction == Constant.DIRECTION_UP
    or self._direction == Constant.DIRECTION_LEFT
    or self._direction == Constant.DIRECTION_LEFT_UP
    or self._direction == Constant.DIRECTION_RIGHT_UP then
        self._zorderEffectNode:setLocalZOrder(1)
    else
        self._zorderEffectNode:setLocalZOrder(3)
    end
end
function HeroActor:updateEffectZOrder()
    if not self:getAgent() then
        return
    end

    -- 人族
    -- 更新 快速恢复 心脏层级
    local buff = self:hasBuffer(BuffEnum.EFFECT_HEART_CATALYST)
    if buff then
        self:updateZorderEffectZorder()

        local effectActor = self:getZorderEffect(SkillEnum.SKILL_HEART_CATALYST)
        if effectActor then
            effectActor:changeDirection(self._direction)
        end
    end

    -- 魔族
    -- 更新 召唤-精灵 转职前
    local buff = self:hasBuffer(BuffEnum.EFFECT_SUMMON_SYLPH)
    if buff then
        self._zorderEffectNode:setLocalZOrder(3)

        local effectActor = self:getZorderEffect(SkillEnum.SKILL_SUMMON_SYLPH)
        if effectActor then
            effectActor:changeDirection(self._direction)
        end
    end
end

