function HeroActor:refreshHelmetBodyPants()
    self._roleData:clearModelName()
    local isSlayer = self._roleData:isSlayer()
    if isSlayer then
        self._helmetName, self._modelName, self._pantsName, self._hairName = self._roleData:getModelName()
        self._helmetShadowName, self._modelShadowName, self._pantsShadowName, self._hairShadowName = self._roleData:getModelShadowName()
    else
        self._modelName = self._roleData:getModelName()
        self._modelShadowName = self._roleData:getModelShadowName()
    end
    
    -- 人族需改变头发数据
    if self._heroSlayerActor then
        self._heroSlayerActor:changeHelmetName(self._helmetName)
        self._heroSlayerActor:changePantsName(self._pantsName)
        self._heroSlayerActor:changeHairName(self._hairName)
    end
    self:initActionInfoHero()
end

function HeroActor:changeFaceShape()
    self:refreshHelmetBodyPants()
end

function HeroActor:changeSex()
    self:refreshHelmetBodyPants()
end

function HeroActor:changeTitleAppr(titleId)
    self._nameNode:updateTitleAppr(self._roleData)
end

function HeroActor:changeBodyAppr()
    self:refreshHelmetBodyPants()
end

function HeroActor:changeHelmet()
    self:refreshHelmetBodyPants()
end

function HeroActor:changeTrousers()
    self:refreshHelmetBodyPants()
end

