local OptionInfoDao = {}

function OptionInfoDao:query(type)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM OptionInfo WHERE Type=%d;", tonumber(type))) do
    	local meta = lt.OptionInfoMeta.new(row)
        return meta
    end
end

function OptionInfoDao:queryAll()
    local optionInfoMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM OptionInfo") do
        local meta = lt.OptionInfoMeta.new(row)
        optionInfoMap[meta:getType()] = meta
    end
    return optionInfoMap
end

return OptionInfoDao