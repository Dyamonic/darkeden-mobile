---@class UICompTransactionSellCell
--- 交易行  单个售卖物品结构
local UICompTransactionSellCell = class("UICompTransactionSellCell", lt.UIGButtonBase)

local NtfManager                = lt.NtfManager
local CacheManager              = lt.CacheManager
local ItemModule                = lt.ItemModule
local Constant                  = lt.Constant
local TransactionModule         = lt.TransactionModule
local TimeCounter               = lt.TimeCounter

UICompTransactionSellCell.ChangeSkinConf = {
    ["Transaction"] = {
        ["btn"] = "bg_pmh_djkdiban02",
        ["bg_txt"] = "bg_pmh_wzbtmdiban02",
    }
}


function UICompTransactionSellCell:ctor()
    UICompTransactionSellCell.super.ctor(self)
    --UI
    self._icon = nil
    self._lblCount = nil
    self._lblName = nil
    self._lblPrice = nil
    self._rareImg = nil
    self._expireImg = nil
    self._showImg = nil
    self._btnClick = nil
    --数据
    self._data = nil
    self._sprite = nil
end

function UICompTransactionSellCell:onClear()
    --UI
    if self._btnClick then
        self._btnClick:removeClickListener()
        self._btnClick = nil
    end
    self._icon = nil
    self._lblCount = nil
    self._lblName = nil
    self._lblPrice = nil
    self._rareImg = nil
    self._expireImg = nil
    self._showImg = nil
    --数据
    self._data = nil
    self._sprite = nil
    UICompTransactionSellCell.super.onClear(self)
end

function UICompTransactionSellCell:onConstruct()
    self._icon = self:getChild("icon")
    self._lblCount = self:getChild("lbl_count")
    self._lblName = self:getChild("lbl_name")
    self._lblPrice = self:getChild("lbl_price")
    self._rareImg = self:getChild("img_rare")
    self._expireImg = self:getChild("img_expire")
    self._showImg = self:getChild("img_show")
    self._btnClick = self:getChild("btn")
end

function UICompTransactionSellCell:onEnter()
    UICompTransactionSellCell.super.onEnter(self)
    self._btnClick:addClickListener(handler(self, self.onBtnClick))
end

function UICompTransactionSellCell:onExit()
    self._btnClick:removeClickListener()
    UICompTransactionSellCell.super.onExit(self)
end

function UICompTransactionSellCell:setObjInfo(data)
    self._data = data
    local itemInfo = ItemModule:getItemDataByProperty(data.objProperty)
    local sid = itemInfo:getItemId()
    local itemType = itemInfo:getItemType()
    local itemMeta = nil
    local iconPath = ""
    
    if self._sprite then
        self._sprite:removeFromParent()
        self._sprite = nil
    end

    if itemType == Constant.ItemType.ITEM_TYPE_PROP then
        itemMeta = CacheManager:getItemMeta(sid)
        iconPath = "prop"
        local resUrl = string.format("ui://Item/%s_%s", iconPath, itemMeta:getIconId())
        self._icon:setURL(resUrl)
        self._icon:setVisible(true)
    elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
        iconPath = "equip"
        itemMeta = CacheManager:queryEquipMeta(sid)
        local resUrl = string.format("ui://Item/%s_%s", iconPath, itemMeta:getIconId())
        self._icon:setURL(resUrl)
        self._icon:setVisible(false)

        local iconId = itemMeta:getIconId()
        if iconId then
            local affixId = itemInfo:getFirstAffixId() or 0
            local affixLevel = itemInfo:getFirstAffixLevel() or 0
            local sprite = lt.CommonFunc.createEquipById(iconId,affixId,affixLevel)
            self:displayObject():addChild(sprite)
            local pos = self._icon:getPosition()
            sprite:setPosition(pos.x,self:getSize().height-pos.y)
            self._sprite = sprite
        end
    end
    
    --缩放尺寸
    local itemSize = self._icon:getSize()
    local heightS = 50 / itemSize.height
    local widthS = 50 / itemSize.width
    local scale = heightS
    if widthS < heightS then
        scale = widthS
    end
    self._icon:setScale(scale, scale)
    if self._sprite then
        self._sprite:setScale(scale)
    end
    self._lblName:setText(itemMeta and itemMeta:getName() or "")
    local meta = TransactionModule:getTransactionDataByItemIdAndType(sid, itemType)
    self._rareImg:setVisible(meta:getAnnounce() == 1)
    self._showImg:setVisible(data.IsBidding == 1)
    self._expireImg:setVisible(data.IsBidding ~= 1)
    if data.IsBidding == 0 then
        local serverTime = TimeCounter:serverTime()
        local lastSeconds = self._data.downTimeStamp - serverTime
        self._expireImg:setVisible(lastSeconds <= 0)
    end
    self._lblPrice:setText(data.sellPrice .. GReadText.KEY_SHOPPING_TIPS1)
    self._lblCount:setText(itemInfo:getNum())
end

function UICompTransactionSellCell:onBtnClick()
    -- 下架
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW,
        { class = "UIWndTransactionDownTips", itemInfo = self._data })
end

return UICompTransactionSellCell
