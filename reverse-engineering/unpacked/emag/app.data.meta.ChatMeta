local ChatMeta   = class("ChatMeta")

local CommonFunc = lt.CommonFunc

function ChatMeta:ctor(row)
    self:initWithRow(row)
end

function ChatMeta:initWithRow(row)
    self._chatType = row.chatType
    self._name     = row.name
    self._level    = row.level
    self._recharge = row.recharge
    self._number   = row.number
    self._time     = row.time
    if row.cost == "" then
        self._cost = nil
    else
        self._cost = CommonFunc:analysisJsonToTable(row.cost, true)
    end
end

function ChatMeta:getChatCost()
    return self._cost
end

-- AUTO GENERATED GETTERS START
-- 以下方法由脚本自动生成，请勿手动修改

function ChatMeta:getChatType() return self._chatType end
function ChatMeta:getName() return self._name end
function ChatMeta:getLevel() return self._level end
function ChatMeta:getRecharge() return self._recharge end
function ChatMeta:getNumber() return self._number end
function ChatMeta:getTime() return self._time end
function ChatMeta:getCost() return self._cost end

-- AUTO GENERATED GETTERS END
return ChatMeta
