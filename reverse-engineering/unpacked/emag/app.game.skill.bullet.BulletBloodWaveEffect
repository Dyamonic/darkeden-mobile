local BulletBloodWaveEffect = class("BulletBloodWaveEffect", lt.BulletBase)
local EffectActor = lt.EffectActor
--[[
   血浪技能效果
]]
local CacheManager = lt.CacheManager
local ScheduleUtil = lt.ScheduleUtil

function BulletBloodWaveEffect:ctor(skillId, direction, releaseXY)
    BulletBloodWaveEffect.super.ctor(self, skillId)
    self._skillId = skillId
    self._direction = direction
    self.releaseXY = releaseXY
    self._effectActor = nil
    self:setAnchorPoint(cc.p(0.5, 0.5))
    self:setPosition(releaseXY)
end

function BulletBloodWaveEffect:onClear()
    if self._effectActor then
        self._effectActor:onClear()
        self._effectActor = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end

function BulletBloodWaveEffect:setPositionEx(x, y)
    self:setPosition(x, y)
end

function BulletBloodWaveEffect:onUpdate()
    self._effectActor:onUpdateEffect()
end

function BulletBloodWaveEffect:addEffect(skillId, meta)
    if not meta then
        yflog:Info("BulletBloodWaveEffect:addEffect the skill:%d has no skill effect meta", skillId)
        return
    end
    self._effectActor = EffectActor.new(meta, self._direction, nil, false)
    self:addChild(self._effectActor)
end

