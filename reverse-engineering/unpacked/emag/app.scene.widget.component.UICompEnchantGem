---@class UICompEnchantGem
---
local UICompEnchantGem = class("UICompEnchantGem", lt.UIGButtonBase, lt.UICompChangeSkin)

local ItemModule = lt.ItemModule

UICompEnchantGem.ChangeSkinConf = {
    ["Strengthen"] = {
        ["img_bg"] = "bg_zhuangbei_kuang4",
    },
}

function UICompEnchantGem:ctor()
    UICompEnchantGem.super.ctor(self)
    --UI
    self._emptyNode = nil
    self._selectImg = nil
    self._item = nil
end

function UICompEnchantGem:onClear()
    --UI
    self._emptyNode = nil
    self._selectImg = nil
    self._item = nil
end

function UICompEnchantGem:onConstruct()
    self:startSkin()
    self._emptyNode = self:getChild("node_empty")
    self._item = fgui.UIPackage:createObject("Item", "Item")
    self._item:setPosition(-4, -4)
    self._item:setScale(0.9, 0.9)
    self._emptyNode:addChild(self._item)
    self._selectImg = self:getChild("img_select")
end

function UICompEnchantGem:setInfo(itemInfo, gemInfo)
    self._item:insertObjectToFactory(self:getRegClass())
    local gemId = gemInfo:getItemId()
    local gemNum = ItemModule:getItemNum(gemId)
    self._item:setInfo(string.format(_GURL.GetImageItem, gemId))
    self._item:setItemNums(gemNum)
    self._item:setGrayed(gemNum <= 0)
    self._item:setIconScale(1.5, 1.5)
    -- if gemNum > 0 then
    --     local canUse = StrengthenModule:suitEnchantGem(itemInfo, gemInfo)
    --     self._item:setRed(not canUse)
    -- end
end

function UICompEnchantGem:changeSelect(select)
    self._selectImg:setVisible(select)
end

return UICompEnchantGem