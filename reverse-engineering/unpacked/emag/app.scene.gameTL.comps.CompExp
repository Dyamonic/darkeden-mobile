---@class CompExp 主界面-右下角经验
local CompExp = class("CompExp", lt.UICompBase)

local Constant = lt.Constant
local RaceType = Constant.RaceType
local GameModule = lt.GameModule
local NtfManager = lt.NtfManager
local CacheManager = lt.CacheManager
local CommonFunc = lt.CommonFunc

local MaxBars = 6
CompExp.ATTR_TYPE = { -- 属性类型
    POWER        = 1, -- 力量
    AGILE        = 2, -- 敏捷
    INTELLIGENCE = 3, -- 智力
}

function CompExp:ctor(view)
    CompExp.super.ctor(self)
    self._view = view

    self._race = GameModule:getHeroRace()
    self._curCom = nil
    self._expBars = {}

    self:initUI()
end

function CompExp:onEnter()
    for index, bar in ipairs(self._expBars) do
        bar:addClickListener(function()
            self:showExpTips(index)
        end)
    end
    if self._touchBtnV then
        self._touchBtnV:addClickListener(function()
            self:showOtherExpTips()
        end)
    end
    if self._touchBtnO then
        self._touchBtnO:addClickListener(function()
            self:showOtherExpTips()
        end)
    end
end

function CompExp:onExit()
    for _, bar in ipairs(self._expBars) do
        bar:removeClickListener()
    end
    if self._touchBtnV then
        self._touchBtnV:removeClickListener()
    end
    if self._touchBtnO then
        self._touchBtnO:removeClickListener()
    end
end

function CompExp:onClear()
    for i, _ in ipairs(self._expBars) do
        self._expBars[i] = nil
    end
    self._expBars = nil
    self._view = nil
    self._curCom = nil
    self._touchBtnV = nil
    self._touchBtnO = nil
end

function CompExp:initUI()
    if self._race == RaceType.Slayer then
        self._curCom = fgui.UIPackage:createObject("Main", "CompExpS")
        for i = 1, MaxBars do
            local touchBtn = self._curCom:getChild("touch"..i)
            table.insert(self._expBars, touchBtn)
        end
    elseif self._race == RaceType.Vampire then
        self._curCom = fgui.UIPackage:createObject("Main", "CompExpV")
        self._touchBtnV = self._curCom:getChild("touch")
    elseif self._race == RaceType.Ousters then
        self._curCom = fgui.UIPackage:createObject("Main", "CompExpO")
        self._touchBtnO = self._curCom:getChild("touch")
    end

    if not self._curCom then
        return
    end

    self._view:addChild(self._curCom)
end

function CompExp:refreshHeroExp()
    if not self._curCom then
        return
    end
    
    if self._race == RaceType.Slayer then
        self:refreshCompExpS()
    elseif self._race == RaceType.Vampire then
        self:refreshCompExpV()
    elseif self._race == RaceType.Ousters then
        self:refreshCompExpO()
    end
end

-- 人族经验刷新
function CompExp:refreshCompExpS()
    local heroData = GameModule:getHeroData()
    if not heroData then
        return
    end
    local domainList = heroData:calculationDomainPercent()
    -- 数值显示
    local value1 = heroData:getTotalSTR()
    local value2 = heroData:getTotalDEX()
    local value3 = heroData:getTotalINT()
    local value4 = (domainList[1] or {}).level or 0
    local value5 = (domainList[2] or {}).level or 0
    local value6 = (domainList[3] or {}).level or 0
    local name4 = GReadText["KEY_DOMAIN_NAME" .. ((domainList[1] or {}).domain or "")]
    local name5 = GReadText["KEY_DOMAIN_NAME" .. ((domainList[2] or {}).domain or "")]
    local name6 = GReadText["KEY_DOMAIN_NAME" .. ((domainList[3] or {}).domain or "")]
    local textTable = {
        { name = "value1", value = value1 },
        { name = "value2", value = value2 },
        { name = "value3", value = value3 },
        { name = "value4", value = value4 },
        { name = "value5", value = value5 },
        { name = "value6", value = value6 },
        { name = "name4", value = name4 },
        { name = "name5", value = name5 },
        { name = "name6", value = name6 },
    }

    for _,v in pairs(textTable) do
        local nameT = self._curCom:getChild(v.name)
        nameT:setText(v.value)
    end

    -- 计算进度条
    local barValue1 = heroData:calculationPercent(1)
    local barValue2 = heroData:calculationPercent(2)
    local barValue3 = heroData:calculationPercent(3)
    local barValue4 = (domainList[1] or {}).percent or 0
    local barValue5 = (domainList[2] or {}).percent or 0
    local barValue6 = (domainList[3] or {}).percent or 0

    local barTable = {
        { name = "bar1", text = "exp1", value = barValue1 },
        { name = "bar2", text = "exp2", value = barValue2 },
        { name = "bar3", text = "exp3", value = barValue3 },
        { name = "bar4", value = barValue4 },
        { name = "bar5", value = barValue5 },
        { name = "bar6", value = barValue6 },
    }

    for _,v in pairs(barTable) do
        local nameT = self._curCom:getChild(v.name)
        nameT:setFillAmount(v.value)
        if v.text then
            self._curCom:getChild(v.text):setText(math.floor(v.value*100).."%")
        end
    end
end

-- 吸血鬼经验刷新
function CompExp:refreshCompExpV()
    local heroData = GameModule:getHeroData()

    -- 数值显示
    local level = heroData:getLevel()
    local value1 = table.concat({heroData:getTotalSTR() , "/" , heroData:getTotalSTR()})
    local value2 = table.concat({heroData:getTotalDEX() , "/" , heroData:getTotalDEX()})
    local value3 = table.concat({heroData:getTotalINT() , "/" , heroData:getTotalINT()})
    local value4 = heroData:getPureSTR()
    local value5 = heroData:getPureDEX()
    local value6 = heroData:getPureINT()
    local textTable = {
        { name = "level",  value = level },
        { name = "value1", value = value1 },
        { name = "value2", value = value2 },
        { name = "value3", value = value3 },
        { name = "value4", value = value4 },
        { name = "value5", value = value5 },
        { name = "value6", value = value6 }
    }

    for _,v in pairs(textTable) do
        local nameT = self._curCom:getChild(v.name)
        nameT:setText(v.value)
    end

    -- 经验条
    local barTable = {
        { name = "barLevel", value = level/Constant.TransferLevel },
    }

    for _,v in pairs(barTable) do
        local nameT = self._curCom:getChild(v.name)
        nameT:setFillAmount(v.value)
    end
end

-- 魔族经验刷新
function CompExp:refreshCompExpO()
    local heroData = GameModule:getHeroData()

    -- 数值显示
    local level = heroData:getLevel()
    local fire = heroData:getFireSpiritLevel()
    local water = heroData:getWaterSpiritLevel()
    local earth = heroData:getEarthSpiritLevel()
    local textTable = {
        { name = "level", value = string.format(GReadText.KET_EXP_TIPS1, level) },
        { name = "fire",  value = string.format(GReadText.KET_EXP_TIPS3, fire) },
        { name = "water", value = string.format(GReadText.KET_EXP_TIPS2, water) },
        { name = "earth", value = string.format(GReadText.KET_EXP_TIPS4, earth) },
    }

    for _,v in pairs(textTable) do
        local nameT = self._curCom:getChild(v.name)
        nameT:setText(v.value)
    end

    -- 经验条
    local barTable = {
        { name = "barLevel", value = level/Constant.TransferLevel },
        { name = "barFire",  value = fire/Constant.ElementMax },
        { name = "barWater", value = water/Constant.ElementMax },
        { name = "barEarth", value = earth/Constant.ElementMax },
    }

    for _,v in pairs(barTable) do
        local nameT = self._curCom:getChild(v.name)
        nameT:setFillAmount(v.value)
    end
end

function CompExp:addAllListener()
    self:refreshHeroExp()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_HERO_EVENT, handler(self, self.refreshHeroExp), "CompExp:refreshHeroExp")
    -- print("------->>>>>>>CompExp:addAllListener")
end

function CompExp:removeAllListener()
    NtfManager:removeNtfListenerByTag("CompExp:refreshHeroExp")
    -- print("------->>>>>>>CompExp:removeAllListener")
end

function CompExp:showExpTips(idx)
    local expBar = self._curCom:getChild("bar"..idx)
    local point = expBar:localToGlobal({x=0,y=0})
    local expStr = ""
    local heroData = GameModule:getHeroData()
    if idx == self.ATTR_TYPE.POWER or idx == self.ATTR_TYPE.AGILE or idx == self.ATTR_TYPE.INTELLIGENCE then
        local percent = math.floor(heroData:calculationPercent(idx)*100)
        local lastExp = heroData:calculationPercent(idx, true)
        expStr = ""
        if idx == self.ATTR_TYPE.POWER then
            expStr = expStr..GReadText.KEY_STRENGTHEN_TIPS63..GReadText.KEY_ROLE_INFO_TIPS32
        elseif idx == self.ATTR_TYPE.AGILE then
            expStr = expStr..GReadText.KEY_STRENGTHEN_TIPS64..GReadText.KEY_ROLE_INFO_TIPS32
        else
            expStr = expStr..GReadText.KEY_STRENGTHEN_TIPS65..GReadText.KEY_ROLE_INFO_TIPS32
        end
        expStr = expStr .. CommonFunc:changeNumberShow(lastExp) .. "("..percent.."%)"
    else
        local domainList = heroData:calculationDomainPercent()
        local percent = math.floor(((domainList[idx-3] or {}).percent or 0)*100)
        local lastExp = (domainList[idx-3] or {}).lastExp or 0
        local domain = (domainList[idx-3] or {}).domain
        expStr = expStr..GReadText["KEY_DOMAIN_NAMES_"..domain]..GReadText.KEY_ROLE_INFO_TIPS32
        expStr = expStr .. CommonFunc:changeNumberShow(lastExp) .. "("..percent.."%)"
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_TEXT_TIPS,
    {
        content = expStr,
        pt = point,
        pivot = cc.p(0.5, 0.5)
    })
end

function CompExp:showOtherExpTips()
    local expBar = self._curCom:getChild("barLevel")
    local point = expBar:localToGlobal({x=0,y=0})
    local heroData = GameModule:getHeroData()
    local level = heroData:getLevel()
    local expMeta = CacheManager:getLevelExpInfoMeta(level) or {}
    local maxExp = expMeta:getExp() or 1
    local curExp = heroData:getExp()
    local exp = CommonFunc:changeNumberShow(maxExp - curExp)
    local precent = curExp/maxExp
    local expStr = table.concat({
        GReadText["KEY_ROLE_INFO_TIPS41"] , exp , "(" , math.floor(precent*100) , "%)"
    })
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_TEXT_TIPS,
    {
        content = expStr,
        pt = point,
        pivot = cc.p(0.5, 0.5)
    })
end

return CompExp