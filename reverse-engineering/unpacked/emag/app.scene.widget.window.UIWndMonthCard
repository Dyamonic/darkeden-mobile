--- 月卡
---@class UIWndMonthCard:UIWindowBase
local UIWndMonthCard = class("UIWndMonthCard", lt.UIWindowBase)

local NtfManager = lt.NtfManager
local CacheManager = lt.CacheManager
local Constant = lt.Constant
local GameModule = lt.GameModule
local ItemModule = lt.ItemModule
local CommonFunc = lt.CommonFunc
local RechargeModule = lt.RechargeModule
local TimeCounterManager = lt.TimeCounterManager

local MONTHCARD_PRICE = CacheManager:getVariableById(Constant.Variable.MonthCardPrice)
local MAXNUMBER = 4

function UIWndMonthCard:ctor(param)
    UIWndMonthCard.super.ctor(self, param)
    self._timeLabel = nil
    for i = 1, MAXNUMBER do
        self["_activeReward"..i] = nil
        self["_dailyReward"..i] = nil
        self["_activeItem"..i] = nil
        self["_dailyItem"..i] = nil
        self["_activeItemNum"..i] = nil
        self["_dailyItemNum"..i] = nil
    end
    self._buyBtn = nil
    self._buyBtnRed = nil
end

function UIWndMonthCard:onInit()
    self:registerComponent("UICompItem")
    UIWndMonthCard.super.onInit(self, _GURL.UIWndMonthCard)

    self:initUI()
end

function UIWndMonthCard:onShown()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_MONTH_CARD, handler(self, self.refreshView), "UIWndMonthCard:refreshView")
    self._buyBtn:addClickListener(handler(self, self.onBuyClick))
    for i = 1, MAXNUMBER do
        self["_activeItem"..i]:addClickListener(handler(self, self.onItemClick))
        self["_dailyItem"..i]:addClickListener(handler(self, self.onItemClick))
    end
    TimeCounterManager:startTimeCounter(TimeCounterManager.TC.MONTH_CARD_UPDATE, {callback = function()
        self:onUpdate()
    end})
    self:refreshView()
end

function UIWndMonthCard:onHide()
    NtfManager:removeNtfListenerByTag("UIWndMonthCard:refreshView")
    self._buyBtn:removeClickListener()
    for i = 1, MAXNUMBER do
        self["_activeItem"..i]:removeClickListener()
        self["_dailyItem"..i]:removeClickListener()
    end
    TimeCounterManager:stopTimeCounter(TimeCounterManager.TC.MONTH_CARD_UPDATE)
    UIWndMonthCard.super.onHide(self)
end

function UIWndMonthCard:onClear()
    self:unregisterAllComponent()
    self._timeLabel = nil
    for i = 1, MAXNUMBER do
        self["_activeReward"..i] = nil
        self["_dailyReward"..i] = nil
        self["_activeItem"..i] = nil
        self["_dailyItem"..i] = nil
        self["_activeItemNum"..i] = nil
        self["_dailyItemNum"..i] = nil
    end
    self._buyBtn = nil
    self._buyBtnRed = nil

    UIWndMonthCard.super.onClear(self)
end

function UIWndMonthCard:onUpdate(dt)
    self:refreshCountDown()
end

function UIWndMonthCard:initUI()
    self._timeLabel = self:getChild("lable_time")
    for i = 1, MAXNUMBER do
        self["_activeReward"..i] = self:getChild("activeReward"..i)
        self["_activeItem"..i] = fgui.UIPackage:createObject("Item", "Item")
        self["_activeItem"..i]:setPivot(0.5, 0.5, true)
        self["_activeItem"..i]:insertObjectToFactory(self)
        self["_activeReward"..i]:getChild("node_item"):addChild(self["_activeItem"..i])
        self["_activeItemNum"..i] = self["_activeReward"..i]:getChild("num")
        self["_dailyReward"..i] = self:getChild("dailyReward"..i)
        self["_dailyItem"..i] = fgui.UIPackage:createObject("Item", "Item")
        self["_dailyItem"..i]:setPivot(0.5, 0.5, true)
        self["_dailyItem"..i]:insertObjectToFactory(self)
        self["_dailyReward"..i]:getChild("node_item"):addChild(self["_dailyItem"..i])
        self["_dailyItemNum"..i] = self["_dailyReward"..i]:getChild("num")
    end
    self._buyBtn = self:getChild("btn_buy")
    self._buyBtnRed = self._buyBtn:getChild("red")
end

function UIWndMonthCard:refreshView()
    --奖励
    local monthCardActiveAwards = CacheManager:getMonthCardActiveAwards()
    local monthCardDailyAwards = CacheManager:getMonthCardDailyAwards()
    for i = 1, MAXNUMBER do
        --立刻获得奖励
        local activeReward = monthCardActiveAwards[i]
        if activeReward then
            if activeReward[1] == Constant.ItemType.ITEM_TYPE_PROP then
                local itemMeta = CacheManager:getItemMeta(activeReward[2])
                local itemInfo = ItemModule:getItemDataByConfig(itemMeta, nil, activeReward[3])
                self["_activeItem"..i]:setItemInfo(itemInfo)
                self["_activeItem"..i]:setItemNums("")
                self["_activeItemNum"..i]:setText(CommonFunc:convertLargerNumber(activeReward[3]))
            else
                local equipMeta = CacheManager:queryEquipMeta(activeReward[2])
                local itemInfo = ItemModule:getItemDataByConfig(equipMeta, nil, activeReward[3])
                self["_activeItem"..i]:setItemInfo(itemInfo)
                self["_activeItem"..i]:setItemNums("")
                self["_activeItemNum"..i]:setText(CommonFunc:convertLargerNumber(activeReward[3]))
            end
            self["_activeReward"..i]:setVisible(true)

            local itemSize = self["_activeItem"..i]:getSize()
            local heightS = 50 / itemSize.height
            local widthS = 50 / itemSize.width
            local scale = heightS
            if widthS < heightS then
                scale = widthS
            end
            self["_activeItem"..i]:setScale(scale, scale)
        else
            self["_activeReward"..i]:setVisible(false)
        end
        --每日获得奖励
        local dailyReward = monthCardDailyAwards[i]
        if dailyReward then
            if dailyReward[1] == Constant.ItemType.ITEM_TYPE_PROP then
                local itemMeta = CacheManager:getItemMeta(tonumber(dailyReward[2]))
                local itemInfo = ItemModule:getItemDataByConfig(itemMeta, nil, dailyReward[3])
                self["_dailyItem"..i]:setItemInfo(itemInfo)
                self["_dailyItem"..i]:setItemNums("")
                self["_dailyItemNum"..i]:setText(CommonFunc:convertLargerNumber(dailyReward[3]))
            else
                local equipMeta = CacheManager:queryEquipMeta(tonumber(dailyReward[2]))
                local itemInfo = ItemModule:getItemDataByConfig(equipMeta, nil, dailyReward[3])
                self["_dailyItem"..i]:setItemInfo(itemInfo)
                self["_dailyItem"..i]:setItemNums("")
                self["_dailyItemNum"..i]:setText(CommonFunc:convertLargerNumber(dailyReward[3]))
            end
            self["_dailyReward"..i]:setVisible(true)

            local itemSize = self["_dailyItem"..i]:getSize()
            local heightS = 50 / itemSize.height
            local widthS = 50 / itemSize.width
            local scale = heightS
            if widthS < heightS then
                scale = widthS
            end
            self["_dailyItem"..i]:setScale(scale, scale)
        else
            self["_dailyReward"..i]:setVisible(false)
        end
    end

    local isMonthCard = RechargeModule:checkMonthCard()
    if not isMonthCard then
        --未购买
        self._buyBtn:setText(MONTHCARD_PRICE..GReadText.KEY_ACTIVITY_RMB_TIP)
        local totalTime = CacheManager:getVariableById(Constant.Variable.MonthCardAddDay)
        self._timeLabel:setText(string.format(GReadText.KEY_MONTHCARD_TIPS1, totalTime))
        self._buyBtnRed:setVisible(false)
    else
        local isReward = RechargeModule:getMonthCardRewardTime()
        if not isReward then
            --未领奖
            self._buyBtn:setText(GReadText.KET_MAIL_TIPS11)
            self._buyBtnRed:setVisible(true)
        else
            self._buyBtn:setText(string.format(GReadText.KEY_MONTHCARD_TIPS2, MONTHCARD_PRICE))
            self._buyBtnRed:setVisible(false)
        end
        self:refreshCountDown()
    end
end

function UIWndMonthCard:onBuyClick()
    local isMonthCard = RechargeModule:checkMonthCard()
    local productId = CacheManager:getVariableById(Constant.Variable.MonthRecharge)
    if not isMonthCard then
        --未购买
        RechargeModule:sendCreateOrder(tonumber(productId))
    else
        --已购买
        local isReward = RechargeModule:getMonthCardRewardTime()
        if not isReward then
            --未领奖
            RechargeModule:sendMonthCardReward()
        else
            RechargeModule:sendCreateOrder(tonumber(productId))
        end
    end  
end

function UIWndMonthCard:onItemClick(context)
    local sender = context:getSender()
    local itemInfo = sender:getItemInfo()
    if itemInfo:getItemType() == Constant.ItemType.ITEM_TYPE_PROP then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemInfo, tipsType = Constant.PROPTIPS_FORM.Display})
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo, tipsType = Constant.EquipShowTipsType.Display})
    end
end

--刷新倒计时
function UIWndMonthCard:refreshCountDown()
    local monthCardEndTime = RechargeModule:getMonthCardEndTime()
    if monthCardEndTime == 0 then
        return
    end
    local day, hour, minute, second = CommonFunc:secondsToTime(monthCardEndTime)
    if day < 10 then day = "0"..day end
    if hour < 10 then hour = "0"..hour end
    if minute < 10 then minute = "0"..minute end
    local timeStr = day..GReadText.KEY_TIME_DAY..hour..GReadText.KEY_TIME_HOUR..minute..GReadText.KEY_TIME_MIN
    self._timeLabel:setText(string.format(GReadText.KEY_MONTHCARD_TIPS3, timeStr))
end

return UIWndMonthCard