    转职后站立时人族的坐骑始终为1帧,此处需要添加转换
]]
function ActionActorMount:getSpriteFrame(idx)
    if not self._spriteFrameArray[idx] then
        return self._spriteFrameArray[1] 
    end

    return self._spriteFrameArray[idx]
end

