---@npc维修/镀银界面
---@class UIWndRepair:UIWindowBase
local UIWndRepair = class("UIWndRepair", lt.UIWindowBase)

local ItemModule = lt.ItemModule
local NtfManager = lt.NtfManager
local Constant = lt.Constant
local WndLockManager = lt.WndLockManager
local NpcModule = lt.NpcModule

UIWndRepair.ChangeSkinConf = {
    ["NPC"] = {
        ["img_bg"] = "bg_zbwx_zhuangbeidi",
    },
    ["Strengthen"] = {
        ["img_di"] = "bg_zhuangbei_di1",
    },
    ["CommonTL"] = {
        ["frame"] = {
            closeButton = {bg  = "bg_beibao_anniu01", bgup  = "bg_beibao_anniu02"},
        },
        ["confirm"] = {bg  = "sort"},
    }
}

function UIWndRepair:ctor(param)
    UIWndRepair.super.ctor(self, param)
    self._type = nil
    self._equipIcon = nil
    self._emptyLabel = nil
    self._statusNode = nil
    self._valueLabel1 = nil
    self._valueLabel2 = nil
    self._closeBtn = nil
    self._confirmBtn = nil
end

function UIWndRepair:onClear()
    self._type = nil
    self._equipIcon = nil
    self._emptyLabel = nil
    self._statusNode = nil
    self._valueLabel1 = nil
    self._valueLabel2 = nil
    self._closeBtn = nil
    self._confirmBtn = nil
    self._iconNode = nil
    if self._sprite then
        self._sprite:removeFromParent()
        self._sprite = nil
    end
    UIWndRepair.super.onClear(self)
end

function UIWndRepair:onInit()
    UIWndRepair.super.onInit(self, _GURL.RepairPanel)
    --只需初始化一次
    self:initUI()
end

function UIWndRepair:onShown()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_REPAIR_VIEW, handler(self, self.refreshRepair), "UIWndRepair:refreshRepair")
    --服务器回调相关
    NtfManager:addNtfListener(NtfManager.NTF.NTF_EQUIP_REPAIR, handler(self, self.equipRepair), "UIWndRepair:equipRepair")

    self._closeBtn:addClickListener(function()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndLock", close = true})
    end)

    self._confirmBtn:addClickListener(handler(self, self.onConfirmBtnClick))

    self._type = self:getParam().param.tabId or Constant.RepairType.Repair
    WndLockManager:setRepairType(self._type)
    self:refreshRepair()
end

function UIWndRepair:onHide()
    NtfManager:removeNtfListenerByTag("UIWndRepair:refreshRepair")
    --服务器回调相关
    NtfManager:removeNtfListenerByTag("UIWndRepair:equipRepair")

    self._closeBtn:removeClickListener()
    self._confirmBtn:removeClickListener()

    WndLockManager:clearRepairItemInfo()

    UIWndRepair.super.onHide(self)
end

function UIWndRepair:initUI()
    self._equipIcon = self:getChild("panel_icon")
    self._emptyLabel = self:getChild("label_empty")
    self._statusNode = self:getChild("node_status")
    self._valueLabel1 = self:getChild("label_value1")
    self._valueLabel2 = self:getChild("label_value2")
    
    self._closeBtn = self:getChild("frame"):getChild("closeButton")
    self._confirmBtn = self:getChild("confirm")
    self._iconNode = self:getChild("iconNode")

    self:refreshPanel()
end

-- 维修/镀银页面刷新逻辑
function UIWndRepair:refreshPanel()
    local target = WndLockManager:getRepairItemInfo()
    if target then
        local equipData = target:getItemInfo()

        if equipData:getItemType() == Constant.ItemType.ITEM_TYPE_EQUIP then
            -- local resUrl = string.format(_GURL.GetImageItemEquip, equipData:getIconId())
            -- self._equipIcon:setURL(resUrl)
            if self._sprite then
                self._sprite:removeFromParent()
                self._sprite = nil
            end
            local iconId = equipData:getIconId()
            if iconId then
                local affixId = equipData:getFirstAffixId() or 0
                local affixLevel = equipData:getFirstAffixLevel() or 0
                local sprite = lt.CommonFunc.createEquipById(iconId,affixId,affixLevel)
                self._iconNode:displayObject():addChild(sprite)
                self._sprite = sprite
                self._sprite:setScale(1.6)
            end
            
            local maxStatus = 0
            local curStatus = 0
            if WndLockManager:getRepairType() == Constant.RepairType.Repair then
                --耐久度
                maxStatus = equipData:getTotalDurability()
                curStatus = equipData:getDurability()
            else
                --镀银值
                maxStatus = equipData:getTotalSilverMax()
                curStatus = equipData:getSilver()
            end
            --修改界面文字
            local statusStr = self._type == Constant.RepairType.Repair and GReadText.KEY_NPC_REPAIR_TIPS1 or GReadText.KEY_NPC_REPAIR_TIPS7
            self._valueLabel1:setColor(curStatus < maxStatus and Constant.COLORS.red or Constant.COLORS.green)
            self._valueLabel1:setText(statusStr..curStatus.."/"..maxStatus)
            local costStr = self._type == Constant.RepairType.Repair and GReadText.KEY_NPC_REPAIR_TIPS2 or GReadText.KEY_NPC_REPAIR_TIPS8
            local costNum = self._type == Constant.RepairType.Repair and NpcModule:getRepairPrice(equipData) or NpcModule:getSliverPrice(equipData)
            local coinCount = ItemModule:getValueItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN)
            self._valueLabel2:setText(costStr..costNum)
            self._valueLabel2:setColor(coinCount >= costNum and Constant.COLORS.green or Constant.COLORS.red)
        else
            local resUrl = string.format(_GURL.GetImageItem, equipData:getIconId())
            self._equipIcon:setURL(resUrl)
            local effectParam = equipData:getItemMeta():getEffectParamJson()
            if effectParam and effectParam["Use"] then
                local maxStatus = effectParam["Use"][2]
                local curStatus = equipData:getUseCount()
                --修改界面文字
                local statusStr = self._type == Constant.RepairType.Repair and GReadText.KEY_NPC_REPAIR_TIPS1 or GReadText.KEY_NPC_REPAIR_TIPS7
                self._valueLabel1:setColor(curStatus < maxStatus and Constant.COLORS.red or Constant.COLORS.green)
                self._valueLabel1:setText(statusStr..curStatus.."/"..maxStatus)
                local costStr = self._type == Constant.RepairType.Repair and GReadText.KEY_NPC_REPAIR_TIPS2 or GReadText.KEY_NPC_REPAIR_TIPS8
                local costNum = (maxStatus - curStatus)*effectParam["Maintain"][2]
                local coinCount = ItemModule:getValueItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN)
                self._valueLabel2:setText(costStr..costNum)
                self._valueLabel2:setColor(coinCount >= costNum and Constant.COLORS.green or Constant.COLORS.red)
            end
        end
    else
        self._equipIcon:setURL("")
    end
    self._equipIcon:setVisible(target ~= nil)
    self._emptyLabel:setVisible(target == nil)
    self._emptyLabel:setText(self._type == Constant.RepairType.Repair and GReadText.KEY_NPC_REPAIR_TIPS5 or GReadText.KEY_NPC_REPAIR_TIPS6)
    self._statusNode:setVisible(target ~= nil)
    self._confirmBtn:setGrayed(target == nil)
    self._confirmBtn:setTouchable(target ~= nil)
    self._confirmBtn:setText(self._type == Constant.RepairType.Repair and GReadText.KEY_NPC_REPAIR_TIPS3 or GReadText.KEY_NPC_REPAIR_TIPS4)
end

function UIWndRepair:refreshRepair()
    self:refreshPanel()
end

function UIWndRepair:showTips(itemInfo)
    if not itemInfo then
        return
    end
    self:showEquipTips(itemInfo)
end

function UIWndRepair:showEquipTips(itemInfo)
    local tipsType = Constant.EquipShowTipsType.Repair
    if self._type == Constant.RepairType.Silver then
        tipsType = Constant.EquipShowTipsType.Silver
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo, tipsType = tipsType})
end

function UIWndRepair:onConfirmBtnClick()
    local target = WndLockManager:getRepairItemInfo()
    if target then
        local equipData = target:getItemInfo()
        if equipData then
            if self._type == Constant.RepairType.Repair then
                --维修
                if equipData:getItemType() == Constant.ItemType.ITEM_TYPE_EQUIP then
                    local maxStatus = equipData:getTotalDurability()
                    if maxStatus == 0 then
                        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_NPC_REPAIR_TIPS9})
                        return
                    end
                    local curStatus = equipData:getDurability()
                    if curStatus >= maxStatus then
                        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_NPC_REPAIR_TIPS10})
                        return
                    end
                    local costNum = NpcModule:getRepairPrice(equipData)
                    local enoughMoney = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN, costNum, {tips = true})
                    if enoughMoney then
                        --服务器交互
                        NpcModule:sendEquipRepair(0, 0, equipData:getItemUid())
                    end
                else
                    local effectParam = equipData:getItemMeta():getEffectParamJson()
                    if effectParam and effectParam["Use"] then
                        local maxStatus = effectParam["Use"][2]
                        if maxStatus == 0 then
                            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_NPC_REPAIR_TIPS9})
                            return
                        end
                        local curStatus = equipData:getUseCount()
                        if curStatus >= maxStatus then
                            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_NPC_REPAIR_TIPS10})
                            return
                        end
                        local costNum = (maxStatus - curStatus)*effectParam["Maintain"][2]
                        local enoughMoney = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN, costNum, {tips = true})
                        if enoughMoney then
                            --服务器交互
                            NpcModule:sendEquipRepair(2, 0, equipData:getItemUid())
                        end
                    end
                end
            else
                --镀银
                local maxStatus = equipData:getTotalSilverMax()
                local curStatus = equipData:getSilver()
                if maxStatus == 0 then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_NPC_REPAIR_TIPS15})
                    return
                end
                if curStatus >= maxStatus then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_NPC_REPAIR_TIPS11})
                    return
                end
                local costNum = NpcModule:getSliverPrice(equipData)
                local enoughMoney = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN, costNum, {tips = true})
                if enoughMoney then
                    --服务器交互
                    NpcModule:sendEquipRepair(1, 0, equipData:getItemUid())
                end
            end
        end
    end
end

--------------------服务器回调--------------------
function UIWndRepair:equipRepair(event)
    --更新一下数据
    local target = WndLockManager:getRepairItemInfo()
    if target then
        local param = event.param
        local newData = ItemModule:getEquipItemByUid(param.equipUid)
        if newData == nil then
            newData = ItemModule:getItemByUid(param.equipUid)
        end
        target.equipData = newData
        WndLockManager:setRepairItemInfo(target)
    end
    --更新角色装备界面
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_HERO_EQUIP_EVENT)
    --刷新界面
    self:refreshPanel()
    --成功提示
    local tips = self._type == Constant.RepairType.Repair and GReadText.KEY_NPC_REPAIR_TIPS13 or GReadText.KEY_NPC_REPAIR_TIPS14
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = tips})
end

return UIWndRepair