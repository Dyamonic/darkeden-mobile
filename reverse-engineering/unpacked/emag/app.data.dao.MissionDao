local MissionDao = {}

function MissionDao:query(missionId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Mission WHERE MissionId=%d;", tonumber(missionId))) do
    	local meta = lt.MissionMeta.new(row)
        return meta
    end
end

function MissionDao:queryAll()
    local map = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Mission") do
        local meta = lt.MissionMeta.new(row)
        map[meta:getMissionId()] = meta
    end
    return map
end

return MissionDao