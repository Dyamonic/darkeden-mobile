
local EquipUpgradeDao = {}

function EquipUpgradeDao:query(rank, level)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM EquipUpgrade WHERE Rank=%d and Level=%d;", rank, level)) do
        local equipUpgrade = lt.EquipUpgradeMeta.new(row)
        return equipUpgrade
    end
end

function EquipUpgradeDao:queryAll()
    local equipUpgradeTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM EquipUpgrade") do
        local equipUpgrade = lt.EquipUpgradeMeta.new(row)
        equipUpgradeTable[equipUpgrade:getRank().."_"..equipUpgrade:getLevel()] = equipUpgrade
    end
    return equipUpgradeTable
end

return EquipUpgradeDao
