-- 是否是护腕
function HeroData:isWristGuard()
    local weaponId = self:getWeapon()
    if type(weaponId) ~= "number" then
        return false
    end

    local equipmentInfo = lt.CacheManager:queryEquipMeta(weaponId)
    if not equipmentInfo then
       return false 
    end
    
    if Constant.WeaponType.WristGuard == equipmentInfo:getType() then
        return true
    end

    return false
end

