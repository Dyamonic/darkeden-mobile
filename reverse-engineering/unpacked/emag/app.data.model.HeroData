local HeroData = class("HeroData")
--[[
    玩家数据
]]

local Constant = lt.Constant
local ServerClientEnum = lt.ServerClientEnum
local CacheManager = lt.CacheManager
local NtfManager = lt.NtfManager
local ItemModule = lt.ItemModule
local SkillModule = lt.SkillModule
local StrengthenModule = lt.StrengthenModule
local TimeCounter = lt.TimeCounter
local CommonFunc = lt.CommonFunc

HeroData._objId               = nil
HeroData._propertyData        = nil
HeroData._helmet              = nil
HeroData._petObjId            = nil -- 拥有宠物
HeroData._scrollExp           = nil
HeroData._isNpc               = nil

function HeroData:ctor(objId, propertyArray)
    assert(objId ~= nil, "HeroData objId is nil !")

    self:setObjId(objId)

    self._propertyData = lt.PropertyData.new(propertyArray)
end

function HeroData:setPropertyArray(propertyArray)
    self._propertyData:setPropertyArray(propertyArray)
    --检查属性
    self:checkProperty(propertyArray)
end

function HeroData:isAlive()
    return self:getStatus() == Constant.HeroStatus.ALIVE
end

-- Setter && Getter
function HeroData:getObjId()
    return self._objId
end

function HeroData:setObjId(objId)
    self._objId = objId
end

function HeroData:setValue(key, value)
    self._propertyData:setValue(key, value)
end

function HeroData:getValue(key)
    return self._propertyData:getValue(key) or 0
end

function HeroData:getChangeValueByKey(key)
    return self._propertyData:getChangeValueByKey(key)
end

function HeroData:getPreValue(key)
    return self._propertyData:getPreValue(key)
end

function HeroData:restoreChangeValueByKey(key)
    self._propertyData:restoreChangeValueByKey(key)
end

