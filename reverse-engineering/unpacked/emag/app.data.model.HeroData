function HeroData:getActionCombId()
    if not self._actionCombId then
        local raceType = self:getRace()
        local sexType = self:getSex()
        if raceType == Constant.RaceType.Slayer or raceType == Constant.RaceType.Vampire then
            self._actionCombId = (raceType - 1) + sexType
        elseif raceType == Constant.RaceType.Ousters then
            self._actionCombId = Constant.ActionComb.Ousters
        end
    end
    return self._actionCombId
end

