--获取历史最高等级
function HeroData:getHistoryMaxLevel()
    if self:isSlayer() and not self:isAdvance() then
        return self:getHistoryTopLevel() or self:getLevel() --or后面的是服务老数据起到保护作用
    end
    return self:getLevel()
end

