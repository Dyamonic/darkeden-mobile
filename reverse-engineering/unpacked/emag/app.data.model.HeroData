function HeroData:getStage()
    return math.floor((self:getLevel() - 1)/ lt.Constant.REBORN_MAXLEVEL)
end

function HeroData:getStageLv()
    local level = self:getValue(ServerClientEnum.CreatureValueDef.Attr_Level) or 0
    return (level - 1) % lt.Constant.REBORN_MAXLEVEL + 1
end

function HeroData:getFlyup()
    local levels = self:getValue(ServerClientEnum.CreatureValueDef.Attr_Level)
    return levels-Constant.REBORN_MAXLEVEL > 0 and levels-Constant.REBORN_MAXLEVEL or 0
end

