-- 是否实名认证
function HeroData:hasVerified()
    local bit = lt.CommonUtil:d2b(self:getMark())
    return bit[32] == 1
end

-- 关注公众号
function HeroData:hasPublicAttention()
    local bit = lt.CommonUtil:d2b(self:getMark())
    return bit[31] == 1
end

-- 公众号充值标记
function HeroData:hasPublicPay()
    local bit = lt.CommonUtil:d2b(self:getMark())
    return bit[30] == 1
end

function HeroData:isFullHp()
    return self:getCurHp() == self:getMaxHp()
end

function HeroData:getHpPercent()
    if self:getMaxHp() <= 0 then
        return 0
    end

    return self:getCurHp() / self:getMaxHp()
end

--获取真实血量百分比(扣除镀银伤害)
function HeroData:getHpPercentReal()
    if self:getMaxHp() <= 0 then
        return 0
    end
    
    return self:getCurHp() / (self:getMaxHp() - self:getSilver())
end

