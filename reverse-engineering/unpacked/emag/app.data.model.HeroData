--检查属性
function HeroData:checkProperty(propertyArray)
    if not propertyArray then return end
    local isChange = false
    local energyChange = false
    for i, v in ipairs(propertyArray) do
        if v.properCode == ServerClientEnum.PlayerValueDef.Attr_CurSkillPoint
            or v.properCode == ServerClientEnum.PlayerValueDef.Attr_SkillPoints
            or v.properCode == ServerClientEnum.CreatureValueDef.Attr_Level
            or v.properCode == ServerClientEnum.CreatureValueDef.Attr_BladeLevel
            or v.properCode == ServerClientEnum.CreatureValueDef.Attr_SwordLevel
            or v.properCode == ServerClientEnum.CreatureValueDef.Attr_GunLevel
            or v.properCode == ServerClientEnum.CreatureValueDef.Attr_HealLevel
            or v.properCode == ServerClientEnum.CreatureValueDef.Attr_BlessLevel
            or v.properCode == ServerClientEnum.PlayerValueDef.Attr_GradeLevel then
            isChange = true
        elseif v.properCode == ServerClientEnum.PlayerValueDef.Attr_Energy then
            energyChange = true
        end
    end
    if isChange then
        self:checkAddPoint()
    end
    --精力变化
    if energyChange then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_ENERGY_EXP, {reloadList = true})
    end
end

--检查是否有需要变强
function HeroData:checkAddPoint()
    --属性点加点/可学习技能
    SkillModule:initRedTips()
    --可装备强化(材料充足)
    StrengthenModule:initRedTips()

    local visible = SkillModule:getRedPoint()
    if not visible then
        visible = StrengthenModule:getRedPoint()
    end
    
    NtfManager:dispatchNtf(NtfManager.NTF.NFT_SYSTEM_TIPS_CHANGE, {key = Constant.SYSTEMTIPS.ADDPOINT, visible = visible})
end

function HeroData:setAttackPlayerIds(attackPlayerIds)
    self:setValue(ServerClientEnum.CreatureValueDef.Attr_AttackPlayerIds, attackPlayerIds)
end

--获得最近攻击我的玩家id(数组)
function HeroData:getAttackPlayerIds()
    local attackPlayerIds = self:getValue(ServerClientEnum.PlayerValueDef.Attr_AttackPlayerIds)
    local playerIds = string.split(attackPlayerIds, ";")
    local playerIdList = {}
    for i = 1, #playerIds do
        table.insert(playerIdList, string.split(playerIds[i], ",")[1])
    end
    return playerIdList
end

function HeroData:getAttackMode()
    local attackMode = self:getValue(ServerClientEnum.CreatureValueDef.Attr_AttackMode) or 0
    return attackMode + 1
