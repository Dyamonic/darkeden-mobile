-- 获取头像图片URL
function HeroData:getHeadUrl()
    local urlPath = ""
    if self:getRace() == Constant.RaceType.Ousters then
        urlPath = _GURL.ImageOuterHead
    elseif self:getRace() == Constant.RaceType.Vampire then
        urlPath = string.format(_GURL.GetImageVarHead, self:getSex())
    elseif self:getRace() == Constant.RaceType.Slayer then
        urlPath = string.format(_GURL.GetImageHead,self:getFaceShape())
    end
    return urlPath
end

-- 头像,人族发型相关 FaceShape 最后一位和人族发型相关，-1得到发型
function HeroData:getHeadId()
    local headId = self:getFaceShape()%10 - 1
    if headId < 0 then
        headId = 0
    elseif headId > 2 then
        headId = 2
    end
    return headId
end

