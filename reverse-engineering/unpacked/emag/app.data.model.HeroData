end

-- 计算人族属性进度
function HeroData:calculationPercent(index, isLastExp)
    local strExp = self:getSTRExp()
    local dexExp = self:getDEXExp()
    local intExp = self:getINTExp()

    local pureSTR = self:getPureSTR()
    local pureDEX = self:getPureDEX()
    local pureINT = self:getPureINT()

    local attrExpTable = {
        [1] = { strExp, pureSTR },
        [2] = { dexExp, pureDEX },
        [3] = { intExp, pureINT },
    }
    if attrExpTable[index] then
        local attrLevelExpCfg = CacheManager:getAttrLevelExpInfoMeta(attrExpTable[index][2])
        if attrLevelExpCfg then
            if isLastExp then
                local lastExp = attrLevelExpCfg:getExp() - attrExpTable[index][1]
                return lastExp
            else
                local percent = attrExpTable[index][1] / attrLevelExpCfg:getExp()
                return percent
            end
        end
    end

    return 0
end

function HeroData:getSlayerLevelTable()
    -- 各个领域等级
    local bladeLevel = self:getBladeLevel()     -- 刀等级
    local swordLevel = self:getSwordLevel()     -- 剑等级
    local gunLevel = self:getGunLevel()         -- 枪等级
    local healLevel = self:getHealLevel()       -- 治疗等级
    local blessLevel = self:getBlessLevel()     -- 祝福等级
    
    local levelTable = {
        [Constant.DomainType.Blade] = bladeLevel,
        [Constant.DomainType.Sword] = swordLevel,
        [Constant.DomainType.Gun] = gunLevel,
        [Constant.DomainType.Heal] = healLevel,
        [Constant.DomainType.Bless] = blessLevel,
    }

    return levelTable
end

function HeroData:getSlayerLevelByDomain(domain)
    local levelTable = self:getSlayerLevelTable()

    return levelTable[domain] or 0
end

function HeroData:getSlayerExpTable()
    -- 各个领域经验
    local bladeExp = self:getBladeExp()     -- 刀经验
    local swordExp = self:getSwordExp()     -- 剑经验
    local gunExp = self:getGunExp()         -- 枪经验
    local healExp = self:getHealExp()       -- 治疗经验
    local blessExp = self:getBlessExp()     -- 祝福经验

    local expTable = {
        [Constant.DomainType.Blade] = bladeExp,
        [Constant.DomainType.Sword] = swordExp,
        [Constant.DomainType.Gun] = gunExp,
        [Constant.DomainType.Heal] = healExp,
        [Constant.DomainType.Bless] = blessExp,
    }

    return expTable
end

-- 计算人族领域进度
function HeroData:calculationDomainPercent()
    -- 各个领域等级
    local levelTable = self:getSlayerLevelTable()

    -- 各个领域经验
    local expTable = self:getSlayerExpTable()
    
    local percentList = {}
    for domain,v in pairs(levelTable) do
        local curDomainLvl = v
        local curExp = expTable[domain] or 0
        local curMeta = CacheManager:getSLevelExpInfoMeta(domain, curDomainLvl)
        local curNeedExp = curMeta and curMeta:getExp() or 1
        local percentExp = math.floor(curExp/curNeedExp*100)/100
        if percentExp > 1 then
            percentExp = 1
        end
        table.insert(percentList, { domain = domain, level = curDomainLvl, percent = percentExp, lastExp = curNeedExp - curExp})
    end

    table.sort(percentList, function(a, b)
        if a.level == b.level then
            return a.percent > b.percent
        end

        return a.level > b.level
    end)

    return percentList
end

---------------------------------------------------------------------
-- old
function HeroData:getNameSimple()
    local name = self:getValue(ServerClientEnum.ObjectValueDef.Attr_DisplayName) or ""
    local pos = string.find(name, "/")
    if not pos then
        return name
    else
        return string.sub(name, 1, pos - 1)
    end
end

function HeroData:setName(name)
    self:setValue(ServerClientEnum.ObjectValueDef.Attr_DisplayName, name)
end

function HeroData:getName()
    local name = self:getValue(ServerClientEnum.ObjectValueDef.Attr_DisplayName) or ""
    local result, _ = string.gsub(name, "/", "\n")
    return result
end

function HeroData:setNameColor(intValue)
    self:setValue(ServerClientEnum.ObjectValueDef.Attr_NameColor, intValue)
end

function HeroData:getNameColor()
    local tendency = self:getTendencies()
    local tendencyId = CacheManager:getTendencyIdByValue(tendency)
    if not tendencyId then
        tendencyId = 3
    end
    return Constant[string.format("COLOR_OX_TENDENCY_%s",tendencyId)]
    -- return self:getValue(ServerClientEnum.ObjectValueDef.Attr_NameColor) or 0
end

