-- 正在命中的效果id(毒物，持续效果)特效
function HeroData:setEffectIds(effectIds, strValue)
    self._effectIds = effectIds

    if strValue ~= nil then
        self:setValue(ServerClientEnum.CreatureValueDef.Attr_HitEffectId, strValue)
    end
end

function HeroData:getEffectIds()
    if self._effectIds then
        return self._effectIds  
    end

    local strValue =  self:getValue(ServerClientEnum.CreatureValueDef.Attr_HitEffectId)
    self._effectIds = string.split(strValue, ",")

    return self._effectIds
end


