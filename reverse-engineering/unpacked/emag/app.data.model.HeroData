function HeroData:getSuperRingData()
    local data = self:getValue(ServerClientEnum.PlayerValueDef.Attr_NewSuperRing) or ""
    if data ~= "" then
        local ringData = {}
        local stateArr = string.split(data, ";")
        for k,v in pairs(stateArr) do
            local temp = string.split(v, ",")
            local ringID = tonumber(temp[1])
            ringData[ringID] = { tonumber(temp[1]), tonumber(temp[2]), tonumber(temp[3]), tonumber(temp[4]), tonumber(temp[5]), tonumber(temp[6])}
        end
        return ringData
    end

    return nil
end

