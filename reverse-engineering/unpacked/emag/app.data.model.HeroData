function HeroData:parseEuqipAttr(attr)
    local attrParse = string.split(attr, ",") or {}
    local itemColor = Constant.DEFALUT_CLOTH_COLOR
    local itemId =  tonumber(attrParse[1]) or 0
    local affixId = tonumber(attrParse[2])
    local affixLevel = tonumber(attrParse[3]) 
    local colorSetRatio = Constant.BaseColorRatio
    if affixLevel then
       colorSetRatio = CacheManager:getPowerColorSet(affixLevel) or colorSetRatio
    end
    if affixId and affixId ~= 0 then
        itemColor = ItemModule:getAffixColor(affixId)
    end
    return itemId, itemColor, colorSetRatio
end


function HeroData:setTrousers(trousers)
    self:setValue(ServerClientEnum.CreatureValueDef.Attr_Trousers,trousers)
end

function HeroData:getTrousers()
    local trousersAttr = self:getValue(ServerClientEnum.CreatureValueDef.Attr_Trousers)
    return self:parseEuqipAttr(trousersAttr)
end

function HeroData:getLevel(total)
    if self:isSlayer() then
        local bladeLevel = self:getBladeLevel()     -- 刀等级
        local swordLevel = self:getSwordLevel()     -- 剑等级
        local gunLevel = self:getGunLevel()         -- 枪等级
        local healLevel = self:getHealLevel()       -- 治疗等级
        local blessLevel = self:getBlessLevel()     -- 祝福等级
        local lv = bladeLevel
        if not total then
            --人族返回五个领域等级最高的
            if swordLevel > lv then lv = swordLevel end
            if gunLevel > lv then lv = gunLevel end
            if healLevel > lv then lv = healLevel end
            if blessLevel > lv then lv = blessLevel end
        else
            --人族返回五个领域总等级
            lv = lv + swordLevel + gunLevel + healLevel + blessLevel
        end
        return lv
    else
        return self:getValue(ServerClientEnum.CreatureValueDef.Attr_Level)
    end
end

--获取人族最高熟练度的领域
function HeroData:getMaxLevel()
    if self:isSlayer() then
        local bladeLevel = self:getBladeLevel()     -- 刀等级
        local swordLevel = self:getSwordLevel()     -- 剑等级
        local gunLevel = self:getGunLevel()         -- 枪等级
        local healLevel = self:getHealLevel()       -- 治疗等级
        local blessLevel = self:getBlessLevel()     -- 祝福等级
        local lv = bladeLevel
        local area = Constant.DomainType.Blade
        if swordLevel > lv then
            lv = swordLevel
            area = Constant.DomainType.Sword
        end
        if gunLevel > lv then
            lv = gunLevel
            area = Constant.DomainType.Gun
        end
        if healLevel > lv then
            lv = healLevel
            area = Constant.DomainType.Heal
        end
        if blessLevel > lv then
            lv = blessLevel
            area = Constant.DomainType.Bless
        end
        return area
    end
    return 0
end

