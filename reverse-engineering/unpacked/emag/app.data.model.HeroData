function HeroData:isSkillHide()
    return Constant.SkillHide.Hide == self:getSkillHide()
end

function HeroData:canMove()
    local canMove = Constant.SkillHide.Hide ~= self:getSkillHide() -- 隐蔽状态不能移动
    return canMove and self:isAlive()
end

function HeroData:canAttack()
    local canAttack = Constant.SkillHide.Hide ~= self:getSkillHide() -- 隐蔽状态不能攻击
    return canAttack and self:isAlive()
end

