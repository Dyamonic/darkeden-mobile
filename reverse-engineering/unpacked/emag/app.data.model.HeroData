--[[ 
    天炼人物外观规则
    种族: 1=人族, 2=鬼族, 3=魔族
    性别: 0=全部, 1=男, 2=女 (魔族无性别)
    转职: 0=转职前, 1=转职后
    等级: 衣服等级(固定)

    model_种族_性别_等级
    model_s_种族_性别_等级 -> 影子 
]]
function HeroData:getModelName()
    if not self._modelName then
        self:setRoleModelName()
    end

    -- 人族 包含头盔和裤子
    if self:isSlayer() then
        return self._helmetName, self._modelName, self._pantsName, self._hairName
    end
    
   return self._modelName
end

function HeroData:clearModelName()
    self._modelName = nil 
end

function HeroData:getModelShadowName()
    if not self._modelShadowName then
        self:setRoleModelName()
    end

    -- 人族 包含头盔和裤子
    if self:isSlayer() then
        return self._helmetShadowName, self._modelShadowName, self._pantsShadowName,self._hairShadowName
    end
    
        
    return self._modelShadowName
end

-- 获取头盔等级
function HeroData:getHelmetModelLevel()
    local helmet = self:getHelmet()
    if helmet == 0 then
        return 0
    end

    local meta = CacheManager:queryEquipMeta(helmet)
    if not meta then
        return 0 
    end

    return meta:getModelLv() or 0
end

-- 获取裤子等级
function HeroData:getPantsModelLevel()
    local trousers = self:getTrousers()
    if trousers == 0 then
        return 0
    end

    local meta = CacheManager:queryEquipMeta(trousers)
    if not meta then
        return 0 
    end

    return meta:getModelLv() or 0
end

--FIXME 人物服饰等级或者转职发生变化 需要同步刷新
function HeroData:setRoleModelName()
    local race = self:getRace()
    local sex = self:getSex()
    -- 魔族外需要设定性别
    if race ~= Constant.RaceType.Ousters then
        -- 服务器定义: 0男 1女, 所以本地需要 +1
        sex = sex + 1
    end

    local colthLevel = self:getClothModelLevel()
    local advance = 0 --self:getAdvanceState()-- TODO转职模型还没有，暂时先强制为0

    
    local baseName = string.format("%d_%d_%d_%d", race, sex, advance, colthLevel)

    self._modelName = string.format("model_%s", baseName)
    self._modelShadowName = string.format("model_s_%s", baseName)

    -- 人族包含头盔和裤子
    if self:isSlayer() then
        local helmetModelLevel = self:getHelmetModelLevel()
        local baseHelmetName = string.format("%d_%d_%d_%d", race, sex, advance, helmetModelLevel)
        local baseHairName =  string.format("%d_%d_%d_%d", race, sex, advance, self:getHeadId())
        self._helmetName = string.format("helmet_%s", baseHelmetName)
        self._hairName = string.format("helmet_%s", baseHairName)
        self._helmetShadowName = string.format("helmet_s_%s", baseHelmetName)
        self._hairShadowName = string.format("helmet_s_%s", baseHairName)


        local pantsModelLevel = self:getPantsModelLevel()
        local basePantsName = string.format("%d_%d_%d_%d", race, sex, advance, pantsModelLevel)
        self._pantsName = string.format("pants_%s", basePantsName)
        self._pantsShadowName = string.format("pants_s_%s", basePantsName)
    end
end

-- 外观, 当人物骑宠或变身也用这个值表示所寄宠物编号或变身后外观
-- 天炼暂时不使用modelId 需和服务同步确认 TODO
function HeroData:setModelId(modle)
    if not modle then
        modle = self:getSex()
    end

    self:setValue(ServerClientEnum.ObjectValueDef.Attr_Appr, modle)
end

function HeroData:getModelId()
    return self:getValue(ServerClientEnum.ObjectValueDef.Attr_Appr) or 0
end

function HeroData:setModelClothId(clothId)
    self._clothId = clothId
end

-- 武器名
function HeroData:getWeaponModelName()
    if not self._weaponModelName then
        self:setRoleWeaponModelName()
    end

    return self._weaponModelName
end

function HeroData:getWeaponModelShadowName()
    if not self._weaponModelShadowName then
        self:setRoleWeaponModelName()
    end

    return self._weaponModelShadowName 
end

function HeroData:getWeaponModelLevel()
    local weaponId = self:getWeapon()
    if weaponId == 0 then
        return 0
    end

    local meta = CacheManager:queryEquipMeta(weaponId)
    if not meta then
        return 0 
    end

    return meta:getModelLv() or 0
end

function HeroData:setRoleWeaponModelName()
    local weaponModelLv = self:getWeaponModelLevel()
    if weaponModelLv == 0  then
        return
    end

    local race = self:getRace()
    local sex = self:getSex()
    -- 魔族外需要设定性别
    if race ~= Constant.RaceType.Ousters then
        -- 服务器定义: 0男 1女, 所以本地需要 +1
        sex = sex + 1
    end

    local advance = 0--self:getAdvanceState()
    local baseName = string.format("%d_%d_%d_%d", race, sex, advance, weaponModelLv)

    self._weaponModelName = string.format("weapon_%s", baseName)
    self._weaponModelShadowName = string.format("weapon_s_%s", baseName)
end

-- 坐骑名
function HeroData:getMountModelName()
    if not self._mountModelName then
        self:setRoleMountModelName()
    end

    return self._mountModelName
end

-- 坐骑名 阴影
function HeroData:getMountModelShadowName()
    if not self._mountModelShadowName then
        self:setRoleMountModelName()
    end

    return self._mountModelShadowName 
end

-- 坐骑 模型人族-男性-没转职-类型ID的坐骑
function HeroData:setRoleMountModelName()
    local mountId = self:getMountId()
    if mountId == 0 then
        return
    end
    local mountInfo = lt.Constant.MOUNT_ITEMS[mountId]
    if not mountInfo then
        return 
    end

    local race = self:getRace()
    local sex = self:getSex()
    -- 魔族外需要设定性别
    if race ~= Constant.RaceType.Ousters then
        -- 服务器定义: 0男 1女, 所以本地需要 +1
        sex = sex + 1
    end

    local baseName = string.format("%d_%d_%d_%d", race, sex, mountInfo.adv, mountInfo.lv)
    self._mountModelName = string.format("mount_%s", baseName)
    self._mountModelShadowName = string.format("mount_s_%s", baseName)
end

-- 盾牌名
function HeroData:getShieldModelName()
    if not self._shieldModelName then
        self:setRoleShieldModelName()
    end

    return self._shieldModelName
end

function HeroData:getShieldModelShadowName()
    if not self._shieldModelShadowName then
        self:setRoleShieldModelName()
    end

    return self._shieldModelShadowName 
end

function HeroData:clearShieldModelName()
    self._shieldModelName = nil
    self._shieldModelShadowName  = nil
end

function HeroData:getShieldModelLevel()
    local shield = self:getShield()
    if shield == 0 then
        return 0
    end

    local meta = CacheManager:queryEquipMeta(shield)
    if not meta then
        return 0 
    end

    return meta:getModelLv() or 0
end

function HeroData:setRoleShieldModelName()
    local shieldLvl = self:getShieldModelLevel()
    if shieldLvl == 0  then
        return
    end

    local race = self:getRace()
    local sex = self:getSex()
    -- 魔族外需要设定性别
    if race ~= Constant.RaceType.Ousters then
        -- 服务器定义: 0男 1女, 所以本地需要 +1
        sex = sex + 1
    end

    local advance = 0--self:getAdvanceState()
    local baseName = string.format("%d_%d_%d_%d", race, sex, advance, shieldLvl)

    self._shieldModelName = string.format("shield_%s", baseName)
    self._shieldModelShadowName = string.format("shield_s_%s", baseName)
end

--[[
    非转职默认衣服外观等级: 人族: 0 魔族: 10 鬼族: 10
    非转职默认衣服外观等级: ?
]]
function HeroData:getClothModelLevel()
    local bodyAppr = self:getBodyAppr() or 0
    local meta = CacheManager:queryEquipMeta(bodyAppr)

    if not meta then
        local advance = self:getAdvanceState()
        if advance == 0 then
            if self:isSlayer() then
                return 0
            else
                return 10
            end
        end
        -- 转职后 TODO 未完成
        if self:isSlayer() then
            return 0
        else
            return 10
        end
    end

    return meta:getModelLv() or 0
end

