--[[
    蓝量是否足够
    ** 鬼族技能消耗血量
]]
function HeroData:checkMana(skillMeta)
    local mana = self:getCurMp()
    if self:getRace() == Constant.RaceType.Vampire then -- IsV...
        mana = self:getCurHp()
    end

    -- FIXME delay 测试,暂不开启mana
    return mana >= skillMeta:getMana()
    -- return true
end

