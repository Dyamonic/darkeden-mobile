
local ActionManager = {}

local Constant = lt.Constant

function ActionManager:init()
    self._frameTable = {}
    self._frameLoadedTable = {}
    self._actionInfoTable = {}
    self._actionDatacfpkTable = {}
end

function ActionManager:clear()
    for _, actionInfo in pairs(self._actionInfoTable) do
        actionInfo:clear()
    end
    self._actionInfoTable = {}


    -- self._actionDatacfpkTable = {} 注意释放

    for dataFilename, frameInfo in pairs(self._frameTable) do
        display.removeSpriteFrames(dataFilename, frameInfo.imageFilename)
    end
    self._frameTable = {}
end

--[[
    释放最不常用的动作 动作存在 引用数 _use
    每次触发方法 获得最低引用数 移除最低引用数的动作
]]
function ActionManager:stepRemove()
    local minUse = nil
    for _, actionInfo in pairs(self._actionInfoTable) do
        if not minUse or actionInfo:getUse() < minUse then
            minUse = actionInfo:getUse()
        end
    end
    if not minUse then
        return
    end
    local count = 0
    for k, actionInfo in pairs(self._actionInfoTable) do
        if actionInfo:getUse() <= minUse then
            count = count + 1
            actionInfo:clear()
            self._actionInfoTable[k] = nil
        else
            actionInfo:setUse(actionInfo:getUse() - (minUse - 1))
        end
    end
    if DEBUG > 2 then
        print("remove ActionInfo by minUse",minUse," count", count)
    end
end

-- sprite frame part
function ActionManager:loadAtlas(dataFilename, imageFilename, ntfMessage)
    if self._frameTable[dataFilename] then
        self._frameTable[dataFilename].rc = self._frameTable[dataFilename].rc + 1

        if self._frameLoadedTable[dataFilename] then
            return true
        end
    else
        self._frameTable[dataFilename] = {}
        self._frameTable[dataFilename].imageFilename = imageFilename
        self._frameTable[dataFilename].rc = 1

        display.loadSpriteFrames(dataFilename, imageFilename, function()
            if DEBUG > 2 then
                print("ActionManager:loadAtlas dataFilename", dataFilename," imageFilename",imageFilename)
            end

            self._frameLoadedTable[dataFilename] = true

            ntfMessage = ntfMessage or lt.NtfManager.NTF.SPRITE_FRAME_LOADED
            lt.NtfManager:dispatchNtf(ntfMessage, {dataFilename = dataFilename})
        end)
    end

    return false
end

function ActionManager:unloadAtlas(dataFilename, imageFilename)
    if self._frameTable[dataFilename] then
        -- 纹理已经被释放
        return
    end

    if self._frameTable[dataFilename].rc == 1 then
        display.removeSpriteFrames(dataFilename, imageFilename)
        self._frameTable[dataFilename] = nil
        self._frameLoadedTable[dataFilename] = nil
        if DEBUG > 2 then
            print("ActionManager:unloadAtlas dataFilename", dataFilename," imageFilename",imageFilename)
        end

    else
        self._frameTable[dataFilename].rc = self._frameTable[dataFilename].rc - 1
    end
end

