--[[
    转职前与转职后对应的action数据不一致
    所以增加此方法区分种族与转职前后的动作
]]
function ActionManager:getAdvancedActorAction(race, advanced, actionId)
    if not advanced then
        --  yflog:Info("==cur =actionId:%s, ", actionId)
        return actionId
    end

    if race == Constant.RaceType.Slayer then
        if actionId == Constant.ACTION_MOUNT_SLAYER_MOVE then
            actionId = Constant.ACTION_MOUNT_ADVANCED_SLAYER_MOVE
        elseif actionId == Constant.ACTION_MOUNT_SLAYER_STAND then
            actionId = Constant.ACTION_MOUNT_ADVANCED_SLAYER_STAND
        end
        return actionId
    end

    yflog:Info("actionId:%s", actionId)

    return actionId
end


function ActionManager:getActionLoop(actionId ,race , tag)
    -- 给与策划测试专用 配置在env文件中 FIXME后期需要删除
    if _G_ACTION_LOOP then
        return -1
    end

    if race == Constant.RaceType.Ousters then
        if actionId == Constant.ACTION_OUSTERS_FAIRY_MOVE_STAND
        or actionId == Constant.ACTION_OUSTERS_FAIRY_MOVE_MOVE
        or actionId == Constant.ACTION_OUSTERS_PEGASUS_MOVE_STAND
        or actionId == Constant.ACTION_OUSTERS_PEGASUS_MOVE_MOVE
         then
            return -1
        end
    end

    if race == Constant.RaceType.Slayer and tag == "mount" then
        if actionId == Constant.ACTION_MOUNT_ADVANCED_SLAYER_STAND
        or actionId == Constant.ACTION_MOUNT_SLAYER_MOVE
        or actionId == Constant.ACTION_MOUNT_SLAYER_STAND
        or actionId == Constant.ACTION_MOUNT_ADVANCED_SLAYER_MOVE
         then
            return -1
        end
    end
    
    if actionId == Constant.ROLE_ACTION_IDLE 
        or actionId == Constant.ROLE_ACTION_MOVE 
        or actionId == Constant.ACTION_OUSTERS_STAND 
        or actionId == Constant.ACTION_OUSTERS_MOVE
        or actionId == Constant.ACTION_OUSTERS_FAST_MOVE_MOVE
        or actionId == Constant.ACTION_OUSTERS_FAST_MOVE_STAND
        or actionId == Constant.ACTION_OUSTERS_DRAIN
        then
        return -1
    else
        return 1
    end

    return 1
end

--[[
    特殊怪物
    方向与action
    208: 油桶: action_0 -> direction_2(站立1帧) && action_6 -> direction_2(击碎8帧)
    102: 圣诞树 action_6 -> direction_2
    203: 地雷 action_0 -> direction_2 
    202: 娱乐站台 action_0 -> direction_2 
    207: 地雷2 action_0 -> direction_1
    242: 理性柱子 action_0 -> direction_3
]]
function ActionManager:getSpecialMonsterDirection(modelId, actionId)
    if modelId == 208 then
        -- 油桶
        return nil, 2
    elseif modelId == 102 then
        -- 圣诞树
        return 6, 2
    elseif modelId == 203 then
        -- 地雷
        return 0, 2
    elseif modelId == 202 then
        -- 娱乐站台
        return 0, 2
    elseif modelId == 207 then
        -- 地雷2
        return 0, 1
    elseif modelId == 242 then
        -- 理性柱子
        if actionId == Constant.ROLE_ACTION_DIE then
            return 6, 3
        else
            return 0, 3
        end
    elseif modelId == 224 then
        -- 伊甸园boss变身
        if actionId == Constant.ROLE_ACTION_DIE then
            return 6, 2
        end
    elseif modelId == 249 then
        -- 地雷2
        return actionId, 2
    end

    return nil, nil
end

return ActionManager
