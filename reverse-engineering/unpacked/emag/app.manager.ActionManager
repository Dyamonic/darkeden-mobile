-- 获取生物数据信息
function ActionManager:getActionData(modelname, modelId)
    local dataName = string.format("%s_%d", modelname, modelId)

    local actionDatacfpk = self._actionDatacfpkTable[dataName]
    if not actionDatacfpk then
        actionDatacfpk = lt.ActionData.new(modelname, modelId)
        self._actionDatacfpkTable[dataName] = actionDatacfpk
    else
        actionDatacfpk:addUse()
    end

    return actionDatacfpk
end

function ActionManager:getActorFrameCount(modelName, actionId, direction,transform,stepMultiple)
    local stepMultiple = stepMultiple or 1
    ------------------------------------------------------------------------------
    -- 变身读取怪物数据
    if transform and lt.SkillEnum.TRANSFORM_MODELID[transform] then
        local frameCount = ActionManager:getCreatureFrameCount("monster", lt.SkillEnum.TRANSFORM_MODELID[transform], actionId, direction)
        return frameCount, 0.06*stepMultiple
    end
    ------------------------------------------------------------------------------

    local meta = lt.CacheManager:getRoleModelMeta(modelName)
    if not meta then
        yflog:Error("RoleModelMeta is nil modelName: %s", modelName)
        return 
    end

    -- 对应动作文件 .cfpk
    local fileName = meta:getAction()

    local modelId = meta:getModelId()

    local actionData = self:getActionData(fileName, modelId)
    if not actionData then
        yflog:Info("ActionManager getCreatureFrameCount actionData is nil")
        return 0
    end
    local modelMap = string.split(modelName, "_")
    local race = tonumber(modelMap[#modelMap-3])
    local frameStep = self:getActionStep(actionId,race)
    local frameCount = actionData:getFrameCount(actionId, direction)
    return frameCount, frameStep*stepMultiple
end

-- 获取怪物某个动作的帧数
function ActionManager:getCreatureFrameCount(modelName, modelId, actionId, direction)
    local name = "creature"

    local actionData = self:getActionData(name, modelId)
    if not actionData then
        yflog:Info("ActionManager getCreatureFrameCount actionData is nil")
        return 0
    end

    local frameCount = actionData:getFrameCount(actionId, direction)
    return frameCount
end

-- 根据动作获取行动step
function ActionManager:getActionStep(actionId,race)
    local step = lt.CacheManager:getActionStep(race,actionId)
    if type(step) == "number" then
        step = step / 1000
    else
        step = 0.05
    end

    return step

--[[
    -- 根据玩家动作获取step,用于动作播放时的步声间隔 && 用于每个动作帧的播放速度间隔  
    -- 如每帧间隔为0.0167  ACTION_IDLE 为 0.333 则站立为20帧播放一张图片 0.0167*20 = 0.334
    if actionId == Constant.ACTION_WALK then
        return lt.Constant.MAP_BLOCK_HEIGHT / Constant.HERO_WALK_SPEED / frameCount
    elseif actionId == Constant.ACTION_RUN then
        return 2 * Constant.MAP_BLOCK_HEIGHT / Constant.HERO_RUN_SPEED / frameCount
    elseif actionId == Constant.ACTION_IDLE then
        return 0.333
    else
        return 0.1
    end
]]
end

