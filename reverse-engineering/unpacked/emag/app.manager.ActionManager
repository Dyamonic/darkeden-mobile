--[[
    modelName: model_种族_性别_等级
]]
function ActionManager:getActionActor(tag, modelName, actionId, direction, isShadow)
    local str = string.split(modelName, "_")
    local race = 0
    if isShadow then
        race = tonumber(str[3])
    else
        race = tonumber(str[2])
    end
    local loop = self:getActionLoop(actionId ,race ,tag)

    local  actionName = string.format("%s_%d_%d", modelName, actionId, direction)
    -- loop = -1

    local actionInfo = self._actionInfoTable[actionName]
    if not actionInfo then
        if tag == "weapon" then
            actionInfo = lt.ActionActorWeapon.new(modelName, actionId, direction, loop, isShadow)
        elseif tag == "shield" then
            actionInfo = lt.ActionActorShield.new(modelName, actionId, direction, loop, isShadow)
        elseif tag == "mount" then
            actionInfo = lt.ActionActorMount.new(modelName, actionId, direction, loop, isShadow)
        else
            actionInfo = lt.ActionActor.new(modelName, actionId, direction, loop, isShadow)
        end

        self._actionInfoTable[actionName] = actionInfo
    else
        actionInfo:addUse()
    end

    return actionInfo
end

