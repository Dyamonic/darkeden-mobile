
-- simulate static variable
local BaseAgent_nextAgentId = 1

local BaseAgent = class("BaseAgent")
local BuffEnum = lt.BuffEnum
local Constant = lt.Constant

BaseAgent._agentId        = nil
BaseAgent._agentType      = nil
BaseAgent._isOutOfGame    = nil -- 控制选中逻辑（人物死亡时可以选中， 怪物死亡时不能选中），| 但是又同时控制了死亡状态机的切换开关，包含人物是否进入outOfGame
BaseAgent._isWaitForClear = nil

function BaseAgent:ctor(agentType)
    self._agentId           = BaseAgent_nextAgentId
    self._agentType         = agentType
    self._isOutOfGame       = false
    self._isWaitingForClear = false
    self._combActionId      = nil
    self._knockBackCount    = 0

    BaseAgent_nextAgentId = BaseAgent_nextAgentId + 1
end

function BaseAgent:onClear()
    assert(false, "Please override BaseAgent:onClear")
end

function BaseAgent:onUpdate(delta)
    assert(false, "Please override BaseAgent:onUpdate")
end

function BaseAgent:onMessage(msg)
end

function BaseAgent:getAgentId()
    return self._agentId
end

function BaseAgent:getAgentType()
    return self._agentType
end

function BaseAgent:isRoleAgent()
    return self._agentType == lt.Constant.AGENT_TYPE_HERO or self._agentType == lt.Constant.AGENT_TYPE_MONSTER
end

function BaseAgent:isHeroAgent()
    return self._agentType == lt.Constant.AGENT_TYPE_HERO
end

function BaseAgent:isMonsterAgent()
    return self._agentType == lt.Constant.AGENT_TYPE_MONSTER
end

function BaseAgent:isItemAgent()
    return self._agentType == lt.Constant.AGENT_TYPE_ITEM
end

function BaseAgent:isNpcAgent()
    return self._agentType == lt.Constant.AGENT_TYPE_NPC
end

function BaseAgent:getIsOutOfGame()
    return self._isOutOfGame
end

function BaseAgent:setIsOutOfGame(isOutOfGame)
    self._isOutOfGame = isOutOfGame
end

function BaseAgent:getIsWaitForClear()
    return self._isWaitForClear
end

function BaseAgent:setIsWaitForClear(isWaitForClear)
    self._isWaitForClear = isWaitForClear
end

function BaseAgent:changeLevel(level)
end

function BaseAgent:playEffect(skillId, isDelay)
end

function BaseAgent:playQueueEffect(skillId, owner, skillGrade)
    local actor = self:getActor()
    if actor and not tolua.isnull(actor) and actor.playQueueEffect then
        actor:playQueueEffect(skillId, owner, skillGrade)
    else
        yflog:Info("BaseAgent playQueueEffect not support")
    end
end

function BaseAgent:playSoleEffect(skillId, owner, skillGrade)
    local actor = self:getActor()
    if not actor or not actor.playSoleEffect then
        yflog:Info("playSoleEffect not support")
        return
    end

    actor:playSoleEffect(skillId, owner, skillGrade)
end

