function BaseAgent:addEffectStatus()

end

function BaseAgent:visibleActor(isVisible)
    
    local actor = self:getActor()
    if not actor then return end
    actor:setVisible(isVisible)

    if actor.getShadowActor then
        local shadowActor = actor:getShadowActor()
        if shadowActor and not tolua.isnull(shadowActor) then
            shadowActor:setVisible(isVisible)
        end
    end
    
    if self:isHeroAgent() and self:isTransCasket() then
        return --棺材中依旧显示名字
    end
   
    if actor._nameNode then
        local nameNode = actor._nameNode 
        if nameNode and not tolua.isnull(nameNode) then
            nameNode:setVisible(isVisible)
        end
        --死亡的时候不显示名字
        if self:isRoleAgent() and self:isDead() then
            nameNode:setVisible(false)
        end
    end
end

function BaseAgent:isVisibleActor()
    local actor = self:getActor()
    if not actor then return false end
    return actor:isVisible()
end

-- 获取当前step的技能
function BaseAgent:getCurStepMultiple(skillId)
    if not self:isRoleAgent() then
        return Constant.STEPMULTIPLE.ONE
    end
    
    -- 减速两倍buff
    local actionId = self:getActor():getActionId()
    for buffId,_ in pairs(BuffEnum.SLOW_DOWN_BUFFS) do
        if self.hasBuffer and self:hasBuffer(buffId) then
            if buffId == BuffEnum.EFFECT_CLASS_FROZEN_ARMOR_TO_CREATURE 
            or buffId == BuffEnum.EFFECT_CLASS_ICE_FIELD_TO_CREATURE 
            or buffId == BuffEnum.EFFECT_CLASS_JABBING_VEIN     
            then
                if self:checkIsMoveAction(actionId) then
                    return Constant.STEPMULTIPLE.TWO
                end
            elseif buffId == BuffEnum.EFFECT_FURY_OF_GNOME or buffId == BuffEnum.EFFECT_ICE_OF_SOUL_STONE or buffId == BuffEnum.EFFECT_CLASS_COLD_ATTACK then
                -- 大地之怒简化和冰之灵石一致
                if not self:checkIsMoveAction(actionId) then
                    return Constant.STEPMULTIPLE.TWO
                end
            elseif buffId == BuffEnum.EFFECT_ABERRATION then
                -- 心态失常
                if self:checkIsMoveAction(actionId) then -- 移动
                    return Constant.STEPMULTIPLE.TWO
                end

                if self:isHeroAgent() then -- 角色
                    if self:isStateSkill() or self:isAttackDummy() or self:isStateShot() then
                        local curState = self:getCurState()
                        skillId = curState:getSkillId()
                    end
                elseif self:isMonsterAgent() then -- 怪物
                    if self:getCurStateId() == Constant.MONSTER_STATE_SKILL then
                        local curState = self:getCurState()
                        skillId = curState:getSkillId()
                    end
                end
                
                if skillId then -- 查询技能表看是否减速
                    local skillMeta = lt.CacheManager:querySkillMeta(skillId)
                    if skillMeta and skillMeta:getAberrationContr() then
                        return Constant.STEPMULTIPLE.TWO
                    end
                end
            else
                return Constant.STEPMULTIPLE.TWO
            end
        end
    end
    return Constant.STEPMULTIPLE.ONE
end

function BaseAgent:resetActionStep()
    local actor = self:getActor()
    if not actor or not actor.resetActionStep then
        yflog:Info("resetActionStep not support")
        return
    end

    actor:resetActionStep()
end

