end

function BaseAgent:getActionId()

end

function BaseAgent:getRoleData()

end

function BaseAgent:isAlive()
    return false
end

function BaseAgent:getActionCombId()
    if not self._combActionId  then
        local roleData = self:getRoleData()
        if roleData then
            local combActionId = roleData:getActionCombId()
            if combActionId then
                self._combActionId = combActionId
            end
        end
    end
    return self._combActionId
end

function BaseAgent:getTransformId()
    return lt.SkillEnum.TRANSFORM.NONE
end


-- 击退计数器
function BaseAgent:setKnockBackCount(count)
    self._knockBackCount = count
end
function BaseAgent:getKnockBackCount()
    return self._knockBackCount
end
function BaseAgent:subKnockBackCount()
    self._knockBackCount = self._knockBackCount - 1
end
return BaseAgent
