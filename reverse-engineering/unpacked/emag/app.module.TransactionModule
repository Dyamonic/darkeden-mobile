-- 根据种族分类
function TransactionModule:getTransactionData()
    local myrace = GameModule:getHeroData():getRace()
    local firstList = CacheManager:getTransactionsDefaultMap()
    local mapTable = {}
    for i, meta in ipairs(firstList or {}) do
        local condi = meta:getCondition() or 0
        if condi == 0 or myrace == condi then
            local first = meta:getFirst()
            local second = meta:getSecond()
            if not mapTable[first] then
                mapTable[first] = {}
            end
            if not mapTable[first][second] then
                mapTable[first][second] = {}
            end
            table.insert(mapTable[first][second], meta)
        end
    end
    return mapTable
end

function TransactionModule:getTransactionDataByItemIdAndType(_itemId, _type)
    _itemId = tonumber(_itemId) or 0
    _type = tonumber(_type) or 0
    local list = CacheManager:getTransactionsDefaultMap()
    for i, meta in ipairs(list or {}) do
        local itemId = meta:getItemId() or 0
        local type = meta:getType() or 0
        if itemId == _itemId and type == _type then
            return meta
        end
    end

    return nil
end

function TransactionModule:getTransactionFilterData()
    local unordered = self:getTransactionData()
    local keys = {}
    for key in pairs(unordered) do
        table.insert(keys, key)
    end
    -- 插入 我的关注
    table.insert(keys, TransactionModule.MarkKey)
    table.sort(keys, function(a, b)
        if a == TransactionModule.MarkKey then
            return true
        end
        if b == TransactionModule.MarkKey then
            return false
        end
        return a < b
    end)

    local ordered = {}
    for _, key in ipairs(keys) do
        if key == TransactionModule.MarkKey then
            table.insert(ordered, {})
        else
            table.insert(ordered, unordered[key])
        end
    end

    return ordered
end

function TransactionModule:getTransactionCurData()
    if not self._defaultList then
        self._defaultList = self:getTransactionFilterData()
    end
    return self._defaultList
end

function TransactionModule:getTransactionCurMeta(mainIdx, subIdx)
    local itemList = nil
    if mainIdx == 1 then -- 我的关注
        --TODO 请求列表
    else
        local filterData = self:getTransactionDefaultData()
        itemList = filterData[mainIdx][subIdx]
    end
    return itemList
end

--获得个人出售列表
function TransactionModule:getTransactionSellList()
    return self._sellList or {}
end

--根据id获得出售数量
function TransactionModule:getNumbyId(id, types)
    local num = 0
    for i = 1, #self._simpleInfoList do
        if self._simpleInfoList[i].cofingId == id then
            num = num + self._simpleInfoList[i].itemNum
        end
    end
    return num
end

--获得出售详细列表
function TransactionModule:getTransactionDetailList(filter, sortPrice, isShow)
    local list = {}
    if filter == 99 then
        list = self:getOriginDetailList()
    else
        for i = 1, #self._detailList do
            local cofingId = self._detailList[i].cofingId
            if cofingId then
                local meta = CacheManager:getTransactionsById(cofingId)
                local itemType = meta:getType()
                if itemType == Constant.ItemType.ITEM_TYPE_PROP then
                    local sid = meta:getItemId()
                    local itemMeta = CacheManager:getItemMeta(sid)
                    if itemMeta:getQuality() == filter then
                        table.insert(list, self._detailList[i])
                    end
                end
            else
                local itemInfo = ItemModule:getItemDataByProperty(self._detailList[i].objProperty)
                if itemInfo:getQuality() == filter then
                    table.insert(list, self._detailList[i])
                end
            end
        end
    end
    table.sort(list, function(a, b)
        if isShow then -- 公示列表
            if sortPrice == 0 then
                return a.curBiddingPrice < b.curBiddingPrice
            else
                return a.curBiddingPrice > b.curBiddingPrice
            end
        else -- 购买列表
            if sortPrice == 0 then
                return a.sellPrice < b.sellPrice
            else
                return a.sellPrice > b.sellPrice
            end
        end
    end)
    return list
end

--获得初始出售详细列表
function TransactionModule:getOriginDetailList()
    return self._detailList or {}
end

--获得个人收藏列表
function TransactionModule:getCollectList(filter, sortPrice)
    local list = {}
    if filter == 99 then
        list = self:getOriginCollectList()
    else
        for i = 1, #self._collectList do
            local itemInfo = ItemModule:getItemDataByProperty(self._collectList[i].objProperty)
            if itemInfo:getQuality() == filter then
                table.insert(list, self._collectList[i])
            end
        end
    end
    table.sort(list, function(a, b)
        if sortPrice == 0 then
            return a.curBiddingPrice < b.curBiddingPrice
        else
            return a.curBiddingPrice > b.curBiddingPrice
        end
    end)
    return list
end

--获得初始收藏列表
function TransactionModule:getOriginCollectList()
    return self._collectList or {}
end

--是否为个人收藏
function TransactionModule:getIsCollectByUid(itemUniqueId)
    local list = self:getOriginCollectList()
    for i = 1, #list do
        if list[i].itemUniqueId == itemUniqueId then
            return true
        end
    end
    return false
end

--获得交易记录
function TransactionModule:getTradingInfo()
    return self._tradingInfo or {}
end

--获得交易总数
function TransactionModule:getTradingSellNum()
    return self._sellNum or 0
end

--获得交易消耗累计值
function TransactionModule:getTradingCostById(itemId)
    local costMap = self._costMap or {}
    for k, v in pairs(costMap) do
        if v.key == itemId then
            return v.value
        end
    end
    return 0
end

return TransactionModule
