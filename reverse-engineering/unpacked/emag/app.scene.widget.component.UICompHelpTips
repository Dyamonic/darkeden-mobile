---@帮助界面
---@class UICompHelpTips
local UICompHelpTips = class("UICompHelpTips", lt.UICompBase, lt.UICompChangeSkin)

local Constant = lt.Constant

UICompHelpTips.ChangeSkinConf = {
    ["HelpTips"] = {
        ["bg"] = "bj_kuang",
    },

    ["CommonTL"] = {
        closeButton = {bg  = "sort"}
    }
}

function UICompHelpTips:ctor()
    self:makeFullScreen()
    self._data = nil
    UICompHelpTips.super.ctor(self)
end

function UICompHelpTips:onClear()
    self._data = nil
    UICompHelpTips.super.onClear(self)
end

function UICompHelpTips:onConstruct()
    self:startSkin()
end

function UICompHelpTips:onEnter()
    local closeButton = self:getChild("closeButton")
    closeButton:addClickListener(handler(self, self.onCloseBtnClick))
end

function UICompHelpTips:onExit()
    local closeButton = self:getChild("closeButton")
    closeButton:removeClickListener()
end

function UICompHelpTips:initUI()
end

function UICompHelpTips:refreshTips(data)
    self._data = data or {}
    local title = self._data.title or ""
    local content = self._data.content or ""
    local tipsType = self._data.tipsType or Constant.HelpTipsType.Common

    local titleT = self:getChild("titleName")
    
    -- Common
    local list = self:getChild("list")
    if tipsType == Constant.HelpTipsType.Common then
        titleT:setText(title)

        list:setVisible(true)
        local target = list:getChildAt(0)
        local detail = target:getChild("detail")
        detail:setText(content)
        local size = detail:getSize()
        target:setSize(size.width, size.height)
    else
        list:setVisible(false)
    end

    -- Skill
    local skillList = self:getChild("skillList")
    if tipsType == Constant.HelpTipsType.Skill and self._data.skillInfo then
        local skillInfo = self._data.skillInfo
        local skillName = skillInfo:getName() or ""
        local skillEnName = skillInfo:getEnName() or ""
        local title = skillName.."("..skillEnName..")"
        titleT:setText(title)

        local skillDesc = skillInfo:getDescription()
        skillList:setVisible(true)
        local target = skillList:getChildAt(0)
        local detail = target:getChild("detail")
        detail:setText(skillDesc)
        
        local icon = target:getChild("icon")
        icon:setURL("ui://Skill/"..skillInfo:getSpriteID())
    else
        skillList:setVisible(false)
    end

    self:setVisible(true)
end

function UICompHelpTips:onCloseBtnClick()
    self:setVisible(false)
end

return UICompHelpTips