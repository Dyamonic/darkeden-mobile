local BuffWaterElementHeal = class("BuffWaterElementHeal", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local ScheduleUtil  = lt.ScheduleUtil

--[[
   水元素加Buff
]]
function BuffWaterElementHeal:ctor(time, actor, skilllevel)    
    BuffWaterElementHeal.super.ctor(self, BuffEnum.EFFECTSTATUS_WATER_ELEMENTAL_HEAL, time, actor)
    local ownerId = self._actor:getAgent():getObjId()
    local objId = string.format("WATER_ELEMENT_%s", ownerId)

    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent  then
        return 
    end

    local elementAgent = worldAgent:getAgent(objId)
    if elementAgent then
        elementAgent:playAttackAction()
    end
end

function BuffWaterElementHeal:onClear()
    BuffWaterElementHeal.super.onClear(self)
end


return BuffWaterElementHeal
