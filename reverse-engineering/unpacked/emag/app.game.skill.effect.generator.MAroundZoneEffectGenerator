--MAroundZoneEffectGenerator	g_StopZoneEffectGenerator;

------------------------------------------------------------------------
-- Generate
------------------------------------------------------------------------
local MAroundZoneEffectGenerator = class("MAroundZoneEffectGenerator", lt.MEffectGenerator)
local SkillEnum = lt.SkillEnum
local Constant = lt.Constant
local CacheManager = lt.CacheManager
local MapUtil = lt.MapUtil

local NUM = {
	[SkillEnum.SKILL_POWER_OF_LAND] = 0,
	[SkillEnum.SKILL_SPIT_STREAM] = 6,
	[SkillEnum.SKILL_SLAYER_BLADE_CUT_STORM] = 6,
}

local TILE_X = Constant.TILE_X	
local TILE_Y= Constant.TILE_Y 
local TILE_X_HALF= Constant.TILE_X_HALF 
local TILE_Y_HALF= Constant.TILE_Y_HALF 

function MAroundZoneEffectGenerator:generate(egInfo)
	math.randomseed(socket.gettime() * 1000)
	local bOK = false;

	local pTarget = egInfo.pEffectTarget;

	local skillId = egInfo.skillId;

	local num = NUM[skillId];
	local dwWaitCount = 0;

	for TempCount=0, num, 1 do
	
		dwWaitCount = 0;
		local pixelPoint =  cc.p(egInfo.x1, egInfo.y1)

		if (skillId == SkillEnum.SKILL_POWER_OF_LAND) then
		
			-- skillId = egInfo.effectSpriteType + math.random(0, 1);
            local result = egInfo.step % 4
			if (result == 0) then
				pixelPoint.x = pixelPoint.x - math.random(0, (TILE_X * 2) - 1) - TILE_X_HALF;
				pixelPoint.y = pixelPoint.y - math.random(0, (TILE_Y * 2) - 1) - TILE_Y_HALF;
            elseif (result == 1) then
				pixelPoint.x = pixelPoint.x - math.random(0, (TILE_X * 2) - 1) - TILE_X_HALF;
				pixelPoint.y = pixelPoint.y + math.random(0, (TILE_Y * 2) - 1) + TILE_Y_HALF;
            elseif (result == 2) then    
				pixelPoint.x = pixelPoint.x + math.random(0, (TILE_X * 2) - 1) + TILE_X_HALF;
				pixelPoint.y = pixelPoint.y - math.random(0, (TILE_Y * 2) - 1) - TILE_Y_HALF;
            elseif (result == 3) then    
				pixelPoint.x = pixelPoint.x + math.random(0, (TILE_X * 2) - 1) + TILE_X_HALF;
				pixelPoint.y = pixelPoint.y + math.random(0, (TILE_Y * 2) - 1) + TILE_Y_HALF;
			end
		
		------------------------------------------------------------------
		-- 바닥에 튀는 먼지..
		------------------------------------------------------------------
		--/*
		elseif (skillId==EFFECTSPRITETYPE_GUN_DUST_1) then
		
			local skillId
            local rand_value = math.random(0, 2)  -- 生成0到2之间的随机数

            if rand_value == 0 then
                skillId = EFFECTSPRITETYPE_GUN_DUST_1
            elseif rand_value == 1 then
                skillId = EFFECTSPRITETYPE_GUN_DUST_2
            elseif rand_value == 2 then
                skillId = EFFECTSPRITETYPE_GUN_DUST_3
            end
			pixelPoint.x = pixelPoint.x + (math.random(0, (TILE_X * 2) - 1)) - TILE_X;
			pixelPoint.y = pixelPoint.y + (math.random(0, (TILE_Y * 2) - 1)) - TILE_Y;
		elseif (skillId==EFFECTSPRITETYPE_MOLE_SHOT_1 ) then
		
			skillId = EFFECTSPRITETYPE_MOLE_SHOT_1+(math.random(0, 4));
			pixelPoint.x = pixelPoint.x + (math.random(0, (TILE_X * 2) - 1)) - TILE_X;
			pixelPoint.y = pixelPoint.y + (math.random(0, (TILE_Y * 2) - 1)) - TILE_Y;
		elseif( skillId == EFFECTSPRITETYPE_INSTALL_TURRET_SCRAP1) then
		
			skillId = EFFECTSPRITETYPE_INSTALL_TURRET_SCRAP1+(math.random(0, 4));
			pixelPoint.x = pixelPoint.x + (math.random(0, (TILE_X * 2) - 1))
			pixelPoint.y = pixelPoint.y+ (math.random(0, (TILE_Y * 2) - 1))
		elseif(skillId ==SkillEnum.SKILL_SLAYER_BLADE_CUT_STORM 
			or skillId == SkillEnum.SKILL_SPIT_STREAM
			-- or skillId == EFFECTSPRITETYPE_TIPOJYU_LIFE_GATEKEEPER_ATTACK_A
			-- or skillId == EFFECTSPRITETYPE_TIPOJYU_HADES_GATEKEEPER_ATTACK_A
			) then
		
			local dirX, dirY = self:calcDir(egInfo.direction)

			pixelPoint.x = egInfo.x0;
			pixelPoint.y = egInfo.y0;
			
			pixelPoint.x = pixelPoint.x + ((((TempCount+1)*(TILE_X_HALF))*dirX));
			pixelPoint.y = pixelPoint.y + ((((TempCount+1)*(TILE_Y_HALF))*dirY));
			dwWaitCount = (TempCount);
		elseif(skillId == EFFECTSPRITETYPE_GREAT_RUFFIAN_2_AXE_THROW) then
		
			pixelPoint.x = egInfo.x0; 
			pixelPoint.y = egInfo.y0;
		elseif(skillId == EFFECTSPRITETYPE_TEMP2640) then
		
			pixelPoint.x = egInfo.x0; 
			pixelPoint.y = egInfo.y0;
		end

		local effectMetas
		if skillId == SkillEnum.SKILL_POWER_OF_LAND then
			effectMetas = CacheManager:getHitMetas(skillId)
		elseif skillId == SkillEnum.SKILL_SPIT_STREAM or skillId == SkillEnum.SKILL_SLAYER_BLADE_CUT_STORM then
			effectMetas = CacheManager:getProcessMetas(skillId)
		end

		local function generateEffect()
			local bullet = lt.BullectScreenEffect.new(skillId, egInfo.direction, cc.p(pixelPoint.x, pixelPoint.y))
			bullet:addEffect(skillId, effectMetas[2])

			local mTarget, nTarget = MapUtil:PixelToMap(pixelPoint.x, pixelPoint.y)
			local zorder = (nTarget  * 10000 + mTarget + 9999) * 10 + 100
			lt.BulletManager:addBulletToMapZOrder(bullet, zorder)
		end
		if dwWaitCount then
			lt.ScheduleUtil:performWithDelayGlobal(function()
				generateEffect()
			end, dwWaitCount * 0.06)
		else
			generateEffect()
		end
    end
	
	return bOK;
end

function MAroundZoneEffectGenerator:calcDir(direction)
	local dirX, dirY = 0, 0;
	if direction == Constant.DIRECTION_LEFT_DOWN then
		dirX = -1
		dirY = -1
	elseif direction == Constant.DIRECTION_RIGHT_UP then
		dirX = 1
		dirY = 1
	elseif direction == Constant.DIRECTION_LEFT_UP then
		dirX = -1
		dirY = 1
	elseif direction == Constant.DIRECTION_RIGHT_DOWN then
		dirX = 1
		dirY = -1
	elseif direction == Constant.DIRECTION_LEFT then
		dirX = -1
	elseif direction == Constant.DIRECTION_DOWN then
		dirY = -1
	elseif direction == Constant.DIRECTION_UP then
		dirY = 1
	elseif direction == Constant.DIRECTION_RIGHT then
		dirX = 1
	end
	return dirX, dirY
end

return MAroundZoneEffectGenerator
