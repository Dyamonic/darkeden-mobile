local DungeonDao = {}

function DungeonDao:queryAll()
    local map = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Dungeon") do
        local meta = lt.DungeonMeta.new(row)
        if not map[meta:getPlayType()] then
            map[meta:getPlayType()] = {}
        end
        table.insert(map[meta:getPlayType()], meta)
    end
    return map
end

return DungeonDao
