--开服活动签到礼包：等级礼包
---@class UIWndExit:UIWindowBase
local UIWndWelfareGift          = class("UIWndWelfareGift", lt.UIWindowBase)
local WelfareModule = lt.WelfareModule
local NtfManager = lt.NtfManager

local TITLE_NAME = {
    [1] = {Id = 1,Key = "Sign",titlename = GReadText.KEY_WELFARE_TITLE_NAME1,bg = "bg_fl_qiribanner",title = "title_fl_qirisol"},
    [2] = {Id = 2,Key = "HeroLevel",titlename = GReadText.KEY_WELFARE_TITLE_NAME2,bg = "bg_fl_linshidi",title = "title_fl_djdbhlfs"}
}

function UIWndWelfareGift:ctor(param)
    self:registerComponent("UICompWelfareGiftRewardCell","UICompWelfareTitle")
    UIWndWelfareGift.super.ctor(self,param)
end

function UIWndWelfareGift:onClear()
    if self._titleList then
        self._titleList:removeChildrenToPool()
        self._titleList:removeItemRenderer()
        self._titleList = nil
    end
    if self._rewardList then
        self._rewardList:removeChildrenToPool()
        self._rewardList:removeItemRenderer()
        self._rewardList = nil
    end
    self._titleIcon = nil
    self._titleBg   = nil
    self._cellDataArr = nil
    self._selectIndex = nil
    self._openTitleArr = nil
    self:unregisterAllComponent()
    UIWndWelfareGift.super.onClear(self)
end

function UIWndWelfareGift:onInit()
    UIWndWelfareGift.super.onInit(self, _GURL.WelfareWndPanel)
    self._titleList  = self:getChild("list_title")
    self._titleList:setItemRenderer(handler(self, self.onBtnsRender))
    self._titleList:setVirtual()
    self._rewardList = self:getChild("listReward")
    self._rewardList:setItemRenderer(handler(self, self.onCellRender))
    self._titleIcon = self:getChild("titleIcon")
    self._titleBg   = self:getChild("titleBg")
end

function UIWndWelfareGift:onShown()
    self._titleList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickTargetItem))
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_WELFARE_CHANGE_EVENT, handler(self, self.initButtonList), "UIWndWelfareGift:initButtonList")
    self:initButtonList()
end

function UIWndWelfareGift:initButtonList(event)
    if not WelfareModule:getGiftRewardOpen() then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndWelfareGift", close=true})
        return
    end
    self._openTitleArr = WelfareModule:checkOpenList(TITLE_NAME)
    if self._selectIndex == nil then
        self._selectIndex = WelfareModule:getFirstShowTitle(self._openTitleArr)
    end
    if event then
        local closeold = true
        for i = 1,#self._openTitleArr do
            if self._openTitleArr[self._selectIndex] and self._openTitleArr[i].Id == self._openTitleArr[self._selectIndex].Id then
                self._selectIndex = i
                closeold = false
            end
        end
        if closeold then
            self._selectIndex = 1
        end
    end
    self._titleList:setNumItems(#self._openTitleArr)
    self:setSelectBut()
end

function UIWndWelfareGift:onHide()
    if self._titleList then
        self._titleList:removeChildrenToPool()
        self._titleList:removeItemRenderer()
        self._titleList = nil
    end
    if self._rewardList then
        self._rewardList:removeChildrenToPool()
        self._rewardList:removeItemRenderer()
        self._rewardList = nil
    end
    NtfManager:removeNtfListenerByTag("UIWndWelfareGift:initButtonList")
    UIWndWelfareGift.super.onHide(self)
end

function UIWndWelfareGift:onEnter()
    UIWndWelfareGift.super.onEnter(self)
end

function UIWndWelfareGift:onExit()
    UIWndWelfareGift.super.onExit(self)
end

function UIWndWelfareGift:onClickTargetItem(context)
    if self._selectIndex ~= context:getData():getIndex() then
        self._selectIndex = context:getData():getIndex()
        self:setSelectBut()
    end
end

function UIWndWelfareGift:setSelectBut()
    self._selectIndex = self._selectIndex or 1
    local res_hard = "ui://Welfare/%s"
    local selectData = self._openTitleArr[self._selectIndex]
    self._titleIcon:setURL(string.format(res_hard,selectData.title))
    self._titleBg:setURL(string.format(res_hard,selectData.bg))
    local childs = self._titleList:getChildren()
    for i = 1, #childs do
        if childs[i]:getIndex() == self._selectIndex then
            childs[i]:setSelect(true)
        else
            childs[i]:setSelect(false)
        end
    end
    self:onInitRewardItem()
end

function UIWndWelfareGift:swichRed()
    local childs = self._titleList:getChildren()
    for i = 1, #childs do
        if childs[i]:getData().Id then
            childs[i]:setRed(WelfareModule:checkRedPoint(childs[i]:getData().Id))
        end
    end
end

function UIWndWelfareGift:onInitRewardItem()
    local selectData = self._openTitleArr[self._selectIndex]
    local list = WelfareModule:getGiftMapByRace(selectData.Id)
    self._cellDataArr = list
    self._rewardList:setVirtual()
    self._rewardList:setNumItems(#self._cellDataArr)
end

--右侧奖励
function UIWndWelfareGift:onCellRender(index, obj)
    local index = index + 1
    local data = self._cellDataArr[index]
    if data then
        obj:setInfo(data,index,self._openTitleArr[self._selectIndex].Id)
        obj.index = index
        obj:insertObjectToFactory(self)
    end
end
--左侧页签按钮
function UIWndWelfareGift:onBtnsRender(index, obj)
    local index = index + 1
    obj:insertObjectToFactory(self)
    obj:setInfo(self._openTitleArr[index],index)
    obj.index = index
    obj:setRed(WelfareModule:checkRedPoint(self._openTitleArr[index].Id))
    if index == self._selectIndex then
        obj:setSelect(true)
    else
        obj:setSelect(false)
    end
end

return UIWndWelfareGift
