-- 光环
local HaloMeta = class("HaloMeta")
function HaloMeta:ctor(row)
    self:initWithRow(row)
end

function HaloMeta:initWithRow(row)
    self._Id        = row.Id
    self._name      = row.Name
    self._type      = row.Type
    self._skill     = row.Skill
    self._icon      = row.Icon
    self._quality   = row.Quality
    self._level     = row.Level
    self._race      = row.Race
    if row.Attr == "" then
        self._attr = nil
    else
        self._attr = json.decode(row.Attr)
    end
    if row.Cost == "" then
        self._cost = nil
    else
        self._cost = json.decode(row.Cost)
    end
end
function HaloMeta:getId() return self._Id end
function HaloMeta:getName() return self._name end
function HaloMeta:getType() return self._type end
function HaloMeta:getSkill() return self._skill end
function HaloMeta:getIcon() return self._icon end
function HaloMeta:getQuality() return self._quality end
function HaloMeta:getLevel() return self._level end
function HaloMeta:getRace() return self._race end
function HaloMeta:getAttr() return self._attr end
function HaloMeta:getCost() return self._cost end

return HaloMeta
