local ShadowDancingEffect = class("ShadowDancingEffect")
local AgentManager = lt.AgentManager
local MapUtil = lt.MapUtil
local Constant = lt.Constant
function ShadowDancingEffect:generate(egInfo)
    local fromAgentId = egInfo.fromAgentId
    local targetAgentId = egInfo.targetAgentId
    local skillId = egInfo.skillId 

    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent  then
        return 
    end

    local heroAgent = AgentManager:getAgent(fromAgentId)
    if not heroAgent then
        return
    end

    local targetAgent = AgentManager:getAgent(targetAgentId)
    if not targetAgent then
        return
    end

    self._heroAgent = heroAgent
    self._targetAgent = targetAgent
    self._skillId = skillId
    self._worldAgent = worldAgent

    for creatureID = 1, 3 do
        self:createFakeCreature(creatureID)
    end
end


function ShadowDancingEffect:getDestMN()
    local mTarget, nTarget = self._targetAgent:getMNExactly()
    local mHero, nHero = self._heroAgent:getMNExactly()
    local sx = mHero - mTarget
    local sy = nHero - nTarget

    if sx > 0 then
        sx = 1
    elseif sx < 0 then
        sx = -1
    else
        sx = 0
    end

    if sy > 0 then
        sy = 1
    elseif sy < 0 then
        sy = -1
    else
        sy = 0
    end

    return  {{x = sx, y = sy}, {x = sx, y = -sy}, {x = -sx, y = sy }}
end


function ShadowDancingEffect:createFakeCreature(creatureID)
   
    local heroData = clone(self._heroAgent:getHeroData())
    heroData:setFakeCreatureType(Constant.FAKE_CREATURE_TYPE.FAST_MOVE_ACTION)
    heroData:setCrossCounter(true)
    
    local mTarget, nTarget = self._targetAgent:getMNExactly()
    local mHero, nHero = self._heroAgent:getMNExactly()
    local direction
    if mHero == mTarget and nHero == nTarget then
        direction = self._heroAgent:getDirection()
    else
        direction = MapUtil:getDirectionToPosition(mHero, nHero, mTarget, nTarget)
    end

    local cloneObjId = heroData:getObjId() .. Constant.CLONETAG.SHADOW_DACING .. creatureID
    heroData:setObjId(cloneObjId)
    heroData:setDirection(direction)

    local cxy = self:getDestMN()

    --设置目标点
    local destM, destN = mTarget + cxy[creatureID].x, nTarget + cxy[creatureID].y
    local destDirection = MapUtil:getDirectionToPosition(destM, destN, mTarget, nTarget)
    heroData:setShadowDancingDest(destM, destN, destDirection)

    local cloneM, cloneN = mHero, nHero
    self._worldAgent:createHeroAgent(heroData, cloneM, cloneN, direction, false, false)


    
    local cloneAgent = self._worldAgent:getAgent(cloneObjId)
    cloneAgent:setDirection(direction)
end







return ShadowDancingEffect