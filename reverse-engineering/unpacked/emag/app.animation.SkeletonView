
local SkeletonView = class("SkeletonView", lt.SkeletonBase)

SkeletonView._spine = nil

function SkeletonView:ctor(skeletonData, sizeRenderTexture)
    self._skeletonData = skeletonData
    self._spine = sp.SkeletonAnimation:createWithData(skeletonData)
    self:addChild(self._spine)

    SkeletonView.super.ctor(self, skeletonData)

end

function SkeletonView:onCleanup()
    SkeletonView.super.onCleanup(self)
end

function SkeletonView:onEnter()
    SkeletonView.super.onEnter(self)
end

function SkeletonView:onExit()
    SkeletonView.super.onExit(self)
end

function SkeletonView:createWithData(skeletonData)
    return SkeletonView.new(skeletonData)
end

function SkeletonView:setSkeletonScale(scale)
    self._spine:setScaleX(scale)
    self._spine:setScaleY(scale)
end

function SkeletonView:setSkeletonScaleX(scaleX)
    self._spine:setScaleX(scaleX)
end

function SkeletonView:setSkeletonScaleY(scaleY)
    self._spine:setScaleY(scaleY)
end

function SkeletonView:stopMixAnimation(trackIndex)
    if self._enableMix == false then return end

    self:clearTrack(trackIndex)
    self._enableMix = false
end

function SkeletonView:resetSkeletonWithAnimation(trackIndex, name, isLoop)
    if not name then return end

    self:clearTracks()

    if not self:setAnimation(trackIndex, name, isLoop) then return end

    if self._enableMix then
        self:clearTrack(trackIndex)
    end

    self._enableMix = false
end

function SkeletonView:resetActorWithAnimation(name, isLoop)
    if not name then return end

    self:clearTracks()

    if not self:setAnimation(0, name, isLoop) then
        return
    end

    if self._enableMix then
        self:clearTrack(0)
    end

    self._enableMix = false
end


function SkeletonView:getSkeletonAnimation()
    return self._spine
end

return SkeletonView
