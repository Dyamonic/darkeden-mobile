UICompGuildUnionListCell.ChangeSkinConf = {
    ["Guild"] = {
        ["bg"] = "bg_gonghuixt_16",
    },
    ["CommonTL"] = {
        ["btn_union"] = { icon = "bg_youjian_changanniu02" },
