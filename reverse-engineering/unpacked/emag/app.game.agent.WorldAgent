function WorldAgent:onScroll(scrollY)
    self._mapAgent:onScroll(scrollY)
end

-- 注: 获取npcagent使用getNpcAgentById(npcId)方法
function WorldAgent:getAgent(objId)
    if not self._agentTable then
        return
    end
    return self._agentTable[objId]
end

function WorldAgent:getNpcAgentByName(name)
    for _, agent in pairs(self._agentTable) do
        if agent:getAgentType() == Constant.AGENT_TYPE_NPC and agent:getName() == name then
            return agent:getObjId()
        end
    end

    return nil
end

function WorldAgent:setNpcAgentVisibleByName(name, isVisible)
    for _, agent in pairs(self._agentTable) do
        if agent:getAgentType() == Constant.AGENT_TYPE_NPC and agent:getName() == name then
            agent:changeVisible(isVisible)
            return
        end
    end
end

function WorldAgent:getNpcAgentById(npcId)
    if not npcId then
        return
    end
    local objId = lt.Constant.CLONETAG.NPCDEFAULT .. npcId
    return self._agentTable[objId]
end

function WorldAgent:getNpcAgentByNpcName(name)
    for _, agent in pairs(self._agentTable) do
        if agent:getAgentType() == Constant.AGENT_TYPE_NPC and agent:getName() == name then
            return agent
        end
    end
    return nil
end

function WorldAgent:getNpcNameById(id)
    local agent = self:getNpcAgentById(id)
    if agent then
        return agent:getName()
    end
    return nil
end

-- 判断m,n位置是否有ItemAgent
function WorldAgent:hasItemAgent(mTarget, nTarget)
    for _, agent in pairs(self._agentTable) do
        if agent:getAgentType() == Constant.AGENT_TYPE_ITEM then
            local m, n = agent:getMNExactly()
            if m == mTarget and n == nTarget then
                return true
            end
        end
    end

    return false
end

function WorldAgent:queryItemAgentArray(mTarget, nTarget)
    local agentArray = {}

    for _, agent in pairs(self._agentTable) do
        if agent:getAgentType() == Constant.AGENT_TYPE_ITEM then
            local m, n = agent:getMNExactly()
            if m == mTarget and n == nTarget then
                agentArray[#agentArray + 1] = agent
            end
        end
    end

    return agentArray
end

