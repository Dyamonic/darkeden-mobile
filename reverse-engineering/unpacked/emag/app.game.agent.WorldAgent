local WorldAgent = class("WorldAgent", lt.BaseAgent)

local Constant = lt.Constant
local CmdDie = lt.CmdDie
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local CacheManager = lt.CacheManager
local AutoFightManager = lt.AutoFightManager
WorldAgent._gameLayer = nil

WorldAgent._mapAgent = nil
WorldAgent._heroAgent = nil
WorldAgent._pickTable = nil -- 配合捡东西
WorldAgent._pickLockTable = nil
WorldAgent._agentTable = nil

-- 记录跨地图寻路状态
WorldAgent._mapLinkArray = nil
WorldAgent._mapLinkMTarget = nil
WorldAgent._mapLinkNTarget = nil

--npc/怪物箭头
WorldAgent._npcArrowCue = {}
WorldAgent._monsterArrowCue = {}

--自动拾取四个方向向量
local autoList = { cc.p(1, 0), cc.p(0, 1), cc.p(-1, 0), cc.p(0, -1) }

function WorldAgent:ctor(gameLayer)
    WorldAgent.super.ctor(self, Constant.AGENT_TYPE_WORLD)

    self._gameLayer = gameLayer

    --local heroX, heroY = 25632, -8656
    local heroX, heroY = 381 * 64 - 32, -(279 * 32 - 16)

    -- MapAgent
    self._mapAgent = lt.MapAgent.new()
    self._gameLayer:addChild(self._mapAgent:getMapActor())


    -- HeroAgent
    -- self._heroAgent = lt.HeroAgent.new(heroX, heroY, true)
    -- self._mapAgent:addHeroAgent(self._heroAgent)

    -- self._mapAgent:adjustPosition(heroX, heroY)

    -- agentTable
    self._agentTable = {}

    self._pickTable = {}
    self._pickLockTable = {}
    self._darknessTrapMNs = {} --黑暗之触坐标点
    self._playerList = nil
    self._bossList = {}
    self._crossCount = 1       --反击假身计数
    lt.AgentManager:setWorldAgent(self)
end

function WorldAgent:onClear()
    lt.LogUtil:debug("WorldAgent:onClear()")
    --self._heroAgent:onClear()

    for key, agent in pairs(self._agentTable) do
        agent:onClear()
        self._agentTable[key] = nil
    end

    self._mapAgent:onClear()

    self._heroAgent = nil
    self._mapAgent = nil
    self._agentTable = nil
    self._pickTable = nil
    self._pickLockTable = nil
    self:clearVisibleList()
end
-- local fame = {"场景","地图","英雄","怪物","NPC","道具","技能","TARP","CAKE","元素"}
function WorldAgent:onUpdate(delta)
    -- self:upDateAgentTable(delta)
    -- local agent_count = {}
    for _, agent in pairs(self._agentTable) do
        agent:onUpdate(delta)
        -- local _type = agent:getAgentType()
        -- agent_count[_type] = agent_count[_type] or 0
        -- agent_count[_type] = agent_count[_type] + 1
    end
    lt.GameModule:onUpdate()
    lt.SkillCdManager:onUpdate()
    lt.BulletManager:onUpdate()
    lt.BulletSystem:onUpdate()

    lt.AudioManager:onUpdate()
    -- MapAgent
    self._mapAgent:onUpdate()

    if self._heroAgent then
        local heroX, heroY = self._heroAgent:getPosition()
        self._mapAgent:adjustPosition(heroX, heroY)
        local m, n = self._heroAgent:getMN()
        self._mapAgent:updateMusic(m, n)
        self._mapAgent:updateSafeArea(m, n)
        self:checkHaloRange()
    end
    -- if lt.TimeCounter:serverTime() ~= self._time then
    --     self._time = lt.TimeCounter:serverTime()
    --     local names = ""
    --     for k,va in pairs(agent_count) do
    --         names = names..fame[k]..va.."个，"
    --     end
    --     print(string.format("总刷新个数:%d 执行时间%f", table.nums(self._agentTable),delta),names)
    -- end
end

function WorldAgent:upDateAgentTable(delta)
    if self._heroAgent then
        self._heroAgent:onUpdate(delta)
    end
    local dalaylevel = 0
    if delta >= 0.05 then
        --20帧[严重阻塞]
        dalaylevel = 4
    elseif delta >= 0.034 then
        --30帧[比较拥堵]
        dalaylevel = 3
    elseif delta >= 0.0222 then
        --45帧[一般]
        dalaylevel = 2
    else
        --55+[丝滑]
        dalaylevel = 1
    end
    local count, dcount = 1, 0
    local _Tdistance = self._mapAgent:resetCameraMN() --重置地图边界
    if dalaylevel == 4 then
        for _, agent in pairs(self._agentTable) do
            local mHero, nHero = self._heroAgent:getMNExactly()
            local mTarget, nTarget = agent:getMNExactly()
            local distance = math.max(math.abs(mTarget - mHero), math.abs(nTarget - nHero))
            if self._mapAgent:inMapCamera(mTarget, nTarget) then
                if self._heroAgent ~= agent and agent:getAgentType() == Constant.AGENT_TYPE_HERO then
                    if distance <= _Tdistance*0.4 then--极端的卡顿靠近边缘20%约1格的用户不立刻刷新
                        agent:onUpdate(delta)
                        count = count + 1
                    else
                        agent:onDelayUpdate(delta, dalaylevel)
                        dcount = dcount + 1
                    end
                elseif agent:getAgentType() == Constant.AGENT_TYPE_MONSTER then
                    if distance <= _Tdistance*0.3 then--极端的卡顿靠近边缘20%约2格的怪物不立刻刷新
                        agent:onUpdate(delta)
                        count = count + 1
                    else
                        agent:onDelayUpdate(delta, dalaylevel)
                        dcount = dcount + 1
                    end
                elseif agent:getAgentType() == Constant.AGENT_TYPE_TRAP then
                    if distance <= _Tdistance*0.4 then--极端的卡顿靠近边缘20%约1格陷阱特性不立刻刷新
                        agent:onUpdate(delta)
                        count = count + 1
                    else
                        agent:onDelayUpdate(delta, dalaylevel)
                        dcount = dcount + 1
                    end
                else
                    if agent.onDelayUpdate then
                        agent:onDelayUpdate(delta, dalaylevel)
                        dcount = dcount + 1
                    else
                        agent:onUpdate(delta)
                        count = count + 1
                    end
                end
            end
        end
    elseif dalaylevel == 3 then
        for _, agent in pairs(self._agentTable) do
            local mHero, nHero = self._heroAgent:getMNExactly()
            local mTarget, nTarget = agent:getMNExactly()
            local distance = math.max(math.abs(mTarget - mHero), math.abs(nTarget - nHero))
            if self._heroAgent ~= agent then
                if self._mapAgent:inMapCamera(mTarget, nTarget) then
                    if agent:getAgentType() == Constant.AGENT_TYPE_TRAP or agent:getAgentType() == Constant.AGENT_TYPE_MONSTER then
                        if distance <= _Tdistance*0.5 then--角色正常刷新按照不追帧进行
                            agent:onUpdate(delta, 2)
                            count = count + 1
                        else
                            agent:onDelayUpdate(delta, dalaylevel)
                            dcount = dcount + 1
                        end
                    else
                        if agent.onDelayUpdate then
                            agent:onDelayUpdate(delta, dalaylevel)
                            dcount = dcount + 1
                        else
                            agent:onUpdate(delta)
                            count = count + 1
                        end
                    end
                end
            end
        end
    elseif dalaylevel == 2 then
        for _, agent in pairs(self._agentTable) do
            --满足正常刷新需求
            local mTarget, nTarget = agent:getMNExactly()
            if self._mapAgent:inMapCamera(mTarget, nTarget) then
                if self._heroAgent ~= agent then
                    if agent.onDelayUpdate then
                        agent:onDelayUpdate(delta, dalaylevel)
                        count = count + 1
                    else
                        agent:onUpdate(delta)
                        count = count + 1
                    end
                end
            end
        end
    else
        for _, agent in pairs(self._agentTable) do
            if self._heroAgent ~= agent then
                --正常刷新切补上之前的挤压
                local mTarget, nTarget = agent:getMNExactly()
                if self._mapAgent:inMapCamera(mTarget, nTarget) then
                    agent:onUpdate(delta)
                    count = count + 1
                end
            end
        end
    end
    -- if dalaylevel >= 4 then
    --     --极端的卡顿先刷新英雄
    --     for _, agent in pairs(self._heroTable) do
    --         local mHero,nHero = self._heroAgent:getMNExactly()
    --         local mTarget,nTarget = agent:getMNExactly()
    --         local distance = math.max(math.abs(mTarget - mHero), math.abs(nTarget - nHero))
    --         if self._heroAgent ~= agent and distance < 16 then
    --             agent:onUpdate(delta)
    --         end
    --     end
    -- else
    --     for _, agent in pairs(self._agentTable) do
    --         local mHero,nHero = self._heroAgent:getMNExactly()
    --         local mTarget,nTarget = agent:getMNExactly()
    --         local distance = math.max(math.abs(mTarget - mHero), math.abs(nTarget - nHero))
    --         if self._heroAgent ~= agent and distance < 16 then
    --             agent:onUpdate(delta)
    --         end
    --     end
    -- end
end

