
local BaseLayer = class("BaseLayer", function()
    return display.newLayer()
end)

function BaseLayer:ctor(param)
    self:enableNodeEvents()
    self:setSwallowsTouches(true)
end

function BaseLayer:onCleanup()
	self:onViewOutHandler()
    self:onClear()
end

function BaseLayer:onClear()
end

function BaseLayer:onViewOutHandler()

end

return BaseLayer
