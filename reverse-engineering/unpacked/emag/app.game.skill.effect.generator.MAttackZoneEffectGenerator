function MAttackZoneEffectGenerator:getMNByDir(eTileX, eTileY, tempDir)
    if tempDir == Constant.DIRECTION_LEFT_DOWN then
        eTileX = eTileX - MOVE_GRID
        eTileY = eTileY + MOVE_GRID
    elseif tempDir == Constant.DIRECTION_RIGHT_UP then
        eTileX = eTileX + MOVE_GRID
        eTileY = eTileY - MOVE_GRID
    elseif tempDir == Constant.DIRECTION_LEFT_UP then
        eTileX = eTileX - MOVE_GRID
        eTileY = eTileY - MOVE_GRID
    elseif tempDir == Constant.DIRECTION_RIGHT_DOWN then
        eTileX = eTileX + MOVE_GRID
        eTileY = eTileY + MOVE_GRID
    elseif tempDir == Constant.DIRECTION_LEFT then
        eTileX = eTileX - MOVE_GRID
    elseif tempDir == Constant.DIRECTION_DOWN then
        eTileY = eTileY + MOVE_GRID
    elseif tempDir == Constant.DIRECTION_UP then
        eTileY = eTileY - MOVE_GRID
    elseif tempDir == Constant.DIRECTION_RIGHT then
        eTileX = eTileX + MOVE_GRID
    end
    return eTileX, eTileY
end


return MAttackZoneEffectGenerator