
local BuffDao = {}

function BuffDao:query(buffId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Buff WHERE BuffId=%d;", buffId)) do
    	local buffMeta = lt.BuffMeta.new(row)
        return buffMeta
    end
end

function BuffDao:queryBuffBySkillID(skillId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Buff WHERE SkillId=%d;", skillId)) do
    	local buffMeta = lt.BuffMeta.new(row)
        return buffMeta
    end
end

return BuffDao
