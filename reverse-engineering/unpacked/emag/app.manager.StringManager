-- 返回格式后字符串,默认显示颜色
function StringManager:getTimeInfo(time)
    local strArray = StringManager:getString(StringManager.KEY_SPIRIT_TIMETIP)
    local strs = ""
    local color = lt.Constant.COLOR_TEXT_RED
    if not time then
        return strs,color
    end
    if time == 0 then
        strs = strArray[1]
        color = lt.Constant.COLOR_GREEN_H
    else
        local timenum = os.time()
        local leftime = time - timenum
        if leftime > 86400 then
            strs = math.ceil(leftime/86400)..strArray[2]
        else
            strs = math.ceil(leftime/3600)..strArray[3]
        end
    end
    return strs,color
end

-- ---------------------------ERROR CODE-----------------------------------
function StringManager:getStringByErrorCode(errorCode)
    local str = self._errorCodeTable[errorCode]
    if not str then
        lt.LogUtil:debugError("errorCode = "..tostring(errorCode))
        str = self._errorCodeTable[1001]
    end
    return str
end

