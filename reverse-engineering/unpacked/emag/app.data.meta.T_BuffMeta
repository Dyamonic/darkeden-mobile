
local BuffMeta = class("BuffMeta")



function BuffMeta:ctor(row)
	self:initWithRow(row)
end

function BuffMeta:initWithRow(row)
    self._buffId      = row.BuffId
    self._name        = row.Name
    self._skillId     = row.SkillId
    self._spriteId    = row.SpriteId
    self._description = row.Description
    self._buffType    = row.BuffType
    self._hasTime     = row.HasTime
    self._allowRepeat = row.AllowRepeat
    self._isIntercept = row.IsIntercept
    self._deathBuff   = row.DeathBuff
end

function BuffMeta:hasTime()
    return tonumber(self._hasTime) == 1
end

function BuffMeta:allowRepeat()
    return tonumber(self._allowRepeat) == 1
end

function BuffMeta:isIntercept()
    return tonumber(self._isIntercept) == 1
end

function BuffMeta:isDeathClear()
    return tonumber(self._deathBuff) == 1
end

-- AUTO GENERATED GETTERS START
-- 以下方法由脚本自动生成，请勿手动修改

function BuffMeta:getBuffId() return self._buffId end
function BuffMeta:getName() return self._name end
function BuffMeta:getSkillId() return self._skillId end
function BuffMeta:getSpriteId() return self._spriteId end
function BuffMeta:getDescription() return self._description end
function BuffMeta:getBuffType() return self._buffType end
function BuffMeta:getDeathBuff() return self._deathBuff end

-- AUTO GENERATED GETTERS END
return BuffMeta
