---@申请列表
---@class UICompTeamApply
local UICompTeamApply = class("UICompTeamApply", lt.UICompBase, lt.UICompChangeSkin)

UICompTeamApply.ChangeSkinConf = {
    ["Team"] = {
        ["img_di"] = "bg_zuduixitong_shenqlbtc",
        ["img_bg"] = "bg_zuduixitong_sqlbdi",
        ["img_title"] = "bg_zuduixitong_sqlbwenzilan",
    },
    ["CommonTL"] = {
        ["btn_refresh"] = {bg = "bg_youjian_changanniu01", disabled = "bg_youjian_changanniu02"},
        ["btn_clearall"] = {bg = "bg_youjian_changanniu01", disabled = "bg_youjian_changanniu02"},
        ["closeButton"] = {bg  = "bg_beibao_anniu01", bgup  = "bg_beibao_anniu02"},
    }
}

local StringManager = lt.StringManager
local CacheManager = lt.CacheManager
local NtfManager = lt.NtfManager
local ItemModule = lt.ItemModule
local TeamModule = lt.TeamModule
local Constant = lt.Constant

function UICompTeamApply:ctor()
    self:registerComponent("UICompTeamApplyCell")
    UICompTeamApply.super.ctor(self)
    --UI
    self._refreshBtn = nil
    self._reddot = nil
    self._clearAllBtn = nil
    self._closeButton = nil
    self._applyList = nil
    self._touchLayer = nil
    --数据
    self._applyTeamList = nil
end

function UICompTeamApply:onClear()
    --UI
    self._refreshBtn = nil
    self._reddot = nil
    self._clearAllBtn = nil
    self._closeButton = nil
    self._applyList = nil
    self._touchLayer = nil
    --数据
    self._applyTeamList = nil
    self:unregisterAllComponent()
    UICompTeamApply.super.onClear(self)
end

function UICompTeamApply:onConstruct()
    self:startSkin()
    self._refreshBtn = self:getChild("btn_refresh")
    self._reddot = self._refreshBtn:getChild("reddot")
    self._clearAllBtn = self:getChild("btn_clearall")
    self._closeButton = self:getChild("closeButton")
    self._applyList = self:getChild("list_apply")
    self._touchLayer = self:getChild("touchLayer") -- 触摸关闭
    self._applyList:setItemRenderer(handler(self, self.renderApplyItem))

end

function UICompTeamApply:onEnter()
    UICompTeamApply.super.onEnter(self)
    self._refreshBtn:addClickListener(handler(self, self.onRefreshBtnClick))
    self._clearAllBtn:addClickListener(handler(self, self.onClearAllBtnClick))
    self._closeButton:addClickListener(handler(self, self.onCancelBtnClick))
    self._touchLayer:addClickListener(handler(self, self.onCancelBtnClick))

end
function UICompTeamApply:onExit()
    self._refreshBtn:removeClickListener()
    self._clearAllBtn:removeClickListener()
    self._closeButton:removeClickListener()
    self._applyList:removeClickListener()
    self._touchLayer:removeClickListener()
    UICompTeamApply.super.onExit(self)
end

function UICompTeamApply:initUI()
end

function UICompTeamApply:refreshView()
    self._applyTeamList = TeamModule:getApplyTeamList()
    self._applyList:setNumItems(#self._applyTeamList)
    --刷新红点
    self:uptRedDotEvt()
end

function UICompTeamApply:onRefreshBtnClick()
    TeamModule:checkRedTips(false)
    TeamModule:sendApplyTeamList()
end

function UICompTeamApply:onClearAllBtnClick()
    TeamModule:sendClearApplyTeamList()
end

function UICompTeamApply:onCancelBtnClick()
    self:setVisible(false)
end

function UICompTeamApply:renderApplyItem(index, obj)
    local playerInfo = self._applyTeamList[index + 1]
    obj:setInfo(playerInfo)
end

--刷新申请列表红点
function UICompTeamApply:uptRedDotEvt()
    local isShowRedDot = TeamModule:getRedPoint()
    self._reddot:setVisible(isShowRedDot)
end

return UICompTeamApply