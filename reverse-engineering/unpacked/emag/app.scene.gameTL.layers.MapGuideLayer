---@class MapGuideLayer 地图引导层(边缘红色箭头)
local MapGuideLayer = class("MapGuideLayer", lt.UICompBase)
local CacheManager  = lt.CacheManager
local TimeTrigger   = lt.TimeTrigger

function MapGuideLayer:ctor()
    MapGuideLayer.super.ctor(self)
    self._timeTrigger = TimeTrigger.new(0.5)
    self:initUI()
end

function MapGuideLayer:initUI()
    self._view = fgui.UIPackage:createObject("Main", "MapGuideLayer")
    self._view:makeFullScreen()
    self._view:center()
    self:addChild(self._view)

    self._imgMapTop    = self._view:getChild("img_top")
    self._lblMapTop    = self._view:getChild("lbl_top")
    self._imgMapRight  = self._view:getChild("img_right")
    self._lblMapRight  = self._view:getChild("lbl_right")
    self._imgMapBottom = self._view:getChild("img_bottom")
    self._lblMapBottom = self._view:getChild("lbl_bottom")
    self._imgMapLeft   = self._view:getChild("img_left")
    self._lblMapLeft   = self._view:getChild("lbl_left")
    self:setAllVisible(false)
end

function MapGuideLayer:onClear()
    self:removeFromParent()
    self._view = nil
    self._imgMapTop = nil
    self._lblMapTop = nil
    self._imgMapRight = nil
    self._lblMapRight = nil
    self._imgMapBottom = nil
    self._lblMapBottom = nil
    self._imgMapLeft = nil
    self._lblMapLeft = nil
    self._timeTrigger = nil
    MapGuideLayer.super.onClear(self)
end

function MapGuideLayer:onEnter()
    MapGuideLayer.super.onEnter(self)

end

function MapGuideLayer:onExit()
    MapGuideLayer.super.onExit(self)
end

function MapGuideLayer:setAllVisible(isShow)
    self._imgMapTop:setVisible(isShow)
    self._lblMapTop:setVisible(isShow)
    self._imgMapLeft:setVisible(isShow)
    self._lblMapLeft:setVisible(isShow)
    self._imgMapBottom:setVisible(isShow)
    self._lblMapBottom:setVisible(isShow)
    self._imgMapRight:setVisible(isShow)
    self._lblMapRight:setVisible(isShow)
end

function MapGuideLayer:onUpdate(dt)
    if self._timeTrigger and self._timeTrigger:tick(dt) then
        local worldAgent = lt.AgentManager:getWorldAgent()
        if not worldAgent then return self:setAllVisible(false) end

        local mapAgent = worldAgent:getMapAgent()
        if not mapAgent then return self:setAllVisible(false) end

        local heroAgent = worldAgent:getHeroAgent()
        if not heroAgent then return end

        local m, n = heroAgent:getMN()
        local top, bottom, left, right, mapM, mapN = mapAgent:getCheckMapBorder()

        -- 定义每个方向的配置
        local directions = {
            {
                pos     = "Top",
                visible = top == 1,
                mm      = m,
                nn      = 0,
            },
            {
                pos     = "Left",
                visible = left == 1,
                mm      = 0,
                nn      = n,
            },
            {
                pos     = "Bottom",
                visible = bottom == 1,
                mm      = m,
                nn      = mapN - 1,
            },
            {
                pos     = "Right",
                visible = right == 1,
                mm      = mapM - 1,
                nn      = n,
            }
        }

        for _, dir in ipairs(directions) do
            self:_updateDirection(dir, mapAgent)
        end
    end
end

-- 单个方向的更新逻辑
function MapGuideLayer:_updateDirection(dir, mapAgent)
    local imgKey = "_imgMap" .. dir.pos
    local lblKey = "_lblMap" .. dir.pos

    self[imgKey]:setVisible(dir.visible)
    self[lblKey]:setVisible(dir.visible)

    if not dir.visible then return end

    local portalSector = mapAgent:getPortalSector(dir.mm, dir.nn)
    local linkmap = nil

    if portalSector and portalSector.zoneId then
        linkmap = CacheManager:getMapMeta(portalSector.zoneId)
    end

    if linkmap then
        self[lblKey]:setText(linkmap:getMapName())
    else
        self[imgKey]:setVisible(false)
        self[lblKey]:setVisible(false)
    end
end

return MapGuideLayer
