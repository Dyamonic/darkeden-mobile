---@class UICompMagicS 人族角色魔法技能界面
local UICompMagicS = class("UICompMagicS", lt.UICompBase)

-- local Constant = lt.Constant
-- local RaceSkinRes = lt.Constant.RaceSkinRes
local GameModule = lt.GameModule
local NtfManager = lt.NtfManager
local CacheManager = lt.CacheManager
local SkillModule = lt.SkillModule
local Constant = lt.Constant
local CommonFunc = lt.CommonFunc

function UICompMagicS:ctor()
    self:registerComponent("UICompMagicItem")
    self._btnIndex = nil
    self._race = nil
    self._domainIndex = nil
    self._skillData = nil
    self._levelTable = nil
    self._levelExpTable = nil
    UICompMagicS.super.ctor(self)
end

function UICompMagicS:onConstruct()
    self._magicSlist = self:getChild("list")
    self._magicSlist:setItemRenderer(handler(self, self.renderListItem))

    self._totalList = self:getChild("totalList")
    self._totalList:setItemRenderer(handler(self, self.renderListItemBar))
end

function UICompMagicS:onClear()
    self:unregisterAllComponent()
    self._btnIndex = nil
    self._race = nil
    self._domainIndex = nil
    self._skillData = nil
    self._levelTable = nil
    self._levelExpTable = nil

    self._magicSlist = nil
    self._totalList = nil
    UICompMagicS.super.onClear(self)
end

function UICompMagicS:onEnter()
    self._magicSlist:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
end

function UICompMagicS:onExit()

    self._magicSlist:removeEventListener(fgui.UIEventType.ClickItem)
end

function UICompMagicS:initUI()
    self._btnList = {}
    -- 技能列表

    self._btnIndex = 1

    -- 人族技能分类
    self._race = GameModule:getHeroRace()
    local curSkills = CacheManager:getSkillByRace(self._race)
    local tempSkillData = {}
    local tempDomainIndex = {}
    for k,v in pairs(curSkills) do
        local skillId = v:getSkillId() or 0
        local domain = math.floor(skillId/1000)
        -- print("-------------->>>>domain" .. domain)
        if not tempSkillData[domain] then
            tempSkillData[domain] = {}
            table.insert(tempDomainIndex, domain)
        end
        if v:getNeedLevel() <= Constant.TransferLevel and v:getSkillMenu() == 1 then
            table.insert(tempSkillData[domain], v)
        end
    end

    -- 分类排序
    table.sort(tempDomainIndex, function(a,b)
        return a < b
    end)
    self._domainIndex = tempDomainIndex

    -- 每个分类数据排序
    for k,v in pairs(tempSkillData) do
        -- 通用技能插入人族每一个分类
        local commonSkillList = CacheManager:getShowCommonSkill()
        for _,commonSkill in pairs(commonSkillList) do
            table.insert(v, commonSkill)
        end

        table.sort(v, function(a,b)
            if a:getNeedLevel() == b:getNeedLevel() then
                return a:getSkillId() < b:getSkillId()
            else
                return a:getNeedLevel() < b:getNeedLevel()
            end
        end)
    end

    self._skillData = tempSkillData

    -- 初始化技能系列
    for i=1,#tempDomainIndex+1 do
        local domain = tempDomainIndex[i]
        local btn = self:getChild("btn" .. i)
        if btn then
            btn.controlIndex = i
            local name = GReadText["KEY_DOMAIN_NAME" .. (domain or "")]
            if i == (#tempDomainIndex+1) then
                name = GReadText["KET_SKILL_TIPS12"]
            end
            btn:getChild("nameSelect"):setText(name)
            btn:getChild("name"):setText(name)
            if i <= #tempDomainIndex then
                local isRed = SkillModule:getRedPoint(2, i)
                btn:getChild("reddot"):setVisible(isRed)
                table.insert(self._btnList, btn)
            end 
            btn:addClickListener(handler(self, function()
                self._btnIndex = i
                self:refreshCurInfo()
                self._magicSlist:scrollToView(0)
            end))
        end
    end

    -- 进度条名初始化
    local expBar = self:getChild("expBar")
    local expBarName = expBar:getChild("name")
    expBarName:setText(GReadText["KET_SKILL_TIPS14"])
    expBar:addClickListener(handler(self, function()
        self:showExpTips()
    end))
    local lvlBar = self:getChild("lvlBar")
    local lvlBarName = lvlBar:getChild("name")
    lvlBarName:setText(GReadText["KET_SKILL_TIPS13"])
    lvlBar:addClickListener(handler(self, function()
        self:showLevelTips()
    end))

    -- 总计列表初始化


    self._controlType = self:getController("select")
end

function UICompMagicS:uptRedDotEvt()
    for i = 1, #self._btnList do
        local isRed = SkillModule:getRedPoint(2, i)
        self._btnList[i]:getChild("reddot"):setVisible(isRed)
    end
end

function UICompMagicS:refreshCurInfo(isSelect)
    if not self._btnIndex then
        return    
    end

    -- 各个领域等级
    local heroData = lt.GameModule:getHeroData()
    local levelTable = heroData:getSlayerLevelTable()
    self._levelTable = levelTable
    -- 各个领域经验
    local expTable = heroData:getSlayerExpTable()
    self._levelExpTable = expTable

    if isSelect then
        local max = -1
        local maxExp = -1
        for i = 1, #levelTable do
            if levelTable[i] > max or (levelTable[i] == max and expTable[i] > maxExp) then
                max = levelTable[i]
                maxExp = expTable[i]
                self._btnIndex = i
            end
        end
    end
    self._controlType:setSelectedIndex(self._btnIndex - 1)
    
    self:refreshBtnName(self._btnIndex)
    local skillTitle = self:getChild("skillTitle")
    local expBar = self:getChild("expBar")
    local lvlBar = self:getChild("lvlBar")

    local domain = self._domainIndex[self._btnIndex]
    if not domain then --  无数据就是总计界面
        self._magicSlist:setVisible(false)
        skillTitle:setVisible(false)
        expBar:setVisible(false)
        lvlBar:setVisible(false)
        self._totalList:setVisible(true)
        self._totalList:setNumItems(6)
        return
    end

    local skillData = self._skillData[domain] or {}
    if not skillData then
        return
    end

    self._magicSlist:setVisible(true)
    skillTitle:setVisible(true)
    expBar:setVisible(true)
    lvlBar:setVisible(true)
    local skillNum = #skillData
    if skillNum < 6 then
        skillNum = 6
    end
    self._magicSlist:setNumItems(skillNum)
    if isSelect then
        self._magicSlist:scrollToView(0)
    end
    self._totalList:setVisible(false)

    -- 各个领域信息显示
    local curDomainLvl = self._levelTable[domain] or 0
    local allMeta = CacheManager:getSLevelExpByDomain(domain) or {}
    lvlBar:getChild("value"):setText(table.concat({ curDomainLvl, "/", #allMeta }))
    lvlBar:getChild("bar"):setValue(curDomainLvl/#allMeta*100)

    local curExp = self._levelExpTable[domain] or 0
    local curMeta = CacheManager:getSLevelExpInfoMeta(domain, curDomainLvl)
    local curNeedExp = curMeta:getExp() or 1
    local percent = math.floor(curExp/curNeedExp*100)
    if percent > 100 then
        percent = 100
    end
    expBar:getChild("value"):setText(table.concat({ percent, "%/", "100%" }))
    expBar:getChild("bar"):setValue(percent)
end

function UICompMagicS:refreshBtnName(index)
    for j=1,6 do
        local btn = self:getChild("btn" .. j)
        local btnControl = btn:getController("name")
        if index == btn.controlIndex then
            btnControl:setSelectedIndex(0)
        else
            btnControl:setSelectedIndex(1)
        end
    end
end

function UICompMagicS:renderListItem(index, obj)
    local domain = self._domainIndex[self._btnIndex]
    if not domain then
        return
    end

    local skillData = self._skillData[domain]
    if not skillData then
        return
    end

    local resetIndex = index+1
    if not skillData[resetIndex] then
        return
    end

    local curBtnState = Constant.SkillState.NotLearnable
    local needLvl = skillData[resetIndex]:getNeedLevel()
    local skillId = skillData[resetIndex]:getSkillId()
    local playerlv = self._levelTable[domain] or 0--heroData:getLevel()
    -- print("------------------->>>>playerlv",playerlv)
    local hasSkill = SkillModule:hasSkill(skillId)
    -- local skillLevel = SkillModule:getSkillLevel(skillId)
    if playerlv >= needLvl then
        curBtnState = Constant.SkillState.Learnable
    end

    if hasSkill then
        curBtnState = Constant.SkillState.Learned
    end

    obj:initItem(skillData[resetIndex],curBtnState)

    obj:insertObjectToFactory(self)
end

function UICompMagicS:onClickItem(context)
    local data = context:getData()

    local skillCfg = data:getSkillCfg()
    if not skillCfg then
        return
    end

    local btnList = { Constant.SkillTipBtns.Detail }
    if data:getCurState() == Constant.SkillState.Learnable then
        table.insert(btnList, Constant.SkillTipBtns.Study)
    end

    local descTips = string.format(GReadText.KET_SKILL_TIPS2, skillCfg:getName())
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_SKILL_TIPS, 
    {
        skillInfo = skillCfg,
        btnList = btnList,
        btnState = data:getCurState(),
        studyCallback = function()
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {content = descTips, confirmCallback = function()
                SkillModule:sendLearnSkill(0,skillCfg:getSkillId())
            end})
        end
    })
end

function UICompMagicS:renderListItemBar(index, obj)
    -- print("renderListItemBar" .. index)

    local tempIndex = index + 1
    local domain = self._domainIndex[tempIndex]
    local name = GReadText["KEY_DOMAIN_NAME" .. (domain or "")]
    if not domain then
        name = GReadText["KET_SKILL_TIPS12"]
    end
    obj:getChild("name"):setText(name)

    if self._levelTable[domain] then
        obj:getChild("value"):setText(table.concat({ self._levelTable[domain], "/", Constant.MaxDomain }))
        obj:getChild("bar"):setValue(self._levelTable[domain]/Constant.MaxDomain*100)
    else
        local total = 0
        for _,v in pairs(self._levelTable) do
            total = total + v
        end
        obj:getChild("value"):setText(table.concat({ total, "/", Constant.MaxDomain }))
        obj:getChild("bar"):setValue(total/Constant.MaxDomain*100)
    end
end

function UICompMagicS:showExpTips()
    local expBar = self:getChild("expBar")
    local itemSize = expBar:getSize()
    local point = expBar:localToGlobal({x=itemSize.width,y=0})
    local domain = self._domainIndex[self._btnIndex]
    local curDomainLvl = self._levelTable[domain] or 0
    local curExp = self._levelExpTable[domain] or 0
    local curMeta = CacheManager:getSLevelExpInfoMeta(domain, curDomainLvl)
    local curNeedExp = curMeta:getExp() or 1
    local expStr = CommonFunc:changeNumberShow(curNeedExp - curExp)
    local percent = math.floor(curExp/curNeedExp*100)
    if percent > 100 then
        percent = 100
    end
    expStr = expStr .. "("..percent.."%)"
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_TEXT_TIPS,
    {
        content = GReadText.KEY_ROLE_INFO_TIPS32..expStr,
        pt = point,
        pivot = cc.p(0.5, 0.5)
    })
end

function UICompMagicS:showLevelTips()
    local lvlBar = self:getChild("lvlBar")
    local itemSize = lvlBar:getSize()
    local point = lvlBar:localToGlobal({x=itemSize.width,y=0})
    local domain = self._domainIndex[self._btnIndex]
    local curDomainLvl = self._levelTable[domain] or 0
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_TEXT_TIPS, 
    {
        content = GReadText["KEY_SALYER_MAGIC_TIPS"..domain]..curDomainLvl,
        pt = point,
        pivot = cc.p(0.5, 0.5)
    })
end

return UICompMagicS