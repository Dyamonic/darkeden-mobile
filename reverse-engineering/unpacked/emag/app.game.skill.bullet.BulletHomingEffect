-- 飞刀回防特效
local BulletHomingEffect = class("BulletHomingEffect", lt.BulletBase)

local Constant = lt.Constant
local GameBoard = lt.GameBoard
local CacheManager = lt.CacheManager
local EffectActor = lt.EffectActor
local TimeTrigger = lt.TimeTrigger
local SkillEnum = lt.SkillEnum
local MapUtil = lt.MapUtil

BulletHomingEffect._targetAgentId  = nil
BulletHomingEffect._effectActor = nil
local offsetX = -25
local offsetY = -Constant.MODEL_HERO_Y/2

function BulletHomingEffect:ctor(skillId, currentAngle, turnAngle)
    BulletHomingEffect.super.ctor(self, skillId)
    self._radCurrent = self:getAngle360( currentAngle );		
	self._radStep = self:getAngle360( turnAngle );
    self._effectNode = display.newNode()
    self._effectNode:setPosition(offsetX, offsetY)
    self:addChild(self._effectNode)
    self._nextFrameIndex = 1
    self._isEndEffect = false
    self:addEffectActor(skillId)
    self._timeTrigger = TimeTrigger.new(1 / Constant.FPS_TL)
    self._endFrameLink = 1
    self._nDir = nil

end

function BulletHomingEffect:onClear()
    if self._effectActor then
        self._effectActor:onClear()
        self._effectActor = nil
    end
    
    self:removeAllChildren()

    self._isEndEffect = nil
    self._effectNode = nil
end

function BulletHomingEffect:addEffectActor(skillId,skillLevel)
    local actionInfoMetas = CacheManager:getBulletMetas(skillId,skillLevel)
    if not actionInfoMetas or #actionInfoMetas < 1 then
        return
    end

    local meta = actionInfoMetas[1]
    -- 存在旋转 所以需要加上锚点
    local anchorPoint = self:getAnchorPointByDirection(self._direction)
    self._effectActor = EffectActor.new(meta, self._direction, cc.p(0.5,0.5), false)

    self._effectNode:addChild(self._effectActor)
    self._actionInfoMeta = meta

    self._isEndEffect = true
end

function BulletHomingEffect:onUpdate()
    if self._timeTrigger:tick() then
        self:onUpdateMove()
    end
    self:onUpdateEffect()
end

function BulletHomingEffect:onUpdateMove()
    if self._effectActor:getEffectActorClose() then
        self._waitingForClear = true
    end
    if self._skillId ~= SkillEnum.SKILL_HALO then
        if not self:traceCreature() then
            return false
        end
        self:calculateAngle()
    end

    -- 更新坐标
    self._radCurrent = self._radCurrent + self._radStep
    self._radCurrent = bit.band(self._radCurrent, Constant.MAX_ANGLE_1)

    local cosIntValue = (Constant.FCos(self._radCurrent) * self._stepPixel)
    local sign = cosIntValue < 0 and -1 or 1 --标记符号位
    -- local unsignedcosIntValue = math.abs(bit.band(cosIntValue, 0xFFFFFFFF))   --有符号整数 进行右移操作。对于有符号整数，右移操作会保留符号位（即最高位）
    local shiftCosValue =  bit.rshift(math.abs(cosIntValue), 16) * sign
    self._pixelX = self._pixelX + shiftCosValue


    local sinIntValue = (Constant.FSin(self._radCurrent) * self._stepPixel)
    local sinSign = sinIntValue < 0 and -1 or 1 --标记符号位
    -- local unsignedsinIntValue = math.abs(bit.band(sinIntValue, 0xFFFFFFFF))   --有符号整数 进行右移操作。对于有符号整数，右移操作会保留符号位（即最高位）
    local shiftSinValue = bit.rshift(math.abs(sinIntValue), 16) * sinSign
    self._pixelY = self._pixelY - shiftSinValue

    self._pixelZ = self._pixelZ + self._stepZ
    if math.abs(self._pixelZ - self._targetZ) < self._stepZ then
        self._pixelZ = self._targetZ
        self._stepZ = 0
        -- self._waitingForClear = true
    end

    -- 判断是否到达目标
    if math.abs(self._pixelX - self._targetX) < self._stepPixel 
        and math.abs(self._pixelY - self._targetY) < self._stepPixel 
        and  self._skillId ~= SkillEnum.SKILL_HALO 
        then
        self._pixelX = self._targetX
        self._pixelY = self._targetY
        self._pixelZ = self._targetZ
        self.m_StepX = 0
        self.m_StepY = 0
        self._stepZ = 0
        self._radStep = 0
        self.m_EndFrame = 0
        return false
    end
    local m,n = MapUtil:PixelToMap(self._pixelX, self._pixelY)
    -- yflog:Info("设置下次移动像素点:M：%s N：%s",m,n)
    if self._nextFrameIndex >= self._endFrameLink  then
        self._waitingForClear = true
    end
    self._effectActor:setNextEffectFrameIndex(self._nextFrameIndex%5 )
    self._nextFrameIndex = self._nextFrameIndex + 1
    self:setPosition(self._pixelX, self._pixelY + self._pixelZ)

    -- if self.m_BltType == BLT_EFFECT then
    --     self.m_Light = MTopView.m_EffectAlphaFPK[self.m_FrameID][self.m_Direction][self.m_CurrentFrame].GetLight()
    -- end

end

function BulletHomingEffect:onEnd(isLastGroupMember)
    if isLastGroupMember then
        if type(self._callback) == "function" then
            self._callback()
        end
    end
    self:onClear()
end

function BulletHomingEffect:onUpdateEffect()
    if not self._isEndEffect then
		return
	end

    if not self._effectActor then 
        return
    end

    -- self._effectActor:onUpdateEffect()
end

function BulletHomingEffect:setEndCallBack(callback)
    self._callback = callback
end


function BulletHomingEffect:setTarget(x, y, z, speed)
    -- 保存目标位置
    self._targetX = x
    self._targetY = y
    self._targetZ = z


	self._stepPixel = speed;

	self._stepZ = (self._targetZ - self._pixelZ) / 16

	self:calculateAngle();
end

function BulletHomingEffect:setPixelPosition(x, y, z)
    self._pixelX = x;
	self._pixelY = y;
	self._pixelZ = z;
    self:setPosition(self._pixelX, self._pixelY + self._pixelZ)
end

function BulletHomingEffect:setDirection(direction)
    self._direction = direction
end

function BulletHomingEffect:setTraceCreatureID(id)
	self._traceObjId = id; 

	if (id ~= nil ) then
		self:traceCreature();	
    end
end

function BulletHomingEffect:traceCreature()
    local worldAgent = lt.AgentManager:getWorldAgent()
    local traceAgent =  worldAgent:getAgent(self._traceObjId)

	if (traceAgent == nil) then
		self._traceObjId = nil;
		self._waitingForClear = true
		return false;
    end

	-- 현재의 좌표를 읽어온다.
	self._targetX, self._targetY = traceAgent:getPosition()
	return true;
end

-- 计算角度
function BulletHomingEffect:calculateAngle()
    -- local mPixel, nPixel = MapUtil:PixelToMap(self._pixelX, self._pixelY)
    -- local mTarget, nTarget = MapUtil:PixelToMap(self._targetX, self._targetY)
    -- local targetAngle = self:getAngleToTarget(mPixel, nPixel, mTarget, nTarget)
    local dir 
    if self._nDir then
        dir = self._nDir
    else
        local targetAngle = self:getAngleToTarget(self._pixelX, self._pixelY, self._targetX, self._targetY)
        dir = self:getAngleDir(self._radCurrent, targetAngle)
    end
  
    self._radStep = dir * math.abs(self._radStep)  -- 设置转向角度
end

function BulletHomingEffect:getAngleDir(nAngle, nTargetAngle)
    if nAngle == nTargetAngle then
        return 0
    end

    local nDir = (nAngle > nTargetAngle) and -1 or 1
    nDir = (math.abs(nAngle - nTargetAngle) >= Constant.ANGLE_180) and -nDir or nDir
   
    return nDir
end



-- 获取目标角度函数
function BulletHomingEffect:getAngleToTarget(nX, nY, nTargetX, nTargetY)
    local nAngle
    local cx = nTargetX - nX
    local cy = nTargetY - nY
    yflog:Info("getAngleToTarget cx:%s cy:%s",cx, cy)

    if cx == 0 then
        if cy > 0 then
            return Constant.ANGLE_270
        elseif cy < 0 then
            return Constant.ANGLE_90 
        end
    end

    if cy == 0 then
        if cx > 0 then
            return Constant.ANGLE_0
        elseif cx < 0 then
            return Constant.ANGLE_180
        end
    end

    if cx == 0 and cy == 0 then
        return Constant.ANGLE_0
    end
    local tab
    if cy < cx then
        if -cy < cx then

            tab = (Constant.MAX_ANGLE_HALF + (Constant.MAX_ANGLE_HALF * cy / cx))
            nAngle = Constant.ANGLE_0 + Constant.FArcTanTab[tab]
            yflog:Info("getAngleToTarget nAngle:%s: add:%s tab:%s",nAngle,Constant.FArcTanTab[tab + 1],tab)
        else
            tab = (Constant.MAX_ANGLE_HALF + (Constant.MAX_ANGLE_HALF * cx / cy))
            nAngle = Constant.ANGLE_270 - Constant.FArcTanTab[tab]
        end
    else
        if -cy < cx then
            tab =  (Constant.MAX_ANGLE_HALF + (Constant.MAX_ANGLE_HALF * cx / cy))
            nAngle = Constant.ANGLE_90 - Constant.FArcTanTab[tab]
        else
            tab = (Constant.MAX_ANGLE_HALF + (Constant.MAX_ANGLE_HALF * cy / cx))
            nAngle = Constant.ANGLE_180 + Constant.FArcTanTab[tab]
        end
    end

    -- 反转角度
    nAngle = Constant.MAX_ANGLE - nAngle

    -- 裁剪角度
    nAngle = self:clipAngle(nAngle)
    yflog:Info("getAngleToTarget nAngle ret:%s",nAngle)

    return nAngle
end

-- 角度裁剪函数
function BulletHomingEffect:clipAngle(nAngle)
    if nAngle < 0 then
        nAngle = nAngle + Constant.MAX_ANGLE
    elseif nAngle >= Constant.MAX_ANGLE then
        nAngle = nAngle - Constant.MAX_ANGLE
    end
    return nAngle
end

function BulletHomingEffect:getAngle360(angle)
    return Constant.FPI * angle / 180;
end

function BulletHomingEffect:setCount(endFrame)
    self._endFrameLink = endFrame
end

function BulletHomingEffect:setRotateDir(dir)
    self._nDir = dir
end
return BulletHomingEffect
