
local SkillEffectsDao = {}

--[[__fmt
    技能特效数据表
]]
function SkillEffectsDao:queryAll()
    local tb = {}
    local db = lt.DbManager:getDb()

    for row in db:nrows("SELECT * FROM SkillSpecialEffects") do
    	local meta = lt.SkillEffectsMeta.new(row)
        if not tb[meta:getSkillId()] then
            tb[meta:getSkillId()] = {}
        end

        table.insert(tb[meta:getSkillId()], meta)
    end

    return tb
end

return SkillEffectsDao
