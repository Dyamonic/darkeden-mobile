---@魔族传送界面
---@class UIWndOustersTransmitMap:UIWindowBase
local UIWndOustersTransmitMap = class("UIWndOustersTransmitMap", lt.UIWindowBase)

local NtfManager = lt.NtfManager
local Constant = lt.Constant
local CacheManager = lt.CacheManager
local GameModule = lt.GameModule
local MaxMapIdx = 8

function UIWndOustersTransmitMap:ctor(param)
    UIWndOustersTransmitMap.super.ctor(self, param)
    self._targetList = nil
    self._listMap = nil
    self._miniMap = nil
    self._nameLabel = nil
    self._transmitSubMap = nil
    -- 数据
    self._idx = 0
end

function UIWndOustersTransmitMap:onClear()
    self:unregisterAllComponent()
    self._listMap = nil
    self._miniMap = nil
    self._nameLabel = nil
    self._transmitSubMap = nil
    if self._targetList then
        self._targetList:removeChildrenToPool()
        self._targetList:removeItemRenderer()
        self._targetList = nil
    end
    UIWndOustersTransmitMap.super.onClear(self)
end

function UIWndOustersTransmitMap:onShown()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_TRANSFER_MAP_SELECT, handler(self, self.transferMapSelect), "UIWndOustersTransmitMap:transferMapSelect")

    for k, mapNode in ipairs(self._mapList) do
        local mapBtn = mapNode:getChild("btn_click")
        mapBtn:addClickListener(handler(self, self.onMapAreaClick))
    end

    local fitMapList = self:getFitMap()
    self._targetList:setNumItems(#fitMapList)
    self:refreshSelect(1)
end

function UIWndOustersTransmitMap:onHide()
    local fitMapList = self:getFitMap()
    self._targetList:setNumItems(#fitMapList)
    self:resetView()

    NtfManager:removeNtfListenerByTag("UIWndOustersTransmitMap:transferMapSelect")

    for k, mapNode in ipairs(self._mapList) do
        local mapBtn = mapNode:getChild("btn_click")
        mapBtn:removeClickListener()
    end

    UIWndOustersTransmitMap.super.onHide(self)
end

function UIWndOustersTransmitMap:onInit()
    self:registerComponent("UICompOustersTransmitMapItem","UICompOustersTransmitSubMap")
    UIWndOustersTransmitMap.super.onInit(self, _GURL.GetOustersTransmitMap)
    self:initUI()
end

function UIWndOustersTransmitMap:initUI()
    self._targetList = self:getChild("targetList")
    self._targetList:setItemRenderer(handler(self, self.renderTargetItem))
    self._listMap = self:getChild("list_map")
    self._miniMap = self._listMap:getChildAt(0)
    self._nameLabel = self:getChild("mapName")
    
    --八个地区
    self._mapList = {}
    for i = 1, MaxMapIdx do
        local mapNode = self._miniMap:getChild("n"..i)
        local meta = CacheManager:getMapTransferPointMeta(i)
        mapNode:getChild("name"):setText(string.split(meta[1]:getMapName(), "_")[1])
        local mapMeta = CacheManager:getMapMeta(meta[1]:getMapCode())
        local startLvl, endLvl = mapMeta:getLvlRecommend()
        mapNode:getChild("lvl"):setText(string.format("Lv%s-Lv%s",startLvl, endLvl))
        local mapBtn = mapNode:getChild("btn_click")
        mapBtn.index = i
        table.insert(self._mapList, mapNode)
    end
end

function UIWndOustersTransmitMap:refreshMiniMap()
    if self._idx ~= 0 then
        local meta = CacheManager:getMapTransferPointMeta(self._idx)
        self._nameLabel:setText(string.split(meta[1]:getMapName(), "_")[1])
    end
end

function UIWndOustersTransmitMap:renderTargetItem(index, obj)
    local fitMapList = self:getFitMap()
    local nameStr = string.split(fitMapList[index+1][1]:getMapName(), "_")[1]
    obj:getChild("title_dilao"):setText(nameStr)
    obj:getChild("title_nodilao"):setText(nameStr)
    local dungeonlist = self:getDungeonMetaList(fitMapList[index+1])
    obj:getChild("node_dillao"):setVisible(#dungeonlist > 0)
    obj:getChild("title_nodilao"):setVisible(#dungeonlist == 0)
    obj:getChild("icon"):setURL(string.format(_GURL.GetMiniMapFGUI, #dungeonlist > 0 and "bg_ditcs_01_o" or "bg_ditcs_04_o"))
    if #dungeonlist > 0 then
        table.insert(dungeonlist, 1, nameStr)
    end
    obj:setObjInfo(dungeonlist, fitMapList[index+1][1]:getMapGroup())
    obj.index = index + 1
    obj:insertObjectToFactory(self)
end

function UIWndOustersTransmitMap:onMapAreaClick(target)
    local index = target:getSender().index
    local meta = CacheManager:getMapTransferPointMeta(index)
    self:refreshSelect(meta[1]:getMapGroup(), 0, true)
end

--根据种族获得相应地图
function UIWndOustersTransmitMap:getFitMap()
    local race = GameModule:getHeroRace()
    local maplist = {}
    for i = 1, MaxMapIdx do
        local meta = CacheManager:getMapTransferPointMeta(i)
        local raceContain = meta[1]:getRace()
        if raceContain == "0" or string.find(raceContain, race) then
            table.insert(maplist, meta)
        end
    end
    return maplist
end

--根据地图index获得百分比位置
function UIWndOustersTransmitMap:getMapPerByIdx(mapIdx)
    local perX = {0, 0.675, 1, 0.335, 0.675, 1, 0.675, 0.675}
    local perY = {0, 0, 0, 0.335, 0.335, 0.335, 0.67, 1}
    return perX[mapIdx], perY[mapIdx]
end

--刷新选中状态
function UIWndOustersTransmitMap:refreshSelect(idx, isGround, mustIn)
    --人族不能进卡斯塔罗(id4,特殊写死)
    local race = GameModule:getHeroRace()
    if race == Constant.RaceType.Slayer and idx == 4 then
        return
    end
    local fitMapList = self:getFitMap()
    local childIndex = 0
    if self._idx ~= 0 then
        local obj = self._mapList[self._idx]
        obj:getChild("select"):setVisible(false)
        for i = 1, #fitMapList do
            if fitMapList[i][1]:getMapGroup() == self._idx then
                childIndex = self._targetList:itemIndexToChildIndex(i-1)
                break
            end
        end
    end
    local dungeonlist = self:getDungeonMetaList(fitMapList[childIndex+1])
    --如果选中一样的idx两次则进入二级界面
    if self._idx == idx then
        if #dungeonlist == 0 or mustIn then
            self:openSubView(isGround)
            return
        end
        --如果不是就收起页签
        self._idx = 0
        local context = self._targetList:getChildAt(childIndex)
        context:getChild("icon"):setURL(string.format(_GURL.GetMiniMapFGUI, #dungeonlist > 0 and "bg_ditcs_01_o" or "bg_ditcs_04_o"))
        context:setSize(212, 50)
        context:getChild("list"):setVisible(false)
        return
    end

    local context = self._targetList:getChildAt(childIndex)
    context:getChild("icon"):setURL(string.format(_GURL.GetMiniMapFGUI, #dungeonlist > 0 and "bg_ditcs_01_o" or "bg_ditcs_04_o"))
    context:setSize(212, 50)
    context:getChild("list"):setVisible(false)

    self._idx = idx
    local newObj = self._mapList[self._idx]
    newObj:getChild("select"):setVisible(true)
    childIndex = 0
    for i = 1, #fitMapList do
        if fitMapList[i][1]:getMapGroup() == self._idx then
            childIndex = self._targetList:itemIndexToChildIndex(i-1)
            break
        end
    end
    local newContext = self._targetList:getChildAt(childIndex)
    local newDungeonlist = self:getDungeonMetaList(fitMapList[childIndex+1])
    newContext:getChild("icon"):setURL(string.format(_GURL.GetMiniMapFGUI, #newDungeonlist > 0 and "bg_ditcs_02_o" or "bg_ditcs_05_o"))
    if #newDungeonlist > 0 then
        newContext:setSize(212, 50 + (#newDungeonlist+1) * 55)
    else
        newContext:setSize(212, 50)
    end
    newContext:getChild("list"):setVisible(true)
    self._targetList:scrollToView(childIndex)

    local scrollPane = self._listMap:getScrollPane()
    local perX, perY = self:getMapPerByIdx(idx)
    scrollPane:setPercX(perX, true)
    scrollPane:setPercY(perY, true)

    self:refreshMiniMap()
end

--二级界面
function UIWndOustersTransmitMap:openSubView(isGround)
    if not self._transmitSubMap then
        self._transmitSubMap = fgui.UIPackage:createObject("MiniMap", "OustersTransmitSubMap")
        self._transmitSubMap:insertObjectToFactory(self)
        self._transmitSubMap:setPosition(0,0)
        self._transmitSubMap:initUI()
        self:addChild(self._transmitSubMap)
    end
    local meta = CacheManager:getMapTransferPointMeta(self._idx)
    --判断地上地下
    local isGround = isGround or 0
    self._transmitSubMap:refreshView(meta, isGround)
    self._transmitSubMap:setVisible(true)
end

--重置界面
function UIWndOustersTransmitMap:resetView()
    self._nameLabel:setText("")
    local scrollPane = self._listMap:getScrollPane()
    scrollPane:setPercX(0)
    scrollPane:setPercY(0)
    if self._transmitSubMap then
        self._transmitSubMap:setVisible(false)
    end
end

--获得地牢metalist
function UIWndOustersTransmitMap:getDungeonMetaList(list)
    local dungeonMetaList = {}
    for i = 1, #list do
        if list[i]:getIsDungeon() == 1 then
            table.insert(dungeonMetaList, list[i])
        end
    end
    return dungeonMetaList
end

function UIWndOustersTransmitMap:transferMapSelect(event)
    local param = event.param or {}
    local index = param.index or 1
    local isGround = param.isGround or 0
    local mustIn = param.mustIn or false
    self:refreshSelect(index, isGround, mustIn)
end

return UIWndOustersTransmitMap