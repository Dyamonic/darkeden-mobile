local PetLevelDao = {}

function PetLevelDao:query(level)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM PetLevel WHERE Level=%d;", tonumber(level))) do
    	local meta = lt.PetLevelMeta.new(row)
        return meta
    end
end

function PetLevelDao:queryAll()
    local mapTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM PetLevel") do
        local petLevelMeta = lt.PetLevelMeta.new(row)
        mapTable[#mapTable+1] = petLevelMeta
    end
    return mapTable
end

return PetLevelDao