
-- 颜色替换Shader
---@class ShaderColorReplaceEffect
local ShaderColorReplaceEffect = class("ShaderColorReplaceEffect")

local ccEngine = cc

function ShaderColorReplaceEffect:ctor(node, program)
    ShaderColorReplaceEffect.super.ctor(self, node, program)
    self._needRefresh = false
end

--- ShaderColorReplaceEffect
---@param node cc.Node 需要修改的纹理节点
---@param originColor cc.vec3 基础颜色值 
---@param targetColor cc.vec3 目标颜色值 
---@param offset number 相似度阈值
function ShaderColorReplaceEffect:render(param)
    self.originColor1 = param.originColor1 
    self.targetColor1 = param.targetColor1 
    self.originColor2 = param.originColor2 
    self.targetColor2 = param.targetColor2 
    self.offset = param.offset or 0.2

    self:setNodeShader()
end

function ShaderColorReplaceEffect:setUniform(glState, time, node)
    -- local dest = glState:getUniformLocation("u_Texture")
    -- glState:setTexture(dest, ccEngine.ShaderStage.VERTEX_AND_FRAGMENT, node:getTexture():getBackendTexture())

    glState:setUniform("u_Threshold", ccEngine.bytearray.from_float(self.offset))
    if self.originColor1 then
        glState:setUniform("u_OriginalColor1", ccEngine.bytearray.from_vec3(self.originColor1))
        glState:setUniform("u_TargetColor1", ccEngine.bytearray.from_vec3(self.targetColor1))
    end
    if self.originColor2 then
        glState:setUniform("u_OriginalColor2", ccEngine.bytearray.from_vec3(self.originColor2))
        glState:setUniform("u_TargetColor2", ccEngine.bytearray.from_vec3(self.targetColor2))
    end

end

function ShaderColorReplaceEffect:resetUniform(glState, time)
end


function ShaderColorReplaceEffect.needRefresh()
    return false
end


function ShaderColorReplaceEffect:resetTime(time)
    return time + 0.5
end

return ShaderColorReplaceEffect

