
local UIGButtonBase = class("UIGButtonBase", function()
    return fgui.GButton:create()
end,lt.UICompChangeSkin)

UIGButtonBase._param         = nil

function UIGButtonBase:ctor(param)
    if param then
        self:setParam(param)
    end
    self:enableComponentEvents()
end

function UIGButtonBase:onConstruct()
end

function UIGButtonBase:setRegClass(node)
    self._regClass = node
end

function UIGButtonBase:getRegClass()
    return self._regClass
end

function UIGButtonBase:setParam(param)
    self._param = param
end

function UIGButtonBase:getParam()
    return self._param
end

function UIGButtonBase:onEnter()
    if DEBUG > 0 then 
        yflog:Info("UIGButtonBase:onEnter()")
    end
    self:startSkin()
end

function UIGButtonBase:onExit()
    if DEBUG > 0 then
        yflog:Info("UIGButtonBase:onExit()")
    end
end

function UIGButtonBase:onClear()
    self._param = nil
    if DEBUG > 0 then
        yflog:Info("UIGButtonBase:onClear()")
    end
end

function UIGButtonBase:removeCustomClickListener(node)
    if not node then
        return
    end

    if type(node) == "table" then
        for i = 1, #node do
            node[i]:removeClickListener()
        end
    else
        node:removeClickListener()
    end
end

function UIGButtonBase:getClassName()
    local className = self.class and self.class.__cname or self.__cname
    return className
end

-- 注册Component
function UIGButtonBase:registerComponent( ... )
    for _, component in ipairs( { ... } ) do
        lt.FGuiManager:registerComponent(self:getClassName(), component)
    end
end

function UIGButtonBase:unregisterComponent( ... )
    for _, component in ipairs( { ... } ) do
        lt.FGuiManager:unregisterComponent(self:getClassName(), component)
    end
end

function UIGButtonBase:unregisterAllComponent()
    lt.FGuiManager:unregisterAllComponent(self:getClassName())
end

-- 管理fgui创建的obj组件
function UIGButtonBase:insertObjectToFactory(node)
    if not node then
        yflog:Error("UIGButtonBase:insertToFactory error node is nil self name:%s", self.__cname)
        return
    end
    local className = node.class and node.class.__cname or node.__cname
    -- yflog:Info("UIGButtonBase:insertObjectToFactory className:%s",className)
    lt.FGuiManager:insertObjectToFactory(className, self:getClassName(), self)
end

return UIGButtonBase