
local RechargeDao = {}

function RechargeDao:queryById(rechargeId)
    local db = lt.DbManager:getDb()
    local rechargeArray = {}
    for row in db:nrows(string.format("SELECT * FROM Recharge WHERE Id=%d ;", rechargeId)) do
    	local rechargeMeta = lt.RechargeMeta.new(row)
        rechargeArray[#rechargeArray+1] = rechargeMeta
    end
    return rechargeArray
end

function RechargeDao:queryByShopType(shopType)
    local db = lt.DbManager:getDb()
    local rechargeArray = {}
    for row in db:nrows(string.format("SELECT * FROM Recharge WHERE ShopType=%d ;", shopType)) do
    	local rechargeMeta = lt.RechargeMeta.new(row)
        rechargeArray[#rechargeArray+1] = rechargeMeta
    end
    return rechargeArray
end


function RechargeDao:queryByRechargeId(rechargeId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Recharge WHERE Id=%d ;", rechargeId)) do
       local rechargeMeta = lt.RechargeMeta.new(row)
       return rechargeMeta
    end
end

function RechargeDao:queryAll()
    local mapTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Recharge") do
        local rechargeMeta = lt.RechargeMeta.new(row)
        mapTable[#mapTable+1] = rechargeMeta
    end
    return mapTable
end

function RechargeDao:queryAllSortID()
    local db = lt.DbManager:getDb()
    local rechargeList = {}
    for row in db:nrows("SELECT * FROM Recharge") do
    	local rechargeMeta = lt.RechargeMeta.new(row)
        rechargeList[rechargeMeta:getId()] = rechargeMeta
    end
    return rechargeList
end


return RechargeDao
