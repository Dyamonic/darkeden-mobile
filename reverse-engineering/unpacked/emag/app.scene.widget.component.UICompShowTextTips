---@class UICompShowTextTips 文本tips
---
local UICompShowTextTips = class("UICompShowTextTips", lt.UICompBase)

local GameModule = lt.GameModule
local TimeCounterManager = lt.TimeCounterManager
local CacheManager = lt.CacheManager
local Constant = lt.Constant

function UICompShowTextTips:ctor()
    UICompShowTextTips.super.ctor(self)
    self:makeFullScreen()
    self._touchLayer = nil
    self._remainTs = nil -- 剩余时间倒计时
    self._touchLayerEvt = nil
end

function UICompShowTextTips:onClear()
    self._touchLayer = nil
    self._remainTs = nil
    self._touchLayerEvt = nil
    UICompShowTextTips.super.onClear(self)
end

function UICompShowTextTips:onEnter()
    UICompShowTextTips.super.onEnter(self)
    self:addTouch()
end

function UICompShowTextTips:onExit()
    if self._touchLayerEvt then
    	cc.Director:getInstance():getEventDispatcher():removeEventListener(self._touchLayerEvt)
    	self._touchLayerEvt = nil
    end
    UICompShowTextTips.super.onExit(self)
end

function UICompShowTextTips:addTouch()
    if not self._touchLayer then
        local size = self:getSize()
        self._touchLayer = display.newLayer(cc.c4b(0, 0, 0, 255), size)
        self._touchLayer:setOpacity(0)
        self._touchLayer:setAnchorPoint(cc.p(0.5, 0.5))
        self:displayObject():addChild(self._touchLayer)
        self._touchLayer:setTouchMode(cc.EVENT_TOUCH_ONE_BY_ONE)
    end
    
    if not self._touchLayerEvt then
        -- print("_touchLayerEvt--------------->add")
        self._touchLayerEvt = cc.EventListenerTouchOneByOne:create()
        self._touchLayerEvt:setSwallowTouches(false)
        self._touchLayerEvt:registerScriptHandler(function(touch, event)
            return true
        end, cc.Handler.EVENT_TOUCH_BEGAN)
        self._touchLayerEvt:registerScriptHandler(function (touch, event)
            if self:isVisible() then
                lt.ScheduleUtil:performWithDelayGlobal(function()
                    self:onLayerClick()
                end, 0)
            end
        end, cc.Handler.EVENT_TOUCH_ENDED)
        cc.Director:getInstance():getEventDispatcher():addEventListenerWithSceneGraphPriority(self._touchLayerEvt, self._touchLayer)
    end
end



function UICompShowTextTips:onLayerClick()
    self:setVisible(false)
    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_BUFF_SELECT)
    self:clearTimeCounter()
end

function UICompShowTextTips:clearTimeCounter()
    TimeCounterManager:stopTimeCounter(TimeCounterManager.TC.BUFFER_TIPS_REMAINTS)
    -- yflog:Info("UICompShowTextTips ---  stopTimeCounter")
end

function UICompShowTextTips:refreshTips(param)
    -- 传入数据
    local content = param.content or "" -- 传入内容
    local pt = param.pt -- 位置
    local pivot = param.pivot -- 锚点
    local width = param.width -- 文字宽度

    -- UI
    local textTips = self:getChild("textTips")
    local text = textTips:getChild("content") -- 文本
    text:setAutoSize(width ~= nil and 2 or 1)
    if width then text:setWidth(width) end
    local buffNode = textTips:getChild("node_buff")
    local buffLoader = textTips:getChild("loader_buff")
    local titleLabel = textTips:getChild("label_title")
    local contentLabel = textTips:getChild("label_content")

    if pivot and pivot.x and pivot.y then
        textTips:setPivot(pivot.x, pivot.y, true)
    else
        textTips:setPivot(0.5, 1, true)
    end
    if pt then
        textTips:setPosition(math.floor(pt.x), math.floor(pt.y))
    end

    local function showInfo()
        text:setText("")
        text:setText(content)
        local textSize = text:getSize()
        textTips:setSize(textSize.width + 10, textSize.height + 10)
        buffNode:setVisible(false)
        text:setVisible(true)
        self:setVisible(true)
    end

    local function showBuffInfo()
        local buffCfg = CacheManager:getBuffById(param.buffId)
        titleLabel:setText(buffCfg:getName())
        buffLoader:setURL(string.format(_GURL.GetImageSkill, buffCfg:getSpriteId()))
        contentLabel:setText(content)
        local textSize = contentLabel:getSize()
        local titleSize = titleLabel:getSize()
        local width = math.max(titleSize.width + 51, textSize.width + 15)
        textTips:setSize(width, textSize.height + 82)
        buffNode:setVisible(true)
        text:setVisible(false)
        self:setVisible(true)
    end

    -- 点击关闭可穿透
    -- self:addTouch()

    -- buff 显示
    local bufferTable = GameModule:getBufferTable() or {}
    local bufferSource = GameModule:getBufferSource() or {}
    if param.buffId and type(bufferTable[param.buffId]) == "number" and CacheManager:getBuffById(param.buffId) then
        self._remainTs = math.floor(bufferTable[param.buffId] or 0)
        local buffCfg = CacheManager:getBuffById(param.buffId)
        local source = bufferSource[param.buffId]
        
        -- yflog:Info("source: %s,%s",source.srcType,source.srcId)
        local function refreshCurContent()
            local desc = nil
            if source and source.srcType == Constant.BuffSrcType.BuffSrcType_Item and source.srcId and CacheManager:getItemMeta(source.srcId) then
                local srcCfg = CacheManager:getItemMeta(source.srcId)
                desc = srcCfg:getDes()
            else
                desc = buffCfg:getDescription() or ""
            end
            local tableStr = {}

            if desc then
                table.insert(tableStr,"[color=#d16b36]")
                table.insert(tableStr,desc)
            end

            if self._remainTs > 0 then
                table.insert(tableStr,"\n[/color][color=#c6c3ff]")
                table.insert(tableStr,GReadText.KEY_BUFF_TIPS1)
                table.insert(tableStr,lt.TimeCounter:transformUnit(self._remainTs))
            end

            table.insert(tableStr,"[/color]")
            content = table.concat(tableStr)
        end

        -- 倒计时
        TimeCounterManager:startTimeCounter(TimeCounterManager.TC.BUFFER_TIPS_REMAINTS, {callback = function()
            if not self._remainTs then
                self:onLayerClick()
                return
            end

            self._remainTs = self._remainTs - 1
            if (self._remainTs and self._remainTs <= 1) then
                self:onLayerClick()
                self._remainTs = nil
                return
            end
            refreshCurContent()
            showBuffInfo()
        end })

        refreshCurContent()
        showBuffInfo()
    else
        showInfo()
    end
end

return UICompShowTextTips