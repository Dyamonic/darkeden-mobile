
local EquipMeta = class("EquipMeta")

local Constant = lt.Constant

function EquipMeta:ctor(row)
    self:initWithRow(row)
end

function EquipMeta:initWithRow(row)
    self._itemId        = row.ItemIdx
    self._name          = row.Name
    self._enName        = row.ENName
    self._rank          = row.Rank
    self._nextItemIdx   = row.NextItemIdx
    self._kind          = row.Kind
    self._race          = row.Race
    self._type          = row.Type
    self._iconId        = row.IconId
    self._apprLook      = row.ApprLook
    self._price         = row.Price
    self._quality       = row.Quality
    self._itemSize      = row.ItemSize
    self._durability    = row.Durability
    self._defense       = row.Protection
    self._minDamage     = row.MinDamage
    self._maxDamage     = row.MaxDamage
    self._hit           = row.Hit
    self._range         = row.Range
    self._dodge         = row.Defence
    self._speed         = row.Speed
    self._criticalHit   = row.CriticalHit
    self._silverMax     = row.SilverMax
    self._requireSTR    = row.RequireSTR
    self._requireDEX    = row.RequireDEX
    self._requireINT    = row.RequireINT
    self._requireSum    = row.RequireSum
    self._needLv        = row.NeedLv
    self._needSex       = row.NeedSex
    self._elementType   = row.ElementType
    self._elementLevel  = row.ElementLevel
    self._defaultOption = row.DefaultOption
    self._des           = row.Description
    self._mpBonus       = row.MPBonus
    self._str           = row.STR
    self._dex           = row.DEX
    self._int           = row.INT
    self._pdam          = row.PDAM
    self._ppro          = row.PPRO
    self._mdam          = row.MDAM
    self._mpmo          = row.MPRO
    self._attr          = row.ATTR
    self._dbtm          = row.DBTM
    self._dbtp          = row.DBTP
    self._effectParam   = row.EffectParam
    self._Sell          = row.Sell
    self._modelLv       = row.ModelLv
    self._color         = row.Color
    self._attributeDisplay = row.AttributeDisplay
    self._monthCardBind = row.AttributeDisplay
    self._luck          = row.Luck
    if self._effectParam ~= "" then
        self._effectParamJson = json.decode(self._effectParam)
    end
end

-- EffectParam在不同的类型中代表不同的值
function EquipMeta:getPocketCount()
    -- EffectParam 代表口袋数量
    -- 鬼族 装备类型衣服2
    -- 人族 装备类型腰带6
    -- 魔族 装备类型腰带6

    local kind = self:getKind()
    -- 鬼族非衣服
    if self._race == Constant.RaceType.Vampire and kind ~= Constant.EquipKind.Clothes then
        return 0
    end

    -- 人族非戒指
    if self._race == Constant.RaceType.Slayer and kind ~= Constant.EquipKind.Belt then
        return 0
    end

    -- 魔族非戒指
    if self._race == Constant.RaceType.Ousters and kind ~= Constant.EquipKind.Belt then
        return 0
    end
    
    if self._effectParam and self._effectParam ~= "" then
        if self:getEffectParam()[1][1] == "Belt" then
            return self:getEffectParam()[1][2] or 0
        end
    end

    return 0
end

function EquipMeta:getItemType()
    return 2
end

function EquipMeta:getAddLimit()
   return 0
end

function EquipMeta:getItemMeta()
    return nil
end

function EquipMeta:getNeedLevel()
    local needLvl = self._needLv
    local advState = lt.Constant.AdvState.NotAdv
    if needLvl > lt.Constant.TransferLevel then
        advState = lt.Constant.AdvState.Adv
        needLvl = needLvl - lt.Constant.TransferLevel
    end

    return advState, needLvl
end

function EquipMeta:getElements()
    local elementTable = {}
    if type(self._elementType) == "number" and self._elementType > 0 then
        elementTable[self._elementType] = self._elementLevel or 0
    end

    return elementTable
end

function EquipMeta:getEffectParam()
    return self._effectParamJson
end

function EquipMeta:isChangeColor()
    return self._color == 1
end

function EquipMeta:getQuality()
    return self._quality or 0
end

function EquipMeta:getEffectParamJson()
    return {}
end


