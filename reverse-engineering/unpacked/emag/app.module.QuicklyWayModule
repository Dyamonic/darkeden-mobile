
local QuicklyWayModule = {}

local SocketApi = lt.SocketApi
local Constant = lt.Constant
local ServerCmdDef = lt.ServerCmdDef
local NtfManager = lt.NtfManager
local Constant   = lt.Constant


function QuicklyWayModule:init()
end

function QuicklyWayModule:clear()
end

function QuicklyWayModule:gotoQuicklyWay(key, param)

    if key == "key_YbPurchase" then       -- 元宝购买
        param.gold = 1
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIDlgQuicklyBuy", quicklyWay = true, info = param, reopen = true})
    elseif key == "key_ByPurchase" then   -- 绑元购买
        param.gold = 2
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIDlgQuicklyBuy", quicklyWay = true, info = param, reopen = true})
    elseif key == "key_Illustration" then -- 图鉴查看
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIDlgHandbook", close = true})
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIDlgHandbook", key = "skill", quicklyWay = true, reopen = true, info = param})
    elseif key == "key_ItemList" then -- 普通物品图鉴
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIDlgHandbook", close = true})
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIDlgHandbook", key = "item", quicklyWay = true, reopen = true, info = param})
    elseif key == "key_EquipmentList" then -- 装备图鉴
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIDlgHandbook", close = true})
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIDlgHandbook", key = "equip", quicklyWay = true, reopen = true, info = param})
    elseif key == "key_Payment" then
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIDlgShop", go2="2"})
    end
end

