local ProtalType = {
    TYPE_NOMAL = 0,
    TYPE_SLAYER_ONLY = 1,
    TYPE_VAMPIRE_ONLY = 2,
    TYPE_MULTI_PORTAL = 3,
    TYPE_BATTLE_PORTAL = 6,
    TYPE_OUSTERS_ONLY = 7,
}
