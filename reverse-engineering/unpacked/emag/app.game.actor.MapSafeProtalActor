function MapSafeProtalActor:ctor(mapMeta)
    local rectSafeProtalPath = string.format("map/mip/%s", mapMeta:getRectJson())
    yflog:Info("----------------- rectSafeProtalPath:%s", rectSafeProtalPath)

    local content = ResUtil:loadMapSafeProtalData(rectSafeProtalPath)

    self._mapSaftProtalData = json.decode(content)

    self:init()
end

function MapSafeProtalActor:onClear()
    self._mapSaftProtalData = nil
end

function MapSafeProtalActor:init()
    local jsonContent = self._mapSaftProtalData

    self._width = jsonContent["Width"]
    self._height = jsonContent["Height"]
    self._portals = jsonContent["MPortals"]
    self._safeRects = jsonContent["SafeRects"]
end

function MapSafeProtalActor:getSafeRectArr()
    return self._safeRects
end

