end

-- 初始化地图跳转点入口
function MapSafeProtalActor:initPortalSector(race)
    if not self._portals then
        return
    end

    yflog:Info("MapSafeProtalActor:initPortalSector race = %s",race)
    local moveTypeMap = self:getProtalMoveType(race)

    self._protalSector = {}
    for i, portal in ipairs(self._portals) do
        for n = portal.Top, portal.Bottom, 1 do
            for m = portal.Left, portal.Right, 1 do
                if moveTypeMap[portal.M_Type] then
                    if not self._protalSector[m] then
                        self._protalSector[m] = {}
                    end
                    if #portal.M_ZoneID > 1 then
                        self._protalSector[m][n] = {type=portal.M_Type, zoneIds=portal.M_ZoneID, len=#portal.M_ZoneID}
                    elseif #portal.M_ZoneID == 1 then
                        self._protalSector[m][n] = {type=portal.M_Type, zoneId=portal.M_ZoneID[1], len=#portal.M_ZoneID}
                    end

                    -- 将传送点设置到寻路中去,寻路绕过传送点(上传至c++)
                    if cpp.MapManager:getInstance().setMNTrans then
                        cpp.MapManager:getInstance():setMNTrans(m, n, true)
                    end
                end
            end
        end
    end
end

-- 根据当前的位置判断是否发送跳转
function MapSafeProtalActor:getPortalSector(m, n)
    if not self._protalSector or not self._protalSector[m] or not self._protalSector[m][n] then
        return nil
    end

    return self._protalSector[m][n]
end

function MapSafeProtalActor:getProtalSectorTable()
    return self._protalSector
end

--[[
    根据入口类型判断是否可以前往
    TYPE_NOMAL          0
    TYPE_SLAYER_ONLY    1
    TYPE_VAMPIRE_ONLY   2
    TYPE_MULTI_PORTAL   3
    TYPE_BATTLE_PORTAL  6
    TYPE_OUSTERS_ONLY   7

    _protal -> type
    TYPE_NOMAL              0
    TYPE_BATTLE_PORTAL      6
        canMove = true

    TYPE_SLAYER_ONLY        1
        canMove = IsSlayer

    TYPE_VAMPIRE_ONLY   2
        canMove = IsVampire

    TYPE_OUSTERS_ONLY
        canMove = IsOusters
    
    TYPE_MULTI_PORTAL   3
        canMove = IsSlayer
]]
-- 获取种族对应的可跳转入口type
function MapSafeProtalActor:getProtalMoveType(race)
    local moveTypeMap = {}
    moveTypeMap[ProtalType.TYPE_NOMAL] = true
    moveTypeMap[ProtalType.TYPE_BATTLE_PORTAL] = true

    if race == Constant.RaceType.Slayer then
        moveTypeMap[ProtalType.TYPE_SLAYER_ONLY] = true
        moveTypeMap[ProtalType.TYPE_MULTI_PORTAL] = true
    elseif race == Constant.RaceType.Vampire  then
        moveTypeMap[ProtalType.TYPE_VAMPIRE_ONLY] = true
    elseif race == Constant.RaceType.Ousters  then
        moveTypeMap[ProtalType.TYPE_OUSTERS_ONLY] = true
    end

    return moveTypeMap
end


-- 获取种族对应的安全区入口type
function MapSafeProtalActor:getSafeRectType(race)
    local safeTypeMap = {}
    safeTypeMap[FLAG_MIP_SAFE.COMMON] = true
    if race == Constant.RaceType.Slayer then
        safeTypeMap[FLAG_MIP_SAFE.SLAYER] = true
        safeTypeMap[FLAG_MIP_SAFE.VAMPIRE] = false
        safeTypeMap[FLAG_MIP_SAFE.OUSTERS] = false
    elseif race == Constant.RaceType.Vampire then
        safeTypeMap[FLAG_MIP_SAFE.SLAYER] = false
        safeTypeMap[FLAG_MIP_SAFE.VAMPIRE] = true
        safeTypeMap[FLAG_MIP_SAFE.OUSTERS] = false
    elseif race == Constant.RaceType.Ousters then
        safeTypeMap[FLAG_MIP_SAFE.SLAYER] = false
        safeTypeMap[FLAG_MIP_SAFE.VAMPIRE] = false
        safeTypeMap[FLAG_MIP_SAFE.OUSTERS] = true
    end

    return safeTypeMap
end

--[[
    安全区信息初始化
    @param 本角色种族
]]
function MapSafeProtalActor:initSafeRect(race)
    self._safeRect = {}
    self._mMax = 0
    self._mMin = 999
    self._nMax = 0
    self._nMin = 999
    
    if not self._safeRects then
        return
    end

    yflog:Info("MapSafeProtalActor:initSafeRect race = %s",race)
    local safeTypeMap = self:getSafeRectType(race)
    
    for i, saferect in ipairs(self._safeRects) do
        for n = saferect.Top, saferect.Bottom, 1 do
            for m = saferect.Left, saferect.Right, 1 do
                if not self._safeRect[m] then
                    self._safeRect[m] = {}
                end
                self._safeRect[m][n] = safeTypeMap[saferect.Flag]
                if m > self._mMax then self._mMax = m end
                if m < self._mMin then self._mMin = m end
                if n > self._nMax then self._nMax = n end
                if n < self._nMin then self._nMin = n end
            end
        end
    end
end

-- 获得安全区数据
function MapSafeProtalActor:getSafeRect(m, n)
    if not self._safeRect or not self._safeRect[m] or self._safeRect[m][n] == nil then
        return nil
    end
    return self._safeRect[m][n]
end

-- 获得安全区上下左右边界(m,n)
function MapSafeProtalActor:getSafeRectBorder()
    return self._mMax, self._mMin, self._nMax, self._nMin
end

return MapSafeProtalActor