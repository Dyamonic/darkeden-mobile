
local InitLayerAccount = class("InitLayerAccount", lt.BaseLayer)

local Constant = lt.Constant

InitLayerAccount._initScene = nil

InitLayerAccount._editAccount = nil

function InitLayerAccount:ctor(initScene)
    InitLayerAccount.super.ctor(self)

    self._initScene = initScene

    self:initUI()
    self:setInfo()
end

function InitLayerAccount:onClear()
    lt.LogUtil:debug("InitLayerAccount:onClear")

    self._initScene   = nil
    self._editAccount = nil
end

function InitLayerAccount:onEnter()
    lt.LogUtil:debug("InitLayerAccount:onEnter")
end

function InitLayerAccount:onExit()
    lt.LogUtil:debug("InitLayerAccount:onExit")
end

