function InitLayerAccount:setInfo()
    local account = lt.PrefManager:getValueByKey(lt.PrefManager.LOGIN_NAME)
    local code = lt.PrefManager:getValueByKey(lt.PrefManager.LOGIN_NAME..account)
    if account and account ~= "" then
        self._editAccount:setText(account)
    end
    if code and code ~= "" then
        self._editCode:setText(code)
    end
end

function InitLayerAccount:show()
    self:setVisible(true)
end

function InitLayerAccount:hide()
    self:setVisible(false)
end

function InitLayerAccount:onClickStartGame()
    local account = self._editAccount:getText()
    if #account == 0 then
        lt.LogUtil:debug("请输入账号...")
        return
    end

    local code = lt.PrefManager:getValueByKey(lt.PrefManager.LOGIN_NAME..account)
    local editcode = self._editCode:getText()
    if device.platform ~= "windows" then
        if not editcode and editcode == "" then
            lt.LogUtil:debug("请输入密码...")
            return
        end
        if code and code ~= "" then
            if editcode ~= code then
                lt.LogUtil:debug("密码错误...")
                return
            end
        end
    end

    if editcode and editcode ~= "" then
        lt.PrefManager:setValueByKey(lt.PrefManager.LOGIN_NAME..account, account)
    end
    lt.PrefManager:setValueByKey(lt.PrefManager.LOGIN_NAME, account)
    self._initScene:setAccount(account)
    self._initScene:showInitLayerServer()
end

return InitLayerAccount
