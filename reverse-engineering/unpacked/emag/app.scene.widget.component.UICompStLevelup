---@装备升级
---@class UICompStLevelup
local UICompStLevelup = class("UICompStLevelup", lt.UIGButtonBase, lt.UICompChangeSkin)

UICompStLevelup.ChangeSkinConf = {
    ["Strengthen"] = {
        ["img_plane"] = "bg_zhuangbei_kuang",
        ["img_di2"] = "bg_zhuangbei_di1",
        ["panel_item"] = "bg_zhuangbei_di",
        ["img_di"] = "bg_zhuangbei_beijing",
        ["img_bg"] = "bg_zhuangbei_kuang1",
    },
    ["CommonTL"] = {
        ["btn_levelup"] = {bg = "bg_zbsj_wxz", bglight = "bg_zbsj_xz"},
    }
}

local StringManager = lt.StringManager
local CacheManager = lt.CacheManager
local NtfManager = lt.NtfManager
local ItemModule = lt.ItemModule
local StrengthenModule = lt.StrengthenModule
local Constant = lt.Constant
local SkeletonManager = lt.SkeletonManager
local AudioManager = lt.AudioManager
local CommonFunc = lt.CommonFunc
local GuideModule = lt.GuideModule

function UICompStLevelup:ctor()
    UICompStLevelup.super.ctor(self)
    --UI
    self._itemNode = nil
    self._equipIcon = nil
    self._nameLabel = nil
    self._curlvLabel = nil
    self._newlvLabel = nil
    self._arrowImg = nil
    self._attrlist = nil
    self._resultPanel = nil
    self._rateLabel = nil
    self._levelupBtn = nil
    self._emptyLabel = nil
    self._itemnameLabel = nil
    self._btnPanel = nil
    self._itemPanel = nil
    self._levelMaxImg = nil
    self._stageMaxImg = nil
    self._effectnNode = nil
    self._item = nil
    self._spine = nil
    self._icon = nil
    self._costLabel = nil
    --数据
    self._itemInfo = nil
    self._prop = nil
    self._nextProp = nil
    self._cost = nil
    self._costNum = nil
    self._animFlag = false
    self._targetAction = nil
    self._itemObjId = nil
end

function UICompStLevelup:onClear()
    --UI
    self._itemNode = nil
    self._equipIcon = nil
    self._nameLabel = nil
    self._curlvLabel = nil
    self._newlvLabel = nil
    self._arrowImg = nil
    self._resultPanel = nil
    self._rateLabel = nil
    self._levelupBtn = nil
    self._emptyLabel = nil
    self._itemnameLabel = nil
    self._btnPanel = nil
    self._itemPanel = nil
    self._levelMaxImg = nil
    self._stageMaxImg = nil
    self._effectnNode = nil
    self._item = nil
    self._spine = nil
    self._icon = nil
    self._costLabel = nil
    --数据
    self._itemInfo = nil
    self._prop = nil
    self._nextProp = nil
    self._cost = nil
    self._costNum = nil
    self._animFlag = nil
    self._targetAction = nil
    self._itemObjId = nil

    if self._attrlist then
        self._attrlist:removeChildrenToPool()
        self._attrlist:removeItemRenderer()
        self._attrlist = nil
    end
end

function UICompStLevelup:onConstruct()
    self:startSkin()
    self:initUI()
end

function UICompStLevelup:initUI()
    self._itemNode = self:getChild("node_item")
    self._equipIcon = self:getChild("panel_icon")
    self._nameLabel = self:getChild("label_name")
    self._curlvLabel = self:getChild("label_curlv")
    self._newlvLabel = self:getChild("label_newlv")
    self._arrowImg = self:getChild("img_arrow")
    self._attrlist = self:getChild("list_attr")
    self._attrlist:setItemRenderer(handler(self, self.renderListItem))
    self._resultPanel = self:getChild("panel_result")
    self._rateLabel = self:getChild("label_rate")
    self._levelupBtn = self:getChild("btn_levelup")
    self._emptyLabel = self:getChild("label_empty")
    self._itemnameLabel = self:getChild("label_itemname")
    self._btnPanel = self:getChild("panel_btn")
    self._itemPanel = self:getChild("panel_item")
    self._levelMaxImg = self:getChild("img_levelmax")
    self._stageMaxImg = self:getChild("img_stagemax")
    self._effectnNode = self:getChild("node_effect")
    
    --创建item
    self._item = fgui.UIPackage:createObject("Item", "Item")
    self._item:setPivot(0.5,0.5, true)
    self._item:setPosition(220, 395)
    self:addChild(self._item)
    self._costLabel = self:getChild("label_cost")

    --创建特效spine
    self._spine = SkeletonManager:createSkeletonEffectWithFile("ShengJiXiTong", "ShengJiXiTong_Skeleton")
    self._effectnNode:displayObject():addChild(self._spine)
    self._spine:setCallback(handler(self, self.spineAnimationEnd))
end

function UICompStLevelup:onEnter()
    self._item:insertObjectToFactory(self:getRegClass())

    self._levelupBtn:addClickListener(handler(self, self.onLevelupBtnClick))
    self._btnPanel:addClickListener(handler(self, self.onCancelBtnClick))
    self._item:addClickListener(function()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = CacheManager:getItemMeta(self._cost), tipsType = Constant.PROPTIPS_FORM.Display})
    end)

    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB,
        handler(self, self.refreshItemNum), "UICompStLevelup:refreshItemNum")
end

function UICompStLevelup:onExit()
    NtfManager:removeNtfListenerByTag(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB, "UICompStLevelup:refreshItemNum")
    self._levelupBtn:removeClickListener()
    self._btnPanel:removeClickListener()
    self._item:removeClickListener()
end

function UICompStLevelup:refreshView(itemInfo)
    self._itemInfo = itemInfo
    self._itemContentTable = {}
    if itemInfo then
        if self._icon == nil then
            self._icon = fgui.UIPackage:createObject("Item", "Item")
            self._icon:insertObjectToFactory(self:getRegClass())
            self._icon:setPivot(0.5,0.5, true)
            self._equipIcon:addChild(self._icon)
        end
        self._icon:setItemInfo(itemInfo)
        self._icon:setVisible(true)
        --获取基础属性
        local lv = itemInfo:getILevel()
        local rate = StrengthenModule:getLevelUpRate(itemInfo, lv)
        self._nameLabel:setText(itemInfo:getName().."  "..StringManager:getRomeNumber(lv))
        local isAdvanced = StrengthenModule:isAdvanced(itemInfo, lv)
        local nextEquip = itemInfo:getItemMeta():getNextItemIdx()
        local lvMax = StrengthenModule:isLevelMax(itemInfo, lv)
        --概率颜色
        local rateColor = "[color=#00ff00]"
        if rate < 50 then
            rateColor = "[color=#ff0000]"
        elseif rate < 70 then
            rateColor = "[color=#ffff00]"
        end

        --判断是否进阶
        if isAdvanced then
            self._curlvLabel:setText(GReadText.KEY_STRENGTHEN_TIPS2)
            self._newlvLabel:setVisible(false)
            self._arrowImg:setVisible(false)
            self._curlvLabel:setVisible(true)
            self._rateLabel:setText(GReadText.KEY_STRENGTHEN_TIPS3..rateColor..rate.."%[/color]")
        else
            self._curlvLabel:setText(string.format(GReadText.KEY_STRENGTHEN_TIPS71, StringManager:getRomeNumber(lv)))
            self._newlvLabel:setText(string.format(GReadText.KEY_STRENGTHEN_TIPS71, StringManager:getRomeNumber(lv+1)))
            self._curlvLabel:setVisible(nextEquip ~= 0 or not lvMax)
            self._newlvLabel:setVisible(nextEquip ~= 0 or not lvMax)
            self._arrowImg:setVisible(nextEquip ~= 0 or not lvMax)
            self._rateLabel:setText(GReadText.KEY_STRENGTHEN_TIPS4..rateColor..rate.."%[/color]")
        end
        self._itemNode:setPosition(29, 70)
        self._rateLabel:setVisible(lvMax and nextEquip ~= 0 or not lvMax)
        self._resultPanel:setVisible(lvMax and nextEquip ~= 0 or not lvMax)
        self._resultPanel:setURL(_GURL.GetImageMoren)

        --获取材料消耗
        self._cost, self._costNum, self._costLord = StrengthenModule:getItemCost(itemInfo, lv)
        if self._cost > 0 then
            self._item:setInfo(string.format(_GURL.GetImageItem,self._cost))
            self._item:setItemNums("")
            self._item:setNeedNum(ItemModule:getItemNum(self._cost), self._costNum)
            local itemMeta = CacheManager:getItemMeta(self._cost)
            self._itemnameLabel:setText(itemMeta:getName())
            self._itemnameLabel:setVisible(true)
            self._itemPanel:setVisible(true)
            self._item:setVisible(true)
            self._levelupBtn:setVisible(true)
            self._levelMaxImg:setVisible(false)
            self._stageMaxImg:setVisible(false)
            self._item:setIconScale(1.5, 1.5)
            local canLevelup = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, self._costLord, {tips = false})
            local color = canLevelup and "[color=#00ff00]" or "[color=#ff0000]"
            local lordStr = color..CommonFunc:changeNumberShow(self._costLord).."[/color]"
            self._costLabel:setText(string.format(GReadText.KEY_NPC_CLS_SKILL_TIPS3, _GURL.GetImageCoin..lordStr))
            self._costLabel:setVisible(true)
            self._levelupBtn:setGrayed(not canLevelup or ItemModule:getItemNum(self._cost) < self._costNum)

            local _itemkey = string.format("%d_%d",1,self._cost)
            self._itemContentTable[_itemkey] = true
        else
            self._itemPanel:setVisible(false)
            self._item:setVisible(false)
            self._levelMaxImg:setVisible(false)
            self._stageMaxImg:setVisible(true)
            self._levelupBtn:setVisible(false)
            self._itemnameLabel:setVisible(false)
            self._costLabel:setVisible(false)
        end
        self._prop = StrengthenModule:getActiveProp(itemInfo, lv)
        self._nextProp = StrengthenModule:getNextProp(itemInfo, lv)
        self._attrlist:setNumItems(#self._prop)
    else
        --没有默认显示界面逻辑
        if self._icon then
            self._icon:setVisible(false)
        end
        self._attrlist:setNumItems(0)
        self._cost = 701011
        self._costNum = 1
        self._item:setInfo(string.format(_GURL.GetImageItem,self._cost))
        self._item:setItemNums("")
        self._item:setNeedNum(ItemModule:getItemNum(self._cost), self._costNum)
        self._itemPanel:setVisible(false)
        self._item:setVisible(false)
        local itemMeta = CacheManager:getItemMeta(self._cost)
        self._itemnameLabel:setText(itemMeta:getName())
        self._itemnameLabel:setVisible(false)
        self._levelupBtn:setGrayed(true)
        self._item:setIconScale(1.5, 1.5)
        self._costLabel:setVisible(false)

        --设置组件属性
        self._itemNode:setPosition(154 ,70)
        self._rateLabel:setVisible(false)
        self._resultPanel:setVisible(false)
        self._curlvLabel:setVisible(false)
        self._newlvLabel:setVisible(false)
        self._arrowImg:setVisible(false)
        self._levelupBtn:setVisible(true)
        self._levelMaxImg:setVisible(false)
        self._stageMaxImg:setVisible(false)

        local _itemkey = string.format("%d_%d",1,self._cost)
        self._itemContentTable[_itemkey] = true
    end
    --通用界面显示逻辑
    self._nameLabel:setVisible(itemInfo ~= nil)
    self._attrlist:setVisible(itemInfo ~= nil)
    -- self._levelupBtn:setTouchable(itemInfo ~= nil)
    self._emptyLabel:setVisible(itemInfo == nil)
    self._btnPanel:setVisible(itemInfo ~= nil)
    self._animFlag = false
end

function UICompStLevelup:onLevelupBtnClick()
    --防止连续点击
    if self._animFlag then return end
    if self._itemInfo == nil then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_STRENGTHEN_TIPS87})
        return
    end
    if self._itemInfo then
        local isExit = StrengthenModule:checkStrengthenEquip(self._itemInfo)
        if not isExit then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_AUTO_TIPS10})
            return
        end
        local canLevelup = ItemModule:enoughItem(1, self._cost, self._costNum, {tips = true})
        if canLevelup then
            --检测货币
            canLevelup = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, self._costLord, {tips = true})
        end
        --服务器交互
        if canLevelup then
            local lv = self._itemInfo:getILevel()
            self._types = StrengthenModule:isAdvanced(self._itemInfo, lv) and 1 or 0
            local isOver = false
            if self._types == 1 then
                local newItemInfo = clone(self._itemInfo)
                newItemInfo:setItemId(self._itemInfo:getItemMeta():getNextItemIdx())
                newItemInfo:initMetaInfo()
                newItemInfo:setValue(lt.ServerClientEnum.ItemValueDef.Attr_ILevel, 1)
                isOver = StrengthenModule:checkOverRequire(newItemInfo)
            end
            if isOver then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {content = GReadText.KEY_STRENGTHEN_TIPS72, confirmCallback = function()
                    self._animFlag = true
                    StrengthenModule:sendEquipLevelup(self._types, self._itemInfo:getObjId(), self._itemInfo:getItemUid())
                end})
            else
                self._animFlag = true
                StrengthenModule:sendEquipLevelup(self._types, self._itemInfo:getObjId(), self._itemInfo:getItemUid())
            end
        end
    end
end

function UICompStLevelup:onLevelupFinish(params)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_OPEN_STRENGTHEN_MASK, true)
    --播放特效
    for idx = 1, #self._prop do
        local childIndex = self._attrlist:itemIndexToChildIndex(idx-1)
        local context = self._attrlist:getChildAt(childIndex)
        context:showLoading()
    end
    self._spine:setAnimationScale(2)
    self._spine:setAnimation(0, "ShengJiPanDuan2", false)
    self._effectnNode:setVisible(true)

    --判断是否成功
    if params.bSuccess then
        self._success = params.bSuccess
    else
        self._success = params.successRet == 0 and true or false
    end
    self._itemObjId = params.itemObjId
end

--动画回调
function UICompStLevelup:spineAnimationEnd(event)
    if event.type == "complete" then
        if event.animation == "ShengJiPanDuan2" then
            if self._success then
                if self._prop then
                    for idx = 1, #self._prop do
                        local childIndex = self._attrlist:itemIndexToChildIndex(idx-1)
                        local context = self._attrlist:getChildAt(childIndex)
                        context:showSuccessAnimation()
                    end
                end
                self._spine:setAnimationScale(0.5)
                self._spine:setAnimation(0, "ShengJiChengGong2", false)
                self._rateLabel:setText(self._types == 0 and GReadText.KEY_STRENGTHEN_TIPS5 or GReadText.KEY_STRENGTHEN_TIPS6)
            else
                if self._prop then
                    for idx = 1, #self._prop do
                        local childIndex = self._attrlist:itemIndexToChildIndex(idx-1)
                        local context = self._attrlist:getChildAt(childIndex)
                        context:showFailAnimation()
                    end
                end
                self._spine:setAnimationScale(1)
                self._spine:setAnimation(0, "ShengJiShiBai2", false)
                self._rateLabel:setText(self._types == 0 and GReadText.KEY_STRENGTHEN_TIPS7 or GReadText.KEY_STRENGTHEN_TIPS8)
            end
        elseif event.animation == "ShengJiChengGong2" then
            self._effectnNode:setVisible(false)
            self:animationFinish()
            AudioManager:playSound(Constant.SoundEffect.EventFanfare)
        elseif event.animation == "ShengJiShiBai2" then
            self._effectnNode:setVisible(false)
            self:animationFinish()
            AudioManager:playSound(Constant.SoundEffect.JewelItemMoveSound)
        end
    end
end

function UICompStLevelup:animationFinish()
    if self._types == 0 or not self._success then
        --升级只刷新右边
        self:refreshView(self._itemInfo)
        if self._itemInfo then
            --升到满阶满级刷新左边
            local nextEquip = self._itemInfo:getItemMeta():getNextItemIdx()
            local lvMax = StrengthenModule:isLevelMax(self._itemInfo, self._itemInfo:getILevel())
            if nextEquip == 0 and lvMax then
                local objId = self._itemInfo:getObjId()
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_EQUIP_VIEW, {objId = objId})
            end
        end
    else
        --升阶刷新左边
        local objId = self._itemObjId
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_EQUIP_VIEW, {objId = objId})
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_OPEN_STRENGTHEN_MASK, false)
end

function UICompStLevelup:onCancelBtnClick()
    self._itemInfo = nil
    self._prop = nil
    self._nextProp = nil
    self._cost = nil
    self._costNum = nil
    self._costLord = nil
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_EQUIP_CHOOSE, {needRefresh = true})
end

function UICompStLevelup:renderListItem(index, obj)
    local equipProp = self._prop[index + 1]
    if self._cost == 0 then
        obj:setMaxAttr(equipProp)
    else
        obj:setAttr(equipProp, self._nextProp)
    end
    obj:insertObjectToFactory(self:getRegClass())
end

function UICompStLevelup:resetTargetAction()
    if self._targetAction then
        self._targetAction:kill()
        self._targetAction = nil
    end
end

function UICompStLevelup:refreshItemNum(event)
    if event and event.name == "NTF_UPDATE_ITEM_NUMB" then
        if event.param and event.param.content then
            if self._itemContentTable and self._itemContentTable[event.param.content] then
                
            else
                return
            end
        end
    end
    self._item:setNeedNum(ItemModule:getItemNum(self._cost), self._costNum)
    if self._cost > 0 and self._costLord then
        local gray = ItemModule:getItemNum(self._cost) < self._costNum
        if not gray then
            local canLevelup = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, self._costLord, {tips = false})
            gray = not canLevelup
        end
        self._levelupBtn:setGrayed(gray)
    end
end

function UICompStLevelup:checkGuide()
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.LEVELUP5) then
        local btn = self._levelupBtn
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x - btn:getSize().width/2, pos.y - btn:getSize().height/2)
        GuideModule:triggerGuide(Constant.GUIDE_ID.LEVELUP5, btn, pos)
        return
    end
end

function UICompStLevelup:refreshMoney()
    if self._costLord then
        local canLevelup = ItemModule:enoughItem(1, Constant.TYPE_VAULE_ITEM.COIN, self._costLord, {tips = false})
        local color = canLevelup and "[color=#00ff00]" or "[color=#ff0000]"
        local lordStr = color..CommonFunc:changeNumberShow(self._costLord).."[/color]"
        self._costLabel:setText(string.format(GReadText.KEY_NPC_CLS_SKILL_TIPS3, _GURL.GetImageCoin..lordStr))
        if self._cost > 0 then
            local gray = ItemModule:getItemNum(self._cost) < self._costNum
            if not gray then
                gray = not canLevelup
            end
            self._levelupBtn:setGrayed(gray)
        end
    end
end

return UICompStLevelup