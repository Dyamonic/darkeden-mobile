local ExchangeBoxDao = {}

function ExchangeBoxDao:query(itemId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM ExchangeBox WHERE ItemIdx=%d;", tonumber(itemId))) do
    	local meta = lt.ExchangeBoxMeta.new(row)
        return meta
    end
end

function ExchangeBoxDao:queryAll()
    local exchangeBoxMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM ExchangeBox") do
        local meta = lt.ExchangeBoxMeta.new(row)
        if not exchangeBoxMap[meta:getNpcIndex()] then
            exchangeBoxMap[meta:getNpcIndex()] = {}
        end
        table.insert(exchangeBoxMap[meta:getNpcIndex()], meta)
    end
    return exchangeBoxMap
end

return ExchangeBoxDao