local TransLiveModule = {}

local SocketApi     = lt.SocketApi
local netcmd_pb     = lt.netcmd_pb
local ServerCmdDef  = lt.ServerCmdDef
local ClientCmdDef  = lt.ClientCmdDef
local NtfManager    = lt.NtfManager
local Constant      = lt.Constant
local StringManager = lt.StringManager

function TransLiveModule:init()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPT_TRANSLIVE_REDDOT, handler(self, self.onUptRedTips), "TransLiveModule:checkRedTips")
end

function TransLiveModule:clear()
    lt.NtfManager:removeNtfListenerByTag("UIDlgTransLive:onUptDataView")
end

function TransLiveModule:initRedTips()
    lt.RedDotModule:createTipsNode("GameLayerUI_TransLiveRedTips", "GameLayerUI_HeroMore")
    
    self:checkRedTips()
end

function TransLiveModule:checkRedTips()
    --等级， 经验， 道具发生变化 都得检测
    local visible = false

    visible = self:isCanTransLive()
    if not visible then
        visible = self:isCanExchange()
    end

    lt.RedDotModule:setTipsStateByName("GameLayerUI_TransLiveRedTips", visible)
end

function TransLiveModule:isCanTransLive()
    local isCanTrans = false

    local severPhase = lt.CommonModule:getServerPrase()
    local iCurLv = self:getTransLiveLv()
    --转生
    local isLvEnough = false
    local isItemEnough = false
    local iHeroLv = lt.GameModule:getHeroData():getLevel()
    local tDaoData = lt.ReBornDao:queryLvPhase(severPhase, iCurLv)
    if tDaoData then
        if iHeroLv >= tDaoData:getMinLevel() then
            isLvEnough = true
        end

        if isLvEnough then
            local isEnough = true
            local data = tDaoData:getCostItem()
            local iCostNum = #data
            for i=1,iCostNum do
                local tCost = data[i]
                if tCost then
                    local iHaveNum = lt.ItemModule:getItemNumByIdAndType(tCost.itemType, tCost.itemId)
                    if iHaveNum < tCost.itemNum then
                        isEnough = false
                        break
                    end
                end
            end
            isItemEnough = isEnough
        end
    end

    if isLvEnough and isItemEnough then
        isCanTrans = true
    end

    return isCanTrans
end

function TransLiveModule:getLvData(iHeroLv)

    local tData = lt.ExpChangeDao:queryAll()
    local tLessData = nil
    if tData then
        local tMinLv = tData[1]:getLevel()
        local tManLv = tData[#tData]:getLevel()
        if iHeroLv < tMinLv then
        elseif iHeroLv >= tManLv then
            tLessData = tData[#tData]
        else
            for i=1,#tData-1 do
                local tCurrLv = tData[i]:getLevel()
                local tNextLv = tData[i+1]:getLevel()
                if iHeroLv < tNextLv and tCurrLv <= iHeroLv then
                    tLessData = tData[i]
                    break
                end
            end
        end
    end

    if not tLessData then
        print("UIWgtTransLiveExchange ERROR: No Data")
    end

    return tLessData
end

function TransLiveModule:isCanExchange()
    --兑换
    local isExchange = false
    local iHeroLv = lt.GameModule:getHeroData():getLevel()
    local tDaoData = self:getLvData(iHeroLv)

    local iExcCount = lt.GameModule:getHeroData():getTransLiveExcCount()
    if tDaoData then
        local iCounts = tDaoData:getTimes()
        if iExcCount < iCounts then
            local iCurrExp = lt.GameModule:getHeroData():getExp()
            local iNeedExp = tDaoData:getCostExp()
    
            local tGold = tDaoData:getCostItem()
            local iHaveNum = lt.ItemModule:getItemNumByIdAndType(tGold.itemType, tGold.itemId)
            if iHaveNum >= tGold.itemNum and iCurrExp >= iNeedExp then
                isExchange = true
            end
        end
    end
    
    return isExchange
end

function TransLiveModule:onUptRedTips(event)
    self:checkRedTips()
end

function TransLiveModule:requestUserLvUp()
    SocketApi:sendToGs(ClientCmdDef.C_PlayerUpLevel)
end

function TransLiveModule:requestUserReBorn()
    SocketApi:sendToGs(ClientCmdDef.C_ReBorn)
end

function TransLiveModule:requestReBornExchange()
    SocketApi:sendToGs(ClientCmdDef.C_ReincarnatedExchange)
end

function TransLiveModule:getTransLiveLv()
    return lt.GameModule:getHeroData():getTransLiveLv()
end

return TransLiveModule