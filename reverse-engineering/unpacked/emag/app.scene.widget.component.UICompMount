--- 坐骑
---@class UICompMount
local UICompMount  = class("UICompMount", lt.UIGButtonBase)

local NtfManager   = lt.NtfManager
local Constant     = lt.Constant
local CacheManager = lt.CacheManager
local ItemModule   = lt.ItemModule
local MountModule  = lt.MountModule
local PrefManager  = lt.PrefManager
local UIMountActor = lt.UIMountActor
local GameModule   = lt.GameModule
local PetUIActor   = lt.PetUIActor
local SkillEnum    = lt.SkillEnum
local GuideModule  = lt.GuideModule


UICompMount.ChangeSkinConf = {
    ["Mount"] = {
        ["bg_left"] = "bg_zqxt_dk01",
        ["bg_right"] = "bg_zqxt_dk02",

    },
    ["CommonTL"] = {
        ["btn_up"] = { bg = "bg_youjian_changanniu01", disabled = "bg_youjian_changanniu02" },
        ["compCost"] = {
            ["bg"] = "bg_zhuangbei_di",
        }
    }
}

function UICompMount:ctor()
    UICompMount.super.ctor(self)
    self._stars           = {}
    self._costLblList     = {}
    self._costIconList    = {}
    self._effectActorsArr = {}
    self._selectItem      = nil
end

function UICompMount:onClear()
    if self._listItem then
        self._listItem:removeChildrenToPool()
        self._listItem:removeItemRenderer()
        self._listItem:removeEventListener(fgui.UIEventType.ClickItem)
        self._listItem = nil
    end
    self:onClearModelActor()
    if self._stars then
        for i = 1, #self._stars do
            self._stars[i] = nil
        end
        self._stars = nil
    end
    if self._stars then
        for i = 1, #self._stars do
            self._stars[i] = nil
        end
        self._stars = nil
    end
    if self._costLblList then
        for i = 1, #self._costLblList do
            self._costLblList[i] = nil
        end
        self._costLblList = nil
    end
    if self._costIconList then
        for i = 1, #self._costIconList do
            self._costIconList[i] = nil
        end
        self._costIconList = nil
    end
    self._useType         = nil
    self._selectItem      = nil
    self._fullControl     = nil
    self._txtCost         = nil
    self._effectActorsArr = nil
    UICompMount.super.onClear(self)
end

function UICompMount:onConstruct()
    self._listItem     = self:getChild("list_litem")
    self._nameText     = self:getChild("lbl_name")
    self._btnsControl  = self:getController("c1")
    self._btnUpData    = self:getChild("btn_up") --激活or升级
    self._btnUse       = self:getChild("btn_gh") --使用
    self._compCost     = self:getChild("compCost")
    self._txtCost      = self:getChild("txt_cost")
    self._btnAll       = self:getChild("btn_zsx")  --总属性
    self._iconCost1    = self:getChild("icon_cos") --消耗货币
    self._lblCost1     = self:getChild("lbl_cost") --消耗货币数量
    self._iconCost2    = self._compCost:getChild("icon")
    self._lblCost2     = self._compCost:getChild("lbl_cost")

    self._propOne      = self:getChild("prop_one")
    self._propLeft     = self:getChild("prop_left")
    self._propRight    = self:getChild("prop_right")
    self._modelNode    = self:getChild("icon_mount")
    self._fullControl  = self:getController("full")

    self._costLblList  = { self._lblCost2, self._lblCost1 }
    self._costIconList = { self._iconCost2, self._iconCost1 }

    local pos          = self._modelNode:getPosition()
    self._originX      = pos.x
    self._originY      = pos.y
    for i = 1, 5 do
        self._stars[i] = self:getChild("star" .. i)
    end
    self._listItem:setItemRenderer(handler(self, self.onCellRender))
    self._effectActorsArr = {}
end

function UICompMount:onEnter()
    UICompMount.super.onEnter(self)
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATA_MOUNTEORHALO_CHANGE,
        handler(self, self.refreshDataUpdatas), "UICompMount:refreshDataUpdatas")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB,
        handler(self, self.initRightItem), "UICompMount:initRightItem")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_MONEY_EVENT,
        handler(self, self.initRightItem), "UICompMount:NTF_UPDATE_MONEY_EVENT")
    self._listItem:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    self._btnUse:addClickListener(handler(self, self.btnUseClick))
    self._btnUpData:addClickListener(handler(self, self.btnUpDataClick))
    self._btnAll:addClickListener(handler(self, self.btnShowAllTipsClick))
    for i, v in ipairs(self._costIconList or {}) do
        v:addClickListener(handler(self, self.btnTipsClick))
    end
end

function UICompMount:onExit()
    self:onClearModelActor()
    NtfManager:removeNtfListenerByTag("UICompMount:refreshDataUpdatas")
    NtfManager:removeNtfListenerByTag("UICompMount:initRightItem")
    NtfManager:removeNtfListenerByTag("UICompMount:NTF_UPDATE_MONEY_EVENT")
    self._listItem:removeEventListener(fgui.UIEventType.ClickItem)
    self._btnUse:removeClickListener()
    self._btnUpData:removeClickListener()
    self._btnAll:removeClickListener()
    for i, v in ipairs(self._costIconList or {}) do
        v:removeClickListener()
    end
    UICompMount.super.onExit(self)
end

function UICompMount:refreshView(fiterType, itemData, curIndex)
    if self._fiterType ~= fiterType then
        self._selectItem = nil
        self._useType = MountModule:getUseType(fiterType == Constant.FITER_MOUNT_TYPE.MOUNT)
    end
    self._fiterType = fiterType
    self._itemData = itemData
    self._listObj = {}
    self._listItem:setNumItems(#itemData)
    if curIndex then
        if self._itemData and not self._selectItem then
            self._selectItem = self._itemData[curIndex]
        end
    else
        if (self._useType == nil or self._useType == 0) and self._itemData then
            self._selectItem = self._itemData[1]
        end
    end
    self:refreshCells()
    self:initRightItem()
    self:onFreshBtn()
end

function UICompMount:btnUseClick()
    if self._selectItem == nil then
        return
    end
    --使用坐骑光环
    if self._fiterType == Constant.FITER_MOUNT_TYPE.MOUNT then
        -- 选择
        local level = MountModule:getHaloInfos(self._fiterType, self._selectItem:getType())
        if level == -1 then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = GReadText.KEY_MOUNT_TIPS4 })
            return
        end
        local keySelect = PrefManager:getUserValueByKey(MountModule.MOUNT_SELECT) or 0
        local typeSelect = self._selectItem:getType() or 0
        if tonumber(keySelect) ~= tonumber(typeSelect) then
            PrefManager:setUserValueByKey(MountModule.MOUNT_SELECT, typeSelect)
        else
            PrefManager:setUserValueByKey(MountModule.MOUNT_SELECT, 0)
        end
        self._useType = MountModule:getUseType(self._fiterType == Constant.FITER_MOUNT_TYPE.MOUNT)
        self:refreshCells()
        self:onFreshBtn()
    elseif self._fiterType == Constant.FITER_MOUNT_TYPE.HALO then
        MountModule:onUseHaloReq(self._selectItem:getType())
    end
end

function UICompMount:btnUpDataClick()
    if self._selectItem == nil then
        return
    end
    if self._fiterType == Constant.FITER_MOUNT_TYPE.MOUNT then
        MountModule:onUpgradeMountReq(self._selectItem:getType())
    elseif self._fiterType == Constant.FITER_MOUNT_TYPE.HALO then
        MountModule:onUpgradeHaloReq(self._selectItem:getType())
    end
end

function UICompMount:onFreshBtn()
    if self._fiterType == Constant.FITER_MOUNT_TYPE.MOUNT then
        local keySelect = PrefManager:getUserValueByKey(MountModule.MOUNT_SELECT) or 0
        local typeSelect = self._selectItem:getType() or 0
        if tonumber(typeSelect) > 0 then
            if tonumber(keySelect) ~= tonumber(typeSelect) then
                self._btnUse:setTitle(GReadText.KEY_MOUNT_TIPS5)
            else
                self._btnUse:setTitle(GReadText.KEY_MOUNT_TIPS6)
            end
        end
        return
    else
        local usekey = MountModule:getUseType()
        local typeSelect = self._selectItem:getType() or 0
        if tonumber(typeSelect) > 0 then
            if tonumber(usekey) ~= tonumber(typeSelect) then
                self._btnUse:setTitle(GReadText.KEY_MOUNT_TIPS5)
            else
                self._btnUse:setTitle(GReadText.KEY_MOUNT_TIPS6)
            end
        end
    end
end

function UICompMount:refreshDataUpdatas(event)
    local param = event.param
    if param then
        self._useType = MountModule:getUseType(self._fiterType == Constant.FITER_MOUNT_TYPE.MOUNT)
        if (self._useType == nil or self._useType == 0) and self._itemData then
            if not self._selectItem then
                self._selectItem = self._itemData[1]
            end
        end
        if param.type == self._fiterType then
            self:refreshCells()
            self:initRightItem()
        end
    end
end

function UICompMount:onCellRender(index, obj)
    local index = index + 1
    local data = self._itemData[index]
    local reset = false
    if self._useType then
        if data:getType() == self._useType then
            self._selectItem = data
            reset = true
        end
    end
    if data then
        obj:setInfo(data, index, self._fiterType)
        obj:insertObjectToFactory(self:getRegClass())
        obj._index = index
        self._listObj[index] = obj
    end
    if reset then
        self:refreshCells()
        self:initRightItem()
    end
end

function UICompMount:onClickItem(context)
    local item = context:getData()
    local _data = item:getData()
    self._selectItem = _data

    self:refreshCells()
    self:initRightItem()
end

function UICompMount:refreshCells()
    for key, v in ipairs(self._listObj) do
        v:refreshLevel(MountModule:getHaloInfos(self._fiterType, self._itemData[key]:getType()))
        if self._selectItem then
            if v:getData():getType() == self._selectItem:getType() then
                v:setSelectVisible(true)
            else
                v:setSelectVisible(false)
            end
            if v:getData():getType() == self._useType then
                v:setUseVisible(true)
            else
                v:setUseVisible(false)
            end
        else
            if v:getData():getType() == self._useType then
                v:setSelectVisible(true)
                v:setUseVisible(true)
            else
                v:setSelectVisible(false)
                v:setUseVisible(false)
            end
        end
    end
end

function UICompMount:refreshDatas(_level)
    self._itemContentTable = {}
    self._nameText:setText(self._selectItem:getName())
    if _level == -1 then
        self._btnUpData:setVisible(true)
        self._btnUse:setVisible(false)
        self._btnUpData:setTitle(GReadText.KEY_MOUNT_TIPS1)
        self._btnUpData:setGrayed(false)
        self._btnsControl:setSelectedIndex(0)
        self._fullControl:setSelectedIndex(0)
    elseif _level == 10 then
        self._btnUse:setVisible(true)
        self._btnUpData:setTitle(GReadText.KEY_MOUNT_TIPS2)
        self._btnUpData:setGrayed(true)
        self._btnsControl:setSelectedIndex(0)
        self._fullControl:setSelectedIndex(1)
    else
        self._btnUse:setVisible(true)
        self._btnUpData:setTitle(GReadText.KEY_MOUNT_TIPS3)
        self._btnUpData:setGrayed(false)
        self._btnsControl:setSelectedIndex(1)
        self._fullControl:setSelectedIndex(0)
    end
    local _type = self._selectItem:getType()
    self:onFreshBtn()
    local itemMetas = MountModule:getLevelDatas(self._fiterType == Constant.FITER_MOUNT_TYPE.MOUNT)[_type]
    -- 下一等级
    local curLevel = _level + 1
    local nextLevel = curLevel + 1
    if nextLevel > #itemMetas.metas then
        nextLevel = #itemMetas.metas
    end
    local itemList = itemMetas.metas[nextLevel]:getCost()
    for i, v in ipairs(itemList or {}) do
        local itemData = v
        local itemType = tonumber(itemData[1])
        local itemMeta = ""
        local iconPath = ""
        if itemType == Constant.ItemType.ITEM_TYPE_PROP then
            iconPath = "prop"
            itemMeta = CacheManager:getItemMeta(tonumber(itemData[2]))
        elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
            iconPath = "equip"
            itemMeta = CacheManager:queryEquipMeta(tonumber(itemData[2]))
        end
        local resUrl = string.format("ui://Item/%s_%s", iconPath, itemMeta:getIconId())

        local allCount = ItemModule:getItemAllCountByItemId(itemMeta:getItemId(), itemMeta:getItemType())
        self._costIconList[i].itemInfo = itemMeta
        self._costIconList[i]:setURL(resUrl)
        local costStr = ""
        if tonumber(itemData[2]) ~= Constant.TYPE_VAULE_ITEM.COIN then
            costStr = allCount .. "/" .. itemData[3]
        else
            costStr = itemData[3]
        end
        self._costLblList[i]:setText(costStr)

        local enough = ItemModule:enoughItem(itemType, itemData[2], tonumber(itemData[3]))
        self._costLblList[i]:setColor(enough and Constant.COLOR_GREEN or Constant.COLOR_TEXT_RED)
        local _itemkey = string.format("%d_%d", itemMeta:getItemType(), itemMeta:getItemId())
        self._itemContentTable[_itemkey] = true
    end

    for i = 1, #self._costLblList do
        self._costIconList[i]:setVisible(i <= #itemList)
        self._costLblList[i]:setVisible(i <= #itemList)
    end
    self._txtCost:setVisible(#itemList >= 2)

    if _level == -1 or self._fullControl:getSelectedIndex() == 1 then
        --激活
        self._propOne:setInfo(curLevel, itemMetas.metas[nextLevel], true)
        self._propOne:insertObjectToFactory(self:getRegClass())
    else
        self._propLeft:setInfo(_level, itemMetas.metas[curLevel], true)
        self._propLeft:insertObjectToFactory(self:getRegClass())
        self._propRight:setInfo(curLevel, itemMetas.metas[nextLevel], false)
        self._propRight:insertObjectToFactory(self:getRegClass())
    end
    if self._fiterType == Constant.FITER_MOUNT_TYPE.MOUNT then
        local type = self._selectItem:getType()
        local race = GameModule:getHeroData():getRace()
        if race == Constant.RaceType.Ousters then -- 魔
            local skillId = 0
            if type == Constant.OUTSET_MOUNTID.FAIRY then
                skillId = SkillEnum.SKILL_SUMMON_FAIRY
            elseif type == Constant.OUTSET_MOUNTID.PEGASUS then
                skillId = SkillEnum.SKILL_SUMMON_PEGASUS
            else
                return
            end
            local buffMetas = CacheManager:getBuffMetas(skillId, 0)
            local maxMetas = math.max(#buffMetas, #self._effectActorsArr)
            if self._effectActorsArr and #self._effectActorsArr > 0 then
                for i = maxMetas, 1, -1 do
                    if i == 1 then
                        self._effectActorsArr[i]:playEffect(buffMetas[i], Constant.DIRECTION_LEFT_DOWN)
                    else
                        if self._effectActorsArr[i] then
                            self._effectActorsArr[i]:onClear()
                            table.remove(self._effectActorsArr, i)
                        end
                    end
                end
            else
                self._effectActorsArr = {}
                for key = 1, #buffMetas do
                    self._effectActorsArr[key] = lt.UIEffectActor.new(buffMetas[key], Constant.DIRECTION_LEFT_DOWN, true)
                    self._modelNode:displayObject():addChild(self._effectActorsArr[key])
                    self._modelNode:setPosition(self._originX, self._originY)
                end
            end
        elseif race == Constant.RaceType.Vampire then -- 鬼
            if self._effectActorsArr then
                for i = #self._effectActorsArr, 1, -1 do
                    self._effectActorsArr[i]:onClear()
                    table.remove(self._effectActorsArr, i)
                end
            end
            if not self._modelPetActor then
                self._modelPetActor = PetUIActor.new(1)
                self._modelNode:displayObject():addChild(self._modelPetActor)
                self._modelNode:setPosition(self._originX + 20, self._originY)
            end
            local transformId = SkillEnum.TRANSFORM_BATS[type]
            local modelId = SkillEnum.TRANSFORM_MODELID[transformId]
            self._modelPetActor:playAction(modelId)
        else
            if self._effectActorsArr then
                for i = #self._effectActorsArr, 1, -1 do
                    self._effectActorsArr[i]:onClear()
                    table.remove(self._effectActorsArr, i)
                end
            end
            if not self._modelActor then
                self._modelActor = UIMountActor.new(1)
                self._modelNode:displayObject():addChild(self._modelActor)
                self._modelNode:setPosition(self._originX + 25, self._originY - 10)
            end
            self._modelActor:playAction(type)
        end
    elseif self._fiterType == Constant.FITER_MOUNT_TYPE.HALO then
        if self._modelActor then
            self._modelActor:onClear()
            self._modelActor = nil
        end
        if self._modelPetActor then
            self._modelPetActor:onClear()
            self._modelPetActor = nil
        end

        local skillId = self._selectItem:getSkill()
        local buffMetas = CacheManager:getBuffMetas(skillId, 0)
        local maxMetas = math.max(#buffMetas, #self._effectActorsArr)
        if self._effectActorsArr and #self._effectActorsArr > 0 then
            for i = maxMetas, 1, -1 do
                if buffMetas[i] then
                    if self._effectActorsArr[i] then
                        self._effectActorsArr[i]:playEffect(buffMetas[i], Constant.DIRECTION_LEFT_DOWN)
                    else
                        self._effectActorsArr[i] = lt.UIEffectActor.new(buffMetas[i], Constant.DIRECTION_LEFT_DOWN, true)
                        self._modelNode:displayObject():addChild(self._effectActorsArr[i])
                        self._modelNode:setPosition(self._originX, self._originY)
                    end
                else
                    if self._effectActorsArr[i] then
                        self._effectActorsArr[i]:onClear()
                        table.remove(self._effectActorsArr, i)
                    end
                end
            end
        else
            self._effectActorsArr = {}
            for key = 1, #buffMetas do
                self._effectActorsArr[key] = lt.UIEffectActor.new(buffMetas[key], Constant.DIRECTION_LEFT_DOWN, true)
                self._modelNode:displayObject():addChild(self._effectActorsArr[key])
                self._modelNode:setPosition(self._originX, self._originY)
            end
        end
    end
end

function UICompMount:onUpdate(dt)
    if self._modelActor then
        self._modelActor:onUpdate(dt)
    end
    if self._modelPetActor then
        self._modelPetActor:onUpdate(dt)
    end
    if self._effectActorsArr then
        for i = 1, #self._effectActorsArr do
            self._effectActorsArr[i]:onUpdate(dt)
        end
    end
end

function UICompMount:onClearModelActor()
    if self._modelActor then
        self._modelActor:onClear()
        self._modelActor = nil
    end
    if self._modelPetActor then
        self._modelPetActor:onClear()
        self._modelPetActor = nil
    end
    if self._effectActorsArr then
        for i = #self._effectActorsArr, 1, -1 do
            self._effectActorsArr[i]:onClear()
            table.remove(self._effectActorsArr, i)
        end
    end
end

function UICompMount:btnTipsClick(target)
    local itemInfo = target:getSender().itemInfo
    if itemInfo then
        ItemModule:showTipsByType(itemInfo)
    end
end

function UICompMount:refreshLevelIcon(maxnumb, hight)
    for i = 1, #self._stars do
        if hight then
            if maxnumb >= i then
                self._stars[i]:setURL("ui://Mount/icon_cwzq_xin03")
            else
                self._stars[i]:setURL("ui://Mount/icon_cwzq_xin01")
            end
        else
            if maxnumb >= i then
                self._stars[i]:setURL("ui://Mount/icon_cwzq_xin01")
            else
                self._stars[i]:setURL("ui://Mount/icon_cwzq_xin02")
            end
        end
    end
end

function UICompMount:initRightItem(event)
    if self._selectItem == nil then
        return
    end
    if event and event.name == "NTF_UPDATE_ITEM_NUMB" then
        if event.param and event.param.content then
            if self._itemContentTable and self._itemContentTable[event.param.content] then

            else
                return
            end
        end
    end
    local level = MountModule:getHaloInfos(self._fiterType, self._selectItem:getType())
    if level == -1 then
        --未激活
        self:refreshLevelIcon(0)
        self:refreshDatas(level)
        return
    else
        local nums = level % 5
        if nums == 0 and level ~= 0 then
            nums = 5
        end
        self:refreshLevelIcon(nums, level > 5)
    end
    self:refreshDatas(level)
end

function UICompMount:btnShowAllTipsClick()
    local point = self._btnAll:localToGlobal({ x = -self._btnAll:getSize().width, y = 0 })

    local tempAttrMap = {}
    for i, v in ipairs(self._itemData or {}) do
        local _type = v:getType()
        local level = MountModule:getHaloInfos(self._fiterType, _type)

        if level ~= -1 then
            local curLevel = level + 1
            local itemMetas = MountModule:getLevelDatas(self._fiterType == Constant.FITER_MOUNT_TYPE.MOUNT)[_type]
            if itemMetas.metas[curLevel] then
                local attrs = itemMetas.metas[curLevel]:getAttr()
                for i, v in ipairs(attrs or {}) do
                    local propId    = v[1]
                    local propValue = v[2]
                    if not tempAttrMap[propId] then
                        tempAttrMap[propId] = propValue
                    else
                        tempAttrMap[propId] = tempAttrMap[propId] + propValue
                    end
                end
            end
        end
    end

    local attrArrs = {}
    for propId, totalValue in pairs(tempAttrMap) do
        table.insert(attrArrs, {
            propId = propId,
            propValue = totalValue
        })
    end

    -- 可选：按 propId 排序，保证显示顺序一致
    table.sort(attrArrs, function(a, b)
        return a.propId < b.propId
    end)

    if #attrArrs == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = GReadText.KEY_MOUNT_TIPS4 })
        return
    end

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_ATTRS_TIPS, {
        pt = point,
        attrArrs = attrArrs,
    })
end

function UICompMount:checkGuide()
    --坐骑系统引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.MOUNT2) then
        local pos = self:displayObject():convertToWorldSpace(self._listItem:getPosition())
        pos = cc.p(pos.x, pos.y)
        GuideModule:triggerGuide(Constant.GUIDE_ID.MOUNT2, self._listItem, pos)
        return
    end

    if GuideModule:checkCanGuide(Constant.GUIDE_ID.MOUNT3) then
        local pos = self:displayObject():convertToWorldSpace(self._btnUpData:getPosition())
        pos = cc.p(pos.x, pos.y - 10)
        GuideModule:triggerGuide(Constant.GUIDE_ID.MOUNT3, self._btnUpData, pos)
        return
    end
end

return UICompMount
