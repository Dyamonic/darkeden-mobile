local VipModule      = {}

local SocketApi      = lt.SocketApi
local netcmd_pb      = lt.netcmd_pb
local CommonModule   = lt.CommonModule
local ServerCmdDef   = lt.ServerCmdDef
local ClientCmdDef   = lt.ClientCmdDef
local NtfManager     = lt.NtfManager
local RedDotModule   = lt.RedDotModule
local CacheManager   = lt.CacheManager

VipModule._myVipList = nil

function VipModule:init()
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_VIP_RESP),
        handler(self, self.onVipResp), "VipModule:onVipResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_BUY_VIP_RESP),
        handler(self, self.onBuyVipResp), "VipModule:onBuyVipResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_RECEIVE_VIP_REWARD_RESP),
        handler(self, self.onReceiveVipRewardResp), "VipModule:onReceiveVipRewardResp")
end

function VipModule:clear()
    SocketApi:removeProtoListenerByTag("VipModule:onVipResp")
    SocketApi:removeProtoListenerByTag("VipModule:onBuyVipResp")
    SocketApi:removeProtoListenerByTag("VipModule:onReceiveVipRewardResp")

    self._myVipList = nil
end

----------------------------回调----------------------------
function VipModule:onVipResp(event)
    local proto = event.param
    local ret = proto.ret -- 0 成功
    local vipData = proto.vipData

    self:initVipList(vipData.vipMap)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_VIP_LIST_CHANGE)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_ENERGY_EXP)
end

function VipModule:onBuyVipResp(event)
    local proto = event.param
    local ret = proto.ret -- 0 成功
    local vipData = proto.vipData

    self:initVipList(vipData.vipMap)
    if ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_VIP_STATE_CHANGE)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_ENERGY_EXP, {reloadList = true})
    end
end

function VipModule:onReceiveVipRewardResp(event)
    local proto = event.param
    local ret = proto.ret -- 0 成功
    local vipData = proto.vipData

    self:initVipList(vipData.vipMap)
    if ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_VIP_STATE_CHANGE)
    end
end

----------------------------请求----------------------------
function VipModule:sendVipReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_VIP_REQ))
end

-- 购买
function VipModule:sendBuyVipReq(vipLv)
    local msg = netcmd_pb.CS_BuyVipReq()
    msg.vipLv = vipLv --
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_BUY_VIP_REQ), msg)
end

-- 领取礼包
function VipModule:sendReceiveVipRewardReq(vipLv)
    local msg = netcmd_pb.CS_ReceiveVipRewardReq()
    msg.vipLv = vipLv --
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_RECEIVE_VIP_REWARD_REQ), msg)
end

----------------------------方法----------------------------

function VipModule:getVipLvState(lv)
    for i, v in ipairs(self._myVipList or {}) do
        if v.key == lv then
            return v.value
        end
    end
    return 0
end

function VipModule:initVipList(vipMap)
    self._myVipList = vipMap
    for i, v in ipairs(self._myVipList) do
        if v.value == CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_BUY_ENUM") then
            VipModule:setVipRedTips(true)
            return
        end
    end
    VipModule:setVipRedTips(false)
end

-- 获取已激活的Id
function VipModule:getCurVipLv()
    local curLv = 0
    for i, v in ipairs(self._myVipList or {}) do
        if v.value ~= CommonModule:GetNetCmdEnum("VIPSTATE_VIPSTATE_NULL_ENUM") then
            if v.key > curLv then
                curLv = v.key
            end
        end
    end
    return curLv
end

function VipModule:getVipExpAdd(vipLv)
    if vipLv == nil then
        vipLv = VipModule:getCurVipLv()
    end 
    local array = CacheManager:getPrivilegeArray()
    if array and array[vipLv] then
        local meta = array[vipLv]
        return meta:getLevelBonus()/100 or 0
    end
    return 0
end

function VipModule:getVipChatNum()
    local array = CacheManager:getPrivilegeArray()
    local vipLv = VipModule:getCurVipLv()
    if array and array[vipLv] then
        local meta = array[vipLv]
        return meta:getNumber() or 0
    end
    return 0
end

-- 交易行额外栏位
function VipModule:getVipPosition()
    local array = CacheManager:getPrivilegeArray()
    local vipLv = VipModule:getCurVipLv()
    if array and array[vipLv] then
        local meta = array[vipLv]
        return meta:getPosition() or 0
    end
    return 0
end

--开启随身出售
function VipModule:getVipMobileRecycle()
    -- local array = CacheManager:getPrivilegeArray()
    -- local vipLv = VipModule:getCurVipLv()
    -- if array and array[vipLv] then
    --     local meta = array[vipLv]
    --     return meta:getMobileRecycle() or 0
    -- end
    return 1
end

-- 第几级开启 一键回收
function VipModule:getQuickRecycleLv()
    local array = CacheManager:getPrivilegeArray()
    for i,v in ipairs(array) do
        if v:getQuickRecycle() == 1 then
            return i
        end
    end
    return 0
end

-- 第几级开启自动回收
function VipModule:getVipAutoRecycleLv()
    local array = CacheManager:getPrivilegeArray()
    for i,v in ipairs(array) do
        if v:getAutoRecycle() == 1 then
            return i
        end
    end
    return 0
end

-- 第几级开启自动买药功能
function VipModule:getVipAutoMedicationLv()
    local array = CacheManager:getPrivilegeArray()
    for i,v in ipairs(array) do
        if v:getAutoMedication() == 1 then
            return i
        end
    end
    return 0
end

function VipModule:getCurVipMeta()
    local array = CacheManager:getPrivilegeArray()
    local vipLv = VipModule:getCurVipLv()
    if array and array[vipLv] then
        return array[vipLv]
    end
    return nil
end
----------------------------红点----------------------------
function VipModule:setVipRedTips(bool)
    RedDotModule:setTipsStateByName("VipRedTips", bool)
end

function VipModule:getRedPoint()
    return RedDotModule:getTipsStateByName("VipRedTips")
end

return VipModule
