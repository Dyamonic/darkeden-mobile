local EveryDayCheckinData = class("EveryDayCheckinData")
--[[
    每日签到 信息
]]

table.merge(EveryDayCheckinData, {
    _day            = nil,            -- 天数
    _state          = nil,        -- 领取状态
})

function EveryDayCheckinData:setData(data)
    self._day = data.day
    self._state = data.state
end

function EveryDayCheckinData:getDay()
    return self._day
end

function EveryDayCheckinData:getState()
    return self._state
end

return EveryDayCheckinData
