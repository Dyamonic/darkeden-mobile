
local AchivementData = class("AchivementData")
--[[
    成就系统
]]

function AchivementData:ctor(meta)

    self:setAchivementMeta(meta)

    local titleId = self._achiveMeta:getTitleId()
    if titleId ~= 0 then
        local titleMeta = lt.CacheManager:queryAchiveTitleMetaById(titleId)
        self:setActiveTitleMeta(titleMeta)
    end
end

function AchivementData:setProtoInfo(obj)
    self._achievementState = obj.achievementState
    self._progress = obj.progress
end

function AchivementData:getState()
    return self._achievementState or 0
end

function AchivementData:getProgress()
    return self._progress or 0
end

function AchivementData:isComplete()
    return self:getState() == 1
end

function AchivementData:isGet()
    return self:getState() == 2
end

function AchivementData:getComplete()
    return (self:getState() == 1 and 1 or 0)
end

function AchivementData:getRedDot()
    return self:isComplete()
end

-- --------------------------------

function AchivementData:getId()
    return self._achiveMeta:getId()
end

function AchivementData:getTitle()
    return self._achiveMeta:getTitle()
end

function AchivementData:getDes()
    return self._achiveMeta:getDes()
end

function AchivementData:getKind()
    return self._achiveMeta:getKind()
end

function AchivementData:getJob()
    return self._achiveMeta:getJob()
end

function AchivementData:getSex()
    return self._achiveMeta:getSex()
end

function AchivementData:getTabType()
    return self._achiveMeta:getTabType()
end

function AchivementData:getTabTypeTitle()
    return self._achiveMeta:getTabTypeTitle()
end

function AchivementData:getAward()
    return self._achiveMeta:getAward()
end

function AchivementData:getItemAwardArr()
    return self._achiveMeta:getItemAwardArr()
end

--  --------------------------------

function AchivementData:getIcon()
    if not self._achiveTitleMeta then
        return ""
    end
    return self._achiveTitleMeta:getIcon()
end

function AchivementData:getTitleName()
    if not self._achiveTitleMeta then
        return ""
    end
    return self._achiveTitleMeta:getTitle()
end

-- -------------------------------------

function AchivementData:setAchivementMeta(meta)
    self._achiveMeta = meta
end

function AchivementData:getAchivementMeta()
    return self._achiveMeta
end

function AchivementData:setActiveTitleMeta(meta)
    self._achiveTitleMeta = meta
end

function AchivementData:getAchiveTitleMeta()
    return self._achiveTitleMeta
end

return AchivementData

