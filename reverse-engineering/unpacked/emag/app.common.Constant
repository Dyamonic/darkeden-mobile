function Constant:getMonsterWalkSpeed(direction)
    local speed = lt.Constant.MONSTER_WALK_SPEED

    if direction == lt.Constant.DIRECTION_UP or direction == lt.Constant.DIRECTION_DOWN then
        return speed
    elseif direction == lt.Constant.DIRECTION_LEFT or direction == lt.Constant.DIRECTION_RIGHT then
        -- return speed * 2
        return speed*Constant.SPEED_HORIZONTAL_VERTICAL_SCALE_FACTOR
    elseif direction == lt.Constant.DIRECTION_LEFT_UP or direction == lt.Constant.DIRECTION_LEFT_DOWN or
           direction == lt.Constant.DIRECTION_RIGHT_UP or direction == lt.Constant.DIRECTION_RIGHT_DOWN then
        -- return speed * 2.236
        return speed * Constant.SPEED_OBLIQUELY_SCALE_FACTOR
    end
end

function Constant:getMonsterWalkSpeedByTime(direction, time)
    local speed = (Constant.MONSTER_WALK_SPEED)/time
    if direction == Constant.DIRECTION_UP or direction == Constant.DIRECTION_DOWN then
        return speed
    elseif direction == Constant.DIRECTION_LEFT or direction == Constant.DIRECTION_RIGHT then
        return speed * Constant.SPEED_HORIZONTAL_VERTICAL_SCALE_FACTOR
    elseif direction == Constant.DIRECTION_LEFT_UP or direction == Constant.DIRECTION_LEFT_DOWN or
           direction == Constant.DIRECTION_RIGHT_UP or direction == Constant.DIRECTION_RIGHT_DOWN then
        return speed * Constant.SPEED_OBLIQUELY_SCALE_FACTOR
    end
end

function Constant:getStateBackSpeed(direction)
    local speed = lt.Constant.STATE_BACK_SPEED
    local stateBackSpeed = lt.CacheManager:getVariableById(Constant.Variable.StateBackSpeed, true)
    if stateBackSpeed and stateBackSpeed > 0 then
        speed = stateBackSpeed
    end

    if direction == lt.Constant.DIRECTION_UP or direction == lt.Constant.DIRECTION_DOWN then
        return speed
    elseif direction == lt.Constant.DIRECTION_LEFT or direction == lt.Constant.DIRECTION_RIGHT then
        return speed*Constant.SPEED_HORIZONTAL_VERTICAL_SCALE_FACTOR
    elseif direction == lt.Constant.DIRECTION_LEFT_UP or direction == lt.Constant.DIRECTION_LEFT_DOWN or
           direction == lt.Constant.DIRECTION_RIGHT_UP or direction == lt.Constant.DIRECTION_RIGHT_DOWN then
        -- return speed * 2.236
        return speed * Constant.SPEED_OBLIQUELY_SCALE_FACTOR
    end
end

-- 自定义UI相关
function Constant:getSkillBtnIdAndCount(job)
    if job == lt.Constant.JOB_ZS then
        -- 战士
        return 3101, 16
    elseif job == lt.Constant.JOB_FS then
        -- 法师
        return 3201, 25
    else
        -- 道士
        return 3301, 22
    end
end

function Constant:isSkillButton(btnId)
    return btnId >= 3000 and btnId <= 3999
end

function Constant:calcSkillId(btnId)
    return (btnId % 1000) * 100
end

function Constant:calcBtnId(skillId)
    return skillId / 100 + 3000
end

