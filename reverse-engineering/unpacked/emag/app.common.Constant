Constant.SPEED_HORIZONTAL_VERTICAL_SCALE_FACTOR = 2 -- 速度左右方向相对于上下的比例
Constant.SPEED_OBLIQUELY_SCALE_FACTOR = 2.236       -- 速度45度角方向相对于上下的比例  根号24^2+48^
function Constant:getHeroRunSpeed(direction)
    local speed = lt.Constant.HERO_RUN_SPEED

    if direction == lt.Constant.DIRECTION_UP or direction == lt.Constant.DIRECTION_DOWN then
        return speed
    elseif direction == lt.Constant.DIRECTION_LEFT or direction == lt.Constant.DIRECTION_RIGHT then
        return speed*Constant.SPEED_HORIZONTAL_VERTICAL_SCALE_FACTOR
    elseif direction == lt.Constant.DIRECTION_LEFT_UP or direction == lt.Constant.DIRECTION_LEFT_DOWN or
           direction == lt.Constant.DIRECTION_RIGHT_UP or direction == lt.Constant.DIRECTION_RIGHT_DOWN then
        return speed * Constant.SPEED_OBLIQUELY_SCALE_FACTOR
    end
end

