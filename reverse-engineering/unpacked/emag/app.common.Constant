function Constant:isUseManyItem(kind)
    local ret = false
    if kind == Constant.ITEM_KIND.kind_heartExp 
    or kind == Constant.ITEM_KIND.kind_package 
    or kind == Constant.ITEM_KIND.kind_reputation 
    or kind == Constant.ITEM_KIND.kind_yuanqi 
    or kind == Constant.ITEM_KIND.kind_exchange 
    or kind == Constant.ITEM_KIND.kind_expdan then
        ret = true
    end
    return ret
end


function Constant:getMapObj(code)
    code = tonumber(code)
    if not code then return "" end
    return Constant.MAP_RES_KEY_VALUE[code] or ""
end

