    elseif direction == lt.Constant.DIRECTION_LEFT_UP or direction == lt.Constant.DIRECTION_LEFT_DOWN or
           direction == lt.Constant.DIRECTION_RIGHT_UP or direction == lt.Constant.DIRECTION_RIGHT_DOWN then
