Constant.CC_SCENWIDTH = 1386
function Constant:GetLiuHaiX()
    -- if device.platform == "android" and cpp.GamePlatform.getAdjustNotchScreenHeight then
    --     -- local h = cpp.GamePlatform:getAdjustNotchScreenHeight()
    --     -- lt.LogUtil:debugTable("test liuhai height  = "..tostring(h))
    --     -- return tonumber(h) or 0
    --     return 0
    -- end

    --只有是全面屏 刘海屏的时候才返回不等于0的值
    local dirSize = cc.Director:getInstance():getWinSize()
    if dirSize.width/dirSize.height > 2.03 then
        local x = (Constant.CC_SCENWIDTH-1280)/2;
        return x;
    end

    return 0;
end

