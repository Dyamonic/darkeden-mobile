
local EquipEnchantingDao = {}

function EquipEnchantingDao:query(maxlv, curlv)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM EquipEnchanting WHERE MaxLevel=%d and Level=%d;", maxlv, curlv)) do
        local equipEnchant = lt.EquipEnchantingMeta.new(row)
        return equipEnchant
    end
end

function EquipEnchantingDao:queryAll()
    local equipEnchantTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM EquipEnchanting") do
        local equipEnchant = lt.EquipEnchantingMeta.new(row)
        equipEnchantTable[equipEnchant:getMaxLevel().."_"..equipEnchant:getLevel()] = equipEnchant
    end
    return equipEnchantTable
end

return EquipEnchantingDao
