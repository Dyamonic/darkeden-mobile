---@class UICompTeamMyCell
---
local UICompTeamMyCell = class("UICompTeamMyCell",lt.UICompBase, lt.UICompChangeSkin)

UICompTeamMyCell.ChangeSkinConf = {
    ["Team"] = {
        ["img_bg"] = "bg_zuduixitong_liebiaoxiao",
        ["img_bgown"] = "bg_zuduixitong_liebiaoxiaoliang",
        ["loader_frame"] = "bg_zuduixitong_touxiangkuang",
    },
    ["CommonTL"] = {
        ["btn_kick"] = {bg = "sort"},
    }
}

local TeamModule = lt.TeamModule
local GameModule = lt.GameModule
local CommonModule = lt.CommonModule
local NtfManager = lt.NtfManager

function UICompTeamMyCell:ctor()
    UICompTeamMyCell.super.ctor(self)
    --UI
    self._nameLabel = nil
    self._levelLabel = nil
    self._jobLoader = nil
    self._guildLabel = nil
    self._gradeLabel = nil
    self._kickBtn = nil
    self._selectImg = nil
    self._starImg = nil
    self._bgOwnImg = nil
    self._bgImg = nil
    --数据
    self._playerInfo = nil
end

function UICompTeamMyCell:onClear()
    --UI
    self._nameLabel = nil
    self._levelLabel = nil
    self._jobLoader = nil
    self._guildLabel = nil
    self._gradeLabel = nil
    self._kickBtn = nil
    self._selectImg = nil
    self._starImg = nil
    self._bgOwnImg = nil
    self._bgImg = nil
    --数据
    self._playerInfo = nil
    UICompTeamMyCell.super.onClear(self)
end

function UICompTeamMyCell:onEnter()
    UICompTeamMyCell.super.onEnter(self)
    self._kickBtn:addClickListener(handler(self, self.onKickBtnClick))
    self._bgImg:addClickListener(handler(self, self.onDetailBtnClick))
end
function UICompTeamMyCell:onExit()
    self._kickBtn:removeClickListener()
    self._bgImg:removeClickListener()
    UICompTeamMyCell.super.onExit(self)
end

function UICompTeamMyCell:onConstruct()
    self:startSkin()
    self._nameLabel = self:getChild("label_name")
    self._levelLabel = self:getChild("label_level")
    self._jobLoader =  self:getChild("loader_job")
    self._guildLabel = self:getChild("label_guild")
    self._gradeLabel = self:getChild("label_grade")
    self._kickBtn = self:getChild("btn_kick")
    self._selectImg = self:getChild("img_select")
    self._starImg = self:getChild("img_star")
    self._bgOwnImg = self:getChild("img_bgown")
    self._bgImg = self:getChild("img_bg")
end

function UICompTeamMyCell:setInfo(playerInfo, isLeader)
    self._nameLabel:setText(playerInfo.playerName)
    local isAdvanve = playerInfo.advanceState
    if isAdvanve == lt.Constant.AdvState.NotAdv then
        local level = playerInfo.level or 0
        self._levelLabel:setText("Lv."..level)
    else
        local level = playerInfo.advanceLv or 1
        self._levelLabel:setText("Av."..level)
    end
    self._jobLoader:setURL(string.format(_GURL.GetImageJob, playerInfo.iconId))
    self._guildLabel:setText(playerInfo.guildName)
    self._gradeLabel:setText(playerInfo.gradeLevel)
    local leaderInfo = isLeader
    self._starImg:setVisible(leaderInfo.playerId == playerInfo.playerId)
    local playerId = GameModule:getHeroData():getPlayerId()
    self._kickBtn:setVisible(leaderInfo.playerId == playerId and playerInfo.playerId ~= playerId)
    self._bgImg:setVisible(playerInfo.playerId ~= playerId)
    self._bgOwnImg:setVisible(playerInfo.playerId == playerId)
    
    --改变字的颜色和透明度
    local color = (leaderInfo.playerId == playerInfo.playerId) and cc.c3b(221,164,17) or cc.c3b(255,255,255)
    local isOnline = playerInfo.online == CommonModule:GetNetCmdEnum("ON_OFF_LINE_ONLINE_ENUM")
    self._nameLabel:setAlpha(isOnline and 1 or 0.5)
    self._nameLabel:setColor(color)
    self._levelLabel:setAlpha(isOnline and 1 or 0.5)
    self._levelLabel:setColor(color)
    self._guildLabel:setAlpha(isOnline and 1 or 0.5)
    self._guildLabel:setColor(color)
    self._gradeLabel:setAlpha(isOnline and 1 or 0.5)
    self._gradeLabel:setColor(color)

    self._playerInfo = playerInfo
end

function UICompTeamMyCell:setSelected(select)
    self._selectImg:setVisible(select)
end

function UICompTeamMyCell:onKickBtnClick()
    local str = string.format(GReadText.KEY_TEAM_HALL_TIPS20, "[color=#00ff00]"..self._playerInfo.playerName.."[/color]")
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {type = 2, content = str, confirmCallback = function()
        TeamModule:sendKickTeam(self._playerInfo)
    end})
end

--角色详细信息
function UICompTeamMyCell:onDetailBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MY_TEAM_SELECT, {data = self})
end

return UICompTeamMyCell