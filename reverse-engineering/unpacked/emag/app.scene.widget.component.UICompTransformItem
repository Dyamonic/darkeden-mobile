---@class UICompTransformItem
---
local UICompTransformItem = class("UICompTransformItem", lt.UIGButtonBase, lt.UICompChangeSkin)

UICompTransformItem.ChangeSkinConf = {
    ["Team"] = {
        ["n1"] = "bg_zuduixitong_yeqiandi02",
    },
}

function UICompTransformItem:ctor()
    UICompTransformItem.super.ctor(self)
    --UI
    self._titleText = nil
    self._controller = nil
    --数据
    self._meta = nil
end

function UICompTransformItem:onClear()
    --UI
    self._titleText = nil
    self._controller = nil
    --数据
    self._meta = nil
end

function UICompTransformItem:onConstruct()
    self:startSkin()
    self._titleText = self:getChild("title")
    self._controller = self:getController("button")
end

function UICompTransformItem:setInfo(meta)
    self._meta = meta
    self._titleText:setText(GReadText.KEY_STRENGTHEN_TIPS79..meta:getTransformType())
end

function UICompTransformItem:setSelect(select)
    self._controller:setSelectedIndex(select and 1 or 0)
end

function UICompTransformItem:getMeta()
    return self._meta
end

return UICompTransformItem