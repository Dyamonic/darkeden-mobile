local AchievementDao = {}

function AchievementDao:queryAll()
    local table = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Achievement")) do
        local meta = lt.AchievementMeta.new(row)
        table[meta:getId()] = meta
    end
    return table
end

return AchievementDao
