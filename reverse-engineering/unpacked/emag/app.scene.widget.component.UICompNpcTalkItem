---@class UICompNpcTalkItem npc单个回复
---
local UICompNpcTalkItem = class("UICompNpcTalkItem", lt.UIGButtonBase)

local Constant = lt.Constant

function UICompNpcTalkItem:ctor()
    UICompNpcTalkItem.super.ctor(self)

    --UI
    self._text = nil
    self._btn = nil
    self._btnEffect = nil
    --数据
    self._curIndex = nil
    self._callback = nil
end

function UICompNpcTalkItem:onClear()
    --UI
    self._text = nil
    self._btn = nil
    self._btnEffect = nil
    --数据
    self._curIndex = nil
    self._callback = nil

    UICompNpcTalkItem.super.onClear(self)
end

function UICompNpcTalkItem:onConstruct()
    self._text = self:getChild("text")
    self._btn = self:getChild("btn")
    self._btnEffect = self:getController("btnEffect")
    
end

function UICompNpcTalkItem:onEnter()
    self._btn:addEventListener(fgui.UIEventType.TouchBegin, handler(self, self.onTouchBegain));
    self._btn:addEventListener(fgui.UIEventType.TouchEnd, handler(self, self.onTouchEnd));
    self._btn:addClickListener(handler(self, self.onTouchEndClick))
end

function UICompNpcTalkItem:onExit()
    self._btn:removeEventListener(fgui.UIEventType.TouchBegin);
    self._btn:removeEventListener(fgui.UIEventType.TouchEnd);
    self._btn:removeClickListener()
end

function UICompNpcTalkItem:setObjInfo(info)
    self._text:setText(info.content)
    self._curIndex = info.index
    self._btn:setWidth(self._text:getWidth())
    self._callback = info.callback
end

function UICompNpcTalkItem:onTouchBegain(context)
    self._btnEffect:setSelectedIndex(1)
    context:captureTouch()
end

function UICompNpcTalkItem:onTouchEnd(context)
    self._btnEffect:setSelectedIndex(0)
end

function UICompNpcTalkItem:onTouchEndClick(context)
    self._btnEffect:setSelectedIndex(0)
    --FIXME 暂时延迟一帧处理,后续排查闪退
    lt.ScheduleUtil:performWithDelayGlobal(function()
        if self._callback then
            self._callback(self._curIndex)
        end
    end, 0)
end

return UICompNpcTalkItem