--- 菜单界面
---@class UIWndExit:UIWindowBase
local UIWndExit          = class("UIWndExit", lt.UIWindowBase)

local NtfManager = lt.NtfManager
local SocketApi = lt.SocketApi
local AutoFightManager = lt.AutoFightManager
local RoleModule = lt.RoleModule

UIWndExit.ChangeSkinConf = {
    ["Main"] = {
        ["img_di"] = "bg_caidan_dikuang",
    },
    ["CommonTL"] = {
        ["btn_close"] = { bg = "bg_beibao_anniu01", bgup = "bg_beibao_anniu02" },
    }
}

function UIWndExit:ctor(param)
    UIWndExit.super.ctor(self, param)
end

function UIWndExit:onClear()
    UIWndExit.super.onClear(self)
end

function UIWndExit:onInit()
    UIWndExit.super.onInit(self, _GURL.UIWndExit)
end

function UIWndExit:onShown()
    self:getChild("btn_usersetting"):addClickListener(handler(self, self.onUserSettingClick))
    self:getChild("btn_changecode"):addClickListener(handler(self, self.onChangeCodeClick))
    self:getChild("btn_exitgame"):addClickListener(handler(self, self.onExitGameClick))
    self:getChild("btn_close"):addClickListener(handler(self, self.onLayerClick))
end

function UIWndExit:onHide()
    
    self:getChild("btn_usersetting"):removeClickListener()
    self:getChild("btn_changecode"):removeClickListener()
    self:getChild("btn_exitgame"):removeClickListener()
    self:getChild("btn_close"):removeClickListener()
    UIWndExit.super.onHide(self)
end

function UIWndExit:onEnter()
    UIWndExit.super.onEnter(self)
end

function UIWndExit:onExit()
    UIWndExit.super.onExit(self)
end


function UIWndExit:onUserSettingClick()
    if (device.platform == "ios" or device.platform == "android") and cpp.SdkService:shared().showFloat then
        cpp.SdkService:shared():showFloat()
    end
end

function UIWndExit:onChangeCodeClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_RENAME_GIFTCODE_BOX,{open = true})
end

function UIWndExit:onExitGameClick()
    self:exitGame()
end

function UIWndExit:onLayerClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndExit", close = true })
end

--退出游戏
function UIWndExit:exitGame()
    if SocketApi:isAlive() then
        --停止挂机
        AutoFightManager:endAutoFight()
        local roleName = RoleModule:getCurRoleName()
        SocketApi:reselRole(roleName)
    else
        RoleModule:clear()
        if _G_Game then
            _G_Game:resetScene()
        end
    end
end

return UIWndExit
