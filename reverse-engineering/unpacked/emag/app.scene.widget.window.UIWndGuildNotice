function UIWndGuildNotice:ctor(param)
    UIWndGuildNotice.super.ctor(self, param)
end

function UIWndGuildNotice:onClear()
    self._bgKuang = nil
    self._lblMsg  = nil
    self._input   = nil
    self._btnSure = nil
    UIWndGuildNotice.super.onClear(self)
end

function UIWndGuildNotice:onShown()
    self._btnSure:addClickListener(handler(self, self.onBtnFncSureClick))
    self:onFreshUI()
end

function UIWndGuildNotice:onHide()
    self._btnSure:removeClickListener()
    UIWndGuildNotice.super.onHide(self)
end

function UIWndGuildNotice:onInit()
    UIWndGuildNotice.super.onInit(self, _GURL.GuildNoticePanel)
    self._btnSure = self:getChild("btn_sure")
    self._bgKuang = self:getChild("bg_kuang")
    self._lblMsg  = self:getChild("txt")

    self:initCocosInputUI()
end

function UIWndGuildNotice:onFreshUI()
    local msg = self:getParam().noticeText or ""
    local type = self:getParam().type -- 1 公会公告 2 个人简介
    if type == GuildModule.NOTICE_TYPE.GUILD_NOTICE and msg == "" then
        msg = GuildModule.initNotice
    end
    self._lblMsg:setText(msg)
    local GuildNoticeLength = CacheManager:getVariableById(Constant.Variable.GuildNoticeLength) or 0
    local GuildMemberNoticeLength = CacheManager:getVariableById(Constant.Variable.GuildMemberNoticeLength) or 0
    self._count = (type == GuildModule.NOTICE_TYPE.GUILD_NOTICE) and tonumber(GuildNoticeLength) or
        tonumber(GuildMemberNoticeLength)
end

function UIWndGuildNotice:initCocosInputUI()
    if not self._input then
        self._input = ccui.EditBox:create(cc.size(539, 182), "", ccui.TextureResType.localType)
        self._input:setAnchorPoint(cc.p(0, 0))
        self._input:setPosition(15, 20)
        self._input:setFontName(Constant.FONT_4)
        self._input:setFontSize(22)
        self._input:setReturnType(cc.KEYBOARD_RETURNTYPE_SEND)
        self._input:setInputMode(cc.EDITBOX_INPUT_MODE_ANY)
        self._input:registerScriptEditBoxHandler(handler(self, self.editBoxEvent))
        self._bgKuang:displayObject():addChild(self._input)
    end
end

function UIWndGuildNotice:editBoxEvent(eventType, sender)
    if eventType == "began" then
        local str = self._lblMsg:getText()
        sender:setText(str)
        self._lblMsg:setText("")
    elseif eventType == "ended" then
        local str = self._input:getText()
        self._input:setText("")
        self._lblMsg:setText(str)
    elseif eventType == "changed" then
        local str = sender:getText()
        str = string.gsub(str, " ", "") --过滤掉空格
        -- str = CommonUtil:rmSpecChars(str)
        local count = string.len(str)
        local reCount = 0
        local beginIndex = -1
        local reString = ""
        for i = 1, count do
            local s = string.sub(str, i, i)
            local t = string.byte(s)
            if t < 128 then
                reCount = reCount + 1 --1字节文字，长度加1
            elseif t >= 192 then
                reCount = reCount + 2 --1字节以上文字，长度加2
            end
            if reCount > self._count then
                beginIndex = i - 1
                break
            end
            beginIndex = i
        end
        reString = string.sub(str, 1, beginIndex)
        sender:setText("")
        self._input:setText(reString)
    elseif eventType == "return" then
    end
end

function UIWndGuildNotice:onBtnFncSureClick(obj)
    local guildNotice = self._lblMsg:getText()

    if guildNotice == "" then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = GReadText.KEY_CHAT_TIPS2 })
        return
    end

    guildNotice = MaskWordUtil:process(guildNotice, "**")
    guildNotice = string.gsub(guildNotice, "[\n\r]", '')

    local type = self:getParam().type -- 1 公会公告 2 个人简介

    --true玩家公告 false公会公告
    local player = type ~= GuildModule.NOTICE_TYPE.GUILD_NOTICE
    GuildModule:sendGuildSetNoticeReq(guildNotice, player)
end

return UIWndGuildNotice
