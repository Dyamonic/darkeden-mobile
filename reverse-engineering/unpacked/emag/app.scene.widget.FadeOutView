
local FadeOutView = class("FadeOutView", function()
    return display.newSprite("ui/common/img_black.png")
end)

function FadeOutView:ctor(callback)
    self:enableNodeEvents()

    self:setOpacity(0)
    self:setScale(50)
    self:setAnchorPoint(0.5, 0.5)
    self:setPosition(display.cx, display.cy)
    self:setAnchorPoint(0.5, 0.5)
    self:setPosition(display.cx, display.cy)
    self:setLocalZOrder(999999999)
 
    local action = cc.Sequence:create(cc.FadeIn:create(0.3), cc.DelayTime:create(0.3), cc.CallFunc:create(function() 
        self:removeSelf()

        callback()
    end))
    self:runAction(action)
end

function FadeOutView:onCleanup()
    self:stopAllActions()
end

return FadeOutView
