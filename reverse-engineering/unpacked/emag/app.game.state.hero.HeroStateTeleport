--- 瞬间移动
local HeroStateTeleport = class("HeroStateTeleport", lt.HeroStateBase)

local MapUtil = lt.MapUtil
local AgentManager = lt.AgentManager
local Constant = lt.Constant
local SkillEnum = lt.SkillEnum
local CacheManager = lt.CacheManager
local ScheduleUtil = lt.ScheduleUtil

-- 目标位置
HeroStateTeleport._mTarget       = nil
HeroStateTeleport._nTarget       = nil
HeroStateTeleport._xTarget       = nil
HeroStateTeleport._yTarget       = nil

-- hero位置
HeroStateTeleport._mHeroX = nil
HeroStateTeleport._mHeroY = nil

--[[
    技能: 瞬间移动
]]

function HeroStateTeleport:ctor(heroAgent, mTarget, nTarget, skillId, needDisappear, targetObjId, knockedTarget)
    HeroStateTeleport.super.ctor(self, heroAgent)
    self._skillId = skillId
    self._visibleFlag = false
    self._moveEffect = nil
    self._targetObjId = targetObjId
    self._knockedTarget = knockedTarget
    self:initMove(mTarget, nTarget)
end

function HeroStateTeleport:onClear()
                            
    HeroStateTeleport.super.onClear(self)
end

function HeroStateTeleport:initMove(mNext, nNext)
    -- hero 目标格子位置
    self._mTarget = mNext
    self._nTarget = nNext
    self._heroActor = self._heroAgent:getActor()

    -- 转换坐标
    self._xTarget, self._yTarget = MapUtil:calcMNMid(self._mTarget, self._nTarget)

    -- 设置方向
    local xHero, yHero = self._heroAgent:getPosition()

    -- 换算方向
    local direction = MapUtil:calcDirectionXY(self._xTarget - xHero, self._yTarget - yHero)
    self._heroAgent:setDirection(direction)
    self._mHeroX = xHero
    self._mHeroY = yHero
    if self._skillId == SkillEnum.SKILL_BOMB_CRASH_WALK then -- 由于服务器协议先出现jump包，然后再同步攻击包，技能实现放在jump里
        self:createPriveousEffect()
    end

    -- 修改MapAgent的AgentSystem
    local mapAgent = AgentManager:getWorldAgent():getMapAgent()
    mapAgent:changeAgentMN(self._heroAgent, self._mTarget, self._nTarget)
    self._moveTime = 0.5
    -- 播放平移动画
    -- self._heroAgent:playAction(Constant.ROLE_ACTION_MOVE)
    if self._skillId == SkillEnum.SKILL_TELEPORT then
        self:createActorMoveAction()
    elseif self._skillId == SkillEnum.SKILL_BOMB_CRASH_WALK then 
        self:createCrashWalkAction()
    elseif self._skillId == SkillEnum.SKILL_DUCKING_WALLOP then
        self:createDuckingAction()
    elseif self._skillId == SkillEnum.SKILL_CHARGING_ATTACK then
        self:createChargingAttack()
    end
end

function HeroStateTeleport:getMapActor()
    local worldAgent = AgentManager:getWorldAgent()
    if not worldAgent then
        return nil
    end

    local mapAgent = worldAgent:getMapAgent()
    if not mapAgent then
        return nil
    end

    local mapActor = mapAgent:getMapActor()
    if not mapActor then
        return nil
    end

    return mapActor
end

function HeroStateTeleport:createChargingAttack()
    local skillId = SkillEnum.SKILL_CHARGING_ATTACK
    local startPos = cc.p(self._heroActor:getPosition())
    local time = math.sqrt((self._yTarget-startPos.y)^2 + (self._xTarget-startPos.x)^2)/600
    local skillMeta = CacheManager:getProcessMetas(skillId,1)
    local step = 0.05
    if skillMeta[1] and skillMeta[1]:getStep() then
        step = skillMeta[1]:getStep()/1000
    end
    local function startEffect()
        -- self._heroActor:hideSprite()
        self._visibleFlag = true
        local direction = self._heroAgent:getDirection()
        if skillMeta[1] then
            self._moveEffect = lt.BullectScreenEffect.new(skillId, direction,cc.p(startPos.x - 25, startPos.y + 15))
            self._moveEffect:addEffect(skillId, skillMeta[1])
            lt.BulletManager:addBulletToMap(self._moveEffect, 1151)
        end
        -- self._heroAgent:playParallelEffectByLv(skillId, 1, Constant.EFFECT.PROCESS)
        -- lt.SkillManager:playParallelEffectByLv(skillId,self._heroAgent:getAgentId(),1,Constant.EFFECT.PROCESS)
    end

    local function endEffect()
        self._moveEffect = nil
        -- self._heroActor:showSprite()
        self._heroAgent:setPosition(self._xTarget, self._yTarget)
        self._heroAgent:changeState(lt.HeroStateIdle.new(self._heroAgent))
    end

    startEffect()
    ScheduleUtil:performWithDelayGlobal(function()
        endEffect()
    end, 17*step)
    self._moveTime = time
end

function HeroStateTeleport:createDuckingAction()
    local skillId = SkillEnum.SKILL_DUCKING_WALLOP
    local metas = CacheManager:getProcessMetas(skillId)
    local startPos = cc.p(self._heroActor:getPosition())
    local function startEffect()
        -- self._heroAgent:visibleActor(false)
        self._visibleFlag = true
        local direction = self._heroAgent:getDirection()
        for _,meta in ipairs(metas) do
            local bullet = lt.BullectScreenEffect.new(skillId, direction, cc.p(startPos.x - 25, startPos.y + 15))
            bullet:addEffect(skillId, meta)
            lt.BulletManager:addBulletToMap(bullet, 1151)
        end
    end

    local function endEffect()
        -- self._heroAgent:visibleActor(true)
        self._heroAgent:setPosition(self._xTarget, self._yTarget)
        self._heroAgent:changeState(lt.HeroStateIdle.new(self._heroAgent))
    end

    startEffect()
    ScheduleUtil:performWithDelayGlobal(function()
        endEffect()
    end, 0.5)
    self._moveTime = 0.5
end

function HeroStateTeleport:createActorMoveAction()
    local targetPos = cc.p(self._xTarget, self._yTarget)

    local skillId = SkillEnum.SKILL_TELEPORT
    -- 播放特效 1为目标对象
    local metas = CacheManager:getProcessMetas(skillId)

    local startPos = cc.p(self._heroActor:getPosition())

    local startMeta = {metas[1], metas[3]}
    local endMeta = {metas[2], metas[4]}
    local function startEffect()
       
        local direction = self._heroAgent:getDirection()
        ScheduleUtil:performWithDelayGlobal(function()
            self._heroAgent:visibleActor(false)
            self._visibleFlag = true
        end,0.05)

        for _,meta in ipairs(startMeta) do
            local bullet = lt.BullectScreenEffect.new(skillId, direction, cc.p(startPos.x - 24, startPos.y + 12))
            bullet:addEffect(skillId, meta)
            lt.BulletManager:addBulletToMap(bullet, 1151)
        end
    end

    local function endEffect()
        -- self._heroAgent:setPosition(self._xTarget, self._yTarget)
        if not self._heroAgent then
            return
        end
        local direction = self._heroAgent:getDirection()
        for _, meta in ipairs(endMeta) do
            local delayTime = meta:getDelayFrame() / 1000
            ScheduleUtil:performWithDelayGlobal(function()
                local bullet = lt.BullectScreenEffect.new(skillId, direction, cc.p(targetPos.x - 24, targetPos.y + 12))
                bullet:addEffect(skillId, meta)
                lt.BulletManager:addBulletToMap(bullet, 1151)
            end, delayTime)
        end

        ScheduleUtil:performWithDelayGlobal(function()
            if self._heroAgent then
                self._heroAgent:visibleActor(true)
                self._heroAgent:changeState(lt.HeroStateIdle.new(self._heroAgent))
            end
        end, 0.9)
       
    end

    startEffect()
    ScheduleUtil:performWithDelayGlobal(function()
        endEffect()
    end, 0.05)

    self._moveTime = 0.135
end

function HeroStateTeleport:createPriveousEffect()
    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then 
        return 
    end
    local targetAgent =  worldAgent:getAgent(self._targetObjId)
    if not targetAgent then
        return 
    end
    local targetAgentId = targetAgent:getAgentId()
    lt.SkillManager:playBombCrashWalk(self._skillId, self._heroAgent:getAgentId(), targetAgentId)
end

function HeroStateTeleport:createCrashWalkAction()
    self._visibleFlag = true
    self._moveTime = 0.25
end

function HeroStateTeleport:onEnter()
end

function HeroStateTeleport:onExit()
    -- 急行幻影效果
    self._heroAgent:hideRushSprite()
end

function HeroStateTeleport:onUpdate()

    if not self._visibleFlag then
        return 
    end
    if not self._moveTime then
        return
    end

    if self.isEnd then
        return
    end

    local directionV = cc.pSub(cc.p(self._xTarget, self._yTarget), cc.p(self._mHeroX, self._mHeroY))

    if not self._step then
        self._step =  math.sqrt((self._xTarget-self._mHeroX)^2 + (self._yTarget-self._mHeroY)^2)/self._moveTime*lt.GameBoard:getDeltaTime()
    end
    local step = self._step
    if cc.pGetLength(directionV) < step then
        self.isEnd = true
        -- 到达
        self._heroAgent:setPosition(self._xTarget, self._yTarget)
        if self._moveEffect then
            self._moveEffect:setPosition(self._xTarget, self._yTarget)
        end
        if self._skillId == SkillEnum.SKILL_TELEPORT then
            return
        end
        if self._skillId == SkillEnum.SKILL_CHARGING_ATTACK then
            return
        end
        if self._skillId == SkillEnum.SKILL_BOMB_CRASH_WALK then
            self._heroAgent:changeState(lt.HeroStateTeleportResult.new(self._heroAgent, self._mTarget, self._nTarget, self._skillId, self._targetObjId, self._knockedTarget))
            return 
        end
        self._heroAgent:changeState(lt.HeroStateIdle.new(self._heroAgent))
        return
    else
        -- 未到
        directionV = cc.pMul(cc.pNormalize(directionV), step)
        self._mHeroX = self._mHeroX + directionV.x
        self._mHeroY = self._mHeroY + directionV.y
        self._heroAgent:setPosition(self._mHeroX, self._mHeroY)
        if self._moveEffect then
            self._moveEffect:setPosition(self._mHeroX, self._mHeroY)
        end
    end
end

function HeroStateTeleport:onMessage(msg)
end

function HeroStateTeleport:getStateId()
    return Constant.HERO_STATE_TELEPORT
end

function HeroStateTeleport:getStateName()
    return "HeroStateTeleport"
end

return HeroStateTeleport