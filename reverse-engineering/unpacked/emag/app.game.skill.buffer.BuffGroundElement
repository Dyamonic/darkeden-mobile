local BuffGroundElement = class("BuffGroundElement", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local Constant = lt.Constant
local CacheManager = lt.CacheManager
local BullectScreenQueueEffect = lt.BullectScreenQueueEffect
local BulletManager = lt.BulletManager
local BULLET_OFFSET_X = -25
local BULLET_OFFSET_Y = 15
--[[
    土精灵光环
]]
function BuffGroundElement:ctor(time, actor, skilllevel,source, buffId)    
    BuffGroundElement.super.ctor(self, buffId, time, actor)
    self._skillId = SkillEnum.SKILL_SUMMON_OF_GROUND_ELEMENTAL
    -- local metas = CacheManager:getBuffMetas(self._skillId)
    -- actor:playSoleQueueSpecail(self._skillId,metas)
    local agent = self._actor:getAgent()
    local reX, reY = agent:getPosition()
    local bullet = BullectScreenQueueEffect.new(self._skillId, 0, cc.p(reX + BULLET_OFFSET_X, reY + BULLET_OFFSET_Y))
    local zorder = -100
    BulletManager:addBulletToMapZOrder(bullet, zorder)
    self._bulletID = bullet:getBulletId()
end

function BuffGroundElement:onClear()
    local bullect = BulletManager:getBulletById(self._bulletID)
    bullect:stopQueueEffect(self._skillId)
    lt.ScheduleUtil:performWithDelayGlobal(function()
        if bullect then
            bullect:setWaitingForClear(true)
        end
    end, 0.1)
    self._skillId = nil
    BuffGroundElement.super.onClear(self)
end

return BuffGroundElement
