
local CmdIdle = class("CmdIdle", lt.CmdBase)

CmdIdle._m         = nil
CmdIdle._n         = nil
CmdIdle._direction = nil

function CmdIdle:ctor(m, n, direction)
    CmdIdle.super.ctor(self, lt.Constant.CmdId.CMD_IDLE)

    self._m           = m
    self._n           = n
    self._direction   = direction
end

-- Setter && Getter
function CmdIdle:getM()
    return self._m
end

function CmdIdle:getN()
    return self._n
end

function CmdIdle:getDirection()
    return self._direction
end

return CmdIdle
