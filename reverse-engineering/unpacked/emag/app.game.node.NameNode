    --[[ 个人设置 血条显示
    if self._nameNodeType ~= Constant.NameNodeType.HERO_SELF and self._textHp then
        self._textHp:setVisible(lt.AutoManager:queryKey("SHOW_HP_PERCENT"))
    end
    ]]
end

