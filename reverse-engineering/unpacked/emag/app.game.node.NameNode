]]
end

function NameNode:updateTopNode(data)
    local height = 0

    --[[ 自动挂机 
    if self._hangupLabel then
        self._hangupLabel:setVisible(self._isHangup)

        if self._isHangup then
            self._hangupLabel:setPosition(8, height + 18 + self._offsetHeight)
            height = height + 32
        end
    end
    ]]
    -- 突出自己 箭头
    -- self._topExtraNode:setPosition(0, height)
end

