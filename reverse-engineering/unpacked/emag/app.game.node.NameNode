        textName:setAnchorPoint(0.5, 0.5)
        textName:setPosition(0, height)
        textName:setColor(Constant.COLOR_TEXT_WHITE_PURE)
        self._nameOffsetNode:addChild(textName)
    else
        textName = lt.UIManager:createTextNameNode(data:getName(), 12)
        textName:setAnchorPoint(0.5, 0.5)
        textName:setPosition(0, height)
        textName:setColor(lt.CommonUtil:calcColor(data:getNameColor()))
        self._nameOffsetNode:addChild(textName)
    end

    -- height = height + textName:getContentSize().height * textName:getScale() - 20
