function NameNode:getHpString(data)
    return data:getCurHp() .. " / " .. data:getMaxHp()
    
    -- if self._nameNodeType == Constant.NameNodeType.HERO_SELF then
    --     return data:getCurHp() .. " / " .. data:getMaxHp()

    -- else
    --     return string.format("%.0f/100", math.ceil(data:getCurHp() / data:getMaxHp() * 100))
    -- end
end


function NameNode:updateTitleAppr(data)
    self._offsetHeight = 0

    --[[ 头顶title特效
    if self._titleBaseAni then
        self._titleBaseAni:removeSelf()
        self._titleBaseAni = nil
    end
    if self._titleAni then
        self._titleAni:removeSelf()
        self._titleAni = nil
    end 
    ]]

    --[[
        -- 称号
    if self._nameNodeType == Constant.NameNodeType.HERO_SELF or self._nameNodeType == Constant.NameNodeType.HERO_OTHER then
        local appr = data:getTitleAppr()
        if appr ~= 0 then
            local meta = lt.CacheManager:queryAchiveTitleMetaById(appr)
            local res = meta:getIcon()

            if res and res ~= "" then
                self._titleSp:setVisible(true)
                lt.ResManager:setDisplayFrameByPath(self._titleSp, res)
                self._labTitle:setVisible(false)
            else
                self._labTitle:setVisible(true)
                self._labTitle:setString(info:getTitle())
                self._titleSp:setVisible(false)
            end
            self._offsetHeight = 30
            self:addTitleEffect(appr,self._titleSp)
        else
            self._titleSp:setVisible(false)
            self._labTitle:setVisible(false)
        end
    else
        self._titleSp:setVisible(false)
        self._labTitle:setVisible(false)
    end
    ]]

    
    -- 聊天气泡
    -- self._chatBg:setPositionY(Constant.MODEL_HERO_Y + 45 + self._offsetHeight)


    -- self:updateTopNode(data)         -- 自动挂机突出自己 暂时屏蔽 delay
end

-- 发现怪物:%s 方向:%s 坐标:(%d,%d)
function NameNode:updateFoundBoss(szText)
    --[[
    if self._foundBossLabel then
        self._foundBossLabel:setString(szText)
    end
    ]]
end

function NameNode:visibleFoundBoss(b)
    --[[
    if self._foundBossLabel then
        self._foundBossLabel:setVisible(b)
    end
    ]]
end

-- 聊天信息
function NameNode:updateChatLabel(chatInfo)
    -- 聊天气泡 更新
    if not self._chatLabel then
        return
    end
    local textTable = lt.ChatModule:filterHanhua(chatInfo) or {}
    if next(textTable) == nil then
        return
    end
    self._chatBg:setVisible(true)
    self._chatLabel:setString(textTable)
    local size = self._chatLabel:getContentSize()
    local height = size.height
    self._chatBg:setContentSize(self._chatBgWidth,height + 30)
    
    self._chatLabel:stopAllActions()
    self._chatLabel:runAction(cc.Sequence:create(cc.DelayTime:create(5), cc.CallFunc:create(function()
        self._chatBg:setVisible(false)
    end)))
end

function NameNode:updateAutoRouteTip(data)
    --[[ 自动寻路中
    local height = 0

    if self._autorouteLabel then
        if data and not lt.HangupManager:isHangup()then
            self._autorouteLabel:setVisible(true)
            self._autorouteLabel:setPosition(8, height + 18 + self._offsetHeight)
            height = height + 32
        else
            self._autorouteLabel:setVisible(false)
            height = 0
            lt.TaskModule:autoFightTask()
        end 
    end
    self._topExtraNode:setPosition(0, height)
    ]]
end

function NameNode:setNameType(type)
    self._nameNodeType = type
end

-- 更新任务箭头
function NameNode:updateTargetArrow(show)
    self._showArrow = show
    self._targetIcon:setVisible(not self._hpNode:isVisible() and self._showArrow)
end

return NameNode
