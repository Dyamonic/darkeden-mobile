function EffectManager:getEffectInfo(effectId, direction, bltType)
    local step = 0.04
    local loop = 1

    return self:getActionEffect(effectId, direction, step, loop, bltType)
end

function EffectManager:getEffectBaseInfo(effectId, direction, bltType, step, loop)
    return self:getActionEffect(effectId, direction, step, loop, bltType)
end

function EffectManager:getEffectInfos(effectInfos, direction, skillId)
    local step = lt.SkillEnum.SKILL_EFFECT_TIME
    local loop = 1
    local infoMap = {}
    for index, effectInfo in ipairs(effectInfos) do
        local effectId = effectInfo.spriteId
        local bltType = effectInfo.bltType
        if skillId and skillId == lt.SkillEnum.SKILL_HANDS_OF_WISDOM then
        --    direction = math.random(0, 7 )
           -- 智慧之触 两个effectId一致但需要随机方向
           infoMap[effectId.."_" ..index] = self:getActionEffect(effectId, direction, step, loop, bltType)
        else
            infoMap[effectId] = self:getActionEffect(effectId, direction, step, loop, bltType)
        end
    end
    
    return infoMap
end

function EffectManager:getActionEffect(effectId, direction, step, loop, bltType)
    local bltTypeName = EffectEnum.BltTypeName[bltType]
    if not direction then
       return 
    end
    local actionName =  string.format("%s_%d_%d", bltTypeName, effectId, direction)

    local effectInfo = self._effectInfoTable[actionName]
    if not effectInfo then
        effectInfo = lt.EffectView.new(effectId, direction, step, loop, bltType)
        self._effectInfoTable[actionName] = effectInfo
    else
        if not effectInfo:checkDownloadRemoteSuccess() then
            effectInfo:ReloadAtlas()
        end

        effectInfo:addUse()
    end

    return effectInfo
end


function EffectManager:getEffectData(modelId, bltType)
    local bltTypeName = EffectEnum.BltTypeName[bltType]
    local effectName = string.format("%s_%d", bltTypeName, modelId)
    local data = self._effectDataTable[effectName]
    if not data then
        data = lt.EffectData.new(modelId, bltType)
        self._effectDataTable[effectName] = data
    else
        data:addUse()
    end

    return data
end

function EffectManager:getEffectZorder(effectId,nextEffectFrameIndex,frameCount,direction)
    local zorder = 3

    if effectId == 1808  or effectId == 1818  or effectId == 1030 then
        return 1
    end

    if effectId == 968 or effectId == 978 then
        return 1
    end

    --------------------------------------------------------------------------------------------------
    -- 环绕特效
    if effectId == 719 then
        if (nextEffectFrameIndex >= 1 and nextEffectFrameIndex <= 9) or (nextEffectFrameIndex >= 16 and nextEffectFrameIndex <= 25) then
            return 1
        end

        return 3
    end

    if effectId == 720 then
        if (nextEffectFrameIndex >= 13 and nextEffectFrameIndex <= 21) or (nextEffectFrameIndex >= 29 and nextEffectFrameIndex <= 33) then
            return 1
        end

        return 3
    end

    if effectId == 721 then
        if (nextEffectFrameIndex >= 9 and nextEffectFrameIndex <= 18) or (nextEffectFrameIndex >= 26 and nextEffectFrameIndex <= 31) then
            return 1
        end

        return 3
    end

    if effectId == 722 then
        if (nextEffectFrameIndex >= 5 and nextEffectFrameIndex <= 14) or (nextEffectFrameIndex >= 22 and nextEffectFrameIndex <= 29) then
            return 1
        end

        return 3
    end
    --------------------------------------------------------------------------------------------------
    -- 对半分
    local halfPerEffectIds = {
        [249] = true,
    }

    local halfBackEffectIds = {
        [246] = true,
        [247] = true,
        [364] = true,
    }

    if effectId == 462 or effectId == 456 then
        if direction == Constant.DIRECTION_UP
        or direction == Constant.DIRECTION_RIGHT
        or direction == Constant.DIRECTION_LEFT_UP
        or direction == Constant.DIRECTION_RIGHT_UP
        or direction == Constant.DIRECTION_RIGHT_DOWN then
            halfPerEffectIds[effectId] = true
        else
            return zorder
        end
    end

    if halfPerEffectIds[effectId] or halfBackEffectIds[effectId] then
        if nextEffectFrameIndex > frameCount/2 then
            if halfPerEffectIds[effectId] then zorder = 1 end
            if halfBackEffectIds[effectId] then zorder = 3 end
        else
            if halfPerEffectIds[effectId] then zorder = 3 end
            if halfBackEffectIds[effectId] then zorder = 1 end
        end

        return zorder
    end
    --------------------------------------------------------------------------------------------------
    -- 中间后面
    -- 中间前面 TODO
    local midBackEffectIds = {
        [366] = true,
        [365] = true,
    }
    if midBackEffectIds[effectId] then
        if nextEffectFrameIndex > frameCount/4 and nextEffectFrameIndex < frameCount/4*3 then
            zorder = 3
        else
            zorder = 1
        end

        return zorder
    end

    return zorder
end

function EffectManager:getEffectOffset(effectId,direction)
    if not effectId then
       return 
    end

    local key = "getOffectXYByDirection" .. effectId
    if type(self[key]) == "function" then
        return self[key](self,direction)
    end
end

