local EffectManager = {}
local EffectEnum = lt.EffectEnum
local Constant = lt.Constant
function EffectManager:init()
    self._frameTable = {}
    self._frameLoadedTable = {}
    self._effectInfoTable = {}
    self._effectDataTable = {}
end

function EffectManager:clear()
    for _, actionInfo in pairs(self._effectInfoTable) do
        actionInfo:clear()
    end
    self._effectInfoTable = {}


    self._effectDataTable = {} -- 注意释放

    for dataFilename, frameInfo in pairs(self._frameTable) do
        display.removeSpriteFrames(dataFilename, frameInfo.imageFilename)
    end
    self._frameTable = {}
end

