
local ClientTextDao = {}

function ClientTextDao:queryAll()
    local clientTextTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM ClientText") do
        local clientText = lt.ClientTextMeta.new(row)
        clientTextTable[clientText:getKey()] = clientText:getValue()
    end

    return clientTextTable
end

return ClientTextDao
