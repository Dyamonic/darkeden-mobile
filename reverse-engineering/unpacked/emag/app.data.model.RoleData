
local RoleData = class("RoleData")

RoleData._name 	    = nil
RoleData._job     	= nil
RoleData._hair 	    = nil
RoleData._color	    = nil
RoleData._level	    = nil
RoleData._sex     	= nil
RoleData._realm	    = nil
RoleData._dltTime 	= nil
RoleData._delete 	= nil
RoleData._serverID  = nil
RoleData._creatTime = nil
RoleData._playerId  = nil
RoleData._selected  = nil  -- for del role

function RoleData:ctor()
    
end

function RoleData:addRole(roleProto)
    -- dump(roleProto)

	self._name = roleProto._szRoleName
	self._byPos = roleProto._byPos
	self._job = roleProto._byJob
	self._sex = roleProto._bySex

	---新增start
	self._faceShape = roleProto._byFaceShape
	self._hairColor = roleProto._byHairColor
	self._skinColor = roleProto._bySkinColor
	self._STR   = roleProto._wSTR
	self._DEX   = roleProto._wDEX
	self._INT   = roleProto._wINT
	self._level = roleProto._wLevel

	self._bladeLevel = roleProto._wBladeLevel
	if self._bladeLevel > self._level then
		self._level = self._bladeLevel
	end

	self._swordLevel = roleProto._wSwordLevel
	if self._swordLevel > self._level then
		self._level = self._swordLevel
	end

	self._gunLevel   = roleProto._wGunLevel
	if self._gunLevel > self._level then
		self._level = self._gunLevel
	end

	self._healLevel  = roleProto._wHealLevel
	if self._healLevel > self._level then
		self._level = self._healLevel
	end

	self._blessLevel = roleProto._wBlessLevel
	if self._blessLevel > self._level then
		self._level = self._blessLevel
	end


	self._repute = roleProto._dwRepute
	self._grade  = roleProto._byGrade
	self._byAdvanced     = roleProto._byAdvanced 
	self._szWeaponAppr   = roleProto._szWeaponAppr
	self._szShieldAppr   = roleProto._szShieldAppr
	self._szHelmetAppr   = roleProto._szHelmetAppr
	self._szBodyAppr     = roleProto._szBodyAppr
	self._szTrousersAppr = roleProto._szTrousersAppr
	---新增end
	
	self._dltTime   = roleProto._szDeleteTime
	self._delete    = roleProto._byDelete
    self._serverID  = roleProto._dwServerID
	self._playerId  = roleProto._szPlayerID
    self._creatTime = roleProto._szCreateTime
	-- self:dump()

end

function RoleData:dump()
    lt.LogUtil:debug(">>>>>>>>>>>>>>>>>>>> RoleData >>>>>>>>>>>>>>>>>>>>")
    lt.LogUtil:debug("self._name = "..self._name)
    lt.LogUtil:debug("self._job = "..self._job)
    lt.LogUtil:debug("self._hair = "..self._hairColor)
    lt.LogUtil:debug("self._color = "..self._skinColor)
    lt.LogUtil:debug("self._level = "..self._level)
    lt.LogUtil:debug("self._sex = "..self._sex)
    lt.LogUtil:debug("self._realm = "..self._realm)
    lt.LogUtil:debug("self._dltTime = "..self._dltTime)
    lt.LogUtil:debug("self._delete = "..self._delete)
    lt.LogUtil:debug("self._serverID = "..self._serverID)
    lt.LogUtil:debug("<<<<<<<<<<<<<<<<<<<< RoleData <<<<<<<<<<<<<<<<<<<<")
end

function RoleData:setName(name)
	self._name = name
end

function RoleData:getName()
	return self._name
end

function RoleData:setJob(job)
	self._job = job
end

function RoleData:getJob()
	return self._job
end

function RoleData:setLevel(level)
	self._level = level
end

function RoleData:getLevel()
	return self._level 
end

function RoleData:setSex(sex)
	self._sex = sex
end

function RoleData:getSex()
	return self._sex
end

function RoleData:setHair(hair)
	self._hair = hair
end

function RoleData:getHair()
	return self._hair
end

function RoleData:setColor(color)
	self._color = color
end

function RoleData:getColor()
	return self._color
end

function RoleData:setRealm(realm)
	self._realm = realm
end

function RoleData:getRealm()
	-- local nums = self._level - lt.Constant.REBORN_MAXLEVEL
	-- return nums > 0 and nums or 0
	--转生修改
	return 0
end

function RoleData:setDltTime(dltTime)
	self._dltTime = dltTime
end

function RoleData:getDltTime()
	return self._dltTime
end

function RoleData:setDelete(delete)
	self._delete = delete
end

function RoleData:getDelete()
	return self._delete
end

function RoleData:setServerID(serverID)
	self._serverID = serverID
end

function RoleData:getServerID()
	return self._serverID
end

function RoleData:setSelected(selected)
	self._selected = selected
end

function RoleData:getSelected()
	return self._selected
end

function RoleData:getCreateTime()
    return self._creatTime
end

function RoleData:getPlayerId()
    return self._playerId
end

function RoleData:getFaceShape()
	return self._faceShape
end

function RoleData:getHairColor()
	return self._hairColor
end

function RoleData:getSkinColor()
	return self._skinColor
end

function RoleData:getRolePos()
	return self._byPos
end

function RoleData:getAdvanced()
	return self._byAdvanced
end

function RoleData:getWeaponAppr()
	return self._szWeaponAppr
end

function RoleData:getShieldAppr()
	return self._szShieldAppr
end

function RoleData:getHelmetAppr()
	return self._szHelmetAppr
end

function RoleData:getBodyAppr()
	return self._szBodyAppr
end

function RoleData:getTrousersAppr()
	return self._szTrousersAppr
end

return RoleData
