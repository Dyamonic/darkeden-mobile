function UIWndGuildCreate:ctor(param)
    UIWndGuildCreate.super.ctor(self, param)
end

function UIWndGuildCreate:onShown()
    self._btnSure:addClickListener(handler(self, self.onBtnFncSureClick))
    self:onFreshUI()
end

function UIWndGuildCreate:onHide()
    self._btnSure:removeClickListener()
    UIWndGuildCreate.super.onHide(self)
end

function UIWndGuildCreate:onClear()
    self._inputName = nil
    self._lblCount  = nil
    self._lblMsg    = nil
    self._bgKuang   = nil
    self._lblLv     = nil
    self._IconItem  = nil
    self._btnSure   = nil
    UIWndGuildCreate.super.onClear(self)
end

function UIWndGuildCreate:onInit()
    UIWndGuildCreate.super.onInit(self, _GURL.GuildCreatePanel)
    self._btnSure   = self:getChild("btn_sure")
    self._inputName = self:getChild("input_name")
    self._lblCount  = self:getChild("lbl_count")
    self._lblMsg    = self:getChild("txt")
    self._bgKuang   = self:getChild("bg_notice")
    self._lblLv     = self:getChild("lbl_lv")
    self._IconItem  = self:getChild("IconItem")
    self:initCocosInputUI()
end

function UIWndGuildCreate:onFreshUI()
    local jinBi = GameModule:getHeroData():getJinBi() or 0
    local CreateGuildCostItem = CacheManager:getVariableById(Constant.Variable.CreateGuildCostItem) or 0
    local countStr = "[color=#00ff00]" .. CreateGuildCostItem .. "[/color]"
    if jinBi < tonumber(CreateGuildCostItem) then
        countStr = "[color=#ff0000]" .. CreateGuildCostItem .. "[/color]"
    end
    local countLimit = string.format(GReadText.KEY_GUILD_TIPS28,_GURL.GetImageCoin..countStr)
    self._lblCount:setText(countLimit)

    local GuildNoticeLength = CacheManager:getVariableById(Constant.Variable.GuildNoticeLength) or 0
    self._count = tonumber(GuildNoticeLength) or 0

    local level = CacheManager:getVariableById(Constant.Variable.CreateGuildPlayerLevel)
    local myLv = GameModule:getHeroData():getLevel()
    local levelStr = "[color=#00ff00]" .. level .. "[/color]"
    if myLv < tonumber(level) then
        levelStr = "[color=#ff0000]" .. level .. "[/color]"
    end
    local lvLimit = string.format(GReadText.KEY_GUILD_TIPS27,levelStr)
    self._lblLv:setText(lvLimit)
    self._lblMsg:setText("")
end

function UIWndGuildCreate:initCocosInputUI()
    if not self._Input then
        self._Input = ccui.EditBox:create(cc.size(534, 121), "", ccui.TextureResType.localType)
        self._Input:setAnchorPoint(cc.p(0, 0))
        self._Input:setPosition(14, 18)
        self._Input:setFontName(Constant.FONT_4)
        self._Input:setFontSize(22)
        self._Input:setReturnType(cc.KEYBOARD_RETURNTYPE_SEND)
        self._Input:setInputMode(cc.EDITBOX_INPUT_MODE_ANY)
        self._Input:registerScriptEditBoxHandler(handler(self, self.editBoxEvent))
        self._bgKuang:displayObject():addChild(self._Input)
    end
end

function UIWndGuildCreate:editBoxEvent(eventType, sender)
    if eventType == "began" then
        local str = self._lblMsg:getText()
        sender:setText(str)
        self._lblMsg:setText("")
    elseif eventType == "ended" then
        local str = self._Input:getText()
        self._Input:setText("")
        self._lblMsg:setText(str)
    elseif eventType == "changed" then
        local str = sender:getText()
        str = string.gsub(str, " ", "") --过滤掉空格
        -- str = CommonUtil:rmSpecChars(str)
        local count = string.len(str)
        local reCount = 0
        local beginIndex = -1
        local reString = ""
        for i = 1, count do
            local s = string.sub(str, i, i)
            local t = string.byte(s)
            if t < 128 then
                reCount = reCount + 1 --1字节文字，长度加1
            elseif t >= 192 then
                reCount = reCount + 2 --1字节以上文字，长度加2
            end
            if reCount > self._count then
                beginIndex = i - 1
                break
            end
            beginIndex = i
        end
        reString = string.sub(str, 1, beginIndex)
        sender:setText("")
        self._Input:setText(reString)
    elseif eventType == "return" then
    end
end

function UIWndGuildCreate:onBtnFncSureClick(obj)
    local level = CacheManager:getVariableById(Constant.Variable.CreateGuildPlayerLevel)
    local myLv = GameModule:getHeroData():getLevel()
    if myLv < tonumber(level) then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,
            { content = string.format(GReadText.KEY_GUILD_TIPS25, level) })
        return
    end

    local guildName = self._inputName:getText()
    local guildNotice = self._lblMsg:getText()

    if guildName == "" then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = GReadText.KEY_GUILD_TIPS24 })
        return
    end

    guildName = string.gsub(guildName, "[\n\r]", '')
    if MaskWordUtil:isFind(guildName) then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SMALL,
            {
                content = StringManager:getString(StringManager.KEY_CUST_TITLE_TIP1),
                confirmCallback = function()
                    self._Input:setVisible(true)
                end
            })
        self._Input:setVisible(false)
        return
    end

    local GuildNameLength = CacheManager:getVariableById(Constant.Variable.GuildNameLength) or 0
    if CommonUtil:GetUTFWidth(guildName) > tonumber(GuildNameLength) then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,
            { content = string.format(GReadText.KEY_CHAT_TIPS5, tonumber(GuildNameLength)) })
        return
    end

    guildNotice = MaskWordUtil:process(guildNotice, "**")
    guildNotice = string.gsub(guildNotice, "[\n\r]", '')

    local icon = math.random(1, 190)
    GuildModule:sendGuildCreateReq(guildName, guildNotice, icon)
end

return UIWndGuildCreate
