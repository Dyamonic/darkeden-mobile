---@class CompFunc 主界面-右下角功能
local CompFunc = class("CompFunc", lt.UICompBase)

local NtfManager = lt.NtfManager
local GuideModule = lt.GuideModule
local GameModule = lt.GameModule
local Constant = lt.Constant

local btnList = {
    {name = "btnMenu", targetName = "comMenu"},
    {name = "btnExp", targetName = "comExp"},
    {name = "btnFeature", targetName = "comMenu"},
    {name = "btnSystem"}
}

function CompFunc:ctor()
    CompFunc.super.ctor(self)

    self._iconTime = nil
    self._txtYMD = nil
    self._txtTime = nil
    self._btnSkill = nil
    self._switchMenu = nil
    self._isFirst = nil
    self._btnGroups = {}
end

function CompFunc:onClear()
    self._txtYMD = nil
    self._txtTime = nil
    self._iconTime = nil
    self._btnSkill = nil
    self._switchMenu = nil
    self._funcNode = nil
    self._featureNode = nil
    self._systemNode = nil
    self._timeProgress = nil
    for k, _ in ipairs(self._btnGroups) do
        self._btnGroups[k] = nil
    end
    self._btnGroups = nil
    CompFunc.super.onClear(self)

end

function CompFunc:onEnter()
    if not self._isFirst then
        self:initUI()
    end
    self._isFirst = true
    self:addComponentEvents()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_RED_DOT_EVENT, handler(self, self.uptRedDotEvt), "CompFunc:uptRedDotEvt")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_GAME_TIME_UPDATE, handler(self, self.refreshTimer), "CompFunc:refreshTimer")

    for _, btn in ipairs(self._btnGroups) do
        btn:addClickListener(handler(self, self.onBtnClick))
    end
    self._btnSkill:addClickListener(handler(self, self.onBtnSkillClick))
end

function CompFunc:onExit()
    self:removeComponentEvents()
    NtfManager:removeNtfListenerByTag("CompFunc:uptRedDotEvt")
    NtfManager:removeNtfListenerByTag("CompFunc:refreshTimer")

    for _, btn in ipairs(self._btnGroups) do
        btn:removeClickListener()
    end
    self._btnSkill:removeClickListener()

end

function CompFunc:refreshTimer()
    local date, time = GameModule:getGameTime()
    self._txtYMD:setText(date)
    self._txtTime:setText(time)
    self._iconTime:refreshTimer(time)
end

function CompFunc:initUI()
    local comMenu = self:getChild("comMenu")
    local comScriptMenu = lt.CompMenu.new(comMenu)
    self:addChild(comScriptMenu)
    comMenu.comScript = comScriptMenu
    comMenu.parent = self

    local comExp = self:getChild("comExp")
    local comScriptExp = lt.CompExp.new(comExp)
    self:addChild(comScriptExp)
    comExp.comScript = comScriptExp

    self._txtYMD = self:getChild("txtYMD")
    self._txtTime = self:getChild("txtTime")
    local date, time = GameModule:getGameTime()
    self._txtTime:setText(time)
    self._txtYMD:setText(date)
    self._iconTime = self:getChild("iconTime")
    
    self._btnSkill = self:getChild("btnSkill")
    self._switchMenu = self:getController("switchMenu")
    self._funcNode = comMenu:getChild("node_func")
    self._featureNode = comMenu:getChild("node_feature")
    self._systemNode = comMenu:getChild("node_system")

    for k,v in ipairs(btnList) do
        local btn = self:getChild(v.name)
        btn.index = k
        table.insert(self._btnGroups, btn)
    end
end

function CompFunc:onBtnSkillClick(context)
    local open,tips = lt.FunctionToggleModule:checkOpen(lt.FunctionToggleModule.FunctionHelpId.SkillEdit) 
    if not open then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
        return
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_OPEN_SKILL_EDIT)
end

-- 切换组件时候调
function CompFunc:onBtnClick(target)
    local index = target:getSender().index
    --显示相关按钮
    self._funcNode:setVisible(index == 1)
    self._featureNode:setVisible(index == 3)
    self._systemNode:setVisible(index == 4)
end

--添加监听事件
function CompFunc:addComponentEvents()
    for k,v in ipairs(btnList) do
        local targetCom = self:getChild(v.targetName or "")
        local isExistAdd = false
        if targetCom and targetCom.comScript and targetCom.comScript.addAllListener then
            isExistAdd = true
        end
        if isExistAdd then
            targetCom.comScript:addAllListener()
        end
    end
end

--移除监听事件
function CompFunc:removeComponentEvents()
    for k,v in ipairs(btnList) do
        local targetCom = self:getChild(v.targetName or "")
        local isExistRemove = false
        if targetCom and targetCom.comScript and targetCom.comScript.removeAllListener then
            isExistRemove = true
        end
        if isExistRemove then
            targetCom.comScript:removeAllListener()
        end
    end
end

function CompFunc:onConstruct()
    self:startSkin()
end

--刷新红点
function CompFunc:uptRedDotEvt(event)
    local param = event.param

    if string.find(param.name, "SkillRedTips") or param.name == "TeamApplyRedTips" then
        --角色红点
        local isShowRedDot = lt.SkillModule:getRedPoint()
        if not isShowRedDot then
            isShowRedDot = lt.TeamModule:getRedPoint() -- 组队小红点
        end
        local btn = self:getChild("btnMenu")
        btn:getChild("reddot"):setVisible(isShowRedDot)
    elseif param.name == "PetModule_checkPetUp" 
        or param.name == "PetModule_checkPetFunction" 
        or param.name == "GuildApplyRedTips" then
        local isShowRedDot = lt.RedDotModule:checkPetAllRed() or lt.GuildModule:getRedPoint()
        local btn = self:getChild("btnFeature")
        btn:getChild("reddot"):setVisible(isShowRedDot)
    end
end

function CompFunc:checkGuide()
    --技能编辑引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.SKILL_EDIT2) then
        local pos = self:displayObject():convertToWorldSpace(self._btnSkill:getPosition())
        pos = cc.p(pos.x - self._btnSkill:getSize().width/2, display.height - pos.y - self:getSize().height/2 - self._btnSkill:getSize().height)
        GuideModule:triggerGuide(Constant.GUIDE_ID.SKILL_EDIT2, self._btnSkill, pos, function()
            self:onBtnSkillClick()
        end)
        return
    end

    --了解宠物引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.PETFIGHT2) then
        local btn = self:getChild("btnMenu")
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, display.height - pos.y - self:getSize().height/2 + btn:getSize().height/2)
        GuideModule:triggerGuide(Constant.GUIDE_ID.PETFIGHT2, btn, pos, function()
            self._funcNode:setVisible(true)
            self._featureNode:setVisible(false)
            self._systemNode:setVisible(false)
            self._switchMenu:setSelectedIndex(0)
        end)
        return
    end

    --宠物出战引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.PETFIGHT12) then
        local btn = self:getChild("btnFeature")
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, display.height - pos.y - self:getSize().height/2 + btn:getSize().height/2)
        GuideModule:triggerGuide(Constant.GUIDE_ID.PETFIGHT12, btn, pos, function()
            self._funcNode:setVisible(false)
            self._featureNode:setVisible(true)
            self._systemNode:setVisible(false)
            self._switchMenu:setSelectedIndex(1)
        end)
        return
    end

    --宠物喂养引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.PETFEED2) then
        local btn = self:getChild("btnFeature")
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, display.height - pos.y - self:getSize().height/2 + btn:getSize().height/2)
        GuideModule:triggerGuide(Constant.GUIDE_ID.PETFEED2, btn, pos, function()
            self._funcNode:setVisible(false)
            self._featureNode:setVisible(true)
            self._systemNode:setVisible(false)
            self._switchMenu:setSelectedIndex(1)
        end)
        return
    end

    --了解公会引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.GUILD2) then
        local btn = self:getChild("btnFeature")
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, display.height - pos.y - self:getSize().height/2 + btn:getSize().height/2)
        GuideModule:triggerGuide(Constant.GUIDE_ID.GUILD2, btn, pos, function()
            self._funcNode:setVisible(false)
            self._featureNode:setVisible(true)
            self._systemNode:setVisible(false)
            self._switchMenu:setSelectedIndex(1)
        end)
        return
    end

    --了解交易行引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.TRANSACTION2) then
        local btn = self:getChild("btnMenu")
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, display.height - pos.y - self:getSize().height/2 + btn:getSize().height/2)
        GuideModule:triggerGuide(Constant.GUIDE_ID.TRANSACTION2, btn, pos, function()
            self._funcNode:setVisible(true)
            self._featureNode:setVisible(false)
            self._systemNode:setVisible(false)
            self._switchMenu:setSelectedIndex(0)
        end)
        return
    end

    --装备传承引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.INHERIT2) then
        local btn = self:getChild("btnFeature")
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, display.height - pos.y - self:getSize().height/2 + btn:getSize().height/2)
        GuideModule:triggerGuide(Constant.GUIDE_ID.INHERIT2, btn, pos, function()
            self._funcNode:setVisible(false)
            self._featureNode:setVisible(true)
            self._systemNode:setVisible(false)
            self._switchMenu:setSelectedIndex(1)
        end)
        return
    end

    --装备转换引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.TRANSFORM2) then
        local btn = self:getChild("btnFeature")
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, display.height - pos.y - self:getSize().height/2 + btn:getSize().height/2)
        GuideModule:triggerGuide(Constant.GUIDE_ID.TRANSFORM2, btn, pos, function()
            self._funcNode:setVisible(false)
            self._featureNode:setVisible(true)
            self._systemNode:setVisible(false)
            self._switchMenu:setSelectedIndex(1)
        end)
        return
    end

    --装备洗炼引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.PURIFY2) then
        local btn = self:getChild("btnFeature")
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, display.height - pos.y - self:getSize().height/2 + btn:getSize().height/2)
        GuideModule:triggerGuide(Constant.GUIDE_ID.PURIFY2, btn, pos, function()
            self._funcNode:setVisible(false)
            self._featureNode:setVisible(true)
            self._systemNode:setVisible(false)
            self._switchMenu:setSelectedIndex(1)
        end)
        return
    end

    --装备升级引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.LEVELUP2) then
        local btn = self:getChild("btnFeature")
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, display.height - pos.y - self:getSize().height/2 + btn:getSize().height/2)
        GuideModule:triggerGuide(Constant.GUIDE_ID.LEVELUP2, btn, pos, function()
            self._funcNode:setVisible(false)
            self._featureNode:setVisible(true)
            self._systemNode:setVisible(false)
            self._switchMenu:setSelectedIndex(1)
        end)
        return
    end

    --装备附魔引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.ENCHANT2) then
        local btn = self:getChild("btnFeature")
        local pos = self:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, display.height - pos.y - self:getSize().height/2 + btn:getSize().height/2)
        GuideModule:triggerGuide(Constant.GUIDE_ID.ENCHANT2, btn, pos, function()
            self._funcNode:setVisible(false)
            self._featureNode:setVisible(true)
            self._systemNode:setVisible(false)
            self._switchMenu:setSelectedIndex(1)
        end)
        return
    end

    --刷新子节点引导
    local comMenu = self:getChild("comMenu")
    comMenu.comScript:checkGuide()
end

return CompFunc