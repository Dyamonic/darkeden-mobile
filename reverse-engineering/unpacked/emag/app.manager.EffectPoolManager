
local EffectPoolManager = {}

EffectPoolManager._spriteArray = {}
EffectPoolManager._resArray = {}

function EffectPoolManager:init()
    for i = 1,1000 do
        local sprite = display.newSprite()
        sprite:retain()
        sprite._idxIndex = i
        sprite.R_Name = nil
        self:pushSprite(sprite)
        self._resArray[#self._spriteArray] = sprite
    end
end

function EffectPoolManager:clear()
    for _, sprite in ipairs(self._spriteArray) do
        sprite:release()
    end
    self._spriteArray = {}
end

function EffectPoolManager:reset()
    self:clear()
    self:init()
end

function EffectPoolManager:retrieveSprite(sprite,des)
    if des then
        -- print(des.."  Tick ="..debug.traceback("",3))
        if sprite.R_Name then
            print("未归还的对象是 "..sprite.R_Name)
            print(des.."  Tick ="..debug.traceback("",3))
        end
    end
    if sprite:getParent() then
        sprite:removeFromParent()
    --     if sprite:getParent().onClear then
    --         sprite:getParent().onClear()
    --     end
    end
    self:pushSprite(sprite)
end

function EffectPoolManager:pushSprite(sprite)
    -- 清理纹理的引用
    sprite:initWithFile("ui/common/rect_dumb.png")
    sprite.R_Name = nil
    self._spriteArray[#self._spriteArray + 1] = sprite
end

function EffectPoolManager:popSprite()
    if #self._spriteArray > 0 then
        local sprite = self._spriteArray[#self._spriteArray]
        self._spriteArray[#self._spriteArray] = nil
        sprite:setRotation(0)
        return sprite
    else
        local sprite = display.newSprite()
        sprite:retain()
        return sprite
    end
end

function EffectPoolManager:getAllR_Name()
    for _, sprite in ipairs(self._resArray) do
