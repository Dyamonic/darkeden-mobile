
local EffectMeta = class("EffectMeta")


-- 特效数据

-- 特效组公共数据


function EffectMeta:ctor(row)
	self:initWithRow(row)
end

function EffectMeta:initWithRow(row)
    self._skillId       = row.SkillId
    self._order         = row.OrderId
    self._spriteId      = row.EffectSpriteType
    self._bltType       = row.BltType
    self._step          = row.Step
    self._delayFrame    = row.DelayFrame
    self._owner         = row.Owner
    self._speed         = row.Speed
    
    -- metas列表的公共数据
    self._approach      = row.Approach
    self._randomTime    = row.RandomTime
    self._loopCount     = row.LoopCount
    self._bulletType    = row.BulletType

    if self._skillId == lt.SkillEnum.SKILL_CHARGING_POWER 
    or self._skillId == lt.SkillEnum.SKILL_REDIANCE
    or self._skillId == lt.SkillEnum.SKILL_PLAYING_WITH_FIRE
    or self._skillId == lt.SkillEnum.SKILL_TALON_OF_CROW
    then
        self._originalSpriteId  = self._spriteId
    end
    if self._skillId == lt.SkillEnum.SKILL_SHADOW_DANCING then
        self._originalDelayFrame = self._delayFrame
    end
end

function EffectMeta:getOriginalSpriteId()
    return self._originalSpriteId
end

function EffectMeta:getEffectId()
    return self._spriteId
end

function EffectMeta:setEffectId(spriteId)
    self._spriteId = spriteId
end

function EffectMeta:setDelayFrame(delayTime)
    self._delayFrame = delayTime
end
function EffectMeta:getOriginalDelayFrame()
    return  self._originalDelayFrame
end

function EffectMeta:bltType()
    return self._bltType
end

function EffectMeta:setOrder(order)
    self._order = order
end

function EffectMeta:setStep(step)
    self._step = step
end

-- AUTO GENERATED GETTERS START
-- 以下方法由脚本自动生成，请勿手动修改

function EffectMeta:getSkillId() return self._skillId end
function EffectMeta:getOrder() return self._order end
function EffectMeta:getSpriteId() return self._spriteId end
function EffectMeta:getBltType() return self._bltType end
function EffectMeta:getStep() return self._step end
function EffectMeta:getDelayFrame() return self._delayFrame end
function EffectMeta:getOwner() return self._owner end
function EffectMeta:getSpeed() return self._speed end
function EffectMeta:getApproach() return self._approach end
function EffectMeta:getRandomTime() return self._randomTime end
function EffectMeta:getBulletType() return self._bulletType end
function EffectMeta:getLoopCount() return self._loopCount end

-- AUTO GENERATED GETTERS END
return EffectMeta
