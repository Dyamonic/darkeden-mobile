---@class UICompChatSettingCell
--- 聊天颜色设置cell
local UICompChatSettingCell = class("UICompChatSettingCell", lt.UIGButtonBase)

local PrefManager = lt.PrefManager
local ChatModule = lt.ChatModule
local NtfManager = lt.NtfManager

function UICompChatSettingCell:ctor()
    UICompChatSettingCell.super.ctor(self)
end

function UICompChatSettingCell:onClear()
    self._icon   = nil
    self._imggou = nil
    UICompChatSettingCell.super.onClear(self)
end

function UICompChatSettingCell:onEnter()
    UICompChatSettingCell.super.onEnter(self)
    self:addClickListener(handler(self, self.onClickBtn))
end

function UICompChatSettingCell:onExit()
    self:removeClickListener()
    UICompChatSettingCell.super.onExit(self)
end

function UICompChatSettingCell:onConstruct()
    self._icon = self:getChild("icon")
    self._imggou = self:getChild("n4")
end

function UICompChatSettingCell:setInfo(index)
    local urlPath = string.format(_GURL.GetCompChatColor, index)
    self._icon:setURL(urlPath)
    local keySetting = PrefManager:getUserValueByKey(ChatModule.CHAT_SETTING_COLOR) or 1
    self._imggou:setVisible(keySetting == index)
end

function UICompChatSettingCell:onClickBtn(obj)
    local index = obj:getSender().index
    local keySetting = PrefManager:getUserValueByKey(ChatModule.CHAT_SETTING_COLOR)
    if keySetting ~= nil and keySetting == index then
        return
    end

    PrefManager:setUserValueByKey(ChatModule.CHAT_SETTING_COLOR, index)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_CHAT_COLOR)
end

return UICompChatSettingCell
