local StrongMeta = class("StrongMeta")

function StrongMeta:ctor(row)
    self:initWithRow(row)
end

function StrongMeta:initWithRow(row)
    self._idx       = row.Idx
    self._type      = row.Type
    self._typeName  = row.TypeName
    self._occupation= row.Occupation
    self._contect   = row.Contect
    self._icon      = row.Icon
    self._jumpType  = row.JumpType
    self._jumpTarget= tonumber(row.JumpTarget)
end

-- AUTO GENERATED GETTERS START
-- 以下方法由脚本自动生成，请勿手动修改

function StrongMeta:getIdx() return self._idx end
function StrongMeta:getType() return self._type end
function StrongMeta:getTypeName() return self._typeName end
function StrongMeta:getOccupation() return self._occupation end
function StrongMeta:getContect() return self._contect end
function StrongMeta:getIcon() return self._icon end
function StrongMeta:getJumpType() return self._jumpType end
function StrongMeta:getJumpTarget() return self._jumpTarget end

-- AUTO GENERATED GETTERS END
return StrongMeta
