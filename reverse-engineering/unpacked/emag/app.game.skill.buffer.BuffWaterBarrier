local BuffWaterBarrier = class("BuffWaterBarrier", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum

--[[
    水之壁障
]]
function BuffWaterBarrier:ctor(time, actor, skilllevel, source)    
    BuffWaterBarrier.super.ctor(self, BuffEnum.EFFECT_CLASS_WATER_BARRIER, time, actor)
    -- actor:playParallelEffect(SkillEnum.SKILL_WATER_BARRIER)
    -- 播放特效 1为目标对象
    if not source.isExist then
        actor:playQueueEffect(SkillEnum.SKILL_WATER_BARRIER, 1)
    end
end

function BuffWaterBarrier:onClear()
    -- stop 播放
    self._actor:stopQueueEffect(SkillEnum.SKILL_WATER_BARRIER)

    BuffWaterBarrier.super.onClear(self)
end

return BuffWaterBarrier
