local BuffMagicDeath = class("BuffMagicDeath", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum

--[[
    致死术
]]
function BuffMagicDeath:ctor(time, actor, skilllevel,source, bufferId)    
    BuffMagicDeath.super.ctor(self, BuffEnum.EFFECT_CLASS_DEATH, time, actor)
    -- 播放特效 1为目标对象
    if not source.isExist then
        actor:playEffect(SkillEnum.SKILL_MAGIC_DEATH)
    end
end

function BuffMagicDeath:onClear()
    -- self._actor:stopQueueEffect(SkillEnum.SKILL_MAGIC_DEATH)

    BuffMagicDeath.super.onClear(self)
end

return BuffMagicDeath
