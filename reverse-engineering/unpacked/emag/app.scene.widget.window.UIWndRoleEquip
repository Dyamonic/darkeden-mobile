--- 角色装备
---@class UIWndRoleEquip:UIWindowBase
local UIWndRoleEquip = class("UIWndRoleEquip", lt.UIWindowBase)

local Constant = lt.Constant
local GameModule = lt.GameModule
local WndLockManager = lt.WndLockManager
local NtfManager = lt.NtfManager
local CacheManager = lt.CacheManager
local ItemModule = lt.ItemModule
local AutoFightManager = lt.AutoFightManager
-- local RaceToJobPanel = {
--     [Constant.RaceType.Slayer] = "Slayer",
--     [Constant.RaceType.Vampire] = "Vampire",
--     [Constant.RaceType.Ousters] = "Ousters",
-- }

UIWndRoleEquip.ChangeSkinConf = {
    ["CommonTL"] = {
        ["frame"] = {
            closeButton = {bg  = "bg_beibao_anniu01", bgup  = "bg_beibao_anniu02"},
        }
    }
}

local EquipName = Constant.EquipName
local EquipIconName = Constant.EquipIconName
local BibleIcon = {Slayer = "bg_zhuangbei_15_s", Vampire = "bg_zhuangbei_11_v", Ousters = "bg_zhuangbei_16_o"}

function UIWndRoleEquip:ctor(param)
    UIWndRoleEquip.super.ctor(self, param)
    
    self._equipPosEquip = nil
    self._preNode = nil
end

function UIWndRoleEquip:onClear()
    self:unregisterAllComponent()
    UIWndRoleEquip.super.onClear(self)
    
    self._equipPosEquip = nil
    self._preNode = nil
end

function UIWndRoleEquip:getEquiPos()
    local curRace = GameModule:getHeroRace()
    return Constant[Constant.RaceToJobPanel[curRace] .. "EquipPos"] or {}
end

function UIWndRoleEquip:getEquiName()
    local curRace = GameModule:getHeroRace()
    return EquipName[Constant.RaceToJobPanel[curRace] .. "EquipPos"]
end

function UIWndRoleEquip:onEnter()
    
end

function UIWndRoleEquip:onExit()

end

function UIWndRoleEquip:onInit()
    local curRace = GameModule:getHeroRace()
    self:registerComponent("UICompRoleEquipItem")
    UIWndRoleEquip.super.onInit(self, string.format(_GURL.GetImageRoleEquip,Constant.RaceToJobPanel[curRace]))
    self:initUI()
end

function UIWndRoleEquip:initUI()
    self.bg = self:getChild("frame"):getChild("bg")
    self.diOpacity = self:getChild("frame"):getChild("opacityDi")
    self.bgOpacity = self:getChild("frame"):getChild("opacityBg")
    self:refreshRoleEquip()
end

function UIWndRoleEquip:onShown()
    UIWndRoleEquip.super.onShown(self)
    lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_UPDATE_HERO_EQUIP_EVENT, handler(self, self.refreshRoleEquip), "UIWndRoleEquip:refreshRoleEquip")
    lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_CANCEL_REPAIR_CHOOSE, handler(self, self.cancelRepairChoose), "UIWndRoleEquip:cancelRepairChoose")
    lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_CANCEL_SELECT_STATE_ITEM, handler(self, self.cancelSelectItem), "UIWndRoleEquip:cancelSelectItem")
    lt.NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_CHANGE_SETTINGS, handler(self, self.changeSettings), "UIWndRoleEquip:changeSettings")
    self:refreshRoleEquip()
    self:refreshBtn()
end

function UIWndRoleEquip:onHide()
    lt.NtfManager:removeNtfListenerByTag("UIWndRoleEquip:refreshRoleEquip")
    lt.NtfManager:removeNtfListenerByTag("UIWndRoleEquip:cancelRepairChoose")
    lt.NtfManager:removeNtfListenerByTag("UIWndRoleEquip:cancelSelectItem")
    lt.NtfManager:removeNtfListenerByTag("UIWndRoleEquip:changeSettings")

    if self._equipPosEquip then
        for k,v in pairs(self._equipPosEquip) do
            v:removeClickListener()
            v:removeFromParent()
        end
    end
    self._equipPosEquip = nil
    self._preNode = nil

    local closeBtn = self:getChild("frame"):getChild("closeButton")
    closeBtn:removeClickListener()
    
    UIWndRoleEquip.super.onHide(self)
end

function UIWndRoleEquip:cancelSelectItem()
    if self._preNode then
        self._preNode:loadShader(false)
        self._preNode = nil 
    end
end

function UIWndRoleEquip:setBGOpacity()
    local editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.EQUIP_OPACITY)
    self.isBGOpacity = editTable.switch == 1
    if self.isBGOpacity then
        editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.WINDOW_OPACITY)
        self.diOpacity:setAlpha(editTable.value/100)
    else
        self.diOpacity:setAlpha(1)
    end
    self.bg:setVisible(not self.isBGOpacity)
    self.diOpacity:setVisible(self.isBGOpacity)
    self.bgOpacity:setVisible(self.isBGOpacity)
end

function UIWndRoleEquip:getEquipItemInfoByPos(pos)
    local equipData = lt.ItemModule:getEquipArray()
    for k,v in ipairs(equipData) do
        local equipPos = v:getPos()
        -- print("xxxxxxxxxxxxxxxx",equipPos)
        if pos == equipPos then
            return v
        end
    end
end

function UIWndRoleEquip:refreshRoleEquip()
    if not self._equipPosEquip then
        self._equipPosEquip = {}
    end
    local equipPos = self:getEquiPos()
    local armsData = self:getEquipItemInfoByPos(equipPos["Arms"])
    local curRace = GameModule:getHeroRace()
    local equipNode = self:getChild("equipNode")
    for k,v in pairs(equipPos) do
        local roleEquip = self:getChild(k)
        local equipData = self:getEquipItemInfoByPos(v)
        local armsSame = false
        if curRace == Constant.RaceType.Slayer then
            if k == "Shield" and armsData and armsData:getMetaType() ~= Constant.ArmsEquipType.HandSword then
                equipData = armsData
                armsSame = true
            end
        else
            if k == "Arms_same" then
                equipData = armsData
                armsSame = true
            end
        end
        if roleEquip then
            local item = nil
            if self._equipPosEquip[v] then
                item = self._equipPosEquip[v]
            end
            if not item then
                item = fgui.UIPackage:createObject("Item", "RoleEquipItem")
                item:insertObjectToFactory(self)
                equipNode:addChild(item)
                self._equipPosEquip[v] = item
                local function btnClik()
                    local equipName = self:getEquiName()
                    if item.equipData then
                        if WndLockManager:getWndLockType() == Constant.WndLockType.Repair and WndLockManager:getRepairType() == Constant.RepairType.Repair then
                            --维修模式切换选中状态
                            local target = item
                            local oldTarget = WndLockManager:getRepairItemInfo()
                            if oldTarget ~= nil then
                                oldTarget:setItemSelect(false)
                            end
                            target:setItemSelect(true)
                            WndLockManager:setRepairItemInfo(target)
                        end
                        item:showTips(item.equipData)
                        item:loadShader(true)
                        self._preNode = item
                    else
                        local itemSize = item:getSize()
                        local point = item:localToGlobal({x=0,y=0-itemSize.height/2})
                        -- print("xxxxxxxxxxxxxxxxxxxxx",point.x, point.y)
                        -- local point = lt.FGUIUtil:fGuiPosToCocos(itemPos)
                        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SHOW_TEXT_TIPS, 
                        {
                            content = (equipName[k] or ""),
                            pt = point
                        })

                        UIWndRoleEquip:onShowBibleTips(k)
                    end
                end
                
                item:addClickListener(handler(self, btnClik))
            end
            item.equipData = equipData
            
            if equipData then
                local itemConfig = equipData:getItemMeta()
                local iconId = itemConfig:getIconId()
                item:setInfo(string.format(_GURL.GetImageItemEquipPath, iconId))
                roleEquip:setVisible(false)

                if string.find(k, "Bible") then
                    roleEquip:setVisible(true)
                    if not roleEquip.effectActor then
                        local meta = lt.EffectMeta.new({
                            SkillId          = 0,
                            OrderId          = 1,
                            EffectSpriteType = 1153,
                            BltType          = 1,
                            Step             = 0.07,
                            DelayFrame       = 0,
                            Owner            = 0,
                            LoopCount        = 1
                        })

                        local effectActor = lt.CompEffectActor.new(meta, 1, true)
                        effectActor:setPosition(roleEquip:getSize().width/2, roleEquip:getSize().height/2)
                        effectActor:setScale(1.2)   
                        roleEquip:displayObject():addChild(effectActor)
                        roleEquip.effectActor = effectActor
                    else
                        roleEquip.effectActor:setVisible(true)
                    end
                end
            else
                item:setInfo(nil)
                --圣书解锁检查
                if string.find(k, "Bible") then
                    local unlock = UIWndRoleEquip:checkBibleUnlock(k)
                    local equipIconName = EquipIconName[Constant.RaceToJobPanel[curRace] .. "EquipPos"]
                    local iconName = unlock and equipIconName[k] or BibleIcon[Constant.RaceToJobPanel[curRace]]
                    roleEquip:setURL(string.format(_GURL.GetImageRoleEquip, iconName))
                    if roleEquip.effectActor then
                        roleEquip.effectActor:setVisible(false)
                    end
                end
                roleEquip:setVisible(true)
            end
            -- print(k .. "----" .. v)
            local pos = roleEquip:getPosition()
            -- print(pos.x,pos.y)

            local roleEquipSize = roleEquip:getSize()
            item:setPivot(0.5,0.5, true)
            item:setPosition(pos.x+roleEquipSize.width/2,pos.y+roleEquipSize.height/2)
            item:setItemInfo(equipData,roleEquipSize)
            local equipIcon = item._equipIcon
            if equipIcon then
                equipIcon:setVisible(not not equipData)
            end

            --如果是镀银直接选中武器
            if WndLockManager:getWndLockType() == Constant.WndLockType.Repair and WndLockManager:getRepairType() == Constant.RepairType.Silver then
                if armsData then
                    if k == "Arms" then
                        item:setItemSelect(true)
                        WndLockManager:setRepairItemInfo(item)
                        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_REFRESH_REPAIR_VIEW)
                    elseif armsSame then
                        item:setItemSelect(true)
                    end
                end
            else
                item:setItemSelect(false)
            end

            --首饰套显示
            local suitPos = nil
            if curRace == Constant.RaceType.Slayer then
                suitPos = Constant.SlayerSuitMapping[v]
            elseif curRace == Constant.RaceType.Vampire then
                suitPos = Constant.VampireSuitMapping[v]
            elseif curRace == Constant.RaceType.Ousters then
                suitPos = Constant.OustersSuitMapping[v]
            end
            if suitPos then
                local icon = self:getChild("Suit"..k)
                icon:setVisible(false)
                local itemInfo = self:getEquipItemInfoByPos(suitPos)
                if itemInfo then
                    local itemMeta = itemInfo:getItemMeta()
                    local iconId = itemMeta:getIconId()
                    if equipData then
                        --有首饰的情况下当背景图
                        icon:setURL(string.format(_GURL.GetImageItemEquip, iconId))
                        icon:setVisible(true)
                    else
                        --没有首饰的情况下当主体(因为点击要显示tips)
                        item:setInfo(string.format(_GURL.GetImageItemEquipPath, iconId))
                        item:setItemInfo(itemInfo,cc.size(roleEquipSize.width + 9, roleEquipSize.height + 9))
                        item.equipData = itemInfo
                    end
                end
            end
        end
    end
    self:setBGOpacity()
end

--取消维修/镀银选中
function UIWndRoleEquip:cancelRepairChoose()
    if WndLockManager:getWndLockType() == Constant.WndLockType.Repair and WndLockManager:getRepairType() == Constant.RepairType.Repair then
        local oldTarget = WndLockManager:getRepairItemInfo()
        if oldTarget ~= nil then
            oldTarget:setItemSelect(false)
        end
        WndLockManager:setRepairItemInfo(nil)
    end
end

function UIWndRoleEquip:refreshBtn()
    local closeBtn = self:getChild("frame"):getChild("closeButton")
    closeBtn:addClickListener(function()
        local wndLockType = WndLockManager:getWndLockType()
        if wndLockType == Constant.WndLockType.Repair then
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndLock", close = true})
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTalkNpc", close = true})
        else
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndRoleEquip", close = true})
        end
    end)
end

function UIWndRoleEquip:checkBibleUnlock(equipName)
    if string.find(equipName, "Bible") then
        local num = tonumber(string.split(equipName, "Bible")[2])
        --todo暂时解锁第一个圣书
        local heroData = GameModule:getHeroData()
        --获得圣书解锁槽位
        local unlockPos = heroData:getHolyBookUnlockPos()
        if num <= unlockPos then
            return true
        end
    end
    return false
end

function UIWndRoleEquip:onShowBibleTips(equipName)
    if string.find(equipName, "Bible") then
        local num = tonumber(string.split(equipName, "Bible")[2])
        local unlock = UIWndRoleEquip:checkBibleUnlock(equipName)
        if unlock then -- 解锁了
            return 
        end
        local count = 0
        local curRace = GameModule:getHeroRace()
        if curRace == Constant.RaceType.Slayer then --人类
            local item = ItemModule:getEquipItemByPos(Constant.SlayerEquipPos.Arms)
            if item then
                local itemMeta = item:getItemMeta()
                local itemType = itemMeta:getType()
                if itemType == Constant.PropTypeSub_15.Sword or
                itemType == Constant.PropTypeSub_15.Blade or
                itemType == Constant.PropTypeSub_15.Gun then
                count = CacheManager:getValueById(Constant.Variable.Reputation2)[num]
                elseif itemType == Constant.PropTypeSub_15.Heal or
                itemType == Constant.PropTypeSub_15.Bless then
                count = CacheManager:getValueById(Constant.Variable.Reputation1)[num]
                end
            else
                count = CacheManager:getValueById(Constant.Variable.Reputation1)[num]
            end
        elseif curRace == Constant.RaceType.Vampire then --吸血鬼
            count = CacheManager:getValueById(Constant.Variable.Reputation3)[num]
        elseif curRace == Constant.RaceType.Ousters then  --魔灵
            count = CacheManager:getValueById(Constant.Variable.Reputation4)[num]
        end

        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = string.format(GReadText.KEY_FRIEND_TIPS3, count)})
    end
end

--设置改变
function UIWndRoleEquip:changeSettings(params)
    local param = params.param
    if param.index == Constant.SETTINGS_TYPES.EQUIP_OPACITY or param.index == Constant.SETTINGS_TYPES.WINDOW_OPACITY then
        local editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.EQUIP_OPACITY)
        self.isBGOpacity = editTable.switch == 1
        if self.isBGOpacity then
            editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.WINDOW_OPACITY)
            self.diOpacity:setAlpha(editTable.value/100)
        else
            self.diOpacity:setAlpha(1)
        end
        self.bg:setVisible(not self.isBGOpacity)
        self.diOpacity:setVisible(self.isBGOpacity)
        self.bgOpacity:setVisible(self.isBGOpacity)
    end
end

return UIWndRoleEquip