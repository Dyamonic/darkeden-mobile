---@class TopLayer 最顶层
local TopLayer = class("TopLayer", lt.UICompBase)
local NtfManager = lt.NtfManager

function TopLayer:ctor()
    -- fgui.registerComponent(_GURL.CompTrace, lt.CompTrace)
    self:registerComponent("CompTrace")

    TopLayer.super.ctor(self)
    self._view = fgui.UIPackage:createObject("Main", "TopLayer")
    self._view:makeFullScreen()
    self._view:center()
    self:addChild(self._view)


    self._isHideAll = false

    self._btnHide = self._view:getChild("btnHide")
    
    self._btnHide:setVisible(false)

    self._traceView = self._view:getChild("trace")
    self._traceView:setVisible(false)
end

function TopLayer:onClear()
    -- fgui.unregisterComponent(_GURL.CompTrace)
    self:unregisterAllComponent()
    self:removeFromParent()
    self._view = nil
    self._isHideAll = nil
    self._traceView = nil
    TopLayer.super.onClear(self)
end
 

function TopLayer:onExit()
    lt.NtfManager:removeNtfListenerByTag("TopLayer:NTF_OPEN_TRACE_UI")
    lt.NtfManager:removeNtfListenerByTag("TopLayer:NTF_CLOSE_TRACE_UI")
    self._btnHide:removeClickListener();
end

function TopLayer:onEnter()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_OPEN_TRACE_UI, handler(self, self.openTraceUI), "TopLayer:NTF_OPEN_TRACE_UI")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CLOSE_TRACE_UI, handler(self, self.closeTraceUI), "TopLayer:NTF_CLOSE_TRACE_UI")

    self._btnHide:addClickListener(handler(self, self.btnHideClick));
end
function TopLayer:btnHideClick()
    self._isHideAll = not self._isHideAll
    local layerManager = display.getRunningScene():getLayerManager()
    layerManager:hideAll(self._isHideAll)
end

function TopLayer:openTraceUI()
    self._traceView:setVisible(true)
end
function TopLayer:closeTraceUI()
    self._traceView:setVisible(false)
end


return TopLayer