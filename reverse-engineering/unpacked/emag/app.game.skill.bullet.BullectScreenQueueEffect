local BullectScreenQueueEffect = class("BullectScreenQueueEffect", lt.BulletBase)
--[[
    地图任意位置释放 序列特效
]]
local ScheduleUtil = lt.ScheduleUtil
local EffectQueueActor = lt.EffectQueueActor
local SkillEnum = lt.SkillEnum
local EffectEnum = lt.EffectEnum
local CacheManager = lt.CacheManager

function BullectScreenQueueEffect:ctor(skillId, direction, releaseXY)
    BullectScreenQueueEffect.super.ctor(self, skillId)
    self._skillId = skillId
    self._direction = direction
    self._releaseXY = releaseXY
    self._queueEffectActorArr = {}
    self._effectActor = nil
    self:setAnchorPoint(cc.p(0.5, 0.5))
    self:setPosition(releaseXY)
    self:playQueueEffect(skillId)
end

function BullectScreenQueueEffect:onClear()
    for i = #self._queueEffectActorArr, 1, -1 do
        local effectActor = self._queueEffectActorArr[i]
        effectActor:onClear()
        table.remove(self._queueEffectActorArr, i)
    end
    self:removeAllChildren()
    self:removeFromParent()
end

function BullectScreenQueueEffect:setPositionEx(x, y)
    self:setPosition(x, y)
end

function BullectScreenQueueEffect:onUpdate()
    self:onUpdateQueueEffect()
end

function BullectScreenQueueEffect:playQueueEffect(skillId, owner)
    local effectQueueActor = EffectQueueActor.new(self, skillId, self._direction)
    self:addChild(effectQueueActor)

    if skillId == SkillEnum.SKILL_CONTINUAL_LIGHT then
        effectQueueActor:addEffectEName(skillId, "result_magic_continual_light")
    elseif skillId == SkillEnum.SKILL_GORE_GLAND_FIRE 
    or skillId == SkillEnum.SKILL_SUMMON_OF_GROUND_ELEMENTAL 
    then
        local buffMetas = CacheManager:getBuffMetas(skillId)
        effectQueueActor:addEffect(skillId, buffMetas) 
    else
        effectQueueActor:addEffectGenerator(skillId, 0)  
    end
    
    table.insert(self._queueEffectActorArr, effectQueueActor)
   
end

-- 主要是停止循环播放的队列
function BullectScreenQueueEffect:stopQueueEffect(skillId)
    for i, effectActor in ipairs(self._queueEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            effectActor:stopQueueEffect()
            break
        end
    end
end

-- 清除某个持续特效
function BullectScreenQueueEffect:removeQueueEffect(skillId)
    for i, effectActor in ipairs(self._queueEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            effectActor:onClear()
            table.remove(self._queueEffectActorArr, i)
            break
        end
    end
end

function BullectScreenQueueEffect:onUpdateQueueEffect()
	local queueEffectActorArr = self._queueEffectActorArr 
	if not queueEffectActorArr or #queueEffectActorArr == 0 then
		return
	end
	for _, effectActor in pairs(queueEffectActorArr) do
		effectActor:onUpdate()
	end
end

return BullectScreenQueueEffect