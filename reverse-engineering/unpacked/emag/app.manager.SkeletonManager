local SkeletonManager = {}
local UIManager = {}

local SkeletonActor = lt.SkeletonActor

function SkeletonManager:init() 
    self._skeletonDataTable = {}
end

function SkeletonManager:createSkeletonActorWithFile(file, actor)
    local skeletonAnimation

    local skeletonData = self._skeletonDataTable[file]
    file = string.lower(file)

    if not skeletonData then
        local skeletonFile = "actor/" .. file .. ".json"
        local atlasFile = "actor/" .. file .. ".atlas"

        skeletonData = sp.SkeletonData:create(skeletonFile, atlasFile)
        self._skeletonDataTable[file] = skeletonData
        skeletonAnimation = SkeletonActor:createWithData(skeletonData)
    else
        skeletonAnimation = SkeletonActor:createWithData(skeletonData)
    end

    if skeletonAnimation ~= nil then
        self:addSkeletonView(skeletonAnimation, self._skeletonActorArray)
    end

    return skeletonAnimation
end

--创建ui界面特效spine
function SkeletonManager:createSkeletonEffectWithFile(folder, file, scale)
    local skeletonAnimation

    local skeletonData = self._skeletonDataTable[file]

    if not skeletonData then
        local skeletonFile = "spine/" .. folder .. "/" .. file .. ".json"
        local atlasFile = "spine/" .. folder .. "/" .. file .. ".atlas"

        skeletonData = sp.SkeletonData:create(skeletonFile, atlasFile)
        self._skeletonDataTable[file] = skeletonData
        skeletonAnimation = SkeletonActor:createWithData(skeletonData)
    else
        skeletonAnimation = SkeletonActor:createWithData(skeletonData)
    end

    skeletonAnimation:setScale(scale or 1)

    return skeletonAnimation
end

function SkeletonManager:clear()
    self._skeletonDataTable = nil
end

return SkeletonManager