local BullectParabolaEffect = class("BullectParabolaEffect", lt.BulletBase)

local Constant = lt.Constant
local GameBoard = lt.GameBoard
local CacheManager = lt.CacheManager
local EffectActor = lt.EffectActor
local TimeTrigger = lt.TimeTrigger
local SkillEnum = lt.SkillEnum

BullectParabolaEffect._targetAgentId  = nil
BullectParabolaEffect._effectActor = nil

function BullectParabolaEffect:ctor(skillId)
    BullectParabolaEffect.super.ctor(self, skillId)


    self._isEndEffect = false
    self._timeTrigger = TimeTrigger.new(1 / Constant.FPS_TL)
    self._nextFrameIndex = 1
    self._waitEffectList = {}
    self:setAnchorPoint(cc.p(0.5, 0.5))
end

function BullectParabolaEffect:onClear()
    if self._effectActor then
        self._effectActor:onClear()
        self._effectActor = nil
    end
    
    self:removeAllChildren()

    self._isEndEffect = nil
end

function BullectParabolaEffect:addEffectActor(skillId,skillLevel)
    local actionInfoMetas = CacheManager:getBulletMetas(skillId,skillLevel)
    if not actionInfoMetas or #actionInfoMetas < 1 then
        return
    end

    local meta = actionInfoMetas[1]
    -- 存在旋转 所以需要加上锚点
    -- local anchorPoint = self:getAnchorPointByDirection(self._direction)
    self._effectActor = EffectActor.new(meta, 6, nil, true)
    self:addChild(self._effectActor)

    self._actionInfoMeta = meta

    self._isEndEffect = true
end


function BullectParabolaEffect:makeCannonadeSmoke()
    local actionInfoMetas = CacheManager:getBulletMetas(self._skillId)

    local cannonadeSmoke = lt.BullectScreenEffect.new(self._skillId, 6, cc.p(self._pixelX, self._pixelY + self._pixelZ ))
    cannonadeSmoke:addEffect(self._skillId, actionInfoMetas[5])
    lt.BulletManager:addBulletToMap(cannonadeSmoke)
    -- cannonadeSmoke:retain()
    -- table.insert(self._waitEffectList, cannonadeSmoke)
end

function BullectParabolaEffect:onUpdate()
    --0.25
    if self._timeTrigger:tick() then
        self:onUpdateMove()
        self:onUpdateWaitEffect()
    end

    self:onUpdateEffect()

end

function BullectParabolaEffect:onUpdateMove()

    if self._effectActor:getEffectActorClose() then
        self._waitingForClear = true
    end
    self._pixelX = self._pixelX + self._stepX
    self._pixelY = self._pixelY + self._stepY
    -- 更新坐标
    self._radCurrent = self._radCurrent + self._radStep
   
    local cosIntValue = (Constant.FCos(self._radCurrent) * self._stepPixel)
    local sign = cosIntValue < 0 and -1 or 1 --标记符号位
    local shiftCosValue =  bit.rshift(math.abs(cosIntValue), 16) * sign
    self._pixelZ = self._pixelZ + shiftCosValue
    
    if self._skillId == SkillEnum.SKILL_CANNONADE then
        self:makeCannonadeSmoke()
    end
    -- 判断是否到达目标
    if math.abs(self._pixelX - self._targetX) < self._stepPixel 
        and math.abs(self._pixelY - self._targetY) < self._stepPixel 
        and self._radCurrent >= Constant.FPI			
	    or self._pixelZ < self._targetZ	
        then
        self._pixelX = self._targetX
        self._pixelY = self._targetY
        self._pixelZ = self._targetZ
        self._stepX = 0
        self._stepY = 0
        self._stepZ = 0
        self._radStep = 0
        self.m_EndFrame = 0
        self._waitingForClear = true
        return false
    end
    self:setPosition(self._pixelX, self._pixelY + self._pixelZ)
end

function BullectParabolaEffect:onEnd(isLastGroupMember)
    if isLastGroupMember then
        if type(self._callback) == "function" then
            self._callback()
        end
    end
    self:onClear()
end

function BullectParabolaEffect:onUpdateEffect()
    if not self._isEndEffect then
		return
	end

    if not self._effectActor then 
        return
    end

    self._effectActor:onUpdateEffect()
end

function BullectParabolaEffect:onUpdateWaitEffect()
    local lens = table.nums(self._waitEffectList)
    if lens <= 0 then
        return 
    end
    local waitEffect = self._waitEffectList[1]
    if waitEffect then
        lt.BulletManager:addBulletToMap(waitEffect)
        table.remove(self._waitEffectList, 1)
    end
end

function BullectParabolaEffect:setEndCallBack(callback)
    self._callback = callback
end


function BullectParabolaEffect:setTarget(x, y, z, step_pixel)
    -- 保存目标位置
    self._targetX = x
    self._targetY = y
    self._targetZ = z

    -- 计算移动方向
    local moveX = self._targetX - self._pixelX
    local moveY = self._targetY - self._pixelY
    local moveZ = self._targetZ - self._pixelZ

    -- 设置移动方向
    self._direction = lt.MapUtil:getDirectionToPosition(self._pixelX, self._pixelY, self._targetX, self._targetY)

    -- 计算移动长度
    self._len = math.sqrt(moveX * moveX + moveY * moveY + moveZ * moveZ)

    if self._len == 0 then
        self._stepX = 0
        self._stepY = 0
        self._stepZ = 0
    else
        -- 计算单位移动步长
        self._stepX = moveX / self._len * step_pixel
        self._stepY = moveY / self._len * step_pixel
        self._stepZ = moveZ / self._len * step_pixel
    end

    self._stepPixel = step_pixel

	local steps = self._len / self._stepPixel
	self._radStep = Constant.FPI / steps
	self._radCurrent = 0
end

function BullectParabolaEffect:setPixelPosition(x, y, z)
    self._pixelX = x;
	self._pixelY = y;
	self._pixelZ = z;
    self:setPosition(self._pixelX, self._pixelY + self._pixelZ)
end

function BullectParabolaEffect:setDirection(direction)
    self._direction = direction
end

function BullectParabolaEffect:setTargetTile(x, y) 
    self._targetTileX = x
    self._targetTileY = y
end
function BullectParabolaEffect:setCount(endFrame)
    self._endFrameLink = endFrame
end

return BullectParabolaEffect
