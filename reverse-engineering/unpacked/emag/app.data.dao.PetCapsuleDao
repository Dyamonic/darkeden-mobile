
local PetCapsuleDao = {}

function PetCapsuleDao:queryAll()
    local petCapsuleMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM PetCapsule") do
        local petCapsuleMeta = lt.PetCapsuleMeta.new(row)
        petCapsuleMap[petCapsuleMeta:getId()] = petCapsuleMeta
    end

    return petCapsuleMap
end

return PetCapsuleDao