
local MonsterMeta = class("MonsterMeta")

MonsterMeta.RACE = {
    SHILING     = 100,
    SHOUWEI1    = 107,  -- 守卫
    SHOUWEI2    = 112,  -- 守卫
}

MonsterMeta.GRADE = {
	LINSHOU		= 5,  -- 灵兽
	ZHAOHUAN2	= 6,  -- 召唤
    TRAP        = 7,  -- 陷阱
}

MonsterMeta._id      = nil -- 怪物ID
MonsterMeta._modelId = nil -- 模型ID
MonsterMeta._race    = nil -- 怪物种族
MonsterMeta._grade	 = nil -- 怪物类型
MonsterMeta._name    = nil -- 怪物名称
MonsterMeta._scale   = nil -- 尺寸
MonsterMeta._level   = nil -- 怪物等级

function MonsterMeta:ctor(row)
	self:initWithRow(row)
end

function MonsterMeta:initWithRow(row)
    self._id            = row.MonsterIdx
    self._modelId       = row.Appr
    self._race          = row.Race
    self._grade			= row.Grade
    self._name          = row.MonsterName or ""
    self._scale         = row.Scale / 10000
    self._actionCombId  = row.ActionCombId
end

function MonsterMeta:dump()
    lt.LogUtil:debug(">>>>>>>>>>>>>>>>>>>> MonsterMeta >>>>>>>>>>>>>>>>>>>>")
    lt.LogUtil:debug("_id:" .. self._id)
    lt.LogUtil:debug("_modelId:" .. self._modelId)
    lt.LogUtil:debug("<<<<<<<<<<<<<<<<<<<< MonsterMeta <<<<<<<<<<<<<<<<<<<<")
end

-- Setter && Getter
function MonsterMeta:getId()
    return self._id
end

function MonsterMeta:getModelId()
    return self._modelId
end

function MonsterMeta:getRace()
    return self._race
end

function MonsterMeta:getGrade()
    return self._grade
end

function MonsterMeta:getName()
    return self._name
end

function MonsterMeta:getScale()
    return self._scale
end

function MonsterMeta:getLevel()
    return self._level
end

function MonsterMeta:getActionCombId()
    return self._actionCombId
end

return MonsterMeta
