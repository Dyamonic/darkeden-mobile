
local NpcMeta = class("NpcMeta")

NpcMeta._mapCode   = nil
NpcMeta._npcPosX   = nil
NpcMeta._npcPosY   = nil
NpcMeta._npcName   = nil
NpcMeta._showName  = nil
NpcMeta._npcType   = nil
NpcMeta._npcFigure = nil
NpcMeta._npcId     = nil
NpcMeta._direction = nil
NpcMeta._mapResId  = nil
NpcMeta._contem    = nil
NpcMeta._display   = nil
NpcMeta._color     = nil -- 模型所有颜色
NpcMeta._roleModel = nil -- 人形npc外观
NpcMeta._monColor  = nil -- 模型局部颜色
NpcMeta._clientNpcId = nil -- 为了防止和服务器id重复

function NpcMeta:ctor(row)
	self:initWithRow(row)
end

function NpcMeta:initWithRow(row)
    self._mapCode   = row.Map
    self._npcPosX   = row.Xpot
    self._npcPosY   = row.Ypot
    self._npcName   = row.NpcName
    self._showName  = row.ShowName
    self._npcType   = row.NpcType
    self._npcStartTalkId   = row.StartTalkId
    self._npcFaceId = row.Face
    self._npcId     = row.NpcIndex
    self._direction = row.Direction
    self._mapResId  = row.MapResId
    self._npcFigure = tonumber(row.Figure)
    self._contem    = row.Contem
    self._dialogueDistance = row.DialogueDistance
    self._display   = row.Display
    if row.RoleModel and row.RoleModel ~= "" then
        self._roleModel = self:splitRoleModel(row.RoleModel)
    end

    -- 模型所有颜色
    if row.Color and row.Color ~= "" then
        self._color = self:string2RGB01(row.Color)
    end

    -- 模型局部颜色
    if row.MonColor and row.MonColor ~= "" then
        self._monColor = self:string2RGB01(row.MonColor)
    end

    if self._npcId then
        self._clientNpcId = lt.Constant.CLONETAG.NPCDEFAULT .. self._npcId
    end
end

-- Setter && Getter
function NpcMeta:getMapCode()
    return self._mapCode
end

function NpcMeta:getNpcPos()
    return self._npcPosX,self._npcPosY
end

function NpcMeta:getNpcName()
    return self._npcName
end

function NpcMeta:getShowName()
    return self._showName
end

function NpcMeta:getNpcType()
    return self._npcType
end

function NpcMeta:getNpcFigure()
    return self._npcFigure
end

function NpcMeta:getNpcHeadId()
    return  self._npcFaceId
end

function NpcMeta:getStartTalkId()
    return  self._npcStartTalkId
end

function NpcMeta:getNpcId()
    return self._npcId
end

function NpcMeta:getClientNpcId()
    return self._clientNpcId
end

function NpcMeta:getNpcDirection()
    return self._direction
end

function NpcMeta:getMapResId()
    return self._mapResId
end

function NpcMeta:getContem()
    return self._contem
end

function NpcMeta:getDialogueDistance()
    return self._dialogueDistance
end

function NpcMeta:getDisplay()
    return self._display
end

function NpcMeta:string2RGB01(color)
    local r, g, b = color:match("(%d+),(%d+),(%d+)")
    return cc.vec3((tonumber(r) or 0)/255, (tonumber(g) or 0)/255, (tonumber(b) or 0)/255)
end

-- function NpcMeta:string2RGB(color)
--     local r, g, b = color:match("(%d+),(%d+),(%d+)")
--     return cc.vec3(tonumber(r) or 0, tonumber(g) or 0, tonumber(b) or 0)
-- end

function NpcMeta:getColor()
    return self._color
end

function NpcMeta:getMonColor()
    return self._monColor
end

function NpcMeta:splitRoleModel(roleModel)
    local modelInfo = {}
    local roleModelList = roleModel:split(",")
    
    modelInfo.race     = tonumber(roleModelList[1]) or 0
    modelInfo.gender   = tonumber(roleModelList[2]) or 0
    modelInfo.helmet   = tonumber(roleModelList[3]) or 0
    modelInfo.bodyAppr = tonumber(roleModelList[4]) or 0
    modelInfo.trousers = tonumber(roleModelList[5]) or 0
    modelInfo.weapon   = tonumber(roleModelList[6]) or 0

    return modelInfo
end

function NpcMeta:getRoleModel()
    return self._roleModel
end

return NpcMeta
