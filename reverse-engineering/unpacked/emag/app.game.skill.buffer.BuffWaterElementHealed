local BuffWaterElementHealed = class("BuffWaterElementHealed", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local ScheduleUtil  = lt.ScheduleUtil
local CacheManager = lt.CacheManager

--[[
    其他人被水元素加Buff
]]
function BuffWaterElementHealed:ctor(time, actor, skilllevel)    
    BuffWaterElementHealed.super.ctor(self, BuffEnum.EFFECTSTATUS_WATER_ELEMENTAL_HEALED, time, actor)
    -- 被攻击播特效即可
    local skillId = SkillEnum.SKILL_SUMMON_OF_WATER_ELEMENTAL
    local actionInfoMetas = CacheManager:getHitMetas(skillId, 0)
    actor:playParallelEffectSpecial(skillId, {actionInfoMetas[2]})
end

function BuffWaterElementHealed:onClear()
    BuffWaterElementHealed.super.onClear(self)
end


return BuffWaterElementHealed
