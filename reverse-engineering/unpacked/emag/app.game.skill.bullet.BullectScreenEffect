local BullectScreenEffect = class("BullectScreenEffect", lt.BulletBase)
local EffectActor = lt.EffectActor
--[[
    地图任意位置释放单个特效
]]
local CacheManager = lt.CacheManager
local ScheduleUtil = lt.ScheduleUtil

function BullectScreenEffect:ctor(skillId, direction, releaseXY, anchorPoint)
    BullectScreenEffect.super.ctor(self, skillId)
    self._skillId = skillId
    self._direction = direction
    self.releaseXY = releaseXY
    self._effectActor = nil
    self:setAnchorPoint(anchorPoint or cc.p(0.5, 0.5))
    self:setPosition(releaseXY)
end

function BullectScreenEffect:onClear()
    if self._effectActor then
        self._effectActor:onClear()
        self._effectActor = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end

function BullectScreenEffect:setEnd()
    self._waitingForClear = true
end

function BullectScreenEffect:setEndByDelay(delay)
    ScheduleUtil:performWithDelayGlobal(function()
        self:setEnd()
    end, delay)
end

function BullectScreenEffect:setPositionEx(x, y)
    self:setPosition(x, y)
end
function BullectScreenEffect:setPostionMN(m, n)
    local x, y = lt.MapUtil:calcMNMid(m, n)
    self:setPosition(x, y)
end

function BullectScreenEffect:onUpdate()
    self._effectActor:onUpdateEffect()

    if self._effectActor:isEndEffect() then
        self:setEnd()
    end
end

function BullectScreenEffect:addEffect(skillId, meta, isLoop)
    if not meta then
        yflog:Info("BullectScreenEffect:addEffect the skill:%d has no skill effect meta", skillId)
        return
    end
    self._effectActor = EffectActor.new(meta, self._direction, nil, isLoop)
    self:addChild(self._effectActor)
end

function BullectScreenEffect:setStep(step)
    self._effectActor:setStep(step)
end

return BullectScreenEffect