---@class UICompGuildApplyListCell
--- 公会申请列表cell
local UICompGuildApplyListCell = class("UICompGuildApplyListCell", lt.UIGButtonBase)
local NtfManager = lt.NtfManager
local CommonModule = lt.CommonModule
local Constant = lt.Constant
local CacheManager = lt.CacheManager
local GuildModule = lt.GuildModule

UICompGuildApplyListCell.ChangeSkinConf = {
    ["Guild"] = {
        ["bg"] = "bg_gonghuixt_13",
    },

    ["CommonTL"] = {
        ["btn_reject"] = { loaderdown = "bg_beibao_ren_anniu" },
        ["btn_agree"] = { loaderdown = "bg_beibao_ren_anniu" },
    }
}
function UICompGuildApplyListCell:ctor()
    UICompGuildApplyListCell.super.ctor(self)
    self._playerInfo = nil
end

function UICompGuildApplyListCell:onClear()
    self._lblName    = nil
    self._lblLv      = nil
    self._lblGrade   = nil
    self._imgJob     = nil
    self._btnReject  = nil
    self._btnAgree   = nil
    self._playerInfo = nil
    UICompGuildApplyListCell.super.onClear(self)
end

function UICompGuildApplyListCell:onEnter()
    UICompGuildApplyListCell.super.onEnter(self)
    self._btnReject:addClickListener(handler(self, self.onClickRejectBtn))
    self._btnAgree:addClickListener(handler(self, self.onClickAgreeBtn))
end

function UICompGuildApplyListCell:onExit()
    self._btnReject:removeClickListener()
    self._btnAgree:removeClickListener()
    UICompGuildApplyListCell.super.onExit(self)
end

function UICompGuildApplyListCell:onConstruct()
    self._lblName   = self:getChild("lbl_name")
    self._lblLv     = self:getChild("lbl_lv")
    self._lblGrade  = self:getChild("lbl_grade")
    self._imgJob    = self:getChild("img_job")
    self._btnReject = self:getChild("btn_reject")
    self._btnAgree  = self:getChild("btn_agree")
end

function UICompGuildApplyListCell:setInfo(info, index)
    self._lblName:setText(info.name)
    local isAdvanve = info.advanceState
    if isAdvanve == Constant.AdvState.NotAdv then
        local level = info.level or 0
        self._lblLv:setText("Lv." .. level)
    else
        local level = info.advanceLv or 1
        self._lblLv:setText("Av." .. level)
    end
    local gradeLevel = info.gradeLv <= 0 and 1 or info.gradeLv
    local rankData = CacheManager:getRoleRankByRaceAndLvl(info.race, gradeLevel)
    self._lblGrade:setText(rankData and rankData:getName() or "")
    self._imgJob:setURL(string.format(_GURL.GetImageJob, info.iconId))

    self._playerInfo = info
end

function UICompGuildApplyListCell:setSelected(select)
    self._bgSelect:setVisible(select)
end

function UICompGuildApplyListCell:onClickRejectBtn(obj)
    local playerId = self._playerInfo.playerId
    GuildModule:sendGuildApplyOptReq(playerId, 2) --// 1.同意  2.拒绝
end

function UICompGuildApplyListCell:onClickAgreeBtn(obj)
    local playerId = self._playerInfo.playerId
    GuildModule:sendGuildApplyOptReq(playerId, 1) --// 1.同意  2.拒绝
end

return UICompGuildApplyListCell
