-- 标记圣水制造（人医）
function ItemModule:createHolyPotionDoctor(item)
    local itemId = item:getItemId()
    local itemIds = { 301015 , 301016 , 301017, 301018 }
    for _,v in ipairs(itemIds) do
        if itemId == v and item:getObjId() then
            table.insert(self._holyPotionDoctorArr, item:getObjId())
            break
        end
    end
end

function ItemModule:getCreateHolyPotionDoctor()
    return self._holyPotionDoctorArr or {}
end

function ItemModule:clearCreateHolyPotionDoctor(objId)
    if objId and self._holyPotionDoctorArr then
        for i, objvalue in ipairs(self._holyPotionDoctorArr) do
            if objId == objvalue then
                table.remove(self._holyPotionDoctorArr, i)
                break
            end
        end
    end
end

-- 装备部位 (类型,种族 -> 部位)
function ItemModule:getEquipPartName(kind)
    if not kind  then
        return ""
    end
    local heroData = GameModule:getHeroData()
    if not heroData then
        return ""
    end
    local race = heroData:getRace()
    if kind == Constant.EquipKind.Helmet then
        if race == Constant.RaceType.Ousters then
            return "发圈"
        else
            return "头盔"
        end
    elseif kind == Constant.EquipKind.Clothes or 
        kind == Constant.EquipKind.TransferEquipmentLeft or
        kind == Constant.EquipKind.TransferEquipmentRight then
        return "上身装备"
    elseif kind == Constant.EquipKind.Necklace then
        return "项链"
    elseif kind == Constant.EquipKind.Shield then
        return "副手武器"
    elseif kind == Constant.EquipKind.Glove then
        return "手套"
    elseif kind == Constant.EquipKind.Bracelet then
        return "手镯"
    elseif kind == Constant.EquipKind.Ring then
        return "戒指"
    elseif kind == Constant.EquipKind.Shoes then
        return "鞋子"
    elseif kind == Constant.EquipKind.Trousers then
        if race == Constant.RaceType.Ousters then
            return "靴子"
        else
            return "裤子"
        end
    elseif kind == Constant.EquipKind.Belt then
        if race == Constant.RaceType.Ousters then
            return "臂环"
        else
            return "腰带"
        end
    elseif kind == Constant.EquipKind.Arms then
        return "主武器"
    elseif kind == Constant.EquipKind.ElfStone then
        return "精灵石"
    elseif kind == Constant.EquipKind.Amulet then
        return "护身符"
    elseif kind == Constant.EquipKind.Earrings then
        return "耳环"
    end
    
    return ""
end

-- 自动售卖 筛选
-- 根据种族分类
function ItemModule:getAutoRecycleMap()
    local heroData = GameModule:getHeroData()
    if not heroData then
        return
    end
    local myrace = heroData:getRace()
    local list = CacheManager:getRecycleSettingsMap()
    local mapTable = {}
    for _, meta in ipairs(list or {}) do
        local race = meta:getOccupation() or 0
        if race == 0 or myrace == race then
            local first = meta:getClass() -- 大类
            local second = meta:getType() -- 小类
            if not mapTable[first] then
                mapTable[first] = {}
            end
            if not mapTable[first][second] then
                mapTable[first][second] = {}
            end
            table.insert(mapTable[first][second], meta)
        end
    end

    local function remapNestedTable(t)
        local result = {}
        local keys = {}

        -- 提取所有 key 并排序以保证顺序一致
        for k in pairs(t) do
            table.insert(keys, k)
        end
        -- table.sort(keys)

        local idx = 1
        for _, k in ipairs(keys) do
            local subTable = t[k]
            local subResult = {}
            local subKeys = {}

            -- 子级 key 同样提取并排序
            for sk in pairs(subTable) do
                table.insert(subKeys, sk)
            end
            -- table.sort(subKeys)

            local subIdx = 1
            for _, sk in ipairs(subKeys) do
                subResult[subIdx] = subTable[sk] -- 第三层数据保持不变
                subIdx = subIdx + 1
            end

            result[idx] = subResult
            idx = idx + 1
        end

        return result
    end

    return remapNestedTable(mapTable)
end

function ItemModule:getAutoRecycleFilterMap()
    if not self._recycleSettingsFilterMap then
		self._recycleSettingsFilterMap = self:getAutoRecycleMap()
	end
	return self._recycleSettingsFilterMap
end
-- 装备或道具音效
function ItemModule:playSoundByItemInfo(itemInfo)
    if itemInfo == nil then return end
    local itemType = itemInfo:getItemType()
    local kind = itemInfo:getMetaKind()
    local type = itemInfo:getMetaType()
    local soundName = nil
    if itemType == ItemType.ITEM_TYPE_PROP then
        if kind == PropType.AMMUNITION then
            --弹药
            soundName = SoundEffect.MagazineItemMoveSound
        elseif kind == PropType.STRENGTHEN then
            --强化类道具
            soundName = SoundEffect.JewelItemMoveSound
        end
    elseif itemType == ItemType.ITEM_TYPE_EQUIP then
        local race = GameModule:getHeroRace()
        if race == Constant.RaceType.Slayer then
            --人族
            if kind == Constant.EquipKind.Clothes or kind == Constant.EquipKind.Trousers then
                --衣服和裤子
                soundName = SoundEffect.ClothItemMoveSound
            elseif kind == Constant.EquipKind.Arms then
                --武器
                if Constant.IsGun[type] then
                    --枪
                    soundName = SoundEffect.GunItemMoveSound
                else
                    soundName = SoundEffect.SwordItemMoveSound
                end
            elseif kind == Constant.EquipKind.Shield then
                --盾牌
                soundName = SoundEffect.ShieldItemMoveSound
            elseif kind == Constant.EquipKind.Bracelet then
                --手镯
                soundName = SoundEffect.BraceletItemMoveSound
            elseif kind == Constant.EquipKind.Shoes then
                --鞋子
                soundName = SoundEffect.ShoesItemMoveSound
            elseif kind == Constant.EquipKind.Glove then
                --手套
                soundName = SoundEffect.GloveItemMoveSound
            elseif kind == Constant.EquipKind.Helmet then
                --头盔
                soundName = SoundEffect.HelmItemMoveSound
            elseif kind == Constant.EquipKind.Belt then
                --腰带
                soundName = SoundEffect.BeltItemMoveSound
            end
        elseif race == Constant.RaceType.Vampire then
            --鬼族
            if kind == Constant.EquipKind.Clothes then
                --衣服
                soundName = SoundEffect.ClothItemMoveSound
            elseif kind == Constant.EquipKind.Bracelet then
                --手镯
                soundName = SoundEffect.BraceletItemMoveSound
            elseif kind == Constant.EquipKind.Glove then
                --拳套
                soundName = SoundEffect.GloveItemMoveSound
            end
        elseif race == Constant.RaceType.Ousters then
            --魔族
            if kind == Constant.EquipKind.Belt then
                --臂环
                soundName = SoundEffect.ArmsbandItemMoveSound
            elseif kind == Constant.EquipKind.Trousers then
                --靴子
                soundName = SoundEffect.BootsItemMoveSound
            elseif kind == Constant.EquipKind.Arms and type == Constant.WeaponType.BattleWheel then
                --战轮
                soundName = SoundEffect.ChakramItemMoveSound
            elseif kind == Constant.EquipKind.Helmet then
                --发圈
                soundName = SoundEffect.CircletItemMoveSound
            elseif kind == Constant.EquipKind.Clothes then
                --大衣
                soundName = SoundEffect.CoatItemMoveSound
            elseif kind == Constant.EquipKind.ElfStone then
                --精灵石
                soundName = SoundEffect.ElementalStoneItemMoveSound
            elseif kind == Constant.EquipKind.Necklace then
                --项链
                soundName = SoundEffect.PendantItemMoveSound
            elseif kind == Constant.EquipKind.Ring then
                --戒指
                soundName = SoundEffect.RingItemMoveSound
            elseif kind == Constant.EquipKind.Arms and type == Constant.WeaponType.WristGuard then
                --护腕
                soundName = SoundEffect.WristletItemMoveSound
            end
        end
    end
    if soundName then
        lt.AudioManager:playBattleSound(soundName)
    end
end

-- 根据设置类型 筛分
function ItemModule:getAutoRecycleMapBySettingsType()
    local heroData = GameModule:getHeroData()
    if not heroData then
        return
    end
    local myrace = heroData:getRace()
    local list = CacheManager:getRecycleSettingsMap()
    local mapTable = {}
    for _, meta in ipairs(list or {}) do
        local race = meta:getOccupation() or 0
        if race == 0 or myrace == race then
            local first = meta:getClass() -- 大类
            local second = meta:getSettingsType() -- 设置类型
            if not mapTable[first] then
                mapTable[first] = {}
            end
            if not mapTable[first][second] then
                mapTable[first][second] = {}
            end
            table.insert(mapTable[first][second], meta)
        end
    end
    return mapTable
end

function ItemModule:getAutoRecycleTypeFilterMap()
    if not self._recycleSettingsTypeFilterMap then
		self._recycleSettingsTypeFilterMap = self:getAutoRecycleMapBySettingsType()
	end
	return self._recycleSettingsTypeFilterMap
end

function ItemModule:checkAutoRecycle(item)
    if not item then
        return false
    end

    local itemType = item:getItemType()
    local mapData = self:getAutoRecycleTypeFilterMap()

    if itemType == Constant.ItemType.ITEM_TYPE_PROP then
        -- 自动买药的 不售卖
        local itemId = item:getItemId()
        if lt.AutoFightManager:isAutoBuyItem(itemId) then
            return false
        end
        return self:checkPropAutoRecycle(item, mapData)
    elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
        local isAllSelect = self:checkRecycleTypeAllSelect()
        if not isAllSelect then
            return false
        end
        local list = self:getAutoEquipList() --自动回收列表 不售卖
        for i,v in ipairs(list or {}) do
            if v:getItemUid() == item:getItemUid() then
                return false
            end
        end
        return self:checkEquipAutoRecycle(item, mapData)
    end

    return false
end

-- 处理道具类型的自动回收
function ItemModule:checkPropAutoRecycle(item, mapData)
    local mapInfo = mapData[Constant.ItemType.ITEM_TYPE_PROP]
    if not mapInfo then return false end

    local itemIdx = item:getItemId()
    local type2Array  = mapInfo[Constant.SettingsType.ItemID]

    -- 先检查类型2匹配
    if type2Array then
        for _, meta in ipairs(type2Array) do
            local valueRange = string.split(meta:getValueRange(), ",")
            if tonumber(valueRange[1]) == Constant.ItemType.ITEM_TYPE_PROP and itemIdx == tonumber(valueRange[2]) then
                if self:isMetaEnabled(meta) then
                    return true
                else
                    return false
                end
            end
        end
    end

    -- 再检查类型1匹配
    local type1Array = mapInfo[Constant.SettingsType.ItemType] or {}
    local kind = item:getMetaKind()
    local type = item:getMetaType()

    for _, meta in ipairs(type1Array) do
        local valueRange = string.split(meta:getValueRange(), ",")
        if tonumber(valueRange[1]) == kind and (tonumber(valueRange[2]) == 0 or tonumber(valueRange[2]) == type) then
            if self:isMetaEnabled(meta) then
                return true
            else
                return false
            end
        end
    end

    return false
end

-- 处理装备类型的自动回收
function ItemModule:checkEquipAutoRecycle(item, mapData)
    local mapInfo = mapData[Constant.ItemType.ITEM_TYPE_EQUIP]
    if not mapInfo then return false end



    -- 检查装备类型设置
    local equipTypeArray = mapInfo[Constant.SettingsType.EquipType]
    if equipTypeArray then
        -- 没勾选的类型 不判断
        local isInEquipType = false
        local kind = item:getMetaKind()
        local type = item:getMetaType()
        for _, meta in ipairs(equipTypeArray or {}) do
            local valueRange = string.split(meta:getValueRange(), ",")
            if tonumber(valueRange[1]) == kind and (tonumber(valueRange[2]) == 0 or tonumber(valueRange[2]) == type) then
                if not self:isMetaEnabled(meta) then
                    return false
                end
                isInEquipType = true
            end
        end
        if not isInEquipType then
            return false
        end
    end

    -- 检查装备等级设置
    local equipLvArray = mapInfo[Constant.SettingsType.EquipLv]
    if equipLvArray then
        local needLv = item:getMetaNeedLv() or 0
        local isInEquipLv = false
        for _, meta in ipairs(equipLvArray or {}) do
            local valueRange = string.split(meta:getValueRange(), ",")
            local minLv = tonumber(valueRange[1]) or 0
            local maxLv = tonumber(valueRange[2]) or 0
            if minLv <= needLv and maxLv >= needLv then
                if not self:isMetaEnabled(meta) then
                    return false
                end
                isInEquipLv = true
            end
        end
        if not isInEquipLv then
            return false
        end
    end

    -- 检查属性限制
    local equipPropList = mapInfo[Constant.SettingsType.EquipProp]
    local itemMeta = item:getItemMeta()
    if equipPropList and itemMeta then
        local requireStr = itemMeta:getRequireSTR()
        local requireDex = itemMeta:getRequireDEX()
        local requireInt = itemMeta:getRequireINT()
        local requireSum = itemMeta:getRequireSum()
        -- if requireStr > 0 or requireDex > 0 or requireInt > 0 or requireSum > 0 then
        local isInEquipProp = false
        for _, meta in ipairs(equipPropList or {}) do
            local valueRange = string.split(meta:getValueRange(), ",")
            local minLv = tonumber(valueRange[1]) or 0
            local maxLv = tonumber(valueRange[2]) or 0

            -- 判断当前 meta 是否匹配任意一个属性值
            local matched = false
            if requireStr >= 0 and (minLv <= requireStr and maxLv >= requireStr) then 
                matched = true
            elseif requireDex >= 0 and (minLv <= requireDex and maxLv >= requireDex) then 
                matched = true
            elseif requireInt >= 0 and (minLv <= requireInt and maxLv >= requireInt) then 
                matched = true
            elseif requireSum >= 0 and (minLv <= requireSum and maxLv >= requireSum) then 
                matched = true
            end

            if matched then
                if not self:isMetaEnabled(meta) then
                    return false
                end
                isInEquipProp = true
            end
        end
        if not isInEquipProp then
            return false
        end
        -- end
    end

    -- 检查词条品质
    local equipAffixArray = mapInfo[Constant.SettingsType.EquipAffix]
    if equipAffixArray then
        local quality = item:getQuality()
        local isInEquipAffix = false
        for _, meta in ipairs(equipAffixArray or {}) do
            local value = tonumber(meta:getValueRange())
            if value == quality then
                if not self:isMetaEnabled(meta) then
                    return false
                end
                isInEquipAffix = true
            end
        end
        if not isInEquipAffix then
            return false
        end
    end

    return true
end

-- 判断 Meta 是否启用
function ItemModule:isMetaEnabled(meta)
    local keySetting = PrefManager:getUserValueByKey(GameModule.AUTO_RECYCLE_SETTING .. meta:getIdx())
    local checkselect = keySetting and tonumber(keySetting) or meta:getDefaultSwitch() or 0
    return checkselect == 1
end

-- 判断四大类是否都未勾选（即没有任何回收条件）
function ItemModule:checkRecycleTypeAllSelect()
    local mapData = self:getAutoRecycleTypeFilterMap()
    if not mapData then
        return false, 0
    end

    local equipMap = mapData[Constant.ItemType.ITEM_TYPE_EQUIP]
    if not equipMap then
        return false, 0
    end

    -- 检查指定类型的配置是否至少有一项启用
    local function isAnyMetaEnabled(configArray)
        if not configArray then return false end
        for _, meta in ipairs(configArray) do
            if self:isMetaEnabled(meta) then
                return true
            end
        end
        return false
    end

    local settingsTypes = {
        Constant.SettingsType.EquipType,
        Constant.SettingsType.EquipAffix,
    }

    for _, settingType in ipairs(settingsTypes) do
        local config = equipMap[settingType] or {}
        if next(config ) ~= nil and  (not isAnyMetaEnabled(config)) then
            -- 只要有一个分类下有启用项，就说明不是"全未勾选"
            return false, settingType
        end
    end

    -- EquipLv 和 EquipProp 只有一个就行
    local configLv = equipMap[Constant.SettingsType.EquipLv] or {}
    local configProp = equipMap[Constant.SettingsType.EquipProp] or {}
    local hasLv = next(configLv) ~= nil and isAnyMetaEnabled(configLv)
    local hasProp = next(configProp) ~= nil and isAnyMetaEnabled(configProp)

    if not hasLv and not hasProp then
        -- 两个分类都没有启用项，视为未满足条件
        return false, Constant.SettingsType.EquipLv  -- 或者可以统一用 0 表示复合型失败
    end

    -- 所有分类都没有启用项
    return true, 0
end

-- 背包
function ItemModule:getPackageArray()
    return self._packageArray or {}
end

-- 自动装备List
function ItemModule:getAutoEquipList()
    return self._autoEquipList or {}
end

-- 插入
function ItemModule:addAutoEquipList(item)
    if item then
        table.insert(self._autoEquipList, item)
    end
end

-- 删除
function ItemModule:delAutoEquipList(pos)
    table.remove(self._autoEquipList, pos)
end


function ItemModule:sendVipAutoSellReq(autoFlag,itemList)
    self._autoRecycleFlag = autoFlag or false
    local msg = netcmd_pb.CS_VipAutoSellReq()
    msg.autoFlag = autoFlag or false
    msg.itemUid = itemList or false
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_VIP_AUTO_SELL_REQ), msg)
end

function ItemModule:onVipAutoSellResp(event)
    local proto = event.param
    local ret = proto.ret
    local changeNum = proto.changeNum
    local sellItemNum = proto.sellItemNum
    yflog:Info("--------changeNum-"..changeNum.."--sellItemNum--"..sellItemNum)
    if ret == 0 then
        if not self._autoRecycleFlag then
            local content = string.format("已出售[%s]个物品，获得[%s]金币",sellItemNum,changeNum)
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = content })
        else -- 加入系统消息
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_NEW_SYSTEM_NOTICE, {noticeId = Constant.MessageNoticeId.AotoRecycle,params = {sellItemNum,changeNum}})
        end
    end
end

function ItemModule:setIsEquipListChange(isChange)
    self._equipListChange = isChange
end

function ItemModule:getIsEquipListChange()
    return self._equipListChange
end

function ItemModule:onUpdate()
    if not self:getIsEquipListChange() then -- 背包装备没变化
        return
    end
    -- 自动出售功能需求VIP开启等级
    local vipLv = VipModule:getCurVipLv()
    local autoRecycleNeedVip = VipModule:getVipAutoRecycleLv()
    if (vipLv < tonumber(autoRecycleNeedVip)) then
        self:setIsEquipListChange(false)
        return
    end

    -- 开启自动回收
    local keySetting = PrefManager:getUserValueByKey(GameModule.AUTO_RECYCLE_SETTING_OPEN)
    local checkselect = 0
    if keySetting then
        checkselect = tonumber(keySetting)
    end
    if checkselect ~= 1 then
        self:setIsEquipListChange(false)
        return
    end
    -- yflog:Info("-------------------onUpdate-checkselect-"..checkselect)
    --FIXME 检验背包新增道具再刷新 
    local itemList = {}
    local propList = {} --检验过的道具缓存
    for _, v in ipairs(self._packageArray) do
        local itemIdx = v:getItemId()
        local itemType = v:getItemType()
        if (propList[itemIdx] and itemType == Constant.ItemType.ITEM_TYPE_PROP) or self:checkAutoRecycle(v) then
            -- 检验过的道具不用在检验
            if itemType == Constant.ItemType.ITEM_TYPE_PROP then
                propList[itemIdx] = 1
            end
            table.insert(itemList, v:getItemUid())
        end
    end
    if #itemList > 0 then
        ItemModule:sendVipAutoSellReq(true, itemList)
    end
    self:setIsEquipListChange(false)
end

--检测身上穿着几件套装(返回位置Idx数组)
function ItemModule:checkSuitIdxs(suitMeta)
    local suitIdxs = {}
    if suitMeta:getSuitType() == 1 then
        suitIdxs = self:checkASuitNum(suitMeta)
    elseif suitMeta:getSuitType() == 2 then
        suitIdxs = self:checkBSuitNum(suitMeta)
    end
    return suitIdxs
end

--A类套装检测只有数量判断
function ItemModule:checkASuitNum(suitMeta)
    local suitList = self:getSuitList(suitMeta)
    local suitIdxs = {}
    local suitBonus = suitMeta:getSuitBonus()
    for k, v in ipairs(suitBonus) do
        if #suitList >= v[1] then
            table.insert(suitIdxs, k)
        end
    end
    return suitIdxs
end

--B类套装检测数量判断+套件id判断
function ItemModule:checkBSuitNum(suitMeta)
    local suitList = self:getSuitList(suitMeta)
    local suitIdxs = {}
    local suitBonus = suitMeta:getSuitBonus()
    for k, v in ipairs(suitBonus) do
        if #suitList >= v[1] then
            local isExit = CommonFunc:isInArray(suitList, v[3])
            if isExit then
                table.insert(suitIdxs, k)
            end
        end
    end
    return suitIdxs
end

--获得套装list(去重)
function ItemModule:getSuitList(suitMeta)
    local suitList = {}
    local suitIdx = suitMeta:getIdxId()
    local componentIds = suitMeta:getComponentId()
    if #componentIds == 0 then
        return suitList
    end
    for _, itemInfo in ipairs(self._equipArray) do
        local equipMeta = itemInfo:getItemMeta()
        local effectParam = equipMeta:getEffectParam()
        if effectParam and effectParam ~= "" and effectParam[1][1] == "Suit" then
            if effectParam[1][2] == suitIdx then
                local isExit = CommonFunc:isInArray(componentIds, effectParam[1][3])
                local isAdd = CommonFunc:isInArray(suitList, effectParam[1][3])
                if isExit and not isAdd then
                    table.insert(suitList, effectParam[1][3])
                end
            end
        end
    end
    return suitList
end

function ItemModule:showTips(itemInfo)
    local itemType = itemInfo:getItemType()
    if itemType ==  Constant.ItemType.ITEM_TYPE_PROP then
        self:showPropTips(itemInfo)
    elseif itemType ==  Constant.ItemType.ITEM_TYPE_EQUIP then
        self:showEquipTips(itemInfo)
    end
end

function ItemModule:showPropTips(itemInfo)
    if WndLockManager:getWndLockType() == Constant.WndLockType.Trade or WndLockManager:getWndLockType() == Constant.WndLockType.AutoRecycle then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemInfo, tipsType = Constant.PROPTIPS_FORM.SELL})
    elseif WndLockManager:getWndLockType() == Constant.WndLockType.Repair then
        if WndLockManager:getRepairType() == Constant.RepairType.Repair then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemInfo, tipsType = Constant.PROPTIPS_FORM.REPAIR})
        end
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemInfo, tipsType = Constant.PROPTIPS_FORM.BAG})
    end
end

function ItemModule:showEquipTips(itemInfo)
    if WndLockManager:getWndLockType() == Constant.WndLockType.Trade or WndLockManager:getWndLockType() == Constant.WndLockType.AutoRecycle then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo, tipsType = Constant.EquipShowTipsType.Sell})
    elseif WndLockManager:getWndLockType() == Constant.WndLockType.Repair then
        if WndLockManager:getRepairType() == Constant.RepairType.Repair then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo,tipsType = Constant.EquipShowTipsType.Repair, isBag = true})
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo,tipsType = Constant.EquipShowTipsType.Silver})
        end
    elseif itemInfo:getItemMeta():getKind() == Constant.EquipKind.Contract and self:isEquipOfContractPos(itemInfo) then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo, tipsType = Constant.EquipShowTipsType.RoleEquip})
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo,tipsType = Constant.EquipShowTipsType.Bag})
    end
end

-- 检测契约是否已穿戴
function ItemModule:isEquipOfContractPos(itemInfo)
    local curObjId = itemInfo:getObjId()
    for _, pos in ipairs(ContractPos) do
        local equip = self:getEquipItemByPos(pos)
        if equip then
            local equipObjId = equip:getObjId()
            if curObjId == equipObjId then
            return true 
            end
        end
    end
    return false
end

function ItemModule:checkItemXYChange(preItemInfo, curItemIfno)
    return preItemInfo:getItemX() == curItemIfno:getItemX() and preItemInfo:getItemY() == curItemIfno:getItemY()
end

function ItemModule:showTipsByType(itemInfo,tipsType)
    local itemType = itemInfo:getItemType()
    if itemType ==  Constant.ItemType.ITEM_TYPE_PROP then
        self:showPropDisplayTips(itemInfo,tipsType)
    elseif itemType ==  Constant.ItemType.ITEM_TYPE_EQUIP then
        self:showEquipDisplayTips(itemInfo,tipsType)
    end
end

function ItemModule:showPropDisplayTips(itemInfo,tipsType)
    tipsType = tipsType or Constant.PROPTIPS_FORM.Display
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemInfo, tipsType = tipsType})
end

function ItemModule:showEquipDisplayTips(itemInfo,tipsType)
    tipsType = tipsType or  Constant.EquipShowTipsType.Display
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo,tipsType = tipsType})
end

--获得一件没有附魔的装备(背包和装备栏)
function ItemModule:getNoEnchantEquip()
    for k, v in pairs(self._equipArray) do
        if v and v:getItemType() == Constant.ItemType.ITEM_TYPE_EQUIP then
            local attr = lt.StrengthenModule:transformAffix(v)
            if #attr == 0 then
                return v
            end
        end
    end
    for k,v in pairs(self._packageArray) do
        if v and v:getItemType() == Constant.ItemType.ITEM_TYPE_EQUIP then
            local attr = lt.StrengthenModule:transformAffix(v)
            if #attr == 0 then
                return v
            end
        end
    end
    return nil
end

--获得一件有附魔的装备(背包和装备栏)
function ItemModule:getEnchantEquip()
    for k, v in pairs(self._equipArray) do
        if v and v:getItemType() == Constant.ItemType.ITEM_TYPE_EQUIP then
            local attr = lt.StrengthenModule:transformAffix(v)
            if #attr > 0 then
                local isMax = lt.StrengthenModule:getEnchantMax(attr)
                if not isMax then
                    return v
                end
            end
        end
    end
    for k,v in pairs(self._packageArray) do
        if v and v:getItemType() == Constant.ItemType.ITEM_TYPE_EQUIP then
            local attr = lt.StrengthenModule:transformAffix(v)
            if #attr > 0 then
                local isMax = lt.StrengthenModule:getEnchantMax(attr)
                if not isMax then
                    return v
                end
            end
        end
    end
    return nil
end

--使用物品(按itemidx, itemtype, count)
function ItemModule:sendUseItemByIndex(itemIdx, itemType, count)
    local msg = netcmd_pb.CS_UseItemByIndexReq()
    msg.itemIdx = itemIdx
    msg.itemType = itemType
    msg.count = count
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_USE_ITEM_BY_INDEX_REQ), msg)
end

--使用物品回调
function ItemModule:onUseItemByIndex(event)
    local proto = event.param
    if proto.ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = GReadText.KEY_USE_ITEM_LIMIT19})
    end
end

function ItemModule:getWeaponTypeByWeaponAppr(weaponAppr)
    local weapon = weaponAppr
    local weaponType = nil
    if weapon and weapon ~= "" then
        local weaponId = tonumber(string.split(weapon,",")[1])
        if type(weaponId) == "number" then
            local weaponMeta = lt.CacheManager:queryEquipMeta(weaponId)
            if weaponMeta then
                weaponType = weaponMeta:getType()
            end
        end
    end

    return weaponType
end

--
function ItemModule:getSuitEquipAttr(item)
    if not item then
        return ""
    end
    local suitTableStr = ""
    local itemConfig = item:getItemMeta()
    local attributeDisplay = itemConfig:getAttributeDisplay()
    local displays = string.split(attributeDisplay, ",")
    -- 力量
    if lt.StrengthenModule:getAttrShow(displays[Constant.EqAttrShowType.STR]) then
        local str = item:getTotalStr()
        local titleName = GReadText.KEY_STRENGTHEN_TIPS63.." : "
        suitTableStr = titleName.."+"..str
    end

    -- 敏捷
    if lt.StrengthenModule:getAttrShow(displays[Constant.EqAttrShowType.DEX]) then
        local dex = item:getTotalDex()
        local titleName = GReadText.KEY_STRENGTHEN_TIPS64.." : "
        suitTableStr = titleName.."+"..dex
    end

    -- 智力
    if lt.StrengthenModule:getAttrShow(displays[Constant.EqAttrShowType.INT]) then
        local int = item:getTotalInt()
        local titleName = GReadText.KEY_STRENGTHEN_TIPS65.." : "
        suitTableStr = titleName.."+"..int
    end

    -- 物理伤害
    if lt.StrengthenModule:getAttrShow(displays[Constant.EqAttrShowType.PDAM]) then
        local pdam = item:getTotalPdam()
        local titleName = GReadText.KEY_STRENGTHEN_TIPS66.." : "
        suitTableStr = titleName.."+"..pdam
    end

    -- 魔法伤害
    if lt.StrengthenModule:getAttrShow(displays[Constant.EqAttrShowType.MDAM]) then
        local mdam = item:getTotalMdam()
        local titleName = GReadText.KEY_STRENGTHEN_TIPS67.." : "
        suitTableStr = titleName.."+"..mdam
    end

    -- 物理防御
    if lt.StrengthenModule:getAttrShow(displays[Constant.EqAttrShowType.PPRO]) then
        local ppro = item:getTotalPpro()
        local titleName = GReadText.KEY_STRENGTHEN_TIPS68.." : "
        suitTableStr = titleName.."+"..ppro
    end

    -- 魔法防御
    if lt.StrengthenModule:getAttrShow(displays[Constant.EqAttrShowType.MPRO]) then
        local mpmo = item:getTotalMpmo()
        local titleName = GReadText.KEY_STRENGTHEN_TIPS69.." : "
        suitTableStr = titleName.."+"..mpmo
    end

    -- 总能力
    if lt.StrengthenModule:getAttrShow(displays[Constant.EqAttrShowType.ATTR]) then
        local attr = item:getTotalAttr()
        local titleName = GReadText.KEY_EQUIP_TIPS44.." : "
        suitTableStr = titleName.."+"..attr
    end

    -- 对怪增伤
    if lt.StrengthenModule:getAttrShow(displays[Constant.EqAttrShowType.DBTM]) then
        local dbtm = item:getTotalDbtm()
        local titleName = GReadText.KEY_EQUIP_TIPS45.." : "
        suitTableStr = titleName.."+"..dbtm.."%"
    end

    -- 对人增伤
    if lt.StrengthenModule:getAttrShow(displays[Constant.EqAttrShowType.DBTP]) then
        local dbtp = item:getTotalDbtp()
        local titleName = GReadText.KEY_EQUIP_TIPS46.." : "
        suitTableStr = titleName.."+"..dbtp.."%"
    end

    return suitTableStr
end
