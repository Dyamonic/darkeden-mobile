function ItemModule:calcItemsXY(itemArr, manager)
    local gridX = 1
    local gridY = 1
    local maxHeight = 1

    for _, itemInfo in ipairs(itemArr) do
        -- 找到可以放置道具的起始位置
        local aMeta = itemInfo:getItemMeta()
        local itemSizeIndex = aMeta:getItemSize()
        local gridWidth = lt.Constant.ITEMSIZE[itemSizeIndex].width
        local gridHeight = lt.Constant.ITEMSIZE[itemSizeIndex].height

        while true do
            if manager:isAreaFree(gridX, gridY, gridWidth, gridHeight) then
                itemInfo:setFiterXY(gridX, gridY)
                manager:placeItem(gridX, gridY, gridWidth, gridHeight)
                local height = gridY + gridHeight - 1
                if height > maxHeight then
                    maxHeight = height
                end
                break
            end

            -- 如果当前位置不合适，移动到下一个位置
            local totalWidth, totalHeight = manager:getGridWH()
            gridX = gridX + 1
            if gridX > totalWidth then
                gridX = 1
                gridY = gridY + 1
            end
            -- 如果超出背包范围，停止查找
            if gridY > totalHeight then
                print("背包已满，无法放置更多道具")
                return 
            end
        end
    end
    return maxHeight
end

function ItemModule:calcItemsMaxXY(itemArr, manager)
    local gridX = 1
    local gridY = 1
    local maxHeight = 1

    for _, itemInfo in ipairs(itemArr) do
        -- 找到可以放置道具的起始位置
        local aMeta = itemInfo:getItemMeta()
        local itemSizeIndex = aMeta:getItemSize()
        local gridWidth = lt.Constant.ITEMSIZE[itemSizeIndex].width
        local gridHeight = lt.Constant.ITEMSIZE[itemSizeIndex].height

        while true do
            if manager:isAreaFree(gridX, gridY, gridWidth, gridHeight) then
                itemInfo:setFiterXY(gridX, gridY)
                manager:placeItem(gridX, gridY, gridWidth, gridHeight)
                local height = gridY + gridHeight - 1
                if height > maxHeight then
                    maxHeight = height
                end
                break
            end

            -- 如果当前位置不合适，移动到下一个位置
            local totalWidth, totalHeight = manager:getGridWH()
            gridX = gridX + 1
            if gridX > totalWidth then
                gridX = 1
                gridY = gridY + 1
            end
        end
    end
    return maxHeight
end

--[[
道具分页签排序规则：
1. 空间大小排序，1、2、4、3、6
2. 道具大类
3. 道具小类
4. 稀有度排序
--]]
--[[
装备分页签排序规则：
1. 空间大小排序，1、2、4、3、6
2. 装备类型（大类）
3. 武器类型（小类）
4. 稀有度排序(从大到小，其他从小到大)
--]]

function ItemModule:fiterSort(sortArr)
    table.sort(sortArr, function(a, b)
        local aMeta = a:getItemMeta()
        local bMeta = b:getItemMeta()
        if aMeta:getItemSize() ~= bMeta:getItemSize() then
            if aMeta:getItemSize() == 3 and bMeta:getItemSize() == 4 then
                return false 
            end
            if aMeta:getItemSize() == 4 and bMeta:getItemSize() == 3 then
                return true 
            end
            return aMeta:getItemSize() < bMeta:getItemSize()    
        elseif aMeta:getKind() ~= bMeta:getKind() then
            return aMeta:getKind() < bMeta:getKind()
        elseif aMeta:getType() ~= bMeta:getType() then
            return aMeta:getType() < bMeta:getType()
        elseif aMeta:getItemId() ~= bMeta:getItemId() then
            return aMeta:getItemId() < bMeta:getItemId()
        elseif a:getQuality() ~= b:getQuality() then
            return a:getQuality() > b:getQuality()
        elseif a:getILevel() ~= b:getILevel() then
            return a:getILevel() > b:getILevel()
        end
    end)
end

--[[
强化装备排序规则：
0. 符合要求的装备
1. 装备类型（大类）
2. 武器类型（小类）
3. 空间大小排序，1、2、4、3、6
4. 稀有度排序(从大到小，其他从小到大)
--]]
function ItemModule:fiterStrengthenSort(sortArr)
    table.sort(sortArr, function(a, b)
        local aMeta = a:getItemMeta()
        local bMeta = b:getItemMeta()

        if a:getFilter() ~= b:getFilter() then
            return a:getFilter() > b:getFilter()
        elseif a:getItemType() ~= b:getItemType() then
            return a:getItemType() > b:getItemType()
        elseif aMeta:getKind() ~= bMeta:getKind() then
            return aMeta:getKind() < bMeta:getKind()
        elseif aMeta:getType() ~= bMeta:getType() then
            return aMeta:getType() < bMeta:getType()
        elseif a:getILevel() ~= b:getILevel() then
            return a:getILevel() > b:getILevel()
        elseif aMeta:getItemSize() ~= bMeta:getItemSize() then
            if aMeta:getItemSize() == 3 and bMeta:getItemSize() == 4 then
                return false 
            end
            if aMeta:getItemSize() == 4 and bMeta:getItemSize() == 3 then
                return true 
            end
            return aMeta:getItemSize() < bMeta:getItemSize()    
        elseif a:getQuality() ~= b:getQuality() then
            return a:getQuality() > b:getQuality()
        elseif aMeta:getItemId() ~= bMeta:getItemId() then
            return aMeta:getItemId() > bMeta:getItemId()
        end
    end)
end

function ItemModule:getEmptyPos()
    local table2 = self._expandsPosRecord
    local table1 = {1,2,3,4,5}
        
    local notInTable2 = {}

    local function existsInTable(value, tbl)
        for _, v in ipairs(tbl) do
            if tonumber(v) == tonumber(value) then
                return true
            end
        end
        return false
    end

    for _, value in ipairs(table1) do
        if not existsInTable(value, table2) then
            table.insert(notInTable2, value)
        end
    end
    if #table1 == 0 then
        notInTable2 = table1
    end

    local function findMinValue(t)
        if #t == 0 then return nil end
        local minValue = t[1] 
        for i = 2, #t do     
            if t[i] < minValue then
                minValue = t[i]
            end
        end
        return minValue
    end
    
    local minValue = findMinValue(notInTable2)
    return minValue
end

function ItemModule:calcPage(array)
    local pageNums = {}
    local vPage
    for i,v in ipairs(array) do
        pageNums[v:getPage()] = pageNums[v:getPage()] and (pageNums[v:getPage()] + 1) or 1
    end

    for i,v in ipairs(pageNums) do
        if v < 40 then
            return i
        end
    end

    return #pageNums + 1
end

function ItemModule:insertPackageItem(item)
    table.insert(self._packageArray, item)
    self:fiterBagItems()

    local itemType = item:getItemType()
    if itemType ==  Constant.ItemType.ITEM_TYPE_EQUIP then
        --自动穿戴
        if self._unEquipObjId ~= item:getObjId() and item:getNew() then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_EQUIP_AUTOUSE,{item = item})
        end
    end

    self:setIsEquipListChange(true)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB,{content = string.format("%d_%d",item:getItemType(),item:getItemId()),item = item})
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_CHANGE_EVENT, {typePos = Constant.ItemTypePos.Item_InPackage,item = item})
    -- print("物品添加",item:getObjId())
end

function ItemModule:removePackageItem(index)
    local content,objId = "",nil
    local item = nil
    if self._packageArray and self._packageArray[index] then
        item = self._packageArray[index]
        content = string.format("%d_%d",self._packageArray[index]:getItemType(),self._packageArray[index]:getItemId())
        objId = self._packageArray[index]:getObjId()
    end
    table.remove(self._packageArray, index)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB,{content = content ,item = item})
    if objId then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_CHANGE_EVENT, {typePos = Constant.ItemTypePos.Item_InPackage,objId = objId})
    end
    self:fiterBagItems()
end

function ItemModule:getDepotEmptyPos(curIndex)
    local depotArray = ItemModule:getDepotArray() or {}
    local heroData = GameModule:getHeroData()
    local getMaxDepotPos = heroData:getMaxDepot()
    local maxGroup = math.floor(getMaxDepotPos / 20)
    local groupIndexTable = {}
    for i = 1,maxGroup do
        groupIndexTable[i] = true
    end
    
    local function checkEmptyPos(index)
        local emptyPos = nil
        local startPos = (index-1)*20
        local endPos = (index*20)-1
        for i = startPos, endPos do
            local isExist = false
            for j = 1, #depotArray do
                local depot = depotArray[j]
                if depot:getPos() == i then
                    isExist = true
                    break
                end
            end
            if not isExist then
                emptyPos = i
                break
            end
        end

        
        if emptyPos and emptyPos > getMaxDepotPos then
            emptyPos = nil
        end

        return emptyPos
    end

    local emptyPos = nil
    -- 是否有制定页查询
    if curIndex and groupIndexTable[curIndex] then
        emptyPos = checkEmptyPos(curIndex)
        if emptyPos then
            return emptyPos
        end
        groupIndexTable[curIndex] = false
    end

    -- 从1开始查询
    for i = 1,maxGroup do
        if groupIndexTable[i] then
            emptyPos = checkEmptyPos(i)
            if emptyPos then
                return emptyPos
            end
        end
    end

    return emptyPos
end

function ItemModule:setPackageItemUsing(objId, bool)
    for k,v in ipairs(self._packageArray) do
        if v:getObjId() == objId then
            v:setSellItem(bool)
            return
        end
    end
end

function ItemModule:getItemByItemId(itemId,types)
    for k,v in ipairs(self._packageArray) do
        if v:getItemId() == itemId and v:getItemType() == types then
            return v, k
        end
    end
    for k,v in ipairs(self._beltArray) do
        if v:getItemId() == itemId and v:getItemType() == types then
            return v, k
        end
    end
    return nil, nil
end

-- 从背包里查询第一个物品id相同的物品
function ItemModule:getPackageByItemId(itemId,types)
    for k,v in ipairs(self._packageArray) do
        if v:getItemId() == itemId and v:getItemType() == types then
            return v, k
        end
    end

    return nil, nil
end


-- 通过itemid 获取总量
function ItemModule:getItemAllCountByItemId(itemId, types)
    local count = 0
    for k,v in ipairs(self._packageArray) do
        if v:getItemId() == itemId and v:getItemType() == types then
            count = count + v:getNum()
        end
    end
    return count
end

function ItemModule:getNotMarkItemById(itemId,types)
    for k,v in ipairs(self._packageArray) do
        if v:getItemId() == itemId 
            and v:getItemType() == types 
            and (v:getMarkMapId() == nil or tonumber(v:getMarkMapId()) == 0)
            then
            return v, k
        end
    end
    return nil, nil
end

function ItemModule:getMarkItemById(itemId,types)
    for k,v in pairs(self._packageArray) do
        if v:getItemId() == itemId 
            and v:getItemType() == types 
            and (v:getMarkMapId() and tonumber(v:getMarkMapId()) > 0)
            then
            return v, k
        end
    end
    return nil, nil
end

function ItemModule:getWholeItems(itemId, types)
    local ret = {}
    for i,v in ipairs(self._packageArray) do
        if v:getItemId() == itemId and v:getItemType() == types then
            ret[#ret + 1] = { objId = v:getObjId(), num = v:getNum() }
        end
    end
    return ret
end

function ItemModule:getSingalItemByItemId(itemId,itemType)
    for k,v in ipairs(self._packageArray) do
        if v:getItemId() == itemId and not v:getUseType() and v:getItemType() == itemType then
            return v
        end
    end
    return nil
end

function ItemModule:checkHasItem(itemType, itemid, array)
    if not itemid then 
        return false 
    end

    for k,v in pairs(array) do
        if v:getItemType() == itemType and v:getItemId() == itemid then
            return true
        end
    end
    return false
end

function ItemModule:checkDestroyItem(itemType, itemid)
    local destroyTabel = lt.WeaponDestroyDao:queryAll()
    if not destroyTabel then 
        return false 
    end
    for k,v in pairs(destroyTabel) do
        if k == itemid and itemType == v:getItemType() then
            return true
        end
    end
end

function ItemModule:getItemNum(itemId)
    local num = 0
    for k,v in ipairs(self._packageArray) do
        if v:getItemId() == itemId then
            num = num + v:getNum()
        end
    end
    return num
end

function ItemModule:getItemNumByIdAndType(itemType, itemId, itemBind)
    local num = self:getValueItem(itemType, itemId)
    if num == 0 then
        -- if itemType == Constant.ItemType.ITEM_TYPE_RUNE then
        --     for k,v in ipairs(self._sealArray) do
        --         if v:getItemId() == itemId and (itemBind == nil or (itemBind == v:getIsBind())) then
        --             num = num + v:getNum()
        --         end
        --     end
        -- else
        for k,v in ipairs(self._packageArray) do
            if v:getItemId() == itemId and v:getItemType() == itemType and (itemBind == nil or (itemBind == v:getIsBind())) then
                num = num + v:getNum()
            end
        end
        -- end
    end
    return num
end

function ItemModule:checkItemInPackage(itemType, itemId)
    if itemId == 0 then return false end

    for _,v in ipairs(self._packageArray) do
        if v:getItemId() == itemId and v:getItemType() == itemType then
            return true
        end
    end
    return false
end

