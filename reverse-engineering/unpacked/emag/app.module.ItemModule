-- 根据装备配置创建一个临时的的ItemData
function ItemModule:getItemDataByConfig(itemConfig, limitTime, num)
    limitTime = limitTime or 0
    local itemValueDef = lt.ServerClientEnum.ItemValueDef or {}
    local propertyArray = {}
    for k,v in pairs(itemValueDef) do
        local value = 0
        if v == lt.ServerClientEnum.ItemValueDef.Attr_ItemIdx then
            value = itemConfig:getItemId()
        elseif v == lt.ServerClientEnum.ItemValueDef.Attr_ItemType then
            value = itemConfig:getItemType()
        elseif v == lt.ServerClientEnum.ItemValueDef.Attr_ILevel then
            value = 4
        elseif v == lt.ServerClientEnum.ItemValueDef.Attr_Deadline then
            if limitTime > 0 then
                local serverTime = lt.TimeCounter:serverTime()
                value = serverTime + limitTime
            end
        elseif v == lt.ServerClientEnum.ItemValueDef.Attr_Bound then
            value = 0
        elseif v == lt.ServerClientEnum.ItemValueDef.Attr_Durability then
            if itemConfig:getItemType() == Constant.ItemType.ITEM_TYPE_EQUIP then
                value = itemConfig:getDurability()
            end
        elseif v == lt.ServerClientEnum.ItemValueDef.Attr_UseCount then
            if itemConfig:getKind() == Constant.PropType.TRANSFER and itemConfig:getType() == Constant.PropTypeSub_6.SlayerTransform then
                local maxCount = itemConfig:getEffectParam()[1][2]
                value = maxCount
            end
        elseif v == lt.ServerClientEnum.ItemValueDef.Attr_SuperposeCount then
            value = num or 1
        end
        table.insert(propertyArray, {properCode = v, intValue = value, strValue = ""})
    end
    local item = lt.ItemData.new(0, propertyArray)
    return item
end

-- 根据objProperty创建一个ItemData
function ItemModule:getItemDataByProperty(objProperty)
    local item = lt.ItemData.new(0, objProperty.objprops)
    return item
end

function ItemModule:getObjIdBySkillId(skillId)
    local itemIds = lt.SkillEnum.USE_SKILL_ITEMS[skillId]
    if type(itemIds) ~= "table" then
        return nil
    end

    local itemObjId = nil
    for _,v in ipairs(itemIds) do
        local item = lt.ItemModule:getItemByItemId(v,Constant.ItemType.ITEM_TYPE_PROP)
        if item then
            itemObjId = item:getObjId()
            break
        end
    end

    return itemObjId
end

function ItemModule:getWeaponColor()
    local curRace = lt.GameModule:getHeroRace()
    local equipName = Constant.RaceToJobPanel[curRace] .. "EquipPos"
    local armsPos = Constant[equipName].Arms
    local item = lt.ItemModule:getEquipItemByPos(armsPos)
    if item then
        return self:getAffixColor(item:getFirstAffixId())
    end
end

function ItemModule:getAffixColor(affixId)
    if affixId and tonumber(affixId) > 0 then
        local affixData = lt.CacheManager:getEnchantingAffixMeta(affixId)
        if affixData then
            return affixData:getColor()
        else
            return Constant.DEFALUT_CLOTH_COLOR
        end
    else
        return Constant.DEFALUT_CLOTH_COLOR
    end
end

--检测背包和腰带是否有可安装的子弹
function ItemModule:autoAddBullet()
    for k,v in pairs(self._beltArray) do
        if v:getMetaKind() == Constant.PropType.AMMUNITION then
            if self:checkUseItemAmmunition(v) then
                local objId = v:getObjId()
                self:sendUseItem(objId, 1)
                return true
            end
        end
    end
    for k,v in pairs(self._packageArray) do
        if v:getMetaKind() == Constant.PropType.AMMUNITION then
            if self:checkUseItemAmmunition(v) then
                local objId = v:getObjId()
                self:sendUseItem(objId, 1)
                return true
            end
        end
    end

    return false
end

