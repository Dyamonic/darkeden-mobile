function ItemModule:getItemMetaByStr(str)
    local msg = string.split(str, ":")
    local itemType = tonumber(msg[1])
    local itemIdx = msg[2]
    local num = msg[3]
    local itemMeta = nil
    if itemType == 1 then
        itemMeta = lt.ItemDao:query(itemIdx)
    elseif itemType == 2 then
        itemMeta = lt.EquipDao:query(itemIdx)
    elseif itemType == 3 then
        itemMeta = lt.BookDao:query(itemIdx)
    end
    return itemMeta, num
end

function ItemModule:getItemMetaByItemId(itemType, itemId)
    local itemMeta = nil
    local itemType = tonumber(itemType)
    if itemType == 1 then
        itemMeta = lt.ItemDao:query(itemId)
    elseif itemType == 2 then
        itemMeta = lt.EquipDao:query(itemId)
    elseif itemType == 3 then
        itemMeta = lt.BookDao:query(itemId)
    elseif itemType == lt.Constant.ItemType.ITEM_TYPE_RUNE then
        itemMeta = lt.RuneDao:queryGood(itemId)
    elseif itemType == 5 then
        itemMeta = lt.SpiritEquipDao:queryItem(itemId)
    end
    return itemMeta
end

function ItemModule:getExchangeStr(items,idx)
    local linkstr = ""
    if not items then
        return linkstr
    end
    local strs = StringManager:getString(StringManager.KEY_EXCHANGE_TIPSTR)
    local array = string.split(items:getMateTypeValue(),",")
    for k,v in pairs(array) do
        if v and v ~= "" then
            local data = string.split(v,":")
            if k == #array then
                linkstr = linkstr..self:getItemMetaByItemId(tonumber(data[1]),tonumber(data[2])):getName().."*"..data[3]
            else
                linkstr = linkstr..self:getItemMetaByItemId(tonumber(data[1]),tonumber(data[2])):getName().."*"..data[3]..","
            end
        end
    end
    return string.format(strs[idx],items:getName(),linkstr)
end

--[[
@parma str              数据库item配置字符串
@parma propertyED       属性分割符 默认":"
@parma groupED          物品组分割符
]]
function ItemModule:parse2ItemData(str, propertyED, groupED)
    if not str or str == "" then
        return {}
    end

    propertyED = propertyED or ":"

    local ret = {}
    if groupED then
        local groupData = string.split(str, groupED)
        for i=1, #groupData do
            local temp = string.split(groupData[i], propertyED)
            ret[#ret+1] = { itemType=tonumber(temp[1]), itemId=tonumber(temp[2]), itemNum=tonumber(temp[3]), bind = tonumber(temp[4]), ext1=tonumber(temp[5]), ext2=tonumber(temp[6]) }
        end
    else
        local temp = string.split(str, propertyED)
        ret = { itemType=tonumber(temp[1]), itemId=tonumber(temp[2]), itemNum=tonumber(temp[3]), bind = tonumber(temp[4]), ext1=tonumber(temp[5]), ext2=tonumber(temp[6]) }
    end

    return ret
end

function ItemModule:parseJson2ItemData(str)
    if not str or str == "" then
        return {}
    end
    local ret = {}
    for k,v in pairs(json.decode(str)) do
        if v then
            ret[#ret+1] = {itemType=tonumber(v.Type), itemId=tonumber(v.ID), itemNum=tonumber(v.Num), bind = tonumber(v.Bind), times = v.Deadline}
        end
    end
    return ret
end

function ItemModule:parseServerPhaseItemData(str, kvED, serverPhaseED, propertyED, groupED)
    local ret = {}
    if not str or str == "" then
        return ret
    end

    if not kvED or not serverPhaseED then
        return ret
    end

    local serverPhase = lt.CommonModule:getServerPrase()
    local last = nil

    for i,v in ipairs(string.split(str, serverPhaseED)) do
        local tmp = string.split(v, kvED)

        if tmp[1] and tonumber(tmp[1]) <= serverPhase then
            if last and tonumber(tmp[1]) > last then
                ret = lt.ItemModule:parse2ItemData(tmp[2], propertyED, groupED)
                last = tonumber(tmp[1])
            elseif not last then
                ret = lt.ItemModule:parse2ItemData(tmp[2], propertyED, groupED)
                last = tonumber(tmp[1])
            end
        end
    end

    return ret
end

-- 判断物品是否足够
function ItemModule:enoughItem(itemType, itemId, needNum, param)
    param = param or {}
    itemId = tonumber(itemId)
    local itemNum = 0
    if itemId == Constant.TYPE_VAULE_ITEM.COIN then                 --金币
        itemNum = lt.GameModule:getHeroData():getJinBi() or 0
    elseif itemId == Constant.TYPE_VAULE_ITEM.TICKET then           --点券
        itemNum = lt.GameModule:getHeroData():getGold() or 0
    else
        if param.total then
            itemNum = self:getItemAllCountByItemId(itemId, itemType)
        else
            itemNum = self:getItemNum(itemId)
        end
    end
    -- if itemId == 60000 then                 -- 元宝
    --     itemNum = lt.GameModule:getHeroData():getValue(ServerClientEnum.PlayerValueDef.Attr_YuanBao) or 0
    -- elseif itemId == 60001 then             -- 金锭
    --     itemNum = lt.GameModule:getHeroData():getValue(ServerClientEnum.PlayerValueDef.Attr_BindYuanBao) or 0
    -- elseif itemId >= 60002 and itemId <= 60006 then         -- 金币
    --     itemNum = lt.GameModule:getHeroData():getValue(ServerClientEnum.PlayerValueDef.Attr_JinBi) or 0
    -- else
    --     if itemType == nil then
    --         itemNum = self:getItemNum(itemId)
    --     else
    --         itemNum = self:getItemNumByIdAndType(itemType, itemId)
    --     end
    -- end
    local enough = itemNum >= needNum
    -- if not enough and param.quickBuy then
    --     local itemMeta = self:getItemMetaByItemId(itemType, itemId)
    --     if itemMeta then
    --         NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MASK_VIEW, {class = "UIDlgQuicklyWay", item = itemMeta})
    --     end
    -- end

    if not enough and param.tips then
        local itemMeta = self:getItemMetaByItemId(itemType, itemId)
        if itemMeta then
            if itemType == Constant.ItemType.ITEM_TYPE_PROP then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemMeta, tipsType = Constant.PROPTIPS_FORM.Display})
            end

            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = itemMeta:getName()..GReadText.KEY_STRENGTHEN_TIPS31})
        end
    end
    
    return enough
end

function ItemModule:getSealItem()
    local sealArray = {}
    for k,v in pairs(self._packageArray) do
        if v:getSeal() == 1 and v:getItemType() == 2 and v:getItemMeta():getRuneGroup() ~= "" then
            sealArray[#sealArray+1] = v
        end
    end
    return sealArray
end

function ItemModule:getInlayItem()
    local Array = {}
     for k,v in pairs(self._equipArray) do
        if v:getItemMeta():getRuneGroup() and v:getItemMeta():getRuneGroup() ~= ""then
            Array[#Array+1] = v
        end
    end
    for k,v in pairs(self._packageArray) do
        if v:getItemType() ==2 then
            if v:getItemMeta():getRuneGroup() and v:getItemMeta():getRuneGroup() ~= "" then
                Array[#Array+1] = v
            end
        end
    end
    return Array
end

function ItemModule:getIdentifyItem()
    local Array = {}
    for k,v in pairs(self._equipArray) do
        if v:getItemMeta():getIdentify() == 1 then
            Array[#Array+1] = v
        end
    end
    for k,v in pairs(self._packageArray) do
        if v:getItemType() ==2 then
            if v:getItemMeta():getIdentify() == 1 then
                Array[#Array+1] = v
            end
        end
    end
    return Array
end

function ItemModule:checkBeltInBag()
    for k,v in pairs(self._packageArray) do
        if v:getItemMeta():getPocketCount() > 0 then
            return true
        end
    end
    return false
end

function ItemModule:getSkillBook()
    local Array = {}
    for k,v in pairs(self._packageArray) do
        if v:getItemType() ==3 then
            Array[#Array+1] = v
        end
    end
    return Array
end

function ItemModule:deserializeAttr(buffer)
    local attrs = {}

    if type(buffer) == "string" and string.len(buffer) ~= 0 then
        local attr = string.split(buffer, ";")
        for _,v in ipairs(attr) do
            if string.len(v) ~= 0 then
                local tmp = string.split(v, ",")
                attrs[tonumber(tmp[1])] = tonumber(tmp[2])
            end
        end
    end

    return attrs
end

-- 装备在身上的pos值与配置表的值的转化   装备->物品表
function ItemModule:equipPos2Type(pos)
    return Constant.EQUIP_TYPE_POS_MAP[pos]
end

function ItemModule:equipType2Pos(etype)
    return Constant.EQUIP_POS_TYPE_MAP[etype]
end

