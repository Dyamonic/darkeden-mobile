end

function ItemModule:AddClientItem(itemArray)
    for k,v in pairs(itemArray) do
        if v then
            if v and type(v) ~= "number" then
                --local item = lt.ItemData.new(v:getObjId(),v:getPropertyArray())
                --print("TZ::::::",v:getObjId())
                --item:setTypePos(Constant.ItemTypePos.Item_InPackage)
                --table.insert(self._packageArray, item)
                local item,k = self:getItemByObjId(v:getObjId())
                if item then
                    v:setUseType(false)
                end
            end
        end
    end
    lt.LogUtil:debugInfo("ItemModule:AddClientItem")
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ADD_CLIENTITEN_POST,{content = itemArray})
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_EVENT)
end

function ItemModule:RemoveManyItem(itemArray)
    lt.LogUtil:debugInfo("ItemModule:RemoveManyItem")
    for k,v in ipairs(itemArray) do
        if  v then
            self:RemoveSingalItem(v:getObjId())
        end
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_EVENT)
end

function ItemModule:autoUseFastItem(setId, itemId)
    local setId2Index = {
        [10001] = 4001,
        [10002] = 4002,
        [10003] = 4003,
        [10004] = 4003,
        [11001] = 4004,
        [11002] = 4004,
    }
    -- 4004
    -- 4005
    -- 4006
    local item = self:getFastPotion(setId2Index[setId or 0], itemId)
    if item then
        lt.AudioManager:playSound(item:getItemMeta():getUseAudio())
        self:sendUseItem(item:getObjId())
    end
end

function ItemModule:onSpiritItemAck(event)
    local proto = event.param
    if proto then
        if proto.type == 1 then
            for i = 1, #proto.parm do
                local objprop = proto.parm[i]
                if objprop then
                    local item = lt.ItemData.new(objprop.objID, objprop.objprops)
                    table.insert(self._spiritArray, item)
                    if self._spiritEquipType then
                        local content = string.format(StringManager:getString(StringManager.KEY_ADD_ITEM_TIP), item:getItemMeta():getName())
                        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_NOTICE,{content = content})
                    end
                end
            end
            if not self._spiritEquipType then
                self._spiritEquipType = true
            end
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPT_SPIRITEQUIP_POST,{content = "add"})
        elseif proto.type == 2 then
            for i = 1, #proto.parm do
                local objprop = proto.parm[i].objprops
                if objprop then
                    for k,v in pairs(self._spiritArray) do
                        local objID = objprop[1].strValue
                        if objID == v:getSpecialObjId() then
                            table.remove(self._spiritArray,k)
                        end
                    end
                end
            end
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPT_SPIRITEQUIP_POST,{content = "consume"})
        elseif proto.type == 3 then
            for i = 1, #proto.parm do
                local objprop = proto.parm[i].objprops
                local objID = nil
                for k,v in pairs(objprop) do
                    if v and v.properCode == ServerClientEnum.ItemValueDef.Attr_SPIRITEQUIP_ID then
                        objID = v.strValue
                    end
                end
                if objID then
                    for k,v in pairs(self._spiritArray) do
                        if objID == v:getSpecialObjId() then
                            v:setPropertyArray(objprop)
                        end
                    end
                end
            end
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPT_SPIRITEQUIP_POST,{content = "deal"})
    end
    print("onSpiritItemAck::::",proto.parm)
end

function ItemModule:useFastItem(event)
    local proto = event.param
    local item = nil
    local btnId = proto.btnId
    lt.LogUtil:debugTable("useFastItem = "..tostring(btnId))
    -- if proto.btnId == 2002 then -- 回城
    --     for i,v in ipairs(self._packageArray) do
    --         if v:getMetaKind() == Constant.ITEM_KIND.kind_back then
    --             if not item or item:getItemId() >= v:getItemId() then
    --                 item = v
    --             end
    --         end
    --     end
    -- else 
    --     item = self:getFastPotion(proto.btnId)
    -- end
    item = self:getFastPotion(btnId)
    if item then
        if item:getMetaKind() == 31 and item:getMetaType() == 2 then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MASK_VIEW, {class = "UIDlgCitySelect", item = item})
            return
        end
        lt.AudioManager:playSound(item:getItemMeta():getUseAudio())
        self:sendUseItem(item:getObjId())
    else
        -- NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = StringManager:getString(StringManager.KEY_FAST_NONE_TIP)})
    end
end

function ItemModule:RemoveSingalItem(objId)
    for i,v in ipairs(self._packageArray) do
        if objId == v:getObjId() then
            --table.remove(self._packageArray, i)
            v:setUseType(true)
            break
        end
    end
end

