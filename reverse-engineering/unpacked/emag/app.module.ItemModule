-- 按物品大类ItemType从前到后（分类相同按照小类Kind排序），
-- 物品小类Kind从前到后（小类相同按道具品质Quality排序）
-- 道具品质Quality从大到小（品质相同按道具种类Type排序）
-- 道具种类Type从前到后（道具种类相同按Id排序）
-- 道具Id从前到后（Id相同按绑定属性排序）
-- 绑定属性从小到大（绑定属性相同按叠加数量排序）
-- 叠加数量从大到小

function ItemModule:tidyPackage()
    table.sort(self._packageArray, function (a, b)
        local ta = 1
        local aMeta = a:getItemMeta()
        local bMeta = b:getItemMeta()
        if a:getItemType() == 2 then
            ta = 3*100000000 + a:getMetaEquipPos() * 1000000 + aMeta:getQuality() * 100000 + a:getItemId() + a:getBind()/10
        elseif a:getItemType() == 1 then
            ta = 2*100000000 + a:getMetaKind()*1000000 + aMeta:getQuality() * 100000 + a:getMetaType()*10000 + a:getItemId()/100 + a:getBind()/1000 + a:getNum()/10000000
        elseif a:getItemType() == 3 then
            ta = 1*100000000 + a:getItemId()
        end
        local tb = 1
        if b:getItemType() == 2 then
            tb = 3*100000000 + b:getMetaEquipPos() * 1000000 + bMeta:getQuality() * 100000 + b:getItemId() + b:getBind()/10
        elseif b:getItemType() == 1 then
            tb = 2*100000000 + b:getMetaKind()*1000000 + bMeta:getQuality() * 100000 + b:getMetaType()*10000 + b:getItemId()/100 + b:getBind()/1000 + b:getNum()/10000000
        elseif a:getItemType() == 3 then
            tb = 1*100000000 + b:getItemId()
        end
        return ta > tb
    end)
    for i,v in ipairs(self._packageArray) do
        v:setPos(-1)
        v:setPage((i%40 == 0) and i/40 or (math.floor(i/40) + 1))
    end
end


function ItemModule:fiterBagItems()
    if self.gridPropManager then
        self.gridPropManager:clear()
    end
    self.gridPropManager = lt.InventoryGridManger.new(Constant.INVENTORY_DEFUAL_SIZE.WIDTH, Constant.INVENTORY_DEFUAL_SIZE.HEIGHT + ItemModule:getExpandGridH())
    if self.gridEquipManager then
        self.gridEquipManager:clear()
    end
    self.gridEquipManager = lt.InventoryGridManger.new(Constant.INVENTORY_DEFUAL_SIZE.WIDTH, Constant.INVENTORY_DEFUAL_SIZE.HEIGHT + ItemModule:getExpandGridH())
    self._fiterPropArr = {}
    self._fiterEquipArr = {}
    --按位置排序
    table.sort(self._packageArray,function (a,b)
        if a:getItemY() == b:getItemY() then
            return a:getItemX() < b:getItemX()
        end
        return a:getItemY() < b:getItemY()
    end)
    
    for _,itemInfo in ipairs(self._packageArray) do
        local itemType = itemInfo:getItemType()
        if itemType ==  Constant.ItemType.ITEM_TYPE_PROP then
            table.insert(self._fiterPropArr, itemInfo)
        elseif itemType ==  Constant.ItemType.ITEM_TYPE_EQUIP then
            table.insert(self._fiterEquipArr, itemInfo)
        end
    end

    self:fiterSort(self._fiterPropArr)
    self:fiterSort(self._fiterEquipArr)

    self:calcItemsXY(self._fiterPropArr, self.gridPropManager)
    self:calcItemsXY(self._fiterEquipArr,self.gridEquipManager)
end

function ItemModule:fiterStrengthenItems(index, item, filterEquipType)
    index = index or 1
    if self.gridStrengthManager then
        self.gridStrengthManager:clear()
    end
    self.gridStrengthManager = lt.InventoryGridManger.new(Constant.STRENGTHEN_SIZE.WIDTH, ItemModule.MAX_GRID_HEIGHT, true)
    self._fiterStrengthArr = {}

    --装备合成/传承/转换只能操作背包里的装备
    if index ~= Constant.TYPEFILTER.LEVELUP and index ~= Constant.TYPEFILTER.STRENGTHNEN and
    index ~= Constant.TYPEFILTER.BLESSING and index ~= Constant.TYPEFILTER.RECASTING and
    index ~= Constant.TYPEFILTER.PURIFY and index ~= Constant.TYPEFILTER.MOTIVATE then
        filterEquipType = FilterEquipType.BagEquip
    end

    if filterEquipType == FilterEquipType.BagEquip then
        for _,itemInfo in ipairs(self._packageArray) do
            local itemType = itemInfo:getItemType()
            if itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
                local isFilter = lt.StrengthenModule:getFilterEquips(index, itemInfo, item)
                itemInfo:setFilter(isFilter)
                table.insert(self._fiterStrengthArr, itemInfo)
            elseif (index == Constant.TYPEFILTER.REFINERIGHT or index == Constant.TYPEFILTER.REFINELEFT) and itemType == Constant.ItemType.ITEM_TYPE_PROP then
                --如果是精炼副材料可以用通用石头
                local itemKind = itemInfo:getMetaKind()
                local subType = itemInfo:getMetaType()
                if itemKind == Constant.PropType.STRENGTHEN and subType == Constant.PropTypeSub_7.Refine then
                    local isFilter = lt.StrengthenModule:getFilterItems(index, itemInfo, item)
                    itemInfo:setFilter(isFilter)
                    table.insert(self._fiterStrengthArr, itemInfo)
                end
            end
        end
    else
        for _,itemInfo in ipairs(self._equipArray) do
            local itemType = itemInfo:getItemType()
            if itemType ==  Constant.ItemType.ITEM_TYPE_EQUIP then
                local isFilter = lt.StrengthenModule:getFilterEquips(index, itemInfo, item)
                itemInfo:setFilter(isFilter)
                table.insert(self._fiterStrengthArr, itemInfo)
            end
        end
    end
    
    self:fiterStrengthenSort(self._fiterStrengthArr)

    local maxHeight = self:calcItemsMaxXY(self._fiterStrengthArr, self.gridStrengthManager)
    return maxHeight
end

function ItemModule:fiterStrengthenItemsSp(index, itemInfo1, itemInfo2)
    if self.gridStrengthManager then
        self.gridStrengthManager:clear()
    end
    self.gridStrengthManager = lt.InventoryGridManger.new(Constant.STRENGTHEN_SIZE.WIDTH, ItemModule.MAX_GRID_HEIGHT, true)
    self._fiterStrengthArr = {}
    
    for _,itemInfo in ipairs(self._packageArray) do
        local itemType = itemInfo:getItemType()
        if itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
            local isFilter = lt.StrengthenModule:getFilterEquipsSp(itemInfo, itemInfo1, itemInfo2)
            itemInfo:setFilter(isFilter)
            table.insert(self._fiterStrengthArr, itemInfo)
        elseif (index == Constant.TYPEFILTER.REFINERIGHT or index == Constant.TYPEFILTER.REFINELEFT) and itemType == Constant.ItemType.ITEM_TYPE_PROP then
            --如果是精炼副材料可以用通用石头
            local itemKind = itemInfo:getMetaKind()
            local subType = itemInfo:getMetaType()
            if itemKind == Constant.PropType.STRENGTHEN and subType == Constant.PropTypeSub_7.Refine then
                local isFilter = lt.StrengthenModule:getFilterEquipsSp(itemInfo, itemInfo1, itemInfo2)
                itemInfo:setFilter(isFilter)
                table.insert(self._fiterStrengthArr, itemInfo)
            end
        end
    end

    self:fiterStrengthenSort(self._fiterStrengthArr)

    local maxHeight = self:calcItemsMaxXY(self._fiterStrengthArr, self.gridStrengthManager)
    return maxHeight
end

function ItemModule:fiterTransactionItems(index, item)
    index = index or 1
    if self.gridTransactionManager then
        self.gridTransactionManager:clear()
    end
    self.gridTransactionManager = lt.InventoryGridManger.new(Constant.TRANSACTION_SIZE.WIDTH, ItemModule.MAX_GRID_HEIGHT, true)
    self._fiterTransactionArr = {}
    
    for _,itemInfo in ipairs(self._packageArray) do
        -- local transactionsMeta = CacheManager:getTransactionsById(itemInfo:getItemId())
        local sid = itemInfo:getItemId()
        local itemType = itemInfo:getItemType()
        local transactionsMeta = lt.TransactionModule:getTransactionDataByItemIdAndType(sid, itemType)
        if transactionsMeta then
            itemInfo:setFilter(1)
            table.insert(self._fiterTransactionArr, itemInfo)
        end
    end
    local maxHeight = self:calcItemsMaxXY(self._fiterTransactionArr, self.gridTransactionManager)
    return maxHeight
end

