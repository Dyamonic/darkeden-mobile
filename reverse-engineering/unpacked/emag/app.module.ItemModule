-- 腰带相关 start

--[[
    和装备相关的更新都可以写到这边
]]
function ItemModule:calcEquipValue()
    -- 装备更新后计算当前的腰带位个数
    self:calcPocketCount()
end

--[[
    获取当前腰带位置个数
]]
function ItemModule:calcPocketCount()
    self._beltPosNum = 0
    for _,v in pairs(self._equipArray or {}) do
        local equipMeta = v:getItemMeta()
        local pocketCount = equipMeta:getPocketCount()
        if pocketCount > 0 then
            self._beltPosNum = self._beltPosNum + equipMeta:getPocketCount()
            -- yflog:Info("pocketCount---------------->>>>%s",equipMeta:getPocketCount())
        end
    end
    -- 特殊处理
    if self._beltPosNum <= 0 then
        self._beltArray = {}
    end

    -- local beltSize = lt.GameModule._heroData:getBeltSize()
    -- yflog:Info("beltSize---------------->>>>%s",beltSize)
end

function ItemModule:getPocketCount()
    return self._beltPosNum or 0
end

function ItemModule:getBeltArray()
    return self._beltArray
end

function ItemModule:getBeltByPos(pos)
    for k,v in ipairs(self._beltArray) do
        if v:getPos() == pos then
            return v
        end
    end
end

function ItemModule:getBeltIndexByPos(pos)
    for k,v in ipairs(self._beltArray) do
        if v:getPos() == pos then
            return v, k
        end
    end
    return nil, nil
end

function ItemModule:getBeltItemByObjId(objId)
    for k,v in ipairs(self._beltArray) do
        if v:getObjId() == objId then
            return v, k
        end
    end
    return nil, nil
end

