function ItemModule:init()
    SocketApi:addProtoListener(ServerCmdDef.CLEAR_PACK, handler(self, self.onClearPackage), "ItemModule:onClearPackage")
    SocketApi:addProtoListener(ServerCmdDef.PACKAGEITEM, handler(self, self.onItemDataInfoAck), "ItemModule:PACKAGEITEM")
    SocketApi:addProtoListener(ServerCmdDef.EQUIPMENT, handler(self, self.onItemDataInfoAck), "ItemModule:EQUIPMENT")
    SocketApi:addProtoListener(ServerCmdDef.STORAGEITEM, handler(self, self.onItemDataInfoAck), "ItemModule:STORAGEITEM")
    SocketApi:addProtoListener(ServerCmdDef.S_BELT_ITEM, handler(self, self.onItemDataInfoAck), "ItemModule:S_BELT_ITEM")
    SocketApi:addProtoListener(ServerCmdDef.S_BELT_ITEM_OPERATE, handler(self, self.onBeltItemAck), "ItemModule:onBeltItemAck")
    SocketApi:addProtoListener(ServerCmdDef.ITEM_INTO_PACKAGE, handler(self, self.onRefreshPackageAck), "ItemModule:onRefreshPackageAck")
    SocketApi:addProtoListener(ServerCmdDef.ITEM_EQUIP_ACK, handler(self, self.onRefreshEquipAck), "ItemModule:onRefreshEquipAck")
    SocketApi:addProtoListener(ServerCmdDef.ITEM_UNEQUIP_ACK, handler(self, self.onRefreshUnEquipAck), "ItemModule:onRefreshUnEquipAck")
    SocketApi:addProtoListener(ServerCmdDef.S_USEITEM_ACK, handler(self, self.onUseItemAck), "ItemModule:onUseItemAck")
    SocketApi:addProtoListener(ServerCmdDef.ITEM_AUTOTIDY, handler(self, self.onItemAutoTidyAck), "ItemModule:onItemAutoTidyAck")
    SocketApi:addProtoListener(ServerCmdDef.ITEM_TAKEN_ACK, handler(self, self.onItemTakenAck), "ItemModule:onItemTakenAck") -- 取出仓库
    SocketApi:addProtoListener(ServerCmdDef.ITEM_STORED_ACK, handler(self, self.onItemStoredAck), "ItemModule:onItemStoredAck") -- 存入仓库
    SocketApi:addProtoListener(ServerCmdDef.POP_BAG, handler(self, self.onPopBagAck), "ItemModule:onPopBagAck")
    SocketApi:addProtoListener(ServerCmdDef.ITEM_RECYCLE_ACK, handler(self, self.onItemRecycleAck), "ItemModule:onItemRecycleAck")
    SocketApi:addProtoListener(ServerCmdDef.TAKEBACK_ITEM, handler(self, self.onTakeBackAck), "ItemModule:onTakeBackAck")
    SocketApi:addProtoListener(ServerCmdDef.ITEM_PROPERTY_CHANGE, handler(self, self.onPropertyChangeAck), "ItemModule:onPropertyChangeAck")
    SocketApi:addProtoListener(ServerCmdDef.PECK_ITEM_ACK, handler(self, self.onPeckItemAck), "ItemModule:onPeckItemAck")
    SocketApi:addProtoListener(ServerCmdDef.EXPAND_BAG, handler(self, self.onExpandBag), "ItemModule:onExpandBag")
    SocketApi:addProtoListener(ServerCmdDef.EXPAND_BAG_LIST, handler(self, self.onExpandBagList), "ItemModule:onExpandBagList")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_VIP_AUTO_SELL_RESP),handler(self, self.onVipAutoSellResp), "ItemModule:onVipAutoSellResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.CS_USE_ITEM_BY_INDEX_RESP),handler(self, self.onUseItemByIndex), "ItemModule:onUseItemByIndex")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_REWARD_NTF),handler(self, self.onRewardNtf), "ItemModule:onRewardNtf")
    -- NtfManager:addNtfListener(NtfManager.NTF.NTF_USE_ITEM_EVENT, handler(self, self.useFastItem), "ItemModule:useFastItem")
    -- NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_ITEM_EVENT, handler(self, self.autoUnpackItem), "ItemModule:autoUnpackItem")
    -- NtfManager:addNtfListener(NtfManager.NTF.NET_SETTING_CHANGE, handler(self, self.autoUnpackItem), "ItemModule:NET_SETTING_CHANGE")
    -- SocketApi:addProtoListener(ServerCmdDef.S_SpiritEquipCreat, handler(self, self.onSpiritItemAck), "ItemModule:onSpiritItemAck")

    local autoRecycleCD = CacheManager:getVariableById(Constant.Variable.AutoRecycleRequireCoolDown) or 0
    self._tickHandler = lt.ScheduleUtil:scheduleGlobal(handler(self, self.onUpdate), tonumber(autoRecycleCD))

    self._rewardNtfArray = {}
    self._beltArray = {}
end

function ItemModule:clear()
    SocketApi:removeProtoListenerByTag("ItemModule:onClearPackage")
    SocketApi:removeProtoListenerByTag("ItemModule:PACKAGEITEM")
    SocketApi:removeProtoListenerByTag("ItemModule:EQUIPMENT")
    SocketApi:removeProtoListenerByTag("ItemModule:STORAGEITEM")
    SocketApi:removeProtoListenerByTag("ItemModule:S_BELT_ITEM")
    SocketApi:removeProtoListenerByTag("ItemModule:onBeltItemAck")
    SocketApi:removeProtoListenerByTag("ItemModule:onRefreshPackageAck")
    SocketApi:removeProtoListenerByTag("ItemModule:onRefreshEquipAck")
    SocketApi:removeProtoListenerByTag("ItemModule:onRefreshUnEquipAck")
    SocketApi:removeProtoListenerByTag("ItemModule:onUseItemAck")
    SocketApi:removeProtoListenerByTag("ItemModule:onItemAutoTidyAck")
    SocketApi:removeProtoListenerByTag("ItemModule:onItemTakenAck")
    SocketApi:removeProtoListenerByTag("ItemModule:onItemStoredAck")
    SocketApi:removeProtoListenerByTag("ItemModule:onPopBagAck")
    SocketApi:removeProtoListenerByTag("ItemModule:onItemRecycleAck")
    SocketApi:removeProtoListenerByTag("ItemModule:onTakeBackAck")
    SocketApi:removeProtoListenerByTag("ItemModule:onPropertyChangeAck")
    SocketApi:removeProtoListenerByTag("ItemModule:onPeckItemAck")
    SocketApi:removeProtoListenerByTag("ItemModule:onVipAutoSellResp")
    SocketApi:removeProtoListenerByTag("ItemModule:onUseItemByIndex")
    SocketApi:removeProtoListenerByTag("ItemModule:onRewardNtf")
    -- NtfManager:removeNtfListenerByTag("ItemModule:useFastItem")
    -- NtfManager:removeNtfListenerByTag("ItemModule:autoUnpackItem")
    -- NtfManager:removeNtfListenerByTag("ItemModule:NET_SETTING_CHANGE")
    -- SocketApi:removeProtoListenerByTag("ItemModule:onSpiritItemAck")
    self._itemData      = nil
    self._packageArray  = {}
    self._equipArray    = {}
    self._depotArray    = {}
    -- self._sealArray     = {}
    self._spiritArray   = {}
    self._beltArray = {}
    self._spiritEquipType = nil
    self._fastOutIn     = nil
    self._addGridH = 0
    self._hpArr = {}
    self._mpArr = {}
    self._hpMpArr = {}
    self._expandsPosRecord = {}
    if self._tickHandler then
        lt.ScheduleUtil:unscheduleGlobal(self._tickHandler)
        self._tickHandler = nil
    end
    self._autoEquipList = {}
    self._isAutoBuyChange  = false
    self._rewardNtfArray = nil
    self._recycleSettingsFilterMap = nil
    self._recycleSettingsTypeFilterMap = nil
    self._autoRecycleFlag = false
    self._equipListChange  = true
end

--  从包裹到角色
function ItemModule:sendEquipItem(objId, pos, fromType)
    lt.LogUtil:debugTable("ItemModule:sendExchange")
    local equip = netcmd_pb.Equip()
    equip.objID = objId
    equip.pos = pos
    equip.fromType = fromType
    SocketApi:sendToGs(lt.ClientCmdDef.EQUIP, equip)
end

-- 从角色到包裹
function ItemModule:sendUnEquipItem(objId, pos)
    self._unEquipObjId = objId
    local msg = netcmd_pb.UnEquip()
    msg.objID = objId
    msg.pos = pos
    SocketApi:sendToGs(lt.ClientCmdDef.UNEQUIP, msg)
end

-- 从包裹到仓库
function ItemModule:sendToDepot(objId,pos,num)
    local msg = netcmd_pb.StoreItem()
    msg.objID = objId
    msg.pos = pos
    msg.num = num or 1
    SocketApi:sendToGs(lt.ClientCmdDef.STORE_ITEM, msg)
end

-- 从仓库到包裹
function ItemModule:sendFromDepotOut(objId,pos,num)
    local msg = netcmd_pb.CS_TakeoutStorageItemReq()
    msg.objID = objId
    msg.pos = pos
    msg.num = num or 1
    SocketApi:sendToGs(lt.ClientCmdDef.TAKEOUT_STORAGE_ITEM, msg)
end

-- 使用物品
function ItemModule:sendUseItem(objId,number)
    local msg = netcmd_pb.CS_UseItemReq()
    msg.itemObjId = tonumber(objId)
    msg.count = number or 1
    SocketApi:sendToGs(lt.ClientCmdDef.C_USE_ITEM, msg)
end

-- 染色使用物品
function ItemModule:sendUseItemHairColor(objId,number)
    self._useItemTips = GReadText.KEY_APPEARANCE_TIPS6
    ItemModule:sendUseItem(objId,number)
end

-- 使用物品客户端限制逻辑
function ItemModule:sendUseItemLimit(itemInfo,number)
    if not itemInfo then return end
    local objId = itemInfo:getObjId()
    
    local itemMeta = itemInfo:getItemMeta()
    if not itemMeta then return end
    
    local kind = itemMeta:getKind()
    local itemType = itemMeta:getType()
    local itemId = itemMeta:getItemId()
    yflog:Info("UseItemLimit: itemId %s kind: %s itemType: %s",itemId,kind,itemType)
    if kind == Constant.PropType.PERSONALIZATION then -- 重置道具 kind8
        if not self:checkUseItemPersonalization(itemInfo,number) then
            return
        end
    elseif kind == Constant.PropType.STRENGTHEN then -- 强化道具 kind7(只跳转界面不使用)
        if not self:checkUseItemStrengthen(itemInfo,number) then
            return
        end
    elseif kind == Constant.PropType.AMMUNITION then -- 弹药
        if not self:checkUseItemAmmunition(itemInfo,true) then
            return Constant.ClientErrorCode.AMMUNITION_NO_USE
        end
    elseif kind == Constant.PropType.CONSUMABLES then -- 消耗品
        if not self:checkUseItemConsumables(itemInfo,number) then
            return
        end
    elseif kind == Constant.PropType.SKILLRESET then -- 技能重置液
        if not self:checkUseItemSkillReset(itemInfo,number) then
            return
        end
    elseif kind == Constant.PropType.TRANSFER then -- 传送道具
        if not self:checkUseItemTranster(itemInfo,number) then
            return
        end
    elseif kind == Constant.PropType.PET_CULTIVATE then -- 宠物养成道具(只跳转界面不使用)
        if not self:checkUseItemPetCultivate(itemInfo,number) then
            return
        end
    elseif table.keyof(lt.SkillEnum.USE_SKILL_ITEMS,itemId) then
        local isCanUse, msg = lt.SkillModule:skillItemUseLimit(itemId)
        if not isCanUse then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = msg})
            return 
        end
    elseif itemId == Constant.SLAYER_MOUNTID.SCORPION_KEY then
        local mountId = GameModule:getHeroData():getMountId()
        if mountId == Constant.SLAYER_MOUNTID.SCORPION_KEY then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_MOUNT_TIPS7})
            return 
        end
    else
        yflog:Info("TODO itemId %s kind: %s itemType: %s",itemId,kind,itemType)
    end

    self:sendUseItem(objId,number)
end

-- 重置道具
function ItemModule:checkUseItemPersonalization(itemInfo,number)
    local objId = itemInfo:getObjId()
    local itemMeta = itemInfo:getItemMeta()
    local itemType = itemMeta:getType()
    local itemId = itemMeta:getItemId()
    local heroData = GameModule:getHeroData()
    if not heroData then
        return false
    end

    if itemType == Constant.PropTypeSub_8.ClassSkillClear then
        --重置道具	8	阶级技能清除液	07
        local passiveSkillList = lt.SkillModule:getPassiveSkillList()
        if #passiveSkillList <= 0 then -- 阶级列表为空不能
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_USE_ITEM_LIMIT1})
            return false
        end
        -- 已成功完成阶级技能的重置
        self._useItemTips = GReadText.KEY_USE_ITEM_LIMIT5

        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
            content = GReadText.KEY_USE_ITEM_LIMIT9,
            confirmCallback = function()
                self:sendUseItem(objId,number)
            end,
        })

        return false
    elseif itemType == Constant.PropTypeSub_8.ChangeSex then
        --重置道具    8    性别重置液    06
        -- 已成功完成性别重置
        self._useItemTips = GReadText.KEY_APPEARANCE_TIPS2

        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
            content = string.format(GReadText.KEY_APPEARANCE_TIPS3, itemMeta:getName()),
            confirmCallback = function()
                self:sendUseItem(objId,number)
            end,
        })

        return false
    elseif itemType == Constant.PropTypeSub_8.ClearPoint then
        --重置道具	8	古代忘却水晶	09
        local race = heroData:getRace()
        if race == Constant.RaceType.Ousters then
            if (heroData:getAddSTR() <= 0) and (heroData:getAddDEX() <= 0) and (heroData:getAddINT() <= 0) then
                local total = heroData:getInitSTR() + heroData:getInitDEX() + heroData:getInitINT()
                if total <= 30 then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_USE_ITEM_LIMIT3})
                    return false
                end
            end
        else
            if (heroData:getAddSTR() <= 0) and (heroData:getAddDEX() <= 0) and (heroData:getAddINT() <= 0) then
                if race == Constant.RaceType.Slayer then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_USE_ITEM_LIMIT4})
                else
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_USE_ITEM_LIMIT3})
                end
                return false
            end
        end
        
        -- 已成功完成属性重置
        self._useItemTips = GReadText.KEY_USE_ITEM_LIMIT6

        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
            content = GReadText.KEY_USE_ITEM_LIMIT10,
            confirmCallback = function()
                self:sendUseItem(objId,number)
            end,
        }) 

        return false
    elseif itemType == Constant.PropTypeSub_8.ClearEvil then
        --重置道具	8	善恶值清除液	10
        local maxValue = Constant.MaxTendency
        if heroData:getTendencies() >= maxValue then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_USE_ITEM_LIMIT2})
            return false
        end

        local needNum = maxValue - heroData:getTendencies()
        local effectParam = itemMeta:getEffectParam()
        local addNum = effectParam[1][2]
        if type(addNum) == "number" and addNum > needNum then
            addNum = needNum
        end

        -- 善恶值已增加%s，目前为%s
        local perNum = addNum + heroData:getTendencies()
        if perNum > maxValue then
            perNum = maxValue
        end
        local tendencyName = CacheManager:getTendencyNameByValue(perNum)
        self._useItemTips = string.format(GReadText.KEY_USE_ITEM_LIMIT7,addNum,tendencyName)

        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
            content = string.format(GReadText.KEY_USE_ITEM_LIMIT8,addNum),
            confirmCallback = function()
                self:sendUseItem(objId,number)
            end,
        })

        return false
    elseif itemType == Constant.PropTypeSub_8.Rename then
        -- 签名卡
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_RENAME_MESSAGE_BOX, {objId = objId})
        return false
    elseif itemType == Constant.PropTypeSub_8.TransformBox then
        --Trans工具箱
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 4, subIdx = 3}})
        return false
    elseif itemType == Constant.PropTypeSub_8.Color then
        local race = GameModule:getHeroRace()
        if race == Constant.RaceType.Vampire then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_APPEARANCE_TIPS5})
            return false
        end
        
        -- 角色外观 - 染发剂
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndAppearance", reopen = true, param ={
            index = Constant.Appearance.Hair,
            selectItemId = itemId,
        }})
        return false
    end

    return true
end

-- 强化道具
function ItemModule:checkUseItemStrengthen(itemInfo,number)
    local itemMeta = itemInfo:getItemMeta()
    local itemType = itemMeta:getType()
    
    if itemType == Constant.PropTypeSub_7.Strengthen then
        --装备词条强化
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 2, subIdx = 1, filterType = FilterEquipType.BagEquip}})
    elseif itemType == Constant.PropTypeSub_7.Compose then
        --装备合成
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 3, subIdx = 1, filterType = FilterEquipType.BagEquip}})
    elseif itemType == Constant.PropTypeSub_7.Recasting then
        --装备重铸
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 4, subIdx = 1, filterType = FilterEquipType.BagEquip}})
    elseif itemType == Constant.PropTypeSub_7.Purify then
        --装备净化
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 4, subIdx = 2, filterType = FilterEquipType.BagEquip}})
    elseif itemType == Constant.PropTypeSub_7.Blessing then
        --装备祝福
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 2, subIdx = 2, filterType = FilterEquipType.BagEquip}})
    elseif itemType == Constant.PropTypeSub_7.Inherit then
        --装备传承
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 3, subIdx = 2, filterType = FilterEquipType.BagEquip}})
    elseif itemType == Constant.PropTypeSub_7.Levelup or itemType == Constant.PropTypeSub_7.Evolution then
        --装备升级/进阶
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 1, subIdx = 1, filterType = FilterEquipType.BagEquip}})
    elseif itemType == Constant.PropTypeSub_7.Transform then
        --装备转换石
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndStrengthen", param = {index = 4, subIdx = 3}})
    end
    return false
end

--宠物养成道具
function ItemModule:checkUseItemPetCultivate(itemInfo,number)
    local itemMeta = itemInfo:getItemMeta()
    local itemType = itemMeta:getType()
    if itemType == Constant.PropTypeSub_10.RedBird
    or itemType == Constant.PropTypeSub_10.RedBird2
    or itemType == Constant.PropTypeSub_10.CutHead
    or itemType == Constant.PropTypeSub_10.ShockCapsule
    or itemType == Constant.PropTypeSub_10.CombinationDevice
    or itemType == Constant.PropTypeSub_10.IceCapsule
    or itemType == Constant.PropTypeSub_10.Combination
    or itemType == Constant.PropTypeSub_10.DigSpeed
    or itemType == Constant.PropTypeSub_10.AddLvl
    or itemType == Constant.PropTypeSub_10.AddExp
    or itemType == Constant.PropTypeSub_10.Food
    or itemType == Constant.PropTypeSub_10.Revival7
    or itemType == Constant.PropTypeSub_10.Revival14 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndPet", param = {index = 1, light = true}})
    end
    return false
end

-- 弹药
function ItemModule:checkUseItemAmmunition(itemInfo, needTips)
    local itemMeta = itemInfo:getItemMeta()
    local itemType = itemMeta:getType()

    -- 子弹
    if itemType == Constant.PropTypeSub_4.Bullet then
        local effectParam = itemMeta:getEffectParamJson() or {}
        local curArms = self:getEquipItemByPos(Constant.SlayerEquipPos.Arms)
        if not curArms then
            -- 当前武器不存在
            if needTips then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_USE_ITEM_LIMIT11})
            end
            return false
        end
        
        local armsConfig = curArms:getItemMeta()
        local itemType = armsConfig:getType()
        local isGun = Constant.IsGun[itemType]
        if not isGun then
            -- 当前武器不是枪
            if needTips then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_USE_ITEM_LIMIT11})
            end
            return false
        end

        -- -- 子弹适配枪的类型
        -- -- AMMO
        -- yflog:Info("not equip AMMO %s",effectParam["AMMO"][2] )

        if type(effectParam["Ammo"]) == "table" and effectParam["Ammo"][2] ~= itemType then
            if needTips then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_USE_ITEM_LIMIT13})
            end
            return false
        end
        -- yflog:Info("equip AMMO %s",itemType)

        -- 需要学习过技能
        if type(effectParam["NeedSkill"]) == "table" and effectParam["NeedSkill"][2] then
            -- 需要学习过技能
            local skillId = effectParam["NeedSkill"][2]
            local hasSkill = lt.SkillModule:hasSkill(skillId)
            if not hasSkill then
                -- 未学习过技能
                if needTips then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_USE_ITEM_LIMIT12})
                end
                return false
            end
        end

        -- TRANSFORM:使用技能后转换成某个物品
        -- TODO
        -- if TRANSFORM then
        -- end
        -- yflog:Info("is bullet %s",effectParam)

        -- 子弹装填中提示
        self._useItemTips = GReadText.KEY_USE_ITEM_LIMIT20
        lt.AudioManager:playSound(SoundEffect.ItemUseMagazineSound)
        return true
    end
end

-- 消耗品 CONSUMABLES
function ItemModule:checkUseItemConsumables(itemInfo,number)
    local objId = itemInfo:getObjId()
    local itemMeta = itemInfo:getItemMeta()
    local itemType = itemMeta:getType()
    
    -- 药水使用限制
    -- 药品类道具仅玩家血量或法力值不满时才可以使用
    -- 特殊情况：拥有消除镀银属性的药水，在存在镀银减益时，即使满血也可以使用
    local canUse = true

    -- 需提示框使用
    if itemType == Constant.PropTypeSub_3.DoubleExp or itemType == Constant.PropTypeSub_3.MulExp then
        self._useItemTips = string.format(GReadText.KEY_USE_ITEM_LIMIT16,itemMeta:getName())

        self:sendUseItem(objId,number)

        return false
    elseif itemType == Constant.PropTypeSub_3.SlayerPotion or itemType == Constant.PropTypeSub_3.VampirePotion or
        itemType == Constant.PropTypeSub_3.OustersPotion or itemType == Constant.PropTypeSub_3.CommonPotion then
        local param = itemMeta:getEffectParam()
        local potionType = ""
        local dissilver = false
        local heroData = GameModule:getHeroData()
        local race = heroData:getRace()
        for i = 1, #param do
            if param[i][1] == "Hp" then
                potionType = potionType .. param[i][1]
            elseif param[i][1] == "Mp" then
                potionType = potionType .. param[i][1]
            elseif param[i][1] == "DISSILVER" and heroData:getSilver() > 0 then
                dissilver = true
            end
        end
        if potionType == potionType1 then
            --只加血(没有镀银伤害)
            if heroData:isFullHp() and not dissilver then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_USE_ITEM_LIMIT21})
                canUse = false
            end
        elseif potionType == potionType2 then
            if heroData:getMpPercent() == 1 then
                if race == Constant.RaceType.Ousters then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_USE_ITEM_LIMIT23})
                else
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_USE_ITEM_LIMIT22})
                end
                canUse = false
            end
        elseif potionType == potionType3 then
            if heroData:isFullHp() and heroData:getMpPercent() == 1 then
                if race == Constant.RaceType.Ousters then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_USE_ITEM_LIMIT25})
                else
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_USE_ITEM_LIMIT24})
                end
                canUse = false
            end
        end
    end

    if not canUse then
        -- 无需消耗提示
        return false
    end

    return true
end

-- 技能重置液
function ItemModule:checkUseItemSkillReset(itemInfo,number)
    local objId = itemInfo:getObjId()
    local itemMeta = itemInfo:getItemMeta()
    local itemType = itemMeta:getType()
    local heroData = GameModule:getHeroData()
    if not heroData then
        return false
    end

    if heroData:getAdvanceState() == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_ITEMTIPS_TIPS20})
        return false
    end

    local race = heroData:getRace()
    if race == Constant.RaceType.Slayer and
        (itemType == Constant.PropTypeSub_15.Sword or
        itemType == Constant.PropTypeSub_15.Blade or
        itemType == Constant.PropTypeSub_15.Gun or
        itemType == Constant.PropTypeSub_15.Heal or
        itemType == Constant.PropTypeSub_15.Bless) then -- 人族
        
        -- 当前如果是相同的领域无法使用
        local domainType = Constant.DomainType or {}
        for k,v in pairs(domainType) do
            if v == itemType and heroData:getSlayerLevelByDomain(v) > 0 then
                local str = GReadText.KEY_ITEMTIPS_TIPS21
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = str})
                return false
            end
        end

        local str = {
            [Constant.PropTypeSub_15.Blade] = "刀",
            [Constant.PropTypeSub_15.Sword] = "剑",
            [Constant.PropTypeSub_15.Gun] = "枪",
            [Constant.PropTypeSub_15.Heal] = "医生",
            [Constant.PropTypeSub_15.Bless] = "祝福",
        }

        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
            content = string.format(GReadText.KEY_USE_ITEM_LIMIT17,GReadText["KEY_NPC_DOMAIN_NAME" .. itemType]),
            confirmCallback = function()
                self._useItemTips =  string.format("使用成功，职业更变为%s", str[itemType])
                self:sendUseItem(objId,number)
            end,
        })

        return false
    elseif race == Constant.RaceType.Vampire and
        itemType == Constant.PropTypeSub_15.Vampire then -- 鬼族
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
            content = GReadText.KEY_USE_ITEM_LIMIT18,
            confirmCallback = function()
                self._useItemTips = GReadText.KEY_USE_ITEM_LIMIT19
                self:sendUseItem(objId,number)
            end,
        })

        return false
    elseif race == Constant.RaceType.Ousters and
        itemType == Constant.PropTypeSub_15.Ousters then -- 魔族
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
            content = GReadText.KEY_USE_ITEM_LIMIT18,
            confirmCallback = function()
                self._useItemTips = GReadText.KEY_USE_ITEM_LIMIT19
                self:sendUseItem(objId,number)
            end,
        })

        return false
    end

    return true
end

-- 传送道具
function ItemModule:checkUseItemTranster(itemInfo,number)
    local objId = itemInfo:getObjId()
    local itemMeta = itemInfo:getItemMeta()
    local itemType = itemMeta:getType()
    local heroData = GameModule:getHeroData()
    if not heroData then
        return
    end
    local race = heroData:getRace()
    if itemType == Constant.PropTypeSub_6.SlayerTransform then
        local worldAgent = lt.AgentManager:getWorldAgent()
        local myMapMeta = worldAgent:getMapAgent():getMapMeta()
        if myMapMeta:getTestInterphone() == 0 then
            --0不能用对讲机
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_TRANSMIT_MAP_TIPS5})
            return
        end
        --先扣道具
        if race ==  Constant.RaceType.Slayer then
            local useCount = itemInfo:getUseCount()
            if useCount <= 0 then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_TRANSMIT_MAP_TIPS2})
                return false
            end
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndSlayerTransmitMap", param = {objId = objId}})
            return true
        end
        return false
    elseif itemType == Constant.PropTypeSub_6.BACKHOME then
        return true
    end
    return false
end

-- 腰带放入、卸下
function ItemModule:sendBeltItemOperate(operateType,objId,pos)
    local msg = netcmd_pb.CS_BeltItemOpReq()
    msg.opType = operateType
    msg.itemObjId = tonumber(objId)
    msg.pos = pos
    SocketApi:sendToGs(lt.ClientCmdDef.C_BELT_ITEM_OPERATE, msg)
end

-- 批量使用物品
function ItemModule:sendUseOverlayItem(objId, num,itemid)
    lt.LogUtil:debugTable("num = "..tostring(num))
    local msg = netcmd_pb.BatchUseItem()
    msg.objID = tonumber(objId)
    msg.num = num
    if itemid then
        msg.Idx = itemid
    end
    SocketApi:sendToGs(lt.ClientCmdDef.BATCH_USE_ITEM, msg)
end

function ItemModule:sendFastUseItems(array)
    local msg = netcmd_pb.UseItems()

    local obj = {}
    for i,v in ipairs(array) do
        local pb = netcmd_pb.BatchUseItem()
        pb.objID = tonumber(v.objID)
        pb.num = v.num
        obj[#obj + 1] = pb
    end
    msg.items = obj
    SocketApi:sendToGs(lt.ClientCmdDef.FAST_USE_ITEMS, msg)
end

-- 丢弃物品
function ItemModule:sendPeckItem(objId, peckNum)
    local msg = netcmd_pb.Peck()
    msg.objID = tonumber(objId)
    -- msg.packId = pkg and pkg or lt.Constant.ItemTypePos.Item_InPackage
    msg.peckNum = tonumber(peckNum) or 1
    SocketApi:sendToGs(lt.ClientCmdDef.PECK, msg)
end

-- 丢弃金币
function ItemModule:requestPeckMoney(money)
    local msg = netcmd_pb.DiscardJinbi()
    msg.discardNum = money
    SocketApi:sendToGs(lt.ClientCmdDef.DISCARD_JINBI, msg)
end

function ItemModule:requestComposeItem(objId, targetObjId)
    local msg = netcmd_pb.UseKunShengItem()
    msg.objID = objId
    msg.TargetObjID = targetObjId
    SocketApi:sendToGs(lt.ClientCmdDef.USE_KUN_YAO_ITEM, msg)
end

function ItemModule:goBackToTown()
    --local msg = netcmd_pb.Peck()
    SocketApi:sendToGs(lt.ClientCmdDef.BACK_TO_TOWN)
end

function ItemModule:OneKeyRecycle()
    SocketApi:sendToGs(lt.ClientCmdDef.RECOVERY_ITEM)
end

function ItemModule:sendExpandBag(param)
    local msg = netcmd_pb.ExpansionPackageOperate()
    msg.operateId = param.operateId
    msg.pos = param.pos
    msg.objId = param.objId
    SocketApi:sendToGs(lt.ClientCmdDef.EXPAND_BAG, msg)
end

--[[
    网络接收
]]

-- uint32 operateId = 1;    //操作Id 0装备 1卸下
-- uint32 pos = 2; // 扩容背包位置
-- uint32 objId = 3; // 扩容背包道具Id 当OperateId为0时需要填

function ItemModule:onExpandBag(event)
    lt.LogUtil:debugInfo("ItemModule:onExpandBag")
    local proto = event.param
    local ret = proto.ret
    local pos = proto.pos
    local operateId = proto.operateId
    if ret == 0 then
        local isChange, isAdd, newGirds = self:getExpandChange(pos, operateId)
        if isChange then
            local addStr = isAdd == true and GReadText.KEY_ADD or GReadText.KEY_SUB
            local successStr = string.format(GReadText.TIPS_EXPAND_RPLACE_SUCCESS, addStr, newGirds)
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = successStr})
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = EXPAND_BAG_CODE[tostring(ret)]})
        end
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = EXPAND_BAG_CODE[tostring(ret)]})
    end
end


function ItemModule:getExpandChange(pos, operateId)
    local isChange, isAdd, newGrid
    local pos = pos + 1
    local origin = Constant.INVENTORY_DEFUAL_SIZE.WIDTH * (Constant.INVENTORY_DEFUAL_SIZE.HEIGHT + ItemModule:getExpandGridH())
    local operateH = ItemModule:getOperateExpandItemH()
    local expandArr = ItemModule:getExpandArray()
    if operateId == 0 then
        if expandArr[pos] then
            --替换
            local originH = expandArr[pos]:getItemMeta():getEffectParam()[1][2]
            if originH > operateH then
                isChange = true 
                isAdd = false
                newGrid = origin - (originH - operateH) * Constant.INVENTORY_DEFUAL_SIZE.WIDTH
            elseif originH < operateH then
                isChange = true
                isAdd = true
                newGrid = origin + (operateH - originH) * Constant.INVENTORY_DEFUAL_SIZE.WIDTH
            elseif originH == operateH then
                isChange = false 
            end
        else
            --装上
            isChange = true
            isAdd = true
            newGrid = origin + operateH * Constant.INVENTORY_DEFUAL_SIZE.WIDTH
        end
    else
        --卸下
        isChange = true
        isAdd = false
        newGrid = origin - operateH * Constant.INVENTORY_DEFUAL_SIZE.WIDTH
    end

    return isChange, isAdd, newGrid
end

function ItemModule:setOperateExpandItemH(itemH)
    self._operateItemH = itemH
end
function ItemModule:getOperateExpandItemH()
    return self._operateItemH
end

function ItemModule:onExpandBagList(event)
    lt.LogUtil:debugInfo("ItemModule:onExpandBagList")
    local proto = event.param
    if proto.expansionPackageItem then
        self._expandPackageArray = {}
        for i = 1, #proto.expansionPackageItem do
            local objprop = proto.expansionPackageItem[i]
            if objprop then
                local item = lt.ItemData.new(objprop.objID, objprop.objprops)
                item:setTypePos(Constant.ItemTypePos.Item_InExpandBag)
                local expandPos = item:getPos()
                self._expandPackageArray[expandPos] = item
                -- table.insert(self._expandPackageArray, item)
            end
        end
    end
    self:calcExpand()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_INVENTORY_EXPAND_LIST,{ ret = proto.ret})
    self:fiterBagItems()
end

function ItemModule:calcExpand()
    self:setExpandH(0)
    local expand = ItemModule._expandPackageArray or {}
    self._expandsPosRecord = {}
    for _, info in pairs(expand) do
        local pos = info:getPos()
        table.insert(self._expandsPosRecord, pos)
        local config = info:getItemMeta()
        local addH = config:getEffectParam()[1][2]
        self:setExpandH(self:getExpandGridH() + tonumber(addH))
    end
end
function ItemModule:getExpandGridH()
    if self._addGridH < 0 then
        self._addGridH = 0
    end
    return self._addGridH
end
function ItemModule:setExpandH(h)
    self._addGridH = h
end
function ItemModule:getExpandArray()
    return self._expandPackageArray or {}
end

--一键清除
function ItemModule:onClearPackage(event)
    lt.LogUtil:debugInfo("ItemModule:onClearPackage")
    self._packageArray = {}
    self._lockCount = 0
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_EVENT)
end

function ItemModule:onItemDataInfoAck(event)
    lt.LogUtil:debugInfo("ItemModule:onItemDataInfoAck")
    local proto = event.param
    -- dump(proto)
    -- lt.LogUtil:debugTable(proto,"proto",6)
    -- 装备位列表
    if proto.equipItem then
        self._equipArray = {}

        for i = 1, #proto.equipItem do
            local objprop = proto.equipItem[i]
            if objprop then
                local item = lt.ItemData.new(objprop.objID, objprop.objprops)
                item:setTypePos(Constant.ItemTypePos.Item_InEquip)
                table.insert(self._equipArray, item)
            end
        end

        -- 装备位列表更新时计算跟装备相关的数值
        self:calcEquipValue()
        local heroData = GameModule:getHeroData()
        if not heroData then
            return
        end
        heroData:setEquipArray(self._equipArray)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_MEDAL_REPUTE_POST)
    end

    -- 背包列表
    if proto.pakageItem then
        self._packageArray = {}
        -- local change = self:ComparisonTable(self._packageArray,proto.pakageItem)
        for i = 1, #proto.pakageItem do
            local objprop = proto.pakageItem[i]
            if objprop then
                local item = lt.ItemData.new(objprop.objID, objprop.objprops)
                item:setTypePos(Constant.ItemTypePos.Item_InPackage)
                item:setPos(i)
                self:insertPackageItem(item)
                self._lockCount = 0
            end
        end
        
        self:fiterBagItems()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_EVENT)
    end

    -- 仓库列表
    if proto.storageItem then
        self._depotArray = {}

        for i = 1, #proto.storageItem do
            local objprop = proto.storageItem[i]
            if objprop then
                local item = lt.ItemData.new(objprop.objID, objprop.objprops)
                item:setTypePos(Constant.ItemTypePos.Item_InDepot)
                -- item:setPos(i)
                table.insert(self._depotArray, item)
            end
        end
        -- self:tidyDepot()
    end

    -- 腰带位列表
    if proto.objProperty and #proto.objProperty > 0 then
        self._beltArray = {}
        for i = 1, #proto.objProperty do
            local objprop = proto.objProperty[i]
            if objprop then
                local item = lt.ItemData.new(objprop.objID, objprop.objprops)
                item:setTypePos(Constant.ItemTypePos.Item_InBelt)
                table.insert(self._beltArray, item)
            end
        end

        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_BELT_EVENT)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_EVENT)
    end
end

-- 位置新增item
function ItemModule:onRefreshPackageAck(event)
    local proto = event.param
    local ret = proto.ret
    -- yflog:Info("ItemModule onRefreshPackageAck ret",ret)

    if ret == -1 then
        yflog:Info("ItemModule onRefreshPackageAck ret -1 背包空间不足")
        return
    elseif ret == -2 then
        yflog:Info("ItemModule onRefreshPackageAck ret -2 道具不存在")
        return
    end
    local heroData = GameModule:getHeroData()
    if not heroData then
        return
    end
    if proto.parcelId == Constant.ItemTypePos.Item_InPackage then
        local objprop = proto.newItem
        if objprop then
            local item = lt.ItemData.new(objprop.objID, objprop.objprops)
            item:setNew(true)
            item:setTypePos(Constant.ItemTypePos.Item_InPackage)
            item:setPos(-1)
            self:insertPackageItem(item)
            local content = string.format(StringManager:getString(StringManager.KEY_ADD_ITEM_TIP), item:getName())
            if (item:getItemType() ~= 1 and item:getIsTaskItem() and heroData:getLevel() <= 25)
                or (item:getItemType() == 1 and item:getMetaFastUse())
                or (item:getItemType() == 3 and item:getMetaFastUse() 
                    and lt.SkillModule:hasSkill(item:getSkillId()) == nil 
                    and item:getMetaNeedJob() == lt.GameModule:getHeroData():getJob()
                    and item:getMetaNeedLv() <= lt.GameModule:getHeroData():getLevel()) 
                or (item:getItemType() == 2 )
                then
                self:useTaskItem(item)
            end

            -- 圣水瓶标记，新增物品(人祝)
            self:createHolyPotion(item)
            -- 圣水瓶标记，新增物品(人医)
            self:createHolyPotionDoctor(item)

            NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_NOTICE,{content = content})
            -- NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_EVENT)--道具变化:[数量新增]
            self._lockCount = 0
            -- 播放音效
            self:playSoundByItemInfo(item)
            -- 检测是否显示变强
            heroData:checkAddPoint()
        end
    elseif proto.parcelId == Constant.ItemTypePos.Item_InEquip then
        local objprop = proto.newItem
        if objprop then
            local item = lt.ItemData.new(objprop.objID, objprop.objprops)
            item:setTypePos(Constant.ItemTypePos.Item_InPackage)
            table.insert(self._equipArray, item)

            -- 装备位列表更新时计算跟装备相关的数值
            -- self:calcEquipValue()
            heroData:setEquipArray(self._equipArray)
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_HERO_EQUIP_EVENT)
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_AUTO_EQUIP_EVENT, {itemInfo = item})
            if item:getPos() == Constant.EQUIP_ITEM_POS.pos_horse then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHEILDINFO_POST,{content = "openstrengh"})
            end

            local content = string.format(StringManager:getString(StringManager.KEY_ADD_ITEM_TIP), item:getName())
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_NOTICE,{content = content})
            -- 播放音效
            self:playSoundByItemInfo(item)
        end
    elseif proto.parcelId == Constant.ItemTypePos.Item_InDepot then
        local objprop = proto.newItem
        if objprop then
            local item = lt.ItemData.new(objprop.objID, objprop.objprops)
            item:setTypePos(Constant.ItemTypePos.Item_InDepot)
            -- item:setPos(#self._depotArray + 1)
            table.insert(self._depotArray, item)
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_DEPOT_EVENT)
        end
    end
end

-- 穿装备
function ItemModule:onRefreshEquipAck(event)
    yflog:Info("ItemModule:onRefreshEquipAck")
    local proto = event.param
    if proto.ret == 0 then
        local objId = proto.objID
        local pos = proto.pos
        local fromType = proto.fromType -- Constant.ItemTypePos
        local equipOld, indexEquip = self:getEquipItemByPos(pos)
        local equipNew, indexNew = self:getItemByObjId(objId) -- 背包穿装备
        local equipBelt, _ = self:getBeltItemByObjId(objId)   -- 腰带穿装备
        local item = nil
        if equipOld and fromType == Constant.ItemTypePos.Item_InPackage then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_EQUIP_AUTOUSE_RMV_EQUIP_LATER,{ itemInfo = equipOld})
            item = equipOld
        end
        if equipNew and fromType == Constant.ItemTypePos.Item_InPackage  then --背包到装备位
            -- equipNew:setPos(pos)
            -- if indexEquip then
            --     equipNew:setTypePos(Constant.ItemTypePos.Item_InEquip)
            --     self._equipArray[indexEquip] = equipNew
            -- else
            --     equipNew:setTypePos(Constant.ItemTypePos.Item_InEquip)
            --     table.insert(self._equipArray, equipNew)
            -- end

            -- if equipOld then
            --     equipOld:setPos(-1)
            --     equipOld:setTypePos(Constant.ItemTypePos.Item_InPackage)
            --     -- self:insertPackageItem(equipOld)
            --     -- table.insert(self._packageArray, equipOld)
            --     local content = string.format(StringManager:getString(StringManager.KEY_ADD_ITEM_TIP), equipOld:getName())
            --     NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_NOTICE,{content = content})
            -- end
            item = equipNew
        elseif equipBelt and fromType == Constant.ItemTypePos.Item_InBelt then -- 腰带到装备位
            local equipBeltPos = equipBelt:getPos()
            equipBelt:setPos(pos)
            if indexEquip then
                equipBelt:setTypePos(Constant.ItemTypePos.Item_InEquip)
                self._equipArray[indexEquip] = equipBelt
            else
                equipBelt:setTypePos(Constant.ItemTypePos.Item_InEquip)
                table.insert(self._equipArray, equipBelt)
            end
            yflog:Info("ItemModule:onRefreshEquipAck======>>>>>" .. equipBeltPos)
            if equipOld then
                equipOld:setPos(equipBeltPos)
                equipOld:setTypePos(Constant.ItemTypePos.Item_InBelt)
                table.insert(self._beltArray, equipBelt)
                local content = string.format(StringManager:getString(StringManager.KEY_ADD_ITEM_TIP), equipOld:getName())
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_NOTICE,{content = content})
                yflog:Info("ItemModule:onRefreshEquipAck======>>>>> equipOld" .. equipBeltPos)
            else
                yflog:Info("ItemModule:onRefreshEquipAck======>>>>> not equipOld" .. equipBeltPos)
            end
            item = equipBelt
        end

        -- 装备位列表更新时计算跟装备相关的数值
        self:calcEquipValue()

        -- local config = equipNew:getItemMeta()
        -- if pos == Constant.EQUIP_ITEM_POS.pos_clothes then
        --     lt.GameModule._heroData:setModelClothId(config:getModle())
        -- elseif pos == Constant.EQUIP_ITEM_POS.pos_weapon then
        --     lt.GameModule._heroData:setWeapon(config:getModle())
        --     lt.GameModule._heroData:setWeaponAppr(config:getAppr())
        -- elseif pos == Constant.EQUIP_ITEM_POS.pos_hat then
        --     lt.GameModule._heroData:setHelmet(config:getModle())
        -- end
        local heroData = GameModule:getHeroData()
        if not heroData then
            return
        end
        heroData:setEquipArray(self._equipArray)

        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_HERO_EQUIP_EVENT)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_AUTO_EQUIP_EVENT, {itemInfo = item})
        -- NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_EVENT)
        self._lockCount = 0
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = "装备失败！"})
        -- NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_EVENT)
    end
end

