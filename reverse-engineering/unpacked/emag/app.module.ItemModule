function ItemModule:getDestroyArray(types)
    local itemArray = {}
    if not self._packageArray then 
        return itemArray 
    end
    for k,v in pairs(self._packageArray) do
        if self:checkDestroyItem(v:getItemType(), v:getItemId()) and v:getSheildLevel() == 0 then
            if types then
                if not self:checkHasItem(v:getItemType(), v:getItemId(),itemArray) then
                    itemArray[#itemArray+1] = v
                end
            else
                itemArray[#itemArray+1] = v
            end
           
        end 
    end
    return itemArray
end

function ItemModule:getChatArray()
    local itemArray = {}
    if not self._packageArray then 
        return itemArray 
    end
    for k,v in pairs(self._packageArray) do
        if not v:getIsBind() then
            itemArray[#itemArray+1] = v
        end 
    end
    return itemArray
end

function ItemModule:checkCurEquipIsGun()
    local curArms = self:getEquipItemByPos(Constant.SlayerEquipPos.Arms)
    if not curArms then
        return false
    end
    
    local armsConfig = curArms:getItemMeta()
    local itemType = armsConfig:getType()
    return Constant.IsGun[itemType] or false
end

-- 获取自身枪武器
function ItemModule:getEquipGun()
    local curArms = self:getEquipItemByPos(Constant.SlayerEquipPos.Arms)
    if not curArms then
        return nil
    end
    
    local armsConfig = curArms:getItemMeta()
    local itemType = armsConfig:getType()
    if Constant.IsGun[itemType] then
        return curArms
    end

    return nil
end

function ItemModule:getRefineArray(index)
    local itemArray = {}
    if index == 1 then
        if self._equipArray then 
            for k,v in pairs(self._equipArray) do
                 if v then
                    if lt.RareConsumeDao:queryDefault(v:getMetaEquipPos(),0) then
                        itemArray[#itemArray+1] = v
                    end
                 end
            end 
         end
         for k,v in pairs(self._packageArray) do
             if v then
                 if v:getItemType() == 2 then
                     if v:getMetaEquipPos() > 0 and v:getMetaEquipPos() < Constant.EQUIP_ITEM_POS.pos_horse then
                        if lt.RareConsumeDao:queryDefault(v:getMetaEquipPos(),0) then
                            itemArray[#itemArray+1] = v
                        end
                     end 
                 end    
             end
         end
         --[[
         for k,v in pairs(self._depotArray) do
             if v then
                 if v:getItemType() == 2 then
                    if v:getMetaEquipPos() > 0 and v:getMetaEquipPos() < Constant.EQUIP_ITEM_POS.pos_horse then
                        if lt.RareConsumeDao:queryDefault(v:getMetaEquipPos(),0) then
                            itemArray[#itemArray+1] = v
                        end
                    end 
                 end 
             end
         end
         --]]
    elseif index == 2 then
        local info = lt.RareUpDao:queryAll()
        for i=1,#info do
            local v,k = self:getItemByItemId(info[i]:getItemID(),info[i]:getItemType())
            if v then
                itemArray[#itemArray+1] = v
            end
        end 
    end
    return itemArray
end

function ItemModule:getSpiritEquipArray(types,index)
    local array = {}
    if types then
        for k,v in pairs(self._spiritArray) do
            if v and not v:isSpiritEquip() and not v:isSpiritEquipLock() then
                array[#array+1] = v
            end
        end
        return array
    else
        if index == 0 then
            for k,v in pairs(self._spiritArray) do
                if v and v:getItemMeta():getEquipPos() < 7 then
                    array[#array+1] = v
                end
            end
            return array
        else
            for k,v in pairs(self._spiritArray) do
                if v and v:getItemMeta():getEquipPos() == index then
                    array[#array+1] = v
                end
            end
            return array
        end
    end 
end

function ItemModule:getSpiritEquipItem(objid)
    if self._spiritArray then
        for k,v in pairs(self._spiritArray) do
            if objid ==  v:getSpecialObjId() then
                return v
            end
        end
    end
    return nil
end

function ItemModule:useTaskItem(item)
    item:setTaskItem(0)  -- 任务物品 id到了客户端 就为0
    local ret = false
    for i,v in ipairs(self._taskItemArr) do
        if item:getObjId() == v:getObjId() then
            ret = true
            break
        end
    end
    if not ret then
        self._taskItemArr[#self._taskItemArr + 1] = item

        self:saveTaskItemToUser()
        if #self._taskItemArr == 1 then
            -- NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIDlgTaskEquip", reopen = true, item = item})
        end
    end
end

function ItemModule:removeTaskItem(item)
    for i=#self._taskItemArr, 1, -1 do
        local v = self._taskItemArr[i]
        if item:getObjId() == v:getObjId() then
            table.remove(self._taskItemArr, i)
        elseif not self:getItemByObjId(v:getObjId()) then
            table.remove(self._taskItemArr, i)
        end
    end

    self:saveTaskItemToUser()

    if #self._taskItemArr > 0 then
        -- NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIDlgTaskEquip", reopen = true, item = self._taskItemArr[1]})
    end
end

function ItemModule:gameStartTaskItem()
    local objIdArr = self:getTaskItemFromUser()
    if not objIdArr then return end

    self._taskItemArr = {}
    for _,v in ipairs(self._packageArray) do
        local str = v:getItemType() .. "," .. v:getItemId()
        for j,objStr in ipairs(objIdArr) do
            if str == objStr then
                self._taskItemArr[#self._taskItemArr + 1] = v
                break
            end
        end
    end

    if #self._taskItemArr > 0 then
        -- NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIDlgTaskEquip", reopen = true, item = self._taskItemArr[1]})
    end
end

function ItemModule:getTaskItemFromUser()
    local objIdStr = lt.PrefManager:getUserValueByKey(ItemModule.FAST_TASK_ITEM)
    local objIdArr = nil
    if objIdStr and objIdStr ~= "" then
        objIdArr = string.split(objIdStr, ";")
    end
    return objIdArr
end

function ItemModule:saveTaskItemToUser()
    local objIdStr = ""
    local num = #self._taskItemArr

    for i,v in ipairs(self._taskItemArr) do
        objIdStr = objIdStr .. v:getItemType() .. "," .. v:getItemId()
        if i < num then
            objIdStr = objIdStr .. ";"
        end
    end
    lt.PrefManager:setUserValueByKey(ItemModule.FAST_TASK_ITEM, objIdStr)
end

