-- 奖励
function ItemModule:onRewardNtf(event)
    local proto = event.param
    local systemId = proto.systemId
    -- yflog:Info("----------->>>>>>>>>> %s",systemId)
    local rewardInfoArray = proto.singleRewardInfo
    local rewardArray = {}
    self._rewardNtfArray = {}
    local rewardByItemId = {}
    for k,v in ipairs(rewardInfoArray) do
        -- yflog:Info("-------------%s,%s,%s",v.itemId,v.itemType,v.itemAddNum,v.objProperty)
        local rewardIndex = rewardByItemId[v.itemId]
        if rewardIndex and rewardArray[rewardIndex] and v.itemType == Constant.ItemType.ITEM_TYPE_PROP then
            rewardArray[rewardIndex].itemAddNum = (rewardArray[rewardIndex].itemAddNum or 0) + (v.itemAddNum or 0)
        else
            table.insert(rewardArray,{itemId = v.itemId,itemType = v.itemType,itemAddNum = v.itemAddNum,objProperty = v.objProperty})
            rewardByItemId[v.itemId] = #rewardArray
        end
    end

    if #rewardArray > 0 then
        table.insert(self._rewardNtfArray, {systemId = systemId, rewardArray = rewardArray})
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_REWARD_TIPS,{})
    end
end

function ItemModule:getFirstReward()
    if #self._rewardNtfArray == 0 then
        return
    end

    local reward = table.remove(self._rewardNtfArray, 1)
    return reward
end

-- 客户端根据表配置获得一个ItemData
-- A=物品类型
-- B=物品ID
-- C=物品数量
-- D=是否绑定
-- E=物品剩余时间
-- F=物品等级
-- G=物品属性1
-- H=物品属性2
-- I=物品属性3
function ItemModule:getItemDataByRewardConfig(rewardConfig)
    local propertyArray = {
        { properCode = lt.ServerClientEnum.ItemValueDef.Attr_ItemIdx  , intValue = tonumber(rewardConfig[2]) },
        { properCode = lt.ServerClientEnum.ItemValueDef.Attr_ItemType , intValue = tonumber(rewardConfig[1]) },
        { properCode = lt.ServerClientEnum.ItemValueDef.Attr_ILevel   , intValue = 4},
    }

    local affixAttr1 = tonumber(rewardConfig[7] or 0)
    if affixAttr1 > 0 then
        local optionCfg = CacheManager:getAttributeMetaByOptionId(affixAttr1)
        if optionCfg then
            local affixId = optionCfg:getType()
            local affixLevel = optionCfg:getGrade()
            table.insert( propertyArray, { properCode = lt.ServerClientEnum.ItemValueDef.Attr_FirstAffixId, intValue = affixId})
            table.insert( propertyArray, { properCode = lt.ServerClientEnum.ItemValueDef.Attr_FirstAffixLevel, intValue = affixLevel})
        end
    end

    local affixAttr2 = tonumber(rewardConfig[8] or 0)
    if affixAttr2 > 0 then
        local optionCfg = CacheManager:getAttributeMetaByOptionId(affixAttr2)
        if optionCfg then
            local affixId = optionCfg:getType()
            local affixLevel = optionCfg:getGrade()
            table.insert( propertyArray, { properCode = lt.ServerClientEnum.ItemValueDef.Attr_SecondAffixId, intValue = affixId})
            table.insert( propertyArray, { properCode = lt.ServerClientEnum.ItemValueDef.Attr_SecondAffixLevel, intValue = affixLevel})
        end
    end

    local affixAttr3 = tonumber(rewardConfig[9] or 0)
    if affixAttr3 > 0 then
        local optionCfg = CacheManager:getAttributeMetaByOptionId(affixAttr3)
        if optionCfg then
            local affixId = optionCfg:getType()
            local affixLevel = optionCfg:getGrade()
            table.insert( propertyArray, { properCode = lt.ServerClientEnum.ItemValueDef.Attr_ThirdAffixId, intValue = affixId})
            table.insert( propertyArray, { properCode = lt.ServerClientEnum.ItemValueDef.Attr_ThirdAffixLevel, intValue = affixLevel})
        end
    end

    local item = lt.ItemData.new(0, propertyArray)
    return item
end

function ItemModule:initUnpackItem()
    self._hpArr = self:getUnpakcItemArr(4001)
    self._mpArr = self:getUnpakcItemArr(4002)
    self._hpMpArr = self:getUnpakcItemArr(4003)
end

function ItemModule:getUnpakcItemArr(id)
    -- local uiConfig = lt.CacheManager:getUIConfig(id)
    -- local itemStr = uiConfig:getUnpackItemId()
    -- local arr = string.split(itemStr, ",")
    -- return arr
    return {}
end

function ItemModule:unpackItemType(id)
    -- 红
    for i,v in ipairs(self._hpArr) do
        if tonumber(v) == id then
            return 1
        end
    end
    -- 蓝
    for i,v in ipairs(self._mpArr) do
        if tonumber(v) == id then
            return 2
        end
    end
    -- 瞬药
    for i,v in ipairs(self._hpMpArr) do
        if tonumber(v) == id then
            return 3
        end
    end

    return 0
end

