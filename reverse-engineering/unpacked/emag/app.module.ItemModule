function ItemModule:onUseItemAck(event)
    lt.LogUtil:debugInfo("ItemModule:onUseItemAck")
    local proto = event.param
    if proto.ret == 0 and self._useItemTips then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = self._useItemTips or ""})
        
        if self._useItemTips == GReadText.KEY_APPEARANCE_TIPS2 or --转性关闭所有界面
           self._useItemTips == GReadText.KEY_APPEARANCE_TIPS6 then --染发关闭所有界面
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_CLOSE_ALL)
        end

        self._useItemTips = nil
    end
end

function ItemModule:onItemAutoTidyAck(event)
    lt.LogUtil:debugInfo("ItemModule:onItemAutoTidyAck")
    local proto = event.param
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_INVENTORY_AUTOSORT,{ret = proto.ret})
end
--取出仓库成功
function ItemModule:onItemTakenAck(event)
    lt.LogUtil:debugInfo("ItemModule:onItemTakenAck")
    local proto = event.param
    if proto.ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_WAREHOUSE_TIPS8})
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_DEPOT_EVENT)
    end
end

--放入仓库成功
function ItemModule:onItemStoredAck(event)
    lt.LogUtil:debugInfo("ItemModule:onItemStoredAck")
    local proto = event.param
    if proto.ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_WAREHOUSE_TIPS7})
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_DEPOT_EVENT)
    end
end

-- 存入腰带取出腰带
function ItemModule:onBeltItemAck(event)
    lt.LogUtil:debugInfo("ItemModule:onBeltItemAck")
    local proto = event.param
    if proto.ret == 0 then
        local type = proto.opType
        local objId = proto.itemObjId
        local pos = proto.pos
        
        if type == Constant.BeltOperateType.PutIn then
            -- 如果位置上有东西就先删除之前位置上的物品
            local item, index = self:getBeltIndexByPos(pos)
            if item then
                table.remove(self._beltArray, index)
            end
            local item, index = self:getItemByObjId(objId)
            if item then
                item:setTypePos(Constant.ItemTypePos.Item_InBelt)
                table.insert(self._beltArray, item)
            end
            self:removePackageItem(index)

        elseif type == Constant.BeltOperateType.TakeOut then
            local item, index = self:getBeltItemByObjId(objId)
            table.remove(self._beltArray, index)
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_BELT_EVENT)
    end
end

function ItemModule:onPopBagAck(event)
    lt.LogUtil:debugInfo("ItemModule:onPopBagAck")
end

function ItemModule:onItemRecycleAck(event)
    lt.LogUtil:debugInfo("ItemModule:onItemRecycleAck")
end

-- 位置取出item操作
function ItemModule:onTakeBackAck(event)
    lt.LogUtil:debugInfo("ItemModule:onTakeBackAck")
    local proto = event.param
    local typePos = proto.parcelId
    -- 要删除item 由单个改为list
    local itemList = proto.itemList
    if typePos == Constant.ItemTypePos.Item_InPackage then
        local removeArray = {}
        for i,v in ipairs(itemList or {}) do
            local objId = v.objID
            local item, index = self:getItemByObjId(objId)
            if item then
                table.insert(removeArray, index)
            end
        end
        -- 这边要从小到大排序
        table.sort(removeArray)
        for i = #removeArray, 1, -1 do
            ItemModule:removePackageItem(removeArray[i])
        end
        -- self._lockCount = 0
        -- 检测是否显示变强
        local heroData = GameModule:getHeroData()
        heroData:checkAddPoint()
    elseif typePos == Constant.ItemTypePos.Item_InDepot then
        local removeArray = {}
        for i,v in ipairs(itemList or {}) do
            local objId = v.objID
            local item, index = self:getDepotItemByObjId(objId)
            if item then
                table.insert(removeArray, index)
            end
        end
        -- 这边要从小到大排序
        table.sort(removeArray)
        for i = #removeArray, 1, -1 do
            table.remove(self._depotArray, removeArray[i])
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_DEPOT_EVENT)
    elseif typePos == Constant.ItemTypePos.Item_InEquip then
        local removeArray = {}
        for i,v in ipairs(itemList or {}) do
            local objId = v.objID
            local item, index = self:getEquipItemByObjId(objId)
            if item then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_AUTO_EQUIP_EVENT, {itemInfo = item}) 
                table.insert(removeArray, index)
            end
        end
        -- 这边要从小到大排序
        table.sort(removeArray)
        for i = #removeArray, 1, -1 do
            table.remove(self._equipArray, removeArray[i])
        end
        -- 装备位列表更新时计算跟装备相关的数值
        -- self:calcEquipValue()
        local heroData = GameModule:getHeroData()
        if not heroData then
            return
        end
        heroData:setEquipArray(self._equipArray)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_HERO_EQUIP_EVENT)
    elseif typePos == Constant.ItemTypePos.Item_InBelt then
        local removeArray = {}
        for i,v in ipairs(itemList or {}) do
            local objId = v.objID
            local item, index = self:getBeltItemByObjId(objId)
            if item then
                table.insert(removeArray, index)
            end
        end
        -- 这边要从小到大排序
        table.sort(removeArray)
        for i = #removeArray, 1, -1 do
            table.remove(self._beltArray, removeArray[i])
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_BELT_EVENT)
    end
end

-- item属性改变
function ItemModule:onPropertyChangeAck(event)
    yflog:Info("ItemModule:onPropertyChangeAck")
    local proto = event.param
    local typePos = proto.parcelId
    -- 这边改成list
    local itemPropArray  = proto.itemProp_list
    if typePos == Constant.ItemTypePos.Item_InPackage then
        for i,v in ipairs(self._packageArray) do
             for ii,vv in ipairs(itemPropArray or {}) do
                local objId = vv.objID
                local objprop = vv.objprops
                if v:getObjId() == objId then
                    v:setPropertyArray(objprop)
                    self:addNumItemTip(v, objprop)
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_CHANGE_EVENT, {typePos = Constant.ItemTypePos.Item_InPackage,item = v})
                    break
                end
            end
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_EVENT)
    elseif typePos == Constant.ItemTypePos.Item_InEquip then
        local item = nil
        for i,v in ipairs(self._equipArray) do
            for ii,vv in ipairs(itemPropArray or {}) do
                local objId = vv.objID
                local objprop = vv.objprops
                if v:getObjId() == objId then
                    item = v
                    v:setPropertyArray(objprop)
                    self:propertyChangeNotice(v, objprop)
                    break
                end
            end
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_HERO_EQUIP_EVENT)
    elseif typePos == Constant.ItemTypePos.Item_InDepot then
        for i,v in ipairs(self._depotArray) do
            for ii,vv in ipairs(itemPropArray or {}) do
                local objId = vv.objID
                local objprop = vv.objprops
                if v:getObjId() == objId then
                    v:setPropertyArray(objprop)
                    break
                end
            end
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_DEPOT_EVENT)
    elseif typePos == Constant.ItemTypePos.Item_InBelt then
        for i,v in ipairs(self._beltArray) do
            for ii,vv in ipairs(itemPropArray or {}) do
                local objId = vv.objID
                local objprop = vv.objprops
                if v:getObjId() == objId then
                    v:setPropertyArray(objprop)
                    self:addNumItemTip(v, objprop)
                    break
                end
            end
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_BELT_EVENT,{type = 2})
    end
end

--丢弃物品回调
function ItemModule:onPeckItemAck(event)
    lt.LogUtil:debugInfo("ItemModule:onPeckItemAck")
    local proto = event.param
    if proto.ret ~= 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_EVENT)
    end
end

function ItemModule:queryItem(iId, iType)
    local item

    iType = iType or 1

    for _, v in ipairs(self._packageArray) do

        local type = v:getItemType()
        local id = v:getItemId()

        if type == iType and id == iId then
            if not item then
                item = v
            elseif item:getNum() >= v:getNum() then
                item = v
            end
        end
    end

    return item
end

function ItemModule:getFastPotion(btnId, useItemId)
    -- print("ItemModule:getFastPotion ", index, "useItemId:", useItemId)
    local item = nil
    if useItemId then
        for _, itemData in ipairs(self._packageArray) do
            if itemData:getItemType() == 1 and itemData:getItemId() == useItemId then
                item = itemData
                break
            end
        end
    else
        -- local uiConfig = lt.UIConfigDao:query(btnId)
        local uiConfig = lt.CacheManager:getUIConfig(btnId)
        if not uiConfig then return item end
        local itemStr = uiConfig:getItemIdString()

        if not itemStr then return item end

        local arr = string.split(itemStr, ";")
        if arr then
            for _, itemId in ipairs(arr) do
                for _, itemData in ipairs(self._packageArray) do
                    if itemData:getItemType() == 1 and itemData:getItemId() == tonumber(itemId) then
                        item = itemData
                        break
                    end
                end
                if item then
                    break
                end
            end
        end
    end
    return item
end

function ItemModule:getPackageArray()
    return self._packageArray
end

function ItemModule:getEquipArray()
    return self._equipArray
end

function ItemModule:getDepotArray()
    return self._depotArray
end

function ItemModule:getSortDepotArray()
    local depotArray = clone(self._depotArray)
    table.sort(depotArray,function (a,b)
        return (a:getPos() or 0) < (b:getPos() or 0)
    end)

    return depotArray
end

function ItemModule:getSealArray()
    return self._sealArray
end

function ItemModule:getLavePackageGrid()
    -- return math.max(0, ItemModule.MAX_GRID_NUM - table.nums(self._packageArray) - self._lockCount)
    return math.max(0, lt.GameModule:getHeroData():getMaxPackage() - self:getUsedPackageNums())
end

---已使用的格子数
function ItemModule:getUsedPackageNums()
    local num = 0
    for _,itemInfo in ipairs(self._packageArray) do
        local itemConfig = itemInfo:getItemMeta()
        local gridSizeIndex = itemConfig:getItemSize()
        local size = lt.Constant.ITEMSIZE[gridSizeIndex or 1]
        num = num + size.width * size.height
    end
    return num
end

function ItemModule:addLockCount()
    self._lockCount = self._lockCount + 1
end

function ItemModule:addNumItemTip(item, objprop)
    for _,v in ipairs(objprop) do
        if v.properCode and v.properCode == lt.ServerClientEnum.ItemValueDef.Attr_SuperposeCount then
            local addNum = item:getChangeValueByKey(lt.ServerClientEnum.ItemValueDef.Attr_SuperposeCount) 
            if addNum and addNum > 0 then
                local content = string.format(StringManager:getString(StringManager.KEY_ADD_ITEM_TIP), item:getName())
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_NOTICE,{content = content})

                -- 圣水瓶标记, 数量变更(人祝)
                self:createHolyPotion(item)
                -- 圣水瓶标记，新增物品(人医)
                self:createHolyPotionDoctor(item)
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB,{content = string.format("%d_%d",item:getItemType(),item:getItemId()),item = item})
                break;
            end
        end
    end
end

function ItemModule:propertyChangeNotice(item, objprop)
    for _,v in ipairs(objprop) do
        if v.properCode and v.properCode == ServerClientEnum.ItemValueDef.Attr_Durability then
            --耐久度变化
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATE_DURABILITY, {uid = item:getItemUid()})
            local change = item:getChangeValueByKey(v.properCode) or 0
            if change ~= 0 then
                self:AutoRepair(item)
            end
            if change >= 0 then -- 只有降低
                return
            end
            local partName = self:getEquipPartName(item:getMetaKind())
            if partName == "" then
                return
            end
            local preProp = string.format("%.0f",item:getPreValue(ServerClientEnum.ItemValueDef.Attr_Durability)/item:getTotalDurability()*100)
            local curProp = string.format("%.0f",item:getDurability()/item:getTotalDurability()*100)
            local intCurProp = tonumber(curProp)
            local intPreProp = tonumber(preProp)
            if intPreProp ~= intCurProp  and (intCurProp == 25 or intCurProp <= 10) then --
                local content = string.format(GReadText.KEY_AUTO_RECYCLE_TIPS3, partName,intCurProp)
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = content})
            end
            break
        end
    end
end

-- 自动维修
function ItemModule:AutoRepair(item)
    if not item then
        return
    end

    local meta = VipModule:getCurVipMeta()
    if not meta or meta:getRepair() ~= 1 then
        return
    end

    local durabilityTotal = item:getTotalDurability()
    local durability = item:getDurability()
    local curProp = string.format("%.0f", durability / durabilityTotal * 100)
    local privilegeUpkeep = CacheManager:getVariableById(Constant.Variable.PrivilegeUpkeep) or 10
    if tonumber(curProp) <= tonumber(privilegeUpkeep) then
        local costNum = lt.NpcModule:getRepairPrice(item)
        local enoughMoney = self:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN, costNum, {tips = false})
        if enoughMoney then
            --服务器交互
            lt.NpcModule:sendEquipRepair(0, 0, item:getItemUid(), true)
        end
    end
end


function ItemModule:initUnpackItem()
    self._hpArr = self:getUnpakcItemArr(4001)
    self._mpArr = self:getUnpakcItemArr(4002)
    self._hpMpArr = self:getUnpakcItemArr(4003)
end

function ItemModule:getUnpakcItemArr(id)
    -- local uiConfig = lt.CacheManager:getUIConfig(id)
    -- local itemStr = uiConfig:getUnpackItemId()
    -- local arr = string.split(itemStr, ",")
    -- return arr
    return {}
end

function ItemModule:unpackItemType(id)
    -- 红
    for i,v in ipairs(self._hpArr) do
        if tonumber(v) == id then
            return 1
        end
    end
    -- 蓝
    for i,v in ipairs(self._mpArr) do
        if tonumber(v) == id then
            return 2
        end
    end
    -- 瞬药
    for i,v in ipairs(self._hpMpArr) do
        if tonumber(v) == id then
            return 3
        end
    end

    return 0
end

