
local NameFirstDao = {}

function NameFirstDao:queryAll()
    local nameFirstTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM GenerateFirstName;") do
    	if not nameFirstTable[row.Type] then
    		nameFirstTable[row.Type] = {}
    	end
        table.insert(nameFirstTable[row.Type], row.FirstName)
    end

    return nameFirstTable
end

return NameFirstDao
