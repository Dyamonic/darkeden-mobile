local HeroStateMountIdle = class("HeroStateMountIdle", lt.HeroStateBase)
local Constant = lt.Constant
HeroStateMountIdle._isHit = false

function HeroStateMountIdle:ctor(heroAgent, delayHandle)
    HeroStateMountIdle.super.ctor(self, heroAgent)

    local mountId = self._heroAgent:getHeroData():getMountId()
    local actionId = Constant.ACTION_SLAYER_MOTOR_STAND
    if Constant.MOUNT_ADVANCED_ITEMS3[mountId] then
        actionId = Constant.ACTION_STAND
    end
    self._heroAgent:playAction(actionId)
    self._delayHandle = delayHandle
end

function HeroStateMountIdle:onClear()
    HeroStateMountIdle.super.onClear(self)
end

function HeroStateMountIdle:onEnter()
    self._heroAgent:setSkillId(nil)
    self._heroAgent:setAutoSkill(false)
end

function HeroStateMountIdle:onExit()
end

function HeroStateMountIdle:onUpdate()
    -- 其他玩家
    if not self._heroAgent:getIsSelf() then
        local cmd = self._heroAgent:getCmdSystem():pop()
        if cmd then
            self._heroAgent:handleCmd(cmd)
        end
        return
    end

    if self._heroAgent:getIsOutOfGame() then
        self._heroAgent:changeState(lt.HeroStateDie.new(self._heroAgent))
        return
    end

    local skillId,level = self:getCurUseSkillId(self._heroAgent)
    if skillId then
        local isSuccess = self:handleSkill(skillId, {level = level})
        --技能释放失败设置autoskill = false
        if not isSuccess then
            self._heroAgent:setAutoSkill(false)
        end
    end

    -- FIXME 确认delayHandle 作用
    --[[
    local deltaTime = lt.GameBoard:getDeltaTime()
    if self._delayHandle and self._delayHandle > 0 then
        self._delayHandle = self._delayHandle - deltaTime
        if self._delayHandle > 0 then
            return
        end
    end
    ]]
end

function HeroStateMountIdle:onMessage(msg)
    if msg.msgId == Constant.MSG_MOVE_JOYSTICK or msg.msgId == Constant.MSG_MOVE_TOUCH then
        -- 无法移动
        if not self._heroAgent:canMove() then
            return
        end
        
        if msg.msgId == Constant.MSG_MOVE_TOUCH and msg.moveType == Constant.MOVE_NONE then
            return
        end

        -- 摇杆控制移动/点击控制移动
        self._heroAgent:changeState(lt.HeroStateMountMove.new(self._heroAgent, msg.moveType, msg.moveDirection, msg.mNext, msg.nNext))
        return
    elseif msg.msgId == Constant.MSG_ROUTE then
        -- 寻路处理
        -- TODO 测试 寻路逻辑，状态切换至HeroStateMountMove
        self._heroAgent:handleRouteMsg(msg)
    elseif msg.msgId == Constant.MSG_SKILL then
        -- 释放空技能 下车
        lt.GameModule:sendAttack(0, 0, 0, 0, 0)
    end
end

function HeroStateMountIdle:getStateId()
    return Constant.HERO_STATE_MOUNT_IDLE
end

function HeroStateMountIdle:getStateName()
    return "HeroStateMountIdle"
end

function HeroStateMountIdle:handleSkill(skillId, params)
    params = params or {}
    params.showTips = self._handleSkillRet
    self._handleSkillRet = self._heroAgent:handleSkill(skillId, params)
    return self._handleSkillRet
end

function HeroStateMountIdle:getCurUseSkillId(heroAgent)
    local skillId, level = heroAgent:getSkillId()
    if not skillId then
        return nil, nil
    end

    -- 等级为0 不释放技能
    if level == 0 then
        return nil, nil
    end

    -- 技能Cd完毕
    if not lt.SkillCdManager:isReady(skillId) then
        return nil, nil
    end

    -- 验证技能是否已使用
    local canUse = not heroAgent:getIsSkillIdUsed(skillId)
    if not canUse then
        return nil, nil
    end

    return skillId,level
end

return HeroStateMountIdle