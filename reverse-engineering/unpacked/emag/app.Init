ltMetaTable = {}
lt = {}
setmetatable(lt, ltMetaTable)

ltMetaTable.__index = function(table, name)
    table[name] = require(ltMetaTable[name])
    return table[name]
end

function lt.getClass(name)
    if lt[name] == nil then
        lt[name] = require(ltMetaTable[name])
    end

    return lt[name]
end

-- 重载脚本
function lt.reload(name)
    if DEBUG > 0 then
        if lt[name] then
            package.loaded[ltMetaTable[name]] = nil
            lt[name] = nil
        end
    end
end

