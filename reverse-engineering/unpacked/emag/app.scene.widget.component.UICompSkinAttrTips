---@class UICompSkinAttrTips
local UICompSkinAttrTips = class("UICompSkinAttrTips", lt.UICompBase)

local CacheManager = lt.CacheManager
local PetModule    = lt.PetModule
local CommonFunc   = lt.CommonFunc

function UICompSkinAttrTips:ctor()
    UICompSkinAttrTips.super.ctor(self)
    self:makeFullScreen()
end

function UICompSkinAttrTips:onConstruct()
    self._list = self:getChild("skin_attr"):getChild("list")
    self._list:setItemRenderer(handler(self, self.renderTextItem))
    
    local visibleSize = cc.Director:getInstance():getVisibleSize()
    self:setSize(visibleSize.width, visibleSize.height)
end

function UICompSkinAttrTips:onEnter()
    UICompSkinAttrTips.super.onEnter(self)
    
    self:addClickListener(handler(self, self.onLayerClick))
end


function UICompSkinAttrTips:onExit()
    UICompSkinAttrTips.super.onExit(self)

    self:removeClickListener()
end

function UICompSkinAttrTips:onClear()
end

function UICompSkinAttrTips:refreshTips(param)
    local skinAttr = self:getChild("skin_attr")
    skinAttr:setPivot(0, 0, true)
    local pt = param.pt -- 位置
    if pt then
        skinAttr:setPosition(math.floor(pt.x), math.floor(pt.y))
    end

    self._skinAttrList = PetModule:getPetSkinAttrList() or {}
    self._list:setNumItems(#self._skinAttrList)
end

function UICompSkinAttrTips:renderTextItem(index, obj)
    local skinAttr = self._skinAttrList[index + 1]
    local value = CommonFunc.getOptionInfoStrName2(skinAttr[1], skinAttr[2])
    obj:getChild("title"):setText(value)
end

function UICompSkinAttrTips:onLayerClick()
    self:setVisible(false)
    self._skinAttrList = nil
end

return UICompSkinAttrTips