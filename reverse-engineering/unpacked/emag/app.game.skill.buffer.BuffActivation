local BuffActivation = class("BuffActivation", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local ScheduleUtil  = lt.ScheduleUtil

--[[
    狂暴
]]
function BuffActivation:ctor(time, actor, skilllevel)    
    BuffActivation.super.ctor(self, BuffEnum.EFFECT_CLASS_ACTIVATION, time, actor)
    -- 播放手上动画
    actor:playHandEffect(SkillEnum.SKILL_ACTIVATION)
end

function BuffActivation:onClear()
    self._actor:stopHandAction(SkillEnum.SKILL_ACTIVATION)
    BuffActivation.super.onClear(self)
end

return BuffActivation
