    self._mapCode       = row.MapCode
    self._purposeLevelConvert = CommonFunc:analysisJsonToTable(self._purposeLevel)
    self._displayRace   = row.DisplayRace
end

function TeamHallMeta:getPurposeLevel()
    return self._purposeLevelConvert
end

