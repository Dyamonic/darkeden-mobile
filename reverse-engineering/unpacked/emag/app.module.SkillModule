function SkillModule:getSkillOperatorSize(skillId)
    local size = self:getSkillPixelRect(skillId)

    return size.width, size.height
end

-- 基础判断
function SkillModule:checkCanUseSkill(skillId)
    -- 普通技能直接返回
    if SkillCdManager:IsNormalSkill(skillId)then
        return true
    end

    --取消变身忽略cd
    local isTransforming, transformId = false, 0
    if self:isVampire() then
        isTransforming,transformId = self:isTransforming()
    end

    -- 检查cd
    if not SkillCdManager:isReady(skillId) and not isTransforming then
        return false
    end

    return true
end

--检查人族领域等级
function SkillModule:checkSlayerDomainLevel(skillId)
    local curRace = GameModule:getHeroRace()
    -- 检查人族领域限制
    if curRace == Constant.RaceType.Slayer then
        local skillMeta = CacheManager:queryMetaBySkillId(skillId)
        local heroData = GameModule:getHeroData()
        local levelTable = heroData:getSlayerLevelTable()
        local curDomainLvl = levelTable[skillMeta:getDomain()]
        if not curDomainLvl then
            curDomainLvl = heroData:getLevel()
        else
            curDomainLvl = curDomainLvl + heroData:getAdvanceLevel()
        end
        
        if curDomainLvl < skillMeta:getNeedLevel() then
            return false, GReadText.KEY_SKILL_LIMIT_TIPS8
        end
    end
    return true
end

-- 判断技能在触摸开始事件中是否能使用
function SkillModule:checkSkillEventBegin(heroAgent,skillId)
    local raceType = GameModule:getHeroRace()
    local SKILL_RELESE_TIPS = self.SKILL_RELESE_TIPS
    --- 无关种族
    -- 沉默buff 无法释放技能
    if heroAgent:hasBuffer(BuffEnum.EFFECT_CLASS_PLEASURE_EXPLOSION) then
        return false,SKILL_RELESE_TIPS.PLEASURE_EXPLOSION
    end

    -- 眩晕时只能放普攻
    if heroAgent:hasBuffer(BuffEnum.EFFECT_BLOCK_HEAD) and skillId ~= lt.SkillEnum.NORAML_MELEE and skillId ~= lt.SkillEnum.NORMAL_RANGE then
        return false, SKILL_RELESE_TIPS.BLOCKHEAD
    end

    -- 目标条件判断[后面有技能攻击目标逻辑，不再需要这里判断目标]
    -- local skillMeta = CacheManager:queryMetaBySkillId(skillId)
    -- local isToSelf = skillMeta:isToSelf()
    -- if heroAgent:getTargetAgentId() == heroAgent:getAgentId() and not isToSelf then
    --     return false, SKILL_RELESE_TIPS.LIMIT_SELF
    -- end

    --被吸血时 无法释放技能
    if heroAgent:hasBuffer(BuffEnum.EFFECT_CLASS_BLOOD_DRAINING) then
        return false, SKILL_RELESE_TIPS.BLOODYING
    end
    
    -- 判断技能是否需要特定道具
    local isReadyItem, itemName = self:isReadyUseItems(skillId)
    if not isReadyItem then
        return false, string.format(SKILL_RELESE_TIPS.USEITEM, itemName)
    end

    --需要道具的相关条件
    local isReadyItemCondition, itemName = self:isReadyItemSpecialCondition(skillId)
    if not isReadyItemCondition then 
        return false, string.format(SKILL_RELESE_TIPS.USEITEM_CONDITION, itemName)
    end

    --技能释放前置条件需求(武器类型,精灵石)  判断身上的武器、精灵石头是否满足释放条件
    local isReadyCondition, tips = self:isReadyCondition(skillId)
    if not isReadyCondition then
        return false, tips
    end



    ---特定种族判断
    if raceType == Constant.RaceType.Slayer then
          
        -- 转生术无法释放，可装轮盘
        if skillId == lt.SkillEnum.SKILL_ETERNITY then
            return false
        end

        -- 枪的类型必须与子弹类型一致
        if skillId == lt.SkillEnum.SKILL_PIERCING and heroAgent:getWeaponType() == lt.Constant.WeaponType.SGGun then
            return false, SKILL_RELESE_TIPS.LIMIT_PIERCING
        end

        -- 人族领域等级
        local isDomainLv, msg = SkillModule:checkSlayerDomainLevel(skillId)
        if not isDomainLv then
            return false, msg
        end
    elseif raceType == Constant.RaceType.Vampire then
        
        -- 变身狼时 无法释放石之肌肤
        if heroAgent:hasBuffer(BuffEnum.EFFECT_CLASS_STONE_SKIN) and (skillId == lt.SkillEnum.TRANSFORM_TO_WOLF or skillId == lt.SkillEnum.TRANSFORM_TO_WERWOLF) then
            return  false, SKILL_RELESE_TIPS.STONE_SKIN
        end
        -- 战争咆哮（需要变身小狼才可使用）1
        if skillId == lt.SkillEnum.MAGIC_HOWL then
            local isTransforming, transformId = self:isTransforming()
            return isTransforming == true and transformId == lt.SkillEnum.TRANSFORM.WOLF, SKILL_RELESE_TIPS.TRANSFORMWOLF
        end

        -- 死亡之吻
        if skillId == lt.SkillEnum.MAGIC_BITE_OF_DEATH then
            local isTransforming, transformId = self:isTransforming()
            return isTransforming == true and transformId == lt.SkillEnum.TRANSFORM.WERWOLF, SKILL_RELESE_TIPS.TRANSFORMWERWOLF
        end

        --变身限制  FIXME 待验证
        local isReadyTransform = self:isReadyTransform(skillId)
        local wolfNormal = self:transformUseSkill(skillId)
        if (not isReadyTransform) and not wolfNormal then
            return false, SKILL_RELESE_TIPS.TRANSFORM
        end
        if skillId == lt.SkillEnum.SKILL_BLOOD_DRAIN then
            local _can,tips = self:checkCanUseBloodDrainSkill(skillId,heroAgent)
            if not _can then
                return _can,tips
            end
        end
       
    elseif raceType == Constant.RaceType.Ousters then
        -- 魔族普攻需要判断武器
        if not self:outersMeleeLimit(skillId) then
            return false, GReadText.KEY_SKILL_LIMIT_TIPS1
        end
    end
  
    return true
end

--- 使用技能 Once 只触发一次
---@param skillId number 技能Id
function SkillModule:useSkill(skillId, isLongPress)
    local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()

    -- 自己死亡限制
    if not heroAgent:isAlive() then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PLAYER_IS_DIE})
        return
    end

    -- 取消安装炮塔
    local hasBufferTurret = heroAgent:hasBuffer(lt.BuffEnum.EFFECT_INSTALL_TURRET)
    if hasBufferTurret and skillId ~= SkillEnum.SKILL_TURRET_FIRE then
        GameModule:sendAttack(0, 0, 0, 0, 0)
        return
    end

    -- 取消隐匿
    local heroData = GameModule:getHeroData()
    if heroData:isSkillHide() then
        GameModule:sendAttack(0, 0, 0, 0, 0)
        return
    end

    -- 取消召唤-精灵
    local hasBuffer = heroAgent:hasBuffer(lt.BuffEnum.EFFECT_SUMMON_SYLPH)
    if hasBuffer then
        GameModule:sendAttack(0, 0, 0, 0, 0)
        return
    end

    --变身技能
    if table.keyof(SkillEnum.TRANSFORM_SKILL, skillId) then
        if SkillModule:isTransforming() then
            -- 发送取消变身协议
            SkillModule:sendCancelTransform()
        else
            local isCanAttack,msg = SkillModule:checkCanUseTransformSkill(skillId,heroAgent)
            if isCanAttack then
                -- 藤蔓不能使用任何技能
                if heroAgent:hasBuffer(BuffEnum.EFFECT_CLASS_VINE) then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = SkillModule.SKILL_RELESE_TIPS.LIMIT_VINE_BUFF})
                    return  
                end
                GameModule:sendAttack(skillId, -1, 0, 0, 0)
            else
                lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = msg})
            end
        end
        return
    end

    -- 血之印记
    if skillId == SkillEnum.MAGIC_BLOODY_MARK then
        local itemId = SkillEnum.USE_SKILL_ITEMS[skillId]
        local item = lt.ItemModule:getNotMarkItemById(itemId, Constant.ItemType.ITEM_TYPE_PROP)
        if item then
            local itemObjId = item:getObjId()
            GameModule:sendAttack(skillId, -1, 0, 0, 0, itemObjId)
        end
        return
    end

    --血之漩涡
    if skillId == SkillEnum.BLOODY_TUNNEL then
        for k, v in ipairs(SkillEnum.USE_SKILL_ITEMS[skillId]) do
            local item = lt.ItemModule:getMarkItemById(v, Constant.ItemType.ITEM_TYPE_PROP)
            if item then
                local itemObjId = item:getObjId()
                GameModule:sendAttack(skillId, -1, 0, 0, 0, itemObjId)
            end
            return
        end
    end

    -- 圣水制造（人祝） -- 召唤-精灵
    if skillId == SkillEnum.SKILL_CREATE_HOLY_POTION or skillId == SkillEnum.SKILL_CREATE_HOLY_POTION_DOCTOR or skillId == SkillEnum.SKILL_SUMMON_SYLPH then
        local itemObjId = lt.ItemModule:getObjIdBySkillId(skillId)
        if itemObjId then
            GameModule:sendAttack(skillId, -1, 0, 0, 0, itemObjId)
        else
            yflog:Info("not enough")
            local tips = ""
            if skillId == SkillEnum.SKILL_CREATE_HOLY_POTION then
                tips = GReadText.KEY_SKILL_LIMIT_TIPS5
            elseif skillId == SkillEnum.SKILL_SUMMON_SYLPH then
                tips = GReadText.KEY_SKILL_LIMIT_TIPS6
            elseif skillId == SkillEnum.SKILL_CREATE_HOLY_POTION_DOCTOR then
                tips = GReadText.KEY_SKILL_LIMIT_TIPS5
            end
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = tips})
        end
        return
    end

    -- 灵魂锁链
    if skillId == SkillEnum.SKILL_SOUL_CHAIN then
        local skillMeta = CacheManager:querySkillMeta(skillId)
        local condition, tips = heroAgent:checkSkillCondition(skillId, skillMeta)
        if not condition then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = tips})
            return 
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_OPEN_TRACE_UI)
        return 
    end
    -- if heroAgent:checkMovingAttack(skillId) then
    heroAgent:onMessage({msgId=lt.Constant.MSG_SKILL, skillId=skillId, mNext = lt.GameBoard:getSkillMNext(), nNext = lt.GameBoard:getSkillNNext()})
    -- end
end

function SkillModule:checkCanUseTransformSkill(skillId,heroAgent)
    if not SkillCdManager:isReady(skillId) then
        return false, SkillModule.SKILL_RELESE_TIPS.CD
    end
    -- 血蓝
    local isCanUse, tips = heroAgent:checkHpMp(skillId, heroAgent:getRaceType())
    return isCanUse, tips
end

--是否能用吸血
function SkillModule:checkCanUseBloodDrainSkill(skillId,heroAgent)
    if not SkillCdManager:isReady(skillId) then
        return false, SkillModule.SKILL_RELESE_TIPS.CD
    end
    local isCanUse,tips = heroAgent:getCanBloodDrain()
    return isCanUse,tips
end

function SkillModule:isSkillOnPress()
    return self._isSkillOnPress
end
function SkillModule:setSkillOnPress(isPressing)
    self._isSkillOnPress = isPressing
end


function SkillModule:skillItemUseLimit(itemId)
    local skillId = table.keyof(SkillEnum.USE_SKILL_ITEMS, itemId)
    if not skillId then
        return false, ""
    end
    
    local skillMeta = lt.CacheManager:querySkillMeta(skillId)
    if not skillMeta then
        return false, ""
    end

    local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
    if not heroAgent then
        return false, ""
    end

    local isCanUse, msg = heroAgent:checkSkillCondition(skillId, skillMeta)
    return isCanUse, msg
end


function SkillModule:getSelectColor()
    local worldAgent = lt.AgentManager:getWorldAgent()
    local heroAgent = worldAgent:getHeroAgent()
    local selectAgent  = heroAgent:getTargetAgent(false)
    if not selectAgent then
       return false 
    end
    if selectAgent:isNpcAgent() then
        return Constant.COLOR_GL_GREEN
    else
        if heroAgent:isEnemyAgent(selectAgent) then
            return Constant.COLOR_GL_RED
        else
           return Constant.COLOR_GL_BLUE
        end
    end
    return Constant.COLOR_GL_GREEN
end

--获得配置技能
function SkillModule:getEditSkills()
    --单体技能,群体技能,治疗技能,减益技能,增益技能,复活技能,其他技能,被动技能
    local skillArray = {{}, {}, {}, {}, {}, {}, {}, {}}
    local skillData = self:getSkillList()
    for k, v in pairs(skillData) do
        local skillId = v:getSkillId()
        local skillCfg = CacheManager:querySkillMeta(skillId)
        local group = skillCfg:getIndividualOrGroup()
        --被动技能放在最后
        if group == 0 then group = 8 end
        --插入技能
        table.insert(skillArray[group], skillCfg:getSkillId())
    end
    return skillArray
end

--自动战斗可设置的技能
function SkillModule:getAutoSkills()
    --单体技能
    local skillSingleData = {}
    --群体技能
    local skillAreaData = {}
    --增益技能
    local skillBuffData = {}
    --治疗技能
    local skillHealData = {}

    local skillData = self:getSkillList()
    for k, v in pairs(skillData) do
        local skillId = v:getSkillId()
        local skillCfg = CacheManager:querySkillMeta(skillId)
        if skillCfg:getIndividualOrGroup() == SINGLE then
            table.insert(skillSingleData, skillCfg:getSkillId())
        elseif skillCfg:getIndividualOrGroup() == AREA then
            table.insert(skillAreaData, skillCfg:getSkillId())
        elseif skillCfg:getIndividualOrGroup() == BUFF then
            table.insert(skillBuffData, skillCfg:getSkillId())
        elseif skillCfg:getIndividualOrGroup() == HEAL then
            table.insert(skillHealData, skillCfg:getSkillId())
        end
    end

    return skillSingleData, skillAreaData, skillBuffData, skillHealData
end

--更新自动战斗配置的技能
function SkillModule:updateAutoSettingSkills()
    if self._saveData == nil then
        self:getEditConf()
    end
    self._autoSingleSkills = {}
    self._autoAreaSkills = {}
    self._autoBuffSkills = {}
    self._autoHealSkills = {}
    --是否拥有吸血技能
    self._hasBloodDrain = false
    --是否拥有灵魂吸收技能
    self._hasAbsorbSoul = false
    --30到39的是自动挂机技能
    for idx = 30, 39 do
        local skill = self._saveData[idx]
        if skill and skill.skillId then
            local skillId = skill.skillId
            local skillCfg = CacheManager:querySkillMeta(skillId)
            if self:isReadyCondition(skillId) then
                if skillId == SkillEnum.SKILL_BLOOD_DRAIN then
                    --吸血
                    self._hasBloodDrain = true
                elseif skillId == SkillEnum.SKILL_ABSORB_SOUL then
                    --吸蓝
                    self._hasAbsorbSoul = true
                else
                    --其他自动挂机技能
                    if skillCfg:getIndividualOrGroup() == SINGLE then
                        table.insert(self._autoSingleSkills, skillId)
                    elseif skillCfg:getIndividualOrGroup() == AREA then
                        table.insert(self._autoAreaSkills, skillId)
                    elseif skillCfg:getIndividualOrGroup() == BUFF then
                        local buffMeta = CacheManager:getBuffBySkillId(skillId)
                        if buffMeta then
                            self._autoBuffSkills[skillId] = buffMeta:getBuffId()
                        end
                    elseif skillCfg:getIndividualOrGroup() == HEAL then
                        table.insert(self._autoHealSkills, skillId)
                    end
                end
            end
        end
    end
end

--获得自动挂机单体技能
function SkillModule:getAutoSingleSkills()
    return self._autoSingleSkills or {}
end

--自动挂机单体技能切换到下一个
function SkillModule:nextAutoSingleSkills(skillId)
    local idx = -1
    for k, v in ipairs(self._autoSingleSkills) do
        if v == skillId then
            idx = k
            table.remove(self._autoSingleSkills, k)
            break
        end
    end
    if idx > 0 then
        self._autoSingleSkills[#self._autoSingleSkills + 1] = skillId
        return
    end
end

--获得自动挂机群体技能
function SkillModule:getAutoAreaSkills()
    return self._autoAreaSkills or {}
end

--自动挂机群体技能切换到下一个
function SkillModule:nextAutoAreaSkills(skillId)
    local idx = -1
    for k, v in ipairs(self._autoAreaSkills) do
        if v == skillId then
            idx = k
            table.remove(self._autoAreaSkills, k)
            break
        end
    end
    if idx > 0 then
        self._autoAreaSkills[#self._autoAreaSkills + 1] = skillId
        return
    end
end


-- 获取循环动画配置
function SkillModule:getRepeatConfig(actionId,skillId)
    -- 一般根据动作获取配置
    local mulFrame = Constant.MUL_FRAME[actionId] or 7 -- 发攻击包（特效播放）对应的帧数
    local repeatCount = Constant.MUL_FRAME_REPEAT[actionId] or 4 -- 重复播放的帧数
    local repeatStart = Constant.MUL_FRAME_REPEAT_START[actionId] or mulFrame -- 重复动画起始帧

    -- 特殊技能按照特殊处理
    if skillId == SkillEnum.SKILL_TURRET_FIRE then
        mulFrame = 14
        repeatCount = 6
        repeatStart = 14
    elseif skillId == SkillEnum.SKILL_PLASMA_ROCKET_LAUNCHER or skillId == lt.SkillEnum.SKILL_XRL_MISSILE then
        local frameData = (Constant.MUL_FRAME_TABLE[skillId] or {})[actionId]
        if frameData then
            mulFrame = frameData.MUL_FRAME or mulFrame
            repeatCount = frameData.MUL_FRAME_REPEAT or repeatCount
            repeatStart = frameData.MUL_FRAME_REPEAT_START or repeatStart
        end
    elseif skillId == lt.SkillEnum.SKILL_INNATE_DEADLY_CLAW then
        mulFrame = 4
        repeatCount = 5
        repeatStart = 4
    elseif skillId == lt.SkillEnum.SKILL_SET_AFIRE then
        mulFrame = 6
        repeatCount = 11
        repeatStart = 1
    end

    return mulFrame, repeatCount, repeatStart
end

-- 检查技能表用旧表还是新表（
function SkillModule:checkSkillNew(skillId)
    if SkillEnum.OldSkillTable[skillId] then
        return false
    end

	if SkillEnum.NewSkillTable[skillId] then
		return true
	end

    local skillVirtualLevel = CacheManager:getStartActionLevelBySkillId(skillId)
    if skillVirtualLevel and skillVirtualLevel > 35 then -- 此处判断条件谨慎变动
        return true
    else
        return false
    end

end

--获得自动挂机增益技能
function SkillModule:getAutoBuffSkills()
    return self._autoBuffSkills or {}
end

--获得自动挂机回血技能
function SkillModule:getAutoHealSkills()
    return self._autoHealSkills or {}
end

--获得自动挂机是否有吸血技能
function SkillModule:hasBloodDrain()
    return self._hasBloodDrain or false
end

--获得自动挂机是否有吸蓝技能
function SkillModule:hasAbsorbSoul()
    return self._hasAbsorbSoul or false
end

return SkillModule