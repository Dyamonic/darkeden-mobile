    CD = GReadText.KET_SKILL_TIPS47,
    BUFFCD = GReadText.KET_SKILL_TIPS48,
    USEITEM = GReadText.KET_SKILL_TIPS49,
    TRANSFORM = GReadText.KET_SKILL_TIPS50,
    USEITEM_CONDITION = GReadText.KET_SKILL_TIPS51,
    HIDE = GReadText.KET_SKILL_TIPS52,
    MPLIMIT = GReadText.KET_SKILL_TIPS53,
    BLOCKHEAD = GReadText.KET_SKILL_TIPS54,
    BLOODYING = GReadText.KET_SKILL_TIPS55,
    STONE_SKIN = GReadText.KET_SKILL_TIPS56,
    HPMP = GReadText.KET_SKILL_TIPS57,
    TRANSFORMWOLF = GReadText.KET_SKILL_TIPS58,
    EATCORPSE = GReadText.KET_SKILL_TIPS59,
    TRANSFORMWERWOLF = GReadText.KET_SKILL_TIPS60,
    NEED_BULLET = GReadText.KET_SKILL_TIPS61,
    NEED_INSTALL_TURRET = GReadText.KET_SKILL_TIPS62,
    MAP_LIMIT = GReadText.KET_SKILL_TIPS63,
    LIMIT_SELF = GReadText.KET_SKILL_TIPS64,
    LIMIT_PIERCING = GReadText.KET_SKILL_TIPS65,
    PLEASURE_EXPLOSION = GReadText.KET_SKILL_TIPS67,
    LIMIT_VINE_BUFF = GReadText.KEY_SKILL_VINE_TIPS,
