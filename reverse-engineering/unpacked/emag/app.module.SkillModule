function SkillModule:onCrossCounter(event)
    local proto = event.param
    yflog:Info("SkillModule:onCrossCounter fromObjId:%s targetObjId:%s skillId:%s",proto.objID, proto.targetID, proto.skillCode)
    if not proto then
        return
    end
    local worldAgent = lt.AgentManager:getWorldAgent()
    if worldAgent then
        worldAgent:createCrossCounterAgents(proto.objID, proto.targetID, proto.skillCode)
    end
end

function SkillModule:getWeaponType()
    local curRace = GameModule:getHeroRace()
    local equipName = Constant.RaceToJobPanel[curRace] .. "EquipPos"
    local armsPos = Constant[equipName].Arms
    local item = lt.ItemModule:getEquipItemByPos(armsPos)
    local armsKind
    if item then
        armsKind = item:getMetaType()
    end
    
    return armsKind
end

function SkillModule:getNoramlSkillId()
    local race = GameModule:getHeroData():getRace()
    if race == Constant.RaceType.Slayer then
        return SkillEnum.NORMAL_RANGE
    else
        return SkillEnum.NORAML_MELEE
    end
end

-- 人族普攻17002
function SkillModule:getEditSkillConf()
    local default = clone(lt.SkillEditDefaultConf)
    local race = GameModule:getHeroData():getRace()
    if race == Constant.RaceType.Slayer then
        default[1].skillId = SkillEnum.NORMAL_RANGE
        default[30].skillId = SkillEnum.NORMAL_RANGE
    else
        default[1].skillId = SkillEnum.NORAML_MELEE
        default[30].skillId = SkillEnum.NORAML_MELEE
        if race == Constant.RaceType.Vampire then
            default[2].skillId = SkillEnum.SKILL_BLOOD_DRAIN
            default[31].skillId = SkillEnum.SKILL_BLOOD_DRAIN
        else
            default[2].skillId = SkillEnum.SKILL_ABSORB_SOUL
            default[31].skillId = SkillEnum.SKILL_ABSORB_SOUL
        end
    end
    return default
end

-- 根据范围修正落点
function SkillModule:calxFixedPoint(x1, y1, x2, y2, skillRange)
    local dx = x2 - x1
    local dy = y2 - y1
    local d = math.sqrt(dx^2 + dy^2)
    if d == 0 then
        return x1, y1
    end

    local tx = x1 + dx / d * skillRange * Constant.MAP_BLOCK_WIDTH
    local ty = y1 + dy / d * skillRange * Constant.MAP_BLOCK_HEIGHT

    return tx, ty
end


--死亡是否关闭特效
function SkillModule:isCloseEffect(skillId, target, effectName)
    if not skillId then return false end
    local skillMeta = CacheManager:queryMetaBySkillId(skillId)
    if not target then return false end
    local isDie = target.isDie and target:isDie()
    if isDie then
        if skillMeta then
            local needSkillEffect = skillMeta:getDieNeedSkillEffect()
            if needSkillEffect == 1  then
                if skillId == SkillEnum.SKILL_WHITSUNTIDE 
                or skillId == SkillEnum.SKILL_RESURRECT 
                or skillId == SkillEnum.SKILL_SUMMON_MIGA
                or skillId == SkillEnum.SKILL_SUMMON_OF_GROUND_ELEMENTAL
                then
                    return false
                end
                if skillId == SkillEnum.SKILL_HARPOON_BOMB then
                    return effectName ~= Constant.EFFECT.HIT
                elseif skillId == SkillEnum.SKILL_HETER_CHAKRAM then
                    return effectName ~= Constant.EFFECT.SELF
                end
                return effectName ~= Constant.EFFECT.PROCESS
            else
                return true  
            end
        end
        return true
    end
    return false
end


--检查子弹数量
function SkillModule:checkBulletNum(skillId)
    local skillMeta = CacheManager:queryMetaBySkillId(skillId)
    local needBullet = skillMeta:isNeedBullet()
    if needBullet and ItemModule:checkCurEquipIsGun() then
        local item = ItemModule:getEquipItemByPos(Constant.SlayerEquipPos.Arms)
        if item then
            local bulletCount = item:getAmmoCount()

            -- FIXME 在外面检查子弹不足时的音效播放
            -- if bulletCount <= 0 then
            --     lt.AudioManager:playSound(Constant.SoundEffect.ItemNoMagazineSound)
            -- end


            return bulletCount > 0
        end
    end
    return true
end

--获取子弹数量
function SkillModule:getBulletNum(skillId)
    local needBullet = true
    if skillId ~= nil then
        local skillMeta = CacheManager:queryMetaBySkillId(skillId)
        needBullet = skillMeta:isNeedBullet()
    end
    if not needBullet then
        return 0
    end

    local item = ItemModule:getEquipGun()
    if not item then
        return 0
    end

    return item:getAmmoCount() or 0
end

function SkillModule:setTouchMoving(isTouch)
    self._isTouchMoving = isTouch
end
function SkillModule:getTouchMoving()
    return self._isTouchMoving
end

------------------红点------------------
function SkillModule:checkRedTips(main, sub)
    local heroData = GameModule:getHeroData()
    local race = heroData:getRace()
    local heroLv = heroData:getLevel()
    local grade = heroData:getGrade()
    local isRed = false
    if main == Constant.ROLE_MAINIDX.ROLE then
        local totalPoints = heroData:getCurSkillPoint()
        isRed = totalPoints > 0
    elseif main == Constant.ROLE_MAINIDX.MAGIC then
        local curSkills = CacheManager:getSkillByRace(race)
        if race == Constant.RaceType.Ousters then
            for k, v in pairs(curSkills) do
                local skillId = v:getSkillId() or 0
                local list = Constant["OUSTERS_SKILL"..sub]
                local isExit = StrengthenModule:checkExit(list, skillId)
                if isExit then
                    local state = self:getCurSkillState(skillId, list)
                    if state == lt.Constant.SkillState.Learnable then
                        isRed = true
                        break
                    end
                end
            end
        elseif race == Constant.RaceType.Vampire then
            for k, v in pairs(curSkills) do
                local skillId = v:getSkillId() or 0
                local domain = math.floor(skillId/1000) - 5
                if domain == sub and v:getSkillMenu() == 1 and v:getNeedLevel() <= Constant.TransferLevel and heroLv >= v:getNeedLevel() then
                    if not self:hasSkill(skillId) then
                        isRed = true
                        break
                    end
                end
            end
        elseif race == Constant.RaceType.Slayer then
            for k, v in pairs(curSkills) do
                local skillId = v:getSkillId() or 0
                local domain = math.floor(skillId/1000)
                local areaLevel = heroData:getSlayerLevelTable()[sub]
                if domain == sub and v:getSkillMenu() == 1 and v:getNeedLevel() <= Constant.TransferLevel and areaLevel >= v:getNeedLevel() then
                    if not self:hasSkill(skillId) then
                        isRed = true
                        break
                    end
                end
            end
        end
    elseif main == Constant.ROLE_MAINIDX.LOWCLS then
        local curSkills = CacheManager:getRankBonusInfoCfg(race, 1, 4)[sub]
        local canLearn = false
        for k, v in pairs(curSkills) do
            local skillId = v:getRankId() or 0
            local learned = self:checkPassiveSkillLearned(skillId)
            if learned then
                isRed = false
                break
            elseif not learned and grade >= v:getClassLevel() then
                canLearn = true
                isRed = true
            end
        end
        isRed = isRed and canLearn
    elseif main == Constant.ROLE_MAINIDX.SUPERCLS then
        local curSkills = CacheManager:getRankBonusInfoCfg(race, 5, 6)[sub]
        local canLearn = false
        for k, v in pairs(curSkills) do
            local skillId = v:getRankId() or 0
            local learned = self:checkPassiveSkillLearned(skillId)
            if learned then
                isRed = false
                break
            elseif not learned and grade >= v:getClassLevel() then
                canLearn = true
                isRed = true
            end
        end
        isRed = isRed and canLearn
    elseif main == Constant.ROLE_MAINIDX.TRANSFER then
        -- local curSkills = CacheManager:getSkillByRace(race)
        -- local isAdvanve = heroData:getAdvanceState()
        -- if isAdvanve == Constant.AdvState.Adv then
        --     heroLv = Constant.TransferLevel + heroData:getAdvanceLevel()
        -- end
        -- for k, v in pairs(curSkills) do
        --     local skillId = v:getSkillId() or 0
        --     if v:getSkillMenu() == 1 and v:getNeedLevel() > Constant.TransferLevel and heroLv >= v:getNeedLevel() then
        --         if not self:hasSkill(skillId) then
        --             isRed = true
        --             break
        --         end
        --     end
        -- end
        isRed = false
    end
    self:setSkillRedTips(main, sub, isRed)
end

function SkillModule:initRedTips()
    local heroData = GameModule:getHeroData()
    if not heroData then
        return
    end
    local race = heroData:getRace()
    for main = 1, table.nums(Constant.ROLE_MAINIDX) do
        local subIdx = 1
        if main == Constant.ROLE_MAINIDX.MAGIC then
            if race == Constant.RaceType.Ousters then
                subIdx = 2
            elseif race == Constant.RaceType.Vampire then
                subIdx = 6
            elseif race == Constant.RaceType.Slayer then
                subIdx = 5
            end
        elseif main == Constant.ROLE_MAINIDX.LOWCLS then
            subIdx = 4
        elseif main == Constant.ROLE_MAINIDX.SUPERCLS then
            subIdx = 2
        end
        for sub = 1, subIdx do
            self:checkRedTips(main, sub)
        end
    end
end

function SkillModule:setSkillRedTips(main, sub, bool)
    lt.RedDotModule:setTipsStateByName("SkillRedTips_"..main.."_"..sub, bool)
end

function SkillModule:getRedPoint(main, sub)
    local race = GameModule:getHeroData():getRace()
    if main == nil and sub == nil then
        for main = 1, table.nums(Constant.ROLE_MAINIDX) do
            local subIdx = 1
            if main == Constant.ROLE_MAINIDX.MAGIC then
                if race == Constant.RaceType.Ousters then
                    subIdx = 2
                elseif race == Constant.RaceType.Vampire then
                    subIdx = 6
                elseif race == Constant.RaceType.Slayer then
                    subIdx = 5
                end
            elseif main == Constant.ROLE_MAINIDX.LOWCLS then
                subIdx = 4
            elseif main == Constant.ROLE_MAINIDX.SUPERCLS then
                subIdx = 2
            end
            for sub = 1, subIdx do
                local red = self:getRedPoint(main, sub)
                if red then
                    return true
                end
            end
        end
        return false
    elseif main ~= nil and sub == nil then
        local subIdx = 1
        if main == Constant.ROLE_MAINIDX.MAGIC then
            if race == Constant.RaceType.Ousters then
                subIdx = 2
            elseif race == Constant.RaceType.Vampire then
                subIdx = 6
            elseif race == Constant.RaceType.Slayer then
                subIdx = 5
            end
        elseif main == Constant.ROLE_MAINIDX.LOWCLS then
            subIdx = 4
        elseif main == Constant.ROLE_MAINIDX.SUPERCLS then
            subIdx = 2
        end
        for sub = 1, subIdx do
            local red = self:getRedPoint(main, sub)
            if red then
                return true
            end
        end
        return false
    end
    local isShowRedDot = lt.RedDotModule:getTipsStateByName("SkillRedTips_"..main.."_"..sub)
    return isShowRedDot
end

