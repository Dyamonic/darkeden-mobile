function SkillModule:init()
    SocketApi:addProtoListener(ServerCmdDef.S_SINGLE_SKILL, handler(self, self.onSingleSkill), "SkillModule:onSingleSkill")
    SocketApi:addProtoListener(ServerCmdDef.S_SKILL_LIST, handler(self, self.onSkillList), "SkillModule:onSkillList")
    SocketApi:addProtoListener(ServerCmdDef.S_LEARN_SKILL, handler(self, self.onLearnSkill), "SkillModule:onLearnSkill")
    SocketApi:addProtoListener(ServerCmdDef.S_SKILL_DELETE, handler(self, self.onSkillDelete), "SkillModule:onSkillDelete")
    SocketApi:addProtoListener(ServerCmdDef.S_PASSIVE_SKILL_LIST, handler(self, self.onPassiveSkillList), "SkillModule:onPassiveSkillList")
    SocketApi:addProtoListener(ServerCmdDef.S_UPGRADE_SKILL, handler(self, self.onUpgradeSkill), "SkillModule:onUpgradeSkill")
    SocketApi:addProtoListener(ServerCmdDef.S_RETURN_SKIL, handler(self, self.onReturnSkill), "SkillModule:onReturnSkill")
    SocketApi:addProtoListener(ServerCmdDef.S_CROSS_COUNTER_NOTIFY, handler(self, self.onCrossCounter), "SkillModule:onCrossCounter")
    SocketApi:addProtoListener(ServerCmdDef.S_CleanClassSkill, handler(self, self.onCleanClassSkill), "SkillModule:onCleanClassSkill")
    SocketApi:addProtoListener(ServerCmdDef.S_VampireTunnel, handler(self, self.onVampireTunnel), "SkillModule:onVampireTunnel")
    self._isSkillListFirst = true
end

function SkillModule:clear()
    self._skillTable = {}
    self._passiveSkillTable = {}
    self._cleanedClassLevel = {}
    self._skillNeedMana = {}
    self._saveData = nil
    self._skillId = nil
    self._skillLv = nil
    self._skillType = nil
    self._preCheckSkillId = nil
    self._isSkillListFirst = nil
    self._curNeedRefresh = nil
    if self._delayScheule then
        ScheduleUtil:unscheduleGlobal(self._delayScheule)
        self._delayScheule = nil
    end

    SocketApi:removeProtoListenerByTag("SkillModule:onSingleSkill")
    SocketApi:removeProtoListenerByTag("SkillModule:onSkillList")
    SocketApi:removeProtoListenerByTag("SkillModule:onLearnSkill")
    SocketApi:removeProtoListenerByTag("SkillModule:onSkillDelete")
    SocketApi:removeProtoListenerByTag("SkillModule:onPassiveSkillList")
    SocketApi:removeProtoListenerByTag("SkillModule:onUpgradeSkill")
    SocketApi:removeProtoListenerByTag("SkillModule:onReturnSkill")
    SocketApi:removeProtoListenerByTag("SkillModule:onCleanClassSkill")
    SocketApi:removeProtoListenerByTag("SkillModule:onVampireTunnel")
    SocketApi:removeProtoListenerByTag("SkillModule:onCrossCounter")

end


function SkillModule:onSingleSkill(event) 
    lt.LogUtil:debug("SkillModule:onSingleSkill")
    local proto = event.param
    local skillId = proto.skillId
    local skillCd = proto.skillCd
    if type(skillId) == "number" then
        local skill = lt.SkillData.new({
            skillId = skillId,
            skillLevel = proto.skillLevel,
            skillExp = proto.skillExp,
            skillCd = skillCd,
            skillRange = proto.skillRange
        })
        local hasSkill = self:hasSkill(skill:getSkillId())
        
        if skillCd then
            SkillCdManager:setCd(skillId, skillCd / 1000)
        end
        self:setSkill(skill)
        if not hasSkill then
            local skillCfg = CacheManager:querySkillMeta(skill:getSkillId())
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = string.format(GReadText.KEY_NPC_SKILL_TIPS4, skillCfg:getName())})
        end
    end

    local heroData = GameModule:getHeroData()
    local race = heroData:getRace()
    local skillCfg = CacheManager:querySkillMeta(proto.skillId)
    if race ~= Constant.RaceType.Ousters
    or (race == Constant.RaceType.Ousters and skillCfg and skillCfg:getNeedLevel() and skillCfg:getNeedLevel() >= 150) then
        self._curNeedRefresh = true
    end

    if self._delayScheule then
        ScheduleUtil:unscheduleGlobal(self._delayScheule)
        self._delayScheule = nil
    end
    self._delayScheule = ScheduleUtil:performWithDelayGlobal(function()
        -- 刷新我要变强
        local heroData = GameModule:getHeroData()
        if heroData then
            heroData:checkAddPoint()
        end
        lt.RedDotModule:onRedDotNotice(Constant.SYSTEM_TYPES.ROLE)
        
        if self._curNeedRefresh then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_INIT_SKILL_LIST)
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_SKILL_TIPS_INFO)
        end
        self._curNeedRefresh = nil
    end, 0.2)
end

function SkillModule:onSkillList(event)
    lt.LogUtil:debug("SkillModule:onSkillList")
    local proto = event.param
    if proto.skills then
        self._skillTable = {}
        
        for _,v in ipairs(proto.skills) do
            local skill = lt.SkillData.new(v)
            self:setSkill(skill)
        end
    end
    
    ---------------------------------------------------------------------
    -- 技能列表更新，重置不存在的技能
    if self._isSkillListFirst then
        self._isSkillListFirst = false
    else
        if self._saveData == nil then
            self:getEditConf()
        end
        
        for i = 1, Constant.MAX_BTN_COUNT do
            local skillId = self._saveData[i].skillId
            if skillId and not SkillModule:hasSkill(skillId) then
                self._saveData[i].skillId = nil
            end
        end
        
        SkillModule:saveEditConf()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_SLOT)
    end
    ---------------------------------------------------------------------
    
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_INIT_SKILL_LIST)
end

function SkillModule:onLearnSkill(event)
    lt.LogUtil:debug("SkillModule:onLearnSkill")
    local race = GameModule:getHeroData():getRace()
    if race == Constant.RaceType.Ousters then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SKILL_LEARN)
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_INIT_SKILL_LIST)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_SKILL_TIPS_INFO)
    end
    --检测第一页的技能轮盘，没满就自动放入技能轮盘
    if self._saveData == nil then
        self:getEditConf()
    end
    local isAdd = false
    local skillMeta = CacheManager:queryMetaBySkillId(self._skillId)
    --被动技能不自动装备
    if skillMeta and skillMeta:getPassiveSkill() ~= 1 then
        for i = 1, #DEFAULTSKILLS do
            local idx = DEFAULTSKILLS[i]
            if self._saveData[idx].skillId == nil then
                self._saveData[idx].skillId = self._skillId
                isAdd = true
                break
            end
        end
        if skillMeta:getIndividualOrGroup() == SINGLE or
            skillMeta:getIndividualOrGroup() == AREA or
            skillMeta:getIndividualOrGroup() == HEAL or
            skillMeta:getIndividualOrGroup() == BUFF then
            for i = 1, #DEFAULTAUTOSKILLS do
                local idx = DEFAULTAUTOSKILLS[i]
                if self._saveData[idx].skillId == nil then
                    self._saveData[idx].skillId = self._skillId
                    isAdd = true
                    break
                end
            end
        end
    end
    if isAdd then
        SkillModule:saveEditConf()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_SLOT)
    end

    self._skillId = nil
    self._skillLv = nil
    self._skillType = nil
end

function SkillModule:onUpgradeSkill(event)
    lt.LogUtil:debug("SkillModule:onUpgradeSkill")

    local proto = event.param
    local skillLv = proto.skillLv
    local skillId = proto.skillId
    if self._skillTable[skillId] then
        self._skillTable[skillId]:setLevel(skillLv)
    end

    local race = GameModule:getHeroData():getRace()
    if race == Constant.RaceType.Ousters then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SKILL_UPGRADE)
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_INIT_SKILL_LIST)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_SKILL_TIPS_INFO)
    end

    self._skillType = nil
end

function SkillModule:onReturnSkill(event)
    lt.LogUtil:debug("SkillModule:onReturnSkill")

    local proto = event.param
    local skillLv = proto.skillLv
    if self._skillTable[self._skillId] then
        local lv = self._skillTable[self._skillId]:getLevel()
        local isRemove = skillLv == 0
        if isRemove then
            self:removeSkill(self._skillId)
        else
            self._skillTable[self._skillId]:setLevel(skillLv)
        end
        local tipsStr = isRemove and GReadText.KET_SKILL_TIPS37 or GReadText.KET_SKILL_TIPS36

        local cost = "$".. CommonFunc:changeNumberShow(SkillModule:getCleanSkillCoinNum(self._skillId, lv - skillLv, true))
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = string.format(tipsStr, cost)})

        local race = GameModule:getHeroData():getRace()
        if race == Constant.RaceType.Ousters then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_SKILL_RETURN, {isRemove = isRemove, skillId = self._skillId})
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_INIT_SKILL_LIST)
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_SKILL_TIPS_INFO)
        end
    end

    ---------------------------------------------------------------------
    -- 技能返回，重置不存在的技能
    if self._saveData == nil then
        self:getEditConf()
    end

    for i = 1, Constant.MAX_BTN_COUNT do
        if self._saveData[i].skillId == self._skillId then
            self._saveData[i].skillId = nil
        end
    end
    
    SkillModule:saveEditConf()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_SLOT)
    ---------------------------------------------------------------------

    self._skillId = nil
    self._skillType = nil
end

function SkillModule:onSkillDelete(event)
    
end

function SkillModule:onCleanClassSkill(event)
    local ret = event.ret
    if ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_NPC_CLS_SKILL_TIPS11})
        lt.RedDotModule:onRedDotNotice(Constant.SYSTEM_TYPES.ROLE)
    end
end

function SkillModule:onPassiveSkillList(event)
    local proto = event.param
    -- 阶级技能列表
    if proto.skills then
        self._passiveSkillTable = {}
        local skills = proto.skills
        for _,v in ipairs(skills) do
            table.insert(self._passiveSkillTable, v.skillId)
        end
    end

    -- 清除过的阶级等级列表
    if proto.cleanedClassLevel then
        self._cleanedClassLevel = {}
        local cleanedClassLevel = proto.cleanedClassLevel
        -- yflog:Info("SkillModule:onPassiveSkillList--->>>>>  %s",tostring(#cleanedClassLevel))
        -- dump(cleanedClassLevel)
        for k,v in ipairs(cleanedClassLevel) do
            table.insert(self._cleanedClassLevel, v.cleanedClassLevel)
        end
    end

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_INIT_PASSIVE_SKILL_LIST)
    lt.RedDotModule:onRedDotNotice(Constant.SYSTEM_TYPES.ROLE)
end

-- 获取阶级技能列表
function SkillModule:getPassiveSkillList()
    return self._passiveSkillTable or {}
end

-- 检查是否学习过阶级技能技能
function SkillModule:checkPassiveSkillLearned(skillId)
    for _, v in pairs(self._passiveSkillTable) do
        if v == skillId then
            return true
        end
    end

    return false
end

function SkillModule:checkCleanedClassLevel(classLevel)
    for _, v in pairs(self._cleanedClassLevel) do
        if v == classLevel then
            return true
        end
    end

    return false
end

--学习技能
function SkillModule:sendLearnSkill(skillType, skillId, magic)
    if tonumber(lt.ConfigLoader:isDev()) == 1 then
        if CacheManager:checkSkillLevel(skillId) then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = "35级以上技能暂未开放"})
            return 
        end
    end

    local req = lt.netcmd_pb.LearnSkill()
    --类型 0 职业技能 1 阶级技能
    req.type = skillType
    req.id = skillId
    --1 战斗技能 2 魔法技能
    req.magic = magic or 1

    --缓存
    self._skillId = skillId
    self._skillLv = 1
    self._skillType = skillType
    
    SocketApi:sendToGs(lt.ClientCmdDef.C_LEARN_SKILL, req)
end

--升级技能(只支持升一级)
function SkillModule:sendUpgradeSkill(skillType, skillId)
    local req = lt.netcmd_pb.UpgradeSkillReq()
    req.id = skillId

    --缓存
    self._skillType = skillType

    SocketApi:sendToGs(lt.ClientCmdDef.C_UPGRADE_SKILL, req)
end

--回退技能
function SkillModule:sendBackSkill(skillType, skillId, skillLv)
    local req = lt.netcmd_pb.ReturnSkillReq()
    req.id = skillId
    req.lv = skillLv

    --缓存
    self._skillId = skillId
    self._skillType = skillType

    SocketApi:sendToGs(lt.ClientCmdDef.C_RETURN_SKILL, req)
end

