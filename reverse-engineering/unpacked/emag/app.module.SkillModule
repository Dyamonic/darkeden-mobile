SkillModule._passiveSkillTable = {} -- 被动技能Id
SkillModule._cleanedClassLevel = {} -- 清除过的阶级等级
SkillModule._saveData = nil
SkillModule._skillId = nil
SkillModule._skillLv = nil
SkillModule._skillType = nil
SkillModule._cloneAgents = {}
SkillModule._skillNeedMana = {}  -- 自己的技能需要的mana
SkillModule._curNeedRefresh = nil
SkillModule._delayScheule = nil

local PASSIVE = 0       --被动技能
local SINGLE = 1        --单体技能
local AREA = 2          --群体技能
local HEAL = 3          --治疗技能
local DEBUFF = 4        --DeBuff技能
local BUFF = 5          --增益技能
local REVIVE = 6        --复活技能
local OTHER = 7         --其他技能
local DEFAULTSKILLS = {2,3,4,5,10,11,12,13,14}    --默认技能放置位置
local DEFAULTAUTOSKILLS = {31,32,33,34,35,36,37,38,39}    --默认自动技能放置位置

