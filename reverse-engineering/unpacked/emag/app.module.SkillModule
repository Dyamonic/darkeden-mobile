function SkillModule:hasSkill(skillId)
    if not skillId then return nil end
    return self._skillTable[skillId] ~= nil
end

function SkillModule:removeSkill(skillId)
   if self:hasSkill(skillId) then
        self._skillTable[skillId] = nil
   end
end

function SkillModule:getSkillLevel(skillId)
    if not self._skillTable[skillId] then
        return 0
    end

    return self._skillTable[skillId]:getLevel()
end

function SkillModule:setSkill(skill)
    self:initSkillMana(skill:getSkillId())


    self._skillTable[skill:getSkillId()] = skill
end

function SkillModule:getSkillExp(skillId)
    if not self._skillTable[skillId] then
        return 0
    end

    return self._skillTable[skillId]:getExp()
end

-- Setter && Getter
function SkillModule:getSkillTable()
    return self._skillTable
end

function SkillModule:getActiveSkillTable()
    local skills = {}
    for k, v in pairs(self._skillTable) do
        local skillCfg = CacheManager:querySkillMeta(v:getSkillId())
        if skillCfg:getPassiveSkill() == 0 then
            skills[k] = v
        end
    end
    return skills
end

function SkillModule:getSkillList()
    local skillList = {}
    local heroData = GameModule:getHeroData()
    if heroData:getRace() == Constant.RaceType.Slayer then
        local levelTable = heroData:getSlayerLevelTable()
        for k, v in pairs(self._skillTable) do
            local skillCfg = CacheManager:querySkillMeta(v:getSkillId())
            if tonumber(skillCfg:getRaceSkill()) == 0  then
                table.insert(skillList, v)
            else
                local lv = levelTable[skillCfg:getDomain()]
                if lv == Constant.TransferLevel then
                    lv = lv + heroData:getAdvanceLevel()
                end
                --判断是否满足技能学习条件
                if lv >= skillCfg:getNeedLevel() then
                    table.insert(skillList, v)
                end
            end
        end
    elseif heroData:getRace() == Constant.RaceType.Vampire then
        --鬼族角色32级学习变身-狼、68级学习变身-狼人后，才可以在技能编辑界面显示“死亡之吻”和“吞噬尸体“两个技能
        for k, v in pairs(self._skillTable) do
            if v:getSkillId() == SkillEnum.MAGIC_BITE_OF_DEATH and self:hasSkill(SkillEnum.TRANSFORM_TO_WERWOLF) then
                table.insert(skillList, v)
            elseif v:getSkillId() == SkillEnum.MAGIC_EAT_CORPSE and self:hasSkill(SkillEnum.TRANSFORM_TO_WOLF) then
                table.insert(skillList, v)
            elseif v:getSkillId() ~= SkillEnum.MAGIC_BITE_OF_DEATH and v:getSkillId() ~= SkillEnum.MAGIC_EAT_CORPSE then
                table.insert(skillList, v)
            end
        end
    else
        for k, v in pairs(self._skillTable) do
            table.insert(skillList, v)
        end
    end
    table.sort(skillList, function(a, b)
        local skillCfgA = CacheManager:querySkillMeta(a:getSkillId())
        local skillCfgB = CacheManager:querySkillMeta(b:getSkillId())
        if skillCfgA:getSkillId() == 17001 or skillCfgA:getSkillId() == 17002 then
            return true
        end
        if skillCfgB:getSkillId() == 17001 or skillCfgB:getSkillId() == 17002 then
            return false
        end
        if skillCfgA:getPassiveSkill() ~= skillCfgB:getPassiveSkill() then
            return skillCfgA:getPassiveSkill() < skillCfgB:getPassiveSkill()
        else
            if skillCfgA:getDomain() ~= skillCfgB:getDomain() then
                return skillCfgA:getDomain() < skillCfgB:getDomain()
            else
                if skillCfgA:getNeedLevel() ~= skillCfgB:getNeedLevel() then
                    return skillCfgA:getNeedLevel() < skillCfgB:getNeedLevel()
                else
                    return skillCfgA:getSkillId() < skillCfgB:getSkillId()
                end
            end
        end
    end)
    return skillList
end

-- 魔族检查当前技能Id前置节点是否都学习(遗忘判断)
function SkillModule:checkSkillToRoot2(skillId, deleteSkillId)
    local skillCfg = CacheManager:querySkillMeta(skillId)
    local skillList = skillCfg:getRequireSkillList()
    for k, requireSkill in pairs(skillList) do
        if deleteSkillId == nil or deleteSkillId ~= requireSkill then
            local requireSkillCfg = CacheManager:querySkillMeta(requireSkill)
            local requireSkillList = requireSkillCfg:getRequireSkillList()
            local canCycle = false
            for sub = 1, 2 do
                local list = Constant["OUSTERS_SKILL"..sub] 
                local isExit = StrengthenModule:checkExit(list, requireSkill)
                if self:hasSkill(requireSkill) and isExit then
                    if #requireSkillList > 0 then
                        canCycle = self:checkSkillToRoot2(requireSkill, deleteSkillId)
                    else
                        canCycle = true
                    end
                end
                if canCycle then
                    break
                end
            end
            return canCycle
        end
    end
    return false
end

-- 魔族检查当前技能Id前置节点是否都学习(学习判断)
function SkillModule:checkSkillToRoot(skillId, deleteSkillId)
    local skillCfg = CacheManager:querySkillMeta(skillId)
    local skillList = skillCfg:getRequireSkillList()
    for k, requireSkill in pairs(skillList) do
        if deleteSkillId == nil or deleteSkillId ~= requireSkill then
            local requireSkillCfg = CacheManager:querySkillMeta(requireSkill)
            local requireSkillList = requireSkillCfg:getRequireSkillList()
            local isExit = StrengthenModule:checkExit(self._list, requireSkill)
            if self:hasSkill(requireSkill) and isExit then
                if #requireSkillList > 0 then
                    return self:checkSkillToRoot(requireSkill, deleteSkillId)
                else
                    return true
                end
            end
        end
    end
    return false
end

--魔族获取当前技能状态
function SkillModule:getCurSkillState(skillId, list)
    if list then self._list = list end
    -- do return lt.Constant.SkillState.Learned end
    local skillCfg = CacheManager:querySkillMeta(skillId)
    local requireSkills = skillCfg:getRequireSkillList()
    local state = lt.Constant.SkillState.NotLearnable
    if self:hasSkill(skillId) then
        state = lt.Constant.SkillState.Learned
    else
        --技能点限制
        local heroData = GameModule:getHeroData()
        local curSkillPoint = heroData:getSkillPoints()
        local lv = self:getSkillLevel(skillId)
        local targetPoint = lv == 0 and skillCfg:getSkillPoint() or skillCfg:getLeveUpPoint()
        --等级限制
        local needLevel = skillCfg:getNeedLevel()
        local heroLv = heroData:getLevel()
        if curSkillPoint < targetPoint or heroLv < needLevel then
            state = lt.Constant.SkillState.NotLearnable
        else
            if #requireSkills == 0 then
                state = lt.Constant.SkillState.Learnable
            elseif #requireSkills > 0 then
                local learnable = SkillModule:checkSkillToRoot(skillId)
                if learnable then
                    state = lt.Constant.SkillState.Learnable
                else
                    state = lt.Constant.SkillState.NotLearnable
                end
            end
        end
    end

    return state
end

---获取清洗魔族技能所需要的金币数量
function SkillModule:getCleanSkillCoinNum(skillId, skillLv, isDown)
    local skillCfg = CacheManager:querySkillMeta(skillId)
    local skillPoint = skillCfg:getSkillPoint()
    local price = 0
    local originPrice = 0
    if skillPoint > 0 then
        local originMeta = CacheManager:getDowngradeCostMeta(skillPoint)
        originPrice = originMeta:getCost()
    end
    if skillCfg:getLeveUpPoint() > 0 then
        local singleMeta = CacheManager:getDowngradeCostMeta(skillCfg:getLeveUpPoint())
        local singlePrice = singleMeta:getCost()
        local skillLvl = self:getSkillLevel(skillId)
        if (not isDown and skillLvl - skillLv == 0) or (isDown and skillLvl == 0) then
            price = price + originPrice + singlePrice * (skillLv - 1)
        else
            price = price + singlePrice * skillLv
        end
    else
        price = skillLv > 0 and originPrice or 0
    end
    return price
end

function SkillModule:saveEditConf()
    self:updateAutoSettingSkills()
    local dataString = json.encode(self._saveData)
    local roleId = GameModule:getHeroData():getPlayerId()
    -- yflog:Info("SkillModule:saveEditConf()",roleId)
    cc.UserDefault:getInstance():setStringForKey(Save_SkillModule_Edit_Of_SkillSlot .. roleId, dataString)
    cc.UserDefault:getInstance():flush()
    self._saveData = nil
end

function SkillModule:readEditConf()
    local roleId = GameModule:getHeroData():getPlayerId()
    -- yflog:Info("SkillModule:saveEditConf()",roleId)
    local dataString = cc.UserDefault:getInstance():getStringForKey(Save_SkillModule_Edit_Of_SkillSlot .. roleId, "{}")
    local data = json.decode(dataString) or {}
    if #data == 0 then
        data = self:getEditSkillConf()
    end
    return data
end

function SkillModule:setEditConf(data)
    self._saveData = data
end

function SkillModule:setEditConfByIndex(index, data)
    if self._saveData == nil then
        self:getEditConf()
    end
    for key, value in pairs(data) do
        if value == "nil" then
            value = nil
        end
        yflog:Info("setEditConfByIndex index is: %s, key is :%s, value is:%s", index ,tostring(key), tostring(value))
        if self._saveData[index] then
            self._saveData[index][key] = value
        else
            print(debug.traceback())
        end
    end
end

function SkillModule:checkChange()
    local function tablesAreDifferent(table1, table2)
        if table.nums(table1) ~= table.nums(table2) then
            return true
        end
        for key, value in pairs(table1) do
            if type(value) == "table" then
                if tablesAreDifferent(value, table2[key]) then
                    return true
                end
            elseif value ~= table2[key] then
                return true
            end
        end
        return false
    end
    local orig = self:readEditConf()
    local cur = self:getEditConf()
    local isChange = tablesAreDifferent(orig, cur)
    return isChange
end

function SkillModule:getEditConf()
    if not self._saveData then
        self._saveData = self:readEditConf()
    end
    return self._saveData
end

function SkillModule:setDefaultConf()
    self._saveData = self:getEditSkillConf()
end

function SkillModule:getSkillIcon(skillId)
    if skillId then
        local skillMeta = CacheManager:queryMetaBySkillId(skillId)
        local iconId = "default"
        if skillMeta then
            iconId = skillMeta:getSpriteID()
        end
        return iconId
    end

    return "default"
end

function SkillModule:outersMeleeLimit(skillId)
    --魔族普通攻击
    -- if skillId == SkillEnum.NORAML_MELEE and GameModule:getHeroRace() == Constant.RaceType.Ousters then 
    --     return self:getWeaponType() == Constant.WeaponType.BattleWheel
    -- end
    return true
end

function SkillModule:isVampire()
    local race = GameModule:getHeroRace()
    return race == Constant.RaceType.Vampire
end


---是否满足释放条件
function SkillModule:isBtnUICondition(skillId)
    if not skillId then return true end

    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return false
    end

    local heroData = GameModule:getHeroData()
    if not heroData then
       return  false
    end

    local heroAgent = worldAgent:getHeroAgent()
    if not heroAgent then
        return false
    end

    local raceType = heroData:getRace()

    ---------------- 普通攻击技能 ----------------------
    if SkillCdManager:IsNormalSkill(skillId) then
        if raceType == Constant.RaceType.Ousters then
            if not self:outersMeleeLimit(skillId) then
                return false
            end
        elseif  raceType == Constant.RaceType.Slayer then
            local isReadyBullet = SkillModule:checkBulletNum(skillId)
            if not isReadyBullet then
                return false
            end
        end
        return true
    end

    -----------------

    if not self:isHPMPContion(skillId, heroData) then
        if raceType ~= Constant.RaceType.Vampire then
            return false
        else
            local isTransforming, transformId = self:isTransforming()
            if isTransforming then

            else
                return false
            end
        end
    end
    -- 眩晕中
    if heroAgent:hasBuffer(BuffEnum.EFFECT_BLOCK_HEAD) and skillId ~= lt.SkillEnum.NORAML_MELEE and skillId ~= lt.SkillEnum.NORMAL_RANGE then
        return false
    end
    if not self:isReadyUseItems(skillId) then
        return false
    end

    local isReadyBullet = SkillModule:checkBulletNum(skillId)
    if not isReadyBullet then
        return false
    end

    local flag,_ = self:isReadyCondition(skillId)
    if not flag then
        return false
    end

    

    if raceType == Constant.RaceType.Ousters then
        if not self:outersMeleeLimit(skillId) then
            return false
        end
        -- 召唤-精灵 可取消buff
        if skillId == SkillEnum.SKILL_SUMMON_SYLPH then
            local hasBuffer = heroAgent and heroAgent:hasBuffer(lt.BuffEnum.EFFECT_SUMMON_SYLPH)
            if hasBuffer then
                return true
            end
            local itemObjId = lt.ItemModule:getObjIdBySkillId(skillId)
            if not itemObjId then
                return false
            end
        end
    elseif raceType == Constant.RaceType.Slayer then
        if skillId == SkillEnum.SKILL_ETERNITY then
            return false
        end
        -- 人族烈焰指
        if skillId == SkillEnum.SKILL_PIERCING then
            local worldAgent = lt.AgentManager:getWorldAgent()
            local heroAgent = worldAgent:getHeroAgent()
            if heroAgent and heroAgent:getWeaponType() == lt.Constant.WeaponType.SGGun then
                return false
            end
        end

        -- 炮塔火力需要安装炮塔buff
        if skillId == SkillEnum.SKILL_TURRET_FIRE then
            local worldAgent = lt.AgentManager:getWorldAgent()
            local heroAgent = worldAgent:getHeroAgent()
            local hasBuffer = heroAgent and heroAgent:hasBuffer(BuffEnum.EFFECT_INSTALL_TURRET)
            if not hasBuffer then
                return false
            end
        end
        if skillId == SkillEnum.SKILL_CREATE_HOLY_POTION
        or skillId == SkillEnum.SKILL_CREATE_HOLY_POTION_DOCTOR then
            local itemObjId = lt.ItemModule:getObjIdBySkillId(skillId)
            if not itemObjId then
                return false
            end
        end
        -- 人族领域等级
        local isDomainLv, msg = SkillModule:checkSlayerDomainLevel(skillId)
        if not isDomainLv then
            return false, msg
        end
    elseif raceType == Constant.RaceType.Vampire then
        --变身中忽略其他公共条件
        local isTransforming, transformId = self:isTransforming()
        if isTransforming then
            if skillId == SkillEnum.TRANSFORM_SKILL[transformId] then
                return true
            else
                local wolfNormal = SkillModule:transformUseSkill(skillId)
                if not wolfNormal then
                    return false 
                end
            end
        end
        --吸血特殊处理
        if skillId == SkillEnum.SKILL_BLOOD_DRAIN and not self:isReadyBuff(skillId) then
            return false
        end
        -- 吞噬尸体
        if skillId == SkillEnum.MAGIC_EAT_CORPSE then
            return self:eatCorpseLimit(skillId)
        end

        if skillId == SkillEnum.MAGIC_BITE_OF_DEATH then
            return self:biteOfDeathLimit(skillId)
        end

        -- local wolfNormal = SkillModule:transformUseSkill(skillId)
        -- if wolfNormal then
        --     return true
        -- end
        -- if isTransforming then
        --     --变身中，其他技能不能使用
        --     if skillId ~= SkillEnum.TRANSFORM_SKILL[transformId] then
        --         return false
        --     end
        -- end
        if skillId == SkillEnum.MAGIC_HOWL then
            return isTransforming == true and transformId == lt.SkillEnum.TRANSFORM.WOLF
        end
        
        if self:isVampire() and heroAgent:hasBuffer(BuffEnum.EFFECT_CLASS_STONE_SKIN) then
            return skillId ~= SkillEnum.TRANSFORM_TO_WOLF and skillId ~= SkillEnum.TRANSFORM_TO_WERWOLF 
        end
        
        if skillId == SkillEnum.BLOODY_TUNNEL 
            or skillId == SkillEnum.MAGIC_BLOODY_MARK then
            return self:isReadyItemSpecialCondition(skillId)
        end

        if skillId == SkillEnum.SKILL_BLOODS_SYMPOSION then -- 血之盛宴 需要血之诅咒buff
            if not heroAgent:hasBuffer(BuffEnum.EFFECT_BLOOD_CURSE) then
                return false
            end
        end
    end
    return true
end

-- 刷新按钮根据对应条件type
function SkillModule:isBtnUIConditionByType(skillId, conType)
    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return false
    end

    local heroData = GameModule:getHeroData()
    if not heroData then
       return  false
    end

    local heroAgent = worldAgent:getHeroAgent()
    if not heroAgent then
        return false
    end

    local raceType = heroData:getRace()

    if conType == SLOT_CONDITION_TYPE.HPMP then
        if not self:isHPMPContion(skillId, heroData) then
            if raceType ~= Constant.RaceType.Vampire then
                return false
            else
                local isTransforming, transformId = self:isTransforming()
                if isTransforming then
                    
                else
                    return false
                end
            end
        end
    elseif conType == SLOT_CONDITION_TYPE.ITEM then
        if (not self:isReadyUseItems(skillId)) then
            return false
        end
        if raceType == RaceType.Vampire then
            if skillId == SkillEnum.BLOODY_TUNNEL 
                or skillId == SkillEnum.MAGIC_BLOODY_MARK then
                return self:isReadyItemSpecialCondition(skillId)
            end
        end

        if raceType == RaceType.Ousters then
            if skillId == SkillEnum.SKILL_CREATE_HOLY_POTION
            or skillId == SkillEnum.SKILL_CREATE_HOLY_POTION_DOCTOR then
                local itemObjId = lt.ItemModule:getObjIdBySkillId(skillId)
                if not itemObjId then
                    return false
                end
            end
        end
      
    elseif conType == SLOT_CONDITION_TYPE.EQUIP then
        local flag,_ = self:isReadyCondition(skillId)
        if not flag then
            return false
        end

        if raceType == RaceType.Ousters then
            if not self:outersMeleeLimit(skillId) then
                return false
            end
        end
        if raceType == RaceType.Slayer then
            local isReadyBullet = SkillModule:checkBulletNum(skillId)
            if not isReadyBullet then
                return false
            end
        end
        
    elseif conType == SLOT_CONDITION_TYPE.TARGET then
        if raceType == RaceType.Vampire then
            if skillId == SkillEnum.SKILL_BLOOD_DRAIN and not self:isReadyBuff(skillId) then
                return false
            end 
        end
    elseif conType == SLOT_CONDITION_TYPE.LEVEL then
        if raceType == RaceType.Slayer then
            -- 人族领域等级
            local isDomainLv, msg = SkillModule:checkSlayerDomainLevel(skillId)
            if not isDomainLv then
                return false, msg
            end
        end
    elseif conType == SLOT_CONDITION_TYPE.BUFF then
        if raceType == RaceType.Vampire then
            local isTransforming, transformId = self:isTransforming()
            if isTransforming then
                if skillId == SkillEnum.TRANSFORM_SKILL[transformId] then
                    return true
                end
            end
           
            if self:isVampire() and heroAgent:hasBuffer(BuffEnum.EFFECT_CLASS_STONE_SKIN) then
                return skillId ~= SkillEnum.TRANSFORM_TO_WOLF and skillId ~= SkillEnum.TRANSFORM_TO_WERWOLF 
            end

            -- 吞噬尸体
            if skillId == SkillEnum.MAGIC_EAT_CORPSE then
                return self:eatCorpseLimit(skillId)
            end

            if skillId == SkillEnum.MAGIC_BITE_OF_DEATH then
                return self:biteOfDeathLimit(skillId)
            end
            if skillId == SkillEnum.MAGIC_HOWL then
                return isTransforming == true and transformId == lt.SkillEnum.TRANSFORM.WOLF
            end

            local wolfNormal = SkillModule:transformUseSkill(skillId)
            if wolfNormal then
                return true
            end
            if isTransforming then
                --变身中，其他技能不能使用
                if skillId ~= SkillEnum.TRANSFORM_SKILL[transformId] then
                    return false
                end
            end
            if skillId == SkillEnum.SKILL_BLOODS_SYMPOSION then -- 血之盛宴 需要血之诅咒buff
                if not heroAgent:hasBuffer(BuffEnum.EFFECT_BLOOD_CURSE) then
                    return false
                end
            end
        end
        if raceType == RaceType.Slayer then
            if skillId == SkillEnum.SKILL_TURRET_FIRE then
                local hasBuffer = heroAgent:hasBuffer(BuffEnum.EFFECT_INSTALL_TURRET)
                if not hasBuffer then
                    return false
                end
            end 
        end

        if heroAgent:hasBuffer(BuffEnum.EFFECT_BLOCK_HEAD) and skillId ~= lt.SkillEnum.NORAML_MELEE and skillId ~= lt.SkillEnum.NORMAL_RANGE then
            return false
        end
    end
    return true
end

function SkillModule:getAttackRect(skillId)
    local skillInfo = self._skillTable[skillId]
    if skillId == SkillEnum.SKILL_ICE_LANCE_M then--疾风冰矛
        skillInfo = self._skillTable[SkillEnum.SKILL_ICE_LANCE]
    end
    if skillInfo then
        return skillInfo:getSkillRange()
    else
        yflog:Error("SkillModule:getSkillRange is nil:%s",skillId)
        local skillMeta = CacheManager:queryMetaBySkillId(skillId)
        return skillMeta:getTargetDisX()
    end
end

function SkillModule:isHPMPContion(skillId, heroData)
    local curRace = GameModule:getHeroRace()

    if curRace == Constant.RaceType.Vampire then
        return self:hasSkillHp(skillId, heroData)
    else
        return self:hasSkillMp(skillId, heroData)
    end
end

-- 魔法是否充足
function SkillModule:hasSkillMp(skillId, heroData)
    local needMana = self:getSkillNeedMana(skillId)
    local curMp = heroData:getCurMp()

    return curMp >= needMana
end

-- 血是否充足 专用于鬼族
function SkillModule:hasSkillHp(skillId, heroData)
    local needMana = self:getSkillNeedMana(skillId)
    local curHp = heroData:getCurHp()

    return curHp >= needMana
end

-- 初始化自己拥有技能所需的mana
function SkillModule:initSkillMana(skillId)
    local skillMeta = CacheManager:queryMetaBySkillId(skillId)
    self._skillNeedMana[skillId] = skillMeta:getMana()
    --  = math.floor(needMana * (1 - GameModule:getHeroData():getConsMpBuf() / 10000))
end

-- 获取技能mana
function SkillModule:getSkillNeedMana(skillId)
    if not self._skillNeedMana[skillId] then
        self:initSkillMana(skillId)
    end
    
    -- return self._skillNeedMana[skillId]
    local mana = self._skillNeedMana[skillId] or 0
    return math.floor(mana * (1 - GameModule:getHeroData():getConsMpBuf() / 10000))
end

function SkillModule:getSkillReleaseForm(skillId)
    local skillMeta = CacheManager:queryMetaBySkillId(skillId)
    local form = {}
    if skillMeta then
        local formStr = skillMeta:getSkillReleaseForm()
        form = string.split(formStr, ",")
    end
    if #form == 0 then
       form = {0} --默认为NULL
    end
    local passiveSkillList = self:getPassiveSkillList()
    if skillId == SkillEnum.SKILL_ACID_STORM 
    or skillId == SkillEnum.SKILL_POISON_STORM 
    then
        if self:checkPassiveSkillLearned(SkillEnum.SKILL_ACID_STORM_PRO) then
            form = {form[1],form[2] + 2, form[3] + 2}
        end
    elseif skillId == SkillEnum.HAND_OF_DARKNESS then 
        if self:checkPassiveSkillLearned(SkillEnum.HAND_OF_DARKNESS_PRO) then
            form = {form[1],form[2] + 2, form[3] + 2}
        end
    end
    return form
end

function SkillModule:getSkillPixelRect(skillId)
    local range = self:getAttackRect(skillId) * 2 
    return cc.size(Constant.MAP_BLOCK_WIDTH *range, Constant.MAP_BLOCK_HEIGHT*range)
end

function SkillModule:isDragSkill()
    return self._isDrag
end

function SkillModule:setIsDragSkill(isDrag)
    self._isDrag = isDrag
end

function SkillModule:isReadyBuff(skillId)
    local worldAgent = lt.AgentManager:getWorldAgent()
    local heroAgent = worldAgent:getHeroAgent()

    if not heroAgent or heroAgent:getIsOutOfGame() then
        return false
    end
    if self:isTransforming() then
        return true
    end
    local skillMeta = CacheManager:querySkillMeta(skillId)

    -- 地板技能忽略
    if skillMeta:getTargetType() == Constant.SkillTargetType.ONE_AREA or skillMeta:getTargetType() == Constant.SkillTargetType.AREA then
        return true
    end
    
    local buffer = CacheManager:getBuffBySkillId(skillId)
    if not buffer then
        return true
    end
    local bufferId = buffer:getBuffId()
    local targetAgent
    if skillMeta:getTargetType() == Constant.SkillTargetType.SELF then
        targetAgent = heroAgent
    else
        local targetAgentId = heroAgent:getTargetAgentId()
        if targetAgentId then
            targetAgent = lt.AgentManager:getAgent(targetAgentId)
            --辅助类技能在选择目标位敌对时真正的作用目标是自己
            if SkillEnum.HELP_SKILL_ID_TABLE[skillId] and (not heroAgent:isFriendAgent(targetAgent)) then
                targetAgent = heroAgent
            end
        end
    end
    if targetAgent and not targetAgent:isNpcAgent() then
        if targetAgent:hasBuffer(bufferId) and not buffer:allowRepeat() then
            if bufferId ~= BuffEnum.EFFECT_CLASS_BLOOD_DRAIN then
                return true
            end
            return false
        end
    end
    return true
end

--技能取消变身
function SkillModule:sendCancelTransform()
    SocketApi:sendToGs(lt.ClientCmdDef.CANCEL_TRANSFOR)
end



--使用道具限制
function SkillModule:isReadyUseItems(skillId)
    if SkillEnum.USE_SKILL_ITEMS[skillId] then
        -- FIXME 此处需要判断变身吗
        if self:isTransforming() then
            return true
        end

        local itemId = SkillEnum.USE_SKILL_ITEMS[skillId]
        if type(itemId) == "table" then
            local hasItem = false
            for _, v in ipairs(itemId) do
                local item = ItemModule:getItemByItemId(v, Constant.ItemType.ITEM_TYPE_PROP)
                if item then
                    hasItem = true
                    break
                end
            end
            if hasItem then
                return true
            end
            local itemMeta = ItemModule:getItemMetaByItemId(Constant.ItemType.ITEM_TYPE_PROP, itemId[1])
            return false, itemMeta:getName()
        elseif type(itemId) == "number" then
            local item = ItemModule:getItemByItemId(itemId, Constant.ItemType.ITEM_TYPE_PROP)
            if item then
                return true
            end
            local itemMeta = ItemModule:getItemMetaByItemId(Constant.ItemType.ITEM_TYPE_PROP, itemId)
            return false, itemMeta:getName()
        end

    end
    return true
end

-- 道具特殊条件
function SkillModule:isReadyItemSpecialCondition(skillId)
    -- 血之印记需要未标记
    if skillId == SkillEnum.MAGIC_BLOODY_MARK then
        local itemId = SkillEnum.USE_SKILL_ITEMS[skillId]
        local item = ItemModule:getNotMarkItemById(itemId, Constant.ItemType.ITEM_TYPE_PROP)
        if item then
            return true
        else
            local itemMeta = ItemModule:getItemMetaByItemId(Constant.ItemType.ITEM_TYPE_PROP, itemId)
            return false, itemMeta:getName() 
        end
    -- 血之漩涡需要标记
    elseif skillId == SkillEnum.BLOODY_TUNNEL then
        local itemId = SkillEnum.USE_SKILL_ITEMS[skillId]
        local tips = nil
        for k, v in ipairs(itemId) do
            local item = ItemModule:getMarkItemById(v, Constant.ItemType.ITEM_TYPE_PROP)
            if item then
                return true
            else
                local itemMeta = ItemModule:getItemMetaByItemId(Constant.ItemType.ITEM_TYPE_PROP, v)
                tips = itemMeta:getName() 
            end
        end
        return false, tips
    end
    return true
end

-- 是否变身
function SkillModule:isTransforming()
    local worldAgent = lt.AgentManager:getWorldAgent()
    local heroAgent = worldAgent:getHeroAgent()
    if not heroAgent then
        return false, SkillEnum.TRANSFORM.NONE
    end
    for buffId, transformId in pairs(BuffEnum.TRANSFORM_BUFFS) do
        if heroAgent:hasBuffer(buffId) then
            return true, transformId
        end
    end
    return false, SkillEnum.TRANSFORM.NONE
end

function SkillModule:isReadyTransform(skillId)
    local isTransforming, transformId = SkillModule:isTransforming()

    if isTransforming then
        return skillId == SkillEnum.TRANSFORM_SKILL[transformId]
    else
        return true
    end
end

-- 变身狼可以使用的技能
function SkillModule:transformUseSkill(skillId)
    local _, transformId = SkillModule:isTransforming()
    local wolfNormal = SkillEnum.TRANSFORM_WOLF_USE[skillId] and (transformId == SkillEnum.TRANSFORM.WOLF)
    local werWolfNormal = SkillEnum.WER_WOLF_USE[skillId] and (transformId == SkillEnum.TRANSFORM.WERWOLF or transformId == 0)
    return wolfNormal or werWolfNormal
end

function SkillModule:eatCorpseLimit()
    local _, transformId = SkillModule:isTransforming()
    if transformId ~= lt.SkillEnum.TRANSFORM.WOLF then
        return false
    end

    local worldAgent = lt.AgentManager:getWorldAgent()
    local heroAgent = worldAgent:getHeroAgent()
    if not heroAgent then
        return false
    end

    local monster = heroAgent:getMonsterBody()
    local isExitMonster = false
    if monster then
        isExitMonster = true
    end

    return isExitMonster
end

function SkillModule:biteOfDeathLimit()
    local _, transformId = SkillModule:isTransforming()
    if transformId ~= lt.SkillEnum.TRANSFORM.WERWOLF then
        return false
    end

    return true
end

--血之漩涡传送
function SkillModule:sendBloodyTunnelMap(agentId)
    local req = lt.netcmd_pb.CS_VampireTunnelReq()
    req.tunnelId = agentId
    SocketApi:sendToGs(lt.ClientCmdDef.C_VAMPIRE_TUNNEL_USE, req)
end


--血之漩涡传送Response
function SkillModule:onVampireTunnel(event)
    local proto = event.param
end

-- 技能效果等级获取
function SkillModule:getGradeBySkillLevel(skillLevel,skillId)
    local grade = 0
    if not skillLevel then
        return 1
    end
    if skillId == SkillEnum.SKILL_BACK_STAB then
        -- 背刺 0 - 29
        --      30
        if skillLevel == 30 then
            grade = 2
        else
            grade = 1
        end
    else
        if skillLevel < 15 then
            grade = 1
        elseif skillLevel < 30 then
            grade = 2
        else
            grade = 3
        end
    end
    return grade
end


-- 判断身上的武器、精灵石头是否满足释放条件（动态，玩家可能领域等级之类的可能会变化）
function SkillModule:isReadyCondition(skillId)
    -- do return true end
    local skillMeta = lt.CacheManager:querySkillMeta(skillId)
    if not skillMeta then return end

    local heroData = GameModule:getHeroData()
    local curRace = GameModule:getHeroRace()

    -- 检查武器类型
    local equipName = Constant.RaceToJobPanel[curRace] .. "EquipPos"
    local armsPos = Constant[equipName].Arms
    local item = lt.ItemModule:getEquipItemByPos(armsPos)
    local armsKind = -1
    if item then
        armsKind = item:getMetaType()
    end
    local armsMatch = skillMeta:checkArmsKind(armsKind)
    -- yflog:Info("armsKind---->>>>>>> %s %s",armsKind, armsMatch)
    if not armsMatch then
        return false, GReadText.KEY_SKILL_LIMIT_TIPS1
    end

    -- 检查火元素
    local fire = skillMeta:getFire()
    local fireSpirit = heroData:getFireSpiritLevel()
    -- yflog:Info("fireSpirit----->>>>>>>%s   ,%s",fire,fireSpirit)
    if fireSpirit < fire then
        return false, GReadText.KEY_SKILL_LIMIT_TIPS2
    end

    -- 检查水元素
    local water = skillMeta:getWater()
    local waterSpirit = heroData:getWaterSpiritLevel()
    -- yflog:Info("waterSpirit---->>>>>>> %s %s",water, waterSpirit)
    if waterSpirit < water then
        return false, GReadText.KEY_SKILL_LIMIT_TIPS3
    end

    -- 检查土元素
    local earth = skillMeta:getEarth()
    local earthSpirit = heroData:getEarthSpiritLevel()
    -- yflog:Info("earthSpirit---->>>>>>> %s %s",earth, earthSpirit)
    if earthSpirit < earth then
        return false, GReadText.KEY_SKILL_LIMIT_TIPS4
    end
    --检查领域等级
    local can,tips = self:checkSlayerDomainLevel(skillId)
    if not can then
        return false,tips
    end
    return true
end

