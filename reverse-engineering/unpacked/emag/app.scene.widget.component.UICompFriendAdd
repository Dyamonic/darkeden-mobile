-- 添加好友
---@class UICompFriendAdd
local UICompFriendAdd = class("UICompFriendAdd", lt.UIGButtonBase)

local NtfManager = lt.NtfManager

UICompFriendAdd.ChangeSkinConf = {
    ["MessageBox"] = {
        ["bg"] = "bg_tytanchuang_02",
    },
    ["CommonTL"] = {
        closeButton = { loaderdown = "bg_beibao_ren_anniu" },
        confirm = { loaderdown = "bg_beibao_ren_anniu" },
    }
}

function UICompFriendAdd:ctor()
    UICompFriendAdd.super.ctor(self)
    self._data = nil
end

function UICompFriendAdd:onClear()
    self._data     = nil
    self._nameBg   = nil
    self._inputTxt = nil
    self._confirm  = nil
    UICompFriendAdd.super.onClear(self)
end

function UICompFriendAdd:onEnter()
    UICompFriendAdd.super.onEnter(self)
    self._confirm:addClickListener(handler(self, self.onBtnClick))
    self._closeButton:addClickListener(handler(self, self.onCloseBtnClick))
end

function UICompFriendAdd:onExit()
    self._confirm:removeClickListener()
    self._closeButton:removeClickListener()
    UICompFriendAdd.super.onExit(self)
end

function UICompFriendAdd:onConstruct()

end

function UICompFriendAdd:initUI()
    self._confirm     = self:getChild("confirm")
    self._closeButton = self:getChild("closeButton")
    self._nameBg      = self:getChild("nameBg")
    self._inputTxt    = self:getChild("inputtxt")
    self:initCocosInputUI()
end

function UICompFriendAdd:onCloseBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_FRIENDADD_MESSAGE_BOX)
end

function UICompFriendAdd:onBtnClick()
    local name = self._inputTxt:getText()
    if name == "" then
        return
    end
    self._inputTxt:setText("")
    yflog:Info("------------->>>>>name:%s,", name)

    local confirmCallback = self._data.confirmCallback
    if confirmCallback then
        confirmCallback(name)
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_FRIENDADD_MESSAGE_BOX)
end

function UICompFriendAdd:initCocosInputUI()
    if not self._Input then
        local bgsize = self._nameBg:getSize()
        self._Input = ccui.EditBox:create(cc.size(bgsize.width, bgsize.height), "", ccui.TextureResType.localType)
        self._Input:setAnchorPoint(cc.p(0, 0))
        self._Input:setFontName(lt.Constant.FONT_4)
        self._Input:setFontSize(22)
        self._Input:setReturnType(cc.KEYBOARD_RETURNTYPE_SEND)
        self._Input:setInputMode(cc.EDITBOX_INPUT_MODE_ANY)
        self._Input:setMaxLength(5)
        self._Input:registerScriptEditBoxHandler(handler(self, self.editBoxEvent))
        self._nameBg:displayObject():addChild(self._Input)
    end
end

function UICompFriendAdd:editBoxEvent(eventType, sender)
    if eventType == "began" then
        self._inputTxt:setText("")
    elseif eventType == "ended" then
        self._inputTxt:setText(sender:getText())
        self._Input:setText("")
    elseif eventType == "changed" then
        local str = sender:getText()
        str = string.gsub(str, " ", "") --过滤掉空格
        str = lt.CommonUtil:rmSpecChars(str)
        local count = string.len(str)
        local reCount = 0
        local beginIndex = -1
        local reString = ""
        for i = 1, count do
            local s = string.sub(str, i, i)
            local t = string.byte(s)
            if t < 128 then
                reCount = reCount + 1 --1字节文字，长度加1
            elseif t >= 192 then
                reCount = reCount + 2 --1字节以上文字，长度加2
            end
            if reCount > 10 then
                beginIndex = i - 1
                break
            end
            beginIndex = i
        end
        reString = string.sub(str, 1, beginIndex)
        sender:setText("")
        self._Input:setText(reString)
    elseif eventType == "return" then
    end
end

function UICompFriendAdd:refreshTips(param)
    if self._Input then
        self._Input:setText(param.content)
    end
    self._data = param or {}
    -- self._curMessage = param.content
end

return UICompFriendAdd
