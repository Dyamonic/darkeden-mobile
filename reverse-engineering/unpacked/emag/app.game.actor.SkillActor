---@class SkillActor 技能操作

local SkillActor = class("SkillActor", function()
    return display.newNode()
end)
local SkillEnum = lt.SkillEnum

local UI_SKILL_TYPE = {
    NULL = 0, --无
    DIRECTION = 1, --仅旋转
    AOE = 2, --可任意移动
    SCALE = 3, --可伸缩
    ARROW = 4, --箭头拼接
}

local UI_RECT_TYPE = {
    NULL = 0, --无效果
    LINE = 1, --线性
    SECTOR = 2, --扇形
    ROUND = 3, --圆
    RECTANGLE = 4, --矩形
    RHOMBUS = 5, --菱形
    LINE_ROUND = 6 --线+圆
}

local SHOW_TYPE = {
    BOTTOM = 1,
    TOP = 2,
}

local TYPES_EXCEL = {
    [1] = {type = UI_SKILL_TYPE.DIRECTION, indexs = {2}},
    [2] = {type = UI_SKILL_TYPE.AOE, indexs = {3,4,5}},
    [3] = {type = UI_SKILL_TYPE.NULL, indexs = {0}},
    [4] = {type = UI_SKILL_TYPE.SCALE, indexs = {6}},
    [5] = {type = UI_SKILL_TYPE.ARROW, indexs = {1}},

}

local function getRectangleEdgeDistance(w, h, angleDeg)
    local angleRad = math.rad(angleDeg)

    local halfW = w / 2
    local halfH = h / 2

    local distanceW = math.abs(halfW / math.cos(angleRad))
    local distanceH = math.abs(halfH / math.sin(angleRad))

    local distance = math.min(distanceW, distanceH)
    return math.abs(distance)
end

local function getRectangleEdgePoint(w, h, angleDeg)
    local angleRad = math.rad(angleDeg)
    local halfW = w / 2
    local halfH = h / 2

    local tanA = math.tan(angleRad)

    local x, y

    if math.abs(math.cos(angleRad)) * halfH > math.abs(math.sin(angleRad)) * halfW then
        x = halfW * (math.cos(angleRad) >= 0 and 1 or -1)
        y = x * math.tan(angleRad)
    else
        y = halfH * (math.sin(angleRad) >= 0 and 1 or -1)
        x = y / math.tan(angleRad)
    end

    return x, y
end

function SkillActor:ctor(type)
    self._zorderType = type
 
    self._actorNode = nil --父节点
    self._attackRangeNode = nil --攻击范围
    self._skillDirectionNode = nil --指向性技能形态 (扇形和箭头)   
    self._skillAOENode = nil --移动性技能形态（椭圆、矩形）
    self._skillScaleNode = nil --
    self._arrowLenNode = nil
    self._arrowNode = nil

    self._showTypes = nil
    self._skillDelta = nil
    self._color = nil
    self._range = nil
    self._directionAngle = nil
    self._arrowLength = nil
    self._skillId = nil
    self._attackSize = nil

    self._actorNode = display.newNode()
    self:addChild(self._actorNode)
    -- self._actorNode:setScaleY(0.5)

end

function SkillActor:onClear()
    self:removeAllChildren()

    self._actorNode = nil --父节点
    self._attackRangeNode = nil --攻击范围
    self._skillDirectionNode = nil --指向性技能形态 (扇形和箭头)
    self._skillAOENode = nil --移动性技能形态（椭圆、矩形）
    self._skillScaleNode = nil --
    self._arrowLenNode = nil
    self._arrowNode = nil

    self._showTypes = nil
    self._skillDelta = nil
    self._color = nil
    self._range = nil
    self._directionAngle = nil
    self._arrowLength = nil
    self._skillId = nil
    self._attackSize = nil
end

---攻击范围
function SkillActor:addAttackRect(color, range)
    self._range = range
    if self._range < 1 then 
        return 
    end
    local resPath = lt.ResManager:getAttackRangePath(range)
    if not self._attackRangeNode then
        self._attackRangeNode = display.newSprite(resPath)
        self._attackRangeNode:setAnchorPoint(0.5, 0.5)
        self:addChild(self._attackRangeNode)
        -- self._attackRangeNode:setScaleY(0.5)
    else
        self._attackRangeNode:setTexture(resPath)
    
    end
    self._attackRangeNode:setColor(color)
    self:setOpacityUI(self._attackRangeNode)

end

---技能范围形态
function SkillActor:addSkillRect(params)
    if self._range < 1 then 
        yflog:Info("技能范围小于1，检查配表")
        return 
    end
 
    self._skillDelta = params.delta
    self._showTypes = params.showType
    self._showType = tonumber(self._showTypes[1])
    self._color = params.color
    self._skillId = params.skillId
    local attackSize = params.attackSize
    self._rectWidth = attackSize.width
    self._rectHeight = attackSize.height
    self._isNew = true
    self:updateSkillActor()
end

function SkillActor:updateSkillActor()
    if not self._range or self._range < 1 then 
        yflog:Info("技能范围小于1，检查配表")
        return 
    end
    self:createRectData()
    local type = self:getType(self._showType)
    if type == UI_SKILL_TYPE.AOE then
       self:addAOESkillNode()
    elseif type ==UI_SKILL_TYPE.DIRECTION then
        self:addDirectionSkillNode()
    elseif type == UI_SKILL_TYPE.SCALE then
        self:addScaleNode()
    elseif type ==UI_SKILL_TYPE.ARROW then
        self:addArrowNode()
    end
    if type ==UI_SKILL_TYPE.DIRECTION then
        self._actorNode:setScaleY(0.5)
    else
        self._actorNode:setScaleY(1)
    end
end


function SkillActor:onUpdateMove(skillDelta, color, attackSize, showType)
    if attackSize then
        self._rectWidth = attackSize.width
        self._rectHeight = attackSize.height
    end
    if showType then
        self._showTypes = showType
        self._showType = tonumber(self._showTypes[1]) 
    end
    self._skillDelta = skillDelta
    if color then
        self._color = color
    end
    self._isNew = false
    self:updateSkillActor()
end

---相关数据
function SkillActor:createRectData()
    -- local ellipseCheck = (self._skillDelta.x^2 / width^2) + (self._skillDelta.y^2 / height^2)
    -- if ellipseCheck > 1 then
    --     local angle = math.atan2(self._skillDelta.y, self._skillDelta.x)
    --     self._skillDelta.x = width * math.cos(angle)
    --     self._skillDelta.y = height * math.sin(angle)
    -- end

    self._skillDelta.x = math.max(-self._rectWidth / 2, math.min(self._skillDelta.x, self._rectWidth / 2))
    self._skillDelta.y = math.max(-self._rectHeight / 2, math.min(self._skillDelta.y, self._rectHeight /2))

    self._arrowLength = math.sqrt(self._skillDelta.x^2 + (self._skillDelta.y)^2)
    self._directionAngle = math.deg(math.atan2(self._skillDelta.y, self._skillDelta.x))
end

function SkillActor:getSkillRect()
    return cc.size(self._rectWidth, self._rectHeight)
end

---范围性
function SkillActor:addAOESkillNode()
    local showTypePath = lt.ResManager:getAttackTypePath(self._showTypes)
    if not self._skillAOENode then
        self._skillAOENode = display.newSprite(showTypePath)
        self._actorNode:addChild(self._skillAOENode)
        self._skillAOENode:setAnchorPoint(cc.p(0.5, 0.5))
    else
        if self._isNew then
            self._skillAOENode:setTexture(showTypePath)
        end
    end
    
    local fguiY = self._skillDelta.y
    local cocosY =  display.cy - fguiY - display.cy 

    self._skillAOENode:setPosition(cc.p(self._skillDelta.x, cocosY))
    self._skillAOENode:setColor(self._color)
    if self._skillId == SkillEnum.MAGIC_BLOODY_WALL then
        local direction = self:getDirection(self._directionAngle)
        self._skillAOENode:setRotation(-direction * 45) -- 每个方向旋转45度
    else
        self._skillAOENode:setRotation(0)
    end
    self:setOpacityUI(self._skillAOENode)
end

function SkillActor:setOpacityUI(node)
    if self._zorderType == SHOW_TYPE.TOP then
        if node then
            node:setOpacity(75)
        end
    end
end

function SkillActor:getDirection(angle)
    -- 将角度转换为八个方向
    if angle < 0 then angle = angle + 360 end
    local directions = {0, 45, 90, 135, 180, 225, 270, 315}
    local closestDirection = 0
    local minDiff = 360

    for _, dir in ipairs(directions) do
        local diff = math.abs(angle - dir)
        if diff < minDiff then
            minDiff = diff
            closestDirection = dir
        end
    end
    if closestDirection == 270 or closestDirection == 90 then
        closestDirection = 0 
     elseif closestDirection == 0 or closestDirection == 180 then
        closestDirection = 90
     end

    return closestDirection
end

function SkillActor:getAOENode()
    return self._skillAOENode
end

---指向性
function SkillActor:addDirectionSkillNode()
    local showTypePath = lt.ResManager:getAttackTypePath(self._showTypes)
    if not self._skillDirectionNode then
        self._skillDirectionNode = display.newSprite(showTypePath)
        self._actorNode:addChild(self._skillDirectionNode)
        self._skillDirectionNode:setAnchorPoint(cc.p(0, 0.5))
    else
        if self._isNew then
            self._skillDirectionNode:setTexture(showTypePath)
        end
    end
    -- self._skillDirectionNode:setScaleY(0.5)
    self._skillDirectionNode:setRotation(self._directionAngle)
    self._skillDirectionNode:setColor(self._color)
    self:setOpacityUI(self._skillDirectionNode)
end

--箭头拼接
function SkillActor:addArrowNode()
    local showTypePath = lt.ResManager:getAttackTypePath(self._showTypes)
    local arrowTypePath = lt.ResManager:getAttackArrowRangePath(self._showTypes[2])
    local textureSize = display.newSprite(showTypePath):getContentSize()
    local arrowTextureSize = display.newSprite(arrowTypePath):getContentSize()
    if not self._arrowLenNode then
        self._arrowLenNode = display.newSprite(showTypePath)
        self._actorNode:addChild(self._arrowLenNode)
        self._arrowNode = display.newSprite(arrowTypePath)
        self._actorNode:addChild(self._arrowNode)
        self._arrowLenNode:setAnchorPoint(cc.p(0, 0.5))
        self._arrowNode:setAnchorPoint(cc.p(1, 0.5))
    else
        if self._isNew then
            self._arrowNode:setTexture(arrowTypePath)
            self._arrowLenNode:setTexture(showTypePath)
        end
    end

    self._arrowLenNode:setRotation(self._directionAngle)
    self._arrowLenNode:setColor(self._color)

    self._arrowLenNode:setColor(self._color)
    self._arrowNode:setColor(self._color)
    self._arrowNode:setRotation(self._directionAngle)

    local ePointX, ePointY = getRectangleEdgePoint(self._rectWidth, self._rectHeight, -self._directionAngle)
    self._arrowNode:setPosition(ePointX, ePointY)
    local angleRad = math.rad(self._directionAngle)
    local arrowW, arrowH = arrowTextureSize.width * math.cos(-angleRad),arrowTextureSize.width * math.sin(-angleRad)
    local bPointX, bPointY = ePointX - arrowW, ePointY - arrowH
    local length = cc.pGetLength(cc.p(bPointX, bPointY))
    self._arrowLenNode:setContentSize(math.ceil(length), textureSize.height)
    self:setOpacityUI(self._arrowNode)
    self:setOpacityUI(self._arrowLenNode)

end

--可伸缩
function SkillActor:addScaleNode()
    local showTypePath = lt.ResManager:getAttackTypePath(self._showTypes)
    local scaleRectPath = lt.ResManager:getAttackScaleRangePath(1)
    local textureSize = display.newSprite(showTypePath):getContentSize()
    if not self._skillScaleNode then
        self._skillScaleNode = display.newSprite(showTypePath)
        self._scaleRectNode = display.newSprite(scaleRectPath)
        self._actorNode:addChild(self._scaleRectNode)
        self._actorNode:addChild(self._skillScaleNode)
        self._scaleRectNode:setAnchorPoint(cc.p(0.5, 0.5))
        self._skillScaleNode:setAnchorPoint(cc.p(0, 0.5))
    else
        if self._isNew then
            self._scaleRectNode:setTexture(scaleRectPath)
            self._skillScaleNode:setTexture(showTypePath)
        end
    end

    self._scaleRectNode:setPosition(cc.p(100, 0))
    self._skillScaleNode:setRotation(self._directionAngle)

    self._skillScaleNode:setColor(self._color)
    self._scaleRectNode:setColor(self._color)
    local width = self._arrowLength
    local height = self._arrowLength

    local circlePosX = (width) * math.cos(math.rad(self._directionAngle))
    local circlePosY = (height) * math.sin(math.rad(self._directionAngle))
    if width < 5 then
        circlePosX = math.cos(math.rad(self._directionAngle))
        circlePosY = math.sin(math.rad(self._directionAngle))
        width = 0
    end
    local distance = getRectangleEdgeDistance(self._rectWidth, self._rectHeight, math.abs(self._directionAngle))
    self._skillScaleNode:setContentSize(distance, textureSize.height)
    local fguiY = circlePosY
    local cocosY =  display.cy - fguiY - display.cy 

    self._scaleRectNode:setPosition(circlePosX , cocosY)  -- 更新圆节点位置

    self:setOpacityUI(self._scaleRectNode)
    self:setOpacityUI(self._skillScaleNode)

    self:findEnemyByMoveXY(cc.p(circlePosX , cocosY))
end

function SkillActor:findEnemyByMoveXY(moveXY)
    if SkillEnum.IS_MOVE_SKILL[self._skillId] then
        return 
    end
    if SkillEnum.IS_MOVE_TO_TARGET_SKILL[self._skillId] then
        return 
    end
    local skillMeta = lt.CacheManager:querySkillMeta(self._skillId)
    if not skillMeta then  
        return 
    end
    if skillMeta:getMoveingTarget() then
        return--移动到目标品类
    end
    local heroX, heroY = self:getPosition()
    local bWorldPosition = cc.pAdd(cc.p(heroX, heroY), moveXY)
    local worldAgent = lt.AgentManager:getWorldAgent()
    local selectM, selectN = lt.MapUtil:calcMN(bWorldPosition.x, bWorldPosition.y)
    if worldAgent then
        --辅助类技能以及双向性技能[亲密圣杯]目标选定之后暂且不变
        if SkillEnum.HELP_SKILL_ID_TABLE[self._skillId] or SkillEnum.SKILL_INTIMATE_GRAIL == self._skillId then
        else
            worldAgent:findDestAgent(selectM, selectN, self._range)
        end
    end
end

function SkillActor:isShowRect(isShowAttackRect, isShowSkillRect, showType)
    if self._attackRangeNode then
        self._attackRangeNode:setVisible(isShowAttackRect)
    end
    self._actorNode:setVisible(isShowSkillRect)
    -- if not isShowAttackRect then return end
    local type = self:getType(showType)
    if self._skillDirectionNode then
        self._skillDirectionNode:setVisible(type == UI_SKILL_TYPE.DIRECTION)
    end
    if self._arrowLenNode then
        self._arrowLenNode:setVisible(type == UI_SKILL_TYPE.ARROW)
        self._arrowNode:setVisible(type == UI_SKILL_TYPE.ARROW)
    end
    if self._skillAOENode then
        self._skillAOENode:setVisible(type == UI_SKILL_TYPE.AOE)
    end
    if self._skillScaleNode then
        self._skillScaleNode:setVisible(type == UI_SKILL_TYPE.SCALE)
        self._scaleRectNode:setVisible(type == UI_SKILL_TYPE.SCALE)
    end
end

function SkillActor:getType(showType)
    for _, info in ipairs(TYPES_EXCEL) do
        for _, type in ipairs(info.indexs) do
            if type == showType then
                return info.type
            end
        end
    end
    return UI_SKILL_TYPE.NULL
end

-- 技能轮盘方向指示器
function SkillActor:isNeedInitDirection(showType)
    local type = self:getType(showType)
    return type == UI_SKILL_TYPE.SCALE or type == UI_SKILL_TYPE.DIRECTION or type == UI_SKILL_TYPE.AOE or type == UI_SKILL_TYPE.ARROW
end


return SkillActor