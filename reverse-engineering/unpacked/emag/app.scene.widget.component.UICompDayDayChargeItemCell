---@class UICompDayDayChargeItemCell
--天天充值奖励道具单元对象
local UICompDayDayChargeItemCell = class("UICompDayDayChargeItemCell", lt.UICompBase)

local CacheManager = lt.CacheManager
local Constant     = lt.Constant
local ItemModule   = lt.ItemModule
local NtfManager   = lt.NtfManager

function UICompDayDayChargeItemCell:ctor(param)
    UICompDayDayChargeItemCell.super.ctor(self,param)
end

function UICompDayDayChargeItemCell:onClear()
    self._itemIcon = nil
    self._num      = nil
    self._reward   = nil
    UICompDayDayChargeItemCell.super.onClear(self)
end

function UICompDayDayChargeItemCell:onConstruct()
    self._num     = self:getChild("num")
end

function UICompDayDayChargeItemCell:onEnter()
    UICompDayDayChargeItemCell.super.onEnter(self)
    self:addClickListener(handler(self, self.onShowTips))
end

function UICompDayDayChargeItemCell:onExit()
    self:removeClickListener()
    UICompDayDayChargeItemCell.super.onExit(self)
end

function UICompDayDayChargeItemCell:setInfo(reward)
    self._reward = reward
    if not reward then
        return
    end

    if not self._itemIcon then
        self._itemIcon = fgui.UIPackage:createObject("Item", "Item")
        self._itemIcon:insertObjectToFactory(self:getRegClass())
        self._itemIcon:setPivot(0.5,0.5, true)
        self._itemIcon:setPosition(23,23)
        self:addChild(self._itemIcon)
    end

    local itemMeta = ""
    local iconPath = ""
    if reward.itemType == Constant.ItemType.ITEM_TYPE_PROP then
        iconPath = "prop"
        itemMeta = CacheManager:getItemMeta(reward.itemId)
        local resUrl = string.format("ui://Item/%s_%s", iconPath,itemMeta:getIconId())
        self._itemIcon:setInfo(resUrl)
    elseif reward.itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
        iconPath = "equip"
        itemMeta = CacheManager:queryEquipMeta(reward.itemId)
        local resUrl = string.format("ui://Item/%s_%s", iconPath,itemMeta:getIconId())
        local affixId = 0
        local affixLevel = 0
        if reward.itemInfo then
            affixId = reward.itemInfo:getFirstAffixId()
            affixLevel = reward.itemInfo:getFirstAffixLevel()
        end
        self._itemIcon:setEquipInfo(resUrl,affixId,affixLevel)
    end
    
    local scaleX = 40/self._itemIcon:size().width
    local scaleY = 40/self._itemIcon:size().height
    local scale = scaleX < scaleY and scaleX or scaleY
    if scale > 1 then scale = 1 end
    self._itemIcon:setScale(scale, scale)
    self._itemIcon:setItemNums("")
    self._num:setText(reward.num or "")
    self._num:setSortingOrder(9)
    -- self._itemIcon:setGrayed(true)
end

function UICompDayDayChargeItemCell:onShowTips()
    if not self._reward then
        return
    end
    
    local point = self._itemIcon:localToGlobal({x = 23, y = 0})
    if self._reward.itemType == Constant.ItemType.ITEM_TYPE_PROP then
        local itemMeta = CacheManager:getItemMeta(self._reward.itemId)
        local itemInfo = ItemModule:getItemDataByConfig(itemMeta, nil, self._reward.num)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,
            { itemInfo = itemInfo, pt = point, pivot = cc.p(0, 0.5), tipsType = Constant.PROPTIPS_FORM.Display })
    elseif self._reward.itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
        local itemInfo = self._reward.itemInfo 
        if not itemInfo then
            local itemMeta = CacheManager:queryEquipMeta(self._reward.itemId)
            itemInfo = ItemModule:getItemDataByConfig(itemMeta, nil, self._reward.num)
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,
            { itemInfo = itemInfo, pt = point, tipsType = Constant.EquipShowTipsType.Display })
    end
end

return UICompDayDayChargeItemCell
