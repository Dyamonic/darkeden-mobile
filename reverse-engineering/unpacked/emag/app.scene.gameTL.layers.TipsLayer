---@class TipsLayer 物品提示层
local TipsLayer = class("TipsLayer", lt.UICompBase)
local NtfManager = lt.NtfManager
local Constant   = lt.Constant

local TipsZorder = {
    [Constant.TIPSTYPE.EQUIPTIPS] = 99,
    [Constant.TIPSTYPE.ITEMTIPS] = 99,
}

function TipsLayer:ctor()
    TipsLayer.super.ctor(self)
    self._view = fgui.UIPackage:createObject("Main", "TipsLayer")
    self._view:setPivot(0.5, 0.5 , true)
    self._view:setPosition(display.cx, display.cy)
    self:addChild(self._view)
    
    -- {"ui://MessageBox/MessageBox", lt.UICompMessageBox},     --消息窗口（两个按钮）  
    -- {"ui://MessageBox/MessageBoxSmall", lt.UICompMessageBoxSmall},  --消息窗口（单、双个按钮）
    -- {"ui://MessageBox/MessageBoxNum", lt.UICompMessageBoxNum}, --消息窗口（存钱）
    -- {"ui://MessageBox/MessageBoxSell", lt.UICompMessageBoxSell}, --消息窗口（通用买卖）
    -- {"ui://MessageBox/MessageBoxRemove", lt.UICompMessageBoxRemove}, --消息窗口（删除角色）
    -- {"ui://MessageBox/MessageBoxRename", lt.UICompRename},  --改名
    -- {"ui://MessageBox/MessageChatEdit", lt.UICompChatEdit},  --聊天文字编辑
    -- {"ui://MessageBox/MessageBoxAddFriend", lt.UICompFriendAdd},  --添加好友

    self:registerComponent("UICompMessageBox", 
    "UICompMessageBoxSmall", 
    "UICompMessageBoxVoucher",
    "UICompMessageBoxNum", 
    "UICompMessageBoxSell", 
    "UICompMessageBoxRemove", 
    "UICompRename", 
    "UICompChatEdit", 
    "CompItemTips",
    "UICompEquipTips",
    "UICompShowTextTips",
    "UICompShowSkillTips",
    "UICompHelpTips",
    "UICompShowEquipTips",
    "UICompShowDestInfoTips",
    "UICompGuildInfoTips",
    "UICompPetDetailTips",
    "UICompFriendAdd",
    "UICompUseCode",
    "UICompSkinAttrTips",
    "UICompAllAttrsTips",
    "UICompRankInfoTips",
    "CompPlayerTips",
    "UICompRewardTips")
end

function TipsLayer:onEnter()
    -- 物品tips
    NtfManager:addNtfListener(NtfManager.NTF.NTF_ITEM_TIPS, handler(self, self.itemTipNtf), "TipsLayer:itemTipNtf")

    -- 装备tips
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS, handler(self, self.showEquipTips), "TipsLayer:showEquipTips")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CLOSE_EQUIP_TIPS, handler(self, self.closeEquipTips), "TipsLayer:closeEquipTips")

    -- 角色tips
    NtfManager:addNtfListener(NtfManager.NTF.NTF_PLAYER_TIPS, handler(self, self.playerTipNtf), "TipsLayer:playerTipNtf")

    -- MessageBox 消息窗口 两个按钮(可带标题)
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, handler(self, self.showMessageBox), "TipsLayer:showMessageBox")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CLOSE_MESSAGEBOX, handler(self, self.closeMessageBox), "TipsLayer:closeMessageBox")

    -- MessageBoxSmall 消息窗口小型 一/两个按钮
    NtfManager:addNtfListener(NtfManager.NTF.NTF_MESSAGEBOX_SMALL, handler(self, self.showMessageBoxSmall), "TipsLayer:showMessageBoxSmall")

    -- MessageBoxNum
    NtfManager:addNtfListener(NtfManager.NTF.NTF_MESSAGEBOX_NUM, handler(self, self.messageBoxNumFunc), "TipsLayer:messageBoxNumFunc")

    -- MessageBoxSell
    NtfManager:addNtfListener(NtfManager.NTF.NTF_MESSAGEBOX_SELL, handler(self, self.messageBoxSellFunc), "TipsLayer:messageBoxSellFunc")

    -- showTextTips 文本tips
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOW_TEXT_TIPS, handler(self, self.showTextTips), "TipsLayer:showTextTips")

    -- showSkillTips 技能tips
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOW_SKILL_TIPS, handler(self, self.showSkillTips), "TipsLayer:showSkillTips")

    -- helpTips 帮助tips
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOW_HELP_TIPS, handler(self, self.showHelpTips), "TipsLayer:showHelpTips")

    -- 改名
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOW_RENAME_MESSAGE_BOX, handler(self, self.showMessageBoxRename), "TipsLayer:showMessageBoxRename")

    -- 聊天文字编辑
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOW_CHATEDIT_MESSAGE_BOX, handler(self, self.showMessageBoxChatEdit), "TipsLayer:showMessageBoxChatEdit")

    -- 添加好友
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOW_FRIENDADD_MESSAGE_BOX, handler(self, self.showMessageBoxFriendAdd), "TipsLayer:showMessageBoxFriendAdd")

    -- 交互tips
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOW_DESTINFOTIPS, handler(self, self.showDestInfoTips), "TipsLayer:showDestInfoTips")

    -- 公会交互tips
    NtfManager:addNtfListener(NtfManager.NTF.NTF_GUILDMEMBERINFO_TIPS, handler(self, self.showGuildInfoTips), "TipsLayer:showGuildInfoTips")

    -- 宠物tips
    NtfManager:addNtfListener(NtfManager.NTF.NTF_PET_DETAIL_TIPS, handler(self, self.showPetDetailTips), "TipsLayer:showPetDetailTips")

    -- 礼包码
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOW_RENAME_GIFTCODE_BOX, handler(self, self.showMessageBoxUseCode), "TipsLayer:showMessageBoxUseCode")

    -- 宠物属性tips
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOW_PET_SKIN_TIPS, handler(self, self.showPetSkinAttrTips), "TipsLayer:showPetSkinAttrTips")

    -- 总属性tips
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOW_ATTRS_TIPS, handler(self, self.showAttrTips), "TipsLayer:showAttrTips")

    -- 点券消耗资源提示
    NtfManager:addNtfListener(NtfManager.NTF.NTF_MESSAGEBOX_VOUCHER, handler(self, self.showMessageVoucher), "TipsLayer:showMessageVoucher")

    -- 排行榜tips
    NtfManager:addNtfListener(NtfManager.NTF.NTF_RANK_INFO_TIPS, handler(self, self.showRankTips), "TipsLayer:showRankTips")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOW_REWARD_TIPS, handler(self, self.showRewardTips), "TipsLayer:showRewardTips")
end

function TipsLayer:onExit()
    NtfManager:removeNtfListenerByTag("TipsLayer:itemTipNtf")
    NtfManager:removeNtfListenerByTag("TipsLayer:showEquipTips")
    NtfManager:removeNtfListenerByTag("TipsLayer:closeEquipTips")
    NtfManager:removeNtfListenerByTag("TipsLayer:playerTipNtf")
    NtfManager:removeNtfListenerByTag("TipsLayer:showMessageBox")
    NtfManager:removeNtfListenerByTag("TipsLayer:closeMessageBox")
    NtfManager:removeNtfListenerByTag("TipsLayer:showMessageBoxSmall")
    NtfManager:removeNtfListenerByTag("TipsLayer:messageBoxNumFunc")
    NtfManager:removeNtfListenerByTag("TipsLayer:messageBoxSellFunc")
    NtfManager:removeNtfListenerByTag("TipsLayer:showTextTips")
    NtfManager:removeNtfListenerByTag("TipsLayer:showSkillTips")
    NtfManager:removeNtfListenerByTag("TipsLayer:showHelpTips")
    NtfManager:removeNtfListenerByTag("TipsLayer:showMessageBoxRename")
    NtfManager:removeNtfListenerByTag("TipsLayer:showMessageBoxChatEdit")
    NtfManager:removeNtfListenerByTag("TipsLayer:showMessageBoxFriendAdd")
    NtfManager:removeNtfListenerByTag("TipsLayer:showDestInfoTips")
    NtfManager:removeNtfListenerByTag("TipsLayer:showGuildInfoTips")
    NtfManager:removeNtfListenerByTag("TipsLayer:showPetDetailTips")
    NtfManager:removeNtfListenerByTag("TipsLayer:showMessageBoxUseCode")
    NtfManager:removeNtfListenerByTag("TipsLayer:showPetSkinAttrTips")
    NtfManager:removeNtfListenerByTag("TipsLayer:showAttrTips")
    NtfManager:removeNtfListenerByTag("TipsLayer:showMessageVoucher")
    NtfManager:removeNtfListenerByTag("TipsLayer:showRewardTips")
    NtfManager:removeNtfListenerByTag("TipsLayer:showRankTips")
end

function TipsLayer:onClear()

    self:unregisterAllComponent()

    self:removeFromParent()
    self._view = nil
    self._messageBox = nil
    self._playerTips = nil
    self._equipTips = nil
    self._messageBoxSmall = nil
    self._messageBoxNum = nil
    self._messageBoxSell = nil
    self._textTips = nil
    self._skillTips = nil
    self._renameMessageBox = nil
    self._chatEditMessageBox = nil
    self._friendAddMessageBox = nil
    self._destInfoTips = nil
    self._guildInfoTips = nil
    self._petDetailTips = nil
    self._itemTips = nil
    self._codeMessageBox = nil
    TipsLayer.super.onClear(self)
end

-- 提升tips层级
function TipsLayer:changeToTop(child)
    local children = self._view:getChildren()
    self._view:setChildIndex(child,#children-1)
end

function TipsLayer:itemTipNtf(event)
    local param = event.param
    if not self._itemTips then 
        self._itemTips = fgui.UIPackage:createObject("CompItemTips", "CompItemTips")
        self._itemTips:insertObjectToFactory(self)
        self._itemTips:setSortingOrder(TipsZorder[Constant.TIPSTYPE.ITEMTIPS] or 0)
        self._view:addChild(self._itemTips)
    end
    self._itemTips:setItemTxtUI(param)
end

function TipsLayer:showEquipTips(event)
    local param = event.param
    if param then
        if not self._equipTips then
            self._equipTips = fgui.UIPackage:createObject("EquipTips", "ShowEquipTips")
            self._equipTips:insertObjectToFactory(self)
            self._equipTips:setSortingOrder(TipsZorder[Constant.TIPSTYPE.EQUIPTIPS] or 0)
            self._view:addChild(self._equipTips)
        else
            self:tipsOnEnter(self._equipTips)
        end
        
        self._equipTips:refreshTips(param)
    else
        self:closeEquipTips(nil)
    end
end

function TipsLayer:closeEquipTips(event)
    if self._equipTips then
        self:tipsOnExit(self._equipTips)
    end
end

function TipsLayer:playerTipNtf(event)
    local param = event.param
    if not self._playerTips then 
        self._playerTips = fgui.UIPackage:createObject("Team", "PlayerTips")
        self._playerTips:insertObjectToFactory(self)

        self._view:addChild(self._playerTips)
    end
    self._playerTips:refreshTips(param)
end

function TipsLayer:showMessageBox(event)
    local param = event.param
    if param then
        if not self._messageBox then
            self._messageBox = fgui.UIPackage:createObject("MessageBox", "MessageBox")
            self._messageBox:insertObjectToFactory(self)

            self._view:addChild(self._messageBox)
            self._messageBox:initUI()
        else
            self:tipsOnEnter(self._messageBox)
        end
        
        self._messageBox:refreshDesc(param)
        self:changeToTop(self._messageBox)
    else
        self:closeMessageBox(nil)
    end
end

function TipsLayer:closeMessageBox(event)
    if self._messageBox then
        self:tipsOnExit(self._messageBox)
    end
end

function TipsLayer:showMessageBoxSmall(event)
    local param = event.param
    if param then
        if not self._messageBoxSmall then
            self._messageBoxSmall = fgui.UIPackage:createObject("MessageBox", "MessageBoxSmall")
            self._messageBoxSmall:insertObjectToFactory(self)

            self._view:addChild(self._messageBoxSmall)
            self._messageBoxSmall:initUI()
        else
            self:tipsOnEnter(self._messageBoxSmall)
        end
        
        self._messageBoxSmall:refreshDesc(param)
        self:changeToTop(self._messageBoxSmall)
    else
        self:closeMessageBoxSmall(nil)
    end
end

function TipsLayer:closeMessageBoxSmall(event)
    if self._messageBoxSmall then
        self:tipsOnExit(self._messageBoxSmall)
    end
end

function TipsLayer:messageBoxNumFunc(event)
    local param = event.param
    if param then
        if not self._messageBoxNum then
            self._messageBoxNum = fgui.UIPackage:createObject("MessageBox", "MessageBoxNum")
            self._messageBoxNum:insertObjectToFactory(self)

            self._view:addChild(self._messageBoxNum)
            self._messageBoxNum:initUI()
        else
            self:tipsOnEnter(self._messageBoxNum)
        end

        self._messageBoxNum:refreshInfo(param)
        self:changeToTop(self._messageBoxNum)
    else
        self:closeMessageBoxNum()
    end
end

function TipsLayer:closeMessageBoxNum(event)
    if self._messageBoxNum then
        self:tipsOnExit(self._messageBoxNum)
    end
end

function TipsLayer:messageBoxSellFunc(event)
    local param = event.param
    if param then
        if not self._messageBoxSell then
            self._messageBoxSell = fgui.UIPackage:createObject("MessageBox", "MessageBoxSell")
            self._messageBoxSell:insertObjectToFactory(self)

            self._view:addChild(self._messageBoxSell)
            self._messageBoxSell:initUI()
        else
            self:tipsOnEnter(self._messageBoxSell)
        end

        self._messageBoxSell:refreshUI(param)
        self:changeToTop(self._messageBoxSell)
    else
        self:closeMessageBoxSell()
    end
end

function TipsLayer:closeMessageBoxSell(event)
    if self._messageBoxSell then
        self:tipsOnExit(self._messageBoxSell)

    end
end

function TipsLayer:showTextTips(event)
    local param = event.param
    if param then
        if not self._textTips then
            self._textTips = fgui.UIPackage:createObject("EquipTips", "ShowTextTips")
            self._textTips:insertObjectToFactory(self)

            self:addChild(self._textTips)
        end
        
        self._textTips:refreshTips(param)
    else
        if self._textTips then
            self._textTips:onLayerClick()
        end
    end
end

function TipsLayer:showSkillTips(event)
    local param = event.param
    if param then
        if not self._skillTips then
            self._skillTips = fgui.UIPackage:createObject("Skill", "ShowSkillTips")
            self._skillTips:insertObjectToFactory(self)

            self._view:addChild(self._skillTips)
