--显示宠物tips
function TipsLayer:showPetDetailTips(event)
    local param = event.param
    if param and param.pet then
        if not self._petDetailTips then
            self._petDetailTips = fgui.UIPackage:createObject("Pet", "PetTipsPanel")
            self._petDetailTips:insertObjectToFactory(self)
            self._view:addChild(self._petDetailTips)
        else
            self:tipsOnEnter(self._petDetailTips)
        end
        self._petDetailTips:refreshTips(param.pet)

    else
        self:closePetDetailTips(event)
    end
end

function TipsLayer:closePetDetailTips(event)
    if self._petDetailTips then
        self:tipsOnExit(self._petDetailTips)

    end
end

function TipsLayer:checkHasTips()
    local hasTips = self._itemTips and self._itemTips:isVisible() or false
    if not hasTips then
        hasTips = self._equipTips and self._equipTips:isVisible() or false
    end
    return hasTips
end
