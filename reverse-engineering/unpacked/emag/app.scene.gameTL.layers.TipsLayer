end

function TipsLayer:showHelpTips(event)
    local param = event.param
    if param then
        if not self.helpTips then
            self.helpTips = fgui.UIPackage:createObject("HelpTips", "HelpTips")
            self.helpTips:insertObjectToFactory(self)

            self.helpTips:initUI()
            self._view:addChild(self.helpTips)
        end
        
        self.helpTips:refreshTips(param)
    end
end

