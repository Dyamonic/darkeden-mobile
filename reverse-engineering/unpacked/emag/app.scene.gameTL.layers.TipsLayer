    end
end

--tips 不显示时需手动调用onExit
function TipsLayer:tipsOnExit(tips)
    if tips then
        tips:setVisible(false)
        if tips.onExit then
            tips:onExit()
        end
    end
end

function TipsLayer:tipsOnEnter(tips)
    if tips then
        tips:setVisible(true)
        if tips.onEnter then
            tips:onEnter()
        end
    end
end

return TipsLayer