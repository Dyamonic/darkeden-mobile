
local CmdMount = class("CmdMount", lt.CmdBase)

CmdMount._m         = nil
CmdMount._n         = nil
CmdMount._direction = nil

function CmdMount:ctor(m, n, direction)
    CmdMount.super.ctor(self, lt.Constant.CmdId.CMD_MOUNT)

    self._m           = m
    self._n           = n
    self._direction   = direction
end

-- Setter && Getter
function CmdMount:getM()
    return self._m
end

function CmdMount:getN()
    return self._n
end

function CmdMount:getDirection()
    return self._direction
end

return CmdMount
