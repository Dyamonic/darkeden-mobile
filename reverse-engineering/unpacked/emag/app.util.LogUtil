
local LogUtil = {}

function LogUtil:debug(...)
    print(...)
end

function LogUtil:debugTable(t, prefix, deep)
	if t ~= nil and type(t) == "table" then
		if prefix == nil then
			prefix = ""
		end
		print(prefix .. "{")
		local newPrefix = prefix .. "    "
		for k, v in pairs(t) do
			if type(v) == "table" then
				print(newPrefix .. tostring(k) .. ": ")
				local p = newPrefix
				if deep == nil then
					self:debugTable(v, p, deep)
				elseif deep > 0 then
					self:debugTable(v, p, deep - 1)
				end
			else
				print(newPrefix .. tostring(k) .. ": " .. tostring(v) .. "")
			end
		end
		print(prefix .. "}")
	else
		print(t)
	end
end

--[[--
	打印调试信息

	### 用法示例
	debugLog("WARN", "Network connection lost at %d", os.time())

	@param string tag 调试信息的 tag
	@param string fmt 调试信息格式
	@param [mixed ...] 更多参数
]]
function LogUtil:debugLog(tag, fmt, ...)
	local t = {
		"[",
		string.upper(tostring(tag)),
		"]",
		string.format(tostring(fmt), ...)
	}
	print(table.concat(t))
end

--[[
	输出堆栈
]]
function LogUtil:debugError( fmt, ... )
	self:debugLog("ERR", fmt, ...)
    print(debug.traceback("", 2))
end

function LogUtil:debugInfo(fmt, ...)
    self:debugLog("INFO", fmt, ...)
end

function LogUtil:debugTime()
    print(tostring(os.clock())) 
end

return LogUtil
