local MapObjectActor = class("MapObjectActor")
--[[
    imageObject:
    getObjectType()
    getM() 所在格子(锚点0，1)
    getN() 
    getImageObjectId() 唯一Id
    getSpriteId() 
    getX() 所在地图坐标
    getY() 
    ViewPoint() 
    getTrans() 是否挖空透明
    
]]

MapObjectActor._imageObject = nil
MapObjectActor._drawObjGridTable = nil
MapObjectActor._maskGLProgramState = nil

MapObjectActor._trans = nil
MapObjectActor._pos = nil
MapObjectActor._isRotated = nil -- 图片是否旋转，仅图集的时候使用

function MapObjectActor:ctor(imageObject)
    self._imageObject = imageObject
    self._drawObjGridTable = {}

    self._trans = self._imageObject:getTrans() or 0
    self._isRotated = false
end

function MapObjectActor:onClear()
    self._imageObject = nil
    self._drawObjGridTable = nil
    if self._maskGLProgramState then
        self._maskGLProgramState:onClear()
        self._maskGLProgramState = nil
    end
end

function MapObjectActor:addDrawGrid(objectIndex)
    self._drawObjGridTable[objectIndex] = true
end

function MapObjectActor:removeDrawGrid(objectIndex)
    if self._drawObjGridTable[objectIndex] then
        table.remove(self._drawObjGridTable, objectIndex)
    end

    if table.nums(self._drawObjGridTable) == 0 then
        return true
    end

    return false
end

function MapObjectActor:setSelfPos(pos)
    self._pos = pos
end

-- 是否还存在于地图上，可能异步导致已经被清理 所以需要判断
function MapObjectActor:IsExistOnMap()
    return self._drawObjGridTable ~= nil and table.nums(self._drawObjGridTable) > 0
end

-- 遮罩glProgramState
function MapObjectActor:setMaskGLProgramState(maskGLProgramState)
    self._maskGLProgramState = maskGLProgramState
end

function MapObjectActor:setIsRotated(bool)
    self._isRotated = bool
end

function MapObjectActor:updateOffset(pos, actorZorder)
    if not self:isTrans() or not self._maskGLProgramState then
        return
    end

    -- 此处是为了减少计算吗？ 并没有减少, 可给予一定的浮动值，给予15的浮动值。
    local enable = false
    -- if self:getLocalZOrder() > (actorZorder-15) then -- 在MapActor单独判断了地图，无需浮动值，如有需要再添加 此处做个保存记录，以便查看问题
    if self:getLocalZOrder() > actorZorder then
        enable = true
    end
    -- yflog:Info("self:getLocalZOrder():%s, actorZorder:%s, enable:%s", self:getLocalZOrder(), actorZorder, enable)

    -- 是否使用遮罩算法
    self._maskGLProgramState:updateEnable(enable)

    self._maskGLProgramState:updateOffset(self:calcOffsetPos(pos))
end

function MapObjectActor:calcOffsetPos(pos)
    local selfPos = self._pos
    local maskSize = self._maskGLProgramState:getMaskSize()
    local nodeSize = self._maskGLProgramState:getNodeSize()

    --[[ 
        锚点为(0,1) 所以y轴取反 此处代表遮罩图相对角色的位置
        使用图集时计算方式不同，texture会带上原整图大小做转换，图片发生旋转时(90度)此处y轴的偏移值也相应的去除
    ]]
    -- local offsetY = self._isRotated and - maskSize.y/2 or maskSize.y
    local offsetY = -30
    if self._isRotated then
        -- 翻转后x即为y
        offsetY = offsetY + nodeSize.x-nodeSize.y

        -- yflog:Info("MapObjectActor:calcOffsetPos nodeSize:%s offsetY:%s", yflog:Positon(nodeSize), offsetY)
    end

    local offset = cc.p(pos.x - selfPos.x - maskSize.x/2, selfPos.y - pos.y - maskSize.y/2 + offsetY)
    -- yflog:Info("offset pos:%s ", yflog:Positon(offset))

    return offset
end

-- 是否是传送点
function MapObjectActor:isTrans()
    return self._trans > 0
end

function MapObjectActor:setLocalZOrder(zorder)
    self._localZorder = zorder
end

function MapObjectActor:getLocalZOrder()
    return self._localZorder or 0
end

return MapObjectActor