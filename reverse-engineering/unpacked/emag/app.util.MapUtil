function MapUtil:getTileDir(index)
    return self._tileMap[index]
end

-- m,n 转换成一个唯一数值
function MapUtil:calcMNIndex(m, n)
    return m + 10000 * n
end

function MapUtil:calcMNByIndex(index)
    return math.floor(index % 10000), math.floor(index / 10000)
end

-- Tile相关 根据全局坐标计算当前加载的图片(256*256)
function MapUtil:calcTileMN(x, y)
    return math.floor(x / Constant.MAP_TILE_SIZE), math.floor(-y / Constant.MAP_TILE_SIZE)
end

-- Block相关 根据全局坐标计算当前格子
function MapUtil:calcMN(x, y)
    return math.floor(x / Constant.MAP_BLOCK_WIDTH), math.floor(-y / Constant.MAP_BLOCK_HEIGHT)
end

-- 计算m,n格子的中心点 转换地图坐标
function MapUtil:calcMNMid(m, n)
    -- 中心点 m * 48 + 48/2  -- n * 32 + 32/2
    local x = m * Constant.MAP_BLOCK_WIDTH + Constant.MAP_BLOCK_WIDTH/2;
    local y = -(n * Constant.MAP_BLOCK_HEIGHT + Constant.MAP_BLOCK_HEIGHT/2);
    return x, y
end

function MapUtil:MapToPixel(m, n)
    -- 中心点 m * 48 + 48/2  -- n * 32 + 32/2
    local x = m * Constant.MAP_BLOCK_WIDTH 
    local y = -(n * Constant.MAP_BLOCK_HEIGHT)
    return x, y
end
function MapUtil:MapToPixelX(m)
    -- 中心点 m * 48 + 48/2  -- n * 32 + 32/2
    return m * Constant.MAP_BLOCK_WIDTH 
end
function MapUtil:MapToPixelY(n)
    return -(n * Constant.MAP_BLOCK_HEIGHT)
end
function MapUtil:PixelToMap(x, y)
    -- 中心点 m * 48 + 48/2  -- n * 32 + 32/2
    return math.floor(x / Constant.MAP_BLOCK_WIDTH), math.floor(-y / Constant.MAP_BLOCK_HEIGHT)
end

function MapUtil:PixelToMapX(x)
    -- 中心点 m * 48 + 48/2  -- n * 32 + 32/2
    return math.floor(x / Constant.MAP_BLOCK_WIDTH)
end

function MapUtil:PixelToMapY(y)
    -- 中心点 m * 48 + 48/2  -- n * 32 + 32/2
    return math.floor(-y / Constant.MAP_BLOCK_HEIGHT)
end

-- 计算x,y所在格子的中心点
function MapUtil:calcMid(x, y)
    local m, n = self:calcMN(x, y)
    return self:calcMNMid(m, n)
end

-- 计算m,n效果所属层级
function MapUtil:calcMNZorder(m, n, offset)
    return (n * 10000 + m + 9999) * 10 + (offset or 0)
end

-- 计算方向
function MapUtil:calcDirectionXY(x, y)
    local degree = math.deg(math.atan2(x, y))
    if degree <= -157.5 then
        return Constant.DIRECTION_DOWN
    elseif degree <= -112.5 then
        return Constant.DIRECTION_LEFT_DOWN
    elseif degree <= -67.5 then
        return Constant.DIRECTION_LEFT
    elseif degree <= -22.5 then
        return Constant.DIRECTION_LEFT_UP
    elseif degree <= 22.5 then
        return Constant.DIRECTION_UP
    elseif degree <= 67.5 then
        return Constant.DIRECTION_RIGHT_UP
    elseif degree <= 112.5 then
        return Constant.DIRECTION_RIGHT
    elseif degree <= 157.5 then
        return Constant.DIRECTION_RIGHT_DOWN
    else
        return Constant.DIRECTION_DOWN
    end
end

-- 计算方向
function MapUtil:calcDirectionMN(mFrom, nFrom, mTo, nTo)
    local x1, y1 = lt.MapUtil:calcMNMid(mFrom, nFrom)
    local x2, y2 = lt.MapUtil:calcMNMid(mTo, nTo)
    return lt.MapUtil:calcDirectionXY(x2 - x1, y2 - y1)
end

-- 16方向（某些飞行物会用到）
function MapUtil:calcDirectionXY16(x, y)
    local degree = math.deg(math.atan2(x, y))
    if degree <= -168.75 then
        return 8
    elseif degree <= -146.25 then
        return 9
    elseif degree <= -123.75 then
        return 10
    elseif degree <= -101.25 then
        return 11
    elseif degree <= -78.75 then
        return 12
    elseif degree <= -56.25 then
        return 13
    elseif degree <= -33.75 then
        return 14
    elseif degree <= -11.25 then
        return 15
    elseif degree <= 11.25 then
        return 0
    elseif degree <= 33.75 then
        return 1
    elseif degree <= 56.25 then
        return 2
    elseif degree <= 78.75 then
        return 3
    elseif degree <= 101.25 then
        return 4
    elseif degree <= 123.75 then
        return 5
    elseif degree <= 146.25 then
        return 6
    elseif degree <= 168.75 then
        return 7
    else
        return 8
    end


    local degree = math.deg(math.atan2(x, y))
    if degree <= -157.5 then
        return Constant.DIRECTION_DOWN
    elseif degree <= -112.5 then
        return Constant.DIRECTION_LEFT_DOWN
    elseif degree <= -67.5 then
        return Constant.DIRECTION_LEFT
    elseif degree <= -22.5 then
        return Constant.DIRECTION_LEFT_UP
    elseif degree <= 22.5 then
        return Constant.DIRECTION_UP
    elseif degree <= 67.5 then
        return Constant.DIRECTION_RIGHT_UP
    elseif degree <= 112.5 then
        return Constant.DIRECTION_RIGHT
    elseif degree <= 157.5 then
        return Constant.DIRECTION_RIGHT_DOWN
    else
        return Constant.DIRECTION_DOWN
    end
end

-- 计算direction方向上的两个格子
function MapUtil:calcNext2MN(m, n, direction)
    if direction == Constant.DIRECTION_UP then
        return m, n - 1, m, n - 2
    elseif direction == Constant.DIRECTION_RIGHT_UP then
        return m + 1, n - 1, m + 2, n - 2
    elseif direction == Constant.DIRECTION_RIGHT then
        return m + 1, n, m + 2, n
    elseif direction == Constant.DIRECTION_RIGHT_DOWN then
        return m + 1, n + 1, m + 2, n + 2
    elseif direction == Constant.DIRECTION_DOWN then
        return m, n + 1, m, n + 2
    elseif direction == Constant.DIRECTION_LEFT_DOWN then
        return m - 1, n + 1, m - 2, n + 2
    elseif direction == Constant.DIRECTION_LEFT then
        return m - 1, n, m - 2, n
    elseif direction == Constant.DIRECTION_LEFT_UP then
        return m - 1, n - 1, m - 2, n - 2
    else
        return m, n
    end
end

-- 计算direction方向上的三个格子
function MapUtil:calcNext3MN(m, n, direction)
    if direction == Constant.DIRECTION_UP then
        return m, n - 1, m, n - 2, m, n - 3
    elseif direction == Constant.DIRECTION_RIGHT_UP then
        return m + 1, n - 1, m + 2, n - 2, m + 3, n - 3
    elseif direction == Constant.DIRECTION_RIGHT then
        return m + 1, n, m + 2, n, m + 3, n
    elseif direction == Constant.DIRECTION_RIGHT_DOWN then
        return m + 1, n + 1, m + 2, n + 2, m + 3, n + 3
    elseif direction == Constant.DIRECTION_DOWN then
        return m, n + 1, m, n + 2, m, n + 3
    elseif direction == Constant.DIRECTION_LEFT_DOWN then
        return m - 1, n + 1, m - 2, n + 2, m - 3, n + 3
    elseif direction == Constant.DIRECTION_LEFT then
        return m - 1, n, m - 2, n, m - 3, n
    elseif direction == Constant.DIRECTION_LEFT_UP then
        return m - 1, n - 1, m - 2, n - 2, m - 3, n - 3
    else
        return m, n
    end
end

-- 判断三个MN是否在一条直线上
function MapUtil:isMNInLine(mn0, mn1, mn2)
    if (mn1.m - mn0.m == mn2.m - mn1.m) and (mn1.n - mn0.n == mn2.n - mn1.n) then
        return true
    else
        return false
    end
end

-- 判断两个MN是否相邻
function MapUtil:isMNNeighbor(m0, n0, m1, n1)
    if math.max(math.abs(m1 - m0), math.abs(n1 - n0)) == 1 then
        return true
    else
        return false
    end
end

-- 获取一个方向的相邻的两个方向
function MapUtil:getNeighborDirection(direction)
    if direction == Constant.DIRECTION_UP then
        return Constant.DIRECTION_LEFT_UP, Constant.DIRECTION_RIGHT_UP
    elseif direction == Constant.DIRECTION_RIGHT_UP then
        return Constant.DIRECTION_UP, Constant.DIRECTION_RIGHT
    elseif direction == Constant.DIRECTION_RIGHT then
        return Constant.DIRECTION_RIGHT_UP, Constant.DIRECTION_RIGHT_DOWN
    elseif direction == Constant.DIRECTION_RIGHT_DOWN then
        return Constant.DIRECTION_RIGHT, Constant.DIRECTION_DOWN
    elseif direction == Constant.DIRECTION_DOWN then
        return Constant.DIRECTION_RIGHT_DOWN, Constant.DIRECTION_LEFT_DOWN
    elseif direction == Constant.DIRECTION_LEFT_DOWN then
        return Constant.DIRECTION_DOWN, Constant.DIRECTION_LEFT
    elseif direction == Constant.DIRECTION_LEFT then
        return Constant.DIRECTION_LEFT_DOWN, Constant.DIRECTION_LEFT_UP
    elseif direction == Constant.DIRECTION_LEFT_UP then
        return Constant.DIRECTION_LEFT, Constant.DIRECTION_UP
    else
        return nil
    end
end

function MapUtil:getOppositeDirection(direction)
    if direction == Constant.DIRECTION_UP then
        return Constant.DIRECTION_DOWN
    elseif direction == Constant.DIRECTION_RIGHT_UP then
        return Constant.DIRECTION_LEFT_DOWN
    elseif direction == Constant.DIRECTION_RIGHT then
        return Constant.DIRECTION_LEFT
    elseif direction == Constant.DIRECTION_RIGHT_DOWN then
        return Constant.DIRECTION_LEFT_UP
    elseif direction == Constant.DIRECTION_DOWN then
        return Constant.DIRECTION_UP
    elseif direction == Constant.DIRECTION_LEFT_DOWN then
        return Constant.DIRECTION_RIGHT_UP
    elseif direction == Constant.DIRECTION_LEFT then
        return Constant.DIRECTION_RIGHT
    elseif direction == Constant.DIRECTION_LEFT_UP then
        return Constant.DIRECTION_RIGHT_DOWN
    else
        return Constant.DIRECTION_UNKNOW
    end
end

-- 根据方向返回方向向量以及旋转角度
function MapUtil:calcOffsetAndRotation(direction, normalize)
    local ratio = math.sqrt(2) / 2
    if normalize then
        ratio = 1
    end

    if direction == lt.Constant.DIRECTION_UP then
        return cc.p(0, 1), 0

    elseif direction == lt.Constant.DIRECTION_RIGHT_UP then
        return cc.p(ratio, ratio), 45

    elseif direction == lt.Constant.DIRECTION_RIGHT then
        return cc.p(1, 0), 90

    elseif direction == lt.Constant.DIRECTION_RIGHT_DOWN then
        return cc.p(ratio, -ratio), 135

    elseif direction == lt.Constant.DIRECTION_DOWN then
        return cc.p(0, -1), 180

    elseif direction == lt.Constant.DIRECTION_LEFT_DOWN then
        return cc.p(-ratio, -ratio), 225

    elseif direction == lt.Constant.DIRECTION_LEFT then
        return cc.p(-1, 0), 270

    elseif direction == lt.Constant.DIRECTION_LEFT_UP then
        return cc.p(-ratio, ratio), 315

    else
        return nil
    end
end

--[[
    是否处于一个菱形中
        p1
    p2      p4
        p3
    ]]
function MapUtil:inRhombus(m, n, p1, p2, p3, p4)
    return self:_calRhombusLine(m, n, p1, p2) > 0 and self:_calRhombusLine2(m, n, p2, p3) < 0 and self:_calRhombusLine(m, n, p3, p4) < 0 and self:_calRhombusLine2(m, n, p4, p1) > 0
end

function MapUtil:_calRhombusLine(m, n, p1, p2)
    local a = (p1.y - p2.y) / (p1.x - p2.x)
    local b = p1.y - a * p1.x
    local calN = a * m + b

    if calN < n then
        return 1
    elseif calN > n then
        return -1
    else
        return 0
    end
end

function MapUtil:_calRhombusLine2(m, n, p1, p2)
    local a = (p1.y - p2.y) / (p1.x - p2.x)
    local b = p1.y - a * p1.x
    local calM = (n - b) / a

    if calM > m then
        return 1
    elseif calM < m then
        return - 1
    else
        return 0
    end
end

