function MapUtil:getTileSoundId(actionId, ttype)
    if not actionId or not ttype or not self.SOUND_MAP[actionId] then
        return nil
    end

    return self.SOUND_MAP[actionId][ttype]
end

--[[
    寻路
    routeex: 忽略block & 忽略传送点(用于挂机)
    route2:  末尾两个bool参数可变
    
    beginM, beginN, endM, endN, bool ignoreTarBlock, bool isHangup
    ignoreTarBlock: true 忽略目标点block
    isHangup: true       传送点阻挡(用于挂机)

    route:   无视忽略任何情况

    isBlockTarget: 无视目标点阻挡 false则终点是阻挡点不可寻路
    isTransTarget: 无视传送点阻挡 false则传送点是阻挡点
]]
function MapUtil:route(mHero, nHero, tarM, tarN, isBlockTarget, isTransTarget)
    local route = nil

    -- 挂机状态时寻路
    if lt.AutoFightManager:isAuto() or not isTransTarget then
        --  传送点阻挡 
        route = RouteManagerInstance:routeex(mHero, nHero, tarM, tarN)
    else
        if isBlockTarget then
            route = RouteManagerInstance:route2(mHero, nHero, tarM, tarN, true)
        else
            -- 目标点阻挡，不能寻路
            route = RouteManagerInstance:route(mHero, nHero, tarM, tarN)
        end
    end

    if not route then
        lt.AgentManager:getWorldAgent():getMapAgent():clearClickMark()
    end

    return route
end

function MapUtil:getMNDistance(m1, n1, m2, n2)
    return math.max(math.abs(m1 - m2), math.abs(n1 - n2))
end

function MapUtil:getPonitDistance(m1, n1, m2, n2)
    return math.pow(math.abs(m1 - m2), 2) + math.pow(math.abs(n1 - n2), 2)
end

MapUtil.FLAG_BLOCK_UNDERGROUND = 0x01
MapUtil.FLAG_BLOCK_GROUND      = 0x02
MapUtil.FLAG_BLOCK_FLYING      = 0x04
MapUtil.FLAG_BLOCK_ALL         = 0x07

-- 无阻挡点
function MapUtil:IsEmpty(block) 
    return block == 0
end

-- 全阻挡
function MapUtil:IsBlockAll(block)
    local b = MapUtil.AllMap[block]
    if not b then
        b = false
    end
    -- local b = self:IsBlockUnderground(block) and self:IsBlockGround(block) and self:IsBlockFlying(block)
    return b
end

-- 地下阻挡
function MapUtil:IsBlockUnderground(block)
    local b = MapUtil.UnderGroundMap[block]
    if not b then
        b = false
    end
    return b
end

-- 地面阻挡
function MapUtil:IsBlockGround(block) 
    local b = MapUtil.GroundMap[block]
    if not b then
        b = false
    end
    return b
end

-- 飞行阻挡
function MapUtil:IsBlockFlying(block) 
    local b = MapUtil.FlyingMap[block]
    if not b then
        b = false
    end
    return b
end

-- byte 按位与
function MapUtil:bitwiseAnd(a, b)
    local result = 0
    for i = 0, 8 do
        if (a % 2 == 1) and (b % 2 == 1) then
            result = result + 2 ^ i
        end
        a = math.floor(a / 2)
        b = math.floor(b / 2)
    end
    return result
end

function MapUtil:getPositionToDirection(x, y, direction)
	if direction == Constant.DIRECTION_LEFT_DOWN then
		x = x - 1
		y = y + 1
	elseif direction == Constant.DIRECTION_RIGHT_UP then
		x = x + 1
		y = y - 1
	elseif direction == Constant.DIRECTION_LEFT_UP then
		x = x - 1
		y = y - 1
	elseif direction == Constant.DIRECTION_RIGHT_DOWN then
		x = x + 1
		y = y + 1
	elseif direction == Constant.DIRECTION_LEFT then
		x = x - 1
	elseif direction == Constant.DIRECTION_DOWN then
		y = y + 1
	elseif direction == Constant.DIRECTION_UP then
		y = y - 1
	elseif direction == Constant.DIRECTION_RIGHT then
		x = x + 1
	end
	return x, y
end

function MapUtil:getPositionToDirectionFGUI(x, y, direction)
	if direction == Constant.DIRECTION_LEFT_DOWN then
		x = x - 1
		y = y - 1
	elseif direction == Constant.DIRECTION_RIGHT_UP then
		x = x + 1
		y = y + 1
	elseif direction == Constant.DIRECTION_LEFT_UP then
		x = x - 1
		y = y + 1
	elseif direction == Constant.DIRECTION_RIGHT_DOWN then
		x = x + 1
		y = y - 1
	elseif direction == Constant.DIRECTION_LEFT then
		x = x - 1
	elseif direction == Constant.DIRECTION_DOWN then
		y = y - 1
	elseif direction == Constant.DIRECTION_UP then
		y = y + 1
	elseif direction == Constant.DIRECTION_RIGHT then
		x = x + 1
	end
	return x, y
end

function MapUtil:getDirectionToPosition(originX, originY, destX, destY)
    local stepX = destX - originX
    local stepY = destY - originY

    -- 计算斜率
    local k = (stepX == 0) and 0 or (stepY / stepX)

    -- 确定方向
    if stepY == 0 then
        -- X轴方向
        if stepX == 0 then
            return Constant.DIRECTION_DOWN
        elseif stepX > 0 then
            return Constant.DIRECTION_RIGHT
        else
            return Constant.DIRECTION_LEFT
        end
    elseif stepY < 0 then  -- 向上
        if stepX == 0 then
            return Constant.DIRECTION_UP
        elseif stepX > 0 then  -- 第一象限
            if k < -Constant.BASIS_DIRECTION_HIGH then
                return Constant.DIRECTION_UP
            elseif k <= -Constant.BASIS_DIRECTION_LOW then
                return Constant.DIRECTION_RIGHT_UP
            else
                return Constant.DIRECTION_RIGHT
            end
        else  -- 第二象限
            if k > Constant.BASIS_DIRECTION_HIGH then
                return Constant.DIRECTION_UP
            elseif k >= Constant.BASIS_DIRECTION_LOW then
                return Constant.DIRECTION_LEFT_UP
            else
                return Constant.DIRECTION_LEFT
            end
        end
    else  -- 向下
        if stepX == 0 then
            return Constant.DIRECTION_DOWN
        elseif stepX > 0 then  -- 第四象限
            if k > Constant.BASIS_DIRECTION_HIGH then
                return Constant.DIRECTION_DOWN
            elseif k >= Constant.BASIS_DIRECTION_LOW then
                return Constant.DIRECTION_RIGHT_DOWN
            else
                return Constant.DIRECTION_RIGHT
            end
        else  -- 第三象限
            if k < -Constant.BASIS_DIRECTION_HIGH then
                return Constant.DIRECTION_DOWN
            elseif k <= -Constant.BASIS_DIRECTION_LOW then
                return Constant.DIRECTION_LEFT_DOWN
            else
                return Constant.DIRECTION_LEFT
            end
        end
    end
end

function MapUtil:getWidth()
    local mapData = lt.AgentManager:getWorldAgent():getMapAgent():getMapData()
    return mapData:getMCount()
end

function MapUtil:getHeight()
    local mapData = lt.AgentManager:getWorldAgent():getMapAgent():getMapData()
    return mapData:getNCount()
end
function MapUtil:getNextTileByDirection(tileX, tileY, dir)
    local finalTile = { x = tileX, y = tileY }

    if dir == Constant.DIRECTION_LEFT_DOWN then
        finalTile.x = finalTile.x - 1
        finalTile.y = finalTile.y + 1
    elseif dir == Constant.DIRECTION_RIGHT_UP then
        finalTile.x = finalTile.x + 1
        finalTile.y = finalTile.y - 1
    elseif dir == Constant.DIRECTION_LEFT_UP then
        finalTile.x = finalTile.x - 1
        finalTile.y = finalTile.y - 1
    elseif dir == Constant.DIRECTION_RIGHT_DOWN then
        finalTile.x = finalTile.x + 1
        finalTile.y = finalTile.y + 1
    elseif dir == Constant.DIRECTION_LEFT then
        finalTile.x = finalTile.x - 1
    elseif dir == Constant.DIRECTION_DOWN then
        finalTile.y = finalTile.y + 1
    elseif dir == Constant.DIRECTION_UP then
        finalTile.y = finalTile.y - 1
    elseif dir == Constant.DIRECTION_RIGHT then
        finalTile.x = finalTile.x + 1
    end

    return finalTile
end

function MapUtil:getChangeValueToDirection(direction)
    local x, y = 0, 0 
	if direction == Constant.DIRECTION_LEFT_DOWN then
		x = x - 1
		y = 1
	elseif direction == Constant.DIRECTION_RIGHT_UP then
		x = 1
		y = y - 1
	elseif direction == Constant.DIRECTION_LEFT_UP then
		x = x - 1
		y = y - 1
	elseif direction == Constant.DIRECTION_RIGHT_DOWN then
		x = 1
		y = 1
	elseif direction == Constant.DIRECTION_LEFT then
		x = x - 1
	elseif direction == Constant.DIRECTION_DOWN then
		y = 1
	elseif direction == Constant.DIRECTION_UP then
		y = y - 1
	elseif direction == Constant.DIRECTION_RIGHT then
		x = 1
	end
	return cc.p(x, y)
end

function MapUtil:isInRange(start, target, range)
    return math.max(math.abs(target.x - start.x), math.abs(target.y - start.y)) <= range
end

return MapUtil
