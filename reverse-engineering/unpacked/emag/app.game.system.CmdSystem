
local CmdSystem = class("CmdSystem")

local Constant = lt.Constant

CmdSystem._cmdQueue = nil

function CmdSystem:ctor()
    self._cmdQueue = lt.Queue.new()
end

function CmdSystem:push(cmd)
    self._cmdQueue:push(cmd)
end

function CmdSystem:pop()
    return self._cmdQueue:pop()
end

-- 获取下一条cmd，但是不从queue中移除
function CmdSystem:get()
    return self._cmdQueue:get()
end

function CmdSystem:hasCmd()
    return self:getCmdCount() > 0
end

function CmdSystem:getCmdCount()
    return self._cmdQueue:getSize()
end

function CmdSystem:hasDieCmd()
    local table, left, right = self._cmdQueue:getArray()
    for i = left, right-1 do
        if table[i]:getCmdId() == Constant.CmdId.CMD_DIE then
            return true
        end
    end

    return false
end

function CmdSystem:getDieCmd()
    local table, left, right = self._cmdQueue:getArray()
    for i = left, right-1 do
        if table[i]:getCmdId() == Constant.CmdId.CMD_DIE then
            return table[i]
        end
    end

    return nil
end

return CmdSystem
