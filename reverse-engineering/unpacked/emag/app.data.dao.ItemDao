
local ItemDao = {}

function ItemDao:query(id)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Item WHERE ItemIdx=%d;", id)) do
        local item = lt.ItemMeta.new(row)
        return item
    end
end

function ItemDao:queryAll()
    local itemTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Item") do
        local item = lt.ItemMeta.new(row)
        itemTable[item:getItemId()] = item
    end
    return itemTable
end

function ItemDao:queryAllByKind()
    local itemTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Item") do
        local item = lt.ItemMeta.new(row)
        if not itemTable[item:getKind()] then
            itemTable[item:getKind()] = {}
        end
        table.insert(itemTable[item:getKind()], item)
    end
    return itemTable
end

return ItemDao
