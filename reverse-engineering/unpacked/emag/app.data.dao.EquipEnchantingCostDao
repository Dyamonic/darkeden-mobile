
local EquipEnchantingCostDao = {}

function EquipEnchantingCostDao:query(id)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM EquipEnchantingCost WHERE Amount=%d;", id)) do
        local equipEnchantingCost = lt.EquipEnchantingCostMeta.new(row)
        return equipEnchantingCost
    end
end

function EquipEnchantingCostDao:queryAll()
    local equipEnchantingCostTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM EquipEnchantingCost") do
        local equipEnchantingCost = lt.EquipEnchantingCostMeta.new(row)
        equipEnchantingCostTable[equipEnchantingCost:getId()] = equipEnchantingCost
    end
    return equipEnchantingCostTable
end

return EquipEnchantingCostDao
