local DEFAULT_COLOR = cc.c3b(255, 255, 255)


---@param index number 索引
---@param isGL boolean 是否为opengl颜色值
function RoleColor:getHairColorById(index, isGL)
    if isGL == nil then
        isGL = false
    end
    if index == 0 then
        index = 1
    end
    local color = self.hair[index] or DEFAULT_COLOR
    local glColor = cc.vec3(color.r/255, color.g/255, color.b/255)
    return isGL == false and color or glColor
end

---@param index number 索引
---@param isGL boolean 是否为opengl颜色值
function RoleColor:getSkinColorById(index, isGL)
    if isGL == nil then
        isGL = false
    end
    if index == 0 then
        index = 1
    end
    local color = self.skin[index] or DEFAULT_COLOR
    local glColor = cc.vec3(color.r/255, color.g/255, color.b/255)
    return isGL == false and color or glColor
end

return RoleColor
    
