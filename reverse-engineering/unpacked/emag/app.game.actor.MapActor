    --         return
    --     end
    --     local tileSprite = lt.PoolManager:popSprite()
    --     tileSprite:initWithTexture(texture)
    --     tileSprite:setAnchorPoint(0, 1)
    --     tileSprite:setPosition(m * 48, -n * 24)
    --     self._drawNode:addChild(tileSprite)

    --     if not self._curBlockTable[tileIndex] then
    --         self._curBlockTable[tileIndex] = {}
    --     end
    --     table.insert(self._curBlockTable[tileIndex], tileSprite)
    -- end)

    -- self._imageTable["debug/blockeds.png"] = true
end

function MapActor:drawBlockImg(m, n, path, tileIndex)
    display.loadImage(path, function(texture)
        if not texture or not self._curBlockIndexTable or not self._curBlockIndexTable[tileIndex] then
            return
        end
        local tileSprite = lt.PoolManager:popSprite()
        tileSprite:initWithTexture(texture)
        tileSprite:setAnchorPoint(0, 1)
        tileSprite:setPosition(m * 48, -n * 24)
        self._drawNode:addChild(tileSprite)

        if not self._curBlockTable[tileIndex] then
            self._curBlockTable[tileIndex] = {}
        end
        table.insert(self._curBlockTable[tileIndex], tileSprite)
    end)

    self._imageTable["debug/blockeds.png"] = true
end

function MapActor:draw256Tile(m, n, tileIndex)
    local resCode = self._mapMeta:getResCode() -- 当前地图资源Id
    local tileName = string.format("%s/%s_%d.jpg", resCode, resCode, n * self._mTileCount + m + 1) -- 对应256title图片资源名称
    local obj = lt.Constant:getMapObj(resCode) -- 获取该地图资源所在的object
    local tileData =  lt.MapbinManager:getMapbinInfoByKey(obj, tileName) -- 获取256图片所在object中的字节段
    local path = "map/common/0.jpg"
    if tileData and tileData ~= "" then
        -- C++代码中的特殊解析格式(仅地图资源，取字节)
        path = string.format("map/%s/mapbin/%s%s", obj, tileName, tileData)
    end

    display.loadImage(path, function(texture)
            if not texture or not self._curTileIndexTable or not self._curTileIndexTable[tileIndex] then
                yflog:Info("no texture tileIndex:%d", tileIndex)
                return
            end

            local tileSprite = lt.PoolManager:popSprite()
            tileSprite:initWithTexture(texture)
            tileSprite:setAnchorPoint(0, 1)
            tileSprite:setPosition(m * lt.Constant.MAP_TILE_SIZE, -n * lt.Constant.MAP_TILE_SIZE)
            -- 
            self._tileNode:addChild(tileSprite)

            if not self._curTileTable[tileIndex] then
                self._curTileTable[tileIndex] = {}
            end

            table.insert(self._curTileTable[tileIndex], tileSprite)

        end)

        self._imageTable[path] = true
end

function MapActor:removeImageObject(mIndex, nIndex, objectIndex, imgObjList)
    for _, imgObj in ipairs(imgObjList) do
        local objId = imgObj:getImageObjectId()
        if self._imageObjectIdTable[objId] then
            -- remove的同时判断是否是最后的格子占有次object
            local isLast = self._imageObjectIdTable[objId]:removeDrawGrid(objectIndex)
            if isLast then
                -- 移除Image object在地图上的显示
                -- 资源缓存
                local objectSprite = self._curObjectTable[objId]
                if objectSprite then
                    lt.PoolManager:pushSprite(objectSprite)
                    objectSprite:removeSelf()
                end

                -- 没有grid格子关联时 清空
                self._imageObjectIdTable[objId] = nil
                self._curObjectTable[objId] = nil
            end
        end
    end
end

function MapActor:drawImageObject(objectIndex, imgObjList, heroActor)
    for _, imgObj in ipairs(imgObjList) do
        local objId = imgObj:getImageObjectId()
        if not self._imageObjectIdTable[objId] then
            local objActor = lt.MapObjectActor.new(imgObj)
            self._imageObjectIdTable[objId] = objActor

            local objSpriteId = imgObj:getSpriteId()
            if objSpriteId >= 0 then
                local path = string.format("map_obj_%s_%d.png",self._mapCode, objSpriteId)

                -- yflog:Info("path:%s",path)

                local pos = cc.p(imgObj:getX(), -imgObj:getY())
                local viewPoint = imgObj:getViewPoint()

                -- self:drawGridPos(imgObj:getM(), imgObj:getN())

                if not self._mapObjectTexture then
                    yflog:Info("self._mapObjectTexture is nil self._mapCode:%s", self._mapCode)
                end

                self._mapObjectTexture:loadImage(path, function(frame)
                -- display.loadImage(path, function(frame)
                    if not frame or not self._curObjectIndexTable or not self._curObjectIndexTable[objectIndex] then
                        yflog:Info("no texture objectIndex:%d", objectIndex)
                        return
                    end

                    -- 此处的frame还是大纹理，所以在像素级操作会存在问题
                    local sp = lt.PoolManager:popSprite()
                    sp:setSpriteFrame(frame)
                    -- sp:initWithTexture(texture)
                    sp:setAnchorPoint(0, 1)
                    sp:setPosition(pos)

                    -- yflog:Info("objSpriteId:%d isRotated:%s", objSpriteId, frame:isRotated(), sp:isRotated())

                    local dungeonTransferEffectMeta = lt.CacheManager:getDungeonTransferEffectMapById(objSpriteId)
                    if dungeonTransferEffectMeta then
                        -- 卡斯塔罗地图ID=81坐标121.76取消特效，此地牢只能出不能进
                        if Constant.CASTALO_NE == tostring(self:getMapCode()) and imgObj:getM() == 121 and imgObj:getN() == 76 then
                        else
                            local spine = lt.SkeletonManager:createSkeletonEffectWithFile("ChuanSong01", "ChuanSong01_skeleton")
                            spine:setAnchorPoint(0, 1)
                            sp:addChild(spine)
                            local size = sp:getContentSize()
                            spine:setPosition(size.width/2, size.height/2)
                            local needFlip = dungeonTransferEffectMeta:getNeedFlip() or 0
                            if needFlip == 1 then
                                spine:setScaleX(-1)
                            end
                            spine:setAnimation(0, "ChuanSong01", true)
                            sp.spine = spine
                        end
                    end
                    -- yflog:Info("object  pos.x:%d, pos.y:%d hero.x:%d, hero.y:%d ",pos.x, pos.y, heroActor:getPos().x,heroActor:getPos().y)

                    --[[
                        此处有个viewPoint的bug
                        @goto 1100 102 42 此地图 objSpriteId == 613 || 614 时 viewPoint的值不正确
                        需要用坐标重新计算
                        local spN = math.floor((math.abs(pos.y) + sp:getContentSize().height) / lt.Constant.MAP_BLOCK_HEIGHT)
                        此时： viewPoint=42  spN=46
                        但是用坐标重新计算后 
                        @goto 61 100 214  此地图 objSpriteId == 1388 马车的viewPoint值有点偏差
                        此时：viewPoint=217  spN=220

                        现暂时改成  当在1100这张地图时 特殊处理不使用viewPoint
                    ]]
                    local spM = math.floor(pos.x / Constant.MAP_BLOCK_WIDTH)
                    local spN = 0
                    local zOrder = (viewPoint * 10000 + spM + 9999) * 10 + 1

                    if Constant.MAP_OBJ_ZORDER_VALUE[tostring(self:getMapCode())] == Constant.OBJ_ZORDER_VALUE_POS_SPN then 
                        spN = math.floor((math.abs(pos.y) + sp:getContentSize().height) / Constant.MAP_BLOCK_HEIGHT)
                        zOrder = (spN * 10000 + spM + 9999) * 10 + 1
                    elseif Constant.MAP_OBJ_ZORDER_VALUE[tostring(self:getMapCode())] == Constant.OBJ_ZORDER_VALUE_IMGOBJ_N then
                        spM = imgObj:getM()
                        spN = imgObj:getN()
                        zOrder = (spN * 10000 + spM + 9999) * 10 + 1
                    end
                    -- yflog:Info("spN:%s spM:%s zOrder:%s viewPoint:%s self:getMapCode():%s", spN, spM, zOrder, imgObj:getViewPoint(), self:getMapCode())
                    if viewPoint == 0 then
                        self._floorNode:addChild(sp, objId)
                    else
                        self._heroNode:addChild(sp, zOrder)
                    end

                    -- yflog:Info("zOrder:%s, imgObj: ObjectType:%s, m:%s, n:%s, imageObjectId:%s, spriteId:%s, viewPoint:%s, trans:%s",zOrder, imgObj:getObjectType(),imgObj:getM(), imgObj:getN(), imgObj:getImageObjectId(), imgObj:getSpriteId(),imgObj:getViewPoint(), imgObj:getTrans())
                    if objActor:isTrans() then
                        objActor:setSelfPos(pos)
                        if heroActor.getSelfMaskSp and heroActor:getSelfMaskSp() then
                            -- local maskGLProgramState = ShaderBackendUtil:makeNodeTextureMask(sp, heroActor:getSelfMaskSp())
                            local maskGLProgramState = ShaderBackendUtil:makeNodeSpriteFrameTextureMask(sp, heroActor:getSelfMaskSp())
                            maskGLProgramState:updateRotated(frame:isRotated())

                            self._imageObjectIdTable[objId]:setLocalZOrder(zOrder)
                            self._imageObjectIdTable[objId]:setMaskGLProgramState(maskGLProgramState)
                            self._imageObjectIdTable[objId]:setIsRotated(frame:isRotated())
                            self._imageObjectIdTable[objId]:updateOffset(heroActor:getPos(), heroActor:getLocalZOrder())
                        end
                    end

                    self._curObjectTable[objId] = sp
                end)
            end

        end

        -- 记录当前obj已被格子m,n绘制, 用于判断该objId 不再重复被绘制
        self._imageObjectIdTable[objId]:addDrawGrid(objectIndex)
    end
end

function MapActor:updateObjMask(x, y)
    if not self._imageObjectIdTable then
        return
    end

    for _, imgObj in pairs(self._imageObjectIdTable) do
        if imgObj:IsExistOnMap() and imgObj:isTrans() then
            imgObj:updateOffset(cc.p(x, y), self:getSelfActor():getLocalZOrder())
       end
    end
end

function MapActor:drawGrid()
    local mCount = self._mapData:getMCount()
    local nCount = self._mapData:getNCount()

    lt.LogUtil:debugTable("----------mCount = "..tostring(mCount))
    lt.LogUtil:debugTable("----------nCount = "..tostring(nCount))

    local blockWidth = lt.Constant.MAP_BLOCK_WIDTH
    local blockHeight = lt.Constant.MAP_BLOCK_HEIGHT

    -- Line
    local color = cc.c4f(0.5, 0, 0, 0.5)
    if DEBUG > 0 then
        for m = 0, mCount do
            self._drawNode:drawLine(cc.p(m * blockWidth, 0), cc.p(m * blockWidth, -blockHeight * nCount), color)
        end

        for n = 0, nCount do
            self._drawNode:drawLine(cc.p(0, -n * blockHeight), cc.p(mCount * blockWidth, -n * blockHeight), color)
        end
    end
end

