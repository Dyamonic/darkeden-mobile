function MapActor:playAnimaton(sprite, path, dirName, index, animationCount)
    local animation = display.getAnimationCache(path)
    if not animation then
        local frames = {}

        local texture = display.loadImage(path)
        if texture then
            local size = texture:getContentSize()
            frames[#frames + 1] = cc.SpriteFrame:createWithTexture(texture, cc.rect(0, 0, size.w, size.h))
        end
        for i=1,animationCount-1 do
            local subPath = string.format("%s%05d_%d.png", dirName, index, i)
            local subTexture = display.loadImage(subPath)
            if subTexture then
                local size = subTexture:getContentSize()
                frames[#frames + 1] = cc.SpriteFrame:createWithTexture(subTexture, cc.rect(0, 0, size.w, size.h))
            end
        end

        animation = display.newAnimation(frames, 1/30)

        display.setAnimationCache(path, animation)
        print("setAnimationCache", path)
    end
    sprite:playAnimationForever(animation)
end

function MapActor:setScale(scale)
    self._scale = scale

    -- 清除当前数据为了重新绘制
    self._mCur = nil
    self._nCur = nil

    cc.Node.setScale(self, scale)
end

function MapActor:getSelfActor()
    if self._heroActor then
        return self._heroActor
    end

    local heroAgent = lt.AgentManager:getHeroAgent()
    if not heroAgent then
        return
    end

    self._heroActor = heroAgent:getActor()
    return self._heroActor
end

--初始化转职副本
function MapActor:initAdvanceDungeon()
    --染色副本
    self:drawBlackArea()
    --解决人质副本
    self:initDungeonBlood()
end

--初始化副本染色
function MapActor:drawBlackArea()
    local myMapMeta = lt.AgentManager:getWorldAgent():getMapAgent():getMapMeta()
    local mymapcode = myMapMeta:getMapCode()
    if mymapcode ~= Constant.MAP_CODE.GATEOFALTAR then return end
    if self._blackSprites == nil then
        self._blackSprites = {}
    end
    local race = GameModule:getHeroData():getRace()
    local taskData = TaskModule:getTaskById(Constant["ADVANCE_TASK"..race].DYEING)
    local isComplete = TaskModule:checkTaskComplete(taskData)
    if not isComplete then
        local missionMeta = lt.CacheManager:getMissionMeta(Constant["ADVANCE_TASK"..race].DYEING)
        local target = missionMeta:getMissionTarget()[1][2]
        local meta = lt.CacheManager:getGateOfAltarMeta(target)
        local areas = meta:getCompleteArea()
        local resPath = lt.ResManager:getBlackGridResPath()
        for i = 1, #areas do
            local m = areas[i][1]
            local n = areas[i][2]
            local mnIndex = MapUtil:calcMNIndex(m, n)
            if self._blackSprites[mnIndex] == nil then
                local blackSprite = display.newSprite(resPath)
                blackSprite:setPosition(m * Constant.MAP_BLOCK_WIDTH + Constant.MAP_BLOCK_WIDTH/2, -n * Constant.MAP_BLOCK_HEIGHT - Constant.MAP_BLOCK_HEIGHT/2)
                self._blackSprites[mnIndex] = blackSprite
                self._floorNode:addChild(blackSprite)
            end
        end
        self:onDungeonAltar()
    else
        self:createTeleportation()
    end
end

--重置副本染色
function MapActor:resetBlackArea()
    self._blackSprites = {}
end

--副本染色
function MapActor:onDungeonAltar(event)
    local myMapMeta = lt.AgentManager:getWorldAgent():getMapAgent():getMapMeta()
    local mymapcode = myMapMeta:getMapCode()
    if mymapcode ~= Constant.MAP_CODE.GATEOFALTAR then return end
    if self._blackSprites then
        local altarGatePos = MapModule:getAltarGatePos()
        for i = 1, #altarGatePos do
            self._blackSprites[tonumber(altarGatePos[i])]:setVisible(false)
        end
    end
    self:createTeleportation()
end

--初始化副本解救人质
function MapActor:initDungeonBlood()
    local worldAgent = lt.AgentManager:getWorldAgent()
    local myMapMeta = worldAgent:getMapAgent():getMapMeta()
    local mymapcode = myMapMeta:getMapCode()
    if mymapcode ~= Constant.MAP_CODE.ALTAROFBLOOD then return end
    local race = GameModule:getHeroData():getRace()
    local taskData = TaskModule:getTaskById(Constant["ADVANCE_TASK"..race].HOSTAGE)
    local isComplete = TaskModule:checkTaskComplete(taskData)
    if not isComplete then
        self:onDungeonBlood()
    else
        self:createTeleportation()
    end
end

--副本解救人质
function MapActor:onDungeonBlood(event)
    local worldAgent = lt.AgentManager:getWorldAgent()
    local myMapMeta = worldAgent:getMapAgent():getMapMeta()
    local mymapcode = myMapMeta:getMapCode()
    if mymapcode ~= Constant.MAP_CODE.ALTAROFBLOOD then return end
    local altarBloodNpc = MapModule:getAltarBloodNpc()
    for i = 1, #altarBloodNpc do
        local npcId = tonumber(altarBloodNpc[i])
        local agent = worldAgent:getNpcAgentById(npcId)
        if agent then
            agent:setNpcVisible(false)
            agent:visibleActor(false)
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_NPC_DISAPPEAR, {npcId = npcId})
        end
    end
    self:createTeleportation()
end

--生成传送阵
function MapActor:createTeleportation()
    local worldAgent = lt.AgentManager:getWorldAgent()
    local myMapMeta = worldAgent:getMapAgent():getMapMeta()
    local mymapcode = myMapMeta:getMapCode()
    local race = GameModule:getHeroData():getRace()
    local meta = nil
    if mymapcode == Constant.MAP_CODE.GATEOFALTAR then
        local taskData = TaskModule:getTaskById(Constant["ADVANCE_TASK"..race].DYEING)
        local isComplete = TaskModule:checkTaskComplete(taskData)
        if not isComplete then
            if self._blackSprites == nil then
                return
            end
            local altarGatePos = MapModule:getAltarGatePos()
            if #altarGatePos ~= table.nums(self._blackSprites) then
                return
            end
        end
        local missionMeta = lt.CacheManager:getMissionMeta(Constant["ADVANCE_TASK"..race].DYEING)
        local target = missionMeta:getMissionTarget()[1][2]
        meta = lt.CacheManager:getGateOfAltarMeta(target)
    elseif mymapcode == Constant.MAP_CODE.ALTAROFBLOOD then
        local taskData = TaskModule:getTaskById(Constant["ADVANCE_TASK"..race].HOSTAGE)
        local isComplete = TaskModule:checkTaskComplete(taskData)
        local altarBloodNpc = MapModule:getAltarBloodNpc()
        local missionMeta = lt.CacheManager:getMissionMeta(Constant["ADVANCE_TASK"..race].HOSTAGE)
        local target = missionMeta:getMissionTarget()[1][2]
        meta = lt.CacheManager:getAltarOfBloodMeta(target)
        local dungeonTarget = meta:getDungeonTarget()
        if not isComplete then
            local maxNum = 0
            for i = 1, #dungeonTarget do
                if dungeonTarget[i][1] == race then
                    maxNum = maxNum + 1
                end
            end
            if #altarBloodNpc ~= maxNum then
                return
            end
        else
            for i = 1, #dungeonTarget do
                if dungeonTarget[i][1] == race then
                    local npcId = dungeonTarget[i][2]
                    local agent = worldAgent:getNpcAgentById(npcId)
                    if agent then
                        agent:visibleActor(false)
                        agent:setNpcVisible(false)
                        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_NPC_DISAPPEAR, {npcId = npcId})
                    end
                end
            end
        end
    end
    if meta == nil then return end
    local zone = meta:getLeaveZone()
    local m = zone[2]
    local n = zone[3]
    --创建传送阵特效
    local effectMeta = lt.EffectMeta.new({
        SkillId          = 0,
        OrderId          = 1,
        EffectSpriteType = 1185,
        BltType          = 1,
        Step             = 0.07,
        DelayFrame       = 0,
        Owner            = 0,
        LoopCount        = 1
    })
    local effectActor = lt.CompEffectActor.new(effectMeta, 1, true)
    effectActor:setPosition(MapUtil:calcMNMid(m, n))
    self:addChild(effectActor)
end

--副本失败
function MapActor:onDungeonFailed(event)
    local race = GameModule:getHeroData():getRace()
    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTaskTalk", missionId = race})
end

--多重虚影节点
function MapActor:addPhantom(node)
    if node then
        self._heroShadowNode:addChild(node)
    end
end

function MapActor:drawClickMark(x, y)
    -- 特效
    self:clearClickMark()
    if self._armatureAni == nil then
        -- 加载精灵表
        cc.SpriteFrameCache:getInstance():addSpriteFrames("ui/game/spritesheet.plist", "ui/game/spritesheet.png")

        local frames = {}
        for i = 1, 3 do
            local frameName = string.format("%d.png", i)
            local frame = cc.SpriteFrameCache:getInstance():getSpriteFrame(frameName)
            table.insert(frames, frame)
        end

        local animation = cc.Animation:createWithSpriteFrames(frames, 0.14)
        local animate = cc.Animate:create(animation)

        self._armatureAni = cc.Sprite:createWithSpriteFrame(frames[1])
        self._armatureAni:runAction(cc.RepeatForever:create(animate))
        self:addMoveMarkActor(self._armatureAni)
    end
    self._armatureAni:setPosition(x, y)
    self._armatureAni:setVisible(true)
end

function MapActor:clearClickMark()
    if self._armatureAni then
        self._armatureAni:setVisible(false)
    end
end

--与角色距离<=1隐藏点击特效
function MapActor:checkClickMark()
    if self._armatureAni then
        local heroAgent = lt.AgentManager:getHeroAgent()
        if heroAgent then
            local mHero, nHero = heroAgent:getPosition()
            local disX = mHero - self._armatureAni:getPositionX()
            local disY = nHero - self._armatureAni:getPositionY()
            local dis = math.sqrt(disX * disX + disY * disY)
            if dis <= MaxRange then
                self:clearClickMark()
            end
        end
    end
end

-- 下陨石特效
function MapActor:repeatShakeEffect()

    local function onNpcVampireLairSkill()
        -- 陨石术 没有伤害 纯表现
        local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
        if not heroAgent then
            return
        end
        for i = 1, 10 do
            local targetM, targetN = heroAgent:getMNExactly()
            targetM = targetM + math.random(-15,15)
            targetN = targetN + math.random(-10,10)
            local endX, endY = lt.MapUtil:calcMNMid(targetM, targetN)
            local startY = endY + 500
            local startX = endX + 150
            local bullet = lt.BulletSnowEffect.new(lt.SkillEnum.SKILL_MAGIC_METEOR, cc.p(startX, startY), cc.p(endX, endY), 2)

            local worldAgent = lt.AgentManager:getWorldAgent()
            if not worldAgent then
                return nil
            end
            local mapAgent = worldAgent:getMapAgent()
            if not mapAgent then
                return nil
            end
            local mapActor = mapAgent:getMapActor()
            if not mapActor then
                return nil
            end
            mapActor:addChild(bullet, 100000)
            lt.BulletManager:addBullet(bullet)
        end
    end
    -- 下陨石
    local delayAction = cc.Sequence:create(cc.DelayTime:create(0.8),cc.CallFunc:create(onNpcVampireLairSkill))
    self:runAction(cc.Repeat:create(delayAction, 10))
end

return MapActor