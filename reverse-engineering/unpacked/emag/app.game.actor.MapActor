    end

    if MapUtil:IsBlockUnderground(block) then
        self:drawBlockImg(m, n,"debug/under.png", tileIndex)
    end

    if MapUtil:IsBlockGround(block) then
        self:drawBlockImg(m, n,"debug/ground.png", tileIndex)
    end

    if MapUtil:IsBlockFlying(block) then
        self:drawBlockImg(m, n,"debug/flying.png", tileIndex)
    end

    -- mapTile:getBlock()
