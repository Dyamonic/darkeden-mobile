function MapActor:addChatMsg(event)
    local param = event.param
    local state = param.state or 0
    local waveCount = param.waveCount or 0
    local myMapMeta = lt.AgentManager:getWorldAgent():getMapAgent():getMapMeta()
    local mymapcode = myMapMeta:getMapCode()
    local npcMap = nil
    if state == 1 then
        local npcMapStr = lt.CacheManager:getMasterSummonSayTable(mymapcode)
        if not npcMapStr or not npcMapStr[waveCount] then
            return
        end
        npcMap = {npcMapStr[waveCount]}
    elseif state == 2 then
        npcMap = lt.CacheManager:getMasterDeadTable(mymapcode)
    else
        return
    end
    if not npcMap then
        return
    end
    local strings = npcMap
    local m = param.m
    local n = param.n
    local x, y = lt.MapUtil:calcMNMid(m, n)
    local heroAgent = lt.AgentManager:getHeroAgent()
    if not heroAgent then
        return
    end

    if not self._chatBg then
        self._chatBg = display.newSprite("game/common/bg_gsp_kuang.png", 0, 0,
            { scale9 = true, capInsets = cc.rect(6, 31, 214, 61) })
        self._chatNode:addChild(self._chatBg)
    end

    if not self._chatLabel then
        self._chatLabel = lt.LabelEx.new("",
            { font = Constant.FONT_4, size = 15, color = cc.c3b(255, 255, 255), outline = true, outlineColor = cc.c3b(0,
                0, 0) })
        self._chatBg:addChild(self._chatLabel)
    end
    self._chatBg:setAnchorPoint(0.5, 0)
    self._chatBg:setPosition(50, 0)
    self._chatLabel:setDimensions(214, 0)
    self._chatLabel:setAnchorPoint(0, 0)
    self._chatLabel:setVisible(true)
    self._chatBg:setVisible(true)
    self._chatLabel:stopAllActions()
    y = y + 80
    self._chatNode:setPosition(x, y)
    -- 当前显示的字符串索引
    local currentIndex = 1

    -- 创建一个函数来更新 Label 的文本
    local function updateLabel()
        if currentIndex <= #strings then
            yflog:Info("---------strings-"..strings[currentIndex])
            self._chatLabel:setString(strings[currentIndex]) -- 更新 Label 文本
            local height = self._chatLabel:getContentSize().height
            self._chatBg:setContentSize(cc.size(228, 28 + height))
            self._chatLabel:setPosition(8, 22)
            currentIndex = currentIndex + 1 -- 移动到下一个字符串
        else
            self:hideChatLabel()
        end
    end

    updateLabel()
    -- 创建动作序列
    local function createSequence()
        return cc.Sequence:create(
            cc.DelayTime:create(2),                         -- 延迟 5 秒
            cc.CallFunc:create(updateLabel),                -- 更新 Label 文本
            cc.CallFunc:create(function()
                self._chatLabel:runAction(createSequence()) -- 如果还有字符串未显示，重新运行序列
            end)
        )
    end

    -- 开始执行动作（从第二个字符串开始）
    self._chatLabel:runAction(createSequence())
end


function MapActor:hideChatLabel()
    if self._chatLabel then
        self._chatLabel:setString("")
        self._chatLabel:stopAllActions()
        self._chatLabel:setVisible(false)
    end
    if self._chatBg then
        self._chatBg:setVisible(false)
    end
end

-- 同步更新坐标(x,y为自己角色的坐标)
function MapActor:updateDraw(x, y)
    local m, n = lt.MapUtil:calcTileMN(x, y)
    local bm, bn = lt.MapUtil:calcMN(x, y)

    self:updateTile(m, n)

    self:updateObject(bm, bn)

    self._mCur = m
    self._nCur = n
end

-- m -> x, n -> y 根据256计算得出的m,n title(m,n)
function MapActor:updateTile(m, n)
    local update = false
    -- local col = math.max(12 , math.ceil(15 / self._scale))
    -- local row = math.max(10, math.ceil(12 / self._scale))

    -- 以m,n为基点，没半面加载的资源数量(x列 与 y行)
    local col = math.max(6 , math.ceil(6 / self._scale))
    local row = math.max(3, math.ceil(3 / self._scale))
    
    
    local mL = m - col  -- 左边
    local mR = m + col  -- 右边
    local nT = n + row  -- 上边
    local nB = n - row  -- 下边

    -- 第一次加载，先赋值镜头Rect为m,n 
    if not self._mLTile or not self._mRTile or not self._nTTile or not self._nBTile then
        self._mLTile = m
        self._mRTile = m
        self._nTTile = n
        self._nBTile = n

        self:drawTileMN(m, n)
        update = true
    end

    -- 窗口参数错误修正
    if mL > self._mRTile or mR < self._mLTile or nT  < self._nBTile or nB > self._nTTile then
        -- 显示窗口与原先区域完全不重合 移除当前所有土块
        print("地图跳跃")
        for m=self._mLTile, self._mRTile do
            for n=self._nBTile, self._nTTile do
                self:removeTileMN(m, n)
            end
        end

        self._mLTile = m
        self._mRTile = m
        self._nTTile = n
        self._nBTile = n

        self:drawTileMN(m, n)
        update = true
    end

    local mLNew = self._mLTile
    local mRNew = self._mRTile
    local nTNew = self._nTTile
    local nBNew = self._nBTile

    -- 逐步以当前m,n为中心，向外扩散加载title图片资源
    if mL > self._mLTile then
        mLNew = mLNew + 1
        update = true

    elseif mL < self._mLTile then
        mLNew = mLNew - 1
        update = true

    end

    if mR < self._mRTile then
        mRNew = mRNew - 1
        update = true

    elseif mR > self._mRTile then
        mRNew = mRNew + 1
        update = true

    end

    if nT < self._nTTile then
        nTNew = nTNew - 1
        update = true

    elseif nT > self._nTTile then
        nTNew = nTNew + 1
        update = true

    end

    if nB > self._nBTile then
        nBNew = nBNew + 1
        update = true

    elseif nB < self._nBTile then
        nBNew = nBNew - 1
        update = true

    end

    if update then
        if mLNew > self._mLTile then
            for n=self._nBTile, self._nTTile do
                self:removeTileMN(self._mLTile, n)
            end

        elseif mLNew < self._mLTile then
            for n=nBNew, nTNew do
                self:drawTileMN(mLNew, n)
            end

        end

        if mRNew < self._mRTile then
            for n=self._nBTile, self._nTTile do
                self:removeTileMN(self._mRTile, n)
            end

        elseif mRNew > self._mRTile then
            for n=nBNew, nTNew do
                self:drawTileMN(mRNew, n)
            end

        end

        if nTNew < self._nTTile then
            for m=self._mLTile, self._mRTile do
                self:removeTileMN(m, self._nTTile)
            end

        elseif nTNew > self._nTTile then
            for m=mLNew, mRNew do
                self:drawTileMN(m, nTNew)
            end

        end

        if nBNew > self._nBTile then
            for m=self._mLTile, self._mRTile do
                self:removeTileMN(m, self._nBTile)
            end
        elseif nBNew < self._nBTile then
            for m=mLNew, mRNew do
                self:drawTileMN(m, nBNew)
            end
        end

        self._mLTile = mLNew
        self._mRTile = mRNew
        self._nTTile = nTNew
        self._nBTile = nBNew


        -- print("drawTile L:",mLNew,"R:", mRNew, "B:", nBNew, "T:", nTNew)
    end
end

-- 以当前m,n为中心，逐步向外扩散加载title图片资源
function MapActor:calcExpansionTitle(newValue, curValue, range)
    local update = false
    if range > curValue then
        newValue = newValue + 1
        update = true

    elseif range < curValue then
        newValue = newValue - 1
        update = true
    end

    return newValue, update
end

-- 根据格子大小计算出的m,n
function MapActor:updateObject(m, n)
    local update = false
    local col = math.max(10 , math.ceil(15 / self._scale))
    local col2 = math.ceil(col * 3.33)
    local row = math.max(8, math.ceil(15 / self._scale))

    local mL = m - row
    local mR = m + row

    local nT = n + col2
    local nB = n - col

    if not self._mLObj or not self._mRObj or not self._nTObj or not self._nBObj then
        self._mLObj = m
        self._mRObj = m
        self._nTObj = n
        self._nBObj = n

        self:drawObjectMN(m, n)
        update = true
    end

    if mL > self._mRObj or mR < self._mLObj or nT  < self._nBObj or nB > self._nTObj then
        -- 显示窗口与原先区域完全不重合 移除当前所有土块
        print("地图跳跃")
        for m=self._mLObj, self._mRObj do
            for n=self._nBObj, self._nTObj do
                self:removeTileMN(m, n)
                self:removeBlockMN(m, n)
            end
        end

        self._mLObj = m
        self._mRObj = m
        self._nTObj = n
        self._nBObj = n

        self:drawObjectMN(m, n)
        update = true
    end

    local mLNew = self._mLObj
    local mRNew = self._mRObj
    local nTNew = self._nTObj
    local nBNew = self._nBObj

    if mL > self._mLObj then
        mLNew = mLNew + 1
        update = true

    elseif mL < self._mLObj then
        mLNew = mLNew - 1
        update = true

    end

    if mR < self._mRObj then
        mRNew = mRNew - 1
        update = true

    elseif mR > self._mRObj then
        mRNew = mRNew + 1
        update = true

    end

    if nT < self._nTObj then
        nTNew = nTNew - 1
        update = true

    elseif nT > self._nTObj then
        nTNew = nTNew + 1
        update = true

    end

    if nB > self._nBObj then
        nBNew = nBNew + 1
        update = true

    elseif nB < self._nBObj then
        nBNew = nBNew - 1
        update = true

    end

    if update then
        if mLNew > self._mLObj then
            for n=self._nBObj, self._nTObj do
                self:removeObjectMN(self._mLObj, n)
            end
        elseif mLNew < self._mLObj then
            for n=nBNew, nTNew do
                self:drawObjectMN(mLNew, n)
            end
        end

        if mRNew < self._mRObj then
            for n=self._nBObj, self._nTObj do
                self:removeObjectMN(self._mRObj, n)
            end
        elseif mRNew > self._mRObj then
            for n=nBNew, nTNew do
                self:drawObjectMN(mRNew, n)
            end
        end

        if nTNew < self._nTObj then
            for m=self._mLObj, self._mRObj do
                self:removeObjectMN(m, self._nTObj)
            end

        elseif nTNew > self._nTObj then
            for m=mLNew, mRNew do
                self:drawObjectMN(m, nTNew)
            end

        end

        if nBNew > self._nBObj then
            for m=self._mLObj, self._mRObj do
                self:removeObjectMN(m, self._nBObj)
            end

        elseif nBNew < self._nBObj then
            for m=mLNew, mRNew do
                self:drawObjectMN(m, nBNew)
            end

        end

        self._mLObj = mLNew
        self._mRObj = mRNew
        self._nTObj = nTNew
        self._nBObj = nBNew
        -- print("drawObject L:",mLNew,"R:", mRNew, "B:", nBNew, "T:", nTNew)
    end
end

-- 绘制地图图片(256*256)
function MapActor:drawTileMN(mIndex, nIndex)
    -- yflog:Info("mIndex=%d nIndex=%d",mIndex, nIndex)
    if mIndex < 0 or nIndex < 0 then
        return
    end

    -- yflog:Info("mIndex=%d nIndex=%d",mIndex, nIndex)

    local tileIndex = lt.MapUtil:calcMNIndex(mIndex, nIndex)
    if not self._curTileIndexTable[tileIndex] then
        self._curTileIndexTable[tileIndex] = true

        -- 验证m,n是否合法
        local ok = self:check256Title(mIndex, nIndex)
        if ok then
            -- 绘制256图片
            self:draw256Tile(mIndex, nIndex, tileIndex)
        end
    end
end

-- 验证m,n是否合法
function MapActor:check256Title(m, n)
    local mIndex,nIndex = math.floor(m*lt.Constant.MAP_TILE_SIZE / lt.Constant.MAP_BLOCK_WIDTH), math.floor(n*lt.Constant.MAP_TILE_SIZE / lt.Constant.MAP_BLOCK_HEIGHT)
    return self._mapData:getMapTile(mIndex, nIndex)
end

function MapActor:removeTileMN(mIndex, nIndex)
    local tileIndex = lt.MapUtil:calcMNIndex(mIndex, nIndex)
    if self._curTileIndexTable[tileIndex] then
        local spriteArray = self._curTileTable[tileIndex]
        if spriteArray then
            for _, sprite in ipairs(spriteArray) do
                lt.PoolManager:pushSprite(sprite)
                sprite:removeSelf()
            end
        end

        -- local spriteArray = self._curTileAnimationTable[tileIndex]
        -- if spriteArray then
        --     for _, sprite in ipairs(spriteArray) do
        --         sprite:removeSelf()
        --     end
        -- end

        self._curTileTable[tileIndex] = nil
        -- self._curTileAnimationTable[tileIndex] = nil
        self._curTileIndexTable[tileIndex] = nil
    end
end

-- 绘制阻挡点 (测试用) TEST BLOCK
function MapActor:drawTitleMBBlock(mIndex, nIndex)
    if mIndex < 0 or nIndex < 0 then
        return
    end
    
    local blockIndex = lt.MapUtil:calcMNIndex(mIndex, nIndex)
     if not self._curBlockIndexTable[blockIndex] then
        self._curBlockIndexTable[blockIndex] = true

        local mapTile = self._mapData:getMapTile(mIndex, nIndex)
        if mapTile then
            self:drawBlock(mIndex, nIndex, blockIndex, mapTile)
        end
    end
end

function MapActor:removeBlockMN(mIndex, nIndex)
    local tileIndex = lt.MapUtil:calcMNIndex(mIndex, nIndex)
    if self._curBlockIndexTable[tileIndex] then
        local spriteArray = self._curBlockTable[tileIndex]
        if spriteArray then
            for _, sprite in ipairs(spriteArray) do
                lt.PoolManager:pushSprite(sprite)
                sprite:removeSelf()
            end
        end

        self._curBlockTable[tileIndex] = nil
        self._curBlockIndexTable[tileIndex] = nil
    end
end

function MapActor:drawObjectMN(mIndex, nIndex)
    -- 测试时可以打开
    -- self:drawTitleMBBlock(mIndex, nIndex)

    local heroActor = self:getSelfActor()

    local objectIndex = lt.MapUtil:calcMNIndex(mIndex, nIndex)
    -- 当前格子是否被加载过object
    if not self._curObjectIndexTable[objectIndex] then
        self._curObjectIndexTable[objectIndex] = true

        local imgObjList = self._mapData:getMapImageObjectList(mIndex, nIndex)
        if #imgObjList > 0 then
            self:drawImageObject(objectIndex, imgObjList, heroActor)
        end
    end
end

function MapActor:removeObjectMN(mIndex, nIndex)
    local objectIndex = lt.MapUtil:calcMNIndex(mIndex, nIndex)
    if self._curObjectIndexTable[objectIndex] then
        local imgObjList = self._mapData:getMapImageObjectList(mIndex, nIndex)
        if #imgObjList > 0 then
            self:removeImageObject(mIndex, nIndex, objectIndex, imgObjList)
        end

        -- 资源缓存 
        -- local objectSprite = self._curObjectTable[objectIndex]
