        --     lt.PoolManager:pushSprite(objectSprite)
        --     objectSprite:removeSelf()
        -- end

        -- local objectAnimation = self._curObjectAnimationTable[objectIndex]
        -- if objectAnimation then
        --     objectAnimation:removeSelf()
        -- end

        -- self._curObjectTable[objectIndex] = nil
        -- self._curObjectAnimationTable[objectIndex] = nil
        self._curObjectIndexTable[objectIndex] = nil
    end
end

function MapActor:drawGridPos(m, n)
    local p = cc.p(m, n)
    local lab = lt.LabelEx.new(string.format("(%d,%d)", p.x, p.y), {font=lt.Constant.FONT_2, size=8, color=Constant.COLOR_TEXT_WHITE_PURE, outline=true, outlineColor=cc.c3b(0, 0, 0)})
    lab:setPosition(cc.p(p.x*48+24, -p.y*24-12))
    lab:setAnchorPoint(cc.p(.5, .5))
    self._drawNode:addChild(lab)
end

-- 画阻挡点
function MapActor:drawBlock(m, n, tileIndex, mapTile)
