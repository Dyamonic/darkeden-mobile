
local MapAnimation = class("MapAnimation", function()
    return display.newSprite()
end)

local ShaderBackendUtil = lt.ShaderBackendUtil
local Constant = lt.Constant
local MapModule = lt.MapModule
local GameModule = lt.GameModule
local TaskModule = lt.TaskModule

MapAnimation._mapAnimationInfo = nil

function MapAnimation:ctor()
end

function MapAnimation:setInfo(mapAnimationInfo)
    self._mapAnimationInfo = mapAnimationInfo

    self:updateAnimation(0)
end

function MapAnimation:updateAnimation(index)
    if not self._mapAnimationInfo then
        return
    end

    local texture = self._mapAnimationInfo:getTexture(index)
    if texture then
        self:initWithTexture(texture)
        self:setAnchorPoint(0, 1)
    end
end

