function MapActor:onHeroDie()
    local heroAgent = lt.AgentManager:getHeroAgent()
    if not heroAgent then
        return
    end

    if not self._maskSprite then
        -- 死亡遮罩
        self._maskSprite = display.newSprite("ui/common/img_black.png")
        self._maskSprite:setVisible(false)
        self._maskSprite:setScale(50)
        -- self._maskSprite:setBlendFunc({src=ccb.BlendFactor.DST_COLOR, dst=ccb.BlendFactor.ZERO})
        self._maskSprite:setOpacity(255 * 0.4)
        self._maskNode:addChild(self._maskSprite)
    end

    self._maskSprite:stopAllActions()
    local delayAction = cc.Sequence:create(cc.DelayTime:create(lt.Constant.ReviveShowTime),cc.CallFunc:create(function()
        self._maskSprite:setVisible(true)
    end))
    self._maskSprite:runAction(delayAction)
    self._maskNode:setPosition(heroAgent:getPosition())
end

function MapActor:onHeroRelive()
    if self._maskSprite then
        self._maskSprite:stopAllActions()
        self._maskSprite:setVisible(false)
        self._maskSprite = nil
    end
end

function MapActor:onClear()
    lt.NtfManager:removeNtfListenerByTag("MapActor:NTF_TOGGLE_BLOCK")
    lt.NtfManager:removeNtfListenerByTag("MapActor:NTF_HERO_DIE")
    lt.NtfManager:removeNtfListenerByTag("MapActor:NTF_HERO_RELIVE")
    lt.NtfManager:removeNtfListenerByTag("MapActor:NTF_DUNGEON_MONSTER_CHANGE")
    lt.NtfManager:removeNtfListenerByTag("MapActor:NTF_DUNGEON_ALTAR")
    lt.NtfManager:removeNtfListenerByTag("MapActor:NTF_DUNGEON_BLOOD")
    lt.NtfManager:removeNtfListenerByTag("MapActor:NTF_DUNGEON_FAIL")

    
    if self._maskSprite then
        self._maskSprite:stopAllActions()
        self._maskSprite = nil
    end
    if self._chatLabel then
        self._chatLabel:stopAllActions()
        self._chatLabel = nil
    end

    if self._armatureAni then
        self._armatureAni:stopAllActions()
        self._armatureAni = nil
    end
    self:stopAllActions()

    -- 将Sprite归还到PoolManager
    for _, spriteArray in pairs(self._curTileTable) do
        for _, sprite in ipairs(spriteArray) do
            lt.PoolManager:pushSprite(sprite)
        end
    end

    for _, spriteArray in pairs(self._curBlockTable) do
        for _, sprite in ipairs(spriteArray) do
            lt.PoolManager:pushSprite(sprite)
        end
    end

    for key, sprite in pairs(self._curObjectTable) do
        if sprite.spine then
            sprite.spine:removeSelf()
            sprite.spine = nil
        end

        lt.PoolManager:pushSprite(sprite)
    end

    if self._imageObjectIdTable then
        for _, imageObject in pairs(self._imageObjectIdTable) do
            imageObject:onClear()
        end

        self._imageObjectIdTable = nil
    end

    -- 移除MapAnimation
    -- for _,animationArray in pairs(self._curTileAnimationTable) do
    --     for _, animation in ipairs(animationArray) do
    --     end
    -- end

    -- for _, sprite in pairs(self._curObjectAnimationTable) do
    -- end

    -- 移除纹理
    -- for imageFilename,_ in pairs(self._imageTable) do
    --     display.removeImage(imageFilename)
    -- end
    -- self._imageTable = {}
    cc.Director:getInstance():getTextureCache():removeUnusedTextures()



    -- 清除弹道
    lt.BulletManager:onClear()
    lt.BulletSystem:onClear()
    self._tileNode:removeSelf()
    self._smTileNode:removeSelf()
    self._drawNode:removeSelf()
    self._safeAreaNode:removeSelf()
    self._routeNode:removeSelf()
    self._floorNode:removeSelf()
    self._itemNode:removeSelf()
    self._heroShadowNode:removeSelf()
    self._heroSkillNode:removeSelf()
    self._heroNode:removeSelf()
    self._mapDecorationNode:removeSelf()
    self._moveMarkNode:removeSelf()
    -- self._objectNode:removeSelf()
    -- self._alphaNode:removeSelf()
    self._maskNode:removeSelf()
    self._textNode:removeSelf()
    self._chatNode:removeSelf()
    self:removeSelf()

    self._curTileTable = nil
    self._curBlockTable = nil
    -- self._curTileAnimationTable = nil
    self._curTileIndexTable = nil
    self._curBlockIndexTable = nil
    self._curObjectTable = nil
    self._imageObjectIdTable = nil
    -- self._curObjectAnimationTable = nil
    self._curObjectIndexTable = nil

    self._heroActor = nil
    self._chatBg = nil
end

function MapActor:loadMap(mapData)
    -- 清理之前的地图内容
    for _, spriteArray in pairs(self._curTileTable) do
        for _, sprite in ipairs(spriteArray) do
            lt.PoolManager:pushSprite(sprite)
        end
    end

    for _, spriteArray in pairs(self._curBlockTable) do
        for _, sprite in ipairs(spriteArray) do
            lt.PoolManager:pushSprite(sprite)
        end
    end

    for key, sprite in pairs(self._curObjectTable) do
        -- 移除shader 不然使用过的图片会有黑色的阴影 来自于之前遮罩部分 不清除感觉
        if sprite ~= nil then
            if self._imageObjectIdTable[key] then
                ShaderBackendUtil:makeNodeToNormal(sprite)
            end
            if sprite then
                if sprite.spine then
                    sprite.spine:removeSelf()
                    sprite.spine = nil
                end
                lt.PoolManager:pushSprite(sprite)
            end
        end
    end

    if self._imageObjectIdTable then
        for i, imageObject in pairs(self._imageObjectIdTable) do
            imageObject:onClear()
        end
        
        self._imageObjectIdTable = nil
    end

    
    if self._maskSprite then
        self._maskSprite:stopAllActions()
        self._maskSprite = nil
    end
    if self._chatLabel then
        self._chatLabel:stopAllActions()
        self._chatLabel = nil
    end
    self:stopAllActions()


    -- for _, spriteArray in pairs(self._curTileAnimationTable) do
    --     for _, sprite in ipairs(spriteArray) do
    --     end
    -- end

    -- for _, sprite in pairs(self._curObjectAnimationTable) do
    -- end

    -- for imageFilename,_ in pairs(self._imageTable) do
    --     display.removeImage(imageFilename)
    -- end
    -- self._imageTable = {}
    cc.Director:getInstance():getTextureCache():removeUnusedTextures()
    self:clearClickMark()

    -- 清理之前的弹道表现
    lt.BulletManager:onClear()
    lt.BulletSystem:onClear()
    lt.MapManager:clear()

    if self._mapObjectTexture then
        self._mapObjectTexture:clear()
        self._mapObjectTexture = nil
    end

    self._curTileTable = {}
    self._curBlockTable = {}
    -- self._curTileAnimationTable = {}
    self._curTileIndexTable = {}
    self._curBlockIndexTable = {}
    self._curObjectTable = {}
    self._imageObjectIdTable = {}
    -- self._curObjectAnimationTable = {}
    self._curObjectIndexTable = {}
    self._mCur = nil
    self._nCur = nil
    self._mTileCount = nil
    self._mLTile = nil
    self._mRTile = nil
    self._nTTile = nil
    self._nBTile = nil
    self._mLObj = nil
    self._mRObj = nil
    self._nTObj = nil
    self._nBObj = nil
    self._heroActor = nil

    self._tileNode:removeAllChildren()
    self._heroNode:removeAllChildren()
    self._mapDecorationNode:removeAllChildren()
    -- self._moveMarkNode:removeAllChildren()
    self._smTileNode:removeAllChildren()
    self._safeAreaNode:removeAllChildren()
    --[[
    self._safeAreaNode = cc.DrawNode:create()
    self:addChild(self._safeAreaNode, 0)
    ]]
    self._safeAreaNode = display.newNode()
    self:addChild(self._safeAreaNode, 0)
    self._routeNode:removeAllChildren()
    self._floorNode:removeAllChildren()
    self._itemNode:removeAllChildren()
    self._heroShadowNode:removeAllChildren()
    self._heroSkillNode:removeAllChildren()
    -- self._heroNode:removeAllChildren()
    -- self._objectNode:removeAllChildren()
    -- self._alphaNode:removeAllChildren()
    self._maskNode:removeAllChildren()
    self._textNode:removeAllChildren()
    self._drawNode:removeAllChildren()
    self._chatNode:removeAllChildren()

    -- 设置新地图
    self._mapCode = self._mapMeta:getResCode()
    self._mapObjectTexture = lt.MapObjectTexture.new(self._mapCode)

    self._mapData = mapData
    self:initMTitleCount(mapData)

    -- 屏蔽地图红线
    if DEBUG > 1 then
        self:drawGrid()
    end
    -- self:drawGridPos(mapData)
end

function MapActor:initMTitleCount(mapData)
     local mCount = mapData:getMCount()
    -- local nCount = mapData:getNCount()
    local nWidth = 48 * mCount;
    -- local nHeight = 32 * nCount;
    -- 此处需要四舍五入
    self._mTileCount = math.floor((nWidth/256)+0.495) + (nWidth%256 == 0 and 0 or 1)
    if self._mapMeta and self._mapMeta:getResCode() == "1102" then
        self._mTileCount = 26
    end
    -- yflog:Info("*****************mCount:%s, nWidth: %s self._mTileCount = %s math.ceil(nWidth / 256):%02f nWidth256:%s", mCount, nWidth, self._mTileCount, math.ceil(nWidth / 256), (nWidth%256 == 0 and 0 or 1))
end

function MapActor:setMapMeta(mapMeta)
    self._mapMeta = mapMeta
end

function MapActor:getMapCode()
    if not self._mapMeta then
        return -1
    end

    return self._mapMeta:getMapCode()
end

-- 添加自己
function MapActor:setSelfHeroActor(heroActor)
    self._heroActor = heroActor
end

--[[
    添加 actor
]]
-- 添加 英雄Actor 
function MapActor:addHeroActor(heroActor)
    if heroActor:getSkillActor() then
        self._heroSkillNode:addChild(heroActor:getSkillActor())
    end
    if heroActor:getOpacitySkillActor() then
        self._heroSkillOpacityNode:addChild(heroActor:getOpacitySkillActor())
    end

    if heroActor:getShadowActor() then
        self._heroShadowNode:addChild(heroActor:getShadowActor())
    end
   
    self._heroNode:addChild(heroActor)
    -- self._alphaNode:addChild(heroActor:getNodeAlpha())
    self._textNode:addChild(heroActor:getNameNode())

    self._eyeMaskNode:addChild(heroActor:getEyeMaskNode())
end

-- 怪物Actor 
function MapActor:addMonsterActor(monsterActor)
    if monsterActor:getShadowActor() then
        self._heroShadowNode:addChild(monsterActor:getShadowActor())
    end

    self._heroNode:addChild(monsterActor)
    if monsterActor:getNameNode() then
        self._textNode:addChild(monsterActor:getNameNode())
    end
end

-- 单独添加怪物阴影Actor
function MapActor:addMonsterShadowActor(monsterShadowActor)
    if monsterShadowActor then
        self._heroShadowNode:addChild(monsterShadowActor)
    end
end

-- 陷阱Actor
function MapActor:addTrapActor(trapActor)
    -- if trapActor:isSole() then  -- 地板trap显示在脚底
    --     self._heroSkillNode:addChild(trapActor)
    -- else
    self._heroNode:addChild(trapActor)
    -- end
