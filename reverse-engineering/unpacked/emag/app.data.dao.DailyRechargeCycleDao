
local DailyRechargeCycleDao = {}

function DailyRechargeCycleDao:queryById(cycleId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM DailyRechargeCycle WHERE CycleId=%d ;", cycleId)) do
    	local cycleInfo = lt.DailyRechargeCycleMeta.new(row)
        return cycleInfo
    end
end

return DailyRechargeCycleDao