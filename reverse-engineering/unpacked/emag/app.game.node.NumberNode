function NumberNode:setRollNumber(number, time)
    time = time or 2

    self._iTargetNum = number
    self._iMoveTime = time

    local iMoveNum = self._iTargetNum - self._iCurrentNum
    if self._iMoveDiretion then
        if self._iTargetNum < self._iCurrentNum then
            iMoveNum = self._iCurrentNum + 10 - self._iTargetNum
            self._iTargetNum = self._iTargetNum + 10
        end
    else
        if self._iCurrentNum == 0 then
            iMoveNum = 10 - self._iTargetNum
            self._iTargetNum = self._iTargetNum - 10
        elseif self._iTargetNum > self._iCurrentNum then
            iMoveNum = self._iCurrentNum + 10 - self._iTargetNum
            self._iTargetNum = self._iTargetNum - 10
        end
    end

    local delta = math.abs(iMoveNum) --计算数字间隔
    self._iUpdateSpeed = (delta * self._iFontHight / self._iMoveTime) / self._iMoveRatio
end

function NumberNode:getNumber()
    return math.abs(self._iCurrentNum % 10) 
end

function NumberNode:updateNumber()
    if (self._iCurrentNum ~= self._iTargetNum) then  --如果当前显示的数字不等于目标数字，即要开始滚动
        local dis = self._iUpdateSpeed                --每次调用update函数需要滚动的距离等于update_speed 乘以 d （update_speed在setRollNumber函数中已经算出） 
        if self._iMoveDiretion then
            self._node:setPositionY(self._node:getPositionY() + dis)--每次使整条向下移动dis距离
            self._iUpdateMoveSum = self._iUpdateMoveSum + dis--update_moveSum 用于保存现在到底移动了多少距离
            if (self._iUpdateMoveSum >= self._iFontHight) then --如果现在已经移动了一个字大小的距离
                --每移动一次累加1
                self._iCurrentNum = self._iCurrentNum + 1
                --对10求余是为了在每次达到10后从新开始新循环
                self._iUpdateMoveSum = self._iUpdateMoveSum - self._iFontHight
                local iMathNum = (self._iCurrentNum % 10)
                if iMathNum == 0 then
                    local iMovePosy = -(10 - iMathNum) * self._iFontHight
                    self._node:setPositionY(iMovePosy)
                    self._iUpdateMoveSum = 0
                end

                --变化了一格 首位0可以显示了
                self:onUpdateZeroView(true)
            end
        else
            self._node:setPositionY(self._node:getPositionY() - dis)--每次使整条向下移动dis距离
            self._iUpdateMoveSum = self._iUpdateMoveSum + dis--update_moveSum 用于保存现在到底移动了多少距离
            if (self._iUpdateMoveSum >= self._iFontHight) then --如果现在已经移动了一个字大小的距离
                --每移动一次累加1
                self._iCurrentNum = self._iCurrentNum - 1
                --对10求余是为了在每次达到10后从新开始新循环
                --负数表示向下移,标准对齐位置 self._node:setPositionY(- (self._iCurrentNum % 10) * self._iFontHight);
                self._iUpdateMoveSum = self._iUpdateMoveSum - self._iFontHight
                local iMathNum = (self._iCurrentNum % 10)
                if iMathNum == 0 then
                    local iMathNum = (self._iCurrentNum % 10)
                    self._node:setPositionY(iMathNum * self._iFontHight)
                    self._iUpdateMoveSum = 0
                end

                --变化了一格 首位0可以显示了
                --首位变化到0 是否需要显示
                self:onUpdateZeroView(true)
            end
        end
    else --每次移动距离不等。 需要重新设置位置
        if self._iMoveDiretion then --使用上面的
            local iMathNum = (self._iCurrentNum % 10)
            local iMovePosy = -(10 - iMathNum) * self._iFontHight
            self._node:setPositionY(iMovePosy)
        else
            local iMathNum = (self._iCurrentNum % 10)
            self._node:setPositionY(self._iFontHight * iMathNum)
        end
    end
end

return NumberNode