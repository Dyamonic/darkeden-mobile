local NumberNode = class("NumberNode", lt.UIWidget)

local ResManager = lt.ResManager

function NumberNode:ctor(iInitNumber, isFirstZero, isZeroHide)
    NumberNode.super.ctor(self)

    self._isFirstShow = not isFirstZero      --首位0是否隐藏
    self._isZeroHide = isZeroHide or false   --变化到0是否隐藏

    self:initData(iInitNumber)
    self:initUI()
end

function NumberNode:onClear()
    -- self._node:removeAllChildren()
    -- self:initData()
end

function NumberNode:initUI()
    self._node = display.newNode()
    self._node:setPosition(0, 0)
    self:addChild(self._node)

    self._node1 = display.newNode()
    self._node1:setPosition(0, 0)
    self._node:addChild(self._node1)

    self._node2 = display.newNode()
    self._node2:setPosition(0, 0)
    self._node:addChild(self._node2)

    self._tZeroText = {}
    local fontHight = self._iFontHight
    for i=0,9 do
        local labNum = i
        local lableText = cc.Label:createWithBMFont("font/chs/fightNumber.fnt", labNum, cc.TEXT_ALIGNMENT_CENTER)
        lableText:setAnchorPoint(0, 0)
        lableText:setPosition( 0, -fontHight * i)
        -- lableText:setAdditionalKerning(-30)
        self._node1:addChild(lableText)
        self._labText[#self._labText+1] = lableText

        -- local iw = lableText:getContentSize().width --29
        -- local ih = lableText:getContentSize().height --32
        if i == 0 then
            self._tZeroText[1] = lableText
        end
    end
    --滚动交接时避免无内容的bug
    local iPosy = fontHight * 10 
    for i=0,9 do
        local labNum = i
        local lableText = cc.Label:createWithBMFont("font/chs/fightNumber.fnt", labNum, cc.TEXT_ALIGNMENT_CENTER)
        lableText:setAnchorPoint(0, 0)
        lableText:setPosition( 0, iPosy-fontHight * i)
        self._node2:addChild(lableText)

        if i == 0 then
            self._tZeroText[2] = lableText
        end
    end
end

function NumberNode:initData(iInitNum)
    self._iCurrentNum = iInitNum or 0 --当前值
    self._iTargetNum = 0  --目标值
    self._iUpdateSpeed = 0 --滚动速度
    self._iUpdateMoveSum = 0 --滚动距离
    self._iFontHight = 32    --字体高度
    self._iMoveTime = 2.0    --滚动时间
    self._iMoveRatio = 20    --滚动速度系数
    self._iMoveDiretion = true --滚动方向 true 向上

    self._labText = {}
end

function NumberNode:setMoveDiretion(moveUp)
    self._iMoveDiretion = moveUp

    self:onUpdateUI()
end

function NumberNode:onUpdateUI()
    --设置初始位置
    if self._iMoveDiretion then --使用上面的
        local iMathNum = (self._iCurrentNum % 10)
        local iMovePosy = -(10 - iMathNum) * self._iFontHight
        self._node:setPositionY(iMovePosy)
    else
        local iMathNum = (self._iCurrentNum % 10)
        self._node:setPositionY(self._iFontHight * iMathNum)
    end

    self:onUpdateZeroView(false)
end

