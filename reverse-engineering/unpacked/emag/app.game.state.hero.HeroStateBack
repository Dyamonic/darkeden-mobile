
-- 被冲撞
local HeroStateBack = class("HeroStateBack", lt.HeroStateBase)
local ActionManager = lt.ActionManager
local Constant = lt.Constant
local TimeTrigger = lt.TimeTrigger
local BuffEnum = lt.BuffEnum

HeroStateBack._mTarget       = nil
HeroStateBack._nTarget       = nil
HeroStateBack._xTarget       = nil
HeroStateBack._yTarget       = nil
HeroStateBack._needDisappear = nil
local MapUtil = lt.MapUtil

HeroStateBack._timeElapsed = nil

function HeroStateBack:ctor(heroAgent, mTarget, nTarget, needDisappear, skillId)
    HeroStateBack.super.ctor(self, heroAgent)

    self._needDisappear = needDisappear
    self._timeElapsed = 0
    self._moveX = 0
    self._moveY = 0
    self._stepX = 0
    self._stepY = 0
    self._skillId = skillId
    self._mTarget = mTarget
    self._nTarget = nTarget

    self._setFinal = false

    self._setOpen = false
    self:knockBackPosition(mTarget, nTarget, self._heroAgent:getActionId())
    
    self._timeTrigger = TimeTrigger.new(1 / Constant.FPS_TL)
    self._timeEnterBack = TimeTrigger.new(lt.GameBoard:getDeltaTime() * 2)
end

function HeroStateBack:onClear()
    HeroStateBack.super.onClear(self)
end

function HeroStateBack:onEnter()
    -- self._heroAgent:playAction(Constant.ROLE_ACTION_Hit)
end

function HeroStateBack:onExit()
end

function HeroStateBack:knockBackPosition(x, y, action)
    local oldX, oldY = self._heroAgent:getMNExactly()
    local newX = x
    local newY = y
    local oldPoint = cc.p(MapUtil:MapToPixel(oldX, oldY))
    local newPoint = cc.p(MapUtil:MapToPixel(newX, newY))
    if oldX == newX and oldY == newY then
        yflog:Info("相同坐标不执行")
        return 
    else
        local direction = MapUtil:getDirectionToPosition(newX, newY, oldX, oldY)
        self._heroAgent:setDirection(direction)
    end

    local count, step = ActionManager:getActorFrameCount(self._heroAgent:getHeroData():getModelName(), Constant.ACTION_DAMAGED, self._heroAgent:getDirection(),self._heroAgent:getTransformId(),self._heroAgent:getCurStepMultiple())
    self._heroAgent:setKnockBackCount(count) -- count 为 4

    -- 计算需要移动的像素数
    local gapX = newPoint.x - oldPoint.x 
    local gapY = newPoint.y - oldPoint.y 

    self._moveX = -gapX
    self._moveY = -gapY

    local knockBackCount = self._heroAgent:getKnockBackCount()
    self._stepX = gapX / knockBackCount
    self._stepY = gapY / knockBackCount
end

--进入点燃四连退
function HeroStateBack:enterForce()
    -- 最后一个点才开始算MN
    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
    mapAgent:changeAgentMN(self._heroAgent, self._mTarget, self._nTarget)

    --伤害特效
    lt.SkillManager:playParallelEffectByLv(self._skillId, self._heroAgent:getAgentId(),0, Constant.EFFECT.HIT)
end

function HeroStateBack:onUpdate()
    if self._timeEnterBack:tick() then
        if not self._setFinal then
            self._setFinal = true
            self:enterForce()
        end
    end
    if self._timeTrigger:tick() then
        if self._heroAgent:getKnockBackCount() > 0 then
            -- 执行击退
            self._moveX = self._moveX + self._stepX;
            self._moveY = self._moveY + self._stepY;

            yflog:Info("HeroStateBack:onUpdate()x:%s, y:%s s:%s c:%s", self._moveX, self._moveY, self._moveX, self._stepX)
            local xHero, yHero = self._heroAgent:getPosition()
            self._heroAgent:setPosition(xHero - self._moveX, yHero - self._moveY)
            self._heroAgent:subKnockBackCount()

            -- 剩下3次瓜分
            if not self._setOpen then
                self._moveX = -self._stepX;
                self._moveY = -self._stepY;
                self._stepX = self._stepX / 3
                self._heroAgent:playAction(Constant.ACTION_DAMAGED)
            end
            if self._heroAgent:getKnockBackCount() == 0 then
                self._moveX = 0;
                self._moveY = 0;
                self._heroAgent:changeState(lt.HeroStateIdle.new(self._heroAgent))
                return;
            end			
        end
        self._timeTrigger:reset()
    end
end

function HeroStateBack:onMessage(msg)

end

function HeroStateBack:getStateId()
    return Constant.HERO_STATE_BACK
end

function HeroStateBack:getStateName()
    return "HeroStateBack"
end

return HeroStateBack
