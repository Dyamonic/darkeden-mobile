---@class GameLayer 游戏层
local GameLayer = class("GameLayer", lt.UICompBase)
local WeatherType = lt.Constant.WEATHER_TYPE
local SoundDef = lt.SoundDef
local NtfManager = lt.NtfManager
local ScheduleUtil = lt.ScheduleUtil


function GameLayer:ctor(layerManager)
    GameLayer.super.ctor(self)
    self._view = fgui.UIPackage:createObject("Main", "GameLayer")
    self:addChild(self._view)

    self._layerManager = layerManager

    self._gameLayerBase = lt.GameLayerBase.new()
    self._view:makeFullScreen()
    self._view:displayObject():addChild(self._gameLayerBase)
    self._gameLayerBase:setPosition(0, 0)

    self._gameLayerUI = lt.GameLayerUI.new()
    self._view:displayObject():addChild(self._gameLayerUI, 2)

    self._gameLayerBase:setGameLayerUI(self._gameLayerUI)
    self._gameLayerUI:setGameLayer(self._gameLayerBase)

    self._previousSoundId = SoundDef.SOUNDID_NULL
    self._mWeather = lt.MWeather.new()
    self._weatherEffect = {}
    self._oldFirstZonePixel = cc.p(0, 0)
    self._sharkDelayTime = 0
end

function GameLayer:onClear()

    if self._scheculeHandler then
        ScheduleUtil:unscheduleGlobal(self._scheculeHandler)
        self._scheculeHandler = nil
    end

    self._view = nil
    self._gameLayerBase = nil
    self._gameLayerUI = nil
    self._mWeather = nil
    self._oldFirstZonePixel= nil
    self._weatherEffect = nil 
    GameLayer.super.onClear(self)
end

function GameLayer:onEnter()
    if not self._scheculeHandler then
        self._scheculeHandler = ScheduleUtil:scheduleUpdateGlobal(handler(self, self.onUpdate))
    end

    NtfManager:addNtfListener(NtfManager.NTF.NTF_WEATHER_UPDATE, handler(self, self.onSetWeather),
        "GameLayer:onSetWeather")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_EVENTFLAG_SHAKE_SCREEN, handler(self, self.onEventSharkScreen),
    "GameLayer:onEventSharkScreen")
end
function GameLayer:onExit()
    if self._scheculeHandler then
        ScheduleUtil:unscheduleGlobal(self._scheculeHandler)
        self._scheculeHandler = nil
    end

    NtfManager:removeNtfListenerByTag("GameLayer:onSetWeather")
    NtfManager:removeNtfListenerByTag("GameLayer:onEventSharkScreen")

    self:onClearWeatherEffect()
    self._oldFirstZonePixel = cc.p(0, 0)
end

function GameLayer:onUpdate(delta)
    if self._mWeather then
        self._mWeather:onAction()
    end

    self:activeWeather()

    if self._gameLayerBase then
        self._gameLayerBase:onUpdate(delta)
    end

    if self._layerManager then
        self._layerManager:onUpdate(delta)
    end

    lt.GameBoard:reset()
end

function GameLayer:onEventSharkScreen(event)
    self:getGameLayer():onEventSharkScreen(event)
end

function GameLayer:onClearWeatherEffect()
    for i, v in pairs(self._weatherEffect) do
        if v then
            v:removeFromParent()
            v = nil
        end
    end
    self._weatherEffect = {}
end

function GameLayer:onSetWeather(event)
    local data = event.param
    local weather = data.weather
    local level = data.level

    local previousWeather = weather
    -----------------------------------------------
    -- 이전의 날씨와 관련된 Sound를 없앤다.
    -----------------------------------------------
    -- TOOD
    -- StopSound( self._previousSoundId)

    yflog:Info("[Set Weather] %d, level = %d", weather, level)
    if (previousWeather == WeatherType.WEATHER_SPOT) then
        self._mWeather:onRelease()
    end
    self:onClearWeatherEffect()
    local cLevel = bit.lshift(level, 3)
    yflog:Info("cLevel", cLevel)
    if (weather == WeatherType.WEATHER_CLEAR) then
        self._mWeather:stop()
        self._previousSoundId = SoundDef.SOUNDID_NULL
    elseif (weather == WeatherType.WEATHER_RAINY) then
        self._mWeather:setRain(cLevel)
        self._previousSoundId = (level >= 15) and SoundDef.SOUND_WORLD_WEATHER_RAIN_2 or
        SoundDef.SOUND_WORLD_WEATHER_RAIN_1
        -- TOOD
        -- PlaySound( self._previousSoundId, true, g_pPlayer:GetX(), g_pPlayer:GetY() )
    elseif (weather == WeatherType.WEATHER_SNOWY) then
        self._mWeather:setSnow(cLevel)
        self._previousSoundId = SoundDef.SOUNDID_NULL
    elseif (weather == WeatherType.WEATHER_SPOT) then
        self._mWeather:setSpot(cLevel)
        self._previousSoundId = SoundDef.SOUNDID_NULL
    end

    previousWeather = weather
    yflog:Info("[Set Weather] OK")
end

-----------------------------------------------------------------------------
-- Set Lightning
-----------------------------------------------------------------------------
function GameLayer:onSetLightning(delay)
    yflog:Info("[Set Lightning]")

    -----------------------------------------------
    -- 번개 표현..
    -----------------------------------------------
    self:SetFadeStart(1, 31, 10, 31, 31, 31)

    -- 1초 안의 거리에 있으면.. THUNDER1
    -- 더 멀면 THUNDER2
    local sid = (delay <= 1000) and SoundDef.SOUND_WORLD_WEATHER_THUNDER_1 or SoundDef.SOUND_WORLD_WEATHER_THUNDER_2

    -- sound를 기억해뒀다가 나중에 출력한다.
    -- 添加到音效队列中TOODO
    -- local pNode = new SOUND_NODE( sid, delay, g_pPlayer:GetX(), g_pPlayer:GetY() )

    -- g_pZone:AddSound( pNode )
end

function GameLayer:activeWeather()
    if self._mWeather:isActive() then
        local m_FirstZonePixel = cc.p(0, 0)

        if self._mWeather:getWeatherType() == 3 then--  雪花速度慢 这边要加上人物行走的偏移量
             -- 边界不做偏移量
            local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
            if mapAgent and mapAgent:isCheckMapPosition() then
                m_FirstZonePixel = self._oldFirstZonePixel--cc.p(0, 0)
            else
                local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
                if not heroAgent then
                    return 
                end
                local startX, startY = heroAgent:getPosition()
                startY = startY + lt.Constant.MODEL_HIT_Y
                m_FirstZonePixel = cc.p(startX, -startY)
                self._oldFirstZonePixel = m_FirstZonePixel
            end
        end

        local gapX = (m_FirstZonePixel.x) % display.width
        local gapY = (m_FirstZonePixel.y) % display.height
        for i = 1, self._mWeather:getSize() do
            local MapEffect = self._mWeather:getMapEffects()[i]
            if MapEffect:isActive() then
                local point = {
                    x = MapEffect:GetX() - gapX,
                    y = MapEffect:GetY() - gapY
                }

                if point.x < 0 then
                    point.x = point.x + display.width
                elseif point.x > display.width then
                    point.x = point.x - display.width
                end

                if point.y < 0 then
                    point.y = point.y + display.height
                elseif point.y > display.height then
                    point.y = point.y - display.height
                end
                local path = string.format("ui://Main/weather_%s", MapEffect:GetSpriteID())

                if not self._weatherEffect[i] then
                    -- self._weatherEffect[i] = display.newSprite(path, point.x, point.y)
                    self._weatherEffect[i] = fgui.UIPackage:createObjectFromURL(path)
                    self:addChild(self._weatherEffect[i])
                end

                self._weatherEffect[i]:setPosition(point.x, point.y)
                if self._mWeather:getWeatherType() == lt.MWeather.WEATHER_TYPE.WEATHER_SPOT then
                    -- CSpriteSurface.SetEffect(CSpriteSurface.EFFECT_SCREEN_ALPHA)
                    -- CSpriteSurface.s_Value1 = MapEffect:GetCount() * 32 / MapEffect:GetMaxCount()
                    -- m_pSurface:BltSpriteEffect(point, m_WeatherSPK[MapEffect:GetSpriteID()])
                else
                    -- m_pSurface:BltSprite(point, m_WeatherSPK[MapEffect:GetSpriteID()])
                end
            else
                if self._weatherEffect[i] then
                    self._weatherEffect[i]:removeFromParent()
                    self._weatherEffect[i] = nil
                end
            end
        end
    end
end


function GameLayer:getGameLayer()
    return self._gameLayerBase
end


return GameLayer
