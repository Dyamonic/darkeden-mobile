function UIWndPetFeed:refreshSelect(item)
    if self._id then
        if self._item then
            self._item:setSelect(false)
        end
        self._item = item
        if self._item then
            self._item:setSelect(true)
        else
            self._id = nil
        end
    end
end

function UIWndPetFeed:onfeedBtnClick()
    if self._id == nil then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_STRENGTHEN_TIPS14})
        return
    end
    local canUse = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, self._id, 1, {tips = true})
    if not canUse then
        return
    end
    -- local uid = ItemModule:getUidById(self._id)
    local itemId = self._id
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {type = 2, content = GReadText.KEY_PET_TIPS32,
    confirmCallback = function()
        PetModule:sendPetFeed(self._petInfo, itemId)

    end})
    yflog:Info("UIWndPetFeed:onfeedBtnClick ---> %s",self._id)
end

function UIWndPetFeed:onReliveBtnClick()
    if self._id == nil then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_STRENGTHEN_TIPS14})
        return
    end
    local isDie = PetModule:isDie(self._petInfo.data:getDeadTime())
    if not isDie then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS68})
        return
    end
    local dieTime = PetModule:getDeadTime(self._petInfo.data:getDeadTime())
    if dieTime >= 7 and self._id == Constant.SEVEN_DAY_IN then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS72})
        return
    end
    local canUse = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, self._id, 1, {tips = true})
    if not canUse then
        return
    end
    --复活
    local petUid = self._petInfo.data:getUid()
    PetModule:sendPetRelive(petUid, self._id)
    yflog:Info("UIWndPetFeed:onReliveBtnClick ---> %s %s",isDie, self._id)
end

function UIWndPetFeed:onfeedSpecialClick()
    if self._id == nil then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_STRENGTHEN_TIPS14})
        return
    end
    local canUse = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, self._id, 1, {tips = true})
    if not canUse then
        return
    end
    -- local uid = ItemModule:getUidById(self._id)
    local itemMeta = ItemModule:getItemMetaByItemId(Constant.ItemType.ITEM_TYPE_PROP, self._id)
    local petStr = nil
    if itemMeta:getType() == Constant.PropTypeSub_10.DigSpeed then   -- 挖掘加速	  12
        petStr = GReadText.KEY_PET_TIPS73
    elseif itemMeta:getType() == Constant.PropTypeSub_10.AddLvl then -- 宠物直升丹	  13
        local effect = itemMeta:getEffectParam() or {}
        local petData = self._petInfo.data
        if effect and effect[1] and effect[1][1] == "Pet" then
            local level = tonumber(effect[1][2])
            if type(level) == "number" then
                if level <= petData:getLevel() then
                    petTipsStr = string.format(GReadText.KEY_PET_TIPS76, level)
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = petTipsStr})
                    return
                end
                petStr = string.format(GReadText.KEY_PET_TIPS74, level)   -- 使用提示
            end
        end
    elseif itemMeta:getType() == Constant.PropTypeSub_10.AddExp then -- 宠物经验加成 14
        petStr = GReadText.KEY_PET_TIPS84
    end
    
    local petUid = self._petInfo.data:getUid()
    local itemId = self._id
    if petStr then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {type = 2, content = petStr,
        confirmCallback = function()
            PetModule:sendPetUseItem(petUid, itemId)
        end})
    else
        PetModule:sendPetUseItem(petUid, self._id)
    end
    yflog:Info("UIWndPetFeed:onfeedSpecialClick ---> %s",self._id)
end

function UIWndPetFeed:renderFeedItem(index, obj)
    local param = self:getParam().param or {}
    local feedType = param.feedType
    local itemInfo = self._list[index + 1]
    obj:setInfo(itemInfo, feedType)
    obj:insertObjectToFactory(self)
end

function UIWndPetFeed:onClickItem(context)
    local param = self:getParam().param or {}
    local data = context:getData()
    local itemMeta = CacheManager:getItemMeta(data:getId())
    --如果重复选中显示tips
    if data:getId() == self._id then
        self:showTips(itemMeta)
        return
    end
    self._id = data:getId()
    self:refreshSelect(data)
    --宠物直升丹特殊显示
    if itemMeta:getKind() == Constant.PropType.PET_CULTIVATE and itemMeta:getType() == Constant.PropTypeSub_10.AddLvl then
        local effectParam = itemMeta:getEffectParam()
        self._levelLabel:setText(string.format(GReadText.KEY_PET_TIPS75, effectParam[1][2]))
        self._levelLabel:setVisible(true)
    else
        self._levelLabel:setVisible(false)
    end
end

function UIWndPetFeed:onCloseBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndPetFeed", close = true})
end

function UIWndPetFeed:showTips(itemMeta)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS, {itemInfo = itemMeta, tipsType = Constant.PROPTIPS_FORM.Display})
end

function UIWndPetFeed:checkGuide()
    --宠物喂养引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.PETFEED5) then
        local pos = self:displayObject():convertToWorldSpace(self._itemList:getPosition())
        GuideModule:triggerGuide(Constant.GUIDE_ID.PETFEED5, self._itemList, pos)
        return
    end

    if GuideModule:checkCanGuide(Constant.GUIDE_ID.PETFEED6) then
        local pos = self:displayObject():convertToWorldSpace(self._feedBtn:getPosition())
        GuideModule:triggerGuide(Constant.GUIDE_ID.PETFEED6, self._feedBtn, pos)
        return
    end
end

return UIWndPetFeed