---@宠物喂养
---@class UIWndPetFeed:UIWindowBase
local UIWndPetFeed = class("UIWndPetFeed",lt.UIWindowBase)

local CommonFunc = lt.CommonFunc
local NtfManager = lt.NtfManager
local ItemModule = lt.ItemModule
local PetModule  = lt.PetModule
local Constant   = lt.Constant
local PetUIActor = lt.PetUIActor
local CacheManager = lt.CacheManager
local TimeCounterManager = lt.TimeCounterManager
local GuideModule = lt.GuideModule

UIWndPetFeed.ChangeSkinConf = {
    ["CommonTL"] = {
        ["btn_feed"]    = {bg = "sort"},
        ["closeButton"] = {bg = "bg_beibao_anniu01", bgup = "bg_beibao_anniu02"},
        ["btn_other_ok"]= {bg = "sort"},
        ["btn_revive"]  = {bg = "sort"},
    },
    ["Pet"] = {
        ["frame"] = {n1 = "bg_tankuang"},
    }
}

function UIWndPetFeed:ctor(param)
    UIWndPetFeed.super.ctor(self,param)

    --UI
    self._skinBtn = nil
    self._feedBtn = nil
    self._modelNode = nil
    self._petActor = nil
    self._lastDayLabel = nil
    self._barImg1 = nil
    self._lastTimeLabel = nil
    self._barImg2 = nil
    self._itemList = nil
    self._reviveList = nil
    self._digLabel = nil
    self._expLabel = nil
    self._levelLabel = nil
    --数据
    self._list = nil
    self._petInfo = nil
    self._id = nil
end


function UIWndPetFeed:onShown()
    self:enableUpdateEvent(true)

    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_PET_MY, handler(self, self.refreshCurPanel), "UIWndPetFeed:NTF_REFRESH_PET_MY")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_ITEM_CHANGE_EVENT, handler(self, self.refreshCurPanel), "UIWndPetFeed:NTF_UPDATE_ITEM_CHANGE_EVENT")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CHECK_GUIDE_EVENT, handler(self, self.checkGuide), "UIWndPetFeed:NTF_CHECK_GUIDE_EVENT")

    self._feedBtn:addClickListener(handler(self, self.onfeedBtnClick))
    self._reviveBtn:addClickListener(handler(self, self.onReliveBtnClick))
    self._btnOtherOk:addClickListener(handler(self, self.onfeedSpecialClick))
    self._itemList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    self._reviveList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    local closeButton = self:getChild("closeButton")
    closeButton:addClickListener(handler(self, self.onCloseBtnClick))

    self:refreshCurPanel()

    --定时器
    TimeCounterManager:startTimeCounter(TimeCounterManager.TC.PET_FEED_UPDATE, {callback = function()
        self:refreshPetInfo()
    end})
end

function UIWndPetFeed:onHide()
    NtfManager:removeNtfListenerByTag("UIWndPetFeed:NTF_REFRESH_PET_MY")
    NtfManager:removeNtfListenerByTag("UIWndPetFeed:NTF_UPDATE_ITEM_CHANGE_EVENT")
    NtfManager:removeNtfListenerByTag("UIWndPetFeed:NTF_CHECK_GUIDE_EVENT")

    self._feedBtn:removeClickListener()
    self._reviveBtn:removeClickListener()
    self._btnOtherOk:removeClickListener()
    self._itemList:removeEventListener(fgui.UIEventType.ClickItem)
    self._reviveList:removeEventListener(fgui.UIEventType.ClickItem)
    local closeButton = self:getChild("closeButton")
    closeButton:removeClickListener()

    TimeCounterManager:stopTimeCounter(TimeCounterManager.TC.PET_FEED_UPDATE)

    UIWndPetFeed.super.onHide(self)
end

function UIWndPetFeed:onInit()
    self:registerComponent("UICompPetFeedItem")
    UIWndPetFeed.super.onInit(self, _GURL.WndPetFeedPanel)
    self:initUI()
end

function UIWndPetFeed:onClear()
    if self._petActor then
        self._petActor:onClear()
        self._petActor   = nil
    end
    self:unregisterAllComponent()
    --UI
    self._skinBtn = nil
    self._feedBtn = nil
    self._modelNode = nil
    self._lastDayLabel = nil
    self._barImg1 = nil
    self._lastTimeLabel = nil
    self._barImg2 = nil
    self._digLabel = nil
    self._expLabel = nil
    self._levelLabel = nil
    --数据
    self._list = nil
    self._petInfo = nil
    self._id = nil

    if self._itemList then
        self._itemList:removeChildrenToPool()
        self._itemList:removeItemRenderer()
        self._itemList = nil
    end

    if self._reviveList then
        self._reviveList:removeChildrenToPool()
        self._reviveList:removeItemRenderer()
        self._reviveList = nil
    end
end

function UIWndPetFeed:onUpdate(dt)
    if self._petActor then
        self._petActor:onUpdate(dt)
    end
end

function UIWndPetFeed:initUI()
    self._feedBtn = self:getChild("btn_feed")
    self._reviveBtn = self:getChild("btn_revive")
    self._btnOtherOk = self:getChild("btn_other_ok")
    self._modelNode = self:getChild("node_model")
    self._petActor = PetUIActor.new(2)
    self._modelNode:displayObject():addChild(self._petActor)
    --详细属性
    self._lastDayLabel = self:getChild("label_lastday")
    self._barImg1 = self:getChild("img_bar1")
    self._lastTimeLabel = self:getChild("label_lasttime")
    self._barImg2 = self:getChild("img_bar2")
    --喂养列表
    self._itemList = self:getChild("list_item")
    self._itemList:setItemRenderer(handler(self, self.renderFeedItem))
    --复活列表
    self._reviveList = self:getChild("list_revive")
    self._reviveList:setItemRenderer(handler(self, self.renderFeedItem))
    --额外属性
    self._digLabel = self:getChild("label_dig")
    self._expLabel = self:getChild("label_exp")
    self._levelLabel = self:getChild("label_level")
end

function UIWndPetFeed:refreshCurPanel()
    local param = self:getParam().param or {}
    local feedType = param.feedType
    self:getChild("com_feed"):setVisible(feedType == Constant.WndFeedType.Feed or feedType == Constant.WndFeedType.Revive)
    self:getChild("com_other"):setVisible(feedType == Constant.WndFeedType.Other)
    if feedType == Constant.WndFeedType.Feed then  -- 喂养界面
        local uid      = param.uid
        local petData  = PetModule:getPetByUid(uid)
        local petInfo  = {data = petData, meta = CacheManager:getPetMeta(petData:getId())}
        self:refreshViewFeed(petInfo)
    elseif feedType == Constant.WndFeedType.Other then  -- 喂养其他界面
        local uid      = param.uid
        local petData  = PetModule:getPetByUid(uid)
        local petInfo  = {data = petData, meta = CacheManager:getPetMeta(petData:getId())}
        self:refreshViewOther(petInfo)
    elseif feedType == Constant.WndFeedType.Revive then  -- 喂养复活界面
        local uid      = param.uid
        local petData  = PetModule:getPetByUid(uid)
        local petInfo  = {data = petData, meta = CacheManager:getPetMeta(petData:getId())}
        self:refreshViewRevive(petInfo)
    end
end

function UIWndPetFeed:refreshViewFeed(petInfo)
    local petMeta = petInfo.meta
    local petData = petInfo.data
    --剩余存活天数
    local lastDay, lastTime = PetModule:getSurviveTime(petData:getDeadTime())
    self._lastDayLabel:setText(lastDay..GReadText.KEY_TIME_DAY)
    self._barImg1:setFillAmount(lastDay/Constant.PET_MAX_SURVIVE)
    local lastsTime = CommonFunc:secondsToTime4(lastTime)
    self._lastTimeLabel:setText(lastsTime)
    self._barImg2:setFillAmount(lastTime/Constant.WHOLE_DAY)
    -- local isDie = PetModule:isDie(petData:getDeadTime())
    -- local dieTime = PetModule:getDeadTime(petData:getDeadTime())
    -- self._feedBtn:setText(isDie and GReadText.KEY_PET_TIPS16 or GReadText.KEY_PET_TIPS17)
    --宠物模型
    self._petActor:setDirection(petMeta:getModleDir())
    self._petActor:playAction(petData:getPetModel())
    --列表 存活显示口粮
    self._list = petMeta:getFeed()
    self._itemList:setNumItems(#self._list)
    yflog:Info("UIWndPetFeed:refreshView ---> feed %s", #self._list)
    -- self:refreshSelect(nil)
    self._petInfo = petInfo

    self:getChild("node_feed"):setVisible(true)
    self:getChild("node_revive"):setVisible(false)
    self._reviveBtn:setVisible(false)
    self._feedBtn:setVisible(true)
    self._itemList:setVisible(true)
    self._reviveList:setVisible(false)
end

function UIWndPetFeed:refreshViewOther(petInfo)
    local petMeta = petInfo.meta
    local petData = petInfo.data

    --宠物模型
    self._petActor:playAction(petData:getPetModel())

    self._list = petMeta:getFeedSpecial()
    self._itemList:setNumItems(#self._list)
    -- self:refreshSelect(nil)
    self._petInfo = petInfo

    --刷新宠物数据
    self:refreshPetInfo()
end

--刷新宠物数据
function UIWndPetFeed:refreshPetInfo()
    if not self._petInfo then
        return
    end
    local petInfo = self._petInfo
    local digSpeedUpTime = PetModule:getDigSpeedUpTime(petInfo)
    local expSpeedUpTime = PetModule:getExpSpeedUpTime(petInfo)
    local digColor = digSpeedUpTime == 0 and "[color=#ff0000]" or "[color=#00ff00]"
    local expColor = expSpeedUpTime == 0 and "[color=#ff0000]" or "[color=#00ff00]"
    if digSpeedUpTime == 0 then
        digSpeedUpTime = GReadText.KEY_PET_TIPS82
    end
    if expSpeedUpTime == 0 then
        expSpeedUpTime = GReadText.KEY_PET_TIPS82
    end
    self._digLabel:setText(GReadText.KEY_PET_TIPS78..digColor..digSpeedUpTime.."[/color]")
    self._expLabel:setText(GReadText.KEY_PET_TIPS79..expColor..expSpeedUpTime.."[/color]")
end

function UIWndPetFeed:refreshViewRevive(petInfo)
    local petMeta = petInfo.meta
    local petData = petInfo.data
    --宠物模型
    self._petActor:playAction(petData:getPetModel())
    --列表
    local isDie = PetModule:isDie(petData:getDeadTime())
    self:getChild("node_feed"):setVisible(not isDie)
    self:getChild("node_revive"):setVisible(isDie)
    self._reviveBtn:setVisible(true)
    self._feedBtn:setVisible(false)
    self._itemList:setVisible(false)
    self._reviveList:setVisible(true)

    --死亡显示复活
    self._list = {{1, Constant.SEVEN_DAY_IN, 1}, {1, Constant.SEVEN_DAY_OUT, 1}}
    -- if dieTime > 7 then
    --     table.remove(self._list, 1)
    -- end
    yflog:Info("UIWndPetFeed:refreshViewRevive ---> %s", #self._list)
    self._reviveList:setNumItems(#self._list)

    if isDie then
        --已死亡
        local dieTime = PetModule:getDeadTime(petData:getDeadTime())
        self:getChild("label_die"):setText(string.format(GReadText.KEY_PET_TIPS11, dieTime))
        local item = self._reviveList:getChildAt(dieTime >= 7 and 1 or 0)
        self._id = item:getId()
        self:refreshSelect(item)
    else
        --剩余存活天数
        local lastDay, lastTime = PetModule:getSurviveTime(petData:getDeadTime())
        self._lastDayLabel:setText(lastDay..GReadText.KEY_TIME_DAY)
        self._barImg1:setFillAmount(lastDay/Constant.PET_MAX_SURVIVE)
        local lastsTime = CommonFunc:secondsToTime4(lastTime)
        self._lastTimeLabel:setText(lastsTime)
        self._barImg2:setFillAmount(lastTime/Constant.WHOLE_DAY)
        self:refreshSelect(nil)
    end

    self._petInfo = petInfo
end

