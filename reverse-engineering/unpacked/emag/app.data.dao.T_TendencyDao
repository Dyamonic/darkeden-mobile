
local TendencyDao = {}

function TendencyDao:queryAll()
    local tendencyTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Tendency") do
        local tendency = lt.TendencyMeta.new(row)
        tendencyTable[tendency:getTendencyID()] = tendency
    end

    return tendencyTable
end

return TendencyDao
