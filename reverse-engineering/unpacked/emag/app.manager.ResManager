function ResManager:getItemIconByIconId(iconId)
    if iconId == nil or iconId == "" then
        return nil
    end
    local id = 100000 + iconId
    local iconStr = string.sub(tostring(id), 2, 6)
    return "icon/item/item_" .. iconStr .. ".png"
end

function ResManager:getItemIconOfFGUIByIconId(iconId)
