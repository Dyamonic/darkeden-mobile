function ResManager:getButtonExIconById(btnId)
    local path = ""
    local skillId = nil
    if btnId == 2001 then
        skillId = 0
        path = string.format("icon/skill/skill_btn_%d.png", skillId)
    elseif btnId >= 3000 and btnId <= 3999 then
        skillId = (btnId % 1000) * 100
        path = string.format("icon/skill/skill_btn_%d.png", skillId)
    else
        if btnId == 1003 then
            path = string.format("ui/btn/btn_%d_2.png", btnId)
        else
            path = string.format("ui/btn/btn_%d.png", btnId)
        end
    end
    return path, skillId
    -- return string.format("ui/btn/btn_%d.png", btnId)
end

