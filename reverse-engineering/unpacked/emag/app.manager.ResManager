--[[
params  @asyncCb        异步回调(注意, plist图片文件不存在异步加载) 
         funtion (obj spriteFrame) end
]]
function ResManager:getSpriteFrame(key, asyncCb)
    local fileName, resType = self:realResPath(key)
    local function createFrame(tex)
        if tex then
            if resType == ccui.TextureResType.localType then 
                return cc.SpriteFrame:createWithTexture(tex, cc.rect(0, 0, tex:getContentSize().width, tex:getContentSize().height))
            else
                return cc.SpriteFrameCache:getInstance():getSpriteFrame(fileName)
            end
        end
    end

    if async then
        self:getTex(key, function (tex)
            asyncCb(createFrame(tex))
        end)
    else
        if resType == ccui.TextureResType.localType then
            return createFrame(self:getTex(key))
        else
            return cc.SpriteFrameCache:getInstance():getSpriteFrame(fileName)
        end
    end
end

--[[
params  @asyncCb   function(texture2D) end
]]
function ResManager:getTex(key, asyncCb)
    local fileName, resType = self:realResPath(key)

    local texCache = cc.Director:getInstance():getTextureCache()
    local tex = nil
    if resType == ccui.TextureResType.localType then
        -- asyncCb use in async
        if asyncCb then 
            texCache:addImageAsync(fileName, function (tex)
                assert(tex, "[error] function 'ResManager:getTex' can't get texture, fix path correct.")
                asyncCb(tex)
            end)
        else
            tex = texCache:addImage(fileName)
        end
    else    -- plist
        local frameCache = cc.SpriteFrameCache:getInstance()
        tex = frameCache:getSpriteFrame(fileName):getTexture()
    end

    if not asyncCb then
        if not tex then
            print("[error] function 'ResManager:getTex' can't get texture, fix path correct.")
        end
        -- assert(tex, "[error] function 'ResManager:getTex' can't get texture, fix path correct.")
    end

    return tex
end

--[[
通过key值, 得到真实路径,图片的类型 如果为图集,额外返回图集的路径, 并进行自动加载
@key:       可以是key, 也可以是文件路径

]]
function ResManager:realResPath(key)
    -- assert(type(ResManager[key]) == "string" and ResManager[key] ~= "", "[error] function 'ResManager:realResPath' param key should not be none")

    -- 考虑到, 控件都会基于此调口的调用, 部分资源是通过字符串的拼接, 并不会配置key, 需要兼容key值实际为文件路径的情况
    local path = ResManager[key] or key
    local p1, p2 = string.find(path,".plist")

    if p1 and p2 then
        local plistPath = string.sub(path, 0, p2)
        local fileName = string.sub(path, p2 + 2)

        local cache = cc.SpriteFrameCache:getInstance()
        if not cache:isSpriteFramesWithFileLoaded(plistPath) then
            cache:addSpriteFrames(plistPath)
        end

        return fileName, ccui.TextureResType.plistType, plistPath
    else
        return path, ccui.TextureResType.localType
    end
end

--[[
    测试用，画十字线
]]
function ResManager:DrawCrossLine(node, x, y)
    x = x or 0
    y = y or 0

    local w, h = display.width, display.height
    
    -- 横轴 Horizontal
    local lineHorizontal = cc.DrawNode:create()
    lineHorizontal:setLineWidth(1)
    
    lineHorizontal:drawLine(cc.p(-w, y), cc.p(w, y), lt.Constant.COLOR_4F_GREEN_H)
    node:addChild(lineHorizontal, 1)

    -- 纵轴 Horizontal
    local lineVertical = cc.DrawNode:create()
    lineVertical:setLineWidth(1)
    lineVertical:drawLine(cc.p(x, -h), cc.p(x, h), lt.Constant.COLOR_4F_GREEN_H)
    node:addChild(lineVertical, 1)
end

