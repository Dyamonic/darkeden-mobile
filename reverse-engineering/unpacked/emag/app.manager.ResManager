function ResManager:getAttackTypePath(showTypes)
    if showTypes == nil then
        return nil
    end
    if tonumber(showTypes[1]) == 1 then
        showTypes[3] = "default"
    end
    local form = table.concat(showTypes,"_")
   
    return string.format("tlui/attack/skillStyle/attackStyle%s.png", form)
end

--通过路径获取spriteFrame
function ResManager:getSpriteFrameByPath(path, np)
    if path == nil or path == "" then
        return nil
    end

    if type(path) == "table" then
        return path
    end

    local pos1,pos2 = string.find(path,".plist")
    if pos1 ~= nil and pos2 ~= nil then
        local plistPath = string.sub(path,0, pos2)
        local fileName = string.sub(path,pos2+2)

        cc.SpriteFrameCache:getInstance():addSpriteFrames(plistPath)
        return cc.SpriteFrameCache:getInstance():getSpriteFrame(fileName)
    else
        if np then
            return path
        end

        local sprite = cc.Sprite:create(path)
        if sprite then
            return sprite:getSpriteFrame()
        end
        assert(false, path.." not a plist file and not an image file.")
    end
end

function ResManager:setDisplayFrameByPath(node, path)
    if node and path then
        local spriteFrame = self:getSpriteFrameByPath(path)
        if spriteFrame then
            node:setSpriteFrame(spriteFrame)
        end
    end
end

--通过Key获取spriteFrame
function ResManager:SpriteFrameByKey(key, index)
    local paths = self[key]
    if type(paths) == "table" then
        index = index or 1
        return self:getSpriteFrameByPath(paths[index])
    else
        return self:getSpriteFrameByPath(paths)
    end
end

function ResManager:removeSpriteFrames(dataFilename)
    cc.SpriteFrameCache:getInstance():removeSpriteFramesFromFile(dataFilename)
end

function ResManager:removeTextureForKey(imageFilename)
    local textureCache = cc.Director:getInstance():getTextureCache()
    textureCache:removeTextureForKey(imageFilename)
end

function display.removeUnusedSpriteFrames()
    cc.SpriteFrameCache:getInstance():removeUnusedSpriteFrames()
    cc.Director:getInstance():getTextureCache():removeUnusedTextures()
end

function ResManager:resPath(key)
    return self:getSpriteFrameByPath(self[key], true)
end

function ResManager:getEquipQuaTitlePng(idx)
