    ["NPC"] = {
        ["bg"] = "bg_zdcs_tcb",
        ["img"] = "bg_zdcs_tcd",
        ["img_novip"] = "bg_zdcs_tcd02",
    },
    ["CommonTL"] = {
        ["frame"] = {
            closeButton1 = { bg = "bg_beibao_anniu01", bgup = "bg_beibao_anniu02" },
        },
        ["btn_oneKey"] = { icon = "bg_youjian_changanniu02" },
    }
}

UIWndAutoRecycle.ChangeSkinOffset = {
    [Constant.RaceType.Slayer] = {
        ["frame"] = {
            closeButton1 = { x = -10, y = 7 },
        },
    },
    [Constant.RaceType.Vampire] = {
        ["frame"] = {
            closeButton1 = { x = -5, y = 5 },
        },
    },
    [Constant.RaceType.Ousters] = {
        ["frame"] = {
            closeButton1 = { x = -5, y = 5 },
        },
    }
}

function UIWndAutoRecycle:ctor(param)
    self:registerComponent("UICompAutoRecycleMenuCell")
    UIWndAutoRecycle.super.ctor(self, param)
    self._mainIdx = 0
    self._subIdx = 0
end

function UIWndAutoRecycle:onShown()
    UIWndAutoRecycle.super.onShown(self)
    NtfManager:addNtfListener(
        NtfManager.NTF.NTF_AUTORECYCLE_MAINIDX, handler(self, self.selectMainIdx), "UIWndAutoRecycle:selectMainIdx")
    NtfManager:addNtfListener(
        NtfManager.NTF.NTF_AUTORECYCLE_SUBIDX, handler(self, self.selectSubIdx), "UIWndAutoRecycle:selectSubIdx")
    NtfManager:addNtfListener(
        NtfManager.NTF.NTF_VIP_STATE_CHANGE, handler(self, self.vipChange), "UIWndAutoRecycle:vipChange")
    self._listContent:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    self._cbAllSelect:addClickListener(handler(self, self.onClickAllSelect))
    self._btnOneKey:addClickListener(handler(self, self.onClickOneKeySell))
    self._cbAutoRecycle:addClickListener(handler(self, self.onClickAutoRecycle))
    self._closeBtn:addClickListener(handler(self, self.onCloseClick))
    self:initUI()
end

function UIWndAutoRecycle:onHide()
    NtfManager:removeNtfListenerByTag("UIWndAutoRecycle:selectMainIdx")
    NtfManager:removeNtfListenerByTag("UIWndAutoRecycle:selectSubIdx")
    NtfManager:removeNtfListenerByTag("UIWndAutoRecycle:vipChange")
    self._listContent:removeEventListener(fgui.UIEventType.ClickItem)
    self._cbAllSelect:removeClickListener()
    self._btnOneKey:removeClickListener()
    self._cbAutoRecycle:removeClickListener()
    self._closeBtn:removeClickListener()
    UIWndAutoRecycle.super.onHide(self)
end

function UIWndAutoRecycle:onClear()
    self._targetList    = nil
    self._listContent   = nil
    self._cbAutoRecycle = nil
    self._cbAllSelect   = nil
    self._needLv        = nil
    self._lblNeedLv     = nil
    self._imgSuo        = nil
    self._txtOpenvip    = nil
    self._ctl           = nil
    self._closeBtn      = nil
    self:unregisterAllComponent()
    UIWndAutoRecycle.super.onClear(self)
end

function UIWndAutoRecycle:onInit()
    UIWndAutoRecycle.super.onInit(self, _GURL.AutoRecycleSettings)
    self._targetList    = self:getChild("list_menu")
    self._listContent   = self:getChild("list_item")
    self._btnOneKey     = self:getChild("btn_oneKey")
    self._cbAutoRecycle = self:getChild("cb_autoRecycle")
    self._cbAllSelect   = self:getChild("cb_allSelect")
    self._needLv        = self:getChild("needLv")
    self._imgSuo        = self:getChild("img_suo")
    self._txtOpenvip    = self:getChild("txt_openvip")
    self._ctl           = self:getController("c1")
    self._lblNeedLv     = self:getChild("lbl_needLv")
    self._closeBtn      = self:getChild("frame"):getChild("closeButton1")

    self._targetList:setItemRenderer(handler(self, self.targetRender))
    self._listContent:setItemRenderer(handler(self, self.contentRender))
end

function UIWndAutoRecycle:initUI()
    if #self._targetList:getChildren() > 0 then
        local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
        local context = self._targetList:getChildAt(childIndex)
        context:getController("c1"):setSelectedIndex(1)
        context:setSize(BTN_WIDTH, BTN_HEIHT)
        context:getChild("list_choose"):setVisible(false)
    end

    local mapData = ItemModule:getAutoRecycleFilterMap()
    self._targetList:setNumItems(#mapData)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_AUTORECYCLE_MAINIDX, { mainIdx = 1 })
    self:refreshVipInfo()
end

function UIWndAutoRecycle:targetRender(index, obj)
    local index = index + 1
    local mapData = ItemModule:getAutoRecycleFilterMap()
    obj:getChild("text_choose"):setText(mapData[index][1][1]:getClassName())
    local list = mapData[index]
    obj:setObjInfo(list, index)
end

--选中一级按钮回调
function UIWndAutoRecycle:selectMainIdx(event)
    local param = event.param or {}
    local mapData = ItemModule:getAutoRecycleFilterMap()
    if self._mainIdx == param.mainIdx then
        local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
        local context = self._targetList:getChildAt(childIndex)
        if context:getSize().height > BTN_HEIHT then
            context:getController("c1"):setSelectedIndex(1)
            context:setSize(BTN_WIDTH, BTN_HEIHT)
            context:getChild("list_choose"):setVisible(false)
        else
            local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
            local context = self._targetList:getChildAt(childIndex)
            context:getController("c1"):setSelectedIndex(0)
            local newList = context._helpList
            context:setSize(BTN_WIDTH, BTN_HEIHT + #newList * BTN_HEIHT)
            context:getChild("list_choose"):setVisible(true)
        end
        return
    end

    if self._mainIdx > 0 and self._mainIdx <= #mapData then
        local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
        local context = self._targetList:getChildAt(childIndex)
        context:getController("c1"):setSelectedIndex(1)
        context:setSize(BTN_WIDTH, BTN_HEIHT)
        context:getChild("list_choose"):setVisible(false)
    end

    self._mainIdx = param.mainIdx
    local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
    local newContext = self._targetList:getChildAt(childIndex)
    local newList = newContext._helpList
    newContext:getController("c1"):setSelectedIndex(0)
    newContext:setSize(BTN_WIDTH, BTN_HEIHT + #newList * BTN_HEIHT)
    newContext:getChild("list_choose"):setVisible(true)
    self._targetList:scrollToView(childIndex)

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_AUTORECYCLE_SUBIDX, { subIdx = 1 })
end

--选中二级按钮回调
function UIWndAutoRecycle:selectSubIdx(event)
    local param = event.param or {}
    self._subIdx = param.subIdx
    local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
    local context = self._targetList:getChildAt(childIndex)
    context:selectSubIdx(self._subIdx)

    local mapData = ItemModule:getAutoRecycleFilterMap()
    local data = mapData[self._mainIdx][self._subIdx]
    self._listContent:setNumItems(#data)
    self._listContent:scrollToView(0)
    if data[1] then
        local meta = data[1]
        self._needLv:setText(meta:getTitle() or "")
        local class    = meta:getClass() -- 大类
        local type     = meta:getType()  -- 小类
        local keyStr   = GameModule.AUTO_RECYCLE_SETTING_TYPE .. class .. "_" .. type
        local keyValue = PrefManager:getUserValueByKey(keyStr)
        local select   = 0
        if keyValue then
            select = tonumber(keyValue)
        end
        self._cbAllSelect:setSelected(select ~= 0)
    end
end

function UIWndAutoRecycle:contentRender(index, obj)
    local index = index + 1
    local mapData = ItemModule:getAutoRecycleFilterMap()
    local data = mapData[self._mainIdx][self._subIdx]
    if data and data[index] then
        local info = data[index]
        local lblName = obj:getChild("lbl_name")
        lblName:setText(info:getName())
        local cb_select     = obj:getChild("cb_select")
        local idx           = info:getIdx()
        local defaultSwitch = info:getDefaultSwitch() or 0
        local contentColor  = info:getContentColor() or ""
        if contentColor ~= "" then
            local color = string.split(contentColor, ",")
            lblName:setColor(cc.c3b(color[1], color[2], color[3]))
        else
            lblName:setColor(Constant.COLOR_TEXT_WHITE_PURE)
        end
        local keySetting = PrefManager:getUserValueByKey(GameModule.AUTO_RECYCLE_SETTING .. idx)
        local select     = 0
        if not keySetting then
            select = defaultSwitch
        else
            select = tonumber(keySetting)
        end
        cb_select:setSelected(select ~= 0)
        obj.idx = idx
    end
end

function UIWndAutoRecycle:onClickItem(context)
    local obj        = context:getData()
    local idx        = obj.idx
    local keySetting = PrefManager:getUserValueByKey(GameModule.AUTO_RECYCLE_SETTING .. idx)
    local meta       = CacheManager:getRecycleSettingsByIdx(idx)
    if not meta then
        return
    end
    local select        = 0
    local defaultSwitch = meta:getDefaultSwitch() or 0
    if not keySetting then
        select = defaultSwitch
    else
        select = tonumber(keySetting)
    end
    local keyValue  = math.abs(1 - select)
    local cb_select = obj:getChild("cb_select")
    cb_select:setSelected(keyValue ~= 0)
    PrefManager:setUserValueByKey(GameModule.AUTO_RECYCLE_SETTING .. idx, keyValue)

    ItemModule:setIsEquipListChange(true)
    -- 刷新一次
    local childIndex            = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
    local context               = self._targetList:getChildAt(childIndex)
    context:checkSelectAutoRecycle(self._subIdx)

    -- 判断全部是否勾选
    local defaultAll = keyValue
    local mapData = ItemModule:getAutoRecycleFilterMap()
    local data = mapData[self._mainIdx][self._subIdx]
    for i, v in ipairs(data or {}) do
        local keySetting = PrefManager:getUserValueByKey(GameModule.AUTO_RECYCLE_SETTING .. v:getIdx())
        local checkselect = 0
        if not keySetting then
            checkselect = v:getDefaultSwitch() or 0
        else
            checkselect = tonumber(keySetting)
        end

        if checkselect ~= keyValue then
            defaultAll = 0
            break
        end
    end
    local class         = meta:getClass() -- 大类
    local type          = meta:getType()  -- 小类
    local keyStr        = GameModule.AUTO_RECYCLE_SETTING_TYPE .. class .. "_" .. type
    local keyAllSetting = PrefManager:getUserValueByKey(keyStr)
    if keyAllSetting and tonumber(keyAllSetting) == defaultAll then
        return
    end
    PrefManager:setUserValueByKey(keyStr, defaultAll)
    self._cbAllSelect:setSelected(defaultAll ~= 0)
end

function UIWndAutoRecycle:onClickAllSelect(obj)
    local mapData = ItemModule:getAutoRecycleFilterMap()
    local data = mapData[self._mainIdx][self._subIdx]
    if data and data[1] then
        local meta       = data[1]
        local class      = meta:getClass() -- 大类
        local type       = meta:getType()  -- 小类
        local keyStr     = GameModule.AUTO_RECYCLE_SETTING_TYPE .. class .. "_" .. type
        local keySetting = PrefManager:getUserValueByKey(keyStr)
        local select     = 0
        if keySetting then
            select = tonumber(keySetting)
        end

        local keyValue = math.abs(1 - select)
        PrefManager:setUserValueByKey(keyStr, keyValue)
        self._cbAllSelect:setSelected(keyValue ~= 0)
        for i, v in ipairs(data or {}) do
            PrefManager:setUserValueByKey(GameModule.AUTO_RECYCLE_SETTING .. v:getIdx(), keyValue)
        end
        -- 刷新一次
        self._listContent:setNumItems(#data)
        self._listContent:scrollToView(0)

        local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
        local context = self._targetList:getChildAt(childIndex)
        context:checkSelectAutoRecycle(self._subIdx)

        ItemModule:setIsEquipListChange(true)
    end
end

function UIWndAutoRecycle:onClickOneKeySell()
    -- 装备类型要先判断是否勾选
    local package = ItemModule:getPackageArray()
    local itemList = {}
    local propList = {} --检验过的道具缓存
    for _, v in ipairs(package) do
        local itemIdx = v:getItemId()
        local itemType = v:getItemType()
        if (propList[itemIdx] and itemType == Constant.ItemType.ITEM_TYPE_PROP) or ItemModule:checkAutoRecycle(v) then
            -- 检验过的道具不用在检验
            if itemType == Constant.ItemType.ITEM_TYPE_PROP then
                propList[itemIdx] = 1
            end
            table.insert(itemList, v:getItemUid())
        end
    end
    if #itemList > 0 then
        ItemModule:sendVipAutoSellReq(false, itemList)
    else
        local isAllSelect, type = ItemModule:checkRecycleTypeAllSelect()
        local settingsTypes = {
            [Constant.SettingsType.EquipType] = GReadText.KEY_AUTO_TIPS3,
            [Constant.SettingsType.EquipLv] = GReadText.KEY_AUTO_TIPS4,
            [Constant.SettingsType.EquipProp] = GReadText.KEY_AUTO_TIPS5,
            [Constant.SettingsType.EquipAffix] = GReadText.KEY_AUTO_TIPS6,
        }
        if not isAllSelect and settingsTypes[type] then
            local content = string.format(GReadText.KEY_AUTO_TIPS2, settingsTypes[type])
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = content })
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = GReadText.KEY_AUTO_TIPS7 })
        end
    end
end

function UIWndAutoRecycle:onClickAutoRecycle()
    -- 自动出售功能需求VIP开启等级
    local autoRecycleNeedVip = VipModule:getVipAutoRecycleLv()
    local vipLv = VipModule:getCurVipLv()
    if (vipLv < tonumber(autoRecycleNeedVip)) then
        local content = string.format(GReadText.KEY_AUTO_TIPS8, autoRecycleNeedVip)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = content })
        self._cbAutoRecycle:setSelected(false)
        return
    end

    local keySetting = PrefManager:getUserValueByKey(GameModule.AUTO_RECYCLE_SETTING_OPEN)
    local checkselect = 0
    if keySetting then
        checkselect = tonumber(keySetting)
    end

    local keyValue = math.abs(1 - checkselect)
    self._cbAutoRecycle:setSelected(keyValue ~= 0)
    PrefManager:setUserValueByKey(GameModule.AUTO_RECYCLE_SETTING_OPEN, keyValue)
    ItemModule:setIsEquipListChange(true)
end

function UIWndAutoRecycle:refreshVipInfo()
    local vipLv = VipModule:getCurVipLv()
    --一键出售功能需求VIP开启等级
    local oneKeyNeedVip = VipModule:getQuickRecycleLv()
    local lock = (vipLv < tonumber(oneKeyNeedVip))
    self._btnOneKey:setTouchable(not lock)
    self._btnOneKey:setGrayed(lock)

    -- 自动出售功能需求VIP开启等级
    local autoRecycleNeedVip = VipModule:getVipAutoRecycleLv() or 0
    local lockAuto = (vipLv < tonumber(autoRecycleNeedVip))
    self._cbAutoRecycle:setTouchable(not lock)
    self._imgSuo:setVisible(lockAuto)
    local color = (lockAuto) and CommonUtil:convertColorWithX("#abaaaa") or
        CommonUtil:convertColorWithX("#ffffff")
    self._txtOpenvip:setColor(color)
    local needLv = string.format(GReadText.KEY_AUTO_TIPS9, oneKeyNeedVip)
    self._lblNeedLv:setText(needLv)

    --便捷出售功能需求VIP开启等级
    local selectIndex = 1
    if vipLv < tonumber(oneKeyNeedVip) then
        selectIndex = 0
    end
    self._ctl:setSelectedIndex(selectIndex)

    local keySetting = PrefManager:getUserValueByKey(GameModule.AUTO_RECYCLE_SETTING_OPEN)
    local checkselect = 0
    if keySetting then
        checkselect = tonumber(keySetting)
    end
    self._cbAutoRecycle:setSelected(checkselect ~= 0)
end

function UIWndAutoRecycle:vipChange()
    self:refreshVipInfo()
end

function UIWndAutoRecycle:onCloseClick()
    -- NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndLock", close = true })
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_AUTORECYCLE_CLOSE)
end

return UIWndAutoRecycle
