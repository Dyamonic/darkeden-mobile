---@ 自动回收
---@class UIWndAutoRecycle:UIWindowBase
local UIWndAutoRecycle            = class("UIWndAutoRecycle", lt.UIWindowBase)

local NtfManager                  = lt.NtfManager
local CacheManager                = lt.CacheManager
local PrefManager                 = lt.PrefManager
local ItemModule                  = lt.ItemModule
local Constant                    = lt.Constant
local GameModule                  = lt.GameModule
local VipModule                   = lt.VipModule
local CommonUtil                  = lt.CommonUtil

local BTN_WIDTH                   = 99
local BTN_HEIHT                   = 50

