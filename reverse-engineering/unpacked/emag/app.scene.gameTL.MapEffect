-- MapEffect.lua

local MapEffect = class("MapEffect")

-- Constants for weather effect types
MapEffect.MAP_EFFECT_FALL = 0
MapEffect.MAP_EFFECT_ARRIVE1 = 1
MapEffect.MAP_EFFECT_ARRIVE2 = 2
MapEffect.MAP_EFFECT_ARRIVE3 = 3
MapEffect.MAP_EFFECT_ARRIVE4 = 4
MapEffect.MAP_EFFECT_ARRIVE5 = 5
MapEffect.MAP_EFFECT_ARRIVE6 = 6
MapEffect.SPEED = 0.5

-- Constructor
function MapEffect:ctor()
    self._type = MapEffect.MAP_EFFECT_ARRIVE3
    self._spriteID = 0  -- Replace with actual TYPE_SPRITEID as needed
    self._x = 0
    self._y = 0
    self._stepX = 0
    self._stepY = 0
    self._count = 0
    self._maxCount = 0
end

-- Set properties
function MapEffect:Set(type, sid, x, y, sx, sy, count)
    self._type = type
    self._spriteID = sid
    self._x = x
    self._y = y
    self._stepX = sx
    self._stepY = sy
    self._count = count
    self._maxCount = count
end

-- Move the effect
function MapEffect:Move()
    if self._count == 0 then
        return false
    end

    self._x = self._x + self._stepX
    self._y = self._y + self._stepY
    self._count = self._count - 1

    return true
end

-- Get functions
function MapEffect:isActive()
    return self._count > 0
end

function MapEffect:GetType()
    return self._type
end

function MapEffect:GetSpriteID()
    return self._spriteID
end

function MapEffect:GetX()
    return self._x
end

function MapEffect:GetY()
    return self._y
end

function MapEffect:GetCount()
    return self._count
end

function MapEffect:GetMaxCount()
    return self._maxCount
end

-- Set step functions
function MapEffect:SetSX(sx)
    self._stepX = sx
end

function MapEffect:SetSY(sy)
    self._stepY = sy
end

-- Assignment operator (copy)
function MapEffect:Copy(effect)
    self._type = effect._type
    self._spriteID = effect._spriteID
    self._x = effect._x
    self._y = effect._y
    self._stepX = effect._stepX
    self._stepY = effect._stepY
    self._count = effect._count
    self._maxCount = effect._maxCount
end

return MapEffect
