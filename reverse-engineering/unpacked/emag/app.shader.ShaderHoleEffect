
-- 挖洞 not use
---@class ShaderHoleEffect
local ShaderHoleEffect = class("ShaderHoleEffect", lt.ShaderBaseEffect)

local OFFSET_GRID_WIDTH = 0.92 --格子特效偏移
local OFFSET_GRID_HEIGHT = 1.82 
local Constant = lt.Constant

function ShaderHoleEffect:ctor(node, program)
    ShaderHoleEffect.super.ctor(self, node, program)
    self._needRefresh = true
end

--- render
---@param node cc.Node 需要修改的纹理节点
---@param center cc.vec2 圆心 
---@param offset radius 半径
function ShaderHoleEffect:render(node, param)
    local eyeWidth = param.eyeWidth
    self.scaleWidth = param.scaleAction
    self.center = cc.p(0.5, 0.495)
    self.eyeWidth = eyeWidth or 7
    self.originEyeWidth = self.eyeWidth
    local viewWidth = eyeWidth * 48 
    local viewHeight = (eyeWidth + OFFSET_GRID_HEIGHT) * 24
    if node and not tolua.isnull(node) then
        local orSize = node:getContentSize()
        local size = cc.size(orSize.width * Constant.SIGHT_SCALE, orSize.height * Constant.SIGHT_SCALE)
        self.radius = cc.p(viewWidth * OFFSET_GRID_WIDTH / size.width, viewHeight / size.width)
        self.opacity = param.opacity or 1.0
        self.size = cc.p(size.width, size.height)
        self:setNodeShader()
    else
        print("ShaderHoleEffect Invalid node")
    end
end

function ShaderHoleEffect:setUniform(glState, time, node)
    glState:setUniform("u_holeCenter", cc.bytearray.from_vec2(self.center))
    glState:setUniform("u_holeRadius",cc.bytearray.from_vec2(self.radius))
    glState:setUniform("u_spriteSize", cc.bytearray.from_vec2(self.size))
    glState:setUniform("u_opatity",cc.bytearray.from_float(self.opacity))
end

function ShaderHoleEffect:resetUniform(glState, time)
    if self.scaleWidth and self.eyeWidth then
        if self.scaleWidth - self.eyeWidth > 0 then
            self.eyeWidth = self.eyeWidth + time * 0.5
            if self.eyeWidth > self.scaleWidth then
                -- 检查是否达到最大半径，停止更新
                self.scaleWidth = nil
                return 
            end
        else
            self.eyeWidth = self.eyeWidth - time * 0.5
            if self.eyeWidth < self.scaleWidth then
                self.scaleWidth = nil
                return 
            end
        end
        local viewWidth = self.eyeWidth * 48 
        local viewHeight = (self.eyeWidth + OFFSET_GRID_HEIGHT) * 24
        local radius = cc.p(viewWidth * OFFSET_GRID_WIDTH/ self.size.x, viewHeight/ self.size.x)
        glState:setUniform("u_holeRadius", cc.bytearray.from_vec2(radius))
    end
end

function ShaderHoleEffect.needRefresh()
    return true
end
function ShaderHoleEffect:resetTime(time)
    return time + 5
end
function ShaderHoleEffect:getTime()
    return 0.1
end

return ShaderHoleEffect

