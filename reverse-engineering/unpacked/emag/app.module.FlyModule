-- @Author  : ZhaoCi
-- @Desc    :
local FlyModule = {}
table.merge(FlyModule, {
    _hideTip = nil,
})

function FlyModule:init()

end

function FlyModule:clear()
    self._dbName        = nil
    self._customData    = nil
    self._customIndexs  = nil
end

function FlyModule:saveHideTip(b)
    self._hideTip = b
    lt.PrefManager:setUserValueByKey("hideFlyTip", b and 1 or 0)
end

function FlyModule:hideTipTest()
    if not self._init then
        self._hideTip = lt.PrefManager:getUserValueByKey("hideFlyTip")
        self._hideTip = (self._hideTip and self._hideTip or 0) == 1
        self._init = true
    end
end

function FlyModule:setHideTipById(id,values)
    lt.PrefManager:setUserValueByKey("hideTips_"..id,values)
end

function FlyModule:getHideTipValueById(id)
    return lt.PrefManager:getUserValueByKey("hideTips_"..id)
end

function FlyModule:useFlyshoe(flyID, param)
    self:hideTipTest()

    if not self._hideTip then
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MASK_VIEW, {
            class = "UIDlgFlyTip", 
            -- content = lt.StringManager:getString(lt.StringManager.KEY_TASK_FLY_SHOES_TIP),
            title = lt.StringManager:getString(lt.StringManager.KEY_SYSTEM_TIP),
            callback= function(state)
                -- lt.HangupManager:stopHangup()
                if state == lt.Constant.COMMON_TIP_BTN.BTN_CONFIM then
                    if self:enoughFlyshoe() then
                        lt.AgentManager:clearMapLinkRouteInfo()
                        self:reqUseFlyshoe(flyID)

                        if param and param.callback then
                            param.callback()
                        end
                    end
                else
                    lt.FlyModule:saveHideTip(false)
                end
            end
        })
    else
        -- lt.HangupManager:stopHangup()
        
        if self:enoughFlyshoe() then
            lt.AgentManager:clearMapLinkRouteInfo()
            self:reqUseFlyshoe(flyID)
            if param and param.callback then
                param.callback()
            end
        end
    end
end

function FlyModule:reqUseFlyshoe(flyID)
    local req = lt.netcmd_pb.UseFeiXie()
    req.feixieID = tonumber(flyID) 
    lt.SocketApi:sendToGs(lt.ClientCmdDef.FLY_TRANSFER, req)
end

function FlyModule:enoughFlyshoe(num)
    num = num or 0
    local enough = lt.GameModule:getHeroData():getFlyShoes() > num
    if not enough then
        -- lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP, {
        --     content = lt.StringManager:getString(lt.StringManager.KEY_TASK_SHOES_LACK_TIP)
        -- })
        local itemMeta = lt.ItemModule:getItemMetaByItemId(lt.Constant.ItemType.ITEM_TYPE_PROP, 50021)
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DLG_MASK_VIEW, {class = "UIDlgQuicklyWay", item = itemMeta})
    end
    return enough
end

function FlyModule:isHideTip()
    self:hideTipTest()
    return self._hideTip
end

function FlyModule:getUserCustomData()
    self:loadCustomDB()

    local ret = {}
    for _,v in ipairs(self._customData) do
        local meta = lt.FlyDao:query(v.FlyCode)
        ret[#ret+1] = meta
    end

    return ret
end

function FlyModule:loadCustomDB()
    if not self._dbName then
        local playerId = lt.GameModule:getHeroData():getPlayerId()
        self._dbName = string.format("%s_%s", "customTransfer", tostring(playerId))
    end

    local exist = lt.PrefManager:getDbTableIsExist(self._dbName)
    if not exist then
        -- add default metas
        local metas = lt.FlyDao:queryByTag(1)
        local default = {}
        for i,v in ipairs(metas) do
            default[#default+1] = { v:getFlyID(), i, 1 } 
        end

        lt.PrefManager:createTableDb({ "FlyCode", "SortOrder", "Open" }, default, self._dbName)
    end

    if not self._customData then
        self._customData = {}
        local db = lt.DbManager:getDefaultDb()
        for row in db:nrows(string.format("SELECT * FROM %s WHERE Open=1;", self._dbName)) do
            self._customData[#self._customData+1] = { FlyCode = row.FlyCode, SortOrder = row.SortOrder }
        end
        table.sort(self._customData, function (a, b)
            return a.SortOrder < b.SortOrder
        end)

        self._customIndexs = {}
        for i,v in ipairs(self._customData) do
            self._customIndexs[v.FlyCode] = i
        end
    end
end

function FlyModule:toggleCustom(id)
    local showrow = function(udata,cols,values,names)
        assert(udata == 'db_woool_exite')
        print('[SQLite] %s rows %s', udata, table.concat(values, "-"))
        return 0
    end
    local db = lt.DbManager:getDefaultDb()

    if self._customIndexs[id] then
        local idx = self._customIndexs[id]
        for i=idx, #self._customData do
            self._customData[i] = self._customData[i+1]

            if self._customData[i] then
                self._customData[i].SortOrder = i
                self._customIndexs[self._customData[i].FlyCode] = i
            end
        end
        self._customIndexs[id] = nil

        db:exec('BEGIN') 
        db:exec(string.format("UPDATE %s SET Open=%d WHERE FlyCode=%d;", self._dbName, 0, id), showrow, 'db_woool_exite')

        for i=idx,#self._customData do
            local db_woool_sql = string.format("UPDATE %s SET SortOrder=%d WHERE FlyCode=%d;", self._dbName, i, self._customData[i].FlyCode)
            local ret = db:exec(db_woool_sql, showrow, 'db_woool_exite')

            if ret ~= 0 then
                print(string.format("DbManager: update error tableName = %s, key =", self._dbName, tostring(i)))
                break
            end
        end
        db:exec('COMMIT')
    else
        self._customData[#self._customData+1] = { FlyCode = id, SortOrder = #self._customData+1 }
        self._customIndexs[id] = #self._customData

        local ret = false
        for row in db:nrows(string.format("SELECT * FROM %s;", self._dbName)) do
            if row.FlyCode == id then
                ret = true
                break
            end
        end

        db:exec('BEGIN') 
        local db_woool_sql = ""
        if not ret then
            db_woool_sql = string.format("INSERT INTO %s VALUES('%d', '%d', '%d')", self._dbName, id, #self._customData, 1)
        else
            db_woool_sql = string.format("UPDATE %s SET SortOrder='%d', Open='%d' WHERE FlyCode='%d';", self._dbName, #self._customData, 1, id)
        end
        local ret = db:exec(db_woool_sql, showrow, 'db_woool_exite')
        db:exec('COMMIT')
    end
end

return FlyModule
