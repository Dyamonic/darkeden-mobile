
local StateMachine = class("StateMachine")
--[[
    状态机
]]

StateMachine._curState    = nil
StateMachine._globalState = nil
StateMachine._isSelf      = nil

function StateMachine:ctor(curState, globalState, isSelf)
    self._curState    = curState
    self._globalState = globalState
    self._isSelf      = isSelf

    self._curState:onEnter()
    self._globalState:onEnter()
end

function StateMachine:onClear()
    if self._curState then
        self._curState:onExit()
        self._curState:onClear()
    end
    if self._globalState then
        self._globalState:onExit()
        self._globalState:onClear()
    end

    self._curState = nil
    self._globalState = nil
end

function StateMachine:onUpdate(params)
    if self._curState then
        self._curState:onUpdate(params)
    end
    if self._globalState then
        self._globalState:onUpdate(params)
    end
end

function StateMachine:onMessage(msg)
    if self._curState then
        self._curState:onMessage(msg)
    end
end

function StateMachine:changeState(newState)
    local curState = self._curState
    self._curState = nil

    if curState then
        curState:onExit()
    end

    self._curState = newState
    self._curState:onEnter()
end

function StateMachine:isInStateId(stateId)
    return self:getCurStateId() == stateId
end

function StateMachine:isInStateIdArray(stateIdArray)
    local curStateId = self:getCurStateId()

    for _, stateId in ipairs(stateIdArray) do
        if stateId == curStateId then
            return true
        end
    end

    return false
end

function StateMachine:getCurState()
    return self._curState
end

function StateMachine:getCurStateId()
    if self._curState then
        return self._curState:getStateId()
    else
        return 0
    end
end

function StateMachine:getCurStateName()
    if self._curState then
        return self._curState:getStateName()
    else
        return ""
    end
end

return StateMachine
