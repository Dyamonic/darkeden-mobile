local BuffDarkRevenge = class("BuffDarkRevenge", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local ScheduleUtil  = lt.ScheduleUtil

--[[
    黑暗复仇者
]]
function BuffDarkRevenge:ctor(time, actor, skilllevel)    
    BuffDarkRevenge.super.ctor(self, BuffEnum.EFFECT_CLASS_DARK_REVENGE, time, actor)
    actor:playExtremeEffect(SkillEnum.SKILL_EXTREME)
end

function BuffDarkRevenge:onClear()
    self._actor:removeBindingEffect(SkillEnum.SKILL_EXTREME)
    BuffDarkRevenge.super.onClear(self)
end

return BuffDarkRevenge
