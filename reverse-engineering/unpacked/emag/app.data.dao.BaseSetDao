
local BaseSetDao = {}

function BaseSetDao:query(idx)

    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM BaseSet WHERE SetIdx=%d;",idx)) do
    	local Meta = lt.BaseSetMeta.new(row)
        return Meta
    end
end

function BaseSetDao:queryAll()
    local Table = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM BaseSet;") do
        local Meta = lt.BaseSetMeta.new(row)
        Table[#Table+1] = Meta
    end
    return Table
end

return BaseSetDao
