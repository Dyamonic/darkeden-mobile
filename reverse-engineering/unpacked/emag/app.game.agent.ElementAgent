
local ElementAgent = class("ElementAgent", lt.BaseAgent)

local Constant = lt.Constant
local GameModule = lt.GameModule
local CacheManager = lt.CacheManager

ElementAgent._elementActor = nil
ElementAgent._stateMachine = nil
ElementAgent._isOutOfGame  = nil

ElementAgent._cmdSystem    = nil

ElementAgent._mCur = nil
ElementAgent._nCur = nil

ElementAgent._xCur = nil
ElementAgent._yCur = nil

--[[__fmt
    召唤物
]]

function ElementAgent:ctor(objId, m, n, direction, ownerId, skillId)
    ElementAgent.super.ctor(self, Constant.AGENT_TYPE_ELEMENT)

    self._objId = objId
    self._mCur        = m
    self._nCur        = n
    self._xCur        = 0
    self._yCur        = 0
    self._direction = direction
    self._skillId = skillId

    self._elementActor = lt.ElementActor.new(669, m, n, direction, skillId)

    local worldAgent = lt.AgentManager:getWorldAgent()
    self._ownerAgent = worldAgent:getAgent(ownerId)

    self._elementActor:setOwnerID(ownerId)
    self._elementActor:setTraceID(ownerId)

    self._ownerAgent:setElementalID(objId)
    self._stateMachine = lt.StateMachine.new(lt.EleStateIdle.new(self), lt.HeroStateGlobal.new(self), self._isSelf)
    lt.AgentManager:addAgent(self)
    self:setAgent()
    local actorX, actorY = lt.MapUtil:calcMNMid(self._mCur, self._nCur)
    self:setPosition(actorX, actorY)
   
end

function ElementAgent:setAgent()
    self._elementActor:setAgent(self)
end





function ElementAgent:getMN()
    local x, y = self:getPosition()
    return lt.MapUtil:calcMN(x, y)
end

function ElementAgent:getMNExactly()
    return self._mCur, self._nCur
end

function ElementAgent:setMNExactly(m, n)
    self._mCur = m
    self._nCur = n
end


function ElementAgent:onClear()
    lt.AgentManager:removeAgent(self)

    if self._stateMachine then
        self._stateMachine:onClear()
    end
    if self._elementActor then
        self._elementActor:onClear()
    end

    self._elementActor = nil
    self._stateMachine = nil
    self._cmdSystem = nil
end

function ElementAgent:onUpdate()
    if self._stateMachine then
        self._stateMachine:onUpdate()
    end

    if self._elementActor then
        self._elementActor:onUpdate()
    end
end

function ElementAgent:onMessage(msg)
    if self._stateMachine then
        self._stateMachine:onMessage(msg)
    end
end

-- State
function ElementAgent:changeState(newState)
    if self._stateMachine then
        self._stateMachine:changeState(newState)
    end
end

function ElementAgent:isInStateId(stateId)
    if self._stateMachine then
        return self._stateMachine:isInStateId(stateId)
    else
        return false
    end
end

-- 是否死亡
function ElementAgent:isDead()
    return self:isInStateId(Constant.MONSTER_STATE_DIE) or self:isInStateId(Constant.MONSTER_STATE_DEAD)
end

-- 怪物唯一Id
function ElementAgent:getObjId()
    return self._objId
end


-- 是否需要移除地图上占用的格子
function ElementAgent:roleRemoveAnentMN()
    if not self._monsterData:isAlive() then
        -- 普通移除地图上占用的点 死亡完成挖掘后不占用格子
        local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
        mapAgent:removeAgentMN(self, self:getMNExactly())
    end
end

function ElementAgent:getMNExactly()
    return self._mCur, self._nCur
end

function ElementAgent:setMNExactly(m, n)
    self._mCur = m
    self._nCur = n
    self._elementActor:setMN(m, n)
    
end

function ElementAgent:getPosition()
    return self._xCur, self._yCur
end

function ElementAgent:setPosition(x, y)
    self._xCur = x
    self._yCur = y


    local offsetX, offsetY = -25, 15
    local reX, reY = x + offsetX, y + offsetY
    self._elementActor:setPositionEx(reX, reY)

    local m, n = self:getMN()
    local zOrder = (n * 10000 + m + 9999) * 10
    self._elementActor:setLocalZOrder(zOrder)
end

function ElementAgent:getDirection()
    if self._elementActor then
        return self._elementActor:getDirection()
    else
        return Constant.DIRECTION_DOWN
    end
end

function ElementAgent:setDirection(direction)
    if self._elementActor then
        self._elementActor:setDirection(direction)
    end
end

function ElementAgent:getActor()
    return self._elementActor
end

function ElementAgent:getCmdSystem()
    return self._cmdSystem
end

function ElementAgent:handleRouteMsg(msg)
    if not msg then
        return
    end

    local mHero, nHero = self:getMNExactly()
    if mHero == tonumber(msg.mTarget) and nHero == tonumber(msg.nTarget) then
        -- self:handleRouteCallback(msg.params)
        return
    end

    -- 无视终点阻挡
    local route = lt.MapUtil:route(mHero, nHero, msg.mTarget, msg.nTarget, true)
    if not route then
        print("ElementAgent:handleRouteMsg 不存在寻路",mHero, nHero, msg.mTarget, msg.nTarget)
        return
    end
    if route:getMNCount() > 0 then
        self:changeState(lt.EleStateRoute.new(self, route, msg.params))
        self:getCurState():setWait()
        return
    end
end

function ElementAgent:startTrace()
    if not self._isRoute then
        self._isRoute = true
        self:changeState(lt.EleStateMove.new(self, self._ownerAgent:getAgentId()))
    end
end

function ElementAgent:setIsRoute(isRoute)
    self._isRoute = isRoute

end


function ElementAgent:getTargetAgentId()
    return self._xx
    -- return self._ownerAgent:getAgentId()
end
function ElementAgent:setTargetAgentId()
    self._xx = nil
end

---fix 补丁
function ElementAgent:getIsSelf()
    return true
end

function ElementAgent:playAction()

end

function ElementAgent:checkPickUp()
    return false
end


---fix
function ElementAgent:getMoveSpeed()
    return 48 * 3
end

function ElementAgent:moveAction(xTarget, yTarget)
    transition.moveTo(self:getActor(), {
        x = xTarget,
        y = yTarget,
        time = 1.1,
        onComplete = function()
        end
    })
end


function ElementAgent:getCurState()
    return self._stateMachine:getCurState()
end

function ElementAgent:playAttackAction()
    self._elementActor:playAttackAction()
end





return ElementAgent
