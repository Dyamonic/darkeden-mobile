
local MonsterData = class("MonsterData")
--[[
    怪物数据
]]

local CacheManager = lt.CacheManager
local ServerClientEnum = lt.ServerClientEnum

MonsterData._objId       = nil
MonsterData._objType     = nil
MonsterData._name        = nil
MonsterData._nameColor   = nil
MonsterData._monsterId   = nil
MonsterData._modelId     = nil
MonsterData._level       = nil
MonsterData._curHp       = nil
MonsterData._maxHp       = nil
MonsterData._masterObjId = nil
MonsterData._status      = nil
MonsterData._createTime  = nil
MonsterData._hide        = nil
MonsterData._transform   = nil
MonsterData._weaponModelId = nil
MonsterData._digEndTime  = nil

function MonsterData:ctor(objId, propertyArray)
    self._objId = objId
    self._actionCombId = nil
    for _, v in ipairs(propertyArray) do
        if v.properCode == ServerClientEnum.ObjectValueDef.Attr_ObjType then
            self._objType = v.intValue
        elseif v.properCode == ServerClientEnum.ObjectValueDef.Attr_DisplayName then
            self._name = v.strValue
        elseif v.properCode == ServerClientEnum.ObjectValueDef.Attr_NameColor then
            self._nameColor = v.intValue
        elseif v.properCode == ServerClientEnum.MonsterValueDef.Attr_MonsterIdx then
            --怪物编号
            self._monsterId = v.intValue
        elseif v.properCode == ServerClientEnum.MonsterValueDef.Attr_PetLevel then
            --宠物等级
            self._petLevel = v.intValue
        elseif v.properCode == ServerClientEnum.MonsterValueDef.Attr_PetSign then
            --宠物签名
            self._petSign = v.strValue
        elseif v.properCode == ServerClientEnum.MonsterValueDef.Attr_PetUid then
            --宠物uid
            self._petUid = v.intValue
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_KillObjId then
            --击杀者obiid
            self._killObjId = v.intValue
        elseif v.properCode == ServerClientEnum.ObjectValueDef.Attr_Appr then
            self._modelId = v.intValue
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_Level then
            self._level = v.intValue
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_CurHp then
            self._curHp = v.intValue
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_HpMax then
            self._maxHp = v.intValue
        elseif v.properCode == ServerClientEnum.ObjectValueDef.Attr_MasterID then
            self._masterObjId = v.intValue
        elseif v.properCode == ServerClientEnum.ObjectValueDef.Attr_Status then
            self._status = v.intValue
        -- 天炼
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_MoveMode then
            -- 移动类型 2:行走 1:钻地 4:飞行
            self:setValue(v.properCode, v.intValue)
        elseif v.properCode == ServerClientEnum.CreatureValueDef.Attr_Darkness then
            -- 黑暗之触
            self._darkness = v.intValue
        elseif v.properCode == ServerClientEnum.ObjectValueDef.Attr_CreateTime then
            self._createTime = v.intValue
        else
            self:setValue(v.properCode, v.intValue)
        end
    end

    --[[
    if not self._curHp or not self._maxHp then
        print("数据异常 objId:", objId)
        for _,v in ipairs(propertyArray) do
            print("properCode:",v.properCode,"intValue:",v.intValue,"strValue:",v.strValue)
        end
    end
    ]]
end

function MonsterData:setValue(key, value)
    if key == ServerClientEnum.ObjectValueDef.Attr_MasterID then
        self._masterObjId = value
    elseif key == ServerClientEnum.MonsterValueDef.Attr_Dig then
        self._dig = value
    elseif key == ServerClientEnum.MonsterValueDef.Attr_DigTimes then
        self._digTimes = value
    elseif key == ServerClientEnum.ObjectValueDef.Attr_Status then
        -- status == 0 为存活
        self._status = value
    elseif key == ServerClientEnum.CreatureValueDef.Attr_MoveMode then
        -- 移动类型 2:行走 1:钻地 4:飞行
        self._moveMode = value
    elseif key == ServerClientEnum.MonsterValueDef.Attr_KillObjId then
        --击杀者obiid
        self._killObjId = value
    elseif key == ServerClientEnum.CreatureValueDef.Attr_Hide then
        self._hide = value
    elseif key == ServerClientEnum.CreatureValueDef.Attr_CurHp then
        self._curHp = value
    elseif key == ServerClientEnum.CreatureValueDef.Attr_HpMax then
        self._maxHp = value
    elseif key == ServerClientEnum.CreatureValueDef.Attr_MoveSpeedRate then
        self._moveSpeed = value
    elseif key == ServerClientEnum.CreatureValueDef.Attr_AbsorbSoulFlag then
        self._absorbSoulFlag = value
    elseif key == ServerClientEnum.MonsterValueDef.Attr_PetSkin then
        self:setPetSkinId(value)
    end
end

function MonsterData:getValue(key)
    if key == ServerClientEnum.MonsterValueDef.Attr_Dig then
        return self._dig
    elseif key == ServerClientEnum.MonsterValueDef.Attr_DigTimes then
        return self._digTimes
    elseif key == ServerClientEnum.CreatureValueDef.Attr_MoveMode then
        return self._moveMode
    elseif key == ServerClientEnum.CreatureValueDef.Attr_Hide then
        return self._hide
    elseif key == ServerClientEnum.CreatureValueDef.Attr_CurHp then
        return self._curHp
    elseif key == ServerClientEnum.CreatureValueDef.Attr_HpMax then
        return self._maxHp
    elseif key == ServerClientEnum.CreatureValueDef.Attr_MoveSpeedRate then
        return self._moveSpeed
    elseif key == ServerClientEnum.CreatureValueDef.Attr_AbsorbSoulFlag then
        return self._absorbSoulFlag
    end
end

-- Setter && Getter
function MonsterData:getObjId()
    return self._objId
end

function MonsterData:setObjId(objId)
    self._objId = objId
end

function MonsterData:getObjType()
    return self._objType
end

function MonsterData:setName(name)
    self._name = name
end

function MonsterData:getName()
    return self._name
end

function MonsterData:setNameColor(nameColor)
    self._nameColor = nameColor
end

function MonsterData:getNameColor()
    return self._nameColor or 0
end

function MonsterData:getMonsterId()
    return self._monsterId
end

function MonsterData:getMonsterMeta()
    return nil
end

function MonsterData:getPetLevel()
    return self._petLevel or 0
end

function MonsterData:getPetSign()
    return self._petSign or ""
end

function MonsterData:getPetUid()
    return self._petUid
end

function MonsterData:getCreateTime()
    return self._createTime
end

function MonsterData:getMonsterInfoMeta()
    return CacheManager:getMonsterInfoMeta(self._monsterId)
end

--[[ 怪物类别: 守卫 死灵 ]]
function MonsterData:getRace()
    return 0
    --[[ 老传奇用
    local monsterMeta = self:getMonsterMeta()
    if monsterMeta then
        return monsterMeta:getRace()
    else
        return 0
    end
    ]]
end

--[[ 怪物种类： boss 精英 灵兽 召唤等等]]
function MonsterData:getGrade()

    return 0 
    --[[
    local monsterMeta = self:getMonsterInfoMeta()
    if monsterMeta then
        return monsterMeta:getGrade()
    else
        return 0
    end
    ]]
end

-- boss
function MonsterData:IsBoss()
    local meta = self:getMonsterInfoMeta()
    if not meta then
        return false
    end

    return meta:IsBoss()
end

-- 宠物
function MonsterData:isPet()
    local meta = self:getMonsterInfoMeta()
    if not meta then
        return false
    end

    return meta:IsPet()
end

-- 精英
function MonsterData:IsElite()
    local meta = self:getMonsterInfoMeta()
    if not meta then
        return false
    end

    return meta:IsElite()
end

-- 模型 衣服
function MonsterData:setModelId(modelId)
    self._modelId = modelId
end

function MonsterData:getModelId()
    if self._modelId ~= nil then
        return self._modelId
    end

    local meta = self:getMonsterInfoMeta()
    if not meta then
        return nil
    end
    -- yflog:Info("self._monsterId = %d", self._monsterId)
    self._modelId = meta:getModelId()
    if self._modelId == 0 then
        self._modelId = lt.SkillEnum.SUMMON.SUMMON_MIGA
    end
    return self._modelId
end

-- 宠物皮肤
function MonsterData:setPetSkinId(skinId)
    self._petSkinId = skinId
    if type(self._petSkinId) == "number" and self._petSkinId > 0 then
        local skinTypeCfg = lt.CacheManager:getPetSkinTypeMeta(self._petSkinId)
		if skinTypeCfg then
			self._petSkinModelId = skinTypeCfg:getModel()
        else
            self._petSkinModelId = nil
		end
    else
        self._petSkinModelId = nil
    end
end

function MonsterData:getPetSkinModelId()
    return self._petSkinModelId
end

function MonsterData:getWeaponModelId()
    if self._weaponModelId ~= nil then
        return self._weaponModelId
    end

    local meta = self:getMonsterInfoMeta()
    if not meta then
        return nil
    end
    
    self._weaponModelId = meta:getWeaponModelId()
    
    return self._weaponModelId
end

function MonsterData:getDigLastFrame()
    if self._digLastFrame ~= nil then
        return self._digLastFrame
    end

    local meta = self:getMonsterInfoMeta()
    if not meta then
        return nil
    end
    
    self._digLastFrame = meta:getDigLastFrame()
    
    return self._digLastFrame
end

function MonsterData:getLevel()
    if self._level then
        return self._level
    end

    local meta = self:getMonsterInfoMeta()
    if not meta then
        return nil
    end

    self._level = meta:getLevel()

    return self._level
end

function MonsterData:isFullHp()
    return self:getCurHp() == self:getMaxHp()
end

function MonsterData:getHpPercent()
    if self:getMaxHp() == 0 then
        return 0
    else
        return self:getCurHp() / self:getMaxHp()
    end
end

function MonsterData:setCurHp(curHp)
    self._curHp = curHp
end

function MonsterData:getCurHp()
    return self._curHp or 0
end

function MonsterData:setMaxHp(maxHp)
    self._maxHp = maxHp
end

function MonsterData:getMaxHp()
    return self._maxHp or 1
end

function MonsterData:getMasterObjId()
    return self._masterObjId or 0
end

function MonsterData:getStatus()
    return self._status or 0
end

function MonsterData:isAlive()
    return self:getStatus() == 0
end

-- 移动模式 2:行走 1:钻地 4:飞行
function MonsterData:getMoveMode()
    return self:getValue(ServerClientEnum.CreatureValueDef.Attr_MoveMode)
end

function MonsterData:setDig(isDig)
    self:setValue(ServerClientEnum.MonsterValueDef.Attr_Dig, isDig)
end

-- Attr_Dig 是否已挖掘 dig = 1 为挖掘
function MonsterData:isDig()
    local dig = self:getValue(ServerClientEnum.MonsterValueDef.Attr_Dig)
    if not dig then
        dig = 0
    end

    return dig > 0
end

-- 挖掘次数
function MonsterData:getDigTimes()
    local digTimes = self:getValue(ServerClientEnum.MonsterValueDef.Attr_DigTimes)
    return digTimes or 2
end

-- 是否进入黑暗之触
function MonsterData:getDarkness()
    return self._darkness
end
function MonsterData:setDarkness(darknessId)
    self._darkness = darknessId
end
function MonsterData:isDivine()
    return self._isDivine
end
function MonsterData:setDivine(isDivine)
    self._isDivine = isDivine
end

function MonsterData:setPetLevel(petLevel)
    self._petLevel = petLevel
end

function MonsterData:getKillObjId()
    return self._killObjId
end

function MonsterData:setTargetId(targetId)
    self._targetId = targetId
end 
function MonsterData:getTargetId()
    return self._targetId
end 
function MonsterData:setFakeCreatureType(type)
    self._fakeCreatureType = type
end
function MonsterData:getFakeCreatureType(type)
    return self._fakeCreatureType
end

-- 隐蔽技能
function MonsterData:setSkillHide(hide)
    self:setValue(ServerClientEnum.CreatureValueDef.Attr_Hide, hide)
end

function MonsterData:getSkillHide()
    return self:getValue(ServerClientEnum.CreatureValueDef.Attr_Hide) or 0
end

function MonsterData:isSkillHide()
    local skillHide = self:getSkillHide()
    return lt.Constant.SkillHide.Hide == skillHide
end

function MonsterData:isCrossCount()
    return self._isCrossCount
end

function MonsterData:setCrossCounter(isCross)
    self._isCrossCount = isCross
end

function MonsterData:getMoveSpeed()
    return self._moveSpeed or 0
end

function MonsterData:setMoveSpeed(speed)
    return self:setValue(ServerClientEnum.CreatureValueDef.Attr_MoveSpeedRate, speed)
end

function MonsterData:getActionCombId()
    if not self._actionCombId then
        local monsterMeta = self:getMonsterInfoMeta()
        self._actionCombId = monsterMeta:getActionCombId()
    end
    return self._actionCombId
end

function MonsterData:getAborbSoulFlag()
    return self._absorbSoulFlag or 0
end

function MonsterData:setDigEndTime(digEndTime)
    self._digEndTime = digEndTime
end

function MonsterData:getDigEndTime()
    return self._digEndTime or 0
end

return MonsterData
