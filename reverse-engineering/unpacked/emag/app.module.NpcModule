---------------------npc买卖 start---------------------------

--通过类型和位置获得货架道具
function NpcModule:getItemByShopTypeAndSite(shopType, site)
    local shopMeta = CacheManager:queryShopTypeMeta(self:getNpcId())
    if not shopMeta then
        return
    end
    local shopId = shopMeta:getShopType()
    if shopType == NpcModule.SHOP_TYPE.NORMAL then
        local meta = CacheManager:getNormalGoodsMeta(shopId)[site]
        return meta
    elseif shopType == NpcModule.SHOP_TYPE.SPECIAL then
        local array = self._specialGoodArray[shopId] or {}
        return array[site]
    elseif shopType == NpcModule.SHOP_TYPE.LOTTO then
        local gender = GameModule:getHeroData():getSex() + 1
        local meta = CacheManager:getGamblingShopMeta(shopId)[site]
        if meta then
            for i = 1, #meta do
                if meta[i]:getNeedSex() == 0 or meta[i]:getNeedSex() == gender then
                    return meta[i]
                end
            end
        end
    end
    return nil
end

--通过类型和位置获得货架meta
function NpcModule:getMetaByShopTypeAndSite(shopType, site)
    local shopId = CacheManager:queryShopTypeMeta(self:getNpcId()):getShopType()
    if shopType == NpcModule.SHOP_TYPE.NORMAL then
        local meta = CacheManager:getNormalGoodsMeta(shopId)[site]
        return meta
    elseif shopType == NpcModule.SHOP_TYPE.SPECIAL then
        local meta = CacheManager:getSpecialGoodsMeta(shopId)[site]
        return meta
    elseif shopType == NpcModule.SHOP_TYPE.LOTTO then
        local gender = GameModule:getHeroData():getSex() + 1
        local meta = CacheManager:getGamblingShopMeta(shopId)[site]
        if meta then
            for i = 1, #meta do
                if meta[i]:getNeedSex() == 0 or meta[i]:getNeedSex() == gender then
                    return meta[i]
                end
            end
        end
    end
    return nil
end

--获得金币商店买卖的最大堆叠数量
function NpcModule:getMaxShopBuyNum(itemType, itemInfo)
    local maxNum = 1
    if itemType == Constant.ItemType.ITEM_TYPE_PROP then
        if itemInfo then
            local meta = itemInfo:getItemMeta() or itemInfo
            return meta:getAddLimit()
        end
    end
    return maxNum
end

--获得购买价格
function NpcModule:getShopBuyPrice(itemType, itemInfo, itemConfig)
    local price = 0
    if itemInfo == nil then
        itemInfo = lt.ItemModule:getItemDataByConfig(itemConfig)
    end
    local tradeItem = WndLockManager:getTradeItemInfo()
    if tradeItem and tradeItem.types == NpcModule.SHOP_TYPE.LOTTO then
        --乐透装备单独计算价格
        --购买价格=参数1+（玩家等级*参数2）
        local level = GameModule:getHeroData():getLevel()
        local param = tradeItem.meta:getPriceParam()
        price = tonumber(param[1]) + level * tonumber(param[2])
        price =  math.floor(price * (1 - GameModule:getHeroData():getGamblingShopPriceBuf() / 10000))
    else
        if itemType == Constant.ItemType.ITEM_TYPE_PROP then
            --物品只拿道具表配置
            price = itemInfo:getItemMeta():getPrice()
        else
            local equipMeta = itemInfo:getItemMeta()
            local equipPrice = equipMeta:getPrice()
            local attr = StrengthenModule:transformAffix(itemInfo)
            if #attr == 0 then
                --没有词条只算一次
                price = equipPrice
            else
                --有词条要循环去算价格
                for i = 1, #attr do
                    --计算装备价格乘数
                    local attributeMeta = CacheManager:getAttributeMeta(attr[i][1], attr[i][2])
                    local multiple = attributeMeta:getPriceMultiplier() / 100
                    local curPrice = equipPrice * multiple
                    price = price + curPrice
                end
            end
        end
    end
    return price
end

--获得出售价格(为购买价格的1/4)
function NpcModule:getShopSellPrice(itemType, itemInfo, itemConfig)
    if itemInfo then
        local canSell = itemInfo:getItemMeta():getSell()
        if canSell == 0 then
            --不可出售返回0
            return 0
        end
        local deadLine = itemInfo:getDeadline()
        if deadLine ~= 0 then
            --限时道具统一出售50块
            return self.DEADLINE_PRICE
        end
    end
    local price = self:getShopBuyPrice(itemType, itemInfo, itemConfig)
    price = math.ceil(price / 4)
    return price
end

--刷新特殊商品货架数据
function NpcModule:refreshSpecialGoods(shopItems)
    if self:getNpcId() == nil then return end
    local shopTypeMeta = CacheManager:queryShopTypeMeta(self:getNpcId())
    if shopTypeMeta == nil then return end
    local shopId = shopTypeMeta:getShopType()
    if not self._specialGoodArray[shopId] then
        self._specialGoodArray[shopId] = {}
    end
    for i = 1, #shopItems do
        local v = shopItems[i]
        local meta = CacheManager:getSingleSpecialGoodsMeta(v.indx)
        if meta then
            if v.type == 1 then
                local itemData = lt.ItemData.new(v.objProperty.objID, v.objProperty.objprops)
                self._specialGoodArray[shopId][meta:getSite()] = itemData
            elseif v.type == 0 then
                self._specialGoodArray[shopId][meta:getSite()] = nil
            end
        end
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOP_REFRESH)
end

--打开商店标签
function NpcModule:sendShopOpen()
    local msg = netcmd_pb.CS_OpenShopReq()
    msg.npcId = self:getNpcId()
    msg.tab = NpcModule.SHOP_TYPE.SPECIAL
    SocketApi:sendToGs(ClientCmdDef.OPEN_SHOP_OPERATE, msg)
end

--打开商店标签回调
function NpcModule:onShopOpen(event)
    lt.LogUtil:debugInfo("NpcModule:onShopOpen")
    local proto = event.param
    if proto and proto.allShopItems then
        self:refreshSpecialGoods(proto.allShopItems)
    end
end

--出售物品
function NpcModule:sendSellItem(oneSell, param1, param2, itemInfo)
    local msg = netcmd_pb.CS_SellNpcReq()
    self._itemInfo = itemInfo
    msg.npcId = self:getNpcId() or 9999
    msg.oneSell = oneSell           --0 单个出售 1 一键出售
    if oneSell == NpcModule.SERVER_TYPE.ZERO then
        msg.objId = param1          --唯一id
        msg.num = param2            --出售数量
    else
        msg.bigType = param1        --大类type
        msg.smallType = param2      --小类type
    end
    msg.itemUid = itemInfo:getItemUid() 
    SocketApi:sendToGs(ClientCmdDef.SHOP_SELL_OPERATE, msg)
end

--出售物品回调
function NpcModule:onSellItem(event)
    lt.LogUtil:debugInfo("NpcModule:onSellItem")
    local proto = event.param
    if proto and proto.ret == 0 then
        local cost = "$".. CommonFunc:changeNumberShow(proto.changeNum)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = string.format(GReadText.KEY_NPC_TRADE_TIPS12, cost)})
        --发送金币变化
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_COIN_NUMBER_CHANGE)
        --播放音效
        lt.ItemModule:playSoundByItemInfo(self._itemInfo)
    end
end

--购买物品回调
function NpcModule:onBuyItem(event)
    lt.LogUtil:debugInfo("NpcModule:onBuyItem")
    local proto = event.param
    if proto and proto.ret == 0 then
        --刷新界面
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_EXCHANGE_ITEM)
        --发送金币变化
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_COIN_NUMBER_CHANGE)
        --获取商店数据
        self:sendShopOpen()
    end
end

---------------------npc买卖 end-----------------------------

---------------------npc维修镀银 start---------------------------

--获得维修价格
function NpcModule:getRepairPrice(itemInfo)
    --耐久度维修价格 = （参数1 + ( 参数2 × 装备等级 )）/ 参数3 ×装备表价格×装备价格乘数（有属性的装备）/参数4
    --当多属性时，分别计算单个属性对应的维修价格后，求和。
    --例如：多属性装备耐久度维修价格=属性1维修价格+属性2维修价格+属性3维修价格。
    local price = 0
    local maxStatus = itemInfo:getTotalDurability()
    local curStatus = itemInfo:getDurability()
    if maxStatus ~= 0 then
        local param = CacheManager:getMaintenanceCostsMeta(1):getDurabilityCost()
        local lv = itemInfo:getILevel()
        local equipMeta = itemInfo:getItemMeta()
        local equipPrice = equipMeta:getPrice()
        local attr = StrengthenModule:transformAffix(itemInfo)
        if #attr == 0 then
            --没有词条只算一次
            price = (param[1] + param[2] * lv) / param[3] * equipPrice * 1 / param[4]
        else
            --有词条要循环去算价格
            for i = 1, #attr do
                --计算装备价格乘数
                local attributeMeta = CacheManager:getAttributeMeta(attr[i][1], attr[i][2])
                local multiple = attributeMeta:getPriceMultiplier() / 100
                local curPrice = (param[1] + param[2] * lv) / param[3] * equipPrice * multiple / param[4]
                price = price + curPrice
            end
        end
        --乘以倍率(耐久度不为0)
        local per = (maxStatus - curStatus) / maxStatus
        price = math.floor(price * per)
    end
    if price <= 0 and curStatus < maxStatus then
        price = 1
    end
    return price
end

--获得所有需要维修装备的价格
function NpcModule:getAllEquipRepairPrice()
    local equipArray = lt.ItemModule:getEquipArray()
    local price = 0
    for k, v in pairs(equipArray) do
        price = price + self:getRepairPrice(v)
    end
    return price
end

--获得镀银价格
function NpcModule:getSliverPrice(itemInfo)
    --镀银维修价格 = 参数1 ×（装备最大镀银值-装备当前已持有镀银值）
    local param = CacheManager:getMaintenanceCostsMeta(1):getMaintenanceCosts()
    local maxStatus = itemInfo:getTotalSilverMax()
    local curStatus = itemInfo:getSilver()
    local price = param[1] * (maxStatus - curStatus)
    return price
end

-- 装备维修/镀银
function NpcModule:sendEquipRepair(types, oneOrMore, equipUid, isAutoRepair)
    local msg = netcmd_pb.CS_RepairReq()
    msg.npcId = self:getNpcId() or 0
    msg.type = types            --0 耐久度 1 镀银
    msg.oneOrMore = oneOrMore   --0 维修一件 1, 维修所有
    if oneOrMore == NpcModule.SERVER_TYPE.ZERO then
        msg.equipUid = equipUid --维修一件装备时，使用
    end
    msg.isAutoRepair = isAutoRepair or false
    SocketApi:sendToGs(ClientCmdDef.REPQIR_OPERATE, msg)
end

--装备维修/镀银回调
function NpcModule:onEquipRepair(event)
    lt.LogUtil:debugInfo("NpcModule:onEquipRepair")
    local proto = event.param
    if proto and proto.ret == 0 then
        local equipUid = proto.equipUid
        local isAutoRepair = proto.isAutoRepair
        if isAutoRepair then
            local newData = lt.ItemModule:getEquipItemByUid(equipUid)
            if newData == nil then
                newData = lt.ItemModule:getItemByUid(equipUid)
            end
            if newData then
                local cost = proto.cost
                local content = string.format("自动维修%s，消耗%s游戏币", newData:getName(),cost)
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = content})
            end
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_EQUIP_REPAIR, {equipUid = equipUid})
        end
    end
end

