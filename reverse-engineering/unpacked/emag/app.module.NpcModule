---------------------npc兑换 start-----------------------------

--获得兑换礼包列表
function NpcModule:getExchangeBoxList()
    local exchangeBoxList = {}
    local list = CacheManager:getExchangeBoxMeta(self:getNpcId())
    for i = 1, #list do
        local meta = list[i]
        --判断是否展示
        if meta:getDisplay() == 1 then
            table.insert(exchangeBoxList, meta)
        end
    end
    return exchangeBoxList
end

