
local NpcModule = {}

local SocketApi = lt.SocketApi
local ServerCmdDef = lt.ServerCmdDef
local NtfManager = lt.NtfManager
local Constant   = lt.Constant
local StringManager  = lt.StringManager
local StrengthenModule = lt.StrengthenModule
local CacheManager = lt.CacheManager
local GameModule = lt.GameModule
local WndLockManager = lt.WndLockManager
local CommonModule = lt.CommonModule
local GuideModule = lt.GuideModule
local CommonFunc = lt.CommonFunc
local ItemModule = lt.ItemModule


NpcModule._specialGoodArray = {}   --npc商店特殊道具列表
NpcModule._HolyBookList = {} -- 圣书列表

--装备词条序列枚举
NpcModule.SHOP_TYPE = {
    NORMAL = 1,     --一般道具
    SPECIAL = 2,    --特殊道具
    LOTTO = 3,      --乐透道具
}

--服务端通用类型枚举(具体查看各接口注释)
NpcModule.SERVER_TYPE = {
    ZERO = 0,
    ONE = 1,
}

--限时道具统一出售价格
NpcModule.DEADLINE_PRICE = 50

local netcmd_pb = lt.netcmd_pb
local ClientCmdDef = lt.ClientCmdDef

function NpcModule:init()
    SocketApi:addProtoListener(ServerCmdDef.NpcOperation_JumpMap, handler(self, self.onNpcResponse), "NpcModule:NpcOperation_JumpMap")
    SocketApi:addProtoListener(ServerCmdDef.NpcOperation_Recover, handler(self, self.onNpcRecoverResponse), "NpcModule:NpcOperation_Recover")
    SocketApi:addProtoListener(ServerCmdDef.NpcOperation_BuyStorge, handler(self, self.onBuyStorge), "NpcModule:NpcOperation_BuyStorge")
    SocketApi:addProtoListener(ServerCmdDef.NpcOperation_FindMotorcycle, handler(self, self.onNpcResponse), "NpcModule:NpcOperation_FindMotorcycle")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_TALK_NPC_RESP), handler(self, self.onNpcResponse), "NpcModule:S_TALK_NPC_RESP")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_SET_RELIVE_POINT_RESP), handler(self, self.onSetRelivePoint), "NpcModule:onSetRelivePoint")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_NPC_SIGN_CONTRACT_RESP), handler(self, self.onNpcSignContract), "NpcModule:onNpcSignContract")
    --npc功能(买卖,镀银)
    SocketApi:addProtoListener(ServerCmdDef.OPEN_SHOP_OPERATE, handler(self, self.onShopOpen), "NpcModule:OPEN_SHOP_OPERATE")
    SocketApi:addProtoListener(ServerCmdDef.EQUIP_REPAIR_OPERATE, handler(self, self.onEquipRepair), "NpcModule:EQUIP_REPAIR_OPERATE")
    SocketApi:addProtoListener(ServerCmdDef.NpcOperation_ExchangeItem, handler(self, self.onBuyItem), "NpcModule:NpcOperation_ExchangeItem")
    SocketApi:addProtoListener(ServerCmdDef.EQUIP_SELL_OPERATE, handler(self, self.onSellItem), "NpcModule:EQUIP_SELL_OPERATE")
    SocketApi:addProtoListener(ServerCmdDef.S_CLEANAttributePoint, handler(self, self.onCleanPoint), "NpcModule:S_CLEANAttributePoint")
    -- 圣书
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_HOLYBOOK_LIST_RESP), handler(self, self.onHolyBook_ListResp), "NpcModule:onHolyBook_ListResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_HOLYBOOK_BORROW_RESP), handler(self, self.onHolyBook_BorrowResp), "NpcModule:onHolyBook_BorrowResp")

    self._specialGoodArray = {}   --npc商店特殊道具列表
    self._HolyBookList = {} -- 圣书列表
end



function NpcModule:clear()
    SocketApi:removeProtoListenerByTag("NpcModule:NpcOperation_JumpMap")
    SocketApi:removeProtoListenerByTag("NpcModule:NpcOperation_Recover")
    SocketApi:removeProtoListenerByTag("NpcModule:NpcOperation_ExchangeItem")
    SocketApi:removeProtoListenerByTag("NpcModule:NpcOperation_BuyStorge")
    SocketApi:removeProtoListenerByTag("NpcModule:NpcOperation_FindMotorcycle")
    SocketApi:removeProtoListenerByTag("NpcModule:S_TALK_NPC_RESP")
    SocketApi:removeProtoListenerByTag("NpcModule:onSetRelivePoint")
    SocketApi:removeProtoListenerByTag("NpcModule:onNpcSignContract")
    --npc功能(买卖,镀银)
    SocketApi:removeProtoListenerByTag("NpcModule:OPEN_SHOP_OPERATE")
    SocketApi:removeProtoListenerByTag("NpcModule:EQUIP_REPAIR_OPERATE")
    SocketApi:removeProtoListenerByTag("NpcModule:EQUIP_SELL_OPERATE")
    -- 圣书
    SocketApi:removeProtoListenerByTag("NpcModule:onHolyBook_ListResp")
    SocketApi:removeProtoListenerByTag("NpcModule:onHolyBook_BorrowResp")

    self._specialGoodArray = nil
    self._HolyBookList = nil
    self._itemInfo = nil
end

function NpcModule:onNpcResponse(event)
    lt.LogUtil:debugInfo("NpcModule:onNpcResponse")
    local proto = event.param
    if proto and proto.ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTalkNpc", close = true})
    end
end

function NpcModule:onNpcRecoverResponse(event)
    lt.LogUtil:debugInfo("NpcModule:onNpcResponse")
    local proto = event.param
    if proto and proto.ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTalkNpc", close = true})
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = "治疗成功"})
    end
end


--购买仓库
function NpcModule:onBuyStorge(event)
    lt.LogUtil:debugInfo("NpcModule:onBuyStorge")
    local proto = event.param
    if proto and proto.ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = GReadText.KEY_TRANSACTION_TIPS8})
    end
end

--复活点设置
function NpcModule:onSetRelivePoint(event)
    lt.LogUtil:debugInfo("NpcModule:onSetRelivePoint")
    local proto = event.param
    if proto and proto.ret == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTalkNpc", close = true})
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = GReadText.KEY_NPC_SKILL_TIPS11})
    end
end

--签约(魔族)
function NpcModule:onNpcSignContract(event)
    lt.LogUtil:debugInfo("NpcModule:onNpcSignContract")
    local proto = event.param
    if proto and proto.ret == 0 then
        GameModule:getHeroData():setSignContract(1)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTalkNpc", close = true})
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = GReadText.KEY_NPC_SKILL_TIPS12})
    end
end

--- 传送地图
function NpcModule:sendGotoMap(npcId, npcTalkId)
    local msg = netcmd_pb.CS_JumpMapReq()
    msg.npcId = tonumber(npcId)
    msg.id = tonumber(npcTalkId)
    SocketApi:sendToGs(ClientCmdDef.NpcOperation_JumpMap, msg)
end

--- 满血
function NpcModule:sendFullHp(npcId)
    local msg = netcmd_pb.CS_RecoverReq()
    msg.npcId = npcId
    SocketApi:sendToGs(ClientCmdDef.NpcOperation_Recover, msg)
end

--- 道具兑换(商店购买)
function NpcModule:sendExchangeItem(itemId, types, index, buyNum)
    local msg = netcmd_pb.CS_ExchangeItemReq()
    msg.npcId = self:getNpcId()
    msg.itemId = itemId --商品id
    msg.type = types    --页签类型 1 普通 2 特殊 3 乐透 4 兑换
    msg.index = index   --格子下标
    msg.buyNum = buyNum --购买数量
    SocketApi:sendToGs(ClientCmdDef.NpcOperation_ExchangeItem, msg)
end

