--圣书列表req
function NpcModule:onHolyBook_ListReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_HOLYBOOK_LIST_REQ))
end

--圣书列表resp
function NpcModule:onHolyBook_ListResp(event)
    local proto = event.param
    local vHolyBook = proto.vHolyBook
    self._HolyBookList = vHolyBook
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_HOLYBOOK_LIST_CHANGE)
end

--借圣书req
function NpcModule:onHolyBook_BorrowReq(equipId,borrow)
    local msg = netcmd_pb.CS_HolyBook_BorrowReq()
    msg.equipId = tonumber(equipId)
    msg.borrow = borrow --true 借圣书 false还圣书
    self._equipId = equipId
    self._borrow = borrow
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_HOLYBOOK_BORROW_REQ),msg)
end

--借圣书resp
function NpcModule:onHolyBook_BorrowResp(event)
    local proto = event.param
    local ret = proto.ret
    if ret == 0 then
        if self._borrow == true then
            local itemMeta = CacheManager:queryEquipMeta(self._equipId)
            local name = itemMeta and itemMeta:getName() or ""
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = string.format(GReadText.KEY_AUTO_RECYCLE_TIPS4, name)}) --您已佩戴血之圣书[%s]
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_AUTO_RECYCLE_TIPS5}) --已归还全部圣书
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_HOLYBOOK_LIST_CHANGE)
    end
end

function NpcModule:getHolyBookList()
    return self._HolyBookList or {}
end

function NpcModule:getHolyBookBorrowHash()
    local holyBookBorrowList = GameModule:getHeroData():getValue(lt.ServerClientEnum.PlayerValueDef.Attr_HolyBookBorrow) or 0
    local holyBookBorrows = {}
    if holyBookBorrowList ~= 0 then
        local itemList = string.split(holyBookBorrowList, ",") or {}
        for k,v in ipairs(itemList) do
            holyBookBorrows[v] = true
        end
    end
    return holyBookBorrows
end

function NpcModule:onClickNpc(npcId)
    yflog:Info("NpcModule:onClickNpc(npcId)")
    local npcMeta = lt.CacheManager:queryNpc(npcId)
    if npcMeta:getNpcType() == Constant.NPC_TYPE.TRANSMIT then
        local heroData = lt.GameModule:getHeroData()
        if not heroData:isOusters() then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = GReadText.KEY_NPC_NOTRACE_TIPS})
            return
        end
        if not heroData:getSignContract() then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_NPC_SKILL_TIPS9})
            return
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndOustersTransmitMap"})
    else
        local myMapMeta = lt.AgentManager:getWorldAgent():getMapAgent():getMapMeta()
        local mymapcode = myMapMeta:getMapCode()
        local npcMap =  lt.CacheManager:getNpcVampireLairTable()
        if npcMap[mymapcode] then -- 副本地图npc 不给交互
            return
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTalkNpc", reopen = true, npcId = npcId})
    end
end

---------------------npc 圣书 end---------------------------

return NpcModule
