local SettingsMeta = class("SettingsMeta")

local CommonFunc = lt.CommonFunc


function SettingsMeta:ctor(row)
    self:initWithRow(row)
end

function SettingsMeta:initWithRow(row)
    self._idx           = row.Idx
    self._type          = row.Type
    self._settingClass  = row.SettingClass
    self._name          = row.Name
    self._occupation    = row.Occupation
    self._valueRange    = row.ValueRange
    self._defaultSwitch = row.DefaultSwitch
    self._defaultValue  = row.DefaultValue
    self._settingList   = row.SettingList
    if self._settingList and self._settingList ~= "" then
        self._settingListConvert = json.decode(self._settingList)
    end
    self._valueRangeConvert = CommonFunc:analysisJsonToTable(self._valueRange, true)
    self._defaultSelect     = row.DefaultSelect
    self._defaultInputValue = row.DefaultInputValue
end

function SettingsMeta:getValueRange()
    return self._valueRangeConvert
end

function SettingsMeta:getSettingList()
    return self._settingListConvert
end

-- AUTO GENERATED GETTERS START
-- 以下方法由脚本自动生成，请勿手动修改

function SettingsMeta:getIdx() return self._idx end

function SettingsMeta:getType() return self._type end

function SettingsMeta:getSettingClass() return self._settingClass end

function SettingsMeta:getName() return self._name end

function SettingsMeta:getOccupation() return self._occupation end

function SettingsMeta:getDefaultSwitch() return self._defaultSwitch end

function SettingsMeta:getDefaultValue() return self._defaultValue end

function SettingsMeta:getDefaultSelect() return self._defaultSelect end

function SettingsMeta:getDefaultInputValue() return self._defaultInputValue end

-- AUTO GENERATED GETTERS END
return SettingsMeta
