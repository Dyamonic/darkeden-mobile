local Updater = class("Updater")

local ScheduleUtil = lt.ScheduleUtil
local AssetManager = lt.AssetManager

-- 本地存储key, 边玩边下的download list
local GAME_UPDATE_PLAYING_DOWNLOAD_LIST = "GAME_UPDATE_PLAYING_DOWNLOAD_LIST"
local BaseCDNUrl = _G_CDN_URL .. "win32_dynamics/v%s/"

function Updater:ctor()
    -- 注册下载器: cppUpdater
    self._cppUpdater = cpp.Updater:new()
	self._cppUpdater:registerScriptHandler(handler(self, self.cppUpdateHandler))

    -- 下载列表 以队列形式
    self._downloadList = {}

    -- 下载至当前目录
    self._downloadPath = device.writablePath
    if device.platform == "mac" or device.platform == "windows" then
        self._downloadPath = self._downloadPath .. "download/"
    end
    self._downloadPath = self._downloadPath .. "win32" .. "/"
end

function Updater:getDownloadUrl()
	if not self._downloadUrl then
		self._downloadUrl = string.format(BaseCDNUrl, AssetManager:getRemoteVersion())
	end

	return self._downloadUrl
end

function Updater:onClear()
    self._cppUpdater = nil
end

-- 添加下载项
function Updater:addToDownloadQueue(url, callback)
    local value = AssetManager:getUrlFromRemote(url)

	yflog:Info("Updater:addToDownloadQueue url:%s, value:%s ", url, value)
    self._downloadList[#self._downloadList + 1] = {value = value, callback = callback}
end

function Updater:stopDownload()
	if self._downloadHandler then
		ScheduleUtil:unscheduleGlobal(self._downloadHandler)
		self._downloadHandler = nil
	end

	self._isDownloading = false
end

-- 开始下载标记
function Updater:startDownload(url, callback)
    -- 加入下载队列，再开始下载
    if self._isDownloading or #self._downloadList > 0 then
        self:addToDownloadQueue(url, callback)
        return
    end

    self._isDownloading = false
    self._downloadIdx = 0

    -- {value, callback}
    self._downloadList = {}
    self:addToDownloadQueue(url, callback)
    
	if not self._downloadHandler then
		-- 定时器每帧执行
		self._downloadHandler = ScheduleUtil:scheduleUpdateGlobal(handler(self, self.onDownload))
	end
end

function Updater:onDownload()
    if self._isDownloading then
		return
	end

	self._downloadIdx = self._downloadIdx + 1
	if self._downloadIdx > #self._downloadList then
		-- 完成下载
		self:completeDownload()
		return
	end

	self._isDownloading = true

	local project = self._downloadList[self._downloadIdx]

	if not project or self:isFileDownload(project.value) then
		self:downloadStepSuccess(true)
		return
	end

	self:downloadFile(project.value)
end

-- remote下载文件判断文件类型并下载
function Updater:downloadFile(value)
	-- 分析文件
	local pathinfo = io.pathinfo(value[1])
	if pathinfo.extname == ".zip" then
		-- 压缩包
		local zipUrl  		 = self:getDownloadUrl() .. value[1]

		-- 下载至当前目录
		local uncompressPath = self._downloadPath

		local zipName 		 = pathinfo.filename
		local fileMd5  		 = value[2]

		self:downloadZipFile(zipUrl, uncompressPath, zipName, fileMd5)
	else
		-- 普通文件
		local fileUrl  = self:getDownloadUrl() .. value[1]
		local filePath = self._downloadPath .. pathinfo.dirname
		local fileName = pathinfo.filename
		local fileMd5  = value[2]

		self:downloadNormalFile(fileUrl, filePath, fileName, fileMd5)
	end
end

-- 下载普通文件
function Updater:downloadNormalFile(fileUrl, filePath, fileName, fileMd5)
	self._cppUpdater:downloadNormalFile(fileUrl, filePath, fileName, fileMd5)
end

-- 下载zip文件
function Updater:downloadZipFile(zipUrl, uncompressPath, zipName, fileMd5)
	self._cppUpdater:downloadZipFile(zipUrl, uncompressPath, zipName, fileMd5)
end

-- ****************** C++部分 下载监听 ******************
function Updater:cppUpdateHandler(event, value)
    if event == "success" then
        ScheduleUtil:performWithDelayGlobal(handler(self, self.downloadStepSuccess), 0)
    elseif event == "state" then
        --[[ 
            过程事件 downloadStart  downloadDone uncompressStart uncompressDone stateUnknown
        ]]
        -- yflog:Info("download state: %s", value)
    elseif event == "error" then
        --[[
            value： 
            errorCreateFile:创建文件失败  errorNetwork:网络下载失败  errorUncompress:解压失败  errorCopyFile:拷贝失败  errorMD5:MD5校验失败  errorUnknown:errorUnknown
        ]]
		-- 错误事件
        local errorCode = -1
        if value == "errorCreateFile" then
            -- 创建文件失败 没权限?
            yflog:Info("创建文件失败")
            errorCode = 1
        elseif value == "errorNetwork" then
            -- 网络下载失败 网不好?
            yflog:Info("网络下载失败")
            errorCode = 2
        elseif value == "errorUncompress" then
            -- 解压失败 资源坏了?
            yflog:Info("解压失败")
            errorCode = 3
        elseif value == "errorCopyFile" then
            -- 拷贝文件失败
            yflog:Info("拷贝失败")
            errorCode = 4
        elseif value == "errorMD5" then
            -- MD5校验失败
            yflog:Info("MD5校验失败")
            errorCode = 5
        elseif value == "errorUnknown" then
            yflog:Info("errorUnknown wtf?")
        end

        self:downloadFail(errorCode)
    elseif event == "progress" then
    end
end

function Updater:downloadFail(errorCode)
	-- 检查队列中是否仍有下载任务，有则继续下载，无在stop
	if self:checkDownloadQueueHasNext() then
		return
	end

	self:completeDownload()
end

function Updater:checkDownloadQueueHasNext()
	local hasNext = false
	self._downloadIdx = self._downloadIdx + 1
	if self._downloadIdx > #self._downloadList then
		-- 完成下载
		return hasNext
	end

	hasNext = true
	self._isDownloading = true

	local project = self._downloadList[self._downloadIdx]

	if not project or self:isFileDownload(project.value) then
		self:downloadStepSuccess(true)
		return hasNext
	end

	self:downloadFile(project.value)
	return hasNext
end

-- 这一步的文件下载成功，进行下一步
function Updater:downloadStepSuccess(noSave)
	local project = self._downloadList[self._downloadIdx]
	if not noSave then
		-- 标记这个文件已经下载 用于判断文件是否已经下载，可能会存在已下载，但还未及时写入本地res_map,但游戏中断了。
		self:saveFileDownloadInfo(project.value)

        -- 更新本地缓存
        AssetManager:saveFileDownloadInfo(project.value)
	end

	-- 通知回调方执行资源加载
	local cb = project.callback
	if cb then
		cb(project.value[1])
	end

	self._isDownloading = false
end

-- 完成下载
function Updater:completeDownload()
	self:stopDownload()
	self:clearFileDownloadInfo()
	self:saveLocalStarterMap()
    -- 下载完成
end

--[[
    是否需要清空 本地存储
]]
function Updater:clearFileDownloadInfo()
	self._downloadList = {}
	self._downloadInfo = {}
	cc.UserDefault:getInstance():setStringForKey(GAME_UPDATE_PLAYING_DOWNLOAD_LIST, json.encode(self._downloadInfo))
end

--[[
    XXX 是否需要写入本地res_map.txt文件中
]]
function Updater:saveLocalStarterMap()
	-- XXX 下载好了一起存储 优化存储
end

-- ——————————————————————————————————————————————————————————

-- *************  文件处理 *******************
-- 保存下载文件信息
function Updater:saveFileDownloadInfo(value)
	local downloadInfo = self:getFileDownloadInfo()

    -- [url] = md5
	self._downloadInfo[value[1]] = value[2]

	cc.UserDefault:getInstance():setStringForKey(GAME_UPDATE_PLAYING_DOWNLOAD_LIST, json.encode(self._downloadInfo))
	cc.UserDefault:getInstance():flush()
end

-- 获取downloadInfo， reget: 再次取存储数据
function Updater:getFileDownloadInfo(reget)
	if not self._downloadInfo or reget then
		local downloadList = cc.UserDefault:getInstance():getStringForKey(GAME_UPDATE_PLAYING_DOWNLOAD_LIST, "")
		if downloadList == "" then
			self._downloadInfo = {}
		else
			self._downloadInfo = json.decode(downloadList) or {}
		end
	end

	return self._downloadInfo
end

-- 文件是否已下载，download信息: 格式：[res/bil.pk] = 8b8fa82ad6d2b3f3c2ef0c7562baf2e5
function Updater:isFileDownload(value)
	local downloadInfo = self:getFileDownloadInfo()
	return downloadInfo[value[1]] and downloadInfo[value[1]] == value[2]
end
--  --------------------------文件处理 end------------------------------------

return Updater