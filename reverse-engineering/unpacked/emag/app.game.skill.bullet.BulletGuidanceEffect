--[[ 追踪型子弹 ]]
local BulletGuidanceEffect = class("BulletGuidanceEffect", lt.BulletBase)

local Constant = lt.Constant
local GameBoard = lt.GameBoard
local CacheManager = lt.CacheManager
local EffectActor = lt.EffectActor
local TimeTrigger = lt.TimeTrigger
local MapUtil = lt.MapUtil

BulletGuidanceEffect._targetAgentId  = nil
BulletGuidanceEffect._effectActor = nil
local offsetX = -25
local offsetY = -Constant.MODEL_HERO_Y/2

function BulletGuidanceEffect:ctor(skillId)
    BulletGuidanceEffect.super.ctor(self, skillId)
    self._effectNode = display.newNode()
    self._effectNode:setPosition(offsetX, offsetY)
    self:addChild(self._effectNode)

    self._isEndEffect = false
    self._timeTrigger = TimeTrigger.new(1 / Constant.FPS_TL)
    self._nextFrameIndex = 1
    self._traceObjId = nil

end

function BulletGuidanceEffect:onClear()
    if self._effectActor then
        self._effectActor:onClear()
        self._effectActor = nil
    end
    
    self:removeAllChildren()

    self._isEndEffect = nil
    self._effectNode = nil
end

function BulletGuidanceEffect:addEffectActor(skillId,skillLevel)
    local actionInfoMetas = CacheManager:getBulletMetas(skillId,skillLevel)
    if not actionInfoMetas or #actionInfoMetas < 1 then
        return
    end
    local meta = actionInfoMetas[1]
    -- 存在旋转 所以需要加上锚点
    local anchorPoint = self:getAnchorPointByDirection(self._direction)
    self._effectActor = EffectActor.new(meta, self._direction, anchorPoint, true)
    self._effectNode:addChild(self._effectActor)

    self._actionInfoMeta = meta

    self._isEndEffect = true
end

function BulletGuidanceEffect:onUpdate()
    if self._timeTrigger:tick() then
        self:onUpdateMove()
    end
    self:onUpdateEffect()
end

function BulletGuidanceEffect:onUpdateMove()
    if not self:traceCreature() then
		return false;
    end
    self._pixelX = self._pixelX + self._stepX
    self._pixelY = self._pixelY + self._stepY
  
   
    self._pixelZ = self._pixelZ + self._stepZ


    -- 检查是否到达目标位置
    if math.abs(self._pixelX - self._targetX) < self._stepPixel and
    math.abs(self._pixelY - self._targetY) < self._stepPixel and
    math.abs(self._pixelZ - self._targetZ) < self._stepPixel then
        self._pixelX = self._targetX
        self._pixelY = self._targetY
        self._pixelZ = self._targetZ
        self._stepX = 0
        self._stepY = 0
        self._stepZ = 0
        -- self:setPosition(self._pixelX, self._pixelY + self._pixelZ)
        -- lt.ScheduleUtil:performWithDelayGlobal(function()
            self._waitingForClear = true
        -- end, 0)
    end
    self._effectActor:setNextEffectFrameIndex(self._nextFrameIndex)
    self:setPosition(self._pixelX, self._pixelY + self._pixelZ)
    
    self._nextFrameIndex = self._nextFrameIndex + 1
end

function BulletGuidanceEffect:onEnd(isLastGroupMember)
    if isLastGroupMember then
        if type(self._callback) == "function" then
            self._callback()
        end
    end
    self:onClear()
end

function BulletGuidanceEffect:onUpdateEffect()
    if not self._isEndEffect then
		return
	end

    if not self._effectActor then 
        return
    end

    -- self._effectActor:onUpdateEffect()
end

function BulletGuidanceEffect:setEndCallBack(callback)
    self._callback = callback
end


function BulletGuidanceEffect:setTarget(x, y, z, step_pixel)
    -- 保存目标位置
    self._targetX = x
    self._targetY = y
    self._targetZ = z

    -- 计算移动方向
    local moveX = self._targetX - self._pixelX
    local moveY = self._targetY - self._pixelY
    local moveZ = self._targetZ - self._pixelZ


    -- 计算移动长度
    self._len = math.sqrt(moveX * moveX + moveY * moveY + moveZ * moveZ)

    if self._len == 0 then
        self._stepX = 0
        self._stepY = 0
        self._stepZ = 0
    else
        -- 计算单位移动步长
        self._stepX = moveX / self._len * step_pixel
        self._stepY = moveY / self._len * step_pixel
        self._stepZ = moveZ / self._len * step_pixel
    end

    self._stepPixel = step_pixel
end

function BulletGuidanceEffect:setPixelPosition(x, y, z)
    self._pixelX = x;
	self._pixelY = y;
	self._pixelZ = z;
    self:setPosition(self._pixelX, self._pixelY + self._pixelZ)
end

function BulletGuidanceEffect:setDirection(direction)
    self._direction = direction
end

-- traceCreature
function BulletGuidanceEffect:traceCreature()
    local worldAgent = lt.AgentManager:getWorldAgent()
    local traceAgent =  worldAgent:getAgent(self._traceObjId)

	if (traceAgent == nil) then
		self._traceObjId = nil;
		self._waitingForClear = true
		return false;
    end
    local targetM, targetN = traceAgent:getMNExactly()
    local targetX, targetY = MapUtil:MapToPixel(targetM, targetN)
    local targetZ = 70
	-- 현재의 좌표를 읽어온다.
    self:setTarget(targetX, targetY, targetZ, self._stepPixel)
    return true
end

function BulletGuidanceEffect:setStepPixel(stepPixel)
    self._stepPixel = stepPixel
end


function BulletGuidanceEffect:setTraceCreatureID(id)
	self._traceObjId = id; 

	if (id ~= nil ) then
		self:traceCreature();	
    end
end

return BulletGuidanceEffect
