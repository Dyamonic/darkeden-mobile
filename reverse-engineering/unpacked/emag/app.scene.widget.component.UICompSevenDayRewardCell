---@class UICompSevenDayRewardCell
--- 七日奖励Cell
local UICompSevenDayRewardCell = class("UICompSevenDayRewardCell", lt.UIGButtonBase)

local Constant                 = lt.Constant
local CacheManager             = lt.CacheManager
local NtfManager               = lt.NtfManager
local ItemModule               = lt.ItemModule
local SevenDayModule           = lt.SevenDayModule
local RechargeModule           = lt.RechargeModule

function UICompSevenDayRewardCell:ctor()
    UICompSevenDayRewardCell.super.ctor(self)
    self._data = nil
    self._itemInfo = nil
    self._itemMeta = nil
end

function UICompSevenDayRewardCell:onEnter()
    UICompSevenDayRewardCell.super.onEnter(self)
    self._listItem:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    self._btnRecharge:addClickListener(handler(self, self.onBtnGotoClick))
end

function UICompSevenDayRewardCell:onExit()
    self._listItem:removeEventListener(fgui.UIEventType.ClickItem)
    self._btnRecharge:removeClickListener()
    UICompSevenDayRewardCell.super.onExit(self)
end

function UICompSevenDayRewardCell:onClear()
    self._data        = nil
    self._itemInfo    = nil
    self._itemMeta    = nil
    self._lblTitle    = nil
    self._lblDesc     = nil
    self._lblDiscount = nil
    self._listItem    = nil
    self._btnRecharge = nil
    self._imgDiscount = nil
    self._red         = nil
    UICompSevenDayRewardCell.super.onClear(self)
end

function UICompSevenDayRewardCell:onConstruct()
    self._lblTitle    = self:getChild("lbl_name")
    self._lblDesc     = self:getChild("lbl_desc")
    self._lblDiscount = self:getChild("lbl_discount")
    self._listItem    = self:getChild("list")
    self._btnRecharge = self:getChild("btn_recharge")
    self._red         = self._btnRecharge:getChild("red")
    self._imgDiscount = self:getChild("img_discount")
    self._listItem:setItemRenderer(handler(self, self.onRenderItem))
end

function UICompSevenDayRewardCell:setInfo(data, menuIndex)
    self._data = data
    self._menuIndex = menuIndex
    local meta = CacheManager:getSevenDayGiftMeta(data.giftId)
    if not meta then
        return
    end
    self._meta = meta
    self._lblTitle:setText(meta:getGiftName())
    local diacount = meta:getDiscount()
    self._lblDiscount:setText("超值" .. diacount .. "%")
    self._lblDiscount:setVisible(diacount > 0)
    self._imgDiscount:setVisible(diacount > 0)
    -- 价格
    local price = meta:getPrice() or 0
    -- 是否已购买
    local reward_times = data.reward_times     --领取次数
    local recharge_times = data.recharge_times -- 充值次数
    -- 充值的  先充值->领取
    -- 免费   直接领取
    local buyLimit = meta:getBuyLimit()
    local showRed = false
    local isReward = false
    self._iconGrayed = false
    if price == 0 then
        if reward_times >= buyLimit then
            self._btnRecharge:setTitle(GReadText.KET_MAIL_TIPS10)
            self._iconGrayed = true
            isReward = true
        else
            showRed = true
            self._btnRecharge:setTitle(GReadText.KEY_BUTTON_TEXT_FREE)
        end
    else
        if recharge_times > reward_times then
            self._btnRecharge:setTitle(GReadText.KEY_BUTTON_TEXT_RECEIVE)
            showRed = true
        else
            if recharge_times == 0 then
                self._btnRecharge:setTitle("¥" .. price)
            else
                self._btnRecharge:setTitle(GReadText.KET_MAIL_TIPS10)
                self._iconGrayed = true
                isReward = true
            end
        end
    end
    self._red:setVisible(showRed)
    self._btnRecharge:setGrayed(isReward)
    self._listItem:setNumItems(#meta:getFixAward())
end

function UICompSevenDayRewardCell:onRenderItem(index, obj)
    local index = index + 1
    local itemInfo = self._meta:getFixAward()[index]
    local resUrl = ""
    local itemMeta = ""
    local iconPath = ""
    if obj.sprite then
        obj.sprite:removeFromParent()
        obj.sprite = nil
    end
    local icon = obj:getChild("icon")
    if itemInfo[2] == Constant.ItemType.ITEM_TYPE_PROP then
        iconPath = "prop"
        itemMeta = CacheManager:getItemMeta(itemInfo[3])
        resUrl = string.format("ui://Item/%s_%s", iconPath, itemMeta:getIconId())
        icon:setURL(resUrl)
        icon:setVisible(true)
    elseif itemInfo[2] == Constant.ItemType.ITEM_TYPE_EQUIP then
        iconPath = "equip"
        itemMeta = CacheManager:queryEquipMeta(itemInfo[3])

        local iconId = itemMeta:getIconId()
        if iconId then
            local sprite = lt.CommonFunc.createEquipById(iconId, 0, 0)
            obj:displayObject():addChild(sprite)
            local pos = icon:getPosition()
            sprite:setPosition(pos.x, pos.y)
            local scale = 30 / sprite:getContentSize().width
            sprite:setScale(scale, scale)
            obj.sprite = sprite
        end
        icon:setVisible(false)
    end
    local num = lt.StringManager:convert4BitNumber(itemInfo[4])
    obj:getChild("lbl_num"):setText(num)
    obj:setGrayed(self._iconGrayed)
    obj.itemInfo = itemInfo
    obj.itemMeta = itemMeta
end

function UICompSevenDayRewardCell:onClickItem(context)
    local data     = context:getData()
    self._item     = data
    self._itemInfo = data.itemInfo
    self._itemMeta = data.itemMeta
    self:showTips()
end

function UICompSevenDayRewardCell:showTips()
    local itemType = self._itemMeta:getItemType()
    if itemType == Constant.ItemType.ITEM_TYPE_PROP then
        self:showPropTips()
    elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
        self:showEquipTips()
    end
end

function UICompSevenDayRewardCell:showPropTips()
    local itemInfo = ItemModule:getItemDataByConfig(self._itemMeta, self._itemInfo[5], self._itemInfo[4])
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,
        { itemInfo = itemInfo, pivot = cc.p(0, 0.5), tipsType = Constant.PROPTIPS_FORM.Display })
end

function UICompSevenDayRewardCell:showEquipTips()
    local itemInfo = ItemModule:getItemDataByConfig(self._itemMeta, self._itemInfo[5], self._itemInfo[4])
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,
        { itemInfo = itemInfo, tipsType = Constant.EquipShowTipsType.Display })
end

function UICompSevenDayRewardCell:onBtnGotoClick(target)
    -- 拉起支付 or 领取
    local giftId = self._meta:getGiftId()
    local rewardInfo = SevenDayModule:getSevenDayRewardInfo(self._menuIndex, giftId)
    -- 价格
    local price = self._meta:getPrice() or 0
    local buyLimit = self._meta:getBuyLimit()
    local reward_times = self._data.reward_times --领取次数
    if not rewardInfo then
        if price == 0 then                       -- 免费领取
            if reward_times >= buyLimit then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = GReadText.KET_MAIL_TIPS10 })
            else
                SevenDayModule:onGetSevenDayRewardReq(self._menuIndex, SevenDayModule.CONTROL_INDEX.REWARD, giftId)
            end
        else
            local recharge_times = self._data.recharge_times -- 充值次数
            if reward_times < recharge_times then
                SevenDayModule:onGetSevenDayRewardReq(self._menuIndex, SevenDayModule.CONTROL_INDEX.REWARD, giftId)
            else
                if recharge_times == reward_times and recharge_times > 0 then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = GReadText.KET_MAIL_TIPS10 })
                else
                    local rechargeId = self._meta:getRechargeId()
                    RechargeModule:sendCreateOrder(rechargeId)
                end
            end
        end
    end
end

return UICompSevenDayRewardCell
