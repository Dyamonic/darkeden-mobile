local NpcVampireLairDao = {}

function NpcVampireLairDao:queryAll()
    local mapTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM NpcVampireLair") do
        local mapMeta = lt.NpcVampireLairMeta.new(row)
        mapTable[mapMeta:getMapCode()] = mapMeta
    end
    return mapTable
end

return NpcVampireLairDao
