---@查看他人角色信息
---@class UIWndCheckRoleInfo:UIWindowBase
local UIWndCheckRoleInfo = class("UIWndCheckRoleInfo", lt.UIWindowBase)

local NtfManager         = lt.NtfManager
local CacheManager       = lt.CacheManager
local RankModule         = lt.RankModule
local Constant           = lt.Constant
local RaceSkinRes        = Constant.RaceSkinRes


UIWndCheckRoleInfo.ChangeSkinConfImg = {
    ["RoleInfo"] = {
        ["bg"] = "bg_cyxx_dikuang",
        ["n4"] = "bg_cyxx_kuang_01",
        ["n7"] = "bg_cyxx_kuang_02",
        ["n10"] = "bg_cyxx_kuang_02",
        ["n13"] = "bg_cyxx_kuang_02",
        ["n16"] = "bg_cyxx_kuang_02",
        ["n19"] = "bg_cyxx_kuang_03",
        ["n22"] = "bg_cyxx_kuang_03",
        ["n25"] = "bg_cyxx_kuang_03",
        ["n28"] = "bg_cyxx_kuang_03",
    },
}

function UIWndCheckRoleInfo:ctor(param)
    UIWndCheckRoleInfo.super.ctor(self, param)
end

function UIWndCheckRoleInfo:onInit()
    UIWndCheckRoleInfo.super.onInit(self, _GURL.CheckRoleInfo)
    self._icon          = self:getChild("icon")
    self._imgGuild      = self:getChild("img_guild")
    self._imgGradeLevel = self:getChild("img_gradeLevel")
    self._lblName       = self:getChild("lbl_name")
    self._lblGrade      = self:getChild("lbl_grade")
    self._lblGuildName  = self:getChild("lbl_guildName")
    self._lblJob        = self:getChild("lbl_job")
    self._lblRepute     = self:getChild("lbl_repute")
    self._lblStr        = self:getChild("lbl_str")
    self._lblDex        = self:getChild("lbl_dex")
    self._lblInte       = self:getChild("lbl_inte")
    self._lblTendencies = self:getChild("lbl_tendencies")
end

function UIWndCheckRoleInfo:onShown()
    local param = self:getParam() or {}
    self:refreshHeroInfo(param.role)
end

function UIWndCheckRoleInfo:onHide()
	UIWndCheckRoleInfo.super.onHide(self)
end	

function UIWndCheckRoleInfo:onClear()
    self._icon          = nil
    self._imgGuild      = nil
    self._imgGradeLevel = nil
    self._lblName       = nil
    self._lblGrade      = nil
    self._lblGuildName  = nil
    self._lblJob        = nil
    self._lblRepute     = nil
    self._lblStr        = nil
    self._lblDex        = nil
    self._lblInte       = nil
    self._lblTendencies = nil
    UIWndCheckRoleInfo.super.onClear(self)
end

function UIWndCheckRoleInfo:refreshHeroInfo(role)
    local role = role
    local urlPath = ""
    local race = role.race
    if race == Constant.RaceType.Ousters then
        urlPath = _GURL.ImageOuterHead
    elseif race == Constant.RaceType.Vampire then
        urlPath = string.format(_GURL.GetImageVarHead, role.sex)
    elseif race == Constant.RaceType.Slayer then
        urlPath = string.format(_GURL.GetImageHead, role.faceShape)
    end
    self._icon:setURL(urlPath)
    self._imgGuild:setURL(string.format(_GURL.GetGuildIcon, role.guildIcon))
    local rankData = CacheManager:getRoleRankByRaceAndLvl(race, role.gradeLevel)
    self._imgGradeLevel:setURL(string.format(_GURL.GetGradePath, rankData and rankData:getIconId() or ""))
    self._lblName:setText(role.playerName)
    self._lblGrade:setText(rankData and rankData:getName() or "")
    self._lblGuildName:setText(role.guildName)
    self._lblJob:setText(Constant.JobStr[role.icon] or "")
    self._lblRepute:setText(role.repute)
    self._lblStr:setText(role.str .. "/" .. role.strTotal)
    self._lblDex:setText(role.dex .. "/" .. role.dexTotal)    --敏捷
    self._lblInte:setText(role.inte .. "/" .. role.inteTotal) --智力
    self._lblTendencies:setText(CacheManager:getTendencyNameByValue(role.tendencies))

    for pkgName, pkgConf in pairs(self.ChangeSkinConfImg) do
        self:changeSkin(pkgConf, self, pkgName, race)
    end
end

function UIWndCheckRoleInfo:changeSkin(conf, parent, pkgName, race)
    if not conf then return end
    if parent == nil then return end

    for name, resPathConf in pairs(conf) do
        local childNode = parent:getChild(name)
        if not childNode then
            print("changeskin not found", name)
        end
        if type(resPathConf) == "table" then
            self:changeSkin(resPathConf, childNode, pkgName)
        elseif type(resPathConf) == "string" then
            local url = string.format("ui://%s/%s%s", pkgName, resPathConf, RaceSkinRes[race])
            -- print("change skin url",url)
            childNode:setURL(url)
        end
    end
end

function UIWndCheckRoleInfo:colseView()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndCheckRoleInfo", close = true })
end

return UIWndCheckRoleInfo
