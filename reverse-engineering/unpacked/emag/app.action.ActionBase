local ActionBase = class("ActionBase")

local CacheManager = lt.CacheManager
local NtfManager = lt.NtfManager
local AssetManager = lt.AssetManager

ActionBase._modelName         = nil
ActionBase._modelId           = nil
ActionBase._actionId          = nil
ActionBase._direction         = nil

ActionBase._frameCount        = nil  -- 当前动作和方向 有多少帧，配置在文件内

ActionBase._loop             = nil
ActionBase._spriteFrameArray = nil
ActionBase._waitSpriteFrameTable = nil
ActionBase._spriteInfoArray  = nil
ActionBase._use              = nil

-- action动作文件
ActionBase._actionData       = nil
ActionBase._dataFrameArray   = nil  -- 获取当前动作帧数下的frame对象
ActionBase._spriteFrameTable = nil  -- 缓存已加载的spriteId 用于重复加载判断

--[[
     action类型
     1: hero    玩家角色
     2: monster 怪物
     3: npc     npc
     4: trap    陷阱
]]
ActionBase.ACTION_TYPE = {
    HERO    = 1, 
    MONSTER = 2, 
    NPC     = 3, 
    TRAP    = 4, 
}
ActionBase._actionType       = nil

--[[ 
    modelName  模型名称：角色 武器 影子 怪物等等
    modelId    模型编号
    actionId   动作id
    direction  方向id
]]

function ActionBase:ctor(modelName, modelId, actionId, direction, loop, isShadow)
    self._modelName = modelName
    self._modelId = modelId  -- 人物无 modelId
    self._actionId = actionId
    self._direction = direction
    self._isShadow = isShadow

    self._loop = loop

    -- 初始化表
    self._spriteFrameArray = {}
    self._waitSpriteFrameTable = {}
    self._spriteInfoArray = {}
    self._spriteFrameTable = {}
    self._dataFrameArray = {}
    self._use = 1
    self._atlasSum = 1   -- 默认 atlas 贴图数量为1
    self._atlasCur = 0

    self._tag = string.format("ActionBase_%s_%d_%d_%d", modelName, modelId, actionId, direction)


    local attackTime, moveInterval
    if self._actionType == self.ACTION_TYPE.HERO then
        -- 角色外观表
        local meta = CacheManager:getRoleModelMeta(modelName)
        if not meta then
            yflog:Error("ActionBase RoleModelMeta is nil modelName: %s", modelName)
            return
        end
        
        self._atlasSum = meta:getAtlasCount()
    elseif self._actionType == self.ACTION_TYPE.MONSTER
        or self._actionType == self.ACTION_TYPE.NPC then
        -- 模型表
        local meta = CacheManager:getModelMeta(modelId)
        if not meta then
            yflog:Error("ActionBase MONSTER ModelMeta is nil modelName: %s modelId: %s", modelName, modelId)
            return
        end

        self._atlasSum = meta:getAtlasCount()
        attackTime = meta:getAttackTime()
        moveInterval = meta:getMoveInterval()
    end

    self:loadActionData()

    self._step = self:getActionStep(actionId, attackTime, moveInterval)

    -- 加载图集
    self:loadAtlas(modelName, modelId)
end

function ActionBase:clear()
    self._actionData = nil
    self._spriteFrameArray = nil
    self._waitSpriteFrameTable = nil
    self._spriteInfoArray = nil
    self._dataFrameArray = nil

    if self._spriteFrameTable then
        for key, spriteFrame in pairs(self._spriteFrameTable) do
            spriteFrame:release() 
        end

        self._spriteFrameTable = nil
    end
end

function ActionBase:loadActionData()
end

-- step 用于每个动作帧的播放速度间隔  
-- 如每帧间隔为0.0167  ACTION_IDLE 为 0.333 则站立为20帧播放一张图片 0.0167*20 = 0.334
-- function ActionBase:calcStep()
--     -- 一个动作以160帧为基础
--     local delta = lt.GameBoard:getDeltaTime()  -- 0.0167
--     local interval = math.floor(self._frameCount/160)
-- end

--[[
    action 0 framecount 150  stand
    action 1 framecount 8    move
    action 2 framecount 4
    action 3 framecount 15
    action 4 framecount 72
    action 5 framecount 72
    action 6 framecount 25
    action 7 framecount 20
    action 8 framecount 15
    action 9 framecount 13
    action 10 framecount 11
    action 11 framecount 15
    action 12 framecount 13
    action 13 framecount 11

]]
function ActionBase:getActionStep(actionId, attackTime)    
    -- yflog:Info("ActionBase:getActionStep:%d", actionId)
    if actionId == 1 then
        -- 走路的帧播放速度
        return (lt.Constant.MAP_BLOCK_HEIGHT / (lt.Constant.HERO_RUN_SPEED * self._frameCount))
    elseif actionId == 0 then
        local interval = 0.0167 * (1 + math.floor(120/self._frameCount))
        return interval
    elseif actionId == 8 then
        return 0.05
    else
        return 0.05
    end
end

-- 加载图集
function ActionBase:loadAtlas(modelName)
    local ntfMessage = string.format( "%s_%s",NtfManager.NTF.SPRITE_FRAME_LOADED_ACTOR,modelName)
    for i=1, self._atlasSum do
        local dataFilename = ""
        local imageFilename = ""
        if self._actionType == self.ACTION_TYPE.HERO then
            dataFilename = string.format("tlmodel/role/%s_%d.plist", modelName, i)
            imageFilename = string.format("tlmodel/role/%s_%d.pvr.ccz", modelName, i)
        else
            dataFilename = string.format("tlmodel/monster/%s_%d_%d.plist", modelName, self._modelId,i)
            imageFilename = string.format("tlmodel/monster/%s_%d_%d.pvr.ccz", modelName, self._modelId, i)
        end
        -- yflog:Info("dataFilename = %s", dataFilename)

        if lt.ActionManager:loadAtlas(dataFilename, imageFilename, ntfMessage) then
            -- 取缓存的图集
            self:loadAtlasStep()
        else
            self._waitSpriteFrameTable[dataFilename] = true
        end

        self._spriteInfoArray[#self._spriteInfoArray + 1] = {dataFilename = dataFilename, imageFilename = imageFilename}
    end

    -- 等待加载完成后的监听
    if next(self._waitSpriteFrameTable) ~= nil then
        NtfManager:addNtfListener(ntfMessage, handler(self, self.spriteFrameLoadedNtf), self._tag)
    end
end

-- 远程加载图集
function ActionBase:loadAtlasFromRemote(modelName)
    for i=1, self._atlasSum do
        local path = ""
        if self._actionType == self.ACTION_TYPE.HERO then
            path = string.format("tlmodel/role/%s_%d", modelName, i)
        else
            path = string.format("tlmodel/monster/%s_%d_%d", modelName, self._modelId, i)
        end
        -- yflog:Info("path = %s", path)
        --[[ 
            是否开启边玩边下载 先屏蔽了
        ]]
        local isRemote = AssetManager:loadRemoteAtlas(path, AssetManager.REMOTE_LOADER_TYPE_MODEL, handler(self, self.onLoadCallback))
    end
end

-- 边玩边下 callback
function ActionBase:onLoadCallback(path)
    local pathinfo = io.pathinfo(path)
    -- res/xxx/xxx.zip  特殊格式处理
    if pathinfo.extname == ".zip" then
        path = pathinfo.dirname .. pathinfo.basename
        path = path:sub(5)
    end

    local dataFilename = string.format("%s.plist", path)
    local imageFilename = string.format("%s.pvr.ccz", path)

    -- yflog:Info("actionBase dataFilename = %s", dataFilename)
    if lt.ActionManager:loadAtlas(dataFilename, imageFilename) then
        -- 取缓存的图集
        self:loadAtlasStep()
    else
        self._waitSpriteFrameTable[dataFilename] = true
    end

    self._spriteInfoArray[#self._spriteInfoArray + 1] = {dataFilename = dataFilename, imageFilename = imageFilename}

    if next(self._waitSpriteFrameTable) ~= nil then
        NtfManager:addNtfListener(NtfManager.NTF.SPRITE_FRAME_LOADED, handler(self, self.spriteFrameLoadedNtf), self._tag)
    end
end

-- 图集加载完成通知
function ActionBase:spriteFrameLoadedNtf(event)
    event = event or {}
    event.param = event.param or {}
    local dataFilename = event.param.dataFilename or ""
    if self._waitSpriteFrameTable and self._waitSpriteFrameTable[dataFilename] then
        self._waitSpriteFrameTable[dataFilename] = nil

        self:loadAtlasStep()

        if next(self._waitSpriteFrameTable) == nil and self._tag then
            NtfManager:removeNtfListenerByTag(self._tag)
            self._tag = nil
        end
    end

    
end

-- 图集全部加载完成
function ActionBase:loadAtlasStep()
    self._atlasCur = self._atlasCur + 1
    if self._atlasCur == self._atlasSum then
        self:loadSpriteFrame()
    end
end

function ActionBase:loadSpriteFrame()
    if not self._frameCount then
        yflog:Info("ActionBase:loadSpriteFrame() frameCount is nil")
        return
    end
    for i = 1, self._frameCount do
        local frame = self:calcFrameActor(i)
        local path =  frame.path
        

        if not self._spriteFrameTable[path] then
            local spriteFrame = cc.SpriteFrameCache:getInstance():getSpriteFrame(path)
            if spriteFrame then
                spriteFrame:retain()
            else
                -- print("============================== loadTlSpriteFrame no SpriteFrame ", path, i," ==============================")
                yflog:InfoLine("********** loadSpriteFrame no SpriteFrame:%s", path)
                yflog:Info("modelName:%s, modelId:%s, actionId:%s, direction:%s",tostring(self._modelName),
                                tostring(self._modelId),tostring(self._actionId),tostring(self._direction))
            end

            self._spriteFrameTable[path] = spriteFrame
        end
        if self._spriteFrameTable[path] then
            local size = self._spriteFrameTable[path]:getOriginalSize()
            frame.sprite = self._spriteFrameTable[path]
            frame.size = size
            frame.width = size.width
            frame.height = size.height

            self._spriteFrameArray[#self._spriteFrameArray + 1] = frame
        end
    end
end

--[[
    frame结构：
        spriteId:
        x:
        y:
        size:{width, height}
]]
function ActionBase:calcFrameActor(idx, modelId)
    local frame = self:getActorFrame(idx)
    if not frame then
        yflog:Error("frame is nil, id is:%d", idx)
        return
    end

    local spriteId = frame.spriteId

    -- 角色只需要modelName
    if self._actionType == self.ACTION_TYPE.HERO then
        local path = string.format("%s_%d.png", self._modelName, spriteId)
        return {path = path, x = frame.x, y = frame.y, width = 0, height = 0, size={}}
    end

    local path = string.format("%s_%d_%d.png", self._modelName, self._modelId, spriteId)
    return {path = path, x = frame.x, y = frame.y, width = 0, height = 0, size={}}
end

function ActionBase:getActorFrame(idx)
    return self._dataFrameArray[idx]
end

function ActionBase:getFrameArray()
    return self._dataFrameArray
end

function ActionBase:getFrameCount()
    return self._frameCount
end

-- Setter && Getter
function ActionBase:getSpriteFrame(idx)
    return self._spriteFrameArray[idx]
end

function ActionBase:getSpriteFrameCount()
    return #self._spriteFrameArray
end

-- 根据动作定义脚步声音间隔
function ActionBase:getStep()
    return self._step
end

function ActionBase:getLoop()
    return self._loop
end

function ActionBase:addUse()
    self._use = self._use + 1
end

function ActionBase:setUse(use)
    self._use = use
end

function ActionBase:getUse()
    return self._use
end

return ActionBase