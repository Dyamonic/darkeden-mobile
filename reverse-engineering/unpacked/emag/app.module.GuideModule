-- 引导
local GuideModule = {}

local SocketApi     = lt.SocketApi
local netcmd_pb     = lt.netcmd_pb
local CommonModule  = lt.CommonModule
local ServerCmdDef  = lt.ServerCmdDef
local ClientCmdDef  = lt.ClientCmdDef
local NtfManager    = lt.NtfManager
local CacheManager  = lt.CacheManager
local Constant      = lt.Constant
local ConfigLoader  = lt.ConfigLoader

GuideModule._guideList = nil
GuideModule._currentGudieId = 0
GuideModule._currentTrunkId = 0

local FRONT_TYPE = {
    GUIDE = 1,          --引导前置
    TASK_START = 2,     --任务前置(任务状态=1)
    TASK_FINISH = 3,    --任务前置(任务状态=2)
    LEVEL = 4,          --等级前置
}

--引导开启
local GuideOpen = 1

function GuideModule:init()
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GUIDE_STR_RESP), handler(self, self.onGuideList), "GuideModule:onGuideList")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_SET_GUIDE_STR_RESP), handler(self, self.onGuideSave), "GuideModule:onGuideSave")
end

function GuideModule:clear()
    SocketApi:removeProtoListenerByTag("GuideModule:onGuideList")
    SocketApi:removeProtoListenerByTag("GuideModule:onGuideSave")
    self._guideList = nil
    self._heroData = nil
end

--引导数据请求
function GuideModule:sendGuideListReq()
    local msg = netcmd_pb.CS_CommonReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GUIDE_STR_REQ), msg)
end

function GuideModule:onGuideList(event)
    lt.LogUtil:debugInfo("GuideModule:onGuideList")
    local proto = event.param
    local ret = proto.ret
    self._guideList = {}
    if ret == 0 then
        local guideMap = proto.guideMap
        for i = 1, #guideMap do
            self._guideList[guideMap[i].key] = guideMap[i].value
        end
        --检查是否需要弹新人弹窗
        lt.ScheduleUtil:performWithDelayGlobal(function()
            if not self:isGuideFinish(Constant.GUIDE_ID.FIRST_GUIDE) then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndGuideStart"})
            else
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_CHECK_GUIDE_EVENT)
            end
        end, 0.2)
    end
end

--引导数据保存
function GuideModule:sendGuideListSave(guideId)
    local msg = netcmd_pb.CS_SetGuideStrReq()
    msg.keyGuide = guideId
    msg.value = 1
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_SET_GUIDE_STR_REQ), msg)
end

function GuideModule:onGuideSave(event)
    lt.LogUtil:debugInfo("GuideModule:onGuideSave")
end

--获取引导列表
function GuideModule:getGuideList()
    return self._guideList
end

--获取当前引导Id
function GuideModule:getCurrentGuideId()
    return self._currentGudieId
end

--开始引导
function GuideModule:startGuide(guideId, btn, pos, poslist)
    self._currentGudieId = guideId
    self._currentTrunkId = math.floor(guideId/1000)
    local size = btn:getSize()
    if pos == nil then
        pos = btn:displayObject():convertToWorldSpace(btn:getPosition())
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUIDE_START, {guideId = guideId, pos = pos, size = size, poslist = poslist})
end

--检测引导id是否完成
function GuideModule:isGuideFinish(guideId)
    if self._guideList == nil then
        return true
    end
    if self._guideList[guideId] then
        return true
    end
    return false
end

--判断是否可以进行引导
function GuideModule:checkCanGuide(guideId)
    --新人引导
    if not self:isGuideFinish(Constant.GUIDE_ID.FIRST_GUIDE) then
        return false
    end

    --是否有正在进行的引导
    if self._currentGudieId ~= 0 then
        return false
    end

    --判断引导是否完成
    if self:isGuideFinish(guideId) then
        return false
    end

    --判断引导是否为当前链条
    local trunkId = math.floor(guideId/1000)
    if self._currentTrunkId ~= 0 and self._currentTrunkId ~= trunkId then
        return false
    end

    local guideMeta = CacheManager:getGuideMeta(guideId)

    if guideMeta == nil then
        return false
    end

    --判断该引导是否开启
    if guideMeta:getSwitch() ~= GuideOpen then
        return false
    end

    --判断前置条件是否完成
    local frontParam = guideMeta:getFrontId()
    if #frontParam > 0 then
        for i = 1, #frontParam do
            local frontParams = string.split(frontParam[i], ",")
            local frontType = tonumber(frontParams[1])
            local frontId = tonumber(frontParams[2])
            if frontType == FRONT_TYPE.GUIDE then
                if self:isGuideFinish(frontId) then
                    return true
                end
            elseif frontType == FRONT_TYPE.TASK_START then
                local task = lt.TaskModule:getTaskById(frontId)
                if task and task.taskState == Constant.TASK_STATE.START then
                    local taskCfg = CacheManager:getMissionMeta(frontId)
                    if taskCfg:getMissionType() == Constant.TASK_TYPES.TRUNK then
                        if lt.TaskModule:getMainTaskId() == frontId then
                            return true
                        end
                    else
                        return true
                    end
                end
            elseif frontType == FRONT_TYPE.TASK_FINISH then
                local task = lt.TaskModule:getTaskById(frontId)
                if task and task.taskState == Constant.TASK_STATE.FINISH then
                    return true
                end
            elseif frontType == FRONT_TYPE.LEVEL then
                local heroData = self:getHeroData()
                if heroData then
                    local level = heroData:getLevel()
                    if level >= frontId then
                        return true
                    end
                end
            end
        end
        return false
    end

    return true
end

--触发引导
function GuideModule:triggerGuide(guideId, btn, pos, callback, poslist)
    self._callback = callback
    self:startGuide(guideId, btn, pos, poslist)
end

--直接结束引导
function GuideModule:directEndGuide(guideIds)
    --判断引导是否完成
    for i = 1, #guideIds do
        if not self:isGuideFinish(guideIds[i]) then
            self._guideList[guideIds[i]] = 1
            self:sendGuideListSave(guideIds[i])
            self:checkGuideData(guideIds[i])
        end
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CHECK_GUIDE_EVENT)
end

function GuideModule:checkGuideData(guideId)
    --检测是否为当前引导
    if guideId == self._currentGudieId then
        self._currentGudieId = 0
    end
    --判断是否为最后一步
    if guideId ~= Constant.GUIDE_ID.FIRST_GUIDE then
        local guideMeta = CacheManager:getGuideMeta(guideId)
        if guideMeta:getIsDone() == 1 then
            self._currentTrunkId = 0
        else
            self._currentTrunkId = math.floor(guideId/1000)
        end
    else
        self._currentTrunkId = 0
    end
end

--结束引导
function GuideModule:endGuide(guideId)
    if guideId == nil then
        guideId = self._currentGudieId
    end
    self._currentGudieId = 0

    --判断是否为最后一步
    local guideMeta = CacheManager:getGuideMeta(guideId)
    if guideMeta == nil then
        return
    end
    
    if guideMeta:getIsDone() == 1 then
        self._currentTrunkId = 0
    end

    if not self:isGuideFinish(guideId) then
        self._guideList[guideId] = 1
        self:sendGuideListSave(guideId)
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_GUIDE_END)
end

function GuideModule:runCallback()
    if self._callback then
        self._callback()
    end
end

function GuideModule:getHeroData()
    return lt.GameModule:getHeroData()
end

return GuideModule