
local ViewDao = {}

function ViewDao:query(viewId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM View WHERE ViewID=%d;", tonumber(viewId))) do
    	local viewMeta = lt.ViewMeta.new(row)
        return viewMeta
    end
end

function ViewDao:queryAll()
    local mapTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM View") do
        local mapMeta = lt.ViewMeta.new(row)
        mapTable[#mapTable+1] = mapMeta
    end
    return mapTable
end

return ViewDao
