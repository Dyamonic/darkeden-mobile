---@class CompSelectRoleItem 单个选角预制体
local CompSelectRoleItem = class("CompSelectRoleItem", lt.UIGButtonBase, lt.UICompChangeSkin)
local Constant = lt.Constant
local NtfManager = lt.NtfManager
local RoleModule = lt.RoleModule
local stepTime = 0.12
function CompSelectRoleItem:ctor()
    CompSelectRoleItem.super.ctor(self)
    self._roleModel = nil
end
   
function CompSelectRoleItem:onConstruct()
    self._btnSelect = self:getChild("btn")
    self._btnDel = self:getChild("btnDel")
    self._txtName = self:getChild("name")
    self._spineNode = self:getChild("spineNode")
end

function CompSelectRoleItem:onClear()
    self._btnDel = nil
    self._txtName = nil
    self._spineNode = nil
    self._roleModel = nil
    CompSelectRoleItem.super.onClear(self)
end

function CompSelectRoleItem:resetModel()
    self._roleModel:removeFromParent()
    self._roleModel = nil
    self:setName("")
end

function CompSelectRoleItem:onEnter()
    self._btnSelect:addClickListener(handler(self, self.onClick))
    self._btnDel:addClickListener(handler(self, self.onDeleteBtnClick))
end
function CompSelectRoleItem:onExit()
    self._btnSelect:removeClickListener()
    self._btnDel:removeClickListener()
end

function CompSelectRoleItem:setFromWnd(wnd)
    self._fromWnd = wnd
end

function CompSelectRoleItem:onClick()
    local preIndex = self._fromWnd:getSelectIndex()
    self._fromWnd:setSelectIndex(self._index)
    self._fromWnd:refreshUI()

    -- 点击直接进入游戏  not self._showDel --TODO
    if preIndex == self._index then -- 选中是一个按钮 点击删除做一下互斥
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SELECT_ROLE_ENTER_GAME)
    else
        self._fromWnd:playSelectAction()
    end
end

function CompSelectRoleItem:onDeleteBtnClick()
    self._fromWnd:setSelectIndex(self._index)
    local roleArray = RoleModule:getRoleArray()
    local curRole = roleArray[self._index]
    if curRole then
        local roleName = curRole._name
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX_REMOVE, {
            closeLimitFunc = function(name)
                if name ~= roleName then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_DELETE_NAME_ERROR})
                    return true
                end
            end,
            confirmCallback = function()
                RoleModule:deleteRoleReq(roleName)
            end,
            cancelCallback = function()
            end
        })
    end
end

function CompSelectRoleItem:setSelectRoleItemInfo(roleInfo)
    self._index = roleInfo.index
end

function CompSelectRoleItem:setTouch(isTouch)
    self:setTouchable(isTouch)
end
function CompSelectRoleItem:setName(name)
    self._txtName:setText(name)
end
function CompSelectRoleItem:setModelVisible(isVisible)
    if  self._roleModel then
        self._roleModel:setVisible(isVisible)
    end
end

---人物模型
function CompSelectRoleItem:createRoleModel(roleData, index)
    local job = roleData:getJob()
    local sex = roleData:getSex()
    local hairColorIndex = roleData:getHairColor()
    local skinColorIndex = roleData:getSkinColor()

    if not self._roleModel then
        local heroData = RoleModule:createHeroData(0, {
            race         = job,
            gender       = sex,
            hair         = hairColorIndex,
            skin         = skinColorIndex,
            faceShape    = roleData:getFaceShape(),
            advanced     = roleData:getAdvanced(),
            weaponAppr   = roleData:getWeaponAppr(),
            shieldAppr   = roleData:getShieldAppr(),
            helmetAppr   = roleData:getHelmetAppr(),
            bodyAppr     = roleData:getBodyAppr(),
            trousersAppr = roleData:getTrousersAppr(),
        })

        local roleModel = lt.UIHeroActor.new(heroData, Constant.DIRECTION_DOWN, true)
        self._spineNode:displayObject():addChild(roleModel)
        self._roleModel = roleModel
        roleModel:setScale(RoleModule:getScaleRole())
        self:roleModelPlayAction(roleModel,index == self._selectIndex,job,roleData:getWeaponAppr())
        roleModel:setPosition(cc.p(110, 120))
    end
end

function CompSelectRoleItem:getRoleModel()
    return self._roleModel
end

function CompSelectRoleItem:roleModelPlayAction(roleModel,isMove,job,weapon)
    if not roleModel then
        return
    end

    local weaponType = nil
    if weapon and weapon ~= "" then
        local weaponId = tonumber(string.split(weapon,",")[1])
        -- yflog:Info("weaponId-------------->>>> %s %s",weaponId,Constant.WeaponType.BattleWheel)
        if type(weaponId) == "number" then
            local weaponMeta = lt.CacheManager:queryEquipMeta(weaponId)
            if weaponMeta then
                weaponType = weaponMeta:getType()
            end
            -- yflog:Info("weaponType-------------->>>> %s",weaponType)
        end
    end
    if isMove then
        local moveAction = Constant.ROLE_ACTION_MOVE
        if job == Constant.RaceType.Ousters and weaponType ~= Constant.WeaponType.BattleWheel then
            moveAction = Constant.ACTION_OUSTERS_MOVE
        end
        roleModel:playActionUI(moveAction,stepTime)
    else
        local actionId = Constant.ROLE_ACTION_IDLE
        if job == Constant.RaceType.Ousters and weaponType ~= Constant.WeaponType.BattleWheel then
            actionId = Constant.ACTION_OUSTERS_STAND
        end
        roleModel:playActionUI(actionId)
    end
end





return CompSelectRoleItem