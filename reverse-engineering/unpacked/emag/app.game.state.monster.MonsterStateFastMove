local MonsterStateFastMove = class("MonsterStateFastMove", lt.MonsterStateBase)

local MapUtil = lt.MapUtil
local AgentManager = lt.AgentManager
local Constant = lt.Constant
local PI = 3.141592


-- 目标位置
MonsterStateFastMove._mTarget       = nil
MonsterStateFastMove._nTarget       = nil
MonsterStateFastMove._xTarget       = nil
MonsterStateFastMove._yTarget       = nil

-- hero位置
MonsterStateFastMove._mHeroX = nil
MonsterStateFastMove._mHeroY = nil

--[[
    技能: 分身术 血腥扭曲
]]

function MonsterStateFastMove:ctor(monsterAgent, mTarget, nTarget, skillId)
    MonsterStateFastMove.super.ctor(self, monsterAgent)

    self._skillId = skillId
    self._isEnd = false
    self._fastMoveShadowMax = 2
    if self._skillId == lt.SkillEnum.MAGIC_BLOODY_ZENITH then
        self._fastMoveShadowMax = 8
    end
    self:initMove(mTarget, nTarget)
end

function MonsterStateFastMove:onClear()
end

function MonsterStateFastMove:initMove(mNext, nNext)
    -- hero 目标格子位置
    self._mTarget = mNext
    self._nTarget = nNext
    self._monsterActor = self._monsterAgent:getActor()

    -- 转换坐标
    self._xTarget, self._yTarget = MapUtil:calcMNMid(self._mTarget, self._nTarget)

    -- 设置方向
    local xHero, yHero = self._monsterAgent:getPosition()

    -- 换算方向
    local direction = MapUtil:calcDirectionXY(self._xTarget - xHero, self._yTarget - yHero)
    self._monsterAgent:setDirection(direction)
    self._mHeroX = xHero
    self._mHeroY = yHero
    self._oMHeroX = xHero
    self._oMHeroY = yHero

    -- 修改MapAgent的AgentSystem
    local mapAgent = AgentManager:getWorldAgent():getMapAgent()
    mapAgent:changeAgentMN(self._monsterAgent, self._mTarget, self._nTarget)

    -- 总的位移距离
    self._directionVO = cc.pSub(cc.p(self._xTarget, self._yTarget), cc.p(self._oMHeroX, self._oMHeroY))

    -- 播放平移动画
    self._monsterAgent:playAction(Constant.ROLE_ACTION_MOVE)
    self._monsterActor:setNextFrameIndex(4)
    self._monsterActor:updateFrame(true)

    self._showMultiple = true
end

function MonsterStateFastMove:getMapActor()
    local worldAgent = AgentManager:getWorldAgent()
    if not worldAgent then
        return nil
    end

    local mapAgent = worldAgent:getMapAgent()
    if not mapAgent then
        return nil
    end

    local mapActor = mapAgent:getMapActor()
    if not mapActor then
        return nil
    end

    return mapActor
end


function MonsterStateFastMove:createPhantom(phase,curIndex,isSecond)
    local addIndex = 0
    if isSecond then
        addIndex = 1
    end
    -- 创造影子
    local startPos = cc.p(self._monsterAgent:getPosition())
    local phantom = self._monsterActor:clone(phase+addIndex)  -- 克隆角色
    phantom:setAnchorPoint(0.5,0)
    self._xTarget, self._yTarget = MapUtil:calcMNMid(self._mTarget, self._nTarget)
    local offsetXY = self:getOffectXYByDirection(self._monsterActor:getDirection())
    local offsetX = offsetXY.x*phase
    local offsetY = offsetXY.y*phase
    local offsetSinX = 0
    local offsetSinY = 0
    if self._skillId == lt.SkillEnum.MAGIC_BLOODY_ZENITH then
        local function getDirectionFlag(value)
            return value > 0 and 1 or (value == 0 and 0 or -1)
        end

        local flagX = getDirectionFlag(offsetXY.x)
        local flagY = getDirectionFlag(offsetXY.y)

        offsetX = (phase ~= 0 and flagX * math.abs(self._directionVO.x) / self._fastMoveShadowMax * phase) or 0
        offsetY = (phase ~= 0 and flagY * math.abs(self._directionVO.y) / self._fastMoveShadowMax * phase) or 0

        curIndex = curIndex - 1
        if curIndex >= phase then
            offsetSinY = math.sin((curIndex - phase) * PI / self._fastMoveShadowMax) * self:checkHeight(math.sqrt(self._directionVO.x^2 + self._directionVO.y^2))
        end
    end
    phantom:setPosition(cc.p(startPos.x + offsetX + offsetSinX + 2, startPos.y + offsetY + offsetSinY - 2))
    phantom:setOpacity(100)  -- 设置透明度

    -- 添加到场景
    self:getMapActor():addPhantom(phantom)

    phantom:setVisible(self._monsterActor:isVisible())
    table.insert(self._cloneActorArr, phantom)
end

function MonsterStateFastMove:onEnter()
end

function MonsterStateFastMove:onExit()
    self:clearActorArr()
end

function MonsterStateFastMove:onUpdate()
    self:clearActorArr()

    local directionV = cc.pSub(cc.p(self._xTarget, self._yTarget), cc.p(self._mHeroX, self._mHeroY))
    local disV = math.sqrt(directionV.x^2 + directionV.y^2)

    local disVO = math.sqrt(self._directionVO.x^2 + self._directionVO.y^2)
    local curIndex = self._fastMoveShadowMax - math.floor(disV/disVO*self._fastMoveShadowMax)
    
    if self._skillId == lt.SkillEnum.MAGIC_BLOODY_ZENITH then
        local offsetSinY = math.sin((curIndex) * PI / self._fastMoveShadowMax ) * self:checkHeight(disVO)
        self._monsterActor:setSpriteOffsetY(offsetSinY)
    end

    if not self._isEnd then
        local step = disVO / 0.2 * lt.GameBoard:getDeltaTime()
        if cc.pGetLength(directionV) < step or disVO == 0 then
            self._isEnd = true
            -- 到达
            self._monsterAgent:setPosition(self._xTarget, self._yTarget)

            if self._skillId ~= lt.SkillEnum.MAGIC_BLOODY_ZENITH then
                self._showMultiple = false
                self:clearActorArr()
                local roleData = self._monsterAgent:getRoleData()
                if roleData and roleData:isCrossCount() then
                    local worldAgent = AgentManager:getWorldAgent()
                    if worldAgent then
                        worldAgent:deleteAgent(self._monsterAgent:getObjId())
                    end
                else
                    self._monsterAgent:changeState(lt.MonsterStateIdle.new(self._monsterAgent))
                end
            else
                -- self._monsterAgent:playAction(Constant.ROLE_ACTION_ATTACK,self._skillId)
                -- local delay = 0.5
                -- if self._monsterActor and self._monsterActor:getActionInfo() then
                --     delay = self._monsterActor:getActionInfo():getStep() * self._monsterActor:getActionInfo():getSpriteFrameCount() * self._monsterAgent:getCurStepMultiple()
                -- end
                -- lt.ScheduleUtil:performWithDelayGlobal(function()
                    if self._monsterActor then
                        self._showMultiple = false
                        self:clearActorArr()
                        self._monsterActor:setSpriteOffsetY(nil)
                        self._monsterAgent:setPosition(self._xTarget, self._yTarget)
                        self._monsterAgent:changeState(lt.MonsterStateIdle.new(self._monsterAgent))
                    end
                -- end,delay)
            end
            return
        else
            -- 未到
            directionV = cc.pMul(cc.pNormalize(directionV), step)
            self._mHeroX = self._mHeroX + directionV.x
            self._mHeroY = self._mHeroY + directionV.y
            self._monsterAgent:setPosition(self._mHeroX, self._mHeroY)
        end
    end

    if self._showMultiple then
        for i = 1, self._fastMoveShadowMax do
            if self._isEnd then
                local nextFrameIndex = self._monsterActor:getNextFrameIndex() - 1
                if nextFrameIndex <= 2 then
                    nextFrameIndex = 2
                elseif nextFrameIndex <= 4 then
                    nextFrameIndex = 4
                elseif nextFrameIndex <= 6 then
                    nextFrameIndex = 6
                elseif nextFrameIndex > 6 and nextFrameIndex < 9 then
                    nextFrameIndex = 8
                end
                
                if nextFrameIndex <= i and nextFrameIndex <= self._fastMoveShadowMax then
                    self:createPhantom(self._fastMoveShadowMax - i,curIndex,true)
                end
                if nextFrameIndex > (self._fastMoveShadowMax) then
                    self._showMultiple = false
                end
            else
                self:createPhantom(i,curIndex)
            end
        end
    end
end

function MonsterStateFastMove:clearActorArr()
    for _,v in ipairs(self._cloneActorArr or {}) do
        v:removeFromParent()
    end
    self._cloneActorArr = {}
end

function MonsterStateFastMove:checkHeight(height)
    local curHeight = height
    if curHeight > 100 then
        curHeight = 100
    end

    return curHeight
end

-- 根据方向获取偏移量
function MonsterStateFastMove:getOffectXYByDirection(direction)
    local offsetXY = cc.p(0,0)
    if direction == Constant.DIRECTION_LEFT then
        offsetXY = cc.p(32,0)
    elseif direction == Constant.DIRECTION_RIGHT then
        offsetXY = cc.p(-32,0)
    elseif direction == Constant.DIRECTION_DOWN then
        offsetXY = cc.p(0,32)
    elseif direction == Constant.DIRECTION_UP then
        offsetXY = cc.p(0,-32)
    elseif direction == Constant.DIRECTION_LEFT_DOWN then
        offsetXY = cc.p(15,15)
    elseif direction == Constant.DIRECTION_LEFT_UP then
        offsetXY = cc.p(15,-15)
    elseif direction == Constant.DIRECTION_RIGHT_DOWN then
        offsetXY = cc.p(-15,15)
    elseif direction == Constant.DIRECTION_RIGHT_UP then
        offsetXY = cc.p(-15,-15)
    end

    return offsetXY
end

function MonsterStateFastMove:onMessage(msg)
end

function MonsterStateFastMove:getStateId()
    return Constant.MONSTER_STATE_FASTMOVE
end

function MonsterStateFastMove:getStateName()
    return "MonsterStateFastMove"
end

return MonsterStateFastMove