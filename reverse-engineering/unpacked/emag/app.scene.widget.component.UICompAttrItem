---@class UICompAttrItem
---
local UICompAttrItem = class("UICompAttrItem", lt.UIGButtonBase)

local SkeletonManager = lt.SkeletonManager
local Constant = lt.Constant

function UICompAttrItem:ctor()
    UICompAttrItem.super.ctor(self)
    --UI
    self._curattrLabel = nil
    self._nextattrLabel = nil
    self._arrowImg = nil
    self._upImg = nil
    self._downImg = nil
    self._lastUpImg = nil
    self._lastDownImg = nil
    self._sucessImg = nil
    self._upSpine = nil
    self._downSpine = nil
    self._loadingSpine = nil
    --数据
    self._taskData = nil
    self._curProp = nil
    self._nextProp = nil
end

function UICompAttrItem:onClear()
    --UI
    self._curattrLabel = nil
    self._nextattrLabel = nil
    self._arrowImg = nil
    self._upImg = nil
    self._downImg = nil
    self._lastUpImg = nil
    self._lastDownImg = nil
    self._sucessImg = nil
    self._upSpine = nil
    self._downSpine = nil
    self._loadingSpine = nil
    --数据
    self._taskData = nil
    self._curProp = nil
    self._nextProp = nil
end

function UICompAttrItem:onConstruct()
    self._curattrLabel = self:getChild("label_curattr")
    self._nextattrLabel = self:getChild("label_nextattr")
    self._arrowImg = self:getChild("img_arrow")
    self._upImg = self:getChild("img_up")
    self._downImg = self:getChild("img_down")
    self._lastUpImg = self:getChild("img_lastup")
    self._lastDownImg = self:getChild("img_lastdown")
    self._sucessImg = self:getChild("img_success")

    --添加箭头特效
    self:createArrowEffect(self._upImg)
    self:createDownArrowEffect(self._downImg)

    self._upSpine = SkeletonManager:createSkeletonEffectWithFile("ShengJiXiTong", "ShengJiXiTong_Skeleton")
    self._lastUpImg:displayObject():addChild(self._upSpine)
    self._upSpine:setAnimationScale(0.5)

    self._downSpine = SkeletonManager:createSkeletonEffectWithFile("ShengJiXiTong", "ShengJiXiTong_Skeleton_ArrowDown")
    self._lastDownImg:displayObject():addChild(self._downSpine)
    self._downSpine:setAnimationScale(0.5)
    
    --添加loading特效
    self._loadingSpine = SkeletonManager:createSkeletonEffectWithFile("ShengJiXiTong", "ShengJiXiTong_Skeleton")
    self._sucessImg:displayObject():addChild(self._loadingSpine)
end

function UICompAttrItem:setAttr(prop, nextProp)
    local curProp = string.split(prop, "|")
    local curPropNum = curProp[2]
    local nextPorp = nextProp.add and tonumber(curProp[2]) + nextProp[curProp[1]] or nextProp[curProp[1]]
    local nextPorpNum = nextPorp
    if curProp[1] == GReadText.KEY_EQUIP_TIPS45 or curProp[1] == GReadText.KEY_EQUIP_TIPS46 then
        curPropNum = curPropNum.."%"
        nextPorpNum = nextPorpNum.."%"
    end
    self._curattrLabel:setText(curProp[1]..":"..curPropNum)
    self._curProp = curProp
    self._nextProp = nextPorp
    self._nextattrLabel:setText(nextPorpNum)
    self._nextattrLabel:setVisible(true)
    self._nextattrLabel:setColor(nextPorp >= tonumber(curProp[2]) and Constant.COLOR_GREEN or Constant.COLOR_TEXT_RED)
    self._arrowImg:setVisible(true)
    self._upImg:setVisible(nextPorp > tonumber(curProp[2]))
    self._downImg:setVisible(nextPorp < tonumber(curProp[2]))
    self._lastUpImg:setVisible(false)
    self._lastDownImg:setVisible(false)
    self._sucessImg:setVisible(false)
end

function UICompAttrItem:setMaxAttr(prop)
    local curProp = string.split(prop, "|")
    self._curattrLabel:setText(curProp[1]..":"..curProp[2])
    self._nextattrLabel:setVisible(false)
    self._arrowImg:setVisible(false)
    self._upImg:setVisible(false)
    self._downImg:setVisible(false)
    self._lastUpImg:setVisible(false)
    self._lastDownImg:setVisible(false)
    self._sucessImg:setVisible(false)
end

function UICompAttrItem:showLoading()
    self._loadingSpine:setAnimationScale(4)
    self._loadingSpine:setAnimation(0, "ShengJiPanDuan", false)
    self._sucessImg:setVisible(true)
end

function UICompAttrItem:showSuccessAnimation()
    self._loadingSpine:setAnimationScale(0.5)
    self._loadingSpine:setAnimation(0, "ShengJiChengGong1", false)
    self:showSuccess()
end

function UICompAttrItem:showFailAnimation()
    self._loadingSpine:setAnimationScale(1)
    self._loadingSpine:setAnimation(0, "ShengJiShiBai1", false)
    self:showFail()
end

function UICompAttrItem:showSuccess()
    self._curattrLabel:setText(self._curProp[1]..":"..self._nextProp)
    self._nextattrLabel:setVisible(false)
    self._arrowImg:setVisible(false)
    self._upImg:setVisible(false)
    self._downImg:setVisible(false)
    self._lastUpImg:setVisible(self._nextProp > tonumber(self._curProp[2]))
    self._lastDownImg:setVisible(self._nextProp < tonumber(self._curProp[2]))
    if self._nextProp > tonumber(self._curProp[2]) then
        self._upSpine:setAnimation(0, "ShengJiTiShi", false)
    else
        self._downSpine:setAnimation(0, "ShengJiXiTong_Skeleton_ArrowDown", false)
    end
end

function UICompAttrItem:showFail()
    self._curattrLabel:setText(self._curProp[1]..":"..self._curProp[2])
    self._nextattrLabel:setVisible(false)
    self._arrowImg:setVisible(false)
    self._upImg:setVisible(false)
    self._downImg:setVisible(false)
    self._lastUpImg:setVisible(false)
    self._lastDownImg:setVisible(false)
end

function UICompAttrItem:createArrowEffect(parent, up)
    local spine = SkeletonManager:createSkeletonEffectWithFile("ShengJiXiTong", "ShengJiXiTong_Skeleton")
    parent:displayObject():addChild(spine)
    spine:setAnimationScale(0.2)
    spine:setAnimation(0, "ShengJiTiShi", true)
end

function UICompAttrItem:createDownArrowEffect(parent, up)
    local spine = SkeletonManager:createSkeletonEffectWithFile("ShengJiXiTong", "ShengJiXiTong_Skeleton_ArrowDown")
    parent:displayObject():addChild(spine)
    spine:setAnimationScale(0.2)
    spine:setAnimation(0, "ShengJiXiTong_Skeleton_ArrowDown", true)
end

return UICompAttrItem