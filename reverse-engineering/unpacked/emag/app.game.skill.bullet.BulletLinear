-- end
function BulletLinear:setPixelPosition(x, y, z)
    self._pixelX = x;
	self._pixelY = y;
	self._pixelZ = z;
    self:setPosition(self._pixelX,self._pixelY + self._pixelZ)
end
function BulletLinear:setDirection(direction)
    self._direction = direction
end

return BulletLinear
