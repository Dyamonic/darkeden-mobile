---@class UICompRechargeItem 商城cell
---
local UICompRechargeItem = class("UICompRechargeItem",lt.UICompBase, lt.UICompChangeSkin)
local CacheManager = lt.CacheManager
local Constant = lt.Constant
local NtfManager = lt.NtfManager
local RechargeModule = lt.RechargeModule
local ItemModule = lt.ItemModule

function UICompRechargeItem:ctor()
    UICompRechargeItem.super.ctor(self)
    --UI
    self._tipsImg = nil
    self._nameLabel = nil
    self._priceLabel = nil
    self._timesLabel = nil
    self._buyBtn = nil
    self._item = nil
    --数据
    self._itemMeta = nil
    
end

function UICompRechargeItem:onClear()
    --UI
    self._tipsImg = nil
    self._nameLabel = nil
    self._priceLabel = nil
    self._timesLabel = nil
    self._buyBtn = nil
    self._item = nil
    --数据
    self._itemMeta = nil
    UICompRechargeItem.super.onClear(self)
end

function UICompRechargeItem:onConstruct()
    self._tipsImg = self:getChild("img_tips")
    self._nameLabel = self:getChild("label_name")
    self._priceLabel = self:getChild("label_price")
    self._timesLabel = self:getChild("label_times")
    self._buyBtn = self:getChild("btn_buy")
    self._item = fgui.UIPackage:createObject("Item", "Item")
    self:getChild("itemNode"):addChild(self._item)
    self._item:setPosition(0, 0)
end

function UICompRechargeItem:onEnter()
    UICompRechargeItem.super.onEnter(self)
    self._buyBtn:addClickListener(handler(self, self.onBuyBtnClick))
    self._item:addClickListener(handler(self, self.onTipsBtnClick))
end
function UICompRechargeItem:onExit()
    self._buyBtn:removeClickListener()
    self._item:removeClickListener()
    UICompRechargeItem.super.onExit(self)
end

function UICompRechargeItem:setObjInfo(shopItemMeta)
    self._item:insertObjectToFactory(self:getRegClass())
    self._itemMeta = shopItemMeta
    self._nameLabel:setText(shopItemMeta:getName())
    local lordStr = shopItemMeta:getCostType() == Constant.SHOP_TYPE.POINT and GReadText.KEY_SHOPPING_TIPS1 or GReadText.KEY_SHOPPING_TIPS2
    
    local cost = shopItemMeta:getCost()
    local itemMeta = CacheManager:getItemMeta(cost[2])
    self._quotaType = shopItemMeta:getQuotaType()
    -- 限购次数 + vip限购次数
    self._quotaNum = shopItemMeta:getQuotaNum() + RechargeModule:getVipQuotaNum(shopItemMeta) 

    local num = lt.StringManager:convert4BitNumber(cost[3])

    if shopItemMeta:getCostType() == Constant.SHOP_TYPE.POINT then
        self._priceLabel:setText(_GURL.GetImagePoint..num)
    else
        self._priceLabel:setText(_GURL.GetImageCoin..num)
    end

    self._timesLabel:setVisible(self._quotaType ~= Constant.QUOTA_TYPE.UNLIMITE)
    local buyTimes = RechargeModule:getShoppingData(shopItemMeta:getId()) or 0
    buyTimes = self._quotaNum - buyTimes
    if self._quotaType == Constant.QUOTA_TYPE.DAY then
        if buyTimes == 0 then
            self._timesLabel:setText(GReadText.SHOP_SELL_OUT)
            self._timesLabel:setColor(Constant.COLOR_TEXT_RED)
        else
            self._timesLabel:setText(GReadText.KEY_SHOPPING_TIPS3..":"..buyTimes.."/"..self._quotaNum)
            self._timesLabel:setColor(Constant.COLOR_TEXT_WHITE)
        end
    elseif self._quotaType == Constant.QUOTA_TYPE.WEEK then
        if buyTimes == 0 then
            self._timesLabel:setText(GReadText.SHOP_SELL_OUT)
            self._timesLabel:setColor(Constant.COLOR_TEXT_RED)
        else
            self._timesLabel:setText(GReadText.KEY_SHOPPING_TIPS4..":"..buyTimes.."/"..self._quotaNum)
            self._timesLabel:setColor(Constant.COLOR_TEXT_WHITE)
        end
    elseif self._quotaType == Constant.QUOTA_TYPE.MONTH then
        if buyTimes == 0 then
            self._timesLabel:setText(GReadText.SHOP_SELL_OUT)
            self._timesLabel:setColor(Constant.COLOR_TEXT_RED)
        else
            self._timesLabel:setText(GReadText.KEY_SHOPPING_TIPS5..":"..buyTimes.."/"..self._quotaNum)
            self._timesLabel:setColor(Constant.COLOR_TEXT_WHITE)
        end
    elseif self._quotaType == Constant.QUOTA_TYPE.ALWAYS then
        if buyTimes == 0 then
            self._timesLabel:setText(GReadText.SHOP_SELL_OUT)
            self._timesLabel:setColor(Constant.COLOR_TEXT_RED)
        else
            self._timesLabel:setText(GReadText.KEY_SHOPPING_TIPS6..":"..buyTimes.."/"..self._quotaNum)
            self._timesLabel:setColor(Constant.COLOR_TEXT_WHITE)
        end
    end
    local shopItem = shopItemMeta:getShopItem()
    if shopItem[1] == Constant.ItemType.ITEM_TYPE_PROP then
        local itemMeta = CacheManager:getItemMeta(shopItem[2])
        self._item:setInfo(string.format("ui://Item/prop_%s", itemMeta:getIconId()))
    elseif shopItem[1] == Constant.ItemType.ITEM_TYPE_EQUIP then
        local itemMeta = CacheManager:queryEquipMeta(shopItem[2])
        self._item:setInfo(string.format("ui://Item/equip_%s", itemMeta:getIconId()))
    end
    self._item:setItemNums(shopItem[3])
    
    --图标缩放
    local itemSize = self._item:size()
    local heightS = 50/itemSize.height
    local widthS = 50/itemSize.width
    local scale = heightS
    if widthS < heightS then
        scale = widthS
    end
    self._item:setIconScale(scale, scale)

    --特殊标签
    if shopItemMeta:getNew() == 1 then
        self._tipsImg:setURL(string.format(_GURL.GetRechargeFGUI, "bg_sdiancz_xiao_02"))
        self._tipsImg:setVisible(true)
    elseif shopItemMeta:getHot() == 1 then
        self._tipsImg:setURL(string.format(_GURL.GetRechargeFGUI, "bg_sdiancz_xiao_01"))
        self._tipsImg:setVisible(true)
    else
        self._tipsImg:setVisible(false)
    end
end

function UICompRechargeItem:onBuyBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_RECHARGE_OPEN_BUY, {itemMeta = self._itemMeta})
end

function UICompRechargeItem:onTipsBtnClick()
    local shopItem = self._itemMeta:getShopItem()
    if shopItem[1] == Constant.ItemType.ITEM_TYPE_PROP then
        local itemMeta = CacheManager:getItemMeta(shopItem[2])
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemMeta, tipsType = Constant.PROPTIPS_FORM.DisplayShop})
    elseif shopItem[1] == Constant.ItemType.ITEM_TYPE_EQUIP then
        local itemMeta = CacheManager:queryEquipMeta(shopItem[2])
        local itemData = ItemModule:getItemDataByConfig(itemMeta)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemData, tipsType = Constant.EquipShowTipsType.Display})
    end
end

return UICompRechargeItem