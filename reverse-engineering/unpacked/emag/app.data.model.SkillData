
local SkillData = class("SkillData")

SkillData._skillId      = nil  -- 技能编号
SkillData._level        = nil  -- 技能等级
SkillData._exp          = nil  -- 技能经验值
SkillData._skillCd      = nil  -- 下一次释放剩余时间

function SkillData:ctor(perSkillData)
    assert(perSkillData ~= nil, "perSkillData is nil !")

    self:initSkillData(perSkillData)
end

function SkillData:initSkillData(perSkillData)
    self._skillId = perSkillData.skillId
    self._level = perSkillData.skillLevel
    self._exp = perSkillData.skillExp
    self._skillCd = perSkillData.skillCd
    self._skillRange = perSkillData.skillRange
end

function SkillData:getSkillId()
    return self._skillId
end

function SkillData:setLevel(level)
    self._level = level
end

function SkillData:getLevel()
    return self._level or 0
end

function SkillData:setExp(exp)
    self._exp = exp
end

function SkillData:getExp()
    return self._exp
end

function SkillData:getSkillCd()
    return self._skillCd / 1000
end

function SkillData:getSkillRange()
    return self._skillRange
end

function SkillData:dump()
    lt.LogUtil:debug(">>>>>>>>>>>>>>>>>>>> SkillData >>>>>>>>>>>>>>>>>>>>")
    lt.LogUtil:debug("self._skillId = "..self._skillId)
    lt.LogUtil:debug("self._level = "..self._level)
    lt.LogUtil:debug("self._exp = "..self._exp)
    lt.LogUtil:debug("self._skillCd = "..self._skillCd)
    lt.LogUtil:debug("<<<<<<<<<<<<<<<<<<<< SkillData <<<<<<<<<<<<<<<<<<<<")
end

return SkillData
