local EnergyModule = {}

local SocketApi = lt.SocketApi
local netcmd_pb = lt.netcmd_pb
local ClientCmdDef = lt.ClientCmdDef
local ServerCmdDef = lt.ServerCmdDef
local Constant = lt.Constant
local NtfManager = lt.NtfManager
local CacheManager = lt.CacheManager
local GameModule = lt.GameModule
local VipModule = lt.VipModule
local BuffEnum = lt.BuffEnum
local CommonModule = lt.CommonModule

local ENERGY_TYPE = {
    VITALITY = 1,       --精力加成
    VIP = 2,            --VIP
    EXPHOUR = 3,        --经验沙漏
}

function EnergyModule:init()
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.CS_ENERGY_NTF), handler(self, self.onEnergyNtf), "EnergyModule:onEnergyNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.CS_GET_ENERGY_ITEMS_RESP), handler(self, self.onGetEnergyItems), "EnergyModule:onGetEnergyItems")
end

function EnergyModule:clear()
    SocketApi:removeProtoListenerByTag("EnergyModule:onEnergyNtf")
    SocketApi:removeProtoListenerByTag("EnergyModule:onGetEnergyItems")
end

function EnergyModule:getVitalityMeta()
    local heroData = GameModule:getHeroData()
    if not heroData then
        return nil
    end
    local race = heroData:getRace()
    local level = heroData:getLevel()
    --人族要计算历史最高领域等级
    if race == Constant.RaceType.Slayer then
        level = heroData:getHistoryTopLevel()
    end
    local advState = heroData:getAdvanceState()
    if advState == Constant.AdvState.Adv then
        level = Constant.TransferLevel + heroData:getAdvanceLevel()
    end
    local vitalityMap = CacheManager:getVitalityMap()
    for k, v in ipairs(vitalityMap) do
        if v:getRace() == 0 or v:getRace() == race then
            local levelStr = string.split(v:getLevel(), ",")
            local downLevel = tonumber(levelStr[1])
            local upLevel = tonumber(levelStr[2])
            if level >= downLevel and level <= upLevel then
                return v
            end
        end
    end
    return nil
end

function EnergyModule:getVitalityListMeta()
    local vitalityArray = {}
    local vitalityListMap = CacheManager:getVitalityListMap()
    for k, v in ipairs(vitalityListMap) do
        local data = {}
        data.meta = v
        if v:getIdxId() == ENERGY_TYPE.VITALITY then
            --精力加成
            local meta = self:getVitalityMeta()
            data.name = v:getName()
            data.addPer = meta:getVitalityBonus()/100
            data.status = self:getEnergy() > 0 and 1 or 0
        elseif v:getIdxId() == ENERGY_TYPE.VIP then
            --VIP
            local vipLevel = VipModule:getCurVipLv()
            if vipLevel < 1 then
                --vip小于2显示2(因为vip2以下没有经验加成)
                data.name = v:getName().."1"
                data.addPer = VipModule:getVipExpAdd(1)
                data.status = 0
            else
                data.name = v:getName()..vipLevel
                data.addPer = VipModule:getVipExpAdd()
                data.status = 1
            end
        elseif v:getIdxId() == ENERGY_TYPE.EXPHOUR then
            --经验沙漏
            local bufferTable = GameModule:getBufferTable() or {}
            local remainTime = math.floor(bufferTable[BuffEnum.EFFECT_DOUBLE_EXP] or 0)
            data.name = v:getName()
            data.addPer = 100
            data.status = remainTime > 0 and 1 or 0
            data.lastTime = remainTime
        end
        table.insert(vitalityArray, data)
    end
    return vitalityArray
end

--获得经验值总加成
function EnergyModule:getTotalExpAdd()
    local meta = self:getVitalityMeta()
    if not meta then
        return -1
    end
    local dailyExp = meta:getDailyExperienceLimit()
    local dailyExpLimit = self:getDailyExpLimit()
    --超过今日经验上限返回0
    if dailyExpLimit >= dailyExp then
        return -1
    end
    local totalExp = 0
    local vitalityTable = EnergyModule:getVitalityListMeta()
    for k, v in ipairs(vitalityTable) do
        if v.status == 1 then
            totalExp = totalExp + v.addPer
        end
    end
    return totalExp
end

--获得经验值总加成(纯加成)
function EnergyModule:getPureExpAdd()
    local totalExp = 0
    local vitalityTable = EnergyModule:getVitalityListMeta()
    for k, v in ipairs(vitalityTable) do
        if v.status == 1 then
            totalExp = totalExp + v.addPer
        end
    end
    return totalExp
end

--获得精力数量
function EnergyModule:getEnergy()
    local heroData = GameModule:getHeroData()
    local energy = heroData and heroData:getEnergy() or 0
    return energy
end

--获得精力加成剩余经验
function EnergyModule:getExpPerVitality()
    return self._expPerVitality or 0
end

--获得今日经验
function EnergyModule:getDailyExpLimit()
    return self._dailyExpLimit or 0
end

--是否领取每日精力药水
function EnergyModule:getAchieveEnergy()
    return self._achieveEnergy or false
end

--精力系统是否解锁
function EnergyModule:geEnergyUnlock()
    local open, tips = lt.FunctionToggleModule:checkEnterVisible(lt.FunctionToggleModule.FunctionHelpId.EnergySystem)
    return open
end

--查询精力数据
function EnergyModule:sendQueryEnergy()
    self._send = true
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_QUERY_ENERGY_REQ))
end

--精力数据ntf
function EnergyModule:onEnergyNtf(event)
    local proto = event.param
    self._expPerVitality = proto.curEnergyPointGetExp
    self._dailyExpLimit = proto.todayGetTotalExp
    self._achieveEnergy = proto.is_energy_item_got
    local reload = false
    if self._send then
        self._send = false
        reload = true
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_ENERGY_EXP, {reloadList = reload})
end

--领取精力道具
function EnergyModule:sendGetEnergyItems()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_GET_ENERGY_ITEMS_REQ))
end

--领取精力道具回调
function EnergyModule:onGetEnergyItems(event)
    local proto = event.param
    if proto.ret == 0 then
        self._achieveEnergy = true
        --tips展示
        local freeVitalityDaily = CacheManager:getVariableById(Constant.Variable.FreeVitalityDaily)
        local item = string.split(freeVitalityDaily, ",")
        local itemMeta = CacheManager:getItemMeta(item[2])
        local tips = string.format(GReadText.KEY_ENERGY_TIPS7, itemMeta:getName(), item[3])
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = tips})
        --刷新界面
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_ENERGY_EXP)
    end
end

return EnergyModule