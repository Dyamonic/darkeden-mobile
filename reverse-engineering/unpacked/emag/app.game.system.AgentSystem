
-- MapAgent中用于管理英雄四周一定范围内的各种Agent
local AgentSystem = class("AgentSystem")
local MapUtil = lt.MapUtil
local Constant = lt.Constant

AgentSystem._mnTable = nil

function AgentSystem:ctor()
    self._mnTable = {}
end

function AgentSystem:clear()
    self._mnTable = {}
end

function AgentSystem:addAgent(agent)
    local m, n = agent:getMNExactly()
    local mnIndex = lt.MapUtil:calcMNIndex(m, n)

    if not self._mnTable[mnIndex] then
        self._mnTable[mnIndex] = {}
    end

    self._mnTable[mnIndex][agent:getAgentId()] = agent
end

-- 移除agent所占用的格子
function AgentSystem:removeAgent(agent, m, n)
    local mnIndex = lt.MapUtil:calcMNIndex(m, n)
    if not self._mnTable[mnIndex] then
        return
    end
    
    self._mnTable[mnIndex][agent:getAgentId()] = nil
end

function AgentSystem:getAgentTable(m, n)
    local mnIndex = lt.MapUtil:calcMNIndex(m, n)
    return self._mnTable[mnIndex]
end

function AgentSystem:changeAgentMN(agent, mNew, nNew)
    -- 添加
    local mnIndex = lt.MapUtil:calcMNIndex(mNew, nNew)
    if not self._mnTable[mnIndex] then
        self._mnTable[mnIndex] = {}
    end

    self._mnTable[mnIndex][agent:getAgentId()] = agent

    -- 移除
    local mLast, nLast = agent:getMNExactly()
    if mLast ~= mNew or nLast ~= nNew then
        self:removeAgent(agent, mLast, nLast)
    end
end

-- 实时判断，旁边有人时，此时走路不能通过 Blocked
function AgentSystem:isBlocked(m, n)
    local mnIndex = lt.MapUtil:calcMNIndex(m, n)
    if self._mnTable[mnIndex] and not lt.CommonUtil:isTableEmpty(self._mnTable[mnIndex]) then
        local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
        if not heroAgent then
            return true
        end
        
        local curMoveMode = heroAgent:getCurMoveMode()
        local isBlocked = false
        for _, agent in pairs(self._mnTable[mnIndex]) do
            local agentType = agent:getAgentType()
            if agentType ~= Constant.AGENT_TYPE_TRAP and agentType ~= Constant.AGENT_TYPE_ELEMENT then
                if agent:isRoleAgent() then -- 是人和怪，模式相等设置阻挡点
                    local agentMoveMode = agent:getCurMoveMode()
                    -- yflog:Info("agentMoveMode = %s",agentMoveMode)
                    if agentMoveMode == curMoveMode then -- 模式相等设置阻挡
                        isBlocked = true
                        break
                    
                    elseif agent:isSkillHide() and agent:getActor():isVisible() then -- 隐蔽显示也显示阻挡
                        isBlocked = true
                        break
                    end
                else
                    isBlocked = true
                    break
                end
            end
        end

        return isBlocked
    else
        return false
    end
end

return AgentSystem
