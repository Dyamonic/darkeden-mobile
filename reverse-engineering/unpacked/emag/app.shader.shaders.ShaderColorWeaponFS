return [[
#ifdef GL_ES
    precision mediump float;
#endif
    
varying vec2 v_texCoord;
uniform vec3 dest_color_b;   //皮肤、头发
uniform float u_darkFactor;

void main(void) {
    vec4 src_color = texture2D(CC_Texture0, v_texCoord).rgba; 
    vec3 newColor = src_color.rgb;
    float originB = (1.0- src_color.b) * 1.45; // 色值倍率调整
    float originClothB = (1.0- src_color.b);

    //（人族）武器、盾牌、皮肤、头发  （鬼族）皮肤
    if (length(dest_color_b) > 0.0 && src_color.b > 0.063 && src_color.r == 0.0  && src_color.g == 0.0)
    {
        newColor.r = dest_color_b.r * originB;
        newColor.g = dest_color_b.g * originB;
        newColor.b = dest_color_b.b * originB;
    }

    newColor.rgb *= u_darkFactor; // 调整颜色

    gl_FragColor = vec4(newColor, src_color.a); 
}


]]