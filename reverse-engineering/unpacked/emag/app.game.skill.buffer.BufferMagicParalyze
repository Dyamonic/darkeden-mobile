
local BufferMagicParalyze = class("BufferMagicParalyze", lt.BufferBase)

local SkillEnum = lt.SkillEnum

function BufferMagicParalyze:ctor(time, actor,skilllevel)
    BufferMagicParalyze.super.ctor(self, 1, time, actor)

    -- 播放特效 1为目标对象
    actor:playQueueEffect(SkillEnum.SKILL_MAGIC_PARALYZE, 1)
    self._actor:setActionPause(true)
end

function BufferMagicParalyze:onClear()
    self._actor:setActionPause(false)
    -- stop 播放
    self._actor:stopQueueEffect(SkillEnum.SKILL_MAGIC_PARALYZE)

    BufferMagicParalyze.super.onClear(self)
end

return BufferMagicParalyze
