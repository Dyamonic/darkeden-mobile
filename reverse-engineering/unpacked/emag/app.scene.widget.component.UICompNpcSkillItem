---@class UICompNpcSkillItem 角色技能
local UICompNpcSkillItem = class("UICompNpcSkillItem", lt.UICompBase)

local SkillModule = lt.SkillModule
local GameModule = lt.GameModule
local Constant = lt.Constant

function UICompNpcSkillItem:ctor()
    UICompNpcSkillItem.super.ctor(self)
end

function UICompNpcSkillItem:onConstruct()
    local btnStudy = self:getChild("btnStudy")
    local icon = self:getChild("icon")
    btnStudy:addClickListener(handler(self,self.btnStudyTouch))
    icon:addClickListener(handler(self,self.onClickIcon))
end

function UICompNpcSkillItem:onClear()
    UICompNpcSkillItem.super.onClear(self)
end

function UICompNpcSkillItem:onEnter()
end

function UICompNpcSkillItem:onExit()
end

function UICompNpcSkillItem:setItemInfo(skillCfg, skillDataRace, domain, domainLvl)
    self._skillCfg = skillCfg
    self._skillDataRace = skillDataRace
    self._domain = domain
    self._domainLvl = domainLvl
    local icon = self:getChild("icon")
    local name = self:getChild("name")
    local level = self:getChild("level")
    local btnStudy = self:getChild("btnStudy")
    local btnBg = btnStudy:getChild("bg")

    local spriteId = skillCfg:getSpriteID()
    icon:setURL(string.format(_GURL.GetImageSkill, spriteId))
    local levelStr = self._race == Constant.RaceType.Slayer and GReadText.SELECT_ROLE_13 or GReadText.SELECT_ROLE_2
    level:setText(levelStr..skillCfg:getNeedLevel())
    name:setText(skillCfg:getName())

    local skillId = skillCfg:getSkillId()
    local hasSkill = SkillModule:hasSkill(skillId)
    local learnLimit = self:checkLearnLimit(skillCfg)
    if learnLimit then
        btnStudy:setTitle(GReadText.KEY_NPC_SKILL_TIPS5)
        icon:setGrayed(true)
        btnBg:setGrayed(true)
        level:setColor(Constant.COLOR_TEXT_RED)
    elseif not hasSkill then
        -- 未学习过技能
        btnStudy:setTitle(GReadText.KEY_NPC_SKILL_TIPS5)
        icon:setGrayed(false)
        btnBg:setGrayed(false)
        level:setColor(Constant.COLOR_GREEN)
    else
        -- 已学习过技能
        btnStudy:setTitle(GReadText.KEY_NPC_SKILL_TIPS6)
        icon:setGrayed(false)
        btnBg:setGrayed(true)
    end
    level:setVisible(not hasSkill)
end

function UICompNpcSkillItem:btnStudyTouch(target)
    local skillId = self._skillCfg:getSkillId()
    local learnLimit = self:checkLearnLimit(self._skillCfg)
    if learnLimit then
        -- 等级不足
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_NPC_SKILL_TIPS7})
        return
    end
    local hasSkill = SkillModule:hasSkill(skillId)
    if hasSkill then
        -- 已学习过技能
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_NPC_SKILL_TIPS8})
        return
    end
    SkillModule:sendLearnSkill(0,skillId)
end

function UICompNpcSkillItem:onClickIcon(context)
    local btnList = { Constant.SkillTipBtns.Detail }

    local skillId = self._skillCfg:getSkillId()
    local learnLimit = self:checkLearnLimit()
    local curBtnState = Constant.SkillState.NotLearnable
    if not learnLimit then
        curBtnState = Constant.SkillState.Learnable
    end

    local hasSkill = SkillModule:hasSkill(skillId)
    if hasSkill then
        curBtnState = Constant.SkillState.Learned
    end
    
    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SHOW_SKILL_TIPS, 
    {
        skillInfo = self._skillCfg,
        btnList = btnList,
        btnState = curBtnState,
    })
end

function UICompNpcSkillItem:checkLearnLimit()
    local heroData = GameModule:getHeroData()
    local playerLvl = heroData:getLevel()
    local needLvl = self._skillCfg:getNeedLevel()
    local learnLimit = true
    if self._skillDataRace == Constant.RaceType.Slayer and self._domain and self._domainLvl then
        learnLimit = self._domainLvl < needLvl
    elseif self._skillDataRace == Constant.RaceType.Vampire then
        learnLimit = playerLvl < needLvl
    end

    return learnLimit
end

return UICompNpcSkillItem