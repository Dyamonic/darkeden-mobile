function GameFGUI:loadPackage()
    for _,package in ipairs(fguiPackageConf) do
        fgui.UIPackage:addPackage(package)
    end
end

function GameFGUI:loadCommonPlist()
    for _, plistInfo in pairs(commonPlist) do
        display.loadSpriteFrames(plistInfo..".plist", plistInfo..".png")
    end
end

function GameFGUI:registCommonExtend()
    -- for _,component in ipairs(fguiCommonExtConf) do
    --     lt.FGuiManager:registerComponent("GameFGUI", component)
    -- end
end

function GameFGUI:removePackage()
    for _,package in ipairs(fguiPackageConf) do
        fgui.UIPackage:removePackage(package)
    end
end

function GameFGUI:removeCommonPlist()
    for _, plistInfo in pairs(commonPlist) do
        display.removeSpriteFrames(plistInfo..".plist", plistInfo..".png")
    end
end

function GameFGUI:onClear()
    yflog:Info("GameFGUI:onClear()")
    -- lt.FGuiManager:unregisterAllComponent("GameFGUI")
    self:removePackage()
    self:removeCommonPlist()
end

return GameFGUI
