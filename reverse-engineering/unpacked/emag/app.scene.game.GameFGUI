local commonPlist = {
    
}

function GameFGUI:ctor()
    self:loadFGUI()
end

function GameFGUI:loadFGUI()
    self:registerFont()
    self:createCommonParent()
    self:loadPackage()
    self:registCommonExtend()
    self:loadCommonPlist()
end

function GameFGUI:registerFont()
    fgui.UIConfig:registerFont("FONT_1", "font/chs/FONT_1.TTF");
    fgui.UIConfig:registerFont("FONT_2", "font/chs/FONT_2.TTF");
    fgui.UIConfig:registerFont("fangzheng", "font/fangzheng.ttf");
    fgui.UIConfig.defaultFont = "fangzheng"
    local curRace = lt.GameModule:getHeroRace()
    if curRace == Constant.RaceType.Slayer then
        fgui.UIConfig.buttonSound = _GURL.SlayerButtonSound
    elseif curRace == Constant.RaceType.Ousters then
        fgui.UIConfig.buttonSound = _GURL.OustersButtonSound
    elseif curRace == Constant.RaceType.Vampire then
        fgui.UIConfig.buttonSound = _GURL.VampireButtonSound
    end
end

