---@宠物皮肤
---@class UICompPetSkin
local UICompPetSkin = class("UICompPetSkin", lt.UICompBase)

local PetUIActor   = lt.PetUIActor
local PetModule    = lt.PetModule
local CacheManager = lt.CacheManager
local ItemModule   = lt.ItemModule
local Constant     = lt.Constant
local NtfManager   = lt.NtfManager
local CommonFunc   = lt.CommonFunc

UICompPetSkin.ChangeSkinConf = {
    ["CommonTL"] = {
        ["btn_activate"] = { icon = "bg_youjian_changanniu01" },
        ["btn_up"] = { icon = "bg_youjian_changanniu01" },
    },
    ["Strengthen"] = {
        ["item_bg"] = "bg_zhuangbei_di",
    },
    ["Pet"] = {
        ["btn_change"] = { bg = "btn_cwpf_ghan" },
    }
}


local ArrowList     = { "arrow1", "arrow2", "arrow3", "arrow4" }
local NextAttrList  = { "next_attr1", "next_attr2", "next_attr3", "next_attr4" }
local AttrList      = { "attr1", "attr2", "attr3", "attr4" }

function UICompPetSkin:ctor()
    self._modelNode   = nil
    self._petActor1   = nil
    self._skinId      = nil
    self._levelUpCfg  = nil
    self._consumeItemId = nil
    UICompPetSkin.super.ctor(self)
end

function UICompPetSkin:onClear()
    if self._petActor1 then
        self._petActor1:onClear()
        self._petActor1   = nil
    end
    self._modelNode   = nil
    self._skinId      = nil
    self._levelUpCfg  = nil
    self._consumeItemId = nil
    UICompPetSkin.super.onClear(self)
end

function UICompPetSkin:onEnter()
    UICompPetSkin.super.onEnter(self)

    self._activeBtn:addClickListener(handler(self, self.onUpCallBack))
    self._upBtn:addClickListener(handler(self, self.onUpCallBack))
    self._bgTotal:addClickListener(handler(self, self.onShowTotal))
    self._itemBg:addClickListener(handler(self, self.showTips))
end

function UICompPetSkin:onExit()
    UICompPetSkin.super.onExit(self)

    self._activeBtn:removeClickListener()
    self._upBtn:removeClickListener()
    self._bgTotal:removeClickListener()
    self._itemBg:removeClickListener()
end

function UICompPetSkin:onUpdate(dt)
    if self._petActor1 then
        self._petActor1:onUpdate(dt)
    end
end

function UICompPetSkin:onConstruct()
    self:startSkin()
    self:initUI()
end

function UICompPetSkin:initUI()
    self._modelNode = self:getChild("node_model")
    self._petActor1 = PetUIActor.new(2)
    self._modelNode:displayObject():addChild(self._petActor1)
    self._activeBtn = self:getChild("btn_activate")
    self._upBtn = self:getChild("btn_up")
    self._bgTotal = self:getChild("total_bg")
    self._maxLabel = self:getChild("max")
    self._costCom = self:getChild("com_cost")
    self._nextLevel = self:getChild("next_level")
    self._curLevel = self:getChild("cur_level")
    self._curArrow = self:getChild("cur_arrow")
    self._activateTips = self:getChild("activate_tips")
    self._itemCostText = self:getChild("item_cost_text")
    self._itemCostTextIcon = self:getChild("icon")
    self._itemCostIcon = self:getChild("item_cost_icon")
    self._itemCostNum  = self:getChild("item_cost_num")
    self._itemCostName = self:getChild("item_cost_name")
    self._itemBg       = self:getChild("item_bg")

    -- TEST
    -- self._spine = lt.SkeletonManager:createSkeletonEffectWithFile("RongHeXiTong", "RongHeXiTong_Skeleton_XinZhuangBei")
    -- self:displayObject():addChild(self._spine)
    -- self._spine:setAnimation(0, "XinZhuangBei", true)
end

function UICompPetSkin:refreshView(petSkinData)
    if not petSkinData then
        return
    end
    
    self._skinId = petSkinData:getId()
    self._petActor1:setDirection(petSkinData:getModleDir())
    self._petActor1:playAction(petSkinData:getModel())

    local skinData = PetModule:getSkinDataById(self._skinId)
    local levelUpCfg = CacheManager:getPetSkinById(self._skinId)
    if not skinData then -- 未激活
        self:showNotActive(levelUpCfg[1])
        return
    end

    local curLevel = skinData:getLevel()
    if curLevel >= #levelUpCfg then
        self:showMax(skinData,levelUpCfg[#levelUpCfg])
    else
        self:showActive(skinData,levelUpCfg[curLevel],levelUpCfg[curLevel+1])
    end
end

-- 宠物皮肤未激活
function UICompPetSkin:showNotActive(curLevelUpCfg)
    self._maxLabel:setVisible(false)
    self._costCom:setVisible(true)
    
    for i = 1, #NextAttrList do
        local attr = self:getChild(NextAttrList[i])
        if attr then
            attr:setText("")
        end
    end
    self._nextLevel:setText("")

    self._curLevel:setText(string.format(GReadText.KEY_PET_TIPS62,1))
    self._curLevel:setColor(cc.c3b(255,0,0))
    self._activeBtn:setVisible(true)
    self._upBtn:setVisible(false)
    self._curArrow:setVisible(false)
    if not curLevelUpCfg then
        return
    end

    local showNum = self:refreshCurPetSkinAttr(curLevelUpCfg,cc.c3b(168, 167, 166))
    self:setArrowVisible(false,showNum)

    self:refreshConsume(curLevelUpCfg)
end

-- 宠物皮肤已激活未到最高级
function UICompPetSkin:showActive(skinData,curLevelUpCfg,nextLevelUpCfg)
    self._maxLabel:setVisible(false)
    self._costCom:setVisible(true)

    self._curLevel:setText(string.format(GReadText.KEY_PET_TIPS62,skinData:getLevel()))
    self._curLevel:setColor(cc.c3b(255,255,255))
    self._nextLevel:setText(string.format(GReadText.KEY_PET_TIPS62,skinData:getLevel()+1))

    self._activeBtn:setVisible(false)
    self._upBtn:setVisible(true)
    self._curArrow:setVisible(true)

    local showNum = self:refreshCurPetSkinAttr(curLevelUpCfg,cc.c3b(255,255,255))
    self:setArrowVisible(true,showNum)

    self:refreshNextPetSkinAttr(nextLevelUpCfg)

    self:refreshConsume(nextLevelUpCfg)
end

-- 宠物皮肤到达最高级
function UICompPetSkin:showMax(skinData,curLevelUpCfg)
    self._maxLabel:setVisible(true)
    self._costCom:setVisible(false)

    self._curArrow:setVisible(false)
    self:setArrowVisible(false)

    self._curLevel:setText(string.format(GReadText.KEY_PET_TIPS62,skinData:getLevel()))
    self._curLevel:setColor(cc.c3b(255,255,255))

    local showNum = self:refreshCurPetSkinAttr(curLevelUpCfg)
    for i = 1, #NextAttrList do
        local attr = self:getChild(NextAttrList[i])
        if attr and i <= showNum then
            attr:setText("MAX")
            attr:setColor(cc.c3b(255,0,0))
        else
            attr:setText("")
        end
    end
    self._nextLevel:setText("")

    self._activeBtn:setVisible(false)
    self._upBtn:setVisible(false)
end

function UICompPetSkin:setArrowVisible(isVisible,showNum)
    local curShowNum = showNum or #ArrowList
    for i = 1, #ArrowList do
        local arrow = self:getChild(ArrowList[i])
        if arrow then
            arrow:setVisible(isVisible and (i <= curShowNum))
        end
    end
end

function UICompPetSkin:refreshCurPetSkinAttr(curLevelUpCfg,color)
    local curColor = color or cc.c3b(255, 255, 255)
    local race = lt.GameModule:getHeroRace()
    -- 属性显示
    local accumAttr = curLevelUpCfg:getAccumAttrByRace(race)
    local showNum = 0
    for i = 1, #AttrList do
        local attr = self:getChild(AttrList[i])

        local value = ""
        if accumAttr[i] and accumAttr[i][1] and accumAttr[i][2] then
            value = CommonFunc.getOptionInfoStrName2(accumAttr[i][1], accumAttr[i][2])
            showNum = showNum + 1
        end

        if attr then
            attr:setText(value)
            attr:setColor(curColor)
        end
    end

    return showNum
end

function UICompPetSkin:refreshNextPetSkinAttr(nextLevelUpCfg)
    local race = lt.GameModule:getHeroRace()
    -- 属性显示
    local accumAttr = nextLevelUpCfg:getAccumAttrByRace(race)
    for i = 1, #NextAttrList do
        local attr = self:getChild(NextAttrList[i])

        local value = ""
        if accumAttr[i] and accumAttr[i][2] then

            local optionInfo = lt.CacheManager:getOptionInfoMeta(accumAttr[i][1])
            local isPer        = optionInfo:getPercentage()
            local isPermyriad  = optionInfo:getPermyriad()
            if optionInfo then
                value = accumAttr[i][2]
                if isPermyriad == 1 then
                    value = value / 100
                end
                if isPer == 1 then
                    value = value .. "%"
                end
            end
        end

        if attr then
            attr:setText(value)
            attr:setColor(cc.c3b(0,255,0))
        end
    end
end

function UICompPetSkin:refreshConsume(levelUpCfg)
    self._levelUpCfg = levelUpCfg
    if not levelUpCfg then
        return
    end
    
    -- 第一个消耗显示(金币)
    local consumeItem = levelUpCfg:getConsumeItem()
    if consumeItem and consumeItem[1] and #consumeItem > 1 then
        self._activateTips:setVisible(false)
        local needItem = consumeItem[1][3] or 0
        local itemId = consumeItem[1][2]
        local curItemNum = ItemModule:getValueItem(consumeItem[1][1], itemId)
        local itemCostColor = "#FFFC00"
        if curItemNum < needItem then
            itemCostColor = "#FF0000"
        end
        
        local itemMeta = ItemModule:getItemMetaByItemId(consumeItem[1][1], itemId)
        if itemMeta then
            local costStr = string.format(GReadText.KEY_PET_TIPS63, itemCostColor, _GURL.GetImageCoin..needItem)
            self._itemCostText:setText(costStr)
        else
            self._itemCostText:setText("")
        end
    else
        self._itemCostText:setText("")
        self._activateTips:setVisible(true)
    end

    -- 资源消耗显示
    if consumeItem and consumeItem[#consumeItem] then
        local itemId = consumeItem[#consumeItem][2]
        self._consumeItemId = itemId
        local curItemNum = ItemModule:getItemNum(itemId)
        local needItem = consumeItem[#consumeItem][3] or 0
        self._itemCostNum:setText(curItemNum .. "/" .. needItem)
        if curItemNum < needItem then
            self._itemCostNum:setColor(Constant.COLOR_TEXT_RED)
        else
            self._itemCostNum:setColor(Constant.COLOR_GREEN)
        end
        
        local itemMeta = ItemModule:getItemMetaByItemId(consumeItem[#consumeItem][1], itemId)
        if itemMeta then
            self._itemCostName:setText(itemMeta:getName())
            self._itemCostIcon:setURL(string.format(_GURL.GetImageItem,itemMeta:getIconId() or ""))
        end
    end
end

function UICompPetSkin:refreshCost()
    self:refreshConsume(self._levelUpCfg)
end

function UICompPetSkin:onUpCallBack()
    if not self._skinId then
        return
    end
    
    local skinData = PetModule:getSkinDataById(self._skinId)
    local levelUpCfg = CacheManager:getPetSkinById(self._skinId)
    if not levelUpCfg then
        return
    end

    local curLevelCfg = nil
    if not skinData then -- 未激活
        curLevelCfg = levelUpCfg[1]
    else
        local curLevel = skinData:getLevel()
        if curLevel >= #levelUpCfg then
            curLevelCfg = levelUpCfg[#levelUpCfg]
        else
            curLevelCfg = levelUpCfg[curLevel+1]
        end
    end

    if not curLevelCfg then
        return
    end

    local consumeItem = curLevelCfg:getConsumeItem()
    if not consumeItem then
        return
    end

    -- 金币消耗
    if consumeItem and consumeItem[1] and #consumeItem > 1 then
        local needItem = consumeItem[1][3] or 0
        local isEnough = ItemModule:enoughItem(consumeItem[1][1], consumeItem[1][2], needItem, {tips = true})
        if not isEnough then
            return
        end
    end

    -- 资源消耗显示
    if consumeItem and consumeItem[#consumeItem] then
        local needItem = consumeItem[#consumeItem][3] or 0
        local isEnough = ItemModule:enoughItem(consumeItem[#consumeItem][1], consumeItem[#consumeItem][2], needItem, {tips = true})
        if not isEnough then
            return
        end
    end

    PetModule:sendPetSkinLvUp(self._skinId)
end

function UICompPetSkin:onShowTotal()
    local skinAttrList = PetModule:getPetSkinAttrList() or {}
    if #skinAttrList == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS66})
        return
    end
    -- local itemSize = self._bgTotal:getSize()
    local point = self._bgTotal:localToGlobal({x = 71, y = -2})
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_PET_SKIN_TIPS,{
        pt = point,
    })
end

function UICompPetSkin:showTips()
    if not self._consumeItemId then
        return
    end
    local itemId = self._consumeItemId
    local itemMeta = CacheManager:getItemMeta(itemId)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemMeta, tipsType = Constant.PROPTIPS_FORM.Display})
end

return UICompPetSkin