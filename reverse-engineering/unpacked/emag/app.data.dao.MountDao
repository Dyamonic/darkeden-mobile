-- 坐骑
local MountDao = {}
function MountDao:queryAll()
    local mapTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Mount") do
        local meta = lt.MountMeta.new(row)
        mapTable[#mapTable + 1] = meta
    end
    return mapTable
end

function MountDao:query(Id)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Mount WHERE Id=%d;", tonumber(Id))) do
        local meta = lt.MountMeta.new(row)
        return meta
    end
end

return MountDao
