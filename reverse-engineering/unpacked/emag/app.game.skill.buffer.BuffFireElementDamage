local BuffFireElementDamage = class("BuffFireElementDamage", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local ScheduleUtil  = lt.ScheduleUtil
local CacheManager = lt.CacheManager

--[[
    火元素攻击-伤害
]]
function BuffFireElementDamage:ctor(time, actor, skilllevel)    
    BuffFireElementDamage.super.ctor(self, BuffEnum.EFFECTSTATUS_FIRE_ELEMENTAL, time, actor)
    -- 被攻击播特效即可
    local skillId = SkillEnum.SKILL_SUMMON_OF_FIRE_ELEMENTAL
    local actionInfoMetas = CacheManager:getHitMetas(skillId, 0)
    actor:playParallelEffectSpecial(skillId, {actionInfoMetas[2]})
end

function BuffFireElementDamage:onClear()
    BuffFireElementDamage.super.onClear(self)
end


return BuffFireElementDamage
