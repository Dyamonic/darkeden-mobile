local SheildModule = {}


SheildModule.STATE = {
    None_Red   = 0,         --无红点
    Strong_Red = 1,         --强化红点
    Active_Red = 2,         --激活红点
    Zhulin_Red = 3,         --注灵红点
}

function SheildModule:init()
    self._sheildList = {}
    self._listRed = {}
    self._listIndex = 0
end

function SheildModule:clear()
    self._listRed = nil
    self._listIndex = 0
    self._sheildList = nil
end

function SheildModule:setSheildList(respnseList)
    if not respnseList or type(respnseList) ~= "table" then
        return
    end

    self._sheildList = {}
    for k,v in pairs(respnseList) do
        if v then
            local index = #self._sheildList+1
            self._sheildList[index] = {}
            self._sheildList[index].skinId = v.skinId
            self._sheildList[index].level = v.level
        end
    end

    -- self:checkRedTips()
end

function SheildModule:initRedTips()
    lt.RedDotModule:createTipsNode("GameLayerUI_SheildRedTipsActive", "GameLayerUI_HeroRedTips")
    self:checkRedTips()
end

function SheildModule:resetRedTipsInfo(selectID)
    if not self._sheildList then
        return
    end
    self._listIndex = selectID

    self:checkRedTips()
end

function SheildModule:checkRedTips()
    if not self._sheildList then
        return
    end

    local state = false
    local isActive = false
    local isZhulin = false
    --首先 开启需要 材料数量 读SheildDao
    --开启后 每一级需要材料数量
    local skinArray = lt.SheildDao:querySkinAll()
    for k,v in pairs(skinArray) do
        local skinID = v:getSkinId()
        local isInSheillist = false
        for i=1,#self._sheildList do
            if self._sheildList[i].skinId == skinID then --有这个面巾
                isInSheillist = true
                local curLevel = self._sheildList[i].level
                if curLevel == 0 then
                    --开启材料
                    local info = string.split(v:getUseItem(),":")
                    local haveNum = lt.ItemModule:getItemNumByIdAndType(tonumber(info[1]),tonumber(info[2]))
                    if haveNum >= tonumber(info[3]) then
                        if not isActive then
                            isActive = true
                        end
                        self._listRed[skinID] = SheildModule.STATE.Active_Red
                    else
                        self._listRed[skinID] = SheildModule.STATE.None_Red --不够
                    end
                else
                    --下一级材料
                    local skilldao = lt.SheildDao:querySkill(skinID, curLevel)
                    local info = string.split(skilldao:getUseItem(),":")
                    if info[1] and info[2] then --未满级
                        local haveNum = lt.ItemModule:getItemNumByIdAndType(tonumber(info[1]),tonumber(info[2]))
                        if haveNum >= tonumber(info[3]) then
                            if not isZhulin then
                                isZhulin = true
                            end
                            self._listRed[skinID] = SheildModule.STATE.Zhulin_Red
                        else
                            self._listRed[skinID] = SheildModule.STATE.None_Red --不够
                        end
                    else
                        --已满级
                        self._listRed[skinID] = SheildModule.STATE.None_Red
                    end
                end
                break
            end
        end

        if not isInSheillist then
            local info = string.split(v:getUseItem(),":")
            local haveNum = lt.ItemModule:getItemNumByIdAndType(tonumber(info[1]),tonumber(info[2]))
            if haveNum >= tonumber(info[3]) then
                if not isActive then
                    isActive = true
                end
                self._listRed[skinID] = SheildModule.STATE.Active_Red
            else
                self._listRed[skinID] = SheildModule.STATE.None_Red --不够 
            end
        end
    end

    local state = isActive or isZhulin

    lt.RedDotModule:setTipsStateByName("GameLayerUI_SheildRedTipsActive", state)
end


function SheildModule:getStrongRedTips()
    local state = false
    local items = lt.ItemModule:getEquipItemByPos(lt.Constant.EQUIP_ITEM_POS.pos_horse)
    if items then
        local nextLv = items:getSheildLevel() + 1
        local data = lt.ShieldStrengthenDao:query(nextLv)
        if data then
            state = self:checkItemNum(data:getUseItem())
        end
    end
    
    return state
end

function SheildModule:getZhulinRedTips()
    local redStatus = self._listRed[self._listIndex]
    return redStatus == SheildModule.STATE.Zhulin_Red
end

function SheildModule:getActiveRedTips()
    local redStatus = self._listRed[self._listIndex]
    return redStatus == SheildModule.STATE.Active_Red
end

-- 判断道具存量是否足够
function SheildModule:checkItemNum(str)
    local array = string.split(str,",")
    for i=1,#array do
        local info = string.split(array[i],":")
        local num = lt.ItemModule:getItemNumByIdAndType(tonumber(info[1]),tonumber(info[2]))
        if num < tonumber(info[3]) then
            return false
        end
    end
    return true
end

function SheildModule:getRedTipsInfo()
    return self._listRed
end

return SheildModule
