-- 暗影剑舞假身移动
local HeroStateDancing = class("HeroStateDancing", lt.HeroStateBase)
local Constant = lt.Constant
local ActionManager = lt.ActionManager
HeroStateDancing._moveTypeCur = nil
HeroStateDancing._mTarget = nil
HeroStateDancing._nTarget = nil
HeroStateDancing._xTarget = nil
HeroStateDancing._yTarget = nil

-- onMessage使用
HeroStateDancing._moveType      = nil
HeroStateDancing._moveDirection = nil
HeroStateDancing._mNext         = nil
HeroStateDancing._nNext         = nil
HeroStateDancing._speedRate     = 14


function HeroStateDancing:ctor(heroAgent, moveType, direction, mTarget, nTarget, destDir)
    HeroStateDancing.super.ctor(self, heroAgent)

    -- 脚步身间隔
    self._audioInterval = 0.4
    self._audioElapse = self._audioInterval

    self:initMove(moveType, direction, mTarget, nTarget)
    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent  then
        return 
    end
    self._worldAgent = worldAgent
    self._destDir = destDir
    self._playActioning = false
    self._isDeleteAgent = false
    local count, step = ActionManager:getActorFrameCount(self._heroAgent:getHeroData():getModelName(), Constant.ACTION_SLAYER_BLADE, self._heroAgent:getDirection(),self._heroAgent:getTransformId(),self._heroAgent:getCurStepMultiple())
    local totalTime = (count) * step
    self._timeTrigger = lt.TimeTrigger.new(totalTime)
end

function HeroStateDancing:onClear()
    self._heroAgent = nil
    self._worldAgent = nil
    HeroStateDancing.super.onClear(self)

end

function HeroStateDancing:onEnter()
    if not self._heroAgent:getIsSelf() then
        local leftCount = self._heroAgent:getCmdSystem():getCmdCount()
        if leftCount > 0 then
            self._speedRate = 1 + leftCount * 0.3
        end
    end
end

function HeroStateDancing:onExit()
end

function HeroStateDancing:onUpdate()
    if not self._heroAgent then
        return  
    end
    if self._isDeleteAgent then
        return
    end
    if self._playActioning then
        if self._timeTrigger:tick() then
            self._isDeleteAgent = true
            if self._worldAgent then
                self._worldAgent:deleteAgent(self._heroAgent:getObjId())
            end
        end
        return  
    end
    -- 无法移动
    local xHero, yHero = self._heroAgent:getPosition()
    local directionV = cc.pSub(cc.p(self._xTarget, self._yTarget), cc.p(xHero, yHero))
    local length = cc.pGetLength(directionV)

    local step = self._heroAgent:getMoveSpeed(self._moveTypeCur) * lt.GameBoard:getDeltaTime() * self._speedRate
    -- yflog:Info("step: %02f, self._moveTypeCur:%d, moveSpeed:%d, self._speedRate:%d", step,self._moveTypeCur, self._heroAgent:getMoveSpeed(self._moveTypeCur),self._speedRate)

    if length < step then
        -- 到达
        self._heroAgent:setPosition(self._xTarget, self._yTarget)
        self._heroAgent:setDirection(self._destDir)
        self._playActioning = true
        self._heroAgent:playAction(Constant.ACTION_SLAYER_BLADE)
        self._heroAgent:getActor():setStop()

    else
        -- 未到
        directionV = cc.pMul(cc.pNormalize(directionV), step)
        -- yflog:Info("directionV:%s, cc.pNormalize(directionV):%s", yflog:Positon(directionV), yflog:Positon(cc.pNormalize(directionV)))

        self._heroAgent:setPosition(xHero + directionV.x, yHero + directionV.y)

        if self._fixDirection then
            self._fixDirection = false
            
            self._heroAgent:setDirection(lt.MapUtil:calcDirectionXY(directionV.x, directionV.y))
        end
    end

    self._moveType      = nil
    self._moveDirection = nil
    self._mNext         = nil
    self._nNext         = nil

    -- 脚步声
    self._audioElapse = self._audioElapse + lt.GameBoard:getDeltaTime()
    if self._audioElapse > self._audioInterval then
        self._audioElapse = self._audioElapse - self._audioInterval

        self._heroAgent:mapTileAudio(self._moveTypeCur)
    end
end

function HeroStateDancing:playMoveAction()
    self._heroAgent:playMoveAction(self._moveTypeCur)
end

function HeroStateDancing:onMessage(msg)

end

function HeroStateDancing:getStateId()
    return lt.Constant.HERO_STATE_MOVE
end

function HeroStateDancing:getStateName()
    return "HeroStateDancing"
end


function HeroStateDancing:initMove(moveType, direction, mNext, nNext)
    self._moveTypeCur = moveType
    self._mTarget = mNext
    self._nTarget = nNext
    self._xTarget, self._yTarget = lt.MapUtil:calcMNMid(self._mTarget, self._nTarget)

    -- 设置方向
    self._heroAgent:setDirection(direction)

    -- 按照动作定义脚步声音间隔
    local actionInfo = self._heroAgent:getActor():getActionInfo()
    if actionInfo then
        self._audioInterval = (actionInfo:getStep() or 0.1) * 4
    end
      -- 播放动画
    self:playMoveAction()
    self:setFakeCreatureFastMoveAction(mNext, nNext)
end

-- 修正方向
function HeroStateDancing:setFixDirection()
    self._fixDirection = true
end

--- 暗影剑舞假身移动
function HeroStateDancing:setFakeCreatureFastMoveAction(sX, sY, skillID, targetID)
    local mHero, nHero = self._heroAgent:getMNExactly()
    self._heroAgent:getActor():fastMovePosition(sX, sY, {moveTimesDiv = 4, mHero = mHero, nHero = nHero})

    self.m_nBasicActionInfo = skillID
    self.m_nSpecialActionInfo = skillID
    self.m_TraceID = targetID
end

return HeroStateDancing
