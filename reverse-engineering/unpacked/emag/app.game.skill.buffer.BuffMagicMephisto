local BuffMagicMephisto = class("BuffMagicMephisto", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local ScheduleUtil  = lt.ScheduleUtil

--[[
    死亡契约
]]
function BuffMagicMephisto:ctor(time, actor, skilllevel)    
    BuffMagicMephisto.super.ctor(self, BuffEnum.EFFECT_CLASS_MEPHISTO, time, actor)
    -- 播放特效 1为目标对象
    actor:playEffect(SkillEnum.SKILL_MEPHISTO)
end

function BuffMagicMephisto:onClear()
    self._actor:stopQueueEffect(SkillEnum.SKILL_MEPHISTO)

    BuffMagicMephisto.super.onClear(self)
end

return BuffMagicMephisto
