local GamblingShopDao = {}

function GamblingShopDao:query(itemId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM GamblingShop WHERE ItemId=%d;", tonumber(itemId))) do
    	local meta = lt.GamblingShopMeta.new(row)
        return meta
    end
end

function GamblingShopDao:queryAll()
    local gamblingMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM GamblingShop") do
        local meta = lt.GamblingShopMeta.new(row)
        if not gamblingMap[meta:getShopType()] then
            gamblingMap[meta:getShopType()] = {}
        end
        if not gamblingMap[meta:getShopType()][meta:getSite()] then
            gamblingMap[meta:getShopType()][meta:getSite()] = {}
        end
        table.insert(gamblingMap[meta:getShopType()][meta:getSite()], meta)
    end
    return gamblingMap
end

return GamblingShopDao