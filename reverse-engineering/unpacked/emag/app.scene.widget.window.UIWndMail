--------------------- simple ui get data logic --------------------------

function UIWndMail:getGlistItemByItemIndex(index)
    local childIndex = self._tabList:itemIndexToChildIndex(index)
    return self._tabList:getChildAt(childIndex);
end

function UIWndMail:clearList(isAll)
    self._seletIndex = nil
    self._listItemNums = nil
end

return UIWndMail
