---@魔族技能tips
---@class UIWndMagicOTips:UIWindowBase
local UIWndMagicOTips = class("UIWndMagicOTips", lt.UIWindowBase)

local NtfManager = lt.NtfManager
local WndLockManager = lt.WndLockManager
local Constant = lt.Constant
local CacheManager = lt.CacheManager
local SkillModule = lt.SkillModule
local CommonModule = lt.CommonModule
local ItemModule = lt.ItemModule
local ShaderBackendUtil = lt.ShaderBackendUtil
local SkeletonManager = lt.SkeletonManager
local ScheduleManager = lt.ScheduleManager

-- 写死固定几个技能框
local blueFrameSkillId = {
    [13029] = true,
    [13031] = true,
    [13030] = true,
    [17003] = true,
    [16011] = true,
    [14010] = true,
    [15013] = true,
    [16012] = true,
    [14011] = true,
    [15014] = true,
}
local Constant = lt.Constant
local BUTTON_LONG_PRESS_TIME = Constant.BUTTON_LONG_PRESS_TIME
local BUTTON_CHECK_TIMES = Constant.BUTTON_CHECK_TIMES

function UIWndMagicOTips:ctor(param)
    UIWndMagicOTips.super.ctor(self, param)

    self._magicSelectId = nil
    self._cyanIcon = nil
    self._isGray = nil
    self._skillPointLimit = nil
    self._downLv = nil
    self._spineList = {}

    --- 定时器相关计数
    self._counter = 0
    self._isOpenLearnSche = false
    self._learnCount = 0
    self._isOpenAddSche = false
    self._addCount = 0
    self._isOpenSubSche = false
    self._subCount = 0

end

function UIWndMagicOTips:onClear()
    UIWndMagicOTips.super.onClear(self)

    self._magicSelectId = nil
    self._cyanIcon = nil
    self._isGray = nil
    self._skillPointLimit = nil
    self._downLv = nil
    self._spineList = nil
end

function UIWndMagicOTips:onInit()
    UIWndMagicOTips.super.onInit(self, string.format(_GURL.GetCompRoleInfo,"MagicOTips"))
    self:initUI()
end

function UIWndMagicOTips:initUI()
    self._icon = self:getChild("icon")
    self:refreshBtn()
    self._downLv = 0
    self:refreshSkillTipsInfo()

    --添加特效
    self._spine = SkeletonManager:createSkeletonEffectWithFile("JiNengXueXi", "JNXX_skeleton")
    self:getChild("spineNode"):displayObject():addChild(self._spine)
    self._spine:setCallback(handler(self, self.spineAnimationEnd))
    self._spine:setPosition(30, -33)
    self._spine:setVisible(false)

    self._cleanSpine = SkeletonManager:createSkeletonEffectWithFile("JiNengXueXi02", "JNXX02_skeleton")
    self:getChild("spineNode"):displayObject():addChild(self._cleanSpine)
    self._cleanSpine:setCallback(handler(self, self.cleanSpineAnimationEnd))
    self._cleanSpine:setPosition(34, -33)
    self._cleanSpine:setVisible(false)
end

function UIWndMagicOTips:refreshBtn()
    --学习按钮
    self._learnBtn = self:getChild("frame"):getChild("btn")

    --加号
    self._addBtn = self:getChild("addBtn")
    
    --减号
    self._minusBtn = self:getChild("minusBtn")

    self._costLabel = self:getChild("cost")
    self._cleanNode = self:getChild("cleanNode")
end

function UIWndMagicOTips:onCancelBtnClick()
end

function UIWndMagicOTips:onShown()
    UIWndMagicOTips.super.onShown(self)
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_SKILL_TIPS_INFO, handler(self, self.refreshSkillInfo), "UIWndMagicOTips:refreshSkillInfo")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SKILL_LEARN, handler(self, self.onLearnSkill), "UIWndMagicOTips:onLearnSkill")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SKILL_UPGRADE, handler(self, self.onUpgradeSkill), "UIWndMagicOTips:onUpgradeSkill")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SKILL_RETURN, handler(self, self.onReturnSkill), "UIWndMagicOTips:onReturnSkill")
    
    --设置类型
    local param = self:getParam().param or {}
    self._type = param.type or Constant.ENTER_TYPES.LEARN
    self._skillType = param.skillType or 1
    self._downLv = 0
    --刷新界面
    if self:getContentPane() then
        self:refreshSkillTipsInfo()
    end



    ----------------------------------------------------------------------------------
    local closeBtn = self:getChild("frame"):getChild("closeButton1")
    closeBtn:addClickListener(function()
        if self._type == Constant.ENTER_TYPES.FORGET then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndLock", close = true})
        else
            WndLockManager:closeIgnoreRoleInfo()
        end
    end)

    ----------------------------------------------------------------------------------
    local function learnFunc()
        if self._type == Constant.ENTER_TYPES.LEARN then
            self:learnSkill()
        else
            self:forgetSkill()
        end
    end

    local function addFunc()
        if self._downLv <= 0 then
            self:stopAllBtnScheduler()
            return
        end
        self._downLv = self._downLv - 1
        if self._downLv < 0 then
            self._downLv = 0
        end
        self:refreshSkillTipsInfo()
    end

    local function subFunc()
        local skillCfg = CacheManager:querySkillMeta(self._magicSelectId)
        local canDelete = skillCfg:getCanDelete()
        local lv = SkillModule:getSkillLevel(self._magicSelectId)
        local maxLv = canDelete <= 0 and lv - 1 or lv
        if self._downLv > maxLv then
            self:stopAllBtnScheduler()
            return
        end
        self._downLv = self._downLv + 1
        if self._downLv > maxLv then
            self._downLv = maxLv
        end
        self:refreshSkillTipsInfo()
    end

    ScheduleManager:startTimeCounter(ScheduleManager.TC.MAGIC_OUTERS_TIPS_UPDATE, {callback = function()
        self._counter = self._counter + 1
        if self._counter >= BUTTON_CHECK_TIMES then
            if self._isOpenLearnSche then
                self._learnCount = self._learnCount + 1
                if self._learnCount > BUTTON_LONG_PRESS_TIME  then
                    learnFunc()
                end
            end
            if self._isOpenAddSche then
                self._addCount = self._addCount + 1
                if self._addCount > BUTTON_LONG_PRESS_TIME then
                    addFunc()
                end
            end
            if self._isOpenSubSche then
                self._subCount = self._subCount + 1
                if self._subCount > BUTTON_LONG_PRESS_TIME then
                    subFunc()
                end
            end
            self._counter = 0
        end
    end })

    self._learnBtn:addEventListener(fgui.UIEventType.TouchBegin, handler(self, function()
        local state = SkillModule:getCurSkillState(self._magicSelectId)
        if self._type == Constant.ENTER_TYPES.LEARN and state == Constant.SkillState.Learned then
            self._isOpenLearnSche = true
        end
    end))
    self._learnBtn:addEventListener(fgui.UIEventType.TouchEnd, handler(self, function()
        self._isOpenLearnSche = false
        if self._learnCount > BUTTON_LONG_PRESS_TIME then
            self._learnCount = 0
            return 
        end
        self._learnCount = 0
        learnFunc()
    end))

    ----------------------------------------------------------------------------------

    self._addBtn:addEventListener(fgui.UIEventType.TouchBegin, handler(self, function()
        self._isOpenAddSche = true
    end))
    self._addBtn:addEventListener(fgui.UIEventType.TouchEnd, handler(self, function()
        self._isOpenAddSche = false
        if self._addCount > BUTTON_LONG_PRESS_TIME then
            self._addCount = 0
            return 
        end
        self._addCount = 0
        addFunc()
    end))
    
    ----------------------------------------------------------------------------------

    self._minusBtn:addEventListener(fgui.UIEventType.TouchBegin, handler(self, function()
        self._isOpenSubSche = true

    end))
    self._minusBtn:addEventListener(fgui.UIEventType.TouchEnd, handler(self, function()
        self._isOpenSubSche = false
        if self._subCount > BUTTON_LONG_PRESS_TIME then
            self._subCount = 0
            return 
        end
        self._subCount = 0
        subFunc()
    end))
end

function UIWndMagicOTips:onHide()
    local closeBtn = self:getChild("frame"):getChild("closeButton1")
    closeBtn:removeClickListener()
    ScheduleManager:stopTimeCounter(ScheduleManager.TC.MAGIC_OUTERS_TIPS_UPDATE)

    self._learnBtn:removeEventListener(fgui.UIEventType.TouchBegin)
    self._learnBtn:removeEventListener(fgui.UIEventType.TouchEnd)

    self._addBtn:removeEventListener(fgui.UIEventType.TouchBegin)
    self._addBtn:removeEventListener(fgui.UIEventType.TouchEnd)

    self._minusBtn:removeEventListener(fgui.UIEventType.TouchBegin)
    self._minusBtn:removeEventListener(fgui.UIEventType.TouchEnd)

    self._type = nil
    UIWndMagicOTips.super.onHide(self)
    WndLockManager:clearMagicSelectId()
    NtfManager:removeNtfListenerByTag("UIWndMagicOTips:refreshSkillInfo")
    NtfManager:removeNtfListenerByTag("UIWndMagicOTips:onLearnSkill")
    NtfManager:removeNtfListenerByTag("UIWndMagicOTips:onUpgradeSkill")
    NtfManager:removeNtfListenerByTag("UIWndMagicOTips:onReturnSkill")
end

function UIWndMagicOTips:refreshSkillInfo()
    self._downLv = 0
    self:refreshSkillTipsInfo()
end

function UIWndMagicOTips:refreshSkillTipsInfo()
    local magicSelectId = WndLockManager:getMagicSelectId()
    self._magicSelectId = magicSelectId

    local skillCfg = CacheManager:querySkillMeta(self._magicSelectId)
    if not skillCfg then return end
    
    -- 技能框
    local frame1 = self:getChild("frame1")
    local frame2 = self:getChild("frame2")
    local isBlue = blueFrameSkillId[skillCfg:getSkillId()] or false
    frame1:setVisible(not isBlue)
    frame2:setVisible(isBlue)

    -- 技能名
    local name = self:getChild("name")
    local nameStr = skillCfg:getName()
    if skillCfg:getPassiveSkill() == 1 then
        nameStr = nameStr.." [color=#5096c8]("..GReadText.KET_SKILL_TIPS11..")[/color]"
    end
    name:setText(nameStr)

    -- 技能等级
    local levelT = self:getChild("level")
    local skillLvl = SkillModule:getSkillLevel(skillCfg:getSkillId())
    local maxLv = skillCfg:getLeveUpPoint() == 0 and 1 or Constant.MAXLEVEL
    if skillLvl > maxLv then skillLvl = maxLv end
    local lvStr = table.concat({
        GReadText.KET_SKILL_TIPS16 or "", skillLvl - self._downLv
    })
    if self._downLv > 0 then
        lvStr = lvStr.."[color=#dda411](-"..self._downLv..")[/color]"
    end
    levelT:setText(lvStr)
    
    -- 技能图标
    local state = SkillModule:getCurSkillState(self._magicSelectId)
    local spriteId = skillCfg:getSpriteID()
    self._icon:setURL(string.format("ui://Skill/%s", spriteId))

    if self._cyanIcon then
        self._cyanIcon:removeFromParent()
        self._cyanIcon = nil
    end

    local white = cc.c3b(255,255,255)
    if state == Constant.SkillState.NotLearnable then
        self._icon:setGrayed(true)
        self._icon:setColor(white)
        levelT:setColor(Constant.COLOR_TEXT_GRAY)
    elseif state == Constant.SkillState.Learnable then
        self._icon:setGrayed(false)
        self._icon:setColor(cc.c3b(0,255,0))
        levelT:setColor(Constant.COLOR_GREEN)
    elseif state == Constant.SkillState.Learned then
        self._icon:setGrayed(false)
        self._icon:setColor(white)
        levelT:setColor(Constant.COLOR_TEXT_WHITE)
        
        if skillCfg:getPassiveSkill() == 1 then
            local resPath = string.format("ui://Skill/%s", spriteId)
            self._cyanIcon = fgui.UIPackage:createObjectFromURL(resPath)
            self._cyanIcon:setScale(1.8,1.8)
            

            self:getChild("emptyNode"):addChild(self._cyanIcon)
            self._cyanIcon:setPosition(0, 0)
            --[[
                cocos4.0 FIXME:To be verified, shader change use.
            ]]
            ShaderBackendUtil:makeCyanEffect(self._cyanIcon:displayObject())
        end
    end

    -- 限制显示
    local textTable = {}
    local heroData = lt.GameModule:getHeroData()
    local curLevel = heroData:getLevel()
    local needLevel = skillCfg:getNeedLevel()
    if needLevel > 1 then
        table.insert(textTable, curLevel >= needLevel and "[color=#00ff00]\n" or "[color=#ff0000]\n")
        table.insert(textTable, string.format(GReadText.KET_SKILL_TIPS20, needLevel))
        table.insert(textTable, "[/color]")
    end

    -- 火水土元素需求
    if self._type == Constant.ENTER_TYPES.LEARN then
        local fire = skillCfg:getFire()
        if fire > 0 then
            table.insert(textTable, "[color=#ff6563]\n")
            table.insert(textTable, string.format(GReadText.KET_SKILL_TIPS21, fire))
            table.insert(textTable, "[/color]")
        end
        local water = skillCfg:getWater()
        if water > 0 then
            table.insert(textTable, "[color=#6365ff]\n")
            table.insert(textTable, string.format(GReadText.KET_SKILL_TIPS22, water))
            table.insert(textTable, "[/color]")
        end
        local earth = skillCfg:getEarth()
        if earth > 0 then
            table.insert(textTable, "[color=#ffb663]\n")
            table.insert(textTable, string.format(GReadText.KET_SKILL_TIPS23, earth))
            table.insert(textTable, "[/color]")
        end

        -- 火属性限制
        local myFire = heroData:getFireSpiritLevel()
        local fireLimet = true
        if myFire >= fire then
            fireLimet = false
        end

        -- 水属性限制
        local myWater = heroData:getWaterSpiritLevel()
        local waterLimet = true
        if myWater >= water then
            waterLimet = false
        end

        -- 土属性限制
        local myEarth = heroData:getEarthSpiritLevel()
        local earthLimet = true
        if myEarth >= earth then
            earthLimet = false
        end
    end
    
    -- 是否可删除
    local canDelete = skillCfg:getCanDelete()
    local canDeleteStr = GReadText.KET_SKILL_TIPS18
    if canDelete and canDelete > 0 then
        canDeleteStr = GReadText.KET_SKILL_TIPS17

        table.insert(textTable, "[color=#00ff00]\n")
        table.insert(textTable, canDeleteStr)
        table.insert(textTable, "[/color]")
    else
        table.insert(textTable, "[color=#ff0000]\n")
        table.insert(textTable, canDeleteStr)
        table.insert(textTable, "[/color]")
    end
    
    local limitDesc = self:getChild("limitDesc")
    limitDesc:setText(table.concat(textTable))

    local curSkillPoint = heroData:getSkillPoints()
    local pointT = self:getChild("point")
    local skillPoint = skillCfg:getSkillPoint()
    local tipsStr = GReadText.KET_SKILL_TIPS19
    local skillPointStr = string.format(GReadText.KET_SKILL_TIPS24, skillPoint or 0)
    if self._type == Constant.ENTER_TYPES.LEARN then
        if skillLvl == 0 then
            tipsStr = GReadText.KET_SKILL_TIPS25
        else
            skillPoint = skillCfg:getLeveUpPoint()
            skillPointStr = string.format(GReadText.KET_SKILL_TIPS24, skillPoint or 0)
        end
        --技能学习红色提示，（技能点不足时）
        local color = curSkillPoint < skillPoint and "[color=#ff0000]" or "[color=#fffefe]"
        --可学习是绿色
        if state == Constant.SkillState.Learnable then
            color = "[color=#00ff00]"
        end
        skillPointStr = color..skillPointStr.."[/color]"
    else
        if skillLvl - self._downLv <= 0 then
            tipsStr = GReadText.KET_SKILL_TIPS32
        else
            tipsStr = GReadText.KET_SKILL_TIPS31
        end
        local totalPoint = skillCfg:getLeveUpPoint() * self._downLv
        if skillLvl - self._downLv == 0 then
            totalPoint = totalPoint + skillPoint - skillCfg:getLeveUpPoint()
        end
        skillPointStr = string.format(GReadText.KET_SKILL_TIPS33, "[color=#dda411]"..totalPoint.."[/color]")
    end
    pointT:setText(table.concat({tipsStr,"\n",skillPointStr}))
    
    -- 显示描述
    local descList = self:getChild("descList")
    local target = descList:getChildAt(0)
    local descT = target:getChild("desc")
    local descStr = skillCfg:getDescription()
    descT:setText(descStr)
    local size = descT:getSize()
    target:setSize(size.width, size.height)

    --价格
    local price = SkillModule:getCleanSkillCoinNum(self._magicSelectId, self._downLv)
    local coinNum = ItemModule:getValueItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN)
    local colorStr = coinNum >= price and "[color=#dda411]" or "[color=#ff0000]"
    self._costLabel:setText(string.format(GReadText.KET_SKILL_TIPS34, _GURL.GetImageCoin, colorStr..lt.CommonFunc:changeNumberShow(price).."[/color]"))
    self._costLabel:setVisible(self._downLv > 0)

    local maxLv = skillCfg:getLeveUpPoint() == 0 and 1 or Constant.MAXLEVEL
    ------------------------------------------------------------------
    -- 学习按钮
    local bg = self._learnBtn:getChild("bg")
    local title = self._learnBtn:getChild("title")
    local add = self._learnBtn:getChild("add")
    local titleStr = GReadText.KET_SKILL_BTN_STUDY
    if self._type == Constant.ENTER_TYPES.FORGET then
        titleStr = skillLvl - self._downLv <= 0 and GReadText.KET_SKILL_TIPS30 or GReadText.KET_SKILL_TIPS29
        -- title:setVisible(true)
        add:setVisible(false)
        self._learnBtn:setPosition(384,511)
    else
        -- title:setVisible(skillLvl == 0)
        -- add:setVisible(skillLvl ~= 0)
        if skillLvl == maxLv then
            titleStr = GReadText.KET_SKILL_BTN_LVL_MAX
        elseif skillLvl ~= 0 then
            titleStr = GReadText.KET_SKILL_BTN_UPGRADE
        end
        add:setVisible(false)
        self._learnBtn:setPosition(248,511)
    end
    title:setText(titleStr)

    -- 等级限制
    -- local curLvl = heroData:getLevel()
    -- local levelLimit = true
    -- if curLvl >= needLevel then
    --     levelLimit = false
    -- else
    --     lt.LogUtil:debug("levelLimit----------->" .. needLevel .. " " .. curLvl)
    -- end

    -- 技能点限制
    local skillPointLimit = true
    local targetPoint = skillLvl == 0 and skillPoint or skillCfg:getLeveUpPoint()
    if curSkillPoint >= targetPoint then
        skillPointLimit = false
    end
    self._skillPointLimit = skillPointLimit

    local lv = SkillModule:getSkillLevel(self._magicSelectId)
    local isGray = state == Constant.SkillState.NotLearnable or skillPointLimit or lv >= maxLv
    if self._type == Constant.ENTER_TYPES.FORGET then
        isGray = coinNum < price
    end
    if isGray then
        self.isGray = true
        bg:setGrayed(true)
    else
        self.isGray = nil
        bg:setGrayed(false)
    end

    self._cleanNode:setVisible(false)
    if self._type == Constant.ENTER_TYPES.FORGET then
        if (canDelete > 0 and skillLvl > 0) or (canDelete <= 0 and skillLvl > 1) then
            self._cleanNode:setVisible(true)
        end
    end

    if self._type == Constant.ENTER_TYPES.FORGET and ((canDelete <= 0 and skillLvl == 1) or self._downLv == 0) then
        self._learnBtn:setVisible(false)
    else
        self._learnBtn:setVisible(true)
    end

    --刷新加减按钮
    self._addBtn:setVisible(self._downLv > 0)
    if (canDelete > 0 and skillLvl - self._downLv > 0) or (canDelete <= 0 and skillLvl - self._downLv > 1) then
        self._minusBtn:setVisible(true)
    else
        self._minusBtn:setVisible(false)
    end
    ------------------------------------------------------------------
end

function UIWndMagicOTips:learnSkill()
    if self._skillPointLimit then
        self:stopLearnBtnScheduler()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KET_SKILL_TIPS26})
        return
    end

    local skillCfg = CacheManager:querySkillMeta(self._magicSelectId)
    local maxLv = skillCfg:getLeveUpPoint() == 0 and 1 or Constant.MAXLEVEL
    local lv = SkillModule:getSkillLevel(self._magicSelectId)
    if lv >= maxLv then
        self:stopLearnBtnScheduler()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KET_SKILL_TIPS28})
        return
    end

    if self.isGray then
        self:stopLearnBtnScheduler()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KET_SKILL_TIPS3})
        return
    end

    local state = SkillModule:getCurSkillState(self._magicSelectId)
    if state == Constant.SkillState.Learned then
        local msgType = CommonModule:GetNetCmdEnum("UPGRADE_TYPE_UPGRADE_ENUM")
        SkillModule:sendUpgradeSkill(msgType, self._magicSelectId, 1)
    else
        SkillModule:sendLearnSkill(0, self._magicSelectId, self._skillType)
    end
end

function UIWndMagicOTips:forgetSkill()
    local skillCfg = CacheManager:querySkillMeta(self._magicSelectId)
    local coinNum = ItemModule:getValueItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN)
    local price = SkillModule:getCleanSkillCoinNum(self._magicSelectId, self._downLv)
    if coinNum < price then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KET_SKILL_TIPS35})
        return
    end

    --判断依赖技能
    local dependSkills = CacheManager:queryDependSkillMeta(self._magicSelectId)
    local cantSkillMetas = {}

    --回收还是降级
    local skillLvl = SkillModule:getSkillLevel(self._magicSelectId)
    local isRemove = skillLvl - self._downLv == 0
    local title = isRemove and string.format(GReadText.KET_SKILL_TIPS39, skillCfg:getName())
    or string.format(GReadText.KET_SKILL_TIPS38, self._downLv)

    --是回收才判断前置
    if isRemove then
        for i = 1, #dependSkills do
            local skillCfg = CacheManager:querySkillMeta(dependSkills[i]:getSkillId())
            local state = SkillModule:getCurSkillState(dependSkills[i]:getSkillId())
            if state == Constant.SkillState.Learned then
                local cant = SkillModule:checkSkillToRoot2(dependSkills[i]:getSkillId(), self._magicSelectId)
                if cant == false then
                    table.insert(cantSkillMetas, dependSkills[i])
                end
            end
        end
    end
    
    if #cantSkillMetas > 0 then
        local contentStr = ""
        for i = 1, #cantSkillMetas do
            contentStr = contentStr..cantSkillMetas[i]:getName()
            if i < #cantSkillMetas then
                contentStr = contentStr.."、"
            end
        end
        contentStr = string.format(GReadText.KET_SKILL_TIPS42, contentStr)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
            title = GReadText.KET_SKILL_TIPS41,
            content = contentStr,
            type = 1
        })
        return
    end

    --总点数和总消耗
    local totalPoint = skillCfg:getLeveUpPoint() * self._downLv
    if skillLvl - self._downLv == 0 then
        totalPoint = totalPoint + skillCfg:getSkillPoint() - skillCfg:getLeveUpPoint()
    end
    local content = string.format(GReadText.KEY_COST_TIPS1, totalPoint, _GURL.GetImageCoin, price)

    --二次弹窗
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
        title = title,
        content = content,
        confirmCallback = function()
            local msgType = CommonModule:GetNetCmdEnum("UPGRADE_TYPE_BACK_ENUM")
            SkillModule:sendBackSkill(msgType, self._magicSelectId, self._downLv)
        end,
    })
end

function UIWndMagicOTips:stopAllBtnScheduler()
    self._isOpenAddSche = false
    self._isOpenSubSche = false
end
function UIWndMagicOTips:stopLearnBtnScheduler()
    self._isOpenLearnSche = false
end

function UIWndMagicOTips:onLearnSkill()
    self._spine:setVisible(true)
    self._spine:setAnimation(0, "JNXX_XueXi", false)
end

function UIWndMagicOTips:onUpgradeSkill()
    --添加特效
    if #self._spineList == 0 then
        local spine = SkeletonManager:createSkeletonEffectWithFile("JiNengXueXi", "JNXX_skeleton")
        self:getChild("spineNode"):displayObject():addChild(spine)
        spine:setPosition(30, -33)
        spine:setAnimation(0, "JNXX_ShengJi", false)
        spine:setCallback(function(event)
            if event.type == "complete" then
                spine:setVisible(false)
                table.insert(self._spineList, spine)
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_INIT_SKILL_LIST)
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_SKILL_TIPS_INFO)
            end
        end)
    else
        local spine = self._spineList[1]
        table.remove(self._spineList, 1)
        spine:setVisible(true)
        spine:setAnimation(0, "JNXX_ShengJi", false)
        spine:setCallback(function(event)
            if event.type == "complete" then
                spine:setVisible(false)
                table.insert(self._spineList, spine)
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_INIT_SKILL_LIST)
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_SKILL_TIPS_INFO)
            end
        end)
    end
end

function UIWndMagicOTips:onReturnSkill(event)
    self._cleanSpine:setVisible(true)
    if event.param.isRemove then
        self._cleanSpine:setAnimation(0, "HuiShou01", false)
    else
        self._cleanSpine:setAnimation(0, "JiangJi", false)
    end
end

--动画回调
function UIWndMagicOTips:spineAnimationEnd(event)
    if event.type == "complete" then
        self._spine:setVisible(false)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_INIT_SKILL_LIST)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_SKILL_TIPS_INFO)
    end
end

function UIWndMagicOTips:cleanSpineAnimationEnd(event)
    if event.type == "complete" then
        if event.animation == "JiangJi" or event.animation == "HuiShou02" then
            self._cleanSpine:setVisible(false)
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_INIT_SKILL_LIST)
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_SKILL_TIPS_INFO)
        elseif event.animation == "HuiShou01" then
            self._cleanSpine:setAnimation(0, "HuiShou02", false)
        end
    end
end

return UIWndMagicOTips