---@class UICompTransactionRecordCell
--- 交易行  交易记录cell
local UICompTransactionRecordCell = class("UICompTransactionRecordCell", lt.UIGButtonBase)

local CacheManager = lt.CacheManager
local CommonFunc = lt.CommonFunc
local Constant = lt.Constant

UICompTransactionRecordCell.ChangeSkinConf = {
    ["Transaction"] = {
        ["bg"] = "bg_pmh_jyludiban02",
        ["bg_select"] = "bg_pmh_jyludiban01",
    },
}

function UICompTransactionRecordCell:ctor()
    UICompTransactionRecordCell.super.ctor(self)
    --UI
    self._lblName = nil
    self._lblType = nil
    self._lblCostType = nil
    self._lblCost = nil
    self._lblTime = nil
end

function UICompTransactionRecordCell:onClear()
    --UI
    self._lblName = nil
    self._lblType = nil
    self._lblCostType = nil
    self._lblCost = nil
    self._lblTime = nil
    UICompTransactionRecordCell.super.onClear(self)
end

function UICompTransactionRecordCell:onConstruct()
    self._lblName = self:getChild("lbl_name")
    self._lblType = self:getChild("lbl_type")
    self._lblCostType = self:getChild("lbl_costType")
    self._lblCost = self:getChild("lbl_cost")
    self._lblTime = self:getChild("lbl_time")
end

function UICompTransactionRecordCell:setObjInfo(data)
    local sid = data.id
    local itemType = data.itemType or Constant.ItemType.ITEM_TYPE_PROP
    local itemMeta = nil
    if itemType == Constant.ItemType.ITEM_TYPE_PROP then
        itemMeta = CacheManager:getItemMeta(sid)
    elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
        itemMeta = CacheManager:queryEquipMeta(sid)
    end
    if not itemMeta then
        yflog:Info("----------------------sid"..sid)
        return
    end
    self._lblName:setText(itemMeta:getName().."x"..data.num)
    self._lblType:setText(data.opType == 0 and GReadText.KEY_TRANSACTION_TIPS10 or GReadText.KEY_TRANSACTION_TIPS11)
    local costMeta = CacheManager:getItemMeta(data.costItemId)
    self._lblCostType:setText(costMeta:getName())
    self._lblCost:setText(data.costNum)
    self._lblTime:setText(CommonFunc:timestampToData(data.dealTimeStamp))
end

return UICompTransactionRecordCell
