local PrivilegeDescDao = {}


function PrivilegeDescDao:queryAll()
    local mapTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM PrivilegeDesc") do
        local mapMeta = lt.PrivilegeDescMeta.new(row)
        mapTable[mapMeta:getId()] = mapMeta
    end
    return mapTable
end

return PrivilegeDescDao
