
local UIDialog = class("UIDialog", function()
    return display.newLayer()
end)

UIDialog._param         = nil
UIDialog._selected      = nil
UIDialog._eventListener = nil
UIDialog._isFixFGuiEnabled = true

function UIDialog:ctor(param)
    self:setParam(param)
    self:enableNodeEvents()
    self:setSwallowsTouches(true)
    if param.mask then
        self:setContentSize(display.width, display.height)
        local layer = cc.LayerColor:create(cc.c4b(0, 0, 0, 100), display.width, display.height)
        layer:setPosition(-display.width/2, -display.height/2)
        self:addChild(layer)
        self:onTouch(handler(self, self.onTouchEvent), false, true)
    else
        lt.AudioManager:playSound(lt.ResManager.SOUND_NUM.MENU_BTN_SUB)
    end
end
function UIDialog:onCleanup()
    self:onViewOutHandler()
    self:onClear()
end

function UIDialog:onClear()

end

function UIDialog:onViewOutHandler()

end

function UIDialog:setParam(param)
    self._param = param
end

function UIDialog:getParam()
    return self._param
end

function UIDialog:onEnter()
    lt.LogUtil:debugTable("------------------------------\n\n             Enter Dialog :  " .. tostring(self:getParam().layerName) .. "\n")
    lt.LogUtil:debugTable("------------------------------")
    self:enterEvent()
end

function UIDialog:onExit()
    lt.LogUtil:debugTable("------------------------------\n\n             Exit Dialog :  " .. tostring(self:getParam().layerName) .. "\n")
    lt.LogUtil:debugTable("------------------------------")
    self:exitEvent()
end

function UIDialog:enterEvent()
    self._eventListener = cc.EventListenerTouchOneByOne:create()
    self._eventListener:setEnabled(true)
    self._eventListener:setSwallowTouches(true)
    self._eventListener:registerScriptHandler(handler(self, self.onDialogTouchBegan), cc.Handler.EVENT_TOUCH_BEGAN)
    self._eventListener:registerScriptHandler(handler(self, self.onDialogTouchMoved), cc.Handler.EVENT_TOUCH_MOVED)
    self._eventListener:registerScriptHandler(handler(self, self.onDialogTouchEnded), cc.Handler.EVENT_TOUCH_ENDED)
    cc.Director:getInstance():getEventDispatcher():addEventListenerWithSceneGraphPriority(self._eventListener, self)
end

function UIDialog:exitEvent()
    cc.Director:getInstance():getEventDispatcher():removeEventListener(self._eventListener)
end

function UIDialog:onOpenView()
    -- 已经打开过的 数据初始化
    self:onEnter()
    if self:getParam().mask then
        self:onTouch(function()
            return true
        end, false, true)
    else
        lt.AudioManager:playSound(lt.ResManager.SOUND_NUM.MENU_BTN_SUB)
    end
end

function UIDialog:onCloseView()
    lt.AudioManager:playSound(lt.ResManager.SOUND_NUM.CLOSE_WIDGET)
    self:onExit()
    self:close()
end

function UIDialog:close()
    self:getParent():closeView(self:getParam().layerName)
    if self:getParam().mask then
        self:removeSelf()
    end
end

function UIDialog:removeSelf()
    self:removeTouch()
    self:onCleanup()
end

-- 同层打开的ui
function UIDialog:openView(layerName, param)
    if not param then param = {} end
    self:getParent():openView(layerName,param)
end

function UIDialog:openMaskView(layerName, param)
    if not param then param = {} end
    param.mask = true
    self:getParent():openMaskView(layerName,param)
end

function UIDialog:contain(point)
    return cc.rectContainsPoint(self:getRect(), point)
end

function UIDialog:getRect()
    local x, y = self:getPosition()
    local anchor = self:getAnchorPoint()
    local w = self:getContentSize().width
    local h = self:getContentSize().height
    return cc.rect(x - anchor.x * w, y - anchor.y * h, w, h)
end

function UIDialog:conectToWorldPoint(node, x, y)
    if not x and not y then
        x, y = node:getPosition()
    end 
    local w = node:getContentSize().width * (0.5 - node:getAnchorPoint().x) * node:getScaleX()
    local h = node:getContentSize().height * (0.5 - node:getAnchorPoint().y) * node:getScaleY()
    local parent = node:getParent()
    if parent then
        x = parent:getPositionX() + x + w
        y = parent:getPositionY() + y + h
        if self == parent then
            return x, y
        else
            return self:conectToWorldPoint(parent, x, y)
        end
    else
        print("error can not find parent")
        return x, y
    end
end

function UIDialog:setPositionEx(offX, offY)
    local x, y = self:getPosition()
    x = x + offX
    y = y + offY
    
    self:setPosition(x, y)
end

function UIDialog:onTouchEvent(event)
    
    return true
end

function UIDialog:onDialogTouchBegan(touch, event)
    local convertToFGui = lt.FGUIUtil:cocosPosToFGui(touch:getLocation())
    local selectTouch = self:getParent():onTouchBegan(convertToFGui)
    local ownTouch = self:contain(convertToFGui)
    if selectTouch and ownTouch then
        return true
    -- elseif selectTouch then
    --     self:getParent():clearSelect()
    end
    return false
end

function UIDialog:onDialogTouchMoved(touch, event)
    local convertToFGui = lt.FGUIUtil:cocosPosToFGui(touch:getLocation())
    self:getParent():onTouchMoved(convertToFGui)
end

function UIDialog:onDialogTouchEnded(touch, event)
    local convertToFGui = lt.FGUIUtil:cocosPosToFGui(touch:getLocation())
    self:getParent():onTouchEnded(convertToFGui)
end

function UIDialog:onTouchBegan(point)
end

function UIDialog:onTouchMoved(point) 
end

function UIDialog:onTouchEnded(point)
end

function UIDialog:getSelected()
    return self._selected
end

function UIDialog:onTouchRemoved()
    
end

function UIDialog:onTouchEndOutside()
    
end

function UIDialog:setSelfPos()
    
end

function UIDialog:checkRedTips(name)
    
end
-- function UIDialog:getDialogByLayerName(layerName)
--     return self:getParent():getDialogByLayerName(layerName)
-- end

function UIDialog:getParent()
    return self.dialogSystem
end

--fixed FGUI
function UIDialog:setChildrenTouchEnabled(enabled)
    self._isFixFGuiEnabled = enabled
    local function setTouchEnabled(node)
        if node:getChildrenCount() > 0 then
            for i, v in ipairs(node:getChildren()) do
                setTouchEnabled(v)
            end
        end
        if tolua.iskindof(node, "cc.Button") then
            node:setEnabled(enabled)
        elseif node:isVisible() and node.setTouchEnabled then
            node:setTouchEnabled(enabled)
        end
        if node._listener then
            --lt.ListView
            node._listener:setEnabled(enabled)
        end
    end
    setTouchEnabled(self)
    print("setChildrenTouchEnabled:",self:getParam().layerName, enabled)
    if self._eventListener and self._eventListener.setSwallowTouches then
        self._eventListener:setSwallowTouches(enabled)
    end
end


return UIDialog
