local AutoManager = {}

function AutoManager:init()
	self:reset()
end

function AutoManager:clear()
	self:reset()
end

function AutoManager:reset()
end

function AutoManager:queryKey(key)
	if not self._configMap then
		return false
	end

	return self._configMap[key]
end

function AutoManager:reloadConfig()
	self._configMap = {}

	self:reloadCommonConfig()
end

function AutoManager:reloadCommonConfig()
	-- 点击地图移动
	self._configMap["TOUCH_MOVE"] = true
end

function AutoManager:getSetting(k1, k2, k3)
	return lt.CommonModule:loadSetting(k1, k2, k3)
end

function AutoManager:onUpdate()
end

function AutoManager:getTouchMove()
	return self:queryKey("TOUCH_MOVE")
end

return AutoManager
