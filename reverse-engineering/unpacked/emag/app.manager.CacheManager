-- 狂暴技能数据缓存
function CacheManager:getBerserkerPairList(frameID)
	if not self._berserkerNumPairsIDList then
		self._berserkerNumPairsIDList = {}
		for pf = 0, 120 - 1, 6 do
			local current = BERSERKER_PAIRS_FRAMES[pf + 1]
			local p1 = BERSERKER_PAIRS_FRAMES[pf + 2]
			local p2 = BERSERKER_PAIRS_FRAMES[pf + 3]
			local p3 = BERSERKER_PAIRS_FRAMES[pf + 4]
			local p4 = BERSERKER_PAIRS_FRAMES[pf + 5]
			local p5 = BERSERKER_PAIRS_FRAMES[pf + 6]
			self._berserkerNumPairsIDList[current] = {}
			table.insert(self._berserkerNumPairsIDList[current], p1)
			table.insert(self._berserkerNumPairsIDList[current], p2)
			table.insert(self._berserkerNumPairsIDList[current], p3)
			table.insert(self._berserkerNumPairsIDList[current], p4)
			table.insert(self._berserkerNumPairsIDList[current], p5)
		end
	end
	if self._berserkerNumPairsIDList[frameID] then
		return self._berserkerNumPairsIDList[frameID]
	else
		yflog:Info("CacheManager:getBerserkerPairList not found data :%s",frameID)
	end
end

-- 黑暗复仇者技能数据缓存
function CacheManager:getExtremePairList(frameID)
	if not self._extremeNumPairsIDList then
		self._extremeNumPairsIDList = {}
		for pf = 0, 48 - 1, 4 do
			local current = EXTREME_PAIRS_FRAMES[pf + 1]
			local p2 = EXTREME_PAIRS_FRAMES[pf + 3]
			self._extremeNumPairsIDList[current] = {}
			table.insert(self._extremeNumPairsIDList[current], current)
			table.insert(self._extremeNumPairsIDList[current], p2)
		end
	end
	if self._extremeNumPairsIDList[frameID] then
		return self._extremeNumPairsIDList[frameID]
	else
		yflog:Info("CacheManager:_extremeNumPairsIDList not found data :%s",frameID)
	end
end

-- 音效数据缓存
function CacheManager:getSoundMap()
	if not self._soundMap then
		self._soundMap = lt.SoundDao:queryAll()
	end
	return self._soundMap
end

function CacheManager:getSoundNameByID(ID)
	if not self._soundMap then
		self:getSoundMap()
	end
	local soundMeta = self._soundMap[ID]
	if soundMeta then
		return soundMeta:getSoundName()
	end
end

-- 根据技能Id 获取对应的音效名称
function CacheManager:getSoundNameBySkillId(skillId)
	local startActionMap = self:getSkillStartActionMap()
	local meta = startActionMap[skillId]
	if meta then
		local soundId = meta:getSoundId()
		return self:getSoundNameByID(soundId)
	else
		return nil
	end
end

function CacheManager:getSoundActionMap()
	if not self._soundActionMap then
		self._soundActionMap = lt.SoundActionDao:queryAll()
	end
	return self._soundActionMap
end


-- 根据actionId 获取对应音效名称
function CacheManager:getSoundNameByActionInfo(combId, actionId)
	local startActionMap = self:getSoundActionMap()
	local metas = startActionMap[combId]
	
	if metas and #metas > 0 then
		local meta = metas[actionId]
		if meta then
			local soundId = meta:getSoundId()
			return self:getSoundNameByID(soundId)
		end
	else
		return nil
	end
end

-- 自动售卖 
function CacheManager:getRecycleSettingsMap()
	if not self._recycleSettingsMap then
		self._recycleSettingsMap = lt.AutoRecycleSettingsDao:queryAll()
	end
	return self._recycleSettingsMap
end

function CacheManager:getRecycleSettingsList()
	if not self._recycleSettingsList then
		self._recycleSettingsList = {}
	end
	return self._recycleSettingsList
end

function CacheManager:getRecycleSettingsByIdx(Idx)
	if not Idx or Idx == 0 then
		return nil
	end
	local tb = self:getRecycleSettingsList()
	if not tb[Idx] then
		tb[Idx] = lt.AutoRecycleSettingsDao:queryByIdx(Idx)
	end
	return tb[Idx]
end
--[[  
	我要变强表查询
]]
function CacheManager:getStrongMap()
	if not self._strongeMap then
		self._strongeMap = lt.StrongDao:queryAll()
	end
	return self._strongeMap
end

function CacheManager:getStrongMapByRace(myRace)
	local mapTable = {}
	local strongMap = self:getStrongMap()
    for i = 1, #strongMap do
		local meta = strongMap[i]
        local race = meta:getOccupation()
        if race == 0 or myRace == race then
            local type = meta:getType()
            if not mapTable[type] then
				local tabs = {}
				tabs.idx = type
				tabs.name = meta:getTypeName()
				tabs.metas = {}
                mapTable[type] = tabs
            end
			table.insert(mapTable[type].metas, meta)
        end
    end
    return mapTable
end


