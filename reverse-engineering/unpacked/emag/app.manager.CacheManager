-- 根据装备id 查装备信息
function CacheManager:queryEquipMeta(equipId)
	if not equipId or equipId == 0 then
		return nil
	end

	local tb = self:getEquipMap()
	if not tb[equipId] then
		tb[equipId] = lt.EquipDao:query(equipId)
	end
	
	return tb[equipId]
end
