		self._helpMap = lt.HelpDao:queryAll()
	end
	return self._helpMap
end

function CacheManager:getHelpMapByRace(myRace)
	local mapTable = {}
	local helpMap = self:getHelpMap()
    for i, meta in ipairs(helpMap or {}) do
        local race = meta:getRace() or 0
        if race == 0 or myRace == race then
            local type = meta:getType()
            if not mapTable[type] then
                mapTable[type] = {}
            end
			table.insert(mapTable[type], meta)
        end
    end
    return mapTable
end


