-- model 角色模型
function CacheManager:getModelTable()
	if not self._modelTable then
		self._modelTable = {}
	end

	return self._modelTable
end

function CacheManager:getModelMeta(modelId)
	local modelTable = self:getModelTable()
	if not modelTable[modelId] then
		modelTable[modelId] = lt.ModelDao:query(modelId)
	end
	return modelTable[modelId]
end

function CacheManager:getModelCountByActionId(modelId,actionId)
	return self:getModelMeta(modelId) and self:getModelMeta(modelId):getFrameCount(actionId) or nil
end

function CacheManager:queryAchiveTitleMetaById(id)
    if not self._achiveTitleMap then
        self._achiveTitleMap = {}
    end

    if not self._achiveTitleMap[id] then
        self._achiveTitleMap[id] = lt.AchiveTitleDao:query(id)
    end

    return self._achiveTitleMap[id]
end

function CacheManager:queryAchiveTitleMeta()
    if not self._achiveTitleMap then
        self._achiveTitleMap = lt.AchiveTitleDao:queryAll()
    end

    return self._achiveTitleMap
end

function CacheManager:queryAchiveMeta()
    if not self._achiveMap then
        self._achiveMap = lt.AchivementDao:queryAll()
    end

    return self._achiveMap
end

function CacheManager:queryAccessMeta(id)
	id = tonumber(id) or 1
	if not self._accessMap then
    	self._accessMap = {}
    end

	if not self._accessMap[id] then
	    self._accessMap[id] = lt.AccessDao:query(id)
	end

	return self._accessMap[id]
end

function CacheManager:queryAdditionTipsMeta()
    if not self._addTipsMap then
    	self._addTipsMap = lt.AdditionTipsDao:queryAll()
    end

    return self._addTipsMap
end

function CacheManager:queryAdditionTipsMetaByKey(key)
    if not self._addTipsMap then
    	self._addTipsMap = self:queryAdditionTipsMeta()
    end

    local meta

    for k,v in pairs(self._addTipsMap) do
    	if v:getKey() == key then
    		meta = v
    		break
    	end
    end

    if not meta then
    	meta = lt.AdditionTipsDao:queryByKey(key)
    end
    return meta
end

function CacheManager:getHelpDescribeMetaByType(helpType)
    if not helpType or helpType == "" then return end

    if not self._helpDescribeMap then
    	self._helpDescribeMap = {}
    end

    if not self._helpDescribeMap[helpType] then
		self._helpDescribeMap[helpType] = lt.HelpDescribeDao:query(helpType)
	end

	return self._helpDescribeMap[helpType]
end

function CacheManager:queryExpBoxMetaByLv(level)
    level = tonumber(level) or 1
