--[[
	常量表查询
]]
function CacheManager:getVariableMap()
	if not self._variableMap then
		self._variableMap = {}
	end

	return self._variableMap
end

function CacheManager:getVariableById(variableId, isToNumber)
	local variableMap = CacheManager:getVariableMap()
	if not variableMap[variableId] then
		local variableMeta = lt.VariableDao:query(variableId)
		if variableMeta then
			self._variableMap[variableId] = variableMeta:getValue()
		end
	end
	local value = self._variableMap[variableId]
	if isToNumber then
		value = tonumber(self._variableMap[variableId])
	end
	return value
end

function CacheManager:getValueById(variableId)
	local value = CacheManager:getVariableById(variableId)
	if lt.Constant.Variable.StorePrice == variableId then
		return tonumber(value) or 0
	elseif lt.Constant.Variable.StoreMaxCoin == variableId then
		return tonumber(value) or 0
	elseif lt.Constant.Variable.BagMaxCoin == variableId then
		return tonumber(value) or 0
	elseif lt.Constant.Variable.Hairdye == variableId then
		local itemList = string.split(value, ",")
		for k,v in ipairs(itemList) do
			itemList[k] = tonumber(v)
		end
		return itemList
	elseif lt.Constant.Variable.WearEquipIconScale == variableId then
		return tonumber(value) or 0
	elseif lt.Constant.Variable.Reputation1 == variableId or 
		lt.Constant.Variable.Reputation2 == variableId or
		lt.Constant.Variable.Reputation3 == variableId or
		lt.Constant.Variable.Reputation4 == variableId then
		local list = string.split(value, ",")
		for k,v in ipairs(list) do
			list[k] = tonumber(v)
		end
		return list
	elseif lt.Constant.Variable.AdvanceEquipNumber == variableId then
		local list = {}
		local dm = string.split(value, "|")
		for i = 1, #dm do
			local ds = string.split(dm[i], ":")
			list[tonumber(ds[1])] = tonumber(ds[2])
		end
		return list
	elseif lt.Constant.Variable.PetAttr1UnlockLevel == variableId
		or lt.Constant.Variable.PetAttr2UnlockLevel == variableId
		or lt.Constant.Variable.PetAttr3UnlockLevel == variableId then
		return tonumber(value) or 0
	elseif lt.Constant.Variable.PetSynMain == variableId
    	or lt.Constant.Variable.PetSynSass == variableId then
		return tonumber(value) or 0
	elseif lt.Constant.Variable.GuildQuitAndApplyCD == variableId then
		return tonumber(value) or 0
	else
		return value
	end
end


