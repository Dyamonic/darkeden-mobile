--[[  
	技能表
	table[skillId] = meta
]]
function CacheManager:getSkillMap()
	if not self._skillMap or not self._dependSkillMap then
		self._skillMap, self._dependSkillMap = lt.SkillDao:queryAllSkill()
	end
end


-- 根据技能id 查询技能信息
function CacheManager:querySkillMeta(skillId)
	if not skillId then
		return nil
	end

	if not self._skillMap then
		self:getSkillMap()
	end

	return self._skillMap[skillId]
end

-- 根据依赖技能 查询技能组信息
function CacheManager:queryDependSkillMeta(skillId)
	if not skillId then
		return {}
	end
	if not self._dependSkillMap then
		self:getSkillMap()
	end

	return self._dependSkillMap[skillId]
end

--[[
	技能表  (TODO 此处存在内存重复，后期需要优化)
	种族格式
	table[raceId][i] = meta
]]
function CacheManager:getSkillRaceMap()
	if not self._skillRaceMap then
		self._skillRaceMap = {}
	end

	return self._skillRaceMap
end

-- 根据种族id获取所有技能
function CacheManager:getSkillByRace(raceId)
	local skillRaceMap = self:getSkillRaceMap()
	if not skillRaceMap[raceId] then
		self._skillRaceMap[raceId] = lt.SkillDao:queryByRace(raceId)
	end

	return self._skillRaceMap[raceId]
end

-- 通用技能查询
function CacheManager:getCommonSkill()
	if not self._commonSkillMap then
		self._commonSkillMap = lt.SkillDao:queryCommonSkill()
	end

	return self._commonSkillMap
end

function CacheManager:getShowCommonSkill()
	local commonSkillMap = self:getCommonSkill()
	local tempMap = {}
	for k,v in pairs(commonSkillMap) do
		if v:getSkillMenu() == 1 then
			table.insert(tempMap, v)
		end
	end

	return tempMap
end
function CacheManager:getSkillIdMapMeta()
	if not self._skillIdSkillMap then
		self._skillIdSkillMap = {}
	end
	return self._skillIdSkillMap
end

function CacheManager:queryMetaBySkillId(skillId)
	if skillId == nil then return nil end
	local skillIdMap = self:getSkillIdMapMeta()
	if not skillIdMap[skillId] then
		self._skillIdSkillMap[skillId] = lt.SkillDao:queryById(skillId)
	end
	return self._skillIdSkillMap[skillId]
end

