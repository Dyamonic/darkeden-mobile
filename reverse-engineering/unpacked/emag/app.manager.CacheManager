function CacheManager:getNameFirstTable()
	if not self._nameFirstTable then
		self._nameFirstTable = lt.NameFirstDao:queryAll()
	end
	return self._nameFirstTable
end

function CacheManager:getRandNameFirst(ttype)
	ttype = ttype or 0
	local nameFirstTable = self:getNameFirstTable()
	if not nameFirstTable[ttype] then
		return ""
	end

	local nameArray = nameFirstTable[ttype]
	return nameArray[math.random(#nameArray)]
end

function CacheManager:getNameLastTable()
	if not self._nameLastTable then
		self._nameLastTable = lt.NameLastDao:queryAll()
	end
	return self._nameLastTable
end

function CacheManager:getRandNameLast(ttype)
	ttype = ttype or 1
	local nameLastTable = self:getNameLastTable()
	if not nameLastTable[ttype] then
		return ""
	end

	local nameArray = nameLastTable[ttype]
	return nameArray[math.random(#nameArray)]
end

--[[
	地图表 - 安全区|SafeArea
]]
function CacheManager:getSafeAreaMap()
	if not self._safeAreaMap then
		self._safeAreaMap = lt.SafeAreaDao:queryAll()
	end

	return self._safeAreaMap
end

function CacheManager:getSafeAreaArray(mapCode, all)
	local safeAreaMap = self:getSafeAreaMap()

	-- 当前地图所有安全区信息
	local safeAreaArray2 = safeAreaMap[mapCode] or {}
	if all then
		return safeAreaArray2
	end

	local safeAreaArray = {}
	for _, safeAreaMeta in ipairs(safeAreaArray2) do
		if safeAreaMeta:getType() == 0 then
			safeAreaArray[#safeAreaArray + 1] = safeAreaMeta
		end
	end
	return safeAreaArray
end

function CacheManager:getSkillRecycleTable()
	if not self._SkillRecleTable then
		self._SkillRecleTable = {}
	end

	return self._SkillRecleTable
end

function CacheManager:getSkillRecycle(id)
	local skillRecycleTable = self:getSkillRecycleTable()
	if not skillRecycleTable[id] then
		skillRecycleTable[id] = lt.LibraryDao:queryRecycle(id)
	end
	return skillRecycleTable[id]
end

function CacheManager:getBattleChange(job)
    if not self._battleChangeTable then
        self._battleChangeTable = lt.BattleChangeDao:queryAll()
    end
    return self._battleChangeTable[job]
end

-- ********** 天炼 **********
CacheManager._skillEffectTable = nil 	-- 技能特效资源信息表
CacheManager._monsterInfoTable = nil 	-- 怪物信息表
CacheManager._skillMap 	= nil 			-- 技能表
CacheManager._skillRaceMap = nil 		-- 技能表 种族作为key
CacheManager._equipMap = nil 		 	-- 装备表
CacheManager._roleModelMap = nil 		-- 角色外观表

--[[
	effect 技能特效资源表信息
	table[skillId][i] = meta
]]
function CacheManager:getSkillEffect()
	if not self._skillEffectTable then
		self._skillEffectTable = lt.ActionInfoDao:queryAll()
	end

	return self._skillEffectTable
end

function CacheManager:getSkillEffectBySkillId(skillId)
	local tb = self:getSkillEffect()
	
	return tb[skillId]
end

function CacheManager:getSkillEffectBySkillIdAndEName(skillId, eName, owner)
	local skillMetas = self:getSkillEffectBySkillId(skillId)
	if not skillMetas then
		return nil
	end

	local metas = {}
	for _, meta in ipairs(skillMetas) do
		if meta:getEname() == eName then
			local ret = false
			if owner == nil or (owner ~= nil and meta:getOwner() == owner) then
				ret = true
			end

			if ret then
				table.insert(metas, meta)
			end
		end
	end

	return metas
end

function CacheManager:getSkillEffectBySkillIdAndGenerator(skillId, generator, owner)
	local tb = self:getSkillEffect()
	local skillMetas = tb[skillId]
	if not skillMetas then
		return nil
	end

	local metas = {}
	for _, meta in ipairs(skillMetas) do
		local ret = false
		if owner == nil or (owner ~= nil and meta:getOwner() == owner) then
			ret = true
		end

		if ret and meta:getEffectGeneratorId() == generator then
			table.insert(metas, meta)
		end
	end

	return metas
end

--[[
	怪物信息表
	table[monsterId] = meta
]]
function CacheManager:getMonsterInfoTable()
	if not self._monsterInfoTable then
		self._monsterInfoTable = {}
	end

	return self._monsterInfoTable
end

function CacheManager:getMonsterInfoMeta(monsterId)
	local monsterInfoTable = self:getMonsterInfoTable()
	if not monsterInfoTable[monsterId] then
		monsterInfoTable[monsterId] = lt.MonsterInfoDao:query(monsterId)
	end
	return monsterInfoTable[monsterId]
end
--[[
	怪物颜色表
	table[index] = color
]]
function CacheManager:getMonsterColorByIndex(index)
	if not self._monsterColorTable then
		self._monsterColorTable = lt.MonsterColor:queryAll()
	end

	if self._monsterColorTable[index] then
		return self._monsterColorTable[index]:getColor()
	end
end

