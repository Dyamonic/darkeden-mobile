function CacheManager:getMapTable()
	if not self._mapTable then
		self._mapTable = {}
	end
	return self._mapTable
end

function CacheManager:getMapMeta(id)
	local mapTable = self:getMapTable()
	if not mapTable[id] then
		mapTable[id] = lt.MapDao:query(id)
	end
	return mapTable[id]
end

function CacheManager:getMapMetaByMapCoord(mapCoord)
	local mapTable = self:getMapTable()
	for _,v in pairs(mapTable) do
		if v:getMapCoord() == mapCoord then
			return v
		end
	end

	local mapMeta = lt.MapDao:queryByMapCoord(mapCoord)
	if not mapMeta then
		return
	end
	mapTable[mapMeta:getMapCode()] = mapMeta

	return mapMeta
end

