-- 获取阶级技能数据表 低阶1-4, 高阶5-6
function CacheManager:getRankBonusInfoCfg(raceId, startPos, endPos)
    local rankBonusInfoCfg = {}
    local tempRankBonusInfoCfg = {}
    local sortIndex = {}
    local rankBonusInfo = self:getRankBonusInfoMeta(raceId)
    for k,v in pairs(rankBonusInfo) do
        local curCalssLevel = v:getClassLevel()
        if not tempRankBonusInfoCfg[curCalssLevel] then
            tempRankBonusInfoCfg[curCalssLevel] = {}
            table.insert(sortIndex, curCalssLevel)
        end

        table.insert(tempRankBonusInfoCfg[curCalssLevel], v)
    end

    table.sort(sortIndex,function (a,b)
        return a < b
    end)

    for i=startPos,endPos do
        if sortIndex[i] then
            local sortTable = tempRankBonusInfoCfg[sortIndex[i]]
            table.sort(sortTable, function (a,b)
                return a:getRankId() < b:getRankId()
            end)
            table.insert(rankBonusInfoCfg, sortTable)
        end
    end

    return rankBonusInfoCfg
end

