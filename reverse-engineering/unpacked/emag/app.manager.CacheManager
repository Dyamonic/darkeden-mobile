-- 根据SkillId && skillLevel 获取技能特效
function CacheManager:getSkillEffectByIdLv(skillId, skillLevel)
	local skillEffects = self:getSkillEffectById(skillId) or {}
	if not skillLevel then
		return skillEffects[1]
	end

	for _,meta in ipairs(skillEffects) do
		if meta:checkMetaLevel(skillLevel) then
			return meta
		end
	end

	return skillEffects[1]
end

function CacheManager:getActionMetas(skillId,skillLevel)
	local skillMeta = self:getSkillEffectByIdLv(skillId,skillLevel)
    if not skillMeta then
        return
    end
    
    return skillMeta:getActionMetas()
end

-- 获取buff特效
function CacheManager:getBuffMetas(skillId,skillLevel)
    local skillMeta = CacheManager:getSkillEffectByIdLv(skillId,skillLevel)
    if not skillMeta then
        return
    end
    
    return skillMeta:getSelfMetas()
end

-- 获取受击特效
function CacheManager:getHitMetas(skillId,skillLevel)
    local skillMeta = CacheManager:getSkillEffectByIdLv(skillId,skillLevel)
    if not skillMeta then
        return
    end
    
    return skillMeta:getHitMetas()
end

-- 获取过程特效
function CacheManager:getProcessMetas(skillId,skillLevel)
    local skillMeta = CacheManager:getSkillEffectByIdLv(skillId,skillLevel)
    if not skillMeta then
        return
    end
    
    return skillMeta:getProcessMetas()
end

-- 获取子弹表
function CacheManager:getBulletMetas(skillId,skillLevel)
    local skillMeta = self:getSkillEffectByIdLv(skillId,skillLevel)
    if not skillMeta then
        return
    end

	return skillMeta:getProcessMetas()
end

