function CacheManager:getTeamHallMetaByIdx(idx)
	local teamHallMap = self:getTeamHallMap()
	for i = 1, #teamHallMap do
		for j = 1, #teamHallMap[i] do
			if teamHallMap[i][j]:getIdxId() == idx then
				return teamHallMap[i][j]
			end
		end
	end
	return nil
end

