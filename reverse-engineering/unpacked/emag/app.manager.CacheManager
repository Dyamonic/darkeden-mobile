--检测攻击不同步备用接口
function CacheManager:checkMonsterDataInfo()
	local monstertable = lt.MonsterInfoDao:queryAll()
	for _,data in pairs(monstertable) do
		local modelId = data:getModelId()
		local meta = CacheManager:getModelMeta(modelId)
		if meta then
			if data:getAttackInterval()*1000 ~= meta:getAttackTime() then
				print(string.format("怪物攻击间隔不一致 怪物id：%d， 模型id :%d, [%s]",data:getId(),modelId,data:getName()))
			end
		end
	end
end

