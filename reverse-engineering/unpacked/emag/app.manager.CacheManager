--[[
	倾向
]]
function CacheManager:getTendencyAll()
	if not self._tendencyMap then
		self._tendencyMap = lt.TendencyDao:queryAll()
	end

	return self._tendencyMap
end

function CacheManager:getTendencyNameByValue(tendency)
	local tendencyAll = self:getTendencyAll()
	
	for k,v in pairs(tendencyAll) do
		local minValue = v:getMinValue()
		local maxValue = v:getMaxValue()
		if tendency <= maxValue and tendency >= minValue then
			return v:getName() or ""
		end
	end

	return ""
end

function CacheManager:getTendencyIdByValue(tendency)
	local tendencyAll = self:getTendencyAll()
	for k,v in pairs(tendencyAll) do
		local minValue = v:getMinValue()
		local maxValue = v:getMaxValue()
		if tendency <= maxValue and tendency >= minValue then
			return v:getTendencyID()
		end
	end
	if buglyReportLuaException then
        buglyReportLuaException("BUGLY LOG: CacheManager:getTendencyIdByValue range error", tostring(tendency))
    end
	-- bugly 报错返回了nil, 可能服务端给的值超过的范围 -10000 ~ 10000
	if tendency > 10000 then
		return 1
	elseif tendency < -10000 then
		return 5
	end
	return 1
end

