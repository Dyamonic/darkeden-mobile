--[[  
	巴托里和特普兹行宫
]]
function CacheManager:getNpcVampireLairTable()
	if not self._npcVampireLairTable then
		self._npcVampireLairTable = lt.NpcVampireLairDao:queryAll()
	end
	return self._npcVampireLairTable
end

--[[  
	巴托里和特普兹行宫 触发区域
]]
function CacheManager:getNpcTriggerAreaTable(mapcode)
	if self._arrayMap then
		return self._arrayMap
	end
	local npcVampireLairTable = self:getNpcVampireLairTable()
	local tempMap = {}
	local table = npcVampireLairTable[tostring(mapcode)]
	if table and table:getTriggerArea() ~="" then
		local triggerArea = table:getTriggerArea()
		local formatted_str = triggerArea:gsub("%[%[", "{{"):gsub("%]%]", "}}"):gsub("%[", "{"):gsub("%]", "}")
		-- 动态加载字符串生成表
		local success, result = pcall(loadstring("return " .. formatted_str))
		if success then
			tempMap = result
		end
	end

	self._arrayMap = tempMap

	return self._arrayMap
end

--[[  
	巴托里和特普兹行宫 BOSS召唤怪物时的说话内容
]]
function CacheManager:getMasterSummonSayTable(mapcode)
	local npcVampireLairTable = self:getNpcVampireLairTable()
	local table = npcVampireLairTable[tostring(mapcode)]
	if table and table:getMasterSummonSay() ~= "" then
		local value = table:getMasterSummonSay()
		value = string.gsub(value, "[\n\r]", '')
		local itemList = string.split(value, ";")
		for k,v in ipairs(itemList) do
			itemList[k] = v
		end
		return itemList
	end
	return nil
end

--[[  
	巴托里和特普兹行宫 杀死BOSS后的说话内容
]]

function CacheManager:getMasterDeadTable(mapcode)
	local npcVampireLairTable = self:getNpcVampireLairTable()
	local table = npcVampireLairTable[tostring(mapcode)]
	if not table then
		return nil
	end
	local race = lt.GameModule:getHeroRace()
	local value = nil
	if race == Constant.RaceType.Slayer then
		value = table:getMasterDeadSlayerSay()
	elseif race == Constant.RaceType.Vampire then
		value = table:getMasterDeadVampireSay()
	elseif race == Constant.RaceType.Ousters then
		value = table:getMasterNotDeadSay()
	end
	value = string.gsub(value, "[\n\r]", '')
	local itemList = string.split(value, ";")
	for k,v in ipairs(itemList) do
		itemList[k] = v
	end
	return itemList
end

