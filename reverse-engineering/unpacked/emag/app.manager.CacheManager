function CacheManager:queryFlyMeta()
	if not self._flyTable then
		self._flyTable = {}
	end

	if table.nums(self._flyTable) == 0 then
		self._flyTable = lt.FlyDao:queryAll()
    end

    return self._flyTable
end

function CacheManager:queryShopping()
    if not self._shoppingMap then
    	self._shoppingMap = {}
    end

    if table.nums(self._shoppingMap) == 0 then
