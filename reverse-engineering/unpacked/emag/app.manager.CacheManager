	转职副本血之祭坛表查询
]]
	
function CacheManager:getAltarOfBloodMap()
	if not self._altarOfBloodMap then
		self._altarOfBloodMap = lt.AltarOfBloodDao:queryAll()
	end
	return self._altarOfBloodMap
