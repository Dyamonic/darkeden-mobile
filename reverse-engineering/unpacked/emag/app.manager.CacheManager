function CacheManager:getAltarOfBloodMeta(dungeonId)
	local altarOfBloodMap = self:getAltarOfBloodMap()
	return altarOfBloodMap[dungeonId]
end

function CacheManager:getBloodTransferPos(dungeonId)
	if not self._bloodTransferPos then
		self._bloodTransferPos = {}
		local altarOfBloodMap = self:getAltarOfBloodMap()
		local meta = altarOfBloodMap[dungeonId]
		local leaveAreas = meta:getLeaveArea()
		for i = 1, #leaveAreas do
			local m = leaveAreas[i][1]
			local n = leaveAreas[i][2]
			local idx = lt.MapUtil:calcMNIndex(m, n)
			self._bloodTransferPos[idx] = leaveAreas[i]
		end
	end
	return self._bloodTransferPos
end

