local BuffTransform = class("BuffTransform", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local Constant = lt.Constant
local TRANSFORM_STATE = Constant.TRANSFORM_STATE
local CmdTransform = lt.CmdTransform

--[[
    变身
]]
function BuffTransform:ctor(time, actor, skilllevel, source, bufferId)   
    BuffTransform.super.ctor(self, bufferId, time, actor)

    if bufferId == BuffEnum.EFFECT_INSTALL_TURRET then
        return 
    end

    self._source = source
    yflog:Info("--------------BuffTransform--source--"..source.srcId)
 
    local heroAgent = self._actor:getAgent()
    if not heroAgent:getIsSelf() then
        local cmd = CmdTransform.new(bufferId, self._source.isExist, TRANSFORM_STATE.APPEAR , source.srcId)
        heroAgent:getCmdSystem():push(cmd)
    else
        heroAgent:changeState(lt.HeroStateTransform.new(heroAgent, bufferId, self._source.isExist, TRANSFORM_STATE.APPEAR ,source.srcId))
    end
    
    if heroAgent:isHeroAgent() then
        self._actor:setHideDarkRevengeNode(true)
    end

end

function BuffTransform:onClear()
    if self._bufferId == BuffEnum.EFFECT_INSTALL_TURRET then
        BuffTransform.super.onClear(self)
        return 
    end
    local heroAgent = self._actor:getAgent()
    if not heroAgent then
        return 
    end

    if not heroAgent:getIsSelf() then
        local cmd = CmdTransform.new(self._bufferId, false, TRANSFORM_STATE.DISAPPEAR ,self._source.srcId)
        heroAgent:getCmdSystem():push(cmd)
    else
        heroAgent:changeState(lt.HeroStateTransform.new(heroAgent, self._bufferId, false, TRANSFORM_STATE.DISAPPEAR,self._source.srcId))
    end
    if heroAgent:isHeroAgent() then
        self._actor:setHideDarkRevengeNode(false)
    end
    BuffTransform.super.onClear(self)
end

return BuffTransform
