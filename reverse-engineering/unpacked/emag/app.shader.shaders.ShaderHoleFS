return [[
#ifdef GL_ES
precision mediump float;
#endif

varying vec2 v_texCoord;
uniform sampler2D u_texture;
uniform vec2 u_holeCenter; // 挖洞中心
uniform vec2 u_holeRadius; // 挖洞半径（x: 宽度, y: 高度）
uniform vec2 u_spriteSize;
uniform float u_opatity;// 光圈以外的透明度（魔族透明度较高）

void main()
{
    vec4 color = texture2D(u_texture, v_texCoord);
    
    // 计算当前像素到挖洞中心的标准化坐标
    vec2 normalizedCoord = (v_texCoord - u_holeCenter) * u_spriteSize / min(u_spriteSize.x, u_spriteSize.y);
    
    // 使用椭圆方程判断是否在挖洞范围内
    float ellipseEquation = (normalizedCoord.x * normalizedCoord.x) / (u_holeRadius.x * u_holeRadius.x) +
                            (normalizedCoord.y * normalizedCoord.y) / (u_holeRadius.y * u_holeRadius.y);
    

    // 如果在挖洞范围内，返回透明色
    if (ellipseEquation < 1.0) {
        float opacity = smoothstep(0.0, 1.0, ellipseEquation); // 从中心到边缘透明度递增
        opacity = mix(0.0, u_opatity, opacity); // 根据最大透明度调整
        color = vec4(0.0, 0.0, 0.0, opacity);
       // discard; // 丢弃该片段     
    }else{
        color = vec4(color.rgb, color.a * u_opatity); // 根据透明度调整
    }
    
   gl_FragColor = color; // 否则显示原始颜色
}
]]

