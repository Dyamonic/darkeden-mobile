local HeroStateFly = class("HeroStateFly", lt.HeroStateBase)

local Constant = lt.Constant
local BuffEnum = lt.BuffEnum

--[[
    飞起挂起状态
]]

function HeroStateFly:ctor(heroAgent,buffId)
    HeroStateFly.super.ctor(self, heroAgent)
    
    if buffId == BuffEnum.EFFECT_CAUSE_CRITICAL_WOUNDS then
        self._heroAgent:playAction(Constant.ROLE_ACTION_IDLE)
        self._timeTriggerIdle = lt.TimeTrigger.new(1)
        self._checkBuff = BuffEnum.EFFECT_CAUSE_CRITICAL_WOUNDS_DOWN
    end

    if buffId == BuffEnum.EFFECT_EXPLOSION_WATER then
        self._heroAgent:playAction(Constant.ROLE_ACTION_FLY)
        self._timeTriggerFly = lt.TimeTrigger.new(0.5)
        self._checkBuff = BuffEnum.EFFECT_EXPLOSION_WATER_DOWN
    end
    self._buffId = buffId

    self._heroActor = self._heroAgent:getActor()
end

function HeroStateFly:onClear()
    HeroStateFly.super.onClear(self)
    
    self._checkBuff = nil
    self._buffId    = nil
    self._heroActor = nil
    self._timeTriggerFly = nil
    self._timeTriggerIdle= nil
    self._timeTriggerReverse = nil
end

function HeroStateFly:onEnter()
end

function HeroStateFly:onExit()
    self._heroActor:setActionPause(false)
end

function HeroStateFly:onUpdate()
    if self._timeTriggerIdle and self._timeTriggerIdle:tick(lt.GameBoard:getDeltaTime()) then
        self._timeTriggerIdle = nil
        self._heroAgent:playAction(Constant.ROLE_ACTION_FLY)
        self._timeTriggerFly = lt.TimeTrigger.new(0.5)
    end

    if self._timeTriggerFly and self._timeTriggerFly:tick(lt.GameBoard:getDeltaTime()) then
        self._heroActor:setActionPause(true)
        self._timeTriggerFly = nil
    end

    ------------------------------------------------------------------------------------------------
    -- 倒放
    if self._checkBuff then
        if not self._timeTriggerFly and not self._timeTriggerIdle and not self._timeTriggerReverse then
            local buff = self._heroAgent:hasBuffer(self._checkBuff)
            if not buff then
                self._timeTriggerReverse = lt.TimeTrigger.new(0.06)
            end
        end

        if self._timeTriggerReverse and self._timeTriggerReverse:tick(lt.GameBoard:getDeltaTime()) then
            if self._heroActor:getNextFrameIndex() < 1 then
                return
            end
            self._heroActor:addNextFrameIndex(-1)
            self._heroActor:updateFrame(true)
            self._timeTriggerReverse = lt.TimeTrigger.new(0.06)
        end
    end
end

function HeroStateFly:onMessage(msg)
end

function HeroStateFly:getStateId()
    return Constant.HERO_STATE_FLY
end

function HeroStateFly:getStateName()
    return "HeroStateFly"
end

return HeroStateFly