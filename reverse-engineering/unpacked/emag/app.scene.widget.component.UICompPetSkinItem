---@class UICompPetSkinItem 宠物皮肤cell
---
local UICompPetSkinItem = class("UICompPetSkinItem", lt.UICompBase)
local PetModule = lt.PetModule

function UICompPetSkinItem:ctor()
    UICompPetSkinItem.super.ctor(self)
    --UI
    self._headLoader = nil
    self._name       = nil
    self._selectImg  = nil
    self._headImg    = nil
end

function UICompPetSkinItem:onEnter()
    UICompPetSkinItem.super.onEnter(self)
end

function UICompPetSkinItem:onExit()
    UICompPetSkinItem.super.onExit(self)
end

function UICompPetSkinItem:onClear()
    UICompPetSkinItem.super.onClear(self)
    --UI
    self._headLoader = nil
    self._name       = nil
    self._selectImg  = nil
    self._headImg    = nil
end

function UICompPetSkinItem:onConstruct()
    self._headLoader = self:getChild("loader_head")
    self._selectImg  = self:getChild("img_select")
    self._name       = self:getChild("label_name")
    self._useImg     = self:getChild("use")
    self._lvl        = self:getChild("label_lvl")
    self._reddot     = self:getChild("reddot")
end

function UICompPetSkinItem:setInfo(petSkinInfo,uid)
    if not petSkinInfo then
        return
    end
    self._headLoader:setURL(string.format(_GURL.GetImagePet, "petface_" .. petSkinInfo:getPhoto()))
    self._name:setText(petSkinInfo:getName())

    local selectVisible = false
    local skinData = PetModule:getSkinDataById(petSkinInfo:getId())
    if not skinData then
        self._headLoader:setGrayed(true)
        self._lvl:setText("")
    else
        self._headLoader:setGrayed(false)
        self._lvl:setText("Lv." .. skinData:getLevel())
    end

    if skinData and skinData:getPetUid() == uid then
        selectVisible = true
    end

    self._useImg:setVisible(selectVisible)

    if not uid then
        local skinId = petSkinInfo:getId()
        local isRed = PetModule:checkPetUp(skinId) or false
        self._reddot:setVisible(isRed)
    else
        self._reddot:setVisible(false)
    end
end

function UICompPetSkinItem:setSelect(select)
    self._selectImg:setVisible(select)
end

return UICompPetSkinItem