---ui类宠物/怪物
local PetUIActor = class("PetUIActor",lt.ActionBaseActor)

local Constant = lt.Constant
local ActionManager = lt.ActionManager
-- local TimeTrigger = lt.TimeTrigger
local CacheManager = lt.CacheManager
local offsetX, offsetY = -25, 15
function PetUIActor:ctor(scale)
    PetUIActor.super.ctor(self)
    scale = scale or 1
    self._petNode = display.newNode()
    self:addChild(self._petNode, 1)
    self._petNode:setScale(scale)
    self._petNode:setPosition(offsetX*scale, offsetY*scale)

    self._spriteHero = display.newSprite()
    self._petNode:addChild(self._spriteHero)
end

--宠物模型
function PetUIActor:initActionInfo()
    local modelId = self._actionId
    self._actionInfo = ActionManager:getActionMonsterInfo("monster", modelId, 0, self._direction or Constant.DIRECTION_DOWN)
end

function PetUIActor:onClear()
    PetUIActor.super.onClear(self)
    self._petNode = nil
    self._spriteHero = nil
    self._actionInfo = nil
end

function PetUIActor:onUpdate()
    self:onUpdateAction()
end

function PetUIActor:updateFrame()
    if not self._actionInfo then
        return
    end
    if not self._hideSprite then
        self._spriteHero:setVisible(true)
        local frameCount = self._actionInfo:getSpriteFrameCount()
        local frame = self._actionInfo:getSpriteFrame(self._nextFrameIndex)
        if frame then
            self._spriteHero:setSpriteFrame(frame.sprite)
            local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
            self._spriteHero:setPosition(pos)
        end
        if self._nextFrameIndex >= frameCount then
            self._nextFrameIndex = 1
        else
            self._nextFrameIndex = self._nextFrameIndex + 1
        end
    else
        self._spriteHero:setVisible(false)
    end
end

return PetUIActor
