-- 坐骑
local MountMeta = class("MountMeta")

function MountMeta:ctor(row)
    self:initWithRow(row)
end

function MountMeta:initWithRow(row)
    self._Id      = row.Id
    self._name    = row.Name
    self._type    = row.Type
    self._model   = row.Model
    self._icon    = row.Icon
    self._quality = row.Quality
    self._level   = row.Level
    self._race    = row.Race
    if row.Attr == "" then
        self._attr = nil
    else
        self._attr = json.decode(row.Attr)
    end
    if row.Cost == "" then
        self._cost = nil
    else
        self._cost = json.decode(row.Cost)
    end
end

function MountMeta:getId() return self._Id end

function MountMeta:getName() return self._name end

function MountMeta:getType() return self._type end

function MountMeta:getModel() return self._model end

function MountMeta:getIcon() return self._icon end

function MountMeta:getQuality() return self._quality end

function MountMeta:getLevel() return self._level end

function MountMeta:getRace() return self._race end

function MountMeta:getAttr() return self._attr end

function MountMeta:getCost() return self._cost end

return MountMeta
