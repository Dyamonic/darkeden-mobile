local UIHeroActor = class("UIHeroActor", lt.RoleActor)

local HeroSlayerActor   = lt.HeroSlayerActor
local Constant          = lt.Constant
local RaceType          = Constant.RaceType
local RoleColor         = lt.RoleColor
local ShaderBackendUtil = lt.ShaderBackendUtil
local ActionManager     = lt.ActionManager
local ResUtil = lt.ResUtil
local SlayerPos = Constant.SlayerPos

UIHeroActor._hair        = nil
UIHeroActor._hairColor   = nil
UIHeroActor._skinColor   = nil
UIHeroActor._clothColor  = nil
UIHeroActor._weaponId    = nil
UIHeroActor._actionInfo       = nil
UIHeroActor._shadowActor      = nil
UIHeroActor._actionWeaponInfo = nil
UIHeroActor._actionShieldInfo = nil
UIHeroActor._spriteHero   = nil
UIHeroActor._spriteShadow = nil
UIHeroActor._spriteWeapon = nil
UIHeroActor._spriteShield = nil
UIHeroActor._actionPause = nil

function UIHeroActor:ctor(roleData, direction)
    UIHeroActor.super.ctor(self, roleData, direction)

    local isSlayer = roleData:isSlayer()

    self._weaponSkillColor = nil

    if isSlayer then
        self._helmetName, self._modelName, self._pantsName, self._hairName = roleData:getModelName()
        self._helmetShadowName, self._modelShadowName, self._pantsShadowName, self._hairShadowName = roleData:getModelShadowName()
    else
        self._modelName = roleData:getModelName()
        self._modelShadowName = roleData:getModelShadowName()
    end
    self._weaponModelName = roleData:getWeaponModelName()
    self._weaponModelShadowName = roleData:getWeaponModelShadowName()
    self._shieldModelName = roleData:getShieldModelName()
    self._shieldModelShadowName = roleData:getShieldModelShadowName()

    self._hair        = roleData:getHair()
    self._hairColor   = roleData:getHairColor()
    self._skinColor   = roleData:getSkinColor()
    self._clothColor  = roleData:getClothColor()
    self._raceType    = roleData:getRace()
    self._weaponId    = roleData:getWeapon()


    local ANCHOR_MIDDLE = self.ANCHOR_MIDDLE
    local offsetX, offsetY = -25, 15
    local zorder = 2
    -- 人物模型
    self._heroNode = display.newNode()
    self._heroNode:setPosition(offsetX, offsetY)
    self:addChild(self._heroNode, zorder)

    zorder = zorder + 1

    -- Slayer 人族 Helmet 头盔  pants 裤子
    if isSlayer then
        -- 裤子
        self._heroSlayerActor = HeroSlayerActor.new(roleData, self._heroNode, zorder)
        self._heroNode:addChild(self._heroSlayerActor, zorder)

        zorder = zorder + 1
    end

    self._spriteHero = self:CreateSprite(ANCHOR_MIDDLE, ANCHOR_MIDDLE, zorder, self._heroNode)

    -- 3
    zorder = zorder + 1
    self._spriteWeapon = self:CreateSprite(ANCHOR_MIDDLE, ANCHOR_MIDDLE, zorder, self._heroNode)
    self._spriteShield = self:CreateSprite(ANCHOR_MIDDLE, ANCHOR_MIDDLE, zorder, self._heroNode)
    self._weaponZorder = zorder -- 记录武器层级

    -- 设置层级
    self:updateFrameZOrder()

    self._actionPause = false
    
    self:shaderInit()
end

function UIHeroActor:onClear()
    self:stopAllActions()
    
    if self._heroSlayerActor then
        self._heroSlayerActor:onClear()
        self._heroSlayerActor = nil
    end
    
    self:removeAllChildren()

    self._spriteHero        = nil
    self._spriteWeapon      = nil
    self._spriteShield      = nil

    self._actionInfo        = nil
    self._actionWeaponInfo  = nil
    self._actionShieldInfo  = nil
    

    self._hair              = nil
    self._hairColor         = nil
    self._weaponId          = nil


    self._skillColor = nil
    
    
    -- 先移除继承添加的 在调用超类清楚
    UIHeroActor.super.onClear(self)
end

function UIHeroActor:onUpdate(delta)
    UIHeroActor.super.onUpdate(self)
end

-- override
function UIHeroActor:initActionInfo()
    self:initActionInfoHero()
end

function UIHeroActor:initExtraActionInfo()
    self:initActionInfoHair()
    self:initActionInfoWeapon()
    self:initActionInfoShield()
end

-- override
function UIHeroActor:gotoNextFrame()
    -- UIHeroActor.super.gotoNextFrame(self)
    if self._actionPause and self._initFrame then
        return
    end

    self:updateFrame(true)

    self._nextFrameIndex = self._nextFrameIndex + 1
end

function UIHeroActor:updateFrame(update)
    if not self._actionInfo then
        return
    end

    -- hero action
    if not self._hideSprite then
        self._spriteHero:setVisible(true)

        if update then
            local frame = self._actionInfo:getSpriteFrame(self._nextFrameIndex)
            if frame then
                self._initFrame = true
                local sprite = frame.sprite
                -- print("self._spriteHero:setSpriteFrame",frame.path)
                self._spriteHero:setSpriteFrame(sprite)
                if self._selectColor then
                    self._pixelSize = ResUtil:getPlistPixelSize(sprite)
                end
                local texture = self._spriteHero:getTexture()
                texture:setAliasTexParameters()

                -- 偏移值坐标
                local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
                self._spriteHero:setPosition(pos)

                if self._heroSlayerActor then
                    self._heroSlayerActor:onUpdateFrame(self._nextFrameIndex)
                end
            end
        end
    else
        self._spriteHero:setVisible(false)
        if self._heroSlayerActor then
            self._heroSlayerActor:hideNode()
        end
    end

    -- weapon action
    self:updateWeaponFrame(update)

    -- shield action
    self:updateShieldFrame(update)
end

-- weapon action
function UIHeroActor:updateWeaponFrame(update)
    if self._weaponId ~= 0 and self._actionWeaponInfo and (not self._hideSprite) then
        self._spriteWeapon:setVisible(true)
    
        if update and self._actionWeaponInfo then
            local frame = self._actionWeaponInfo:getSpriteFrame(self._nextFrameIndex)
            if frame then                
                -- frame.path frame.sprite
                local sprite = frame.sprite

                self._spriteWeapon:setSpriteFrame(sprite)
                self._weaponPixelSize = ResUtil:getPlistPixelSize(sprite)
                local texture = self._spriteWeapon:getTexture()
                texture:setAliasTexParameters()

                local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
                self._spriteWeapon:setPosition(pos)
            end
        end
    else
        self._spriteWeapon:setVisible(false)
    end
end

-- shield action
function UIHeroActor:updateShieldFrame(update)
    if  self._shieldId ~= 0 and (not self._hideSprite) then 
        self._spriteShield:setVisible(true)
        if update then
            local frame = self._actionShieldInfo:getSpriteFrame(self._nextFrameIndex)
            if frame then
                local sprite = frame.sprite
                self._spriteShield:setSpriteFrame(sprite)
                self._shieldPixelSize = ResUtil:getPlistPixelSize(sprite)

                local texture = self._spriteShield:getTexture()
                texture:setAliasTexParameters()

                local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
                self._spriteShield:setPosition(pos)
            end
        end
    else
        self._spriteShield:setVisible(false)
    end
end


-- override
function UIHeroActor:_setDirection(direction)
    UIHeroActor.super._setDirection(self, direction)

    -- 设置层级
    self:updateFrameZOrder()
end

-- 设置层级
function UIHeroActor:updateFrameZOrder()
    ----------------------------------------------------------------------------------
    -- 非盾牌武器层级设置
    if self._roleData:isOusters() then
        -- 魔族层级限制
        self._spriteWeapon:setLocalZOrder(self._weaponZorder)
    else
        -- 非魔族层级限制
        if self._direction == Constant.DIRECTION_UP or
        self._direction == Constant.DIRECTION_LEFT_UP or
        self._direction == Constant.DIRECTION_LEFT or
        self._direction == Constant.DIRECTION_LEFT_DOWN then
            local  weaponZOrdr = 0
            if self._direction == Constant.DIRECTION_UP then
                weaponZOrdr = self._weaponZorder
            else
                weaponZOrdr = 1
            end
            self._spriteWeapon:setLocalZOrder(weaponZOrdr)
        else
            self._spriteWeapon:setLocalZOrder(self._weaponZorder)
        end
    end

    ----------------------------------------------------------------------------------
    -- 盾牌武器层级设置
    if self._direction == Constant.DIRECTION_DOWN or
       self._direction == Constant.DIRECTION_LEFT_DOWN or
       self._direction == Constant.DIRECTION_LEFT or
       self._direction == Constant.DIRECTION_LEFT_UP or
       self._direction == Constant.DIRECTION_UP then
        self._spriteShield:setLocalZOrder(self._weaponZorder)
    else
        self._spriteShield:setLocalZOrder(1)
    end
end

function UIHeroActor:changeHair(hair)
    self._hair = hair
    self:initActionInfoHair()
end

function UIHeroActor:changeHairColor(hairColor)
    self._hairColor = hairColor
    self:changeModelColor(self._spriteHero)
end

-- 皮肤变色
function UIHeroActor:changeSkinColor(skinColor)
    self._skinColor = skinColor
    self:changeModelColor(self._spriteHero)
end

function UIHeroActor:changeWeapon(weaponId)
    self._weaponId = weaponId
    self._weaponModelName = self._roleData:getWeaponModelName()
    self._weaponModelShadowName = self._roleData:getWeaponModelShadowName()

    self:initActionInfoWeapon()
end

function UIHeroActor:changeShield(shieldId)
    self._shieldId = shieldId
    self._shieldModelName = self._roleData:getShieldModelName()
    self._shieldModelShadowName = self._roleData:getShieldModelShadowName()

    self:initActionInfoShield()
end

function UIHeroActor:refreshHelmetBodyPants()
    self._roleData:clearModelName()
    local isSlayer = self._roleData:isSlayer()
    if isSlayer then
        self._helmetName, self._modelName, self._pantsName, self._hairName = self._roleData:getModelName()
        self._helmetShadowName, self._modelShadowName, self._pantsShadowName, self._hairShadowName = self._roleData:getModelShadowName()
    else
        self._modelName = self._roleData:getModelName()
        self._modelShadowName = self._roleData:getModelShadowName()
    end
    
    -- 人族需改变头发数据
    if self._heroSlayerActor then
        self._heroSlayerActor:changeHelmetName(self._helmetName)
        self._heroSlayerActor:changePantsName(self._pantsName)
        self._heroSlayerActor:changeHairName(self._hairName)
    end

    self:initActionInfoHero()
end

function UIHeroActor:changeFaceShape()
    self:refreshHelmetBodyPants()
end

function UIHeroActor:changeSex()
    self:refreshHelmetBodyPants()
end

function UIHeroActor:changeBodyAppr()
    self:refreshHelmetBodyPants()
end

function UIHeroActor:changeHelmet()
    self:refreshHelmetBodyPants()
end

function UIHeroActor:changeTrousers()
    self:refreshHelmetBodyPants()
end

function UIHeroActor:initActionInfoHair()

end

function UIHeroActor:initActionInfoHero()
    local modelName = self._modelName
    local actionId = self._actionId
    local direction = self._direction

    self._actionInfo = ActionManager:getAcitonHeroInfo(modelName, actionId, direction)
    if self._heroSlayerActor then
        self._heroSlayerActor:LoadHeroActionInfo(actionId, direction)
    end
end

-- 有武器普攻和没武器普攻动作不同 FIXME
function UIHeroActor:initActionInfoWeapon()
    self._weaponId = self._roleData:getWeapon()

    -- 鬼族转职前不显示装备,暂时去除鬼族武器
    if self._roleData:isVampire() then
        self._actionWeaponInfo = nil
        return
    end

    -- 魔族护腕 == 没带装备
    if self._roleData:isOusters() and self._roleData:isWristGuard() then
        self._actionWeaponInfo = nil
        return
    end

    local weaponModelLv = self._roleData:getWeaponModelLevel()
    if weaponModelLv == 0 then
        self._actionWeaponInfo = nil
        return
    end

    local action = self._actionId

    self._actionWeaponInfo = ActionManager:getActionWeaponInfo(self._weaponModelName, action, self._direction, false)
end

function UIHeroActor:initActionInfoShield()
    self._shieldId = self._roleData:getShield()
     if self._shieldId ~= 0 then
        self._actionShieldInfo = ActionManager:getActionShieldInfo(self._shieldModelName, self._actionId, self._direction)
    else
        self._actionShieldInfo = nil
    end
end

function UIHeroActor:playAction(actionId)
    UIHeroActor.super.playAction(self, actionId)
    if self._preActionId == actionId then
        return
    end

    self._preActionId = actionId
end

-- 修改模型颜色
function UIHeroActor:changeModelColor(node, params, isClone)
    params = params or {}
    local destHairColor = RoleColor:getHairColorById(self._hairColor, true)
    local destSkinColor = RoleColor:getSkinColorById(self._skinColor, true)

    local darkFactor = self._darkFactor
    local skillColor = self._skillColor
    if isClone then
        skillColor = nil
    end

    local helmet, hair, pants
    local uvPixel = {}
    if self._heroSlayerActor then
        helmet, pants, hair = self._heroSlayerActor:getOtherNode()
        uvPixel = self._heroSlayerActor:getPixelSlayerInfo()
        
    end
    local _,helmetColor, helmetLevel = self._roleData:getHelmet()
    local _,pantsColor, pantsLevel = self._roleData:getTrousers()
    local _,shieldColor, shieldLevel = self._roleData:getShield()
    local _,bodyColor, bodyLevel = self._roleData:getBodyAppr()
    local _,weaponColor, weaponLevel =self._roleData:getWeapon()

    local nodes = {
        [RaceType.Slayer] = {
            [1] = {node = node, colorB = destSkinColor, colorG32B = bodyColor, powerG32B = bodyLevel}, -- 上身
            [2] = {node = helmet, colorB = helmetColor, powerB = helmetLevel, pixelSize = uvPixel[SlayerPos.HelMet]}, -- 头盔
            [3] = {node = pants, colorB = destSkinColor, colorG32B = pantsColor, powerG32B = pantsLevel, pixelSize = uvPixel[SlayerPos.Pants]}, -- 裤子
            [4] = {node = self._spriteShield, colorB = shieldColor, powerB = shieldLevel,pixelSize = self._shieldPixelSize}, --盾牌
            [5] = {node = hair, colorB = destHairColor, colorOffset = Constant.GL_COLOR_OFFSET.ZERO, pixelSize = uvPixel[SlayerPos.Hair]},-- 头发
        },
        [RaceType.Vampire] = {
            [1] = {node = node, colorB = destSkinColor, colorG32B = bodyColor,  powerG32B = bodyLevel },
        },
        [RaceType.Ousters] = {
            [1] = {node = node, colorB = destHairColor, colorG32B = bodyColor, powerG32B = bodyLevel, colorOffset = Constant.GL_COLOR_OFFSET.BIT16,colorG96B = pantsColor, powerG96B = pantsLevel}, --魔族靴子=人族裤子
        }
    }

    for _,nodeInfo in ipairs(nodes[self._raceType] or {}) do
        local param = {
            node = nodeInfo.node,
            colorB = nodeInfo.colorB,
            colorG32B = nodeInfo.colorG32B,
            colorG64B = nodeInfo.colorG64B,
            colorG96B = nodeInfo.colorG96B,
            darkFactor = darkFactor,
            colorOffset = params.colorOffset,
            skillColor = skillColor,
            powerB = nodeInfo.powerB,
            powerG32B = nodeInfo.powerG32B,
            powerG64B = nodeInfo.powerG64B,
            powerG96B = nodeInfo.powerG96B,
            pixelSize = nodeInfo.pixelSize or self._pixelSize,
            selectColor = self._selectColor
        }
        
        ShaderBackendUtil:makeMulModelEffect(nodeInfo.node, param)
    end

    ShaderBackendUtil:makeWeaponEffect(self._spriteWeapon, {targetColor = weaponColor, powerB = weaponLevel, pixelSize = self._weaponPixelSize, skillColor = self._weaponSkillColor, selectColor = self._selectColor})
end

function UIHeroActor:shaderInit()
    self:updateCreature()
end

--- 更新外显
function UIHeroActor:updateCreature(param)
    local isStriking = false
    if param and param.isStriking then
        isStriking = param.isStriking
    end

    local isRediance = false
    if param and param.isRediance then
        isRediance = param.isRediance
    end

    local _,weaponColor, weaponLevel =self._roleData:getWeapon()

    if weaponColor then
        ShaderBackendUtil:makeWeaponEffect(self._spriteWeapon, {targetColor = weaponColor,isStriking = isStriking, isRediance = isRediance, powerB = weaponLevel, black = self._darkFactor})
    end
    self:changeModelColor(self._spriteHero)
end

function UIHeroActor:playActionUI(action,stepTime)
    self:playUIAction(action)
    self:stopAllActions()
    local actionInfo = self._actionInfo
    if not actionInfo then
        return
    end
    local time = stepTime or actionInfo:getStep()
    self:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(time), cc.CallFunc:create(function()
        self:gotoNextFrame()
        if self._nextFrameIndex > actionInfo:getSpriteFrameCount() then
            self._nextFrameIndex = 1
        end
        
        -- yflog:Info("self._nextFrameIndex %s %s",self._nextFrameIndex , actionInfo:getSpriteFrameCount())
    end))))
end

return UIHeroActor