
local RoleScene = class("RoleScene", lt.BaseScene)

RoleScene._roleLayer = nil

function RoleScene:ctor()
    RoleScene.super.ctor(self)
end

function RoleScene:registerFont()
    fgui.UIConfig:registerFont("fangzheng", "font/fangzheng.ttf");
    fgui.UIConfig.defaultFont = "fangzheng"
    fgui.UIConfig.buttonSound = "ui://CommonTL/SLAYER_BUTTON"
end

function RoleScene:onClear()
    yflog:Info("RoleScene:onClear")
    self._roleLayer = nil
    self._msgbox = nil
    self._noticeLayer = nil
    -- fgui.unregisterComponent("ui://MessageBox/MessageBox")
    -- fgui.unregisterComponent("ui://MessageBox/MessageBoxRemove")
    -- fgui.unregisterComponent("ui://MessageBox/MessageBoxSmall")
    self:unregisterAllComponent()
    fgui.UIPackage:removePackage("fairygui/CreateRole")
    fgui.UIPackage:removePackage("fairygui/CommonTL")
    fgui.UIPackage:removePackage("fairygui/MessageBox")
    RoleScene.super.onClear(self)

    collectgarbage("collect")
end

function RoleScene:onEnter()
    yflog:Info("RoleScene:onEnter")
    fgui.UIPackage:addPackage("fairygui/CreateRole")
    fgui.UIPackage:addPackage("fairygui/CommonTL")
    fgui.UIPackage:addPackage("fairygui/MessageBox")
    self:registerFont()
    
    -- self._roleLayer:setPivot(0.5,0.5, true)
    -- self._roleLayer:setPosition(display.cx, display.cy)

    self._roleLayer = lt.RoleLayerTL.new()
    self._groot:addChild(self._roleLayer)

    --msgBox
    -- fgui.registerComponent("ui://MessageBox/MessageBox", lt.UICompMessageBox)
    -- fgui.registerComponent("ui://MessageBox/MessageBoxRemove", lt.UICompMessageBoxRemove)
    -- fgui.registerComponent("ui://MessageBox/MessageBoxSmall", lt.UICompMessageBoxSmall)

    self:registerComponent("UICompMessageBox","UICompMessageBoxRemove","UICompMessageBoxSmall")

    self._msgbox = lt.MsgboxRoleLayer.new()
    self._groot:addChild(self._msgbox)
    self._msgbox:setSortingOrder(99)
    
    --tips
    self._noticeLayer = lt.TipRoleLayer.new()
    self._groot:addChild(self._noticeLayer)
    self._noticeLayer:setSortingOrder(100)
end

function RoleScene:onExit()
    yflog:Info("RoleScene:onExit")
end

return RoleScene
