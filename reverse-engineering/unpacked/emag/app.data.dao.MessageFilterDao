local MessageFilterDao = {}

function MessageFilterDao:queryAll()
    local msgMessageFilter = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM MessageFilter") do
        local meta = lt.MessageFilterMeta.new(row)
        msgMessageFilter[meta:getIdxId()] = meta
    end
    return msgMessageFilter
end

return MessageFilterDao
