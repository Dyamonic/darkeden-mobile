---@class UIWndTransactionUpTips:UIWindowBase
---交易行 竞价/上架 tips
local UIWndTransactionUpTips = class("UIWndTransactionUpTips", lt.UIWindowBase)

local Constant               = lt.Constant
local CacheManager           = lt.CacheManager
local NtfManager             = lt.NtfManager
local TransactionModule      = lt.TransactionModule
local ItemModule             = lt.ItemModule
local RechargeModule         = lt.RechargeModule 


UIWndTransactionUpTips.ChangeSkinConf = {
    ["Transaction"] = {
        ["bg"] = "bg_pmh_cztc",
        ["bg_right"] = "bg_pmh_cztc",
        ["btn_sub"] = { icon = "btn_pmh_jianhao" },
        ["btn_add"] = { icon = "btn_pmh_jiahao" },
        ["btn_sub1"] = { icon = "btn_pmh_jianhao" },
        ["btn_add1"] = { icon = "btn_pmh_jiahao" },
        ["btn_max"] = { icon = "btn_pmh_max" },
    },
    ["CommonTL"] = {
        ["frame"] = {
            closeButton = {bg  = "bg_beibao_anniu01", bgup  = "bg_beibao_anniu02"},
        },
        ["btn_up"] = { bg = "bg_beibao_ren_anniu" },
    }
}


function UIWndTransactionUpTips:ctor(param)
    self:registerComponent("UICompTransactionCompareCell")
    UIWndTransactionUpTips.super.ctor(self, param)
end

function UIWndTransactionUpTips:onClear()
    self._lblTime = nil
    self._lblCount = nil
    self._lblCost = nil
    self._iconItem = nil
    self._rareImg = nil
    self._lblName = nil
    self._btnUp = nil
    self._btnSub = nil
    self._btnAdd = nil
    self._controlType = nil
    self._compareList = nil
    self._lblNum = nil
    self._btnNumSub = nil
    self._btnNumAdd = nil
    self._btnNumMax = nil
    if self._numInput then
        self._numInput:removeEditHandler()
        self._numInput:removeSelf()
        self._numInput = nil
    end
    self._meta = nil
    self._max = nil
    self._num = nil
    self._lowPrice = nil
    self._maxPrice = nil
    self._price = nil
    self._lblNotice = nil
    self._sprite = nil
    self:unregisterAllComponent()
    UIWndTransactionUpTips.super.onClear(self)
end

function UIWndTransactionUpTips:onShown()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_TRANSACTION_DETAIL_LIST_CHANGE, handler(self, self.onDetailListChange),
        "UIWndTransactionUpTips:onDetailListChange")
    self._btnUp:addClickListener(handler(self, self.openUpBtnClick))
    self._btnSub:addClickListener(handler(self, self.openSubBtnClick))
    self._btnAdd:addClickListener(handler(self, self.openAddBtnClick))
    self._btnNumSub:addClickListener(handler(self, self.openSubNumBtnClick))
    self._btnNumAdd:addClickListener(handler(self, self.openAddNumBtnClick))
    self._btnNumMax:addClickListener(handler(self, self.openMaxNumBtnClick))
    self._iconItem:addClickListener(handler(self, self.onShowTipClick))

    self:refreshView()
end

function UIWndTransactionUpTips:onHide()
    self._btnUp:removeClickListener()
    self._btnSub:removeClickListener()
    self._btnAdd:removeClickListener()
    self._btnNumSub:removeClickListener()
    self._btnNumAdd:removeClickListener()
    self._btnNumMax:removeClickListener()
    self._compareList:removeItemRenderer()
    self._iconItem:removeClickListener()
    NtfManager:removeNtfListenerByTag("UIWndTransactionUpTips:onDetailListChange")
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_TRANSACTION_CHOOSE)
    UIWndTransactionUpTips.super.onHide(self)
end

function UIWndTransactionUpTips:onInit()
    UIWndTransactionUpTips.super.onInit(self, _GURL.WndTransactionUpTips)

    self._lblTime = self:getChild("lbl_time")
    self._lblCount = self:getChild("lbl_count")
    self._lblCount:setVisible(false)
    self._lblCost     = self:getChild("lbl_cost")
    self._iconItem    = self:getChild("icon_item")
    self._rareImg     = self:getChild("img_rare")
    self._lblName     = self:getChild("lbl_itemName")
    self._btnUp       = self:getChild("btn_up")
    self._btnSub      = self:getChild("btn_sub")
    self._btnAdd      = self:getChild("btn_add")
    self._controlType = self:getController("c1")
    self._compareList = self:getChild("list_compare")
    self._compareList:setItemRenderer(handler(self, self.itemRender))

    --普通上架
    self._lblNum    = self:getChild("lbl_num")
    self._btnNumSub = self:getChild("btn_sub1")
    self._btnNumAdd = self:getChild("btn_add1")
    self._btnNumMax = self:getChild("btn_max")
    self._lblNotice = self:getChild("lbl_Notice")

    self:initCocosInputUI()
end

function UIWndTransactionUpTips:refreshView()
    local param = self:getParam() or {}
    local itemInfo = param.itemInfo
    local sid = itemInfo:getItemId()
    local itemType = itemInfo:getItemType()
    local meta = TransactionModule:getTransactionDataByItemIdAndType(sid, itemType)
    self._meta = meta
    local itemMeta = nil
    local itemType = itemInfo:getItemType()

    if self._sprite then
        self._sprite:removeFromParent()
        self._sprite = nil
    end

    if itemType == Constant.ItemType.ITEM_TYPE_PROP then
        itemMeta = CacheManager:getItemMeta(sid)
        self._iconItem:setURL(string.format("ui://Item/prop_%s", itemMeta and itemMeta:getIconId() or ""))
        self._iconItem:setAlpha(1)
    elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
        itemMeta = CacheManager:queryEquipMeta(sid)
        self._iconItem:setURL(string.format("ui://Item/equip_%s", itemMeta and itemMeta:getIconId() or ""))
        self._iconItem:setAlpha(0)

        local iconId = itemMeta:getIconId()
        if iconId then
            local affixId = itemInfo:getFirstAffixId() or 0
            local affixLevel = itemInfo:getFirstAffixLevel() or 0
            local sprite = lt.CommonFunc.createEquipById(iconId,affixId,affixLevel)
            self:displayObject():addChild(sprite)
            local pos = self._iconItem:getPosition()
            sprite:setPosition(pos.x,424-pos.y)
            self._sprite = sprite
        end
    end
    self._lblName:setText(itemMeta and itemMeta:getName() or "")

    self._iconItem.itemMeta = itemInfo
    --缩放尺寸
    local itemSize = self._iconItem:getSize()
    local heightS = 50 / itemSize.height
    local widthS = 50 / itemSize.width
    local scale = heightS
    if widthS < heightS then
        scale = widthS
    end
    self._iconItem:setScale(scale, scale)
    if self._sprite then
        self._sprite:setScale(scale)
    end

    --公示时间
    local announce = meta:getAnnounce()
    self._controlType:setSelectedIndex(announce == 0 and 1 or 0)
    self._lblTime:setVisible(announce == 1)
    local tradingTime = CacheManager:getVariableById(Constant.Variable.TradingTime)
    self._lblTime:setText(tradingTime .. GReadText.KEY_EQUIP_TIPS42)

    self._price = meta:getDefaultPrice()[3]
    self._costPrice = meta:getCostPrice()[3]
    if announce == 0 then
        --普通上架
        self._max = itemInfo:getNum() or 1
        self._num = self._max
        self:refreshSellNum()
        self._lowPrice = math.floor(meta:getInterval()[2] * 0.01 * self._price)
        self._maxPrice = math.floor(meta:getInterval()[3] * 0.01 * self._price)
    else
        --公示上架
        self._num = 1
        self._lowPrice = self._price
        local tradingUpper = CacheManager:getVariableById(Constant.Variable.TradingUpper) or
        TransactionModule.MAXSELLPRICE
        self._maxPrice = tonumber(tradingUpper)
        self._lblCost:setText(self._costPrice)

        local enoughMoney = ItemModule:enoughItem(self._meta:getCostPrice()[1], self._meta:getCostPrice()[2],
            self._costPrice * self._num)
        self._lblCost:setColor(enoughMoney and Constant.COLOR_TEXT_WHITE_PURE or Constant.COLOR_TEXT_RED)
    end
    self._rareImg:setVisible(announce == 1)
    self:refreshSellPrice()

    --请求数据(参考价格)
    if announce == 0 then
        local list = {}
        local id = meta:getId()
        table.insert(list, tostring(id))
        TransactionModule:sendTransactionSimpleListReq(list, 1)
    end
end

function UIWndTransactionUpTips:initCocosInputUI()
    if not self._numInput then
        self._numInput = ccui.EditBox:create(cc.size(80, 29), "", ccui.TextureResType.localType)
        self._numInput:setAnchorPoint(cc.p(0, 0))
        self._numInput:setFontName(lt.Constant.FONT_4)
        self._numInput:setFontSize(20)
        self._numInput:setReturnType(cc.KEYBOARD_RETURNTYPE_SEND)
        self._numInput:setInputMode(cc.EDITBOX_INPUT_MODE_SINGLELINE)
        self._numInput:registerScriptEditBoxHandler(handler(self, self.editBoxEvent))
        self._numInput:setPosition(cc.p(64, 1))
        self:getChild("n12"):displayObject():addChild(self._numInput)
    end
end

-- 上架
function UIWndTransactionUpTips:openUpBtnClick()
    local isMonthCard = RechargeModule:checkMonthCard(true)
    if not isMonthCard then
        return
    end
    local list = TransactionModule:getTransactionSellList()
    local max = CacheManager:getVariableById(Constant.Variable.Number) + lt.VipModule:getVipPosition()
    if #list >= max then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = "没有交易栏位" })
        return
    end
    local enoughMoney = ItemModule:enoughItem(self._meta:getCostPrice()[1], self._meta:getCostPrice()[2],
        self._costPrice * self._num, { tips = true })
    if enoughMoney then
        local param = self:getParam() or {}
        local itemInfo = param.itemInfo
        TransactionModule:sendPutOnSaleReq(itemInfo:getItemUid(), self._price, self._num)
        self:hideSelectView()
    end
end

function UIWndTransactionUpTips:openAddBtnClick()
    local defaultPrice = self._meta:getDefaultPrice()[3]
    self._price = math.floor(self._price + 0.1 * defaultPrice)
    if self._price > self._maxPrice then
        self._price = self._maxPrice
    end
    self:refreshSellPrice()
end

function UIWndTransactionUpTips:openSubBtnClick()
    local defaultPrice = self._meta:getDefaultPrice()[3]
    self._price = math.floor(self._price - 0.1 * defaultPrice)
    if self._price < self._lowPrice then
        self._price = self._lowPrice
    end
    self:refreshSellPrice()
end

function UIWndTransactionUpTips:editBoxEvent(eventType, sender)
    if eventType == "began" then
    elseif eventType == "ended" then
        --过滤无效字符
        self._price = tonumber(sender:getText())
        if self._price == nil then
            self._price = self._lowPrice
        else
            --判断上下限
            if self._price <= self._lowPrice then
                self._price = self._lowPrice
            elseif self._price > self._maxPrice then
                self._price = self._maxPrice
            end
        end
        sender:setText("")
        --刷新界面
        self:refreshSellPrice()
    elseif eventType == "changed" then
        local str = sender:getText()
        str = string.gsub(str, "[^0-9]", "")
        sender:setText(str)
    elseif eventType == "return" then
    end
end

function UIWndTransactionUpTips:openAddNumBtnClick()
    if self._num >= self._max then
        return
    end
    self._num = self._num + 1
    self:refreshSellNum()
end

function UIWndTransactionUpTips:openSubNumBtnClick()
    if self._num <= 1 then
        return
    end
    self._num = self._num - 1
    self:refreshSellNum()
end

function UIWndTransactionUpTips:openMaxNumBtnClick()
    self._num = self._max
    self:refreshSellNum()
end

function UIWndTransactionUpTips:hideSelectView()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndTransactionUpTips", close = true })
end

function UIWndTransactionUpTips:refreshSellNum()
    self._lblNum:setText(self._num)
    self._lblCost:setText(self._num * self._costPrice)

    local enoughMoney = ItemModule:enoughItem(self._meta:getCostPrice()[1], self._meta:getCostPrice()[2],
        self._costPrice * self._num)
    self._lblCost:setColor(enoughMoney and Constant.COLOR_TEXT_WHITE_PURE or Constant.COLOR_TEXT_RED)
end

function UIWndTransactionUpTips:refreshSellPrice()
    self._numInput:setText(self._price)
end

function UIWndTransactionUpTips:onDetailListChange(event)
    local showlist = {}
    local list = TransactionModule:getOriginDetailList()
    table.sort(list, function(a, b)
        return a.sellPrice < b.sellPrice
    end)
    for i = 1, #list do
        if #showlist >= 10 then break end
        table.insert(showlist, list[i])
    end
    self._compareList:setNumItems(#showlist)
    self._lblNotice:setVisible(#showlist == 0)
end

function UIWndTransactionUpTips:itemRender(index, obj)
    local list = TransactionModule:getOriginDetailList()
    obj:setObjInfo(list[index + 1])
    obj.index = index + 1
end

function UIWndTransactionUpTips:onShowTipClick(target)
    local itemMeta = target:getSender().itemMeta
    if itemMeta then
        ItemModule:showTipsByType(itemMeta)
    end
end

return UIWndTransactionUpTips
