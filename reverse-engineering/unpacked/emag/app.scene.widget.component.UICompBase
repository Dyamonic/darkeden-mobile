
local UICompBase = class("UICompBase", function()
    return fgui.GComponent:create()
end,lt.UICompChangeSkin)

UICompBase._param         = nil

function UICompBase:ctor(param)
    if param then
        self:setParam(param)
    end
    self:enableComponentEvents()
end

function UICompBase:onConstruct()
end

function UICompBase:setParam(param)
    self._param = param
end

function UICompBase:getParam()
    return self._param
end

function UICompBase:setRegClass(node)
    self._regClass = node
end

function UICompBase:getRegClass()
    return self._regClass
end

function UICompBase:onEnter()
    if DEBUG > 0 then 
        yflog:Info("UICompBase:onEnter()")
    end
    self:startSkin()
end

function UICompBase:onExit()
    if DEBUG > 0 then
        yflog:Info("UICompBase:onExit()")
    end
end

function UICompBase:onClear()
    self._param = nil
    if DEBUG > 0 then
        yflog:Info("UICompBase:onClear()")
    end
end

function UICompBase:removeCustomClickListener(node)
    if not node then
        return
    end

    if type(node) == "table" then
        for i = 1, #node do
            node[i]:removeClickListener()
        end
    else
        node:removeClickListener()
    end
end

function UICompBase:getClassName()
    local className = self.class and self.class.__cname or self.__cname
    return className
end

-- 注册Component
function UICompBase:registerComponent( ... )
    for _, component in ipairs( {...} ) do
        lt.FGuiManager:registerComponent(self:getClassName(), component)
    end
end

function UICompBase:unregisterComponent( ... )
    for _, component in ipairs( {...} ) do
        lt.FGuiManager:unregisterComponent(self:getClassName(), component)
    end
end

function UICompBase:unregisterAllComponent()
    lt.FGuiManager:unregisterAllComponent(self:getClassName())
end

-- 管理fgui创建的obj组件
function UICompBase:insertObjectToFactory(node)
    if not node then
        yflog:Error("UIGButtonBase:insertToFactory error node is nil self name:%s", self.__cname)
        return
    end
    local className = node.class and node.class.__cname or node.__cname
    yflog:Info("UIGButtonBase:insertObjectToFactory className:%s",className)
    lt.FGuiManager:insertObjectToFactory(className, self:getClassName(), self)
end

return UICompBase