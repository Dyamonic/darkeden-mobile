local EFFECTSPRITETYPE_FIRE_32 = 890

function MPlayingWithFireEffectGenerator:generate(egInfo)
    local est = { egInfo.effectSpriteType }
    local effectCount = 1
    local skillId = egInfo.skillId
    local x = egInfo.x0 - TILE_X / 2
    local y = egInfo.y0 + TILE_Y / 2

    if egInfo.pPreviousEffect ~= nil then
        est[1] = egInfo.pPreviousEffect.est
        if egInfo.isFirePiecing then
            if est[1] > EFFECTSPRITETYPE_FIRE_16 then
                est[1] = est[1] - (math.random(0, 1) * 16)
            else
                est[1] = est[1] + (math.random(0, 1) * 16)
            end
        else
            self._effectCount = self._effectCount + 1
            if self._effectCount > 112 then
                if est[1] > EFFECTSPRITETYPE_FIRE_16 then
                    est[1] = est[1] - (math.random(0, 1) * 16)
                else
                    est[1] = est[1] + (math.random(0, 1) * 16)
                end
            else
                est[1] = est[1] + 1
                if est[1] > EFFECTSPRITETYPE_FIRE_32 then
                    est[1] = EFFECTSPRITETYPE_FIRE_1
                end
            end
        end

        if egInfo.pPreviousEffect.est then
            local prevEffect = egInfo.pPreviousEffect
            x, y = self:getNewCoordinates(prevEffect, x, y)
        end
    else
        self._effectCount = 0
        est, x, y = self:handleInitialEffect(egInfo.direction, x, y)
        effectCount = 16

        self:triggerMeteorShakeEvent()
    end

    -- if est[1] >= g_pEffectSpriteTypeTable:GetSize() then
    --     return false
    -- end

    local sX, sY = MapUtil:PixelToMapX(egInfo.x0), MapUtil:PixelToMapY(egInfo.y0)

    local bAdd = false
    local pEffectTarget2

    for i = 1, effectCount do
        local metas = CacheManager:getProcessMetas(skillId)
        local meta = metas[1]
        meta:setEffectId(est[i])
        local offsetX, offsetY = 0, 0
        local reX, reY = x + offsetX, y + offsetY
        local bullet = lt.BullectScreenEffect.new(skillId, egInfo.direction, cc.p(reX, reY))
        local mTarget, nTarget = MapUtil:PixelToMap(x, y)
        bullet:addEffect(skillId, meta, false)
        bullet:setStep()
        lt.BulletManager:addBulletToMap(bullet, ZORDER_FIRE)
        if egInfo.callback then
            egInfo.callback({est = est[i], x = x, y = y })
        end
    end
    return true
end


function MPlayingWithFireEffectGenerator:getNewCoordinates(prevEffect, x, y)
    local directions = {
        [EFFECTSPRITETYPE_FIRE_1] = {0, -TILE_Y},
        [EFFECTSPRITETYPE_FIRE_2] = {-TILE_X / 2, -TILE_Y},
        [EFFECTSPRITETYPE_FIRE_3] = {-TILE_X, -TILE_Y},
        [EFFECTSPRITETYPE_FIRE_4] = {-TILE_X, -TILE_Y / 2},
        [EFFECTSPRITETYPE_FIRE_5] = {-TILE_X, 0},
        [EFFECTSPRITETYPE_FIRE_6] = {-TILE_X, TILE_Y / 2},
        [EFFECTSPRITETYPE_FIRE_7] = {-TILE_X, TILE_Y},
        [EFFECTSPRITETYPE_FIRE_8] = {-TILE_X / 2, TILE_Y},
        [EFFECTSPRITETYPE_FIRE_9] = {0, TILE_Y},
        [EFFECTSPRITETYPE_FIRE_10] = {TILE_X / 2, TILE_Y},
        [EFFECTSPRITETYPE_FIRE_11] = {TILE_X, TILE_Y},
        [EFFECTSPRITETYPE_FIRE_12] = {TILE_X, TILE_Y / 2},
        [EFFECTSPRITETYPE_FIRE_13] = {TILE_X, 0},
        [EFFECTSPRITETYPE_FIRE_14] = {TILE_X, -TILE_Y / 2},
        [EFFECTSPRITETYPE_FIRE_15] = {TILE_X, -TILE_Y},
        [EFFECTSPRITETYPE_FIRE_16] = {TILE_X / 2, -TILE_Y}
    }


    local est = prevEffect.est
    if est > EFFECTSPRITETYPE_FIRE_16 then
        est = est - 16
    end
    local offset = directions[est]

    return prevEffect.x + offset[1], prevEffect.y + offset[2]
end

function MPlayingWithFireEffectGenerator:handleInitialEffect(direction, x, y)
    local est = {}
    if direction == Constant.DIRECTION_LEFT then
        x = x - TILE_X / 2
        est[1] = EFFECTSPRITETYPE_FIRE_5 + (math.random(0, 1) * 16)
    elseif direction == Constant.DIRECTION_LEFT_DOWN then
        x = x - TILE_X / 2
        y = y - TILE_Y / 2
        est[1] = EFFECTSPRITETYPE_FIRE_3 + (math.random(0, 1) * 16)
    elseif direction == Constant.DIRECTION_DOWN then
        y = y - TILE_Y / 2
        est[1] = EFFECTSPRITETYPE_FIRE_1 + (math.random(0, 1) * 16)
    elseif direction == Constant.DIRECTION_RIGHT_DOWN then
        x = x + TILE_X / 2
        y = y - TILE_Y / 2
        est[1] = EFFECTSPRITETYPE_FIRE_15 + (math.random(0, 1) * 16)
    elseif direction == Constant.DIRECTION_RIGHT then
        x = x + TILE_X / 2
        est[1] = EFFECTSPRITETYPE_FIRE_13 + (math.random(0, 1) * 16)
    elseif direction == Constant.DIRECTION_RIGHT_UP then
        x = x + TILE_X / 2
        y = y + TILE_Y / 2
        est[1] = EFFECTSPRITETYPE_FIRE_11 + (math.random(0, 1) * 16)
    elseif direction == Constant.DIRECTION_UP then
        y = y + TILE_Y / 2
        est[1] = EFFECTSPRITETYPE_FIRE_9 + (math.random(0, 1) * 16)
    elseif direction == Constant.DIRECTION_LEFT_UP then
        x = x - TILE_X / 2
        y = y + TILE_Y / 2
        est[1] = EFFECTSPRITETYPE_FIRE_7 + (math.random(0, 1) * 16)
    end

    for i = 2, 16 do
        local flag = i - 2
        if i == 2 then 
            flag = 15
        end
        est[i] = EFFECTSPRITETYPE_FIRE_1 + (est[1] - EFFECTSPRITETYPE_FIRE_1 + flag) % 16 + (math.random(0, 1) * 16)
    end
    return est, x, y
end

function MPlayingWithFireEffectGenerator:triggerMeteorShakeEvent()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_EVENTFLAG_SHAKE_SCREEN, {eventDelay = 2000, parameter3 = 3, eventType = Constant.SHARK_SCREEN_TYPE.EVENTID_METEOR_SHAKE})
end

return MPlayingWithFireEffectGenerator
