---@class UICompMiniMap 中地图

local UICompMiniMap = class("UICompMiniMap",lt.UICompBase)

local MapModule = lt.MapModule
local Constant = lt.Constant
local CacheManager = lt.CacheManager
local TeamModule = lt.TeamModule
local GameModule = lt.GameModule
local NtfManager = lt.NtfManager
local TaskModule = lt.TaskModule
local CommonFunc = lt.CommonFunc
local frameWidth = 740

function UICompMiniMap:ctor()
    UICompMiniMap.super.ctor(self)
    self._mWidth = nil
    self._nHeight = nil
    self._mapSize = nil
    self._mapCode = nil

    self._objlist = {}
    self._teamlist = {}
    self._showNpc = true
    self._showDungeon = true
    self._showTransmit = true
    self._showMission = true
    self._showTeamMate = true
    self._routenode = nil
end

function UICompMiniMap:onConstruct()

end

function UICompMiniMap:onClear()
    self._mWidth = nil
    self._nHeight = nil
    self._mapSize = nil
    self._mapCode = nil

    self._objlist = nil
    self._teamlist = nil
    self._showNpc = nil
    self._showDungeon = nil
    self._showTransmit = nil
    self._showMission = nil
    self._showTeamMate = nil
    self._routenode = nil
    UICompMiniMap.super.onClear(self)
end

function UICompMiniMap:onEnter()
    UICompMiniMap.super.onEnter(self)
end

function UICompMiniMap:onExit()
    UICompMiniMap.super.onExit(self)
end

function UICompMiniMap:changePos(posX, posY)
    local x = posX + (frameWidth-self._mapSize.width)/2
    local y = posY + self._disHeight
    return x, y
end

function UICompMiniMap:posToMiniMapPos(posX,posY)
    local minimapPosX = posX*Constant.MAP_BLOCK_WIDTH*self._mapSize.width/self._mWidth
    local minimapPosY = posY*Constant.MAP_BLOCK_HEIGHT*self._mapSize.height/self._nHeight
    local minimapPosX, minimapPosY = self:changePos(minimapPosX, minimapPosY)
    return minimapPosX, minimapPosY
end

function UICompMiniMap:posToMiniMapPos2(posX,posY)
    local minimapPosX = posX*Constant.MAP_BLOCK_WIDTH*self._mapSize.width/self._mWidth
    local minimapPosY = Constant.MAP_BLOCK_HEIGHT*self._mapSize.height/self._nHeight - posY*Constant.MAP_BLOCK_HEIGHT*self._mapSize.height/self._nHeight
    local minimapPosX, minimapPosY = self:changePos(minimapPosX, minimapPosY)
    return minimapPosX, minimapPosY
end

function UICompMiniMap:miniMapPosToPos(posX, posY)
    local minimapPosX = posX - (frameWidth-self._mapSize.width)/2
    local minimapPosY = posY - self._disHeight
    minimapPosX = minimapPosX/Constant.MAP_BLOCK_WIDTH/self._mapSize.width*self._mWidth
    minimapPosY = minimapPosY/Constant.MAP_BLOCK_HEIGHT/self._mapSize.height*self._nHeight

    return minimapPosX, minimapPosY
end

-- 显示自己信息
function UICompMiniMap:refreshMinMapInfo(mapData,mapMeta)
    local my = self:getChild("my")
    local race = GameModule:getHeroRace()
    my:getChild("icon"):setURL(string.format(_GURL.GetMinMapPlayer,(Constant.RaceSkinRes[race] or "_o")))
    my:setVisible(false)
    local posT = self:getChild("pos")
    posT:setText("")

    if not mapMeta then return end
    
    -- 地图信息显示
    local map = self:getChild("map")
    local minMapResPath = string.format(_GURL.GetSmallMap, mapMeta:getResCode())
    map:setURL(minMapResPath)
    local mapSize = map:getSize()
    self._mapSize = mapSize
    self._disHeight = 0

    local scaleX = mapSize.width/frameWidth
    --缩放大于1的才需要适配
    if scaleX > 1 then
        map:setScale(1/scaleX, 1/scaleX)
        self._mapSize = cc.size(mapSize.width*1/scaleX, mapSize.height*1/scaleX)
        self._disHeight = mapSize.height*(1-1/scaleX)/2
    else
        map:setScale(1, 1)
    end

    local mapFrame = self:getChild("mapFrame")
    mapFrame:setScale(scaleX > 1 and 1 or scaleX, 1)
    self:getChild("n64"):setSize(self._mapSize.width, mapSize.height)

    self:setSize(mapSize.width > frameWidth and frameWidth or mapSize.width, mapSize.height)

    local mCount = mapMeta:getWidth()
    local nCount = mapMeta:getHeight()
    self._mWidth = Constant.MAP_BLOCK_WIDTH * mCount
    self._nHeight = Constant.MAP_BLOCK_HEIGHT * nCount

    -- 加载地图信息
    self._showNpc = MapModule:getSelectTable(Constant.MiniMapSelect.Npc)
    self._showDungeon = MapModule:getSelectTable(Constant.MiniMapSelect.Pos)
    self._showTransmit = MapModule:getSelectTable(Constant.MiniMapSelect.Delivery)
    self._showMission = MapModule:getSelectTable(Constant.MiniMapSelect.Task)
    self._showTeamMate = MapModule:getSelectTable(Constant.MiniMapSelect.Team)

    if self._mapCode ~= mapMeta:getMapCode() then
        --清除所有标记
        for i = 1, #self._objlist do
            self._objlist[i]:removeFromParent()
        end
        self._objlist = {}
        self._teamlist = {}

        self._mapCode = mapMeta:getMapCode()
        local worldAgent = lt.AgentManager:getWorldAgent()

        --加载npc(包括魔灵柱)
        local npclist = worldAgent:getNpcPositionList(self._mapCode)
        for k, v in pairs(npclist) do
            local isTransmit = v.npcType == Constant.NPC_TYPE.TRANSMIT
            --只有魔族显示魔灵柱
            if v.isDisplay == 0 and ((isTransmit and race == Constant.RaceType.Ousters) or not isTransmit) then
                local parentNode = isTransmit and self:getChild("transmitNode") or self:getChild("npcNode")
                local scale = isTransmit and 1 or 1.5
                local npcObj = fgui.UIPackage:createObject("MiniMap", isTransmit and "TransmitBig" or "NpcBig")
                parentNode:addChild(npcObj)
                local posX, posY = self:posToMiniMapPos(v.npcX, v.npcY)
                npcObj:setPosition(posX, posY)
                npcObj:getChild("icon"):setScale(scale, scale)
                npcObj.npcName = k
                if not isTransmit then
                    npcObj:getChild("label_name"):setText(string.split(k, "|")[1])
                    --npc名字偏移
                    local isOffset = MapModule:getNpcOffset(v.npcId)
                    if isOffset then
                        npcObj:getChild("label_name"):setPosition(0 + tonumber(isOffset[3]), -20 + tonumber(isOffset[2]))
                    else
                        npcObj:getChild("label_name"):setPosition(0, -20)
                    end
                    -- npcObj:getChild("label_name"):setVisible(true)
                end
                table.insert(self._objlist, npcObj)
            end
        end

        self:initVampireLairNpc()
        --加载地牢
        local dungeonEntraMeta = CacheManager:getMapTransferMeta(self._mapCode)
        for i = 1, #dungeonEntraMeta do
            local meta = dungeonEntraMeta[i]
            if #meta:getLandMark() == 3 then
                local dungeonObj = fgui.UIPackage:createObject("MiniMap", "DungeonBig")
                self:getChild("dungeonNode"):addChild(dungeonObj)
                local posX, posY = self:posToMiniMapPos(meta:getLandMark()[2] or 0, meta:getLandMark()[3] or 0)
                dungeonObj:setPosition(posX, posY)
                local targetMapMeta = CacheManager:getMapMeta(meta:getLandMark()[1])
                if targetMapMeta then
                    local startLvl,endLvl = targetMapMeta:getLvlRecommend()
                    local nameY = -20
                    if startLvl then
                        local s_lvl = startLvl <= 150 and string.format("Lv%s",startLvl) or string.format("Av%s",startLvl - 150)
                        local e_lvl = endLvl <= 150 and string.format("Lv%s",endLvl) or string.format("Av%s",endLvl - 150)
                        local levelstring = string.format("[%s-%s]",s_lvl, e_lvl)
                        dungeonObj:getChild("label_level"):setText(levelstring)
                        dungeonObj:getChild("label_level"):setVisible(true)
                        nameY = -30
                    else
                        dungeonObj:getChild("label_level"):setVisible(false)
                    end
                    dungeonObj:getChild("label_name"):setText(meta:getLandMarkName())
                    --地牢名字偏移
                    local isOffset = meta:getMarkShift()
                    if isOffset then
                        dungeonObj:getChild("label_name"):setPosition(0 + isOffset[2], nameY + isOffset[1])
                        dungeonObj:getChild("label_level"):setPosition(0 + isOffset[2], -15 + isOffset[1])
                    else
                        dungeonObj:getChild("label_name"):setPosition(0, nameY)
                        dungeonObj:getChild("label_level"):setPosition(0, -15)
                    end
                    dungeonObj:getChild("label_name"):setVisible(true)
                end
                table.insert(self._objlist, dungeonObj)
            end
        end

        --加载任务点
        if self._mapCode == Constant.MAP_CODE.ALTAROFBLOOD then
            --解救人质单独处理
            local taskData = TaskModule:getTaskById(Constant["ADVANCE_TASK"..race].HOSTAGE)
            local isComplete = TaskModule:checkTaskComplete(taskData)
            if not isComplete then
                local altarBloodNpc = MapModule:getAltarBloodNpc()
                for k, v in pairs(npclist) do
                    local isFinish = CommonFunc:isInArray(altarBloodNpc, tostring(v.npcId))
                    if v.isDisplay == race and not isFinish then
                        local parentNode = self:getChild("missionNode")
                        local scale = 1.5
                        local npcObj = fgui.UIPackage:createObject("MiniMap", "MissionBig")
                        parentNode:addChild(npcObj)
                        local posX, posY = self:posToMiniMapPos(v.npcX, v.npcY)
                        npcObj.npcId = v.npcId
                        npcObj:setPosition(posX, posY)
                        npcObj:getChild("icon"):setScale(scale, scale)
                        table.insert(self._objlist, npcObj)
                    end
                end
            end
        end
    else
        --任务点刷新
        if self._mapCode == Constant.MAP_CODE.ALTAROFBLOOD then
            --解救人质单独处理
            local taskData = TaskModule:getTaskById(Constant["ADVANCE_TASK"..race].HOSTAGE)
            local isComplete = TaskModule:checkTaskComplete(taskData)
            local altarBloodNpc = MapModule:getAltarBloodNpc()
            for k, v in pairs(self._objlist) do
                local isFinish = CommonFunc:isInArray(altarBloodNpc, tostring(v.npcId))
                v:setVisible(not isComplete and not isFinish)
            end
        end
    end

    -- 我的信息显示
    if mapData then
        local mCount = mapData:getMCount()
        local nCount = mapData:getNCount()
        self._mWidth = Constant.MAP_BLOCK_WIDTH * mCount
        self._nHeight = Constant.MAP_BLOCK_HEIGHT * nCount
        -- 刷新坐标位置
        local posT = self:getChild("pos")
        local myPos = MapModule:getMyPosData()
        if myPos then
            posT:setText(string.format("X:%s  Y:%s",myPos[2],myPos[3]))
            posT:setPosition((frameWidth-self._mapSize.width)/2+2,370)
            -- 刷新我的位置
            local posX, posY = self:posToMiniMapPos(myPos[2] or 0, myPos[3] or 0)
            my:setPosition(posX, posY)
            my:setVisible(true)
            --刷新导航路线
            self:deleteRoute(posX, posY)
        end
    end

    --导航层
    self._routenode = self:getChild("routeNode")
    local myMapMeta = lt.AgentManager:getWorldAgent():getMapAgent():getMapMeta()
    self._routenode:setVisible(self._mapCode == myMapMeta:getMapCode())

    -- self:getChild("npcNode"):setVisible(self._showNpc)
    local childs = self:getChild("npcNode"):getChildren()
    for i = 1, #childs do
        childs[i]:getChild("label_name"):setVisible(self._showNpc)
    end
    self:getChild("dungeonNode"):setVisible(self._showDungeon)
    self:getChild("transmitNode"):setVisible(self._showTransmit)
    self:getChild("transmitNode"):setVisible(self._showMission)
    self:getChild("missionNode"):setVisible(self._showTeamMate)
end

--画安全区
function UICompMiniMap:drawSafeArea()
    local parentNode = self:getChild("safeAreaNode"):displayObject()
    for k = 0, 20 do
        for i = 91+k, 127-1+k do
            for j = 196+k, 197-1+k do
                local posX1, posY1 = self:posToMiniMapPos2(i, j)
                local posX2, posY2 = self:posToMiniMapPos2(i+1, j+1)
                local drawNode = cc.DrawNode:create()
                drawNode:drawSolidRect(cc.p(posX1, posY1), cc.p(posX2, posY2), cc.c4b(0xFF/255, 0x00/255, 0x00/255, 0.3))
                parentNode:addChild(drawNode)
            end
        end
    end 
end

