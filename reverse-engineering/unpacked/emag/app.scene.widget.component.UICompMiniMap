function UICompMiniMap:getGuideList()
    local guidelist = {}
    local myMapMeta = lt.AgentManager:getWorldAgent():getMapAgent():getMapMeta()
    -- if self._showNpc then
        local worldAgent = lt.AgentManager:getWorldAgent()
        local npclist = worldAgent:getNpcPositionList(self._mapCode)
        for k, v in pairs(npclist) do
            local isTransmit = v.npcType == Constant.NPC_TYPE.TRANSMIT
            if not isTransmit and v.isDisplay == 0 then
                local obj = {}
                obj.name = string.split(k, "|")[1]
                obj.icon = "icon_sjditu_06"
                obj.posX = v.npcX
                obj.posY = v.npcY
                obj.guide = myMapMeta:getMapCode() == self._mapCode
                obj.npcId = v.npcId
                table.insert(guidelist, obj)
            end
        end
    -- end
    if self._showDungeon then
        local dungeonEntraMeta = CacheManager:getMapTransferMeta(self._mapCode)
        for i = 1, #dungeonEntraMeta do
            local meta = dungeonEntraMeta[i]
            if #meta:getLandMark() == 3 then
                local obj = {}
                local targetMapMeta = CacheManager:getMapMeta(meta:getLandMark()[1])
                obj.name = meta:getLandMarkName()
                obj.icon = "icon_sjditu_05"
                obj.posX = meta:getLandMark()[2]
                obj.posY = meta:getLandMark()[3]
                obj.guide = myMapMeta:getMapCode() == self._mapCode
                table.insert(guidelist, obj)
            end
        end
    end
    --只有魔族显示魔灵柱
    local race = GameModule:getHeroRace()
    if self._showTransmit and race == Constant.RaceType.Ousters then
        local worldAgent = lt.AgentManager:getWorldAgent()
        local npclist = worldAgent:getNpcPositionList(self._mapCode)
        for k, v in pairs(npclist) do
            local isTransmit = v.npcType == Constant.NPC_TYPE.TRANSMIT
            if isTransmit then
                local obj = {}
                obj.name = string.split(k, "|")[1]
                obj.icon = "icon_sjditu_03"
                obj.posX = v.npcX
                obj.posY = v.npcY
                obj.guide = myMapMeta:getMapCode() == self._mapCode
                obj.npcId = v.npcId
                table.insert(guidelist, obj)
            end
        end
    end
    return guidelist
end

--更新队友位置信息
function UICompMiniMap:onTeamMeteInfo(param)
    --没队伍隐藏所有
    if param.playerId == nil then
        for k, v in pairs(self._teamlist) do
            v:setVisible(false)
        end
        return
    end
    --先隐藏旧数据
    local quitPlayerIds = TeamModule:getQuitPlayerId()
    for i = 1, #quitPlayerIds do
        if self._teamlist[quitPlayerIds[i]] then
            self._teamlist[quitPlayerIds[i]]:setVisible(false)
        end
    end
    TeamModule:resetQuitPlayerId()
    --自己剔除
    local playerId = GameModule:getHeroData():getPlayerId()
    if playerId == param.playerId then return end
    --新数据
    if self._mapCode == param.mapCode then
        if self._teamlist[param.playerId] == nil then
            local teamObj = fgui.UIPackage:createObject("MiniMap", "TeamMatePoint")
            local teamMate = TeamModule:getTeamMateByPlayerId(param.playerId)
            teamObj:getChild("label_name"):setText(teamMate and teamMate.playerName or "")
            teamObj:getChild("label_name"):setVisible(true)
            self:getChild("teamNode"):addChild(teamObj)
            self._teamlist[param.playerId] = teamObj
            table.insert(self._objlist, teamObj)
        end
        local posX, posY = self:posToMiniMapPos(param.Xpos, param.Ypos)
        self._teamlist[param.playerId]:setPosition(posX, posY)
    end
    if self._teamlist[param.playerId] then
        self._teamlist[param.playerId]:setVisible(self._mapCode == param.mapCode)
    end
end

function UICompMiniMap:routePos(param)
    if self._routenode then
        local childs = self._routenode:getChildren()
        for i = 1, #childs do
            childs[i]:removeFromParent()
        end
        self._routearray = nil
    end
    if param.routeMNArray then
        self._routearray = param.routeMNArray
        self:addRoute(self._routearray)
    end
end

function UICompMiniMap:addRoute(array)
    if not array or not self._routenode then
        return 
    end
    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
    if not mapAgent then
        return
    end
    self._routearray = array
    local needShow = true
    local curX = nil
    for i = 1, #array do
        local pointObj = fgui.UIPackage:createObject("MiniMap", "RoutePoint")
        local posX, posY = self:posToMiniMapPos(self._routearray[i][1], self._routearray[i][2])
        pointObj:setPosition(posX, posY)
        pointObj:setVisible(i%2 == 1)
        self._routenode:addChild(pointObj)
        if i%2 == 1 then
            --纵向的两个点只显示一个
            if curX == posX then
                curX = nil
                pointObj:setVisible(false)
            else
                curX = posX
            end
        end
    end
end

function UICompMiniMap:deleteRoute(m, n)
    if not self._routenode then
        return 
    end
    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
    if not mapAgent then
        return
    end
    local needDelete = {}
    local childs = self._routenode:getChildren()
    for i = 1, #childs do
        table.insert(needDelete, childs[i])
        local childX = childs[i]:getX()
        local childY = childs[i]:getY()
        if math.floor(childX) == math.floor(m) and math.floor(childY) == math.floor(n) then
            break
        end
    end
    if #needDelete < #childs then
        for i = 1, #needDelete do
            needDelete[i]:removeFromParent()
        end
    end
end

function UICompMiniMap:selectMapPos(position)
    local myMapMeta = lt.AgentManager:getWorldAgent():getMapAgent():getMapMeta()
    if self._mapCode ~= myMapMeta:getMapCode() then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_TRANSMIT_MAP_TIPS4})
        return
    end
    local pt = self:globalToLocal(position)
    local x, y = self:miniMapPosToPos(pt.x, pt.y)
    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
    if mapAgent and mapAgent:isBlocked(x, y) then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = GReadText.KEY_TASK_TIPS7})
        return
    end
    lt.AutoFightManager:endAutoFight()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MINIMAP_ROUTE_POS,{posx = x, posy = y, mapId = myMapMeta:getMapCode()})
end

function UICompMiniMap:onNpcDisappear(param)
    for k, v in pairs(self._objlist) do
        if v.npcId == param.npcId then
            v:setVisible(false)
        end
    end
end

function UICompMiniMap:onNpcShow(param)
    local show = param.show
    local npcName = param.npcName
    for k, v in pairs(self._objlist) do
        if v.npcName == npcName then
            v:setVisible(show)
        end
    end
end

function UICompMiniMap:initVampireLairNpc()
    local pcVampireLairInfo = MapModule:getNpcVampireLairInfo()
    if pcVampireLairInfo then
        local npcName = ""
        local npcMap = CacheManager:getNpcVampireLairTable()
        local myMapMeta = lt.AgentManager:getWorldAgent():getMapAgent():getMapMeta()
        local mymapcode = myMapMeta:getMapCode()
        if npcMap[mymapcode] then
            npcName = npcMap[mymapcode]:getNpcName()
        else
            return
        end
        local show = false
        local vampireState = pcVampireLairInfo.vampireState
        if vampireState == lt.CommonModule:GetNetCmdEnum("NPCVAMPIRELAIRSTATE_NPCVAMPIRELAIRSTATE_PLAYTIME_ENUM") then
            show = true
        end
        for k, v in pairs(self._objlist) do
            if v.npcName == npcName then
                v:setVisible(show)
            end
        end
    end
end

return UICompMiniMap