
local Route = class("Route")

Route._mnArray = nil

function Route:ctor(mnArray)
    self._mnArray = mnArray
end

function Route:getMNCount()
    return #self._mnArray
end

function Route:getNextMN()
    local mn = self._mnArray[1]

    table.remove(self._mnArray, 1)

    return mn
end

function Route:queryNextMN()
    return self._mnArray[1]
end

function Route:queryMN(idx)
    return self._mnArray[idx]
end

function Route:dump()
    lt.LogUtil:debug("========================================")
    lt.LogUtil:debug("mnCount: " .. #self._mnArray)

    for i=1,#self._mnArray do
        local point = self._mnArray[i]
        lt.LogUtil:debug(point.x .. "," .. point.y)
    end
    lt.LogUtil:debug("========================================")
end

function Route:getPointArray()
    return self._mnArray
end

return Route
