---@class UIWndEnergyBuy:UIWindowBase
---精力系统 购买
local UIWndEnergyBuy = class("UIWndEnergyBuy", lt.UIWindowBase)

local Constant = lt.Constant
local CacheManager = lt.CacheManager
local NtfManager = lt.NtfManager
local TransactionModule = lt.TransactionModule
local ItemModule = lt.ItemModule
local GameModule = lt.GameModule
local RechargeModule = lt.RechargeModule

function UIWndEnergyBuy:ctor(param)
    UIWndEnergyBuy.super.ctor(self, param)
end

function UIWndEnergyBuy:onClear()
    self._lblName = nil
    self._lblHave = nil
    self._iconItem = nil
    self._lblDesc = nil
    self._touchLayer = nil
    self._btnNumAdd = nil
    self._btnNumSub = nil
    self._btnNumMax = nil
    if self._numInput then
        self._numInput:removeEditHandler()
        self._numInput:removeSelf()
        self._numInput = nil
    end
    self._btnBuy = nil
    self._btnUse = nil
    self._btnCancel = nil
    self._itemMeta = nil
    self._max = nil
    self._num = nil

    UIWndEnergyBuy.super.onClear(self)
end

function UIWndEnergyBuy:onHide()
    NtfManager:removeNtfListenerByTag("UIWndEnergyBuy:refreshItemNum")
    self._touchLayer:removeClickListener()
    self._btnNumSub:removeClickListener()
    self._btnNumAdd:removeClickListener()
    self._btnNumMax:removeClickListener()
    self._btnBuy:removeClickListener()
    self._btnUse:removeClickListener()
    self._btnCancel:removeClickListener()
    self._iconItem:removeClickListener()
    UIWndEnergyBuy.super.onHide(self)
end

function UIWndEnergyBuy:onShown()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB,
        handler(self, self.refreshItemNum), "UIWndEnergyBuy:refreshItemNum")
    self._touchLayer:addClickListener(handler(self, self.hideSelectView))
    self._btnNumSub:addClickListener(handler(self, self.openSubNumBtnClick))
    self._btnNumAdd:addClickListener(handler(self, self.openAddNumBtnClick))
    self._btnNumMax:addClickListener(handler(self, self.openMaxNumBtnClick))
    self._btnBuy:addClickListener(handler(self, self.onBuyBtnClick))
    self._btnUse:addClickListener(handler(self, self.onUseBtnClick))
    self._btnCancel:addClickListener(handler(self, self.hideSelectView))
    self._iconItem:addClickListener(handler(self, self.onShowTipClick))
    self:refreshView()
end

function UIWndEnergyBuy:onInit()
    UIWndEnergyBuy.super.onInit(self, _GURL.UIWndEnergyBuy)
    self._lblName = self:getChild("lbl_name")
    self._lblHave = self:getChild("lbl_have")
    self._iconItem = self:getChild("icon_item")
    self._lblDesc = self:getChild("lbl_desc")
    self._touchLayer = self:getChild("touchLayer")
    self._btnNumAdd = self:getChild("btn_add")
    self._btnNumSub = self:getChild("btn_sub")
    self._btnNumMax = self:getChild("btn_max")
    self._btnBuy = self:getChild("btn_buy")
    self._btnUse = self:getChild("btn_use")
    self._btnCancel = self:getChild("btn_cancel")
    self:initCocosInputUI()
end

function UIWndEnergyBuy:refreshView()
    local vitalityUsage = CacheManager:getVariableById(Constant.Variable.VitalityUsage)
    local types = tonumber(string.split(vitalityUsage, ",")[1])
    local itemId = tonumber(string.split(vitalityUsage, ",")[2])
    local itemMeta = CacheManager:getItemMeta(itemId)
    self._itemMeta = itemMeta

    --购买道具
    self._lblName:setText(itemMeta:getName())
    self._lblDesc:setText(itemMeta:getDes())
    self._iconItem:setURL(string.format("ui://Item/prop_%s", itemMeta:getIconId()))

    --拥有数量
    self:refreshItemNum()

    self._num = 1
    self:refreshUseNum()
end

function UIWndEnergyBuy:initCocosInputUI()
    if not self._numInput then
        self._numInput = ccui.EditBox:create(cc.size(110, 32), "", ccui.TextureResType.localType)
        self._numInput:setAnchorPoint(cc.p(0, 0))
        self._numInput:setFontName(lt.Constant.FONT_4)
        self._numInput:setFontSize(20)
        self._numInput:setReturnType(cc.KEYBOARD_RETURNTYPE_SEND)
        self._numInput:setInputMode(cc.EDITBOX_INPUT_MODE_SINGLELINE)
        self._numInput:registerScriptEditBoxHandler(handler(self, self.editBoxEvent))
        self._numInput:setPosition(cc.p(8, 1))
        self._numInput:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
        self:getChild("n68"):displayObject():addChild(self._numInput)
    end
end

--购买
function UIWndEnergyBuy:onBuyBtnClick()
    local access = self._itemMeta:getAccess()
    if access then
        local jumpStore = access[1][2]
        RechargeModule:openRechargeByItemId(jumpStore)
    end
end

--使用
function UIWndEnergyBuy:onUseBtnClick()
    local vitalityUsage = CacheManager:getVariableById(Constant.Variable.VitalityUsage)
    local itemType = tonumber(string.split(vitalityUsage, ",")[1])
    local itemId = tonumber(string.split(vitalityUsage, ",")[2])
    local isEnough = ItemModule:enoughItem(itemType, itemId, self._num, {total = true, tips = true})
    if not isEnough then
        return
    end
    ItemModule:sendUseItemByIndex(itemId, itemType, self._num)
    self:hideSelectView()
end

function UIWndEnergyBuy:editBoxEvent(eventType, sender)
    if eventType == "began" then
    elseif eventType == "ended" then
        --过滤无效字符
        self._num = tonumber(sender:getText())
        if self._num == nil then
            self._num = 1
        else
            --判断上下限
            if self._num > self._max then
                self._num = self._max
            elseif self._num < 1 then
                self._num = 1
            end
        end
        sender:setText("")
        --刷新界面
        self:refreshUseNum()
    elseif eventType == "changed" then
        local str = sender:getText()
        str = string.gsub(str, "[^0-9]", "")
        sender:setText(str)
    elseif eventType == "return" then
    end
end

function UIWndEnergyBuy:openAddNumBtnClick()
    if self._num >= self._max then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = GReadText.KEY_SHOPPING_TIPS13})
        return
    end
    self._num = self._num + 1
    self:refreshUseNum()
end

function UIWndEnergyBuy:openSubNumBtnClick()
    if self._num <= 1 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = GReadText.KEY_SHOPPING_TIPS12})
        return
    end
    self._num = self._num - 1
    self:refreshUseNum()
end

function UIWndEnergyBuy:openMaxNumBtnClick()
    self._num = self._max
    self:refreshUseNum()
end

function UIWndEnergyBuy:refreshUseNum()
    self._numInput:setText(self._num)
end

--刷新道具数量
function UIWndEnergyBuy:refreshItemNum()
    if event and event.name == "NTF_UPDATE_ITEM_NUMB" then
        if event.param and event.param.content then
            if self._itemContentTable and self._itemContentTable[event.param.content] then
                
            else
                return
            end
        end
    end
    local itemId = self._itemMeta:getItemId()
    local types = self._itemMeta:getItemType()
    local itemNum = ItemModule:getItemAllCountByItemId(itemId, types)
    self._lblHave:setText(itemNum)
    self._lblHave:setColor(itemNum > 0 and Constant.COLOR_GREEN or Constant.COLOR_TEXT_RED)
    --阈值
    self._max = itemNum == 0 and 1 or itemNum
    self._itemContentTable = {}
    local _itemkey = string.format("%d_%d",types,itemId)
    self._itemContentTable[_itemkey] = true
end

function UIWndEnergyBuy:onShowTipClick()
    if self._itemMeta then
        ItemModule:showTipsByType(self._itemMeta)
    end
end

function UIWndEnergyBuy:hideSelectView()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndEnergyBuy", close = true })
end

return UIWndEnergyBuy
