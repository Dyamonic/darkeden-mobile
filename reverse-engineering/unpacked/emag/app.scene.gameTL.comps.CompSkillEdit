        end 
    end
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.SKILL_EDIT8) then
        if self._compSkill:getOpMode() == Operate.Edit_Pos then
            local pos = self:displayObject():convertToWorldSpace(self._autoBtn:getPosition())
            pos = cc.p(pos.x, pos.y)
            GuideModule:triggerGuide(Constant.GUIDE_ID.SKILL_EDIT8, self._autoBtn, pos, function()
