function CompSkillEdit:refreshUI()
    self:refreshSkillList()
    self:refreshAutoSkillList()
    self:refreshSkillSlot()
end

function CompSkillEdit:refreshEditBtnTouch()
    local isCanMove = self._compSkill:canRemove()
    self._removeBtn:setTouchable(isCanMove)
    self._removeBtn:getController("button"):setSelectedIndex(isCanMove == false and 2 or 0)
    local isTouch = self._compSkill:isExistOperateBtn()
    self._scaleSlider:setTouchable(isTouch)
    self._btnAddScale:setTouchable(isTouch)
    self._btnSubScale:setTouchable(isTouch)
    self._scaleSlider:setGrayed(not isTouch)
    self._btnAddScale:setGrayed(not isTouch)
    self._btnSubScale:setGrayed(not isTouch)

    self._touchTipBtn:setTouchable(not isTouch)
    self._removeTouchTipsBtn:setTouchable(not isCanMove)
end

function CompSkillEdit:refreshEditUI(index)
    self._editData = SkillModule:getEditConf()

    local value = 100
    if index then
        value = self._editData[index].scale * 100
    end
    self._scaleSlider:setValue(value - 50)
    self._scaleText:setText(math.floor(value + 0.5).."%")
    self:setBtnText(index)
    self:refreshEditBtnTouch()
end

function CompSkillEdit:refreshSkillList()
    if not self._skillItemGroups then
        self._skillItemGroups = {}
    end
    
    local skillTable = SkillModule:getEditSkills()
    for k, v in ipairs(skillTable) do
        if #v > 0 then
            local skillCell = self._skillList:addItemFromPool()
            skillCell:getChild("label_title"):setText(GReadText["KEY_EDIT_SKILL_NAME"..k])
            local skillList = skillCell:getChild("list_skill")
            skillList:setSize(622, 70*math.ceil(#v/9))
            for k1, v1 in ipairs(v) do
                local itemBox = skillList:addItemFromPool()
                itemBox:insertObjectToFactory(self)
                local skillId = v1
                local isEquip, posEquip = self:isEquipBySkillId(skillId)
                itemBox:setItemInfo(skillId, isEquip)
                itemBox:addClickListener(function()
                    self:skillBtnClick(skillId, itemBox)
                end)
                self._skillItemGroups[skillId] = itemBox
            end
        end
    end
end

function CompSkillEdit:skillBtnClick(skillId, itemBox)
    --被动不能装备
    local skillMeta = CacheManager:querySkillMeta(skillId) 
    if skillMeta:getPassiveSkill() == 0 then
        self._compSkill:setOpMode(Operate.Edit_Set)
    else
        self._compSkill:setOpMode(Operate.Edit_Normal)
    end
    --取消当前选中
    if self.selectSkillId then
        self._skillItemGroups[self.selectSkillId]:getController("button"):setSelectedIndex(0)
    end
    self.selectSkillId = skillId
    local isEquip, posEquip = self:isEquipBySkillId(skillId)
    self._compSkill:setSelectSkillInfo(skillId, posEquip)
    self._compSkill:setLight(skillMeta:getPassiveSkill() == 0)
    self._skillTips:setVisible(true)
    self._skillTips:refreshContent(skillId)
    itemBox:getController("button"):setSelectedIndex(1)
end

function CompSkillEdit:isEquipBySkillId(skillId, isAuto)
    local isEquip = false
    local startIdx = isAuto and 30 or 1
    local endIdx = isAuto and 39 or 29
    for pos, skillInfo in pairs(SkillModule:getEditConf()) do
        if pos >= startIdx and pos <= endIdx then
            if skillInfo.skillId == skillId then
                return true, pos
            end
        end
    end
    return isEquip, nil
end

function CompSkillEdit:takeonSuccess(repalaceSkillId)
    if self._compSkill:getOpMode() == Operate.Edit_Set then
        self._compSkill:setOpMode(Operate.Edit_Normal)
        if repalaceSkillId then
            if self._skillItemGroups[repalaceSkillId] then
                self._skillItemGroups[repalaceSkillId]:setItemInfo(repalaceSkillId, false)
            end
        end
        self._skillItemGroups[self.selectSkillId]:setItemInfo(self.selectSkillId, true)
        self._skillItemGroups[self.selectSkillId]:setSelected(false)
    elseif self._compSkill:getOpMode() == Operate.Auto_Set then
        self._compSkill:setOpMode(Operate.Auto_Normal)
        if repalaceSkillId then
            if self._autoSkillItemGroups[repalaceSkillId] then
                self._autoSkillItemGroups[repalaceSkillId]:setItemInfo(repalaceSkillId, false)
            end
        end
        self._autoSkillItemGroups[self.selectSkillId]:setItemInfo(self.selectSkillId, true)
        self._autoSkillItemGroups[self.selectSkillId]:setSelected(false)
    end
    self._compSkill:setLight(false)
    self._skillTips:setVisible(false)
end

function CompSkillEdit:takeoffSuccess(takeoffId)
    if self._compSkill:getOpMode() == Operate.Edit_Normal then
        if self._skillItemGroups[takeoffId] then
            self._skillItemGroups[takeoffId]:setItemInfo(takeoffId, false)
        end
    elseif self._compSkill:getOpMode() == Operate.Auto_Normal then
        if self._autoSkillItemGroups[takeoffId] then
            self._autoSkillItemGroups[takeoffId]:setItemInfo(takeoffId, false)
        end
    end
end

function CompSkillEdit:refreshSkillSlot()
    self._compSkill:setOpMode(Operate.Edit_Normal)
    self._compSkill:setEditCom(self)
end

