function CompSkillEdit:ctor()
    self:registerComponent("CompSkillEditTips", "CompSkillItem")
    CompSkillEdit.super.ctor(self)
    self._skillItemGroups = {}
    self._autoSkillItemGroups = {}
    self._openIndex = 0
    self._isOpenCheckChange = true
    self._isChanged = false
end

function CompSkillEdit:onConstruct()
    self:startSkin()
    self._skillList = self:getChild('skillList')
    self._compSkill = self:getChild('compSkill')
    self._skillSetBtn = self:getChild('skillSetBtn')
    self._editBtn = self:getChild('editBtn')
    self._addBtn = self:getChild('addBtn')
    self._removeBtn = self:getChild('removeBtn')
    self._btnText = self:getChild('btnText')
    self._hideBtn = self:getChild('hideBtn')
    local curRace = lt.GameModule:getHeroRace()
    if curRace == RaceType.Ousters then
        self._scaleSlider = self:getChild('scaleSlider')
        self:getChild('scaleSlider2'):setVisible(false)
    else
        self._scaleSlider = self:getChild('scaleSlider2')
        self:getChild('scaleSlider'):setVisible(false)
    end
    self._scaleText = self:getChild('scaleText')
    self._openController = self:getController("editOpen")
    self._okBtn = self:getChild('okBtn')
    self._cancelBtn = self:getChild('cancelBtn')
    self._defaultBtn = self:getChild('defaultBtn')
    self._skillTips = self:getChild("skillTips")
    self._skillTips:insertObjectToFactory(self)
    self._shadow = self:getChild("shadow")
    self._btnAddScale = self:getChild("btnAddScale")
    self._btnSubScale = self:getChild("btnSubScale")
    self._touchTipBtn = self:getChild("touchTipBtn")
    self._removeTouchTipsBtn = self:getChild("removeTouchTipsBtn")
    --自动战斗编辑
    self._autoHideBtn = self:getChild('autoHideBtn')
    self._autoBtn = self:getChild('autoBtn')
    self._autoCancelBtn = self:getChild('autoCancelBtn')
    self._autoOkBtn = self:getChild('autoOkBtn')
    self._autoSkillList = self:getChild('autoSkillList')
    self:refreshLeftUIOffset(Constant.SETTINGS_TYPES.LEFT_OFFSET)
end

function CompSkillEdit:onClear()
    self:unregisterAllComponent()
    self:removeCustomClickListener(self._editBtn)
    self:removeCustomClickListener(self._skillSetBtn)
    self:removeCustomClickListener(self._addBtn)
    self:removeCustomClickListener(self._removeBtn)
    self:removeCustomClickListener(self._hideBtn)
    self:removeCustomClickListener(self._cancelBtn)
    self:removeCustomClickListener(self._okBtn)
    self:removeCustomClickListener(self._defaultBtn)
    self:removeCustomClickListener(self._shadow)
    self:removeCustomClickListener(self._btnAddScale)
    self:removeCustomClickListener(self._btnSubScale)
    self:removeCustomClickListener(self._touchTipBtn)
    self:removeCustomClickListener(self._removeTouchTipsBtn)
    self:removeCustomClickListener(self._autoBtn)
    self:removeCustomClickListener(self._autoHideBtn)
    self:removeCustomClickListener(self._autoCancelBtn)
    self:removeCustomClickListener(self._autoOkBtn)
    self._editBtn = nil
    self._skillSetBtn = nil
    self._addBtn = nil
    self._removeBtn = nil
    self._hideBtn = nil
    self._cancelBtn = nil
    self._okBtn = nil
    self._defaultBtn = nil
    self._shadow = nil
    self._btnAddScale = nil
    self._btnSubScale = nil
    self._touchTipBtn = nil
    self._removeTouchTipsBtn = nil
    self._autoBtn = nil
    self._autoHideBtn = nil
    self._autoCancelBtn = nil
    self._autoOkBtn = nil

    if self._scaleSlider then
        self._scaleSlider:removeEventListener(fgui.UIEventType.Changed)
        self._scaleSlider = nil
    end

    if self._skillItemGroups then
        for k, v in pairs(self._skillItemGroups) do
            v:removeClickListener()
        end
        self._skillItemGroups = nil
    end

    if self._autoSkillItemGroups then
        for k, v in pairs(self._autoSkillItemGroups) do
            v:removeClickListener()
        end
        self._autoSkillItemGroups = nil
    end


    self._openIndex = nil
    self._isOpenCheckChange = nil
    self._isChanged = nil

    self._skillList = nil
    self._compSkill = nil
    self._skillSetBtn = nil

    self._btnText = nil
    self._scaleSlider = nil

    self._scaleText = nil

    self._openController = nil
    self._skillTips = nil
    self._shadow = nil
    self._autoHideBtn = nil
    self._autoSkillList = nil
    CompSkillEdit.super.onClear(self)
end

function CompSkillEdit:onEnter()
    self._editData = SkillModule:getEditConf()
    self:refreshUI()
    
    self._editBtn:addClickListener(handler(self, self.editBtnClick));
    self._skillSetBtn:addClickListener(handler(self, self.skillSetBtnClick));
    self._addBtn:addClickListener(handler(self, self.addBtnClick));
    self._removeBtn:addClickListener(handler(self, self.removeBtnClick));
    self._hideBtn:addClickListener(handler(self, self.hideBtnClick));
    self._cancelBtn:addClickListener(handler(self, self.cancelBtnClick));
    self._okBtn:addClickListener(handler(self, self.okBtnClick));
    self._defaultBtn:addClickListener(handler(self, self.defaultBtnClick));
    self._shadow:addClickListener(handler(self, self.shadowClick));
    self._btnAddScale:addClickListener(handler(self, self.btnAddScaleClick));
    self._btnSubScale:addClickListener(handler(self, self.btnSubScaleClick));
    self._touchTipBtn:addClickListener(handler(self, self.touchTipBtnClick));
    self._removeTouchTipsBtn:addClickListener(handler(self, self.removeTouchTipsBtnClick));
    self._autoBtn:addClickListener(handler(self, self.autoBtnClick));
    self._autoHideBtn:addClickListener(handler(self, self.autoHideBtnClick));
    self._autoCancelBtn:addClickListener(handler(self, self.cancelBtnClick));
    self._autoOkBtn:addClickListener(handler(self, self.autoOkBtnClick));
    self._scaleSlider:addEventListener(fgui.UIEventType.Changed, handler(self, self.scaleEvent));
   
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CHECK_GUIDE_EVENT, handler(self, self.checkGuide), "CompSkillEdit:checkGuide")

    self:checkGuide()
end

function CompSkillEdit:onExit()

    NtfManager:removeNtfListenerByTag("CompSkillEdit:checkGuide")
    self:removeCustomClickListener(self._editBtn)
    self:removeCustomClickListener(self._skillSetBtn)
    self:removeCustomClickListener(self._addBtn)
    self:removeCustomClickListener(self._removeBtn)
    self:removeCustomClickListener(self._hideBtn)
    self:removeCustomClickListener(self._cancelBtn)
    self:removeCustomClickListener(self._okBtn)
    self:removeCustomClickListener(self._defaultBtn)
    self:removeCustomClickListener(self._shadow)
    self:removeCustomClickListener(self._btnAddScale)
    self:removeCustomClickListener(self._btnSubScale)
    self:removeCustomClickListener(self._touchTipBtn)
    self:removeCustomClickListener(self._removeTouchTipsBtn)
    self:removeCustomClickListener(self._autoBtn)
    self:removeCustomClickListener(self._autoHideBtn)
    self:removeCustomClickListener(self._autoCancelBtn)
    self:removeCustomClickListener(self._autoOkBtn)
    if self._scaleSlider then
        self._scaleSlider:removeEventListener(fgui.UIEventType.Changed)
    end

    if self._skillItemGroups then
        for k, v in pairs(self._skillItemGroups) do
            v:removeClickListener()
        end
        self._skillItemGroups = nil
    end

    if self._autoSkillItemGroups then
        for k, v in pairs(self._autoSkillItemGroups) do
            v:removeClickListener()
        end
        self._autoSkillItemGroups = nil
    end
end

function CompSkillEdit:onUpdate(dt)
    if self._isOpenCheckChange then
        if self._isChanged == false then
            self._isChanged = SkillModule:checkChange()
        else
            self._okBtn:getChild("redPoint"):setVisible(true)
            self._autoOkBtn:getChild("redPoint"):setVisible(true)
            self._isOpenCheckChange = false
        end
    end
end

---------------------------btn click start ----------------------------
function CompSkillEdit:cancelBtnClick()
    local closeFunc = function()
        SkillModule:setEditConf(nil)
        SkillModule:getEditConf()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_CLOSE_SKILL_EDIT)
       
    end
    if not SkillModule:checkChange() then
        closeFunc()
        return 
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {content = GReadText.KEY_EDIT_SKILL_CANEL, confirmCallback = function()
        closeFunc()
    end})
end

function CompSkillEdit:okBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {content = GReadText.KEY_EDIT_SKILL_SAVE, confirmCallback = function()
        SkillModule:saveEditConf()
        self._okBtn:getChild("redPoint"):setVisible(false)
        self._autoOkBtn:getChild("redPoint"):setVisible(false)
        fgui.GTween:to(1, 0, 0.5):onComplete(function()
            self._isOpenCheckChange = true
            self._isChanged = false
        end)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_EDIT_SKILL_SAVE_TIPS})
    end})
end

function CompSkillEdit:skillSetBtnClick()
    self._compSkill:setOpMode(Operate.Edit_Normal)
    self._compSkill:setDrag(false)
    self._compSkill:setLight(false)
    self._openIndex = 0
    self._compSkill:setSelectTagShow(false)
    self._compSkill:clearOperateBtn()
    self._compSkill:showAutoFightUi(false)
    self:setHideBtnState(0)
    self:refreshEditUI()
    self:setOpenControl(0)
    self._editBtn:setSortingOrder(PRE_ZORDER)
    self._skillSetBtn:setSortingOrder(AFTER_ZORDER)
    self._skillTips:setVisible(false)
    if self._autoSkillItemGroups and self.selectSkillId and self._autoSkillItemGroups[self.selectSkillId] then
        self._autoSkillItemGroups[self.selectSkillId]:setSelected(false)
        self.selectSkillId = nil
    end
end

function CompSkillEdit:editBtnClick()
    self._compSkill:setOpMode(Operate.Edit_Pos)
    self._compSkill:setDrag(true)
    self._compSkill:setLight(false)
    self._compSkill:showAutoFightUi(false)
    self:refreshEditBtnTouch()
    self:setHideBtnState(0)
    self:setOpenControl(1)
    self._openIndex = 1
    self._editBtn:setSortingOrder(AFTER_ZORDER)
    self._skillSetBtn:setSortingOrder(PRE_ZORDER)
end

function CompSkillEdit:addBtnClick()
    local conf = SkillModule:getEditConf()
    for index = 20, 29 do
        if not conf[index].isAdd then
            local addIndex = index
            self._compSkill:addBtn(addIndex)
            return 
        end
    end
end

function CompSkillEdit:removeBtnClick()
    local removeSkillId = self._compSkill:getRemoveSkillId()
    self._compSkill:removeBtn()
    if removeSkillId and removeSkillId ~= "nil" then
        if self._compSkill:getOpMode() == Operate.Edit_Set then
            self._skillItemGroups[removeSkillId]:setItemInfo(removeSkillId, false)
        elseif self._compSkill:getOpMode() == Operate.Auto_Set then
            self._autoSkillItemGroups[removeSkillId]:setItemInfo(removeSkillId, false)
        end
    end
    self:refreshEditUI()
    fgui.GTween:to(1, 0, 1):onComplete(function()
        local isCanMove = self._compSkill:canRemove()
        self._removeBtn:getController("button"):setSelectedIndex(isCanMove == false and 2 or 0)
    end)
end

function CompSkillEdit:hideBtnClick()
    local curIndex = self._openController:getSelectedIndex()
    self._openController:setSelectedIndex(curIndex == 2 and self._openIndex or 2)
    
    self:refreshLeftUIOffset(Constant.SETTINGS_TYPES.LEFT_OFFSET)
end

function CompSkillEdit:defaultBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {content = GReadText.KEY_SKILL_EDIT_DEFAULT, confirmCallback = function()
        SkillModule:setDefaultConf()
        self._compSkill:refreshSlot()
        for skillId, itembox in pairs(self._skillItemGroups) do
            local isEquip, posEquip = self:isEquipBySkillId(skillId)
            itembox:setEquip(isEquip)
        end
        for skillId, itembox in pairs(self._autoSkillItemGroups) do
            local isEquip, posEquip = self:isEquipBySkillId(skillId)
            itembox:setEquip(isEquip)
        end
        self._compSkill:clearOperateBtn()
        self:refreshEditUI()
    end})
end

function CompSkillEdit:scaleEvent(context)
    local value = self._scaleSlider:getValue()
    local realValue = value + 50 
    self._scaleText:setText(math.floor(realValue + 0.5).."%")
    self._compSkill:startScale(realValue / 100)
end

function CompSkillEdit:touchTipBtnClick()
    local isTouch = self._compSkill:isExistOperateBtn()
    if not isTouch then
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_EDIT_NOT_SELECT})
        return 
    end 
end

function CompSkillEdit:removeTouchTipsBtnClick()
    local isTouch = self._compSkill:isExistOperateBtn()
    if not isTouch then
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_EDIT_NOT_SELECT})
        return 
    end

    local isCanMove = self._compSkill:canRemove()
    if not isCanMove then
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_EIDT_NOT_DELETE})
        return 
    end
end

function CompSkillEdit:shadowClick()
    if self._compSkill:getOpMode() == Operate.Edit_Set then
        self._compSkill:setOpMode(Operate.Edit_Normal)
        self._compSkill:setLight(false)
        self._skillTips:setVisible(false)
        self._skillItemGroups[self.selectSkillId]:getController("button"):setSelectedIndex(0)
    elseif self._compSkill:getOpMode() == Operate.Auto_Set then
        self._compSkill:setOpMode(Operate.Auto_Normal)
        self._compSkill:setLight(false)
        self._skillTips:setVisible(false)
        self._autoSkillItemGroups[self.selectSkillId]:getController("button"):setSelectedIndex(0)
    end
end

function CompSkillEdit:btnSubScaleClick()
    local value = self._scaleSlider:getValue()
    local addValue = value - 1
    if addValue < 0 then addValue = 0 end
    self._scaleSlider:setValue(addValue)
    local realValue = addValue + 50 
    self._scaleText:setText(math.floor(realValue + 0.5).."%")
    self._compSkill:startScale(realValue / 100)
end

function CompSkillEdit:btnAddScaleClick()
    local value = self._scaleSlider:getValue()
    local addValue = value + 1
    if addValue > 100 then addValue = 100 end
    self._scaleSlider:setValue(addValue)
    local realValue = addValue + 50 
    self._scaleText:setText(math.floor(realValue + 0.5).."%")
    self._compSkill:startScale(realValue / 100)
end
