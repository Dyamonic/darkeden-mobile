            GuideModule:triggerGuide(Constant.GUIDE_ID.SKILL_EDIT6, bgSmall, pos)
            return
        end 
    end
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.SKILL_EDIT7) then
        if self._compSkill:getOpMode() == Operate.Edit_Pos then
            local bg = self:getChild("bg")
            local pos = self:displayObject():convertToWorldSpace(bg:getPosition())
            pos = cc.p(pos.x, pos.y)
            GuideModule:triggerGuide(Constant.GUIDE_ID.SKILL_EDIT7, bg, pos)
