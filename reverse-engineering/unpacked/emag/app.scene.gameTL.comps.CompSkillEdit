    self._openController:setSelectedIndex(curIndex == 4 and 3 or 4)
    
    self:refreshLeftUIOffset(Constant.SETTINGS_TYPES.LEFT_OFFSET)
end

function CompSkillEdit:setAutoHideBtnState(state)
    self._autoHideBtn:getController("button"):setSelectedIndex(state)
end

function CompSkillEdit:autoBtnClick()
    self._compSkill:setOpMode(Operate.Auto_Normal)
    self._compSkill:setLight(false)
    self._compSkill:setDrag(false)
    self._openIndex = 0
    self._compSkill:setSelectTagShow(false)
    self._compSkill:clearOperateBtn()
    self._compSkill:showAutoFightUi(true)
    self._skillTips:setVisible(false)
    self:setAutoHideBtnState(0)
    self:refreshEditUI()
    self:setOpenControl(3)
    if self._skillItemGroups and self.selectSkillId then
        self._skillItemGroups[self.selectSkillId]:setSelected(false)
        self.selectSkillId = nil
    end
end

function CompSkillEdit:refreshAutoSkillList()
    if not self._autoSkillItemGroups then
        self._autoSkillItemGroups = {}
    end

    local skillSingleData, skillAreaData, skillBuffData, skillHealData = SkillModule:getAutoSkills()
    if #skillSingleData > 0 then
        local skillCell = self._autoSkillList:addItemFromPool()
        skillCell:getChild("label_title"):setText(GReadText.KEY_EDIT_SKILL_TIPS4)
        local skillList = skillCell:getChild("list_skill")
        skillList:setSize(622, 70*math.ceil(#skillSingleData/9))
        for k, v in ipairs(skillSingleData) do
            local itemBox = skillList:addItemFromPool()
            itemBox:insertObjectToFactory(self)
            local skillId = v
            local isEquip, posEquip = self:isEquipBySkillId(skillId, true)
