function CompSkillEdit:autoSkillBtnClick(skillId, itemBox)
    --被动不能装备
    local skillMeta = CacheManager:querySkillMeta(skillId) 
    if skillMeta:getPassiveSkill() == 0 then
        self._compSkill:setOpMode(Operate.Auto_Set)
    else
        self._compSkill:setOpMode(Operate.Auto_Normal)
    end
    --取消当前选中
    if self.selectSkillId then
        self._autoSkillItemGroups[self.selectSkillId]:getController("button"):setSelectedIndex(0)
    end
    self.selectSkillId = skillId
    local isEquip, posEquip = self:isEquipBySkillId(skillId, true)
    self._compSkill:setSelectSkillInfo(skillId, posEquip)
    self._compSkill:setLight(skillMeta:getPassiveSkill() == 0)
    self._skillTips:setVisible(true)
    self._skillTips:refreshContent(skillId)
    itemBox:getController("button"):setSelectedIndex(1)
end

function CompSkillEdit:autoOkBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {content = GReadText.KEY_EDIT_SKILL_SAVE, confirmCallback = function()
        --更新自动挂机技能
        SkillModule:saveEditConf()
        self._okBtn:getChild("redPoint"):setVisible(false)
        self._autoOkBtn:getChild("redPoint"):setVisible(false)
        fgui.GTween:to(1, 0, 0.5):onComplete(function()
            self._isOpenCheckChange = true
            self._isChanged = false
        end)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_EDIT_SKILL_SAVE_TIPS})
    end})
end

function CompSkillEdit:checkGuide()
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.SKILL_EDIT3) then
        if self._compSkill:getOpMode() == Operate.Edit_Normal then
            local pos = self:displayObject():convertToWorldSpace(self._skillList:getPosition())
            pos = cc.p(pos.x, pos.y)
            GuideModule:triggerGuide(Constant.GUIDE_ID.SKILL_EDIT3, self._skillList, pos)
            return
        end 
    end
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.SKILL_EDIT4) then
        if self._compSkill:getOpMode() == Operate.Edit_Normal then
            local bgSmall = self._compSkill:getChild("node_autofight")
            local pos = self._compSkill:displayObject():convertToWorldSpace(bgSmall:getPosition())
            pos = cc.p(pos.x, pos.y)
            GuideModule:triggerGuide(Constant.GUIDE_ID.SKILL_EDIT4, bgSmall, pos)
            return
        end 
    end
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.SKILL_EDIT5) then
        if self._compSkill:getOpMode() == Operate.Edit_Normal then
            local pos = self:displayObject():convertToWorldSpace(self._editBtn:getPosition())
            pos = cc.p(pos.x, pos.y)
            GuideModule:triggerGuide(Constant.GUIDE_ID.SKILL_EDIT5, self._editBtn, pos, function()
                self:editBtnClick()
            end)
            return
