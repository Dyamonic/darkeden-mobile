-- 合成界面
function UICompPetTame:refreshMergePanel(petInfo1,petInfo2)
    self._mergePetInfo1 = petInfo1
    self._mergePetInfo2 = petInfo2
    local petList = { [1] = petInfo1 or {}, [2] = petInfo2 or {} }
    for k,v in pairs(petList) do
        local petMeta = v.meta
        local petData = v.data
        -- 刷新属性
        local propertyt1 = self["_labelProperty1_" .. k]
        local propertyt2 = self["_labelProperty2_" .. k]
        local propertyt3 = self["_labelProperty3_" .. k]
        local propertyt1Str = GReadText.KEY_PET_TIPS3.."[color=#ffff00]"..GReadText.KEY_PET_TIPS2.."[/color]"
        local propertyt2Str = GReadText.KEY_PET_TIPS3.."[color=#ffff00]"..GReadText.KEY_PET_TIPS2.."[/color]"
        local propertyt3Str = ""

        -- 组合描述
        local compose = self["_labelCompose_" .. k]
        local composeStr = GReadText.KEY_PET_TIPS4.."[color=#00ff00]"..GReadText.KEY_PET_TIPS41.."[/color]"

        if petData then
            self["_mergePetActor" .. k]:setDirection(petMeta:getModleDir())
            self["_mergePetActor" .. k]:playAction(petData:getPetModel())
            self["_mergeModel" .. k]:setVisible(true)
            self["_petTips" .. k]:setVisible(false)

            if petData:getAttr1() > 0 then
                propertyt1Str = GReadText.KEY_PET_TIPS3.."[color=#ffff00]".. petData:getAttr1Str() .."[/color]"
            end
            if petData:getAttr2() > 0 then
                propertyt2Str = GReadText.KEY_PET_TIPS3.."[color=#ffff00]".. petData:getAttr2Str() .."[/color]"
            end
            if petData:getAttr3() > 0 then
                propertyt3Str = "[color=#ffff00]".. petData:getAttr3Str() .."[/color]"
            end

            if petData:getCompose() ~= "" then
                composeStr = GReadText.KEY_PET_TIPS4.."[color=#00ff00]"..petData:getComposeStr().."[/color]"
            end
        else
            self["_mergeModel" .. k]:setVisible(false)
            self["_petTips" .. k]:setVisible(true)
        end

        propertyt1:setText(propertyt1Str)
        propertyt2:setText(propertyt2Str)
        propertyt3:setText(propertyt3Str)
        compose:setText(composeStr)
    end

    local maxLevel = CacheManager:getPetMaxLevel()
    -- 主宠物tips
    local petTips = self._petTips1
    local petSynMain = CacheManager:getValueById(Constant.Variable.PetSynMain)
    petTips:setText(string.format(GReadText.KEY_PET_TIPS38,petSynMain,maxLevel))
    
    -- 材料宠物tips
    local petTips2 = self._petTips2
    local petSynSass = CacheManager:getValueById(Constant.Variable.PetSynSass)
    petTips2:setText(string.format(GReadText.KEY_PET_TIPS39,petSynSass,maxLevel))

    -- 组合属性显示
    local effectVisible = false
    if self._mergePetInfo1 and self._mergePetInfo2 then
        effectVisible = true

        -- 组合文字去材料宠物的第一条属性名，并根据第二个宠物的等级给出属性值范围
        local petData = self._mergePetInfo2.data
        local compose1 = self._compose1
        if petData and petData:getAttr1() > 0 then
            local attr1 = petData:getAttr1()
            local optionInfo = lt.CacheManager:getOptionInfoMeta(attr1)
            local petAttr = lt.CacheManager:getPetAttrByPetLevel(attr1,petData:getLevel())
            local value = ""
            if optionInfo and petAttr then
                value = optionInfo:getName() .. petAttr:getAttrLower() .. "-" .. petAttr:getAttrUp()
            end
            local composeStr = GReadText.KEY_PET_TIPS4.."[color=#00ff00]".. value .."[/color]"
            compose1:setText(composeStr)
        end
    end
    self._effectBg:setVisible(effectVisible)
    
    local btnMerge = self._btnMerge -- 合成按钮
    local btnReset = self._btnReset -- 重置按钮
    if self._mergePetInfo1 then
        local petData = self._mergePetInfo1.data
        local isCompose = petData:getCompose() ~= ""
        btnMerge:setVisible(not isCompose)
        btnReset:setVisible(isCompose)
        if isCompose then
            self._labelProperty1_2:setText("")
            self._labelProperty2_2:setText("")
            self._labelProperty3_2:setText("")
            self._labelCompose_2:setText("")
            self._petTips2:setText(GReadText.KEY_PET_TIPS52)
        end
    else
        btnMerge:setVisible(true)
        btnReset:setVisible(false)
    end

    self:refreshMergePanelCost()

    if PetModule:getPetComposeState() == Constant.PETCOMPOSE.SUCCESS then
        if not self._petComposeSpine then
            self._petComposeSpine = lt.SkeletonManager:createSkeletonEffectWithFile("ChongWuHeCheng", "ChongWuHeCheng_Skeleton")
            self:displayObject():addChild(self._petComposeSpine,99)
            self._petComposeSpine:setPosition(130,200)
            self._petComposeSpine:setCallback(handler(self, self.spineAnimationEnd))
        end
        self._petComposeSpine:setVisible(true)
        self._petComposeSpine:setAnimation(0, "ChongWuHeCheng", false)

        PetModule:clearPetComposeState()
    end
end

function UICompPetTame:refreshMergePanelCost()
    local itemId = MERGECOST
    if self._mergePetInfo1 then
        local petData = self._mergePetInfo1.data
        local isCompose = petData:getCompose() ~= ""
        if isCompose then
            itemId = RESETCOST
        end
    end
    local itemMeta = CacheManager:getItemMeta(itemId)
    if itemMeta then
        local itemNum = ItemModule:getItemNum(itemId)
        local itemIcon = self._petItemIcon
        local path = string.format(_GURL.GetImageItem, itemMeta:getIconId())
        yflog:Info("path---->>>>> %s",path)
        itemIcon:setURL(path)
        
        self._mergeItemNum:setText(itemNum .. "/1")
        if itemNum < 1 then
            self._mergeItemNum:setColor(Constant.COLOR_TEXT_RED)
        else
            self._mergeItemNum:setColor(Constant.COLOR_GREEN)
        end

        self._mergeItemName:setText(itemMeta:getName())
    end
end

function UICompPetTame:onMergeTouchCallBack()
    yflog:Info("onMergeTouchCallBack")
    local itemId = MERGECOST
    local itemMeta = CacheManager:getItemMeta(itemId)
    if not itemMeta then
        return
    end
    
    if not self._mergePetInfo1 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS46})
        return
    end
    if not self._mergePetInfo2 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS47})
        return
    end
    
    local isEnough = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, itemId, 1, {tips = true})
    if isEnough then
        PetModule:sendPetCompose(self._mergePetInfo1.data:getUid(), self._mergePetInfo2.data:getUid())
    end
end

function UICompPetTame:onResetTouchCallBack()
    yflog:Info("onResetTouchCallBack")
    local itemId = RESETCOST
    local itemMeta = CacheManager:getItemMeta(itemId)
    if not itemMeta then
        return
    end
    
    if not self._mergePetInfo1 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS46})
        return
    end
    
    local isEnough = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, itemId, 1, {tips = true})
    if isEnough then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
            content = GReadText.KEY_PET_TIPS85,
            confirmCallback = function()
                PetModule:sendPetCompose(self._mergePetInfo1.data:getUid(), 0)
            end,
        })
    end
end

function UICompPetTame:showTips()
    local attrCost = ATTRCOST[self._attrSelectIndex]
    if not attrCost then
        return
    end
    local itemId = attrCost[1]
    if self._attrSelectIndex == ATTRINDEX.ATTR2 and self._isMaxRedBird then
        itemId = attrCost[2]
    end
    local itemMeta = CacheManager:getItemMeta(itemId)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemMeta, tipsType = Constant.PROPTIPS_FORM.Display})
end

function UICompPetTame:showPetItemTips()
    local itemId = MERGECOST
    if self._mergePetInfo1 then
        local petData = self._mergePetInfo1.data
        local isCompose = petData:getCompose() ~= ""
        if isCompose then
            itemId = RESETCOST
        end
    end
    local itemMeta = CacheManager:getItemMeta(itemId)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemMeta, tipsType = Constant.PROPTIPS_FORM.Display})
end
