function UICompPetTame:refreshAttrPanel(petInfo)
    if self._petComposeSpine then
        self._petComposeSpine:setVisible(false)
    end

    if not petInfo then
        self._comTam:setVisible(false)
        return
    end
    self._comTam:setVisible(true)

    self._petInfo = petInfo

    local petMeta = petInfo.meta
    local petData = petInfo.data
    if petData then
        self._petActor1:setDirection(petMeta:getModleDir())
        self._petActor1:playAction(petData:getPetModel())
    end

    -- 默认选中第一个
    if not self._attrSelectIndex then
        self._attrSelectIndex = 1
    end

    self._attrMaxList = {}
    self._isMaxRedBird = false
    for i = 1, #attrItemNameCfg do
        local bgMaxAttr =  self._attrItemMaxAttr[i]
        local maxVisible = false
        local maxAttrValue = ""
        if petData then
            local attrValueText = self._attrItemValueAttr[i]
            local petLevel = petData:getLevel()
            local variableId = Constant.Variable[attrItemNameCfg[i].variableId]
            local curValue   = CacheManager:getValueById(variableId)
            local attrValue  = petData[attrItemNameCfg[i].attrValue](petData)

            ------------------------------------------------------------------------------------------
            -- 计算最大值
            if i == ATTRINDEX.ATTR3 then
                local itemId = ATTRCOST[ATTRINDEX.ATTR3][1]
                local itemMeta = CacheManager:getItemMeta(itemId)
                local effectParam = (itemMeta:getEffectParam() or {})[1] or {}
                local maxValue = effectParam[3] or 0
                maxVisible = maxValue == attrValue -- 黄色视野水滴  EffectParam [["Vis",35,5000]]
                maxAttrValue = maxValue
            elseif i == ATTRINDEX.ATTR2 then
                if attrValue > 0 then
                    local petRaise1Meta = CacheManager:getPetRaiseById(attrValue)
                    local probability2 = petRaise1Meta:getProbability2()
                    if probability2 and probability2 > 0 then
                        maxVisible = true
                        self._isMaxRedBird = true
                    end

                    local petRaise1MaxMeta = CacheManager:getPetRaiseById(petRaise1Meta:getType())
                    local attrMeta = lt.CacheManager:getAttributeMetaByOptionId(petRaise1MaxMeta:getAttributeId())
                    maxAttrValue = attrMeta:getPlusPoint()
                end
            elseif i == ATTRINDEX.ATTR1 then
                -- local attr1 = petData:getAttr1()
                -- local petLevelMap = CacheManager:getAllPetLevelMap()
                -- local petAttrCfg = CacheManager:getPetAttrCfg(attr1)
                -- local maxLvl = #petLevelMap - 1
                -- local petAttr= petAttrCfg[maxLvl]
                -- if petAttr then
                --     maxAttrValue = petAttr:getAccumAttr()
                -- end
                maxAttrValue = ""
            end
            ------------------------------------------------------------------------------------------

            if petLevel < curValue then
                local petLevelLimitStr = string.format(GReadText.KEY_PET_TIPS40,curValue)
                attrValueText:setText(petLevelLimitStr)
            else
                if attrValue == 0 then
                    attrValueText:setText(GReadText.KEY_PET_TIPS44)
                else
                    local functionName = attrItemNameCfg[i].attrStr
                    local attrAtr = petData[functionName](petData)
                    local maxStr = string.format(GReadText.KEY_PET_TIPS67,maxAttrValue)
                    if maxAttrValue == "" then
                        maxStr = ""
                    end
                    attrValueText:setText(attrAtr .. maxStr)
                end
            end
        end
        self._attrMaxList[i] = {maxVisible = maxVisible, maxAttrValue = maxAttrValue }

        bgMaxAttr:setVisible(maxVisible)
    end

    self:refreshAttrPanelCost()
    self:refreshAttrPanelSelect()
end

function UICompPetTame:refreshAttrPanelSelect()
    for i = 1, 3 do
        local selectAttr = self._selectAttr[i]
        selectAttr:setVisible(self._attrSelectIndex == i)
    end
end

function UICompPetTame:onTouchCallBack(obj)
    local target = obj:getSender()
    local index = target.index
    yflog:Info("self._attrSelectIndex --->>> %s",index)
    self._attrSelectIndex = index

    self:refreshAttrPanelCost()
    self:refreshAttrPanelSelect()
end

function UICompPetTame:onTameTouchCallBack()
    yflog:Info("onTameTouchCallBack")
    local attrCost = ATTRCOST[self._attrSelectIndex]
    if not attrCost then
        return
    end

    local itemId = attrCost[1]
    if self._attrSelectIndex == ATTRINDEX.ATTR2 and self._isMaxRedBird then
        itemId = attrCost[2]
    end
    local itemMeta = CacheManager:getItemMeta(itemId)
    if not itemMeta then
        return
    end

    if not self._petInfo then
        return
    end

    local petData = self._petInfo.data
    if not petData then
        return
    end

    if PetModule:getSendPetRaiseLimit() then -- 防止频繁点击
        return
    end
    
    local petLevel = petData:getLevel()
    local variableId = Constant.Variable["PetAttr" .. self._attrSelectIndex .. "UnlockLevel"]
    local curValue   = CacheManager:getValueById(variableId)
    if petLevel < curValue then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = string.format(GReadText.KEY_PET_TIPS45,curValue)})
        return
    end
    
    local isEnough = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, itemId, 1, {tips = true})
    yflog:Info("----->>>>>> %s %s %s",self._petInfo.data:getUid(), self._attrSelectIndex, itemId)
    if isEnough then
        if self._isMaxRedBird and self._attrSelectIndex == ATTRINDEX.ATTR2 then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
                content = GReadText.KEY_PET_TIPS71,
                confirmCallback = function()
                    PetModule:sendPetRaise(self._petInfo.data:getUid(), self._attrSelectIndex)
                end,
            })
        else
            PetModule:sendPetRaise(self._petInfo.data:getUid(), self._attrSelectIndex)
        end
    end
end

function UICompPetTame:refreshCost()
    if self:isMerge() then 
        self:refreshMergePanelCost()
    else
        self:refreshAttrPanelCost()
    end
end

function UICompPetTame:refreshAttrPanelCost()
    local itemIcon = self._itemIcon
    local attrItemNum = self._attrItemNum
    local attrItemBg  = self._attrItemBg
    local btnTame = self._btnTame
    local max     = self._maxImage
    local isVisible = true
    local attrMax = self._attrMaxList[self._attrSelectIndex]
    if self._attrSelectIndex == ATTRINDEX.ATTR3 and attrMax and attrMax.maxVisible then -- 属性3到最高级不显示消耗和按钮
        isVisible = false
    end
    itemIcon:setVisible(isVisible)
    attrItemNum:setVisible(isVisible)
    attrItemBg:setVisible(isVisible)
    btnTame:setVisible(isVisible)
    max:setVisible(not isVisible)

    local attrCost = ATTRCOST[self._attrSelectIndex]
    if not attrCost then
        return
    end

    local itemId = attrCost[1]
    if self._attrSelectIndex == ATTRINDEX.ATTR2 and self._isMaxRedBird then
        itemId = attrCost[2]
    end
    local itemMeta = CacheManager:getItemMeta(itemId)
    if itemMeta then
        local itemNum = ItemModule:getItemNum(itemId)
        local path = string.format(_GURL.GetImageItem, itemMeta:getIconId())
        itemIcon:setURL(path)
        
        attrItemNum:setText(itemNum .. "/1")
        if itemNum < 1 then
            attrItemNum:setColor(Constant.COLOR_TEXT_RED)
        else
            attrItemNum:setColor(Constant.COLOR_GREEN)
        end
    end
end
