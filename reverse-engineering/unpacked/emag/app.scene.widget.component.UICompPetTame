end

function UICompPetTame:onConstruct()
    self._btnTameState  = self:getChild("btn_tame_state")
    self._btnMergeState = self:getChild("btn_merge_state")
    self._btnTame       = self:getChild("btn_tame")
    self._btnMerge      = self:getChild("btn_merge")
    self._btnReset      = self:getChild("btn_reset")
    self._itemIcon      = self:getChild("attr_item_icon")
    self._petItemIcon   = self:getChild("pet_item_icon")
    self._comTam        = self:getChild("com_tame")
    self._mergeItemName = self:getChild("label_item_name")
    self._mergeItemNum  = self:getChild("pet_item_num")
    self._effectBg      = self:getChild("effect_bg")
    self._compose1      = self:getChild("label_compose_1")
    self._petTips1      = self:getChild("pet_tips1")
    self._petTips2      = self:getChild("pet_tips2")
    self._attrItemNum   = self:getChild("attr_item_num")
    self._attrItemBg    = self:getChild("attr_item_bg")
    self._maxImage      = self:getChild("max")
    self._labelProperty1_1 = self:getChild("label_propertyt1_1")
    self._labelProperty2_1 = self:getChild("label_propertyt2_1")
    self._labelProperty3_1 = self:getChild("label_propertyt3_1")
    self._labelCompose_1   = self:getChild("label_compose_1")
    self._labelProperty1_2 = self:getChild("label_propertyt1_2")
    self._labelProperty2_2 = self:getChild("label_propertyt2_2")
    self._labelProperty3_2 = self:getChild("label_propertyt3_2")
    self._labelCompose_2   = self:getChild("label_compose_2")

    self._bgAttrList = {}
    for i = 1, 3 do
        local bgAttr = self:getChild(BGATTR[i])
        self._bgAttrList[i] = bgAttr
    end

    self._selectAttr = {}
    for i = 1, 3 do
        local selectAttr = self:getChild("select_attr" .. i)
        self._selectAttr[i] = selectAttr
    end

    self._attrItemMaxAttr = {}
    self._attrItemValueAttr = {}
    for i = 1, #attrItemNameCfg do
        local bgMaxAttr = self:getChild(attrItemNameCfg[i].maxAttr)
        self._attrItemMaxAttr[i] = bgMaxAttr
        local attrValueText = self:getChild(attrItemNameCfg[i].valueAttr)
        self._attrItemValueAttr[i] = attrValueText
    end
    
    self._modelNode   = self:getChild("node_model")
    self._mergeModel1 = self:getChild("node_merge_model1")
    self._mergeModel2 = self:getChild("node_merge_model2")

    self:startSkin()
    self:initUI()
end

function UICompPetTame:setParentPanel(parent)
    self._parentPanel = parent
end

function UICompPetTame:onEnter()
    UICompPetTame.super.onEnter(self)
    NtfManager:addNtfListener(NtfManager.NTF.NTF_PET_TAME_ATTR_REFRESH, handler(self, self.petTameAttrRefresh), "UICompPetTame:NTF_PET_TAME_ATTR_REFRESH")

    self._btnTameState:addClickListener(handler(self, self.onChangeFuncCallBack))
    self._btnMergeState:addClickListener(handler(self, self.onChangeFuncCallBack))

    for i = 1, 3 do
        local bgAttr = self._bgAttrList[i]
        bgAttr.index = i
        bgAttr:addClickListener(handler(self, self.onTouchCallBack))
    end

    self._btnTame:addClickListener(handler(self, self.onTameTouchCallBack))
    self._btnMerge:addClickListener(handler(self, self.onMergeTouchCallBack))
    self._btnReset:addClickListener(handler(self, self.onResetTouchCallBack))
    self._itemIcon:addClickListener(handler(self, self.showTips))
    self._petItemIcon:addClickListener(handler(self, self.showPetItemTips))

    PetModule:clearSendPetRaiseLimit()
end

function UICompPetTame:onExit()
    UICompPetTame.super.onExit(self)
    NtfManager:removeNtfListenerByTag("UICompPetTame:NTF_PET_TAME_ATTR_REFRESH")

    self._btnTameState:addClickListener(handler(self, self.onChangeFuncCallBack))
    self._btnMergeState:addClickListener(handler(self, self.onChangeFuncCallBack))

    for i = 1, 3 do
        local bgAttr = self._bgAttrList[i]
        bgAttr.index = nil
        bgAttr:removeClickListener()
    end

    self._btnTame:removeClickListener()
    self._btnMerge:removeClickListener()
    self._btnReset:removeClickListener()
    self._itemIcon:removeClickListener()
    self._petItemIcon:removeClickListener()
end

function UICompPetTame:onUpdate(dt)
    if self._petActor1 then
        self._petActor1:onUpdate(dt)
    end
    
    if self._mergePetActor1 then
        self._mergePetActor1:onUpdate(dt)
    end

    if self._mergePetActor2 then
        self._mergePetActor2:onUpdate(dt)
    end
end

function UICompPetTame:initUI()
    self._selectController = self:getController("btnSelect")

    -- 属性
    self._petActor1 = PetUIActor.new(2)
    self._modelNode:displayObject():addChild(self._petActor1)
    
    -- 合成
    self._mergePetActor1 = PetUIActor.new(2)
    self._mergeModel1:displayObject():addChild(self._mergePetActor1)

    self._mergePetActor2 = PetUIActor.new(2)
    self._mergeModel2:displayObject():addChild(self._mergePetActor2)
end

function UICompPetTame:onChangeFuncCallBack()
    self._parentPanel:refreshListData() -- 属性合成切换
    self._parentPanel:refreshList()
    self._parentPanel:showCurPanel()
    self._parentPanel:refreshFilterBtn()
end

