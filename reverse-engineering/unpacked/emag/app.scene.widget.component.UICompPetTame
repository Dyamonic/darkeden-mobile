function UICompPetTame:ctor()
    self._selectController = nil
    self._parentPanel      = nil

    -- 属性
    self._modelNode        = nil
    self._petActor1        = nil
    self._attrSelectIndex  = nil
    self._petInfo          = nil
    self._isMaxRedBird     = nil
    self._spineTameList    = nil

    -- 合成
    self._mergeModel1      = nil
    self._mergeModel2      = nil
    self._mergePetActor1   = nil
    self._mergePetActor2   = nil
    self._attrMaxList      = nil
    self._petComposeSpine  = nil

    UICompPetTame.super.ctor(self)
end

function UICompPetTame:onClear()
