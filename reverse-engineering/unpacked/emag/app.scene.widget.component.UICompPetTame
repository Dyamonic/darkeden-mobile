        self._petActor1:onClear()
        self._petActor1   = nil
    end
    self._mergePetActor1:onClear()
    self._mergePetActor2:onClear()

    self._selectController = nil
    self._parentPanel      = nil

    -- 属性
    self._modelNode        = nil
    self._attrSelectIndex  = nil
    self._petInfo          = nil
    self._isMaxRedBird     = nil
    self._spineTameList    = nil
    
    -- 合成
    self._mergeModel1      = nil
    self._mergeModel2      = nil
    self._mergePetActor1   = nil
    self._mergePetActor2   = nil
    self._mergePetInfo1    = nil
    self._mergePetInfo2    = nil
    self._attrMaxList      = nil
    self._petComposeSpine  = nil

    self._btnTameState  = nil
    self._btnMergeState = nil
    self._btnTame       = nil
    self._btnMerge      = nil
    self._btnReset      = nil
    self._itemIcon      = nil
    self._petItemIcon   = nil
    self._comTam        = nil
    self._mergeItemName = nil
    self._mergeItemNum  = nil
    self._effectBg      = nil
    self._compose1      = nil
    self._petTips1      = nil
    self._petTips2      = nil
    self._attrItemNum   = nil
    self._attrItemBg    = nil
    self._maxImage      = nil
    self._labelProperty1_1 = nil
    self._labelProperty2_1 = nil
    self._labelProperty3_1 = nil
    self._labelCompose_1   = nil
    self._labelProperty1_2 = nil
    self._labelProperty2_2 = nil
    self._labelProperty3_2 = nil
    self._labelCompose_2   = nil
    self._bgAttrList = nil
    self._selectAttr = nil
    self._attrItemMaxAttr = nil
    self._attrItemValueAttr = nil
