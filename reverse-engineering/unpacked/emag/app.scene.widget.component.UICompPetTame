function UICompPetTame:isMerge()
    return self._selectController:getSelectedIndex() == SELECTTYPE.MERGE
end

function UICompPetTame:petTameAttrRefresh()
    if not self._attrSelectIndex then
        return
    end

    if not self._spineTameList then
        self._spineTameList = {}
    end
    
    if not self._spineTameList[self._attrSelectIndex] then
        local selectAttr = self._selectAttr[self._attrSelectIndex]
        local spine = SkeletonManager:createSkeletonEffectWithFile("ShengJiXiTong", "ShengJiXiTong_Skeleton")
        spine:setCallback(handler(self, self.spineAttrEnd))
        selectAttr:displayObject():addChild(spine)
        spine:setScaleX(0.85)
        spine:setPosition(145,20)
        spine:setAnimationScale(2)
        self._spineTameList[self._attrSelectIndex] = spine
    end
    
    local spine = self._spineTameList[self._attrSelectIndex]
    if spine then
        spine:setAnimation(0, "ShengJiPanDuan2", false)
    end
end

function UICompPetTame:spineAnimationEnd(event)
    if event.type == "complete" then
        self._petComposeSpine:setVisible(false)
    end
end

function UICompPetTame:spineAttrEnd(event)
    if event.type == "complete" then
        PetModule:clearSendPetRaiseLimit()
    end
end

return UICompPetTame