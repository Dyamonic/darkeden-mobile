local MessageFormatDao = {}

function MessageFormatDao:queryAll()
    local msgFmtTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM MessageFormat") do
        local meta = lt.MessageFormatMeta.new(row)
        msgFmtTable[meta:getType()] = meta
    end
    return msgFmtTable
end

return MessageFormatDao