---@创建队伍
---@class UICompTeamCreate
local UICompTeamCreate = class("UICompTeamCreate", lt.UICompBase, lt.UICompChangeSkin)

UICompTeamCreate.ChangeSkinConf = {
    ["MessageBox"] = {
        ["img_bg"] = "bg_tytanchuang_03",
    },
    ["CommonTL"] = {
        ["btn_confirm"] = {bg = "sort"},
        ["btn_cancel"] = {bg = "sort"},
    }
}

local CacheManager = lt.CacheManager
local TeamModule = lt.TeamModule
local Constant = lt.Constant

function UICompTeamCreate:ctor()
    self:registerComponent("UICompTeamCreateCell")
    UICompTeamCreate.super.ctor(self)
    --UI
    self._mainIdxBtn1 = nil
    self._mainIdxBtn2 = nil
    self._confirmBtn = nil
    self._cancelBtn = nil
    self._mapList = nil
    self._selectImg1 = nil
    self._selectImg2 = nil
    self._touchLayer = nil
    --数据
    self._mainIdx = nil
    self._subIdx = nil
    self._hallTeamMeta = nil
    self._selectItem = nil
end

function UICompTeamCreate:onClear()
    --UI
    self._mainIdxBtn1 = nil
    self._mainIdxBtn2 = nil
    self._confirmBtn = nil
    self._cancelBtn = nil
    self._mapList = nil
    self._selectImg1 = nil
    self._selectImg2 = nil
    self._touchLayer = nil
    --数据
    self._mainIdx = nil
    self._subIdx = nil
    self._hallTeamMeta = nil
    self._selectItem = nil
    self:unregisterAllComponent()
    UICompTeamCreate.super.ctor(self)
end

function UICompTeamCreate:onConstruct()
    self:startSkin()
    self._mainIdxBtn1 = self:getChild("btn_mainIdx1")
    self._mainIdxBtn2 = self:getChild("btn_mainIdx2")
    self._confirmBtn = self:getChild("btn_confirm")
    self._cancelBtn = self:getChild("btn_cancel")
    self._mapList = self:getChild("list_map")
    self._mapList:setItemRenderer(handler(self, self.renderMapItem))
    self._selectImg1 = self:getChild("img_select1")
    self._selectImg2 = self:getChild("img_select2")
    self._touchLayer = self:getChild("touchLayer") -- 触摸关闭
    --初始化页签
    self._mainIdx = Constant.TEAMHALL_TYPES.LEVEL
    self._subIdx = TeamModule:getFilterLevelIdx()
end

function UICompTeamCreate:onEnter()
    UICompTeamCreate.super.onEnter(self)
    self._mainIdxBtn1:addClickListener(handler(self, function()
        self:onMainIdxBtnClick(Constant.TEAMHALL_TYPES.LEVEL)
    end))
    self._mainIdxBtn2:addClickListener(handler(self, function()
        self:onMainIdxBtnClick(Constant.TEAMHALL_TYPES.DUNGEON)
    end))
    self._confirmBtn:addClickListener(handler(self, self.onConfirmBtnClick))
    self._cancelBtn:addClickListener(handler(self, self.onCancelBtnClick))
    -- self._touchLayer:addClickListener(handler(self, self.onCancelBtnClick))
    self._mapList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
end
function UICompTeamCreate:onExit()
    self._mainIdxBtn1:removeClickListener()
    self._mainIdxBtn2:removeClickListener()
    self._confirmBtn:removeClickListener()
    self._cancelBtn:removeClickListener()
    -- self._touchLayer:removeClickListener()
    self._mapList:removeEventListener(fgui.UIEventType.ClickItem)
    UICompTeamCreate.super.onExit(self)
end

function UICompTeamCreate:initUI()
end

function UICompTeamCreate:refreshView()
    self._selectImg1:setVisible(self._mainIdx == Constant.TEAMHALL_TYPES.LEVEL)
    self._selectImg2:setVisible(self._mainIdx == Constant.TEAMHALL_TYPES.DUNGEON)
    self._hallTeamMeta = TeamModule:getHallTeamMeta(self._mainIdx)
    self._mapList:setNumItems(#self._hallTeamMeta)
    self._mapList:scrollToView(self._subIdx-1)
    self:refreshSelectView()
end

function UICompTeamCreate:onConfirmBtnClick()
    --创建队伍
    local meta = self._hallTeamMeta[self._subIdx]
    TeamModule:sendCreateTeam(meta:getIdxId())
    self:setVisible(false)
    -- self._mainIdx = Constant.TEAMHALL_TYPES.LEVEL
    -- self._subIdx = TeamModule:getFilterLevelIdx()
    -- self:refreshSelectView()
end

function UICompTeamCreate:onCancelBtnClick()
    self:setVisible(false)
    self._mainIdx = Constant.TEAMHALL_TYPES.LEVEL
    self._subIdx = TeamModule:getFilterLevelIdx()
    self:refreshSelectView()
end

function UICompTeamCreate:onMainIdxBtnClick(idx)
    self._mainIdx = idx
    if idx == Constant.TEAMHALL_TYPES.LEVEL then
        --默认符合自己的等级页签
        self._subIdx = TeamModule:getFilterLevelIdx()
    else
        self._subIdx = 1
    end
    self:refreshView()
end

function UICompTeamCreate:renderMapItem(index, obj)
    local meta = self._hallTeamMeta[index + 1]
    obj:setInfo(meta)
    obj.index = index + 1
end

function UICompTeamCreate:onClickItem(context)
    local data = context:getData()
    self._subIdx = data.index
    if self._selectItem then
        self._selectItem:setSelected(false)
    end
    self._selectItem = data
    self._selectItem:setSelected(true)
end

function UICompTeamCreate:refreshSelectView()
    if self._selectItem then
        self._selectItem:setSelected(false)
    end
    local childIndex = self._mapList:itemIndexToChildIndex(self._subIdx-1)
    self._selectItem = self._mapList:getChildAt(childIndex)
    self._selectItem:setSelected(true)
end

return UICompTeamCreate