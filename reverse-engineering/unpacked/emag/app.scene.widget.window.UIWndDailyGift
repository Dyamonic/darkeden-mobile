--- 菜单界面
---@class UIWndExit:UIWindowBase
local UIWndDailyGift          = class("UIWndDailyGift", lt.UIWindowBase)
local CacheManager = lt.CacheManager
local Constant = lt.Constant
local GameModule = lt.GameModule
local NtfManager = lt.NtfManager
local RechargeModule = lt.RechargeModule
local TimeCounter = lt.TimeCounter
local TimeCounterManager = lt.TimeCounterManager

function UIWndDailyGift:ctor(param)
    self:registerComponent("UICompDailyGiftRewardCell","UICompActivityItemCell","UICompDayDayChargeCell","UICompDayDayChargeItemCell","UICompItem")
    UIWndDailyGift.super.ctor(self, param)
end

function UIWndDailyGift:onClear()
    self._textTime = nil
    if self._listItem then
        self._listItem:removeChildrenToPool()
        self._listItem:removeItemRenderer()
        self._listItem = nil
    end

    if self._dayDayList then
        self._dayDayList:removeChildrenToPool()
        self._dayDayList:removeItemRenderer()
        self._dayDayList = nil
    end

    self._listCellData = nil
    self._activityArray = nil
    self:unregisterAllComponent()
    UIWndDailyGift.super.onClear(self)
end

function UIWndDailyGift:onInit()
    UIWndDailyGift.super.onInit(self, _GURL.UIWndDailyGift)
    self._textTime = self:getChild("lasttime")
    self._listItem = self:getChild("gift_list")
    self._listItem:setItemRenderer(handler(self, self.onCellRender))

    self._activityList = self:getChild("activity_list")
    self._activityList:setItemRenderer(handler(self, self.onActivityTitleRender))

    self._dayDayCharge = self:getChild("day_day_charge")
    self._dailtGift    = self:getChild("daily_gift")

    -- 天天充值
    self._goCharge   = self:getChild("go_charge")
    self._dayDayList = self:getChild("dayday_list")
    self._dayDayList:setItemRenderer(handler(self, self.onDayDayChargeRender))
    self._chargeDay = self:getChild("charge_day")
end

function UIWndDailyGift:onShown()
    -- 活动列表
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_CHARGE_ACTIVITY_LIST,handler(self, self.refreshActivityList), "UIWndDailyGift:refreshActivityList")
    self._activityList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickActivityBtn))
    self:initUI()

    -- 每日特惠
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CS_DAILY_GIFT_TIPS, handler(self, self.refreshDailyGiftTipsAndBtnRed), "UIWndDailyGift:refreshDailyGiftTipsAndBtnRed")

    -- 天天充值
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_DAY_DAY_RECHARGE, handler(self, self.refreshDayDayChargeInfoAndBtnRed), "UIWndDailyGift:refreshDayDayChargeInfo")
    self:addDayDayBtnClickListener()

    -- 倒计时
    local function updateFunction()
        self:updateTextTime()
    end
    TimeCounterManager:startTimeCounter(TimeCounterManager.TC.DAILY_GIFT_UPDATE, {callback = function()
        updateFunction()
    end })
end

function UIWndDailyGift:onHide()
    -- 活动列表
    NtfManager:removeNtfListenerByTag("UIWndDailyGift:refreshActivityList")
    self._activityList:removeEventListener(fgui.UIEventType.ClickItem)

    -- 每日特惠
    if self._listItem then
        self._listItem:removeChildrenToPool()
        self._listItem:removeItemRenderer()
        self._listItem = nil
    end
    NtfManager:removeNtfListenerByTag("UIWndDailyGift:refreshDailyGiftTipsAndBtnRed")

    -- 天天充值
    NtfManager:removeNtfListenerByTag("UIWndDailyGift:refreshDayDayChargeInfo")
    self:removeDayDayBtnClickListener()

    -- 倒计时
    TimeCounterManager:stopTimeCounter(TimeCounterManager.TC.DAILY_GIFT_UPDATE)

    UIWndDailyGift.super.onHide(self)
end

function UIWndDailyGift:onEnter()
    UIWndDailyGift.super.onEnter(self)
end

function UIWndDailyGift:onExit()
    UIWndDailyGift.super.onExit(self)
end

function UIWndDailyGift:updateTextTime()
    if self._curSelectActiviteType == Constant.ActivityType.DAILYGIFT then
        local lastTime = TimeCounter:getNowDayLastTime()
        local day, hour, minite,seconds= lt.CommonFunc:secondsToTime(lastTime)
        self._textTime:setText(GReadText.KEY_BUFF_TIPS1..string.format(GReadText.KEY_ACTIVITY_TIPS2,hour, minite,seconds))
    elseif self._curSelectActiviteType == Constant.ActivityType.DAYDAYCHARGE then
        local lastTime = RechargeModule:getDailyRechargeEndTime() - TimeCounter:serverTime()
        local str = TimeCounter:transformUnit(lastTime)
        if str == "" then
            str = GReadText.KEY_ACTIVITY_TIPS5
        end
        str = string.format("[color=#ffff00]%s[/color]", str)
        self._textTime:setText(GReadText.KEY_BUFF_TIPS1..str)
    else
        self._textTime:setText("")
    end
end

function UIWndDailyGift:initUI()
    self:refreshActivityList()
end

function UIWndDailyGift:onClickActivityBtn(context)
    local traget = context:getData()
    local curIndex = traget.index
    local activityData = self._activityArray[curIndex]
    self._curSelectActiviteType = activityData.activiteType
    self:refreshRightPanel()
end

function UIWndDailyGift:refreshRightPanel()
    if self._curSelectActiviteType == Constant.ActivityType.DAILYGIFT then
        self:refreshDailyGiftTips()
    elseif self._curSelectActiviteType == Constant.ActivityType.DAYDAYCHARGE then
        self:refreshDayDayChargeInfo()
    end
    self._dailtGift:setVisible(self._curSelectActiviteType == Constant.ActivityType.DAILYGIFT)
    self._dayDayCharge:setVisible(self._curSelectActiviteType == Constant.ActivityType.DAYDAYCHARGE)

    self:updateTextTime()
end

function UIWndDailyGift:refreshBtnRed(activityType)
    if not activityType or activityType == Constant.ActivityType.DAILYGIFT then
        self:onRefreshDayBtnRed()
    end
    if not activityType or activityType == Constant.ActivityType.DAYDAYCHARGE then
        self:onRefreshDayDayChargeBtnRed()
    end
end

function UIWndDailyGift:onRefreshBtnRedByType(activityType)
    local children = self._activityList:getChildren()
    for k,v in ipairs(children) do
        local data = self._activityArray[k or 0]
        if not data then
            break
        end
        
        local imgRed = v:getChild("img_red")
        if data.activiteType == activityType then
            if activityType == Constant.ActivityType.DAILYGIFT then -- 每日特惠小红点
                local dayGiftRed = RechargeModule:getDayGiftRed() or false
                imgRed:setVisible(dayGiftRed)
                return
            elseif activityType == Constant.ActivityType.DAYDAYCHARGE then -- 天天充值小红点
                local dayGiftRed = RechargeModule:getDayDayReChargeRed()
                imgRed:setVisible(dayGiftRed)
                return
            end
        end
    end
end
---------------------------------------------------------------------------------------------
-- 活动标题 start
function UIWndDailyGift:refreshActivityList()
    local curIndex = self:buildActivityListData()
    self._activityList:setNumItems(#self._activityArray)
    self._activityList:setSelectedIndex(curIndex - 1)
    self:refreshRightPanel()
    self:refreshBtnRed()
end

function UIWndDailyGift:buildActivityListData()
    -- self._curSelectActiviteType = Constant.ActivityType.DAYDAYCHARGE
    self._activityArray = {}
    
    local isOpen = RechargeModule:getDayGiftBagData()
    if isOpen then
        table.insert(self._activityArray, { activiteType = Constant.ActivityType.DAILYGIFT, name = GReadText.KEY_ACTIVITY_NAME_TIPS1})
    end

    local isOpen = RechargeModule:dailyRechargeIsOpen()
    if isOpen then
        table.insert(self._activityArray, { activiteType = Constant.ActivityType.DAYDAYCHARGE, name = GReadText.KEY_ACTIVITY_NAME_TIPS2})
    end

    local isExit = false
    local curIndex = 1
    for k,v in ipairs(self._activityArray) do
        if v.activiteType == self._curSelectActiviteType then
            isExit = true
            curIndex = k
        end
    end
    if not isExit and (#self._activityArray > 0) then
        self._curSelectActiviteType = self._activityArray[1].activiteType or Constant.ActivityType.DAILYGIFT
    end

    return curIndex
end

function UIWndDailyGift:onActivityTitleRender(index, obj)
    local curIndex = index + 1
    local activityData = self._activityArray[curIndex]
    if activityData then
        obj:getChild("title"):setText(activityData.name)
        obj:getChild("title2"):setText(activityData.name)
    end
    obj.index = curIndex
end
-- 活动标题 end
---------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------
--每日特惠 start
function UIWndDailyGift:refreshDailyGiftTips()
    self:onInitRewardItem()
end

function UIWndDailyGift:refreshDailyGiftTipsAndBtnRed()
    self:onInitRewardItem()
    self:onRefreshDayBtnRed()
end

function UIWndDailyGift:onRefreshDayBtnRed()
    self:onRefreshBtnRedByType(Constant.ActivityType.DAILYGIFT)
end

function UIWndDailyGift:onInitRewardItem()
    local race = GameModule:getHeroRace()
    self._list = RechargeModule:getActivityGiftMapByRace(race)
    self._listCellData = self._list
    self._listItem:setVirtual()
    self._listItem:setNumItems(#self._list)
end

-- 奖励道具渲染
function UIWndDailyGift:onCellRender(index, obj)
    local index = index + 1
    local data = self._listCellData[index]
    if data then
        obj:setRegClass(self)
        obj:setInfo(data,index)
        obj.index = index
    end
    obj:insertObjectToFactory(self)
end
--每日特惠 end
---------------------------------------------------------------------------------------------
--天天充值 start
function UIWndDailyGift:refreshDayDayChargeInfo()
    self:onInitDayDayChargeItem()
end

function UIWndDailyGift:refreshDayDayChargeInfoAndBtnRed()
    self:onInitDayDayChargeItem()
    self:onRefreshDayDayChargeBtnRed()
end

function UIWndDailyGift:onRefreshDayDayChargeBtnRed()
    self:onRefreshBtnRedByType(Constant.ActivityType.DAYDAYCHARGE)
end

function UIWndDailyGift:onInitDayDayChargeItem()
    local chargeDay = RechargeModule:getRechargedDays()
    self._chargeDay:setText(string.format(GReadText.KEY_ACTIVITY_TIPS1,chargeDay))

    local rewardStoreId = RechargeModule:getRewardStoreId()
    self._dayDayListData = CacheManager:getDailyRechargeById(rewardStoreId)
    self._dayDayList:setVirtual()
    self._dayDayList:setNumItems(#self._dayDayListData)
end

function UIWndDailyGift:onRechargeBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndRecharge", param = { type = Constant.RECHARGE_TYPE.RECHARGE } })
end

function UIWndDailyGift:addDayDayBtnClickListener()
    self._goCharge:addClickListener(handler(self, self.onRechargeBtnClick))
end

function UIWndDailyGift:removeDayDayBtnClickListener()
    self._goCharge:removeClickListener()
end

function UIWndDailyGift:onDayDayChargeRender(index, obj)
    local curIndex = index + 1
    local dayData = self._dayDayListData[curIndex]
    obj:setRegClass(self)
    obj:setInfo(dayData)
    obj.index = curIndex
    obj:insertObjectToFactory(self)
end

--天天充值 end
---------------------------------------------------------------------------------------------


return UIWndDailyGift
