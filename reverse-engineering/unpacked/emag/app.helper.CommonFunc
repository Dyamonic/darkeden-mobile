
local CommonFunc = {}

CommonFunc.autoGenSet = function(fieldName)
    return function(self, value)
        self[fieldName] = value
    end
end

CommonFunc.autoGenGet = function(fieldName)
    return function(self)
        return self[fieldName]
    end
end

CommonFunc.removeFirstUnderscore = function(str)
    if string.sub(str, 1, 1) == "_" then
        return string.sub(str, 2)
    else
        return str
    end
end

--[[
    生成[fieldName] 对应的get方法
]]
CommonFunc.metaLuaBean = function(cls,fieldName)
    if not cls.new then
        return
    end

    if type(cls._debug) ~= "table" then
        cls._debug = {}
    end

    -- dump方法统一处理
    if not cls.dump then
        function cls:dump()
            lt.LogUtil:debug(">>>>>>>>>>>>>>>>>>>> " .. (cls.__cname or "") .. " >>>>>>>>>>>>>>>>>>>>")
            for k, v in pairs(self._debug) do
                if (type(self[v]) == "number" or type(self[v]) == "string") then
                    lt.LogUtil:debug(v .. ":" .. self[v])
                end
            end
            lt.LogUtil:debug("<<<<<<<<<<<<<<<<<<<< " .. (cls.__cname or "") .. " <<<<<<<<<<<<<<<<<<<<")
        end
    end

    if type(fieldName) ~= "string" or fieldName == "" then
        return
    end

    -- 去除第一个下划线
    local clsName = CommonFunc.removeFirstUnderscore(fieldName)
    -- 首字母大写
    clsName = (clsName:gsub("^%w", string.upper)) or clsName

    -- 去除set方法
    -- cls["set" .. clsName] = CommonFunc.autoGenSet(fieldName)
    cls["get" .. clsName] = CommonFunc.autoGenGet(fieldName)
    table.insert(cls._debug, fieldName)
end

--去除首尾中括号并分割逗号
--返回一个数组 [5,34]
function CommonFunc:analysisJsonToTable(str, isToNumber)
    str = string.sub(str, 2, -2)
    local list = string.split(str, ",")
    if isToNumber then
        for i, v in ipairs(list) do
            list[i] = tonumber(v)
        end
    end
    
    return list
end

--去除首尾双中括号并分割],[
--返回一个二维数组 [[1,703003,1]]
function CommonFunc:analysisJsonToTwoTable(str)
    str = string.sub(str, 3, -3)
    local list = string.split(str, "],[")
    for i = 1, #list do
        list[i] = string.split(str, ",")
    end
    return list
end

--去除首尾双中括号并分割],[
--返回一个二维数组 [[2,16300001,1],[2,16300002,2]]
function CommonFunc:analysisJsonToTwoTableNew(str)
    str = string.sub(str, 3, -3)
    local list = string.split(str, "],[")
    for i = 1, #list do
        list[i] = string.split(list[i], ",")
    end
    return list
end

--去除首尾双中括号并分割],[
--返回一个二维数组 [[2,16300001,1],[2,16300002,2]]
function CommonFunc:analysisJson2Number(str)
    str = string.sub(str, 3, -3)
    local list = string.split(str, "],[")
    for i = 1, #list do
        list[i] = string.split(list[i], ",")
        for j = 1, #list[i] do
            list[i][j] = tonumber(list[i][j])
        end
    end
    return list
end


--修改数字格式(1000000变成1,000,000)
function CommonFunc:changeNumberShow(number)
    -- 将数字转换为字符串
    local number_str = tostring(number)

    -- 使用反向匹配模式，每3位插入一个逗号
    number_str = number_str:reverse():gsub("(%d%d%d)", "%1,"):reverse()

    -- 如果字符串以逗号开头，移除多余的逗号
    if number_str:sub(1, 1) == "," then
        number_str = number_str:sub(2)
    end

    return number_str
end

-- 生成随机数数组
function CommonFunc:randomArray(min, max, len)
    local randomArray = {}
    for i = 1, len do
        table.insert(randomArray,math.random(min, max))
        -- yflog:Info("randomArr%s",randomArray[i])
    end
    
    return randomArray
end

-- 将秒数转换为天、小时、分钟和秒
function CommonFunc:secondsToTime(seconds)
    local days = math.floor(seconds / (24 * 3600))
    seconds = seconds % (24 * 3600)
    local hours = math.floor(seconds / 3600)
    seconds = seconds % 3600
    local minutes = math.floor(seconds / 60)
    seconds = seconds % 60
    return days, hours, minutes, seconds
end

-- 将秒数转换为分和秒
function CommonFunc:secondsToTime2(seconds)
    local minutes = math.floor(seconds / 60)
    local remainingSeconds = seconds % 60
    return string.format("%02d"..GReadText.KEY_TIME_MIN.."%02d"..GReadText.KEY_TIME_SEC, minutes, remainingSeconds)
end

-- 将秒数转换为xx:xx
function CommonFunc:secondsToTime3(seconds)
    local minutes = math.floor(seconds / 60)
    local remainingSeconds = seconds % 60
    return string.format("%02d：%02d", minutes, remainingSeconds)
end

-- 将秒数转换为小时和分
function CommonFunc:secondsToTime4(seconds)
    local hour = math.floor(seconds / 3600)
    local minutes = math.floor(seconds % 3600 / 60)
    return string.format("%02d"..GReadText.KEY_TIME_HOUR.."%02d"..GReadText.KEY_TIME_MIN, hour, minutes)
end

--根据多个点计算多边形
function CommonFunc:generatePolygonFromPoints(points)
    -- 计算叉积 (o -> a) x (o -> b)
    local function cross(o, a, b)
        return (a[1] - o[1]) * (b[2] - o[2]) - (a[2] - o[2]) * (b[1] - o[1])
    end

    -- 按 x 坐标排序，如果 x 相同则按 y 排序
    local function sort_points(points)
        table.sort(points, function(a, b)
            if a[1] == b[1] then
                return a[2] < b[2]
            else
                return a[1] < b[1]
            end
        end)
    end

    -- Andrew's Monotone Chain Algorithm
    if #points <= 3 then
        return points
    end

    -- 按 x 坐标排序
    sort_points(points)

    -- 构建下凸包
    local lower = {}
    for i = 1, #points do
        while #lower >= 2 and cross(lower[#lower - 1], lower[#lower], points[i]) <= 0 do
            table.remove(lower)
        end
        table.insert(lower, points[i])
    end

    -- 构建上凸包
    local upper = {}
    for i = #points, 1, -1 do
        while #upper >= 2 and cross(upper[#upper - 1], upper[#upper], points[i]) <= 0 do
            table.remove(upper)
        end
        table.insert(upper, points[i])
    end

    -- 移除最后一个重复的点
    table.remove(lower)
    table.remove(upper)

    -- 合并下凸包和上凸包
    local hull = {}
    for _, p in ipairs(lower) do
        table.insert(hull, p)
    end
    for _, p in ipairs(upper) do
        table.insert(hull, p)
    end

    return hull
end

-- 将秒数转换为小时和分
function CommonFunc:timestampToData(timestamp)
    local dateFormat = "%Y-%m-%d %H:%M:%S"
    local dateString = os.date(dateFormat, timestamp)
    return dateString
end

function CommonFunc:daysSinceMidnight(timestamp, serverTime)
    local current_time = serverTime
    local specifiedDate = os.date("*t", timestamp)
    specifiedDate.hour = 0
    specifiedDate.min = 0
    specifiedDate.sec = 0
    local specifiedMidnight = os.time(specifiedDate)
    
    local currentDate = os.date("*t", current_time)
    currentDate.hour = 0
    currentDate.min = 0
    currentDate.sec = 0
    local currentMidnight = os.time(currentDate)
    
    return (currentMidnight - specifiedMidnight) / 86400 + 1
end

--合并两个数组
function CommonFunc:mergeArrays(list1, list2)
    local list = {}
    for i = 1, #list1 do
        table.insert(list, list1[i])
    end
    for i = 1, #list2 do
        table.insert(list, list2[i])
    end
    return list
end

function CommonFunc:deepCopySprite(originalSprite)
    -- 获取原精灵的纹理
    -- local texture = originalSprite:getTexture()
    local oriFrame = originalSprite:getSpriteFrame()

    local newSprite = display.newSprite()
    newSprite:setSpriteFrame(oriFrame)

    -- 复制其他属性
    -- newSprite:setPosition(originalSprite:getPosition())
    newSprite:setScale(originalSprite:getScale())
    newSprite:setRotation(originalSprite:getRotation())
    newSprite:setOpacity(originalSprite:getOpacity())
    newSprite:setColor(originalSprite:getColor())

    newSprite:setAnchorPoint(originalSprite:getAnchorPoint())
    return newSprite
end

-- 检查元素是否在数组中
-- @param array 要搜索的数组
-- @param element 要查找的元素
-- @return boolean 如果找到返回true，否则返回false
function CommonFunc:isInArray(array, element)
    -- 检查输入是否为table
    if type(array) ~= "table" then
        return false
    end
    
    -- 遍历数组查找元素
    for _, value in ipairs(array) do
        if value == element then
            return true
        end
    end
    
    return false
end

-- 旋转数组(举例1,2,3,4,5变成2,3,4,5,1)
function CommonFunc:rotateArray(arr, k)
    local n = #arr
    k = k % n  -- 处理 k 大于数组长度的情况
    local rotated = {}
    -- 先复制 arr[k+1..n]
    for i = k + 1, n do
        table.insert(rotated, arr[i])
    end
    -- 再复制 arr[1..k]
    for i = 1, k do
        table.insert(rotated, arr[i])
    end
    return rotated
end

function CommonFunc:convertLargerNumber(num)
    num = tonumber(num)
    local unit = ""
    if num >= 10000000000 then
        num = math.floor(num/100000000)
        unit = "亿"
    elseif num >= 1000000 then
        num = math.floor(num/10000)
        unit = "万"
    end
    return num..unit
end

function CommonFunc:getRemainTime(time)
    local hour = math.floor(time / 3600)
    local minute = math.floor((time - hour * 3600) / 60)
    if hour > 0 then
        if minute > 0 then
            hour = hour + 1
        end
        return string.format(GReadText.KEY_GUILD_TIPS34, hour)
    else
        return string.format(GReadText.KEY_GUILD_TIPS35, minute)
    end
end

--获得当前时间距离零点的秒数
function CommonFunc:getSecondsUntilNextDay(serverTime)
    -- 获取当前时间
    local now = serverTime

    -- 获取当前日期的年、月、日
    local currentDate = os.date("*t", now)
    currentDate.hour = 0
    currentDate.min = 0
    currentDate.sec = 0

    -- 计算明天的日期
    currentDate.day = currentDate.day + 1

    -- 转换为时间戳（明天零点）
    local nextDay = os.time(currentDate)

    -- 计算差值（秒数）
    local secondsUntilNextDay = nextDay - now

    return secondsUntilNextDay
end

function CommonFunc.createEquipById(iconId,affixId,affixLevel)
    local affixColor = lt.Constant.DEFALUT_CLOTH_COLOR
    if type(affixId) == "number" and affixId > 0 then
        local affixData = lt.CacheManager:getEnchantingAffixMeta(affixId)
        if affixData then
            affixColor = affixData:getColor()
        end
    end

    local cocosResUrl = string.format("icon/itemTL/bag/%s/%s.png", "equip",iconId)
    local sprite = display.newSprite(cocosResUrl)
    local texture = sprite:getTexture()
    texture:setAliasTexParameters()

    local param = {
        node = sprite, 
        isBorder = false,
        bColor = cc.vec3(1.0, 1.0, 1.0),
        tColor =  affixColor,
        colorOffset = lt.CacheManager:getPowerColorSet(affixLevel or 0) or lt.Constant.BaseColorRatio,
    }
    lt.ShaderBackendUtil:makeBorderEffect(param.node, param)

    return sprite
end

--是否为同一天
function CommonFunc:isSameDay(timestamp1, timestamp2)
    local t1 = os.date("*t", timestamp1)
    t1.hour = 0
    t1.min = 0
    t1.sec = 0
    local t2 = os.date("*t", timestamp2)
    t2.hour = 0
    t2.min = 0
    t2.sec = 0
    return os.time(t1) == os.time(t2)
end

function CommonFunc.createPropById(iconId)
    local cocosResUrl = string.format("icon/itemTL/bag/%s/%s.png", "prop",iconId)
    local sprite = display.newSprite(cocosResUrl)

    return sprite
end

function CommonFunc.getOptionInfoStrName2(attrType, attrValue)
    local optionInfo = lt.CacheManager:getOptionInfoMeta(attrType)
    local value = ""
    if optionInfo then
        local isPer        = optionInfo:getPercentage()
        local isPermyriad  = optionInfo:getPermyriad()
        value = attrValue
        if isPermyriad == 1 then
            value = value / 100
        end
        if isPer == 1 then
            value = value .. "%"
        end

        value = optionInfo:getName2() .. ": " .. value
    end
    return value
end

return CommonFunc