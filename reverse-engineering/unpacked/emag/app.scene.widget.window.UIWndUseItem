---@使用道具
---@class UIWndUseItem:UIWindowBase
local UIWndUseItem = class("UIWndUseItem",lt.UIWindowBase)

local NtfManager = lt.NtfManager
local ItemModule = lt.ItemModule
local Constant   = lt.Constant
local GameModule = lt.GameModule
local SocketApi = lt.SocketApi
local ServerCmdDef = lt.ServerCmdDef
local ClientCmdDef = lt.ClientCmdDef
local netcmd_pb = lt.netcmd_pb
local CommonModule = lt.CommonModule

UIWndUseItem.ChangeSkinConf = {
    ["MessageBox"] = {
        ["bg"] = "bg_sxjd_tc",
    },
    ["CommonTL"] = {
        confirmButton = {bg  = "sort"},
        closeButton = {bg  = "sort"},
    } 
}

function UIWndUseItem:ctor(param)
    UIWndUseItem.super.ctor(self, param)
    self._params = self:getParam().param
end

function UIWndUseItem:onInit()
    self:registerComponent("UICompItem")
    UIWndUseItem.super.onInit(self,_GURL.MessageBoxUseItem)
    self:setBringToFrontOnClick(false)
    self._cancelBtn = self:getChild("closeButton")
    self._confirmBtn = self:getChild("confirmButton")
    self._itemName = self:getChild("itemName")
    self._titleText = self:getChild("title")--标题
    self._descText = self:getChild("desc")--描述，富文本
    self._itemBg = self:getChild("itembg")--道具背景
    self._touchLayer = self:getChild("touchLayer")
    self._costItem = fgui.UIPackage:createObject("Item", "Item")
    self._costItem:insertObjectToFactory(self)
    self._costItem:setScale(1.2, 1.2)
    self._costItem:setPivot(0.5, 0.5, true)
    self._costItem:setItemNums("")
    self:addChild(self._costItem)
    self._costItem:setPosition(574,295)
end

function UIWndUseItem:onClear()
    self:unregisterAllComponent()
    if self._cancelBtn then
        self._cancelBtn:removeClickListener()
        self._cancelBtn = nil
    end
    if self._confirmBtn then
        self._confirmBtn:removeClickListener()
        self._confirmBtn = nil
    end
    if self._costItem then
        self._costItem:removeClickListener()
        self._costItem = nil
    end
    if self._touchLayer then
        self._touchLayer:removeEventListener(fgui.UIEventType.TouchEnd)
        self._touchLayer = nil
    end
    UIWndUseItem.super.onClear(self)
end

function UIWndUseItem:onShown()
    UIWndUseItem.super.onShown(self)
    self._pointNum = 0
    --获取玩家可洗属性
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.CS_GET_CLEARABLE_ATTRIBUTE_POINT_RESP), handler(self, self.onGetAttributePoint), "UIWndUseItem:onGetAttributePoint")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB,
        handler(self, self.autoUnpackItem), "UIWndUseItem:autoUnpackItem")
    self._cancelBtn:addClickListener(handler(self, self.onCloseBtnClick))
    self._confirmBtn:addClickListener(handler(self, self.onUsetItemBtnClick))
    self._touchLayer:addEventListener(fgui.UIEventType.TouchEnd, handler(self, self.onLayerClick))
    
    self._costItem:addClickListener(function()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = self._costMeta, tipsType = Constant.PROPTIPS_FORM.Display})
    end)
    self:refreshDesc()
    self:sendGetAttributePoint()
end

function UIWndUseItem:onHide()
    SocketApi:removeProtoListenerByTag("UIWndUseItem:onGetAttributePoint")
    NtfManager:removeNtfListenerByTag("UIWndUseItem:autoUnpackItem")
    self._touchLayer:removeEventListener(fgui.UIEventType.TouchEnd)
    self._cancelBtn:removeClickListener()
    self._confirmBtn:removeClickListener()
    self._costItem:removeClickListener()
    UIWndUseItem.super.onHide(self)
end

function UIWndUseItem:refreshDesc()
    self._targetMeta = self._params
    self._costMeta = lt.CacheManager:getItemMeta(self._targetMeta[2])
    local gemId = self._costMeta:getItemId()
    self._costItem:setInfo(string.format(_GURL.GetImageItem, gemId))
    local haveNum = ItemModule:getItemNum(self._targetMeta[2])
    local needNum = self._targetMeta[3]
    self._costItem:setNeedNum(haveNum, needNum)
    self._itemName:setText(self._costMeta:getName())
    local heroData = GameModule:getHeroData()
    self._pointNum = 0
    self._descText:setText(string.format(GReadText.KEY_RETURN_POINTS_TIPS,self._pointNum))
    self._itemContentTable = {}
    local _itemkey = string.format("%d_%d",self._targetMeta[1],self._targetMeta[2])
    self._itemContentTable[_itemkey] = true
end

function UIWndUseItem:autoUnpackItem(event)
    if event and event.name == "NTF_UPDATE_ITEM_NUMB" then
        if event.param and event.param.content then
            if self._itemContentTable and self._itemContentTable[event.param.content] then
                
            else
                return
            end
        end
    end
    local haveNum = ItemModule:getItemNum(self._targetMeta[2])
    self._costItem:setNeedNum(haveNum, self._targetMeta[3])
end

function UIWndUseItem:onCloseBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndUseItem", close=true})
end

function UIWndUseItem:onUsetItemBtnClick()
    if self._pointNum <= 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_CLEARABLE_POINT_TIPS})
        return
    end
    local items = ItemModule:getWholeItems(self._targetMeta[2],self._targetMeta[1])
    if #items > 0 then
        ItemModule:sendUseItem(items[1].objId)
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = self._costMeta:getName()..GReadText.KEY_STRENGTHEN_TIPS31})
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = self._costMeta, tipsType = Constant.PROPTIPS_FORM.Display})
    end
    lt.NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndUseItem", close=true})
end

---------------------------洗属性点------------------------------------
function UIWndUseItem:sendGetAttributePoint()
    local msg = netcmd_pb.CS_GetClearableAttributePointReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_GET_CLEARABLE_ATTRIBUTE_POINT_REQ),msg)
end

function UIWndUseItem:onGetAttributePoint(event)
    local proto = event.param
    local point = proto.num
    self._pointNum = point
    self._descText:setText(string.format(GReadText.KEY_RETURN_POINTS_TIPS,point))
end

function UIWndUseItem:onLayerClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndUseItem", close=true})
end

return UIWndUseItem