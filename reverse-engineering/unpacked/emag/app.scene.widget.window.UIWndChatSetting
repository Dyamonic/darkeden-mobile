--- 聊天设置界面
---@class UIWndChatSetting:UIWindowBase
local UIWndChatSetting            = class("UIWndChatSetting", lt.UIWindowBase)
local PrefManager                 = lt.PrefManager
local Constant                    = lt.Constant
local ChatModule                  = lt.ChatModule
local NtfManager                  = lt.NtfManager
local RaceType                    = Constant.RaceType

UIWndChatSetting.ChangeSkinConf   = {
    ["Chat"] = {
        ["img"]         = "bg_liaotian_di2",
        ["img_list"]    = "bg_liaotian_xk01",
        ["btn_setting"] = { img_up = "btn_liaotian_shezhi", img_down = "btn_liaotian_shezhi1" },
        ["btn_color"]   = { img_up = "btn_liaotian_shezhi", img_down = "btn_liaotian_shezhi1" },
    },

    ["CommonTL"] = {
        ["frame"] = {
            closeButton = { bg = "bg_beibao_anniu01", bgup = "bg_beibao_anniu02" },
        }
    }
}

UIWndChatSetting.ChangeSkinOffset = {
    [RaceType.Slayer] = {
        ["frame"] = {
            closeButton = { x = -5, y = -7 },
        },
    },
    [RaceType.Vampire] = {
        ["frame"] = {
            closeButton = { x = -5, y = -8 },
        },
    },
    [RaceType.Ousters] = {
    }
}

local btnTypeList                 = {
    { name = "btn_xitong", type = Constant.MESSAGE_TALK_TYPE.TALKTYPE_NEW_SYSTEM }, -- 系统
    { name = "btn_shijie", type = Constant.MESSAGE_TALK_TYPE.TALKTYPE_WORD },       -- 世界
    { name = "btn_zhongzu", type = Constant.MESSAGE_TALK_TYPE.TALKTYPE_SAME_RACE }, -- 种族
    { name = "btn_fujin", type = Constant.MESSAGE_TALK_TYPE.TALKTYPE_HANHUA },      -- 附近
    { name = "btn_quyu", type = Constant.MESSAGE_TALK_TYPE.TALKTYPE_MAP },          -- 区域聊天（同地图）
    { name = "btn_zudui", type = Constant.MESSAGE_TALK_TYPE.TALKTYPE_TEAM },        -- 组队
    { name = "btn_gonghui", type = Constant.MESSAGE_TALK_TYPE.TALKTYPE_GUILD },     -- 行会频道
    { name = "btn_lianmeng", type = Constant.MESSAGE_TALK_TYPE.TALKTYPE_UNION },    -- 联盟
    { name = "btn_siliao", type = Constant.MESSAGE_TALK_TYPE.TALKTYPE_PRIVATE }     -- 私聊
}

local btnFncList                  = {
    { name = "btn_setting" },
    { name = "btn_color" }
}

function UIWndChatSetting:ctor(param)
    self:registerComponent("UICompChatSettingCell")
    UIWndChatSetting.super.ctor(self, param)
    self._index       = 0
    self._btnTypeList = {}
    self._btnFncList  = {}
end

function UIWndChatSetting:onClear()
    self._controlFnc  = nil
    self._listColor   = nil
    self._btnTypeList = {}
    self._btnFncList  = {}
    self:unregisterAllComponent()
    UIWndChatSetting.super.onClear(self)
end

function UIWndChatSetting:onShown()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_FLOAT_CHAT_COLOR, handler(self, self.onShowItem),
        "UIWndChatSetting:onShowItem")
    for k, v in ipairs(self._btnFncList) do
        v:addClickListener(handler(self, self.onBtnFncClick))
    end
    for k, v in ipairs(self._btnTypeList) do
        v:addClickListener(handler(self, self.onBtnTypeClick))
    end
    self._listColor:setNumItems(16)
end

function UIWndChatSetting:onHide()
    NtfManager:removeNtfListenerByTag("UIWndChatSetting:onShowItem")
    for k, v in ipairs(self._btnFncList) do
        v:removeClickListener()
    end
    for k, v in ipairs(self._btnTypeList) do
        v:removeClickListener()
    end

    UIWndChatSetting.super.onHide(self)
end

function UIWndChatSetting:onInit()
    UIWndChatSetting.super.onInit(self, _GURL.ChatSettingPanel)
    -- 频道
    for k, v in ipairs(btnTypeList) do
        local btn = self:getChild(v.name)
        self._btnTypeList[k] = btn
        local type = v.type
        btn.type = type
        local keySetting = PrefManager:getUserValueByKey(ChatModule.CHAT_SETTING .. type) or 0
        btn:setSelected(tonumber(keySetting) == 0)
    end

    for k, v in ipairs(btnFncList) do
        local btn = self:getChild(v.name)
        btn.index = k
        self._btnFncList[k] = btn
    end

    self._controlFnc = self:getController("c1")
    self._listColor = self:getChild("list_color")
    self._listColor:setItemRenderer(handler(self, self.renderChatItem))

end

function UIWndChatSetting:onBtnTypeClick(target)
    local type = target:getSender().type or 0
    local name = target:getSender().name
    local keySetting = PrefManager:getUserValueByKey(ChatModule.CHAT_SETTING .. type) or 0
    if tonumber(keySetting) == 0 then
        PrefManager:setUserValueByKey(ChatModule.CHAT_SETTING .. type, 1)
    else
        PrefManager:setUserValueByKey(ChatModule.CHAT_SETTING .. type, 0)
    end
end

function UIWndChatSetting:onBtnFncClick(target)
    local index = target:getSender().index
    if self._index == index then
        return
    end
    self._index = index
    self._controlFnc:setSelectedIndex(index - 1)
end

function UIWndChatSetting:renderChatItem(index, obj)
    obj.index = index + 1
    obj:setInfo(index + 1)
end

function UIWndChatSetting:onShowItem()
    self._listColor:setNumItems(16)
end

return UIWndChatSetting
