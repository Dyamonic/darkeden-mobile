function SocketManager:_send(connindex, messageId, messageData)
    local buffer = cc.utils.ByteArrayVarint.new(cc.utils.ByteArrayVarint.ENDIAN_BIG)

    -- header
    buffer:writeInt(string.len(messageData) + lt.SocketConstants.LENTH_HEADER)  -- length
    buffer:writeInt(messageId)                                                  -- cmd
    buffer:writeInt(self._messageSequence)                                      -- sequence
    buffer:writeInt(2)                                                          -- user id
    buffer:writeInt(self._sessionId)                                            -- session id
    buffer:writeInt(4)                                                          -- optional

    self._messageSequence = self._messageSequence + 1

    -- data
    buffer:writeStringBytes(messageData)

    self._gameNet:SendTo(connindex, buffer:getPack(), buffer:getLen())
end

