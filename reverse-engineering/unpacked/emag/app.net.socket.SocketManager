function SocketManager:onConnectSuccess(connIndex)
    lt.LogUtil:debug("SocketManager:onConnectSuccess connIndex:"..connIndex)
    lt.ConnectLoading:loadingOff()

    if connIndex == self.DEFAULT_CONNINDEX then
        -- 主网络线程
        lt.LogUtil:debug("SocketManager:onConnectSuccess %d", self._contentStatus)

        -- 重置重连标记
        self._reconnectInterval = self.RECONNECT_INTERVAL
        self._recontentTimes    = 0

        if self._contentStatus == self.CONTENT_STATUS.CONNECT then
            -- 正常连接
            self._contentStatus = self.CONTENT_STATUS.ALIVE

        elseif self._contentStatus == self.CONTENT_STATUS.PENDING_CONNECT or self._contentStatus == self.CONTENT_STATUS.RECONNECT then
            -- 挂起重连(需要重新登录)
            self._contentStatus = self.CONTENT_STATUS.ALIVE


        end
    else
        lt.LogUtil:debug("connIndex "..connIndex.." onConnectSuccess")
    end

    lt.SocketApi:dispatchProto(lt.SocketApi._Event.SOCKET_CONNECT_SUCCESS, self._contentStatus)
end

function SocketManager:onConnectFail(connIndex)
    lt.LogUtil:debug("SocketManager:onConnectFail connIndex:"..connIndex)
    if connIndex == self.DEFAULT_CONNINDEX then
        -- 主网络线程
        if self._contentStatus == self.CONTENT_STATUS.DISCONNECT then
            -- 断开链接了
            lt.ConnectLoading:loadingOff()

            -- 弹出提示
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_ALERT_TIP, 
                                                    {content = lt.StringManager:getString(lt.StringManager.KEY_CONNECTING_FAIL),
                                                      btns = {lt.Constant.COMMON_TIP_BTN.BTN_CONFIM}})

        elseif self._contentStatus == self.CONTENT_STATUS.CONNECT then
            -- 主动连接失败(转为初始状态 继续手动连接)
            self:resetInfo()

            lt.SocketApi:dispatchProto(lt.SocketApi._Event.SOCKET_CONNECT_FAIL)
            lt.ConnectLoading:loadingOff()

        elseif self._contentStatus == self.CONTENT_STATUS.PENDING_CONNECT then
            -- 挂起重连失败
            if self._recontentTimes > self.RECONNECT_TIMES then
                self:resetInfo()

                lt.ConnectLoading:loadingOff()
                self:brokenNtf()
                return
            end

            -- 间隔N秒后重连(每次重连增加重连间隔)
            if not self._reconnectHandler then
                lt.LogUtil:debug("connect error reconnect after %.1f second", self._reconnectInterval)
                self._reconnectHandler = lt.ScheduleUtil:performWithDelayGlobal(handler(self, self.delayReconnect), self._reconnectInterval)
            end

        elseif self._contentStatus == self.CONTENT_STATUS.RECONNECT then
            -- 重连失败
            if self._recontentTimes > self.RECONNECT_TIMES then
                lt.ConnectLoading:loadingOff()

                self:brokenNtf()
                return
            end

            -- 间隔N秒后重连(每次重连增加重连间隔)
            if not self._reconnectHandler then
                lt.LogUtil:debug("connect error reconnect after %.1f second", self._reconnectInterval)
                self._reconnectHandler = lt.ScheduleUtil:performWithDelayGlobal(handler(self, self.delayReconnect), self._reconnectInterval)
            end
        end
    elseif connIndex == self.LOGIN_CONNINDEX then
        lt.LogUtil:debug("reconnect connIndex %d after 1s", connIndex)
        lt.ScheduleUtil:performWithDelayGlobal(function()
            self:_reconnect(connIndex)
        end, 1)
    else
        lt.LogUtil:debug("connIndex "..connIndex.." onConnectFail")
    end
end

function SocketManager:onConnectBroken(connIndex)
    lt.LogUtil:debug("SocketManager:onConnectBroken "..connIndex)

    if connIndex == self.DEFAULT_CONNINDEX then
        if self._contentStatus == self.CONTENT_STATUS.DISCONNECT or
           self._contentStatus == self.CONTENT_STATUS.PENDING or
           self._contentStatus == self.CONTENT_STATUS.LOST then
            return
        end

        if self._contentStatus == self.CONTENT_STATUS.ALIVE then
            lt.LogUtil:debug("SocketManager.CONTENT_STATUS is lost code 2")
            -- self._contentStatus = self.CONTENT_STATUS.LOST
            
            if self._willKick then
                self:disconnect(true)
                self:brokenNtf()
                return
            end

            if self._recontentTimes == 0 then
                self:reconnect()
            end
        end
    elseif connIndex == self.LOGIN_CONNINDEX then
        --lt.LogUtil:debug("reconnect connIndex %d after 1s", connIndex)
        --lt.ScheduleUtil:performWithDelayGlobal(function()
        --    self:_reconnect(connIndex)
        --end, 1)
    else
        lt.LogUtil:debug("connIndex "..connIndex.." onConnectBroken")
    end
end

function SocketManager:brokenNtf(extraStr)
    local content = lt.StringManager:getString(lt.StringManager.KEY_CONNECTING_FAIL)
    if extraStr then
        content = content .. extraStr
    end

    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_ALERT_TIP, 
                                            {content = content,
                                              btns = {lt.Constant.COMMON_TIP_BTN.BTN_CONFIM},
                                              offLine = true})
end

