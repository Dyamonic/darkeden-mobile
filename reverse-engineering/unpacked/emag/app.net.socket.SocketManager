function SocketManager:errorCodeAlertTips(msg, msgID)
    local errorCode = msg.ret
    if ServerCmdDef.CHANGE_OF_NAME_RES == msgID then -- 改名协议显示小窗口
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {content =lt.ReadTextManager:getErrorMsgByCode(errorCode)})
    elseif lt.CommonModule:GetNetCmdEnum(ServerCmdDef.S_AGREE_IN_TEAM_RESP) == msgID then -- 入队申请失效
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = lt.ReadTextManager:getErrorMsgByCode(errorCode)})
    elseif errorCode == self.ERROR_CODE.TALKFAST or errorCode == self.ERROR_CODE.USECHECK then -- 说话太快/太频繁
        return true
    elseif ServerCmdDef.PICKUP_ERROR == msgID or ServerCmdDef.S_DigCorpse == msgID or lt.CommonModule:GetNetCmdEnum(ServerCmdDef.S_BUY_TRANSACTION_RESP) == msgID then -- 捡物品失败/挖尸体失败
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = lt.ReadTextManager:getErrorMsgByCode(errorCode)})
        return false
    elseif errorCode == self.ERROR_CODE.PARAMERROR then --参数错误
        return true
    elseif ServerCmdDef.CS_SOUL_CHAIN_RESP == msgID  then -- 灵魂锁链
        return false
    elseif ServerCmdDef.ATTACK_ACK == msgID then -- 攻击协议需在对应协议做处理，错误码有特殊含义
        return false
    elseif lt.CommonModule:GetNetCmdEnum(ServerCmdDef.S_PET_RAISE_RESP) == msgID then -- 宠物驯养
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = lt.ReadTextManager:getErrorMsgByCode(errorCode)})
        return false
    else
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = lt.ReadTextManager:getErrorMsgByCode(errorCode)})
    end

    return true
end

return SocketManager
