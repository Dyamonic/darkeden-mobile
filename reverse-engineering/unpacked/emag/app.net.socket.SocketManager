
local SocketManager = {}
local ServerCmdDef = lt.ServerCmdDef

SocketManager.CONTENT_STATUS = { -- 网络连接状态
    DISCONNECT      = 0, -- 断开
    PENDING         = 1, -- 挂起
    LOST            = 2, -- 网络中断

    CONNECT         = 10, -- 主动连接
    RECONNECT       = 11, -- 重连
    PENDING_CONNECT = 12, -- 挂起重连

    ALIVE           = 999, -- 连接中
}

SocketManager.ERROR_CODE = { -- 错误码
    TALKFAST        = 1148, -- 说话太快
    USECHECK        = 1079, -- 使用太频繁
    PARAMERROR      = 2,    -- 参数错误
}

SocketManager._contentStatus = SocketManager.CONTENT_STATUS.DISCONNECT -- 当前连接状态

SocketManager._init = false

SocketManager.DEFAULT_CONNINDEX = 0
SocketManager.LOGIN_CONNINDEX = 99

SocketManager._messageSequence = 0
SocketManager._sessionId       = 0

SocketManager._domain = nil
SocketManager._ip     = nil
SocketManager._port   = nil

SocketManager._connectTable = nil

-- 心跳相关
SocketManager._heartbeat       = 0
SocketManager._heartbeatover   = 0
SocketManager.CHECK_RECEIVE_INTERVAL = 0.1

-- 重连相关
SocketManager.RECONNECT_INTERVAL    = 3 -- 重连间隔
SocketManager.RECONNECT_TIMES       = 10 -- 重连次数
SocketManager.RECONNECT_TIMES       = 1 -- 重连次数

SocketManager._recontentTimes       = 0
SocketManager._reconnectInterval    = 0

SocketManager.HEART_BEAT       = 3 -- 正常网络心跳
SocketManager.HEART_BEAT_OVER  = 7.5 -- 心跳超时(3次 9s以下 取7.5s)
SocketManager._aliveTime       = 0
SocketManager._aliveSend      = nil
SocketManager._alivePing      = 0
SocketManager._netLevel       = nil

SocketManager._realMessageIdTable = nil
SocketManager._packetParser = nil --解析类

SocketManager._gameNet = cpp.GameNet:getInstance()

SocketManager._willKick = false

SocketManager._clientVer = ""

function SocketManager:init()
    if self._init then
        return
    end

    self._init = true

    -- 只用于 取时间
    --self._socket = cc.net.SocketTCP.new()

    self._gameNet:registerProcessScriptHandler(handler(self, self.onProcess))
    self._gameNet:registerConnectSuccessScriptHandler(handler(self, self.onConnectSuccess))
    self._gameNet:registerConnectFailScriptHandler(handler(self, self.onConnectFail))
    self._gameNet:registerConnectBrokenScriptHandler(handler(self, self.onConnectBroken))

    -- 网络线程开启
    self._gameNet:run()

    -- 心跳
    self._heartbeat     = self.HEART_BEAT
    self._heartbeatover = self.HEART_BEAT_OVER
    
    -- lt.ScheduleUtil:scheduleUpdateGlobal(function()
    --     lt.LogUtil:debug("SocketManager:init scheduleUpdate")
    -- end, 0, false)

    lt.ScheduleUtil:scheduleUpdateGlobal(handler(self, self.onUpdate))

    -- 重连间隔
    self._reconnectInterval = self.RECONNECT_INTERVAL

    -- 请求一一对应
    self._realMessageIdTable = {}

    self._connectTable = {}

    self._packetParser = lt.PacketParser
end

function SocketManager:setHeartbeat(heartbeat)
    self._heartbeat     = heartbeat
    self._heartbeatover = heartbeat * 2.5
end

function SocketManager:resetHeartbeat()
    self._heartbeat     = self.HEART_BEAT
    self._heartbeatover = self.HEART_BEAT_OVER
end

function SocketManager:willKick()
    print("SocketManager:willKick")
    self._willKick = true
end

function SocketManager:onUpdate(delta)
    if self._contentStatus ~= SocketManager.CONTENT_STATUS.ALIVE then
        return
    end

    self._aliveTime = self._aliveTime + delta
    if self._aliveTime < self._heartbeat then
        return
    end
    self._aliveTime = 0
    self:keepAlive()
    if self._aliveSend then
        if (self:getTime() - self._aliveSend) > self._heartbeatover and self._recontentTimes == 0 then
            self._aliveSend = nil
            self:reconnect()
            return
        end
    else
        self._aliveSend = self:getTime()
    end
end

function SocketManager:clear()
    -- body
end

function SocketManager:resetInfo()
    self._contentStatus = self.CONTENT_STATUS.DISCONNECT

    self._domain = nil
    self._ip     = nil
    self._port   = nil
end

function SocketManager:connect(domain, ip, port)
    -- lt.LogUtil:debug("SocketManager:connect")
    if not domain or not ip or not port then
        domain = self._domain
        ip     = self._ip
        port   = self._port
    end

    if not domain or not ip or not port then
        return false
    end

    local reconnecting = false
    if self._reconnectHandler then
        -- 取消重连
        lt.ScheduleUtil:unscheduleGlobal(self._reconnectHandler)
        self._reconnectHandler = nil
        reconnecting = true
    end

    if self._contentStatus == self.CONTENT_STATUS.CONNECT then
        -- 正在连接中
        return false
    end

    if self._contentStatus == self.CONTENT_STATUS.RECONNECT or
       self._contentStatus == self.CONTENT_STATUS.PENDING_CONNECT then
        -- 正在连接中
        if reconnecting then
            self:delayReconnect()
        end
        return false
    end

    -- lt.LogUtil:debugTable("self._contentStatus = "..tostring(self._contentStatus))
    if self._contentStatus == self.CONTENT_STATUS.ALIVE then
        -- 连接中? 先断开
        self:disconnect(true)
    end

    if self._contentStatus == self.CONTENT_STATUS.PENDING then
        -- 挂起重连
        self._contentStatus = self.CONTENT_STATUS.PENDING_CONNECT
    else
        -- 发起主动连接
        self._contentStatus = self.CONTENT_STATUS.CONNECT
    end

    self._domain = domain
    self._ip     = ip
    self._port   = port

    -- lt.LogUtil:debug("SocketManager:connect index:%d domain:%s ip:%s:%d", self.DEFAULT_CONNINDEX, domain, ip, port)
    -- self._gameNet:addConnect(self.DEFAULT_CONNINDEX, self._domain, self._ip, self._port)
    return self:_connect(self.DEFAULT_CONNINDEX, self._domain, self._ip, self._port)
end

function SocketManager:_connect(connindex, domain, ip, port)
    yflog:Info("SocketManager:connect index:%d domain:%s ip:%s:%s", connindex, domain, ip, port)
    self:_disconnect(connindex)
    local result = self._gameNet:addConnect(connindex, domain, ip, port)

    self._connectTable[connindex] = {domain = domain, ip = ip, port = port}

    return result
end

function SocketManager:delayReconnect()
    self._reconnectHandler = nil

    self:reconnect()
end

function SocketManager:reconnect()
    lt.LogUtil:debug("SocketManager:reconnect %d", self._contentStatus)
    if not self._domain or not self._ip or not self._port then
        lt.Game:networkReset(lt.Game.RESET_CODE.RECONNECT_EMPTY)
        return
    end

    if self._reconnectHandler then
        return
    end

    if self._contentStatus == self.CONTENT_STATUS.ALIVE then
        self:disconnect(true)
    end

    self._contentStatus = self.CONTENT_STATUS.RECONNECT -- 发起再次连接

    -- 重连次数++
    self._recontentTimes = self._recontentTimes + 1

    if self._recontentTimes <= self.RECONNECT_TIMES then
        lt.ConnectLoading:loadingOn(self._recontentTimes, self.RECONNECT_TIMES)
    end

    self:_reconnect(self.DEFAULT_CONNINDEX)
end

function SocketManager:_reconnect(connindex)
    self._gameNet:reConnect(connindex)
end

function SocketManager:disconnect(noClear)
    lt.LogUtil:debug("SocketManager:disconnect %d", self._contentStatus)
    if self._contentStatus == self.CONTENT_STATUS.DISCONNECT then
        -- 无连接
        return
    end

    if self._contentStatus == self.CONTENT_STATUS.PENDING then
        -- 挂起
        self._contentStatus = self.CONTENT_STATUS.DISCONNECT
        if not noClear then
            self:resetInfo()
        end
    else
        self._contentStatus = self.CONTENT_STATUS.DISCONNECT
        if not noClear then
            self:_disconnect(self.DEFAULT_CONNINDEX)

            self:resetInfo()
        end
    end

    self._breakFlag = false
    self._willKick = false

    -- 网络断开 停止挂机
    if lt.AutoFightManager:isAuto() then
        lt.AutoFightManager:endAutoFight()
        lt.AutoFightManager:setOldAuto(true)
    end
end

function SocketManager:_disconnect(connindex)
    lt.LogUtil:debug("self._gameNet:removeConnect connIndex:"..connindex)
    self._gameNet:removeConnect(connindex)
end

-- 网络挂起(进入后台)
function SocketManager:pending()
    lt.LogUtil:debug("SocketManager:pending")
    if self._contentStatus == self.CONTENT_STATUS.PENDING or self._contentStatus == self.CONTENT_STATUS.DISCONNECT then
        -- 挂起/无连接
        return
    end

    -- 网络断开 停止挂机
    if lt.AutoFightManager:isAuto() then
        lt.AutoFightManager:endAutoFight()
        lt.AutoFightManager:setOldAuto(true)
    end

    self._contentStatus = self.CONTENT_STATUS.PENDING

    self._gameNet:removeConnect(self.DEFAULT_CONNINDEX)
end

