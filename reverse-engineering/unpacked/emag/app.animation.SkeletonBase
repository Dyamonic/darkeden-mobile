local SkeletonBase = class("SkeletonBase", function()
    return display.newNode()
end)


--[[ 
    spine 骨骼动画基类
]]

SkeletonBase._spine = nil

SkeletonBase.ANIMATION_EVENT = {
    START       = "start",
    COMPLETE    = "complete",
    END         = "end",
    EVENT       = "event",
}

function SkeletonBase:ctor(skeletonData)
    self:enableNodeEvents()

    -- 记录spine 原始大小
    self._animationScaleOriginal = self._spine:getTimeScale()
    self._animationScale = 1
end

function SkeletonBase:onCleanup()
end

function SkeletonBase:onEnter()
end

function SkeletonBase:onExit()
end

function SkeletonBase:create(file)
end

function SkeletonBase:createWithData(skeletonData)
end

function SkeletonBase:getAllAnimationName()
end

-- 播放动画 name:动画名 loop: 循环
function SkeletonBase:playAnimation(name, loop)
    if not name then return false end

    if self:setAnimation(0, name, loop) then
        self._spine:update(0)
        return true
    end
    return false
end

-- 是否有该动画
function SkeletonBase:canPlayAnimation(name)
    if not name then return false end
    return self:findAnimation(name)
end

function SkeletonBase:updateAnimation(deltaTime)
    self._spine:update(deltaTime)
end

-- 添加动画
function SkeletonBase:appendAnimation(name, loop)
    if not name then return false end

    if self:addAnimation(0, name, loop) then
        self._spine:update(0)
        return true
    end

    return false
end

-- frame count 帧数
function SkeletonBase:getAnimationFrameCount(name)
    local duration = self:getAnimationDuration(name)

    return math.ceil(duration/0.03333333);
end

function SkeletonBase:getAnimationDuration(name)
    local animation = self:findAnimation(name)
    if not animation then return nil end

    -- animation return is string so spAnimation interface need write into C++
    return animation.duration
end

--[[
    trackIdx 轨道编号 spine 支持同时播放多个动画于不同轨道
    aniName 动画名称
    loop 是否循环
]]
function SkeletonBase:setAnimation(trackIdx, aniName, loop)
    return self._spine:setAnimation(trackIdx, aniName, loop)
end

--[[
    trackIdx 轨道编号 spine 支持同时播放多个动画于不同轨道
    aniName 动画名称
    loop 是否循环
]]
function SkeletonBase:addAnimation(trackIdx, aniName, loop)
    return self._spine:addAnimation(trackIdx, aniName, loop)
end

--[[
    animation 是否存在
]]
function SkeletonBase:findAnimation(aniName)
    return self._spine:findAnimation(aniName)
end

--[[
    timescale
]]
function SkeletonBase:setAnimationScaleOriginal(scale)
    self._animationScaleOriginal = scale >= 0 and scale or 1
    self:updateSkeletonTimeScale()
end

function SkeletonBase:setAnimationScale(scale)
    self._animationScale = scale >= 0 and scale or 1
    self:updateSkeletonTimeScale()
end

function SkeletonBase:getAnimationScale()
    return self._animationScale
end

function SkeletonBase:updateSkeletonTimeScale(scale)
    self._spine:setTimeScale(self._animationScaleOriginal * self._animationScale)
end

-- 暂停
function SkeletonBase:pauseAnimation()
    self._spine:pause()
end

function SkeletonBase:stopAnimation()
    self:clearTrack(0)
end

--[[
    获取区域大小
]]
function SkeletonBase:getBoundingBox()
    return self._spine:getBoundingBox()
end

function SkeletonBase:handlerEvent(event)
   local callback = self._callback
   if callback then
        callback(event)
   end
end

function SkeletonBase:registerSpineEventHandlerSignal(func, eventType)
    func = func or handler(self, self.handlerEvent)
    eventType = eventType or sp.EventType.ANIMATION_COMPLETE

    self._spine:registerSpineEventHandler(func, eventType)
end

function SkeletonBase:removeSpineEventHandlerSignal(eventType)
    eventType = eventType or sp.EventType.ANIMATION_COMPLETE
    self._spine:unregisterSpineEventHandler(eventType)
end

function SkeletonBase:setSkeletonRotation(rotation)
    self._spine:setRotation(rotation)
end

function SkeletonBase:isAnimationPlaying(trackIndex)
    return self._spine:getCurrent(trackIndex) ~= 0
end

function SkeletonBase:clearTrack(trackIndex)
    self._spine:clearTrack(trackIndex)
end

function SkeletonBase:clearTracks()
    self._spine:clearTracks()
end

function SkeletonBase:getSkeletonAnimation()
    return self._spine
end


return SkeletonBase