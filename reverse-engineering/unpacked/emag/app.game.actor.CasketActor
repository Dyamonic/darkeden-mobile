-- 棺材
local CasketActor = class("CasketActor", function()
    return display.newNode()
end)
local ResUtil = lt.ResUtil

function CasketActor:ctor()
    self.m_bInCasket = false
    self.m_CasketCount = 0
    self.m_CasketType = 0
    self.shouldCallMethod = 1 
    self._targetMark = false
    self._visibleFlag = true
    self._selectColor = nil

    self._casketSprite = display.newSprite("tlui/Etc_19.png")
    self._casketSprite:setAnchorPoint(cc.p(0.5, 0))
    self:addChild(self._casketSprite)
    self._casketSprite:setVisible(false)
    
    self._casetShadow = display.newSprite("tlui/Etc_20.png")
    self._casketSprite:setPosition(cc.p(0, -7))
    self._casetShadow:setAnchorPoint(cc.p(0, 0))
    self._casetShadow:setVisible(false)

end

function CasketActor:setPositionEx(pos)
    self._casetShadow:setPosition(pos.x - 56, pos.y)
end

function CasketActor:onClear()
    self._casketSprite = nil
    if self._casetShadow then
        self._casetShadow:removeFromParent()
    end
    self._casetShadow = nil

end

function CasketActor:addCasketSoon(type)
    self.m_bInCasket = true
    self.m_CasketCount = 0
    self.m_CasketCountInc = 0
    self.m_CasketType = type

    if  type == 0 and self._casetShadow then
        self._casetShadow:setVisible(true)
        if self._ownerAgent then
            self._ownerAgent:getActor():setHideSprite(true)
        end  
    end

    -- SetInvisibleSoon()

    -- if self:getClassType() == CLASS_PLAYER then
    --     g_pSkillAvailable:setAvailableSkills()
    -- end

    -- self.m_bEffectStatus[EFFECTSTATUS_CASKET] = true
    
    self:checkRegen()

    -- if g_pPlayer == self then
    --     UI_LockGear()
    -- end
end

function CasketActor:removeCasketSoon()
    self.m_bInCasket = false
    self.m_CasketCount = 64
    self.m_CasketCountInc = 0

    -- SetVisibleSoon()

    -- self.m_bEffectStatus[EFFECTSTATUS_CASKET] = false
    
    self:checkRegen()

    -- if g_pPlayer == self then
    --     UI_UnlockGear()
    -- end
end

function CasketActor:addCasket(type)
    self:addCasketSoon(type)
    self.m_CasketCount = 64
    self.m_CasketCountInc = -2
end

function CasketActor:removeCasket()
    self:removeCasketSoon()
    self.m_bInCasket = true
    self.m_CasketCount = 0
    self.m_CasketCountInc = 2
    if self._casetShadow then
        self._casetShadow:setVisible(false)
    end
end

function CasketActor:updateCasket()

    if self._spriteSelected then
        if self._visibleFlag then
            local IsTargetMark = self._targetMark
            self._spriteSelected:setVisible(IsTargetMark)
        else
            self._spriteSelected:setVisible(self._visibleFlag)
        end
        -- self._selectColor = lt.SkillModule:getSelectColor() --FIXME 暂时屏蔽描边功能
    end
    
    if self._selectColor then
        local size = self._casketSprite:getContentSize()
        local tex = self._casketSprite:getTexture()
        tex:setAliasTexParameters()
        self._pixelSize = cc.p(1 / size.width, 1 / size.height)
    end

    self.shouldCallMethod = self.shouldCallMethod + 1
    if self.shouldCallMethod > 4 then
        self.shouldCallMethod = 1
        if self.m_bInCasket then
            local incValue = self.m_CasketCountInc

            if self.m_CasketCount < 48 then
                if self.m_CasketCount < 32 then
                    incValue = incValue * 3
                else
                    incValue = incValue * 2
                end
            end

            self.m_CasketCount = self.m_CasketCount + incValue

            if self.m_CasketCount < 0 then
                self.m_CasketCount = 0
                self.m_CasketCountInc = 0
                self._casetShadow:setVisible(true)
                if self._ownerAgent then
                    self._ownerAgent:getActor():setHideSprite(true)
                end  
                self:checkRegen()
            elseif self.m_CasketCount > 64 then
                self.m_bInCasket = false
                self.m_CasketCount = 64
                self.m_CasketCountInc = 0
                if self._ownerAgent then
                    self._ownerAgent:getActor():removeCasketShot()
                end  
                self:checkRegen()
            end
            self:refreshCasketEffect(self.m_CasketCount)
        end
    end


end

function CasketActor:checkRegen()

end

function CasketActor:getOwnerAgent()

end

function CasketActor:refreshCasketEffect(casketValue)
    if self._casketSprite and tolua.isnull(self._casketSprite) ~= nil then
        lt.ShaderBackendUtil:makeCasketEffect(self._casketSprite, {casketValue = casketValue, pixelSize = self._pixelSize, selectColor = self._selectColor})
        if not self._casketSprite:isVisible() and self._visibleFlag then
            self._casketSprite:setVisible(true)
        end
    end
end

---- get
function CasketActor:getCasketCount()
    return self.m_CasketCount
end

function CasketActor:isInCasket()
    return self.m_bInCasket
end
function CasketActor:setInCasket(inCasket)
    self.m_bInCasket = inCasket
end

function CasketActor:getShadowActor()
    return self._casetShadow
end

function CasketActor:setVisibleEx(visible)
    self._visibleFlag = visible
    if self._casetShadow then
        if not self:isInCasket() then
            self._casetShadow:setVisible(false)
        else
            self._casetShadow:setVisible(visible)
        end
    end
end


function CasketActor:setOwnerID(ownerId)
    self._ownerId = ownerId
    local worldAgent = lt.AgentManager:getWorldAgent()
    self._ownerAgent = worldAgent:getAgent(self._ownerId)
end
function CasketActor:getOwnerID()
    return self._ownerId
end


return CasketActor