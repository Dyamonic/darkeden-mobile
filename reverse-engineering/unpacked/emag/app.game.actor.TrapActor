
local TrapActor = class("TrapActor", function()
    return display.newNode()
end)

local CacheManager = lt.CacheManager
local SkillEnum = lt.SkillEnum
local EffectQueueActor = lt.EffectQueueActor
local SkillManager = lt.SkillManager
local EffectParallelActor = lt.EffectParallelActor
local Constant = lt.Constant
local HeroAndMonsterEffect = lt.HeroAndMonsterEffect
local ScheduleUtil = lt.ScheduleUtil
local GameModule = lt.GameModule
local TimeTrigger = lt.TimeTrigger
local NtfManager = lt.NtfManager

TrapActor._timeTrigger    = nil
TrapActor._trapData = nil
TrapActor._nameNode = nil
TrapActor._actionMountInfo = nil
--[[
	陷阱
]]
function TrapActor:ctor(trapData)
	self._trapData = trapData
    self._specialEffectArr = {}

	local offsetX, offsetY = -25, 15
    local zorder = 0

	zorder = zorder + 1
	self._queueEffectNode = display.newNode()
    self._queueEffectNode:setPosition(offsetX, offsetY)

    if self._trapData:getSkillId() == SkillEnum.BLOODY_TUNNEL then
        self:createSelectNode()
    end


    
    self._nameNode = display.newNode()
    self._nameNode:setPosition(offsetX, offsetY)

    -- self._shadowActor = ShadowActor.new(2,nil)
    -- 路标
    if self._trapData:getSubObjType() == Constant.FloorSubType.FLOOR_CUSTOMIZE_TEXT then
        self:createCustomize()
    end
    self._timeTrigger = TimeTrigger.new()
    -- 坐骑
    if self._trapData:getSubObjType() == Constant.FloorSubType.FLOOR_SLAYER_RIDER then
        self:createMount()
    end 
    
    self:addChild(self._queueEffectNode, zorder)
	self._queueEffectActorArr = {}
	self._parallelEffectActorArr = {}
    local skillId = trapData:getSkillId()
    if skillId then
        self:playEffect(skillId,trapData:getSkillLevel())
    end
    self._disappearTime = trapData:getDisappearTime()
    if self._disappearTime > 0 then
        self._timeDisapearTrigger = TimeTrigger.new(self._disappearTime)
    end
end


function TrapActor:createSelectNode()
    ---选中tips
    self._selectLayer = display.newLayer(cc.c4b(0, 0, 0, 255), cc.size(85, 54))
    self._selectLayer:setColor(cc.c3b(49, 40, 24))
    self._selectLayer:setLocalZOrder(99999)
    self._selectLayer:setVisible(false)

    self._selectLayer:setAnchorPoint(cc.p(0.5, 0.5))

    local heroData = lt.GameModule:getHeroData()
    local heroName = heroData:getName()
    local mapName = lt.AgentManager:getWorldAgent():getMapAgent():getMapName()
    local m,n = self._trapData:getMN()

    local showInfos = {
        [1] = {text = string.format("X:%s Y:%s", m,n), color = cc.c3b(255, 203, 255)},
        [2] = {text = mapName, color = cc.c3b(255, 255, 255)},
        [3] = {text = heroName, color = cc.c3b(255, 255, 0)},
    }

    local maxWidth = 0
    for i, info in ipairs(showInfos) do
        local labelTitle = display.newTTFLabel({text=info.text, color = info.color, size = 13, font = lt.Constant.FONT_4})
        labelTitle:setAnchorPoint(0, 1)
        labelTitle:setPosition(8, 2.5 + i * 16)
        self._selectLayer:addChild(labelTitle)
        local size = labelTitle:getContentSize()
        if size.width > maxWidth then
            maxWidth = size.width
        end
    end

    local selectWidth = maxWidth + 16
    self._selectLayer:setContentSize(selectWidth, 54)

    --- 选中标志
    self._select = display.newSprite("ui/common/tunnelPoint.png")
    self._selectLayer:addChild(self._select)
    self._select:setAnchorPoint(cc.p(0.5, 0))
    self._select:setPosition(selectWidth / 2, -25)
end

-- 创建路牌
function TrapActor:createCustomize()
    local dimensions = cc.size(190, 0) -- 原大小(194 128)
    local _customizeBg = display.newSprite("game/common/bg_ggp_kuang.png",0,0,{scale9 = true, size = cc.size(194, 0), capInsets = cc.rect(11, 13, 164, 90)})
    local content = self._trapData:getName()
    local auther = self._trapData:getAuther()
    local showInfos = {
        [1] = {text = "From."..auther, color = cc.c3b(255, 255, 0),pos = { y= 20},align = cc.TEXT_ALIGNMENT_RIGHT},
        [2] = {text = content, color = cc.c3b(255, 255, 255),pos = { y= 40 }},
    }
    local height = 0
    for i, info in ipairs(showInfos) do
        local labelTitle = display.newTTFLabel({text=info.text, color = info.color, size = 18, font = lt.Constant.FONT_4,dimensions = dimensions ,align = info.align})
        labelTitle:setAnchorPoint(0, 0)
        local size = labelTitle:getContentSize()
        height = height + size.height
        labelTitle:setPosition(2,info.pos.y)
        _customizeBg:addChild(labelTitle)
    end
    _customizeBg:setAnchorPoint(0.5, 0)
    _customizeBg:setPosition(60, 50)
    _customizeBg:setOpacity(125) -- FIXME这边设置没有用
    _customizeBg:setContentSize(194,height + 25)
    -- self:addChild(_customizeBg,1)

    self._nameNode:addChild(_customizeBg)

    self._sprite = display.newSprite()
    self._sprite:setAnchorPoint(0.5, 0)
    self._sprite:setPosition(8, 0)
    self:addChild(self._sprite)
    self._actionInfo = lt.ActionManager:getActionMonsterInfo("monster", 139, 0, 2)

    self._spriteShadow = display.newSprite()
    self._spriteShadow:setAnchorPoint(0.5, 0)
    self._spriteShadow:setPosition(-40, 0)
    self:addChild(self._spriteShadow)
    self._actionSadowInfo = lt.ActionManager:getActionMonsterInfo("monster_s", 139, 0, 2, true)
end

-- 坐骑
function TrapActor:createMount()
    local mountId = self._trapData:getItemId()
    local mountInfo = lt.Constant.MOUNT_ITEMS[mountId]
    if not mountInfo then
        return 
    end
    local heroData = GameModule:getHeroData()
    local race = heroData:getRace()
    local sex = heroData:getSex()
    -- 魔族外需要设定性别
    if race ~= Constant.RaceType.Ousters then
        -- 服务器定义: 0男 1女, 所以本地需要 +1
        sex = sex + 1
    end

    local baseName = string.format("%d_%d_%d_%d", race, sex, mountInfo.adv, mountInfo.lv)

    local mountModelName = string.format("mount_%s", baseName)
    local mountModelShadowName = string.format("mount_s_%s", baseName)

    local offsetX, offsetY = -25, 15
    local zorder = 0
    self._trapNode = display.newNode()
    self._trapNode:setPosition(offsetX, offsetY)
    self:addChild(self._trapNode, zorder)

    local mZorder = 0
    --影子
    self._spriteShadowMount = display.newSprite()
    self._spriteShadowMount:setAnchorPoint(0.5, 0.5)
    self._trapNode:addChild(self._spriteShadowMount, mZorder)
    --模型
    mZorder = mZorder + 1
    self._spriteMount = display.newSprite()
    self._spriteMount:setAnchorPoint(0.5, 0.5)  
    self._trapNode:addChild(self._spriteMount, mZorder)

    local heroAgent = lt.AgentManager:getHeroAgent()
    local direction = heroAgent and heroAgent:getDirection() or Constant.DIRECTION_DOWN

    local action = lt.MountModule:getMountActionId(mountId)

    self._actionMountInfo = lt.ActionManager:getActionMountInfo(mountModelName, action, direction)
    self._actionMountShadowInfo = lt.ActionManager:getActionMountInfo(mountModelShadowName, action, direction ,true)
    -- 设置控制参数
    self._timeTrigger:reset(self._actionMountInfo:getStep())
    self._loopCount = 0
    self._nextFrameIndex = 1
    self:gotoNextFrame()
end

function TrapActor:getNameNode()
    return self._nameNode
end

function TrapActor:getSeletNode()
    return self._selectLayer
end

function TrapActor:setSelect(isSelect)
    self._selectLayer:setVisible(isSelect)
end

function TrapActor:getcustomizeLayer()
    return self._customizeLayer
end

function TrapActor:onClear()
    self:stopAllActions()
    
    self:removeAllParalEffect()
    self:removeAllParallelEffect()
    self:removeAllQueueEffect()
    if self._selectLayer then
        self._selectLayer:removeFromParent()
        self._selectLayer = nil
    end
    self:removeAllChildren()
    self._queueEffectNode = nil
    self._queueEffectActorArr = nil
    self._parallelEffectActorArr = nil
    self._actionInfo = nil
    self._actionSadowInfo = nil
    self._specialEffectArr = nil
    self._actionMountInfo = nil
    self._shadowActor = nil
    self._spriteMount = nil
end

function TrapActor:onUpdate()
	self:onUpdateQueueEffect()
    self:onUpdateParalEffect()
    self:updateFrameCustmoize()
    self:updateSpecicalEffect()
    self:onUpdateAction()
    self:onUpdateDisappear()
end

function TrapActor:onUpdateAction()
    if not self._actionMountInfo or not self._actionMountInfo:getLoop() then
        return
    end
    
    local frameCount = self._actionMountInfo:getSpriteFrameCount()
    local loop = self._actionMountInfo:getLoop()
    if loop ~= -1 and (self._loopCount >= loop or self._nextFrameIndex > frameCount) then
        return
    end
    if self._timeTrigger:tick() then
        self:gotoNextFrame()

        if self._nextFrameIndex > frameCount then
            self._nextFrameIndex = 1
            self._loopCount = self._loopCount + 1
        end
    end
end

function TrapActor:onUpdateDisappear() 
    if self._timeDisapearTrigger then
        if self._disappearTime > 0 and not self:isVisible() then
            self:setVisible(true)
        end
        if self._timeDisapearTrigger:tick() then
            if self:getAgent():isClearImmediately() then
                self:setVisible(false)
            else
                self:getAgent():playClearEffect()
            end
        end
    end
end

function TrapActor:gotoNextFrame()
    --- 已经下了坐骑
    self:onUpdateMount()
    self._nextFrameIndex = self._nextFrameIndex + 1
end

function TrapActor:onUpdateMount()
    if not self._actionMountInfo then
        return
    end
    self._spriteMount:setVisible(true)
    local frame = self._actionMountInfo:getSpriteFrame(self._nextFrameIndex)
    if frame then
        self._spriteMount:setSpriteFrame(frame.sprite)
        local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
        self._spriteMount:setPosition(pos)
    end

    local frame = self._actionMountShadowInfo:getSpriteFrame(self._nextFrameIndex)
    if frame then
        self._spriteShadowMount:setSpriteFrame(frame.sprite)
        local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
        self._spriteShadowMount:setPosition(pos)
    end
end

function TrapActor:updateFrameCustmoize()
    if not self._actionInfo then
        return
    end
    self._sprite:setVisible(true)
    local frame = self._actionInfo:getSpriteFrame(1)
    if frame then
        self._sprite:setSpriteFrame(frame.sprite)
    end

    if not self._actionSadowInfo then
        return
    end
    self._spriteShadow:setVisible(true)
    local frame = self._actionSadowInfo:getSpriteFrame(1)
    if frame then
        self._spriteShadow:setSpriteFrame(frame.sprite)
    end
end

function TrapActor:setPositionEx(x, y)
    self:setPosition(x, y)
    if self._shadowActor then
        self._shadowActor:setPosition(x, y)
    end

    if self._nameNode then
        local _, n = lt.MapUtil:calcMN(x, y)
        self._nameNode:setPosition(x, y)
        self._nameNode:setLocalZOrder(n)
    end
end

