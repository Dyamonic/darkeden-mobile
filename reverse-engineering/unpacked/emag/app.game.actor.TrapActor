function TrapActor:playEffect(skillId,skillLevel)
	-- if skillId == SkillEnum.SKILL_GREEN_POISON or skillId == SkillEnum.SKILL_YELLOW_POISON or skillId == SkillEnum.MAGIC_ACID_SWAMP then
		-- 荧绿之毒 艳黄之毒 酸性沼泽 队列类型
    if skillId == SkillEnum.SKILL_MERCY_GROUND 
    or skillId == SkillEnum.MAGIC_REGENERATION 
    or skillId == SkillEnum.SKILL_SWORD_OF_THOR
    or skillId == SkillEnum.MAGIC_GROUND_ATTACK
    or skillId == SkillEnum.MAGIC_BLOODY_SNAKE
    or skillId == SkillEnum.SKILL_ICE_WAVE
    or skillId == SkillEnum.SKILL_THROWING_AXE
    or skillId == SkillEnum.SKILL_CHOPPING_FIREWOOD 
    or skillId == SkillEnum.SKILL_CHAIN_THROWING_AXE 
    or skillId == SkillEnum.SKILL_MULTI_THROWING_AXE
    or skillId == SkillEnum.SKILL_DRAGON_TORNADO
    then
        self:playParallelEffectMetasDelay(skillId,skillLevel)
    elseif skillId == SkillEnum.SKILL_INSTALL_TRAP  then
        local worldAgent = lt.AgentManager:getWorldAgent()
        local heroAgent = worldAgent:getHeroAgent()
        if heroAgent:getRaceType() == Constant.RaceType.Slayer then -- 人族
            self:playParallelEffectMetasDelay(skillId,skillLevel) 
        end
    elseif skillId == SkillEnum.SKILL_SANCTUARY then
        self:playQueueEffectByLv(skillId, skillLevel, Constant.EFFECT.SELF)
    elseif skillId == SkillEnum.SKILL_ICE_HORIZON then
        self:playQueueEffectByLv(skillId, skillLevel, Constant.EFFECT.HIT)
    elseif skillId == (SkillEnum.SKILL_INSTALL_TRAP .. "CLIENT") then
    elseif skillId == SkillEnum.SKILL_HALO then
        local sx, sy = self._trapData:getMN()

        -- local bullet = lt.BullectScreenEffect.new(skillId, 0, cc.p(sx, sy + sz))
        -- bullet:addEffect(self._skillId, processMetas[1], true)
        -- local zorder = (trapN  * 10000 + trapM + 9999) * 10 + 1
        -- lt.BulletManager:addBulletToMapZOrder(bullet, zorder)
        --固定的
        self:playQueueEffectByLv(skillId, skillLevel, Constant.EFFECT.SELF)
        lt.SkillManager:playTraceHole(skillId, self._trapData:getTargetId(), sx, sy, self._trapData:getObjId())
    
    elseif skillId == SkillEnum.SKILL_SHINE_SWORD then
        if self:isTrapTop() then
            self:playParallelEffectMetasDelay(skillId,skillLevel)
        else
            self:playQueueEffectByLv(skillId, skillLevel, Constant.EFFECT.SELF)
        end
    elseif skillId == SkillEnum.SKILL_SUMMON_CLAY  then
        self:playQueueEffectByLv(skillId, skillLevel, Constant.EFFECT.SELF)
    elseif skillId == SkillEnum.SKILL_HEAVEN_GROUND then
        self:playParallelEffectMetasDelay(skillId,skillLevel)
    elseif skillId == SkillEnum.SKILL_HELLFIRE then
        local effectMetas = CacheManager:getHitMetas(skillId,skillLevel)
        local effectParabolaActor = EffectParallelActor.new(self, skillId, 0)
        self._queueEffectNode:addChild(effectParabolaActor)
        effectParabolaActor:addEffect(skillId, {effectMetas[1],effectMetas[2], effectMetas[3]})
        table.insert(self._parallelEffectActorArr, effectParabolaActor)

        local effectQueueActor = EffectQueueActor.new(self, skillId, 0)
        effectQueueActor:addEffect(skillId, {effectMetas[4], effectMetas[5]})
        self._queueEffectNode:addChild(effectQueueActor)
        table.insert(self._queueEffectActorArr, effectQueueActor)
    elseif skillId == SkillEnum.SKILL_FURY_OF_GNOME then
        local actionInfoMetas = lt.CacheManager:getBuffMetas(skillId,skillLevel)
        local metas = {actionInfoMetas[1],actionInfoMetas[2],actionInfoMetas[3]}
        local metasStone = {actionInfoMetas[4],actionInfoMetas[5],actionInfoMetas[6]}
        if self:isTrapBottom() then
            self:addSpecialEffect(skillId, metas)
        else
            self:addSpecialEffect(skillId, metasStone)
        end
    elseif skillId == SkillEnum.SKILL_ICE_FIELD 
    or skillId == SkillEnum.SKILL_WIDE_ICE_FIELD 
    then
        local hitMetas = lt.CacheManager:getHitMetas(skillId,skillLevel)
        self:addSpecialEffect(skillId, hitMetas)
    elseif skillId == SkillEnum.SKILL_MAGIC_METEOR then
        local function endCallBack()
            if self and self._queueEffectNode then
                local actionInfoMetas = CacheManager:getBulletMetas(skillId)
                local effectParabolaActor = EffectParallelActor.new(self, skillId, 0)
                self._queueEffectNode:addChild(effectParabolaActor)
                effectParabolaActor:addEffect(skillId, {actionInfoMetas[2], actionInfoMetas[3]})
                table.insert(self._parallelEffectActorArr, effectParabolaActor)
            end
        end
        local targetM, targetN = self._trapData:getMN()
        local tx, ty = lt.MapUtil:calcMNMid(targetM, targetN)
        lt.SkillManager:playMagicMeteor({skillId = skillId, tx = tx, ty = ty, callback = endCallBack})
    else
        self:playQueueEffectDelay(skillId)
    end
	-- end
end

function TrapActor:playQueueEffectDelay(skillId)
    local delayTime = SkillManager:getActionDelayTime(skillId)
    delayTime = delayTime * self:getSlowDown()
    if skillId == SkillEnum.SKILL_CASTING_FIRE then
        delayTime = 1
    end

    if delayTime > 0 then
        local delayAction = cc.Sequence:create(cc.DelayTime:create(delayTime),cc.CallFunc:create(function()
            self:playQueueEffect(skillId)
        end))
        self:runAction(delayAction)
    else
        self:playQueueEffect(skillId)
    end
end

function TrapActor:playParallelEffectMetasDelay(skillId,skillLevel)
    local delayTime = SkillManager:getActionDelayTime(skillId)
    delayTime = delayTime * self:getSlowDown()
    if delayTime > 0 then
        local delayAction = cc.Sequence:create(cc.DelayTime:create(delayTime),cc.CallFunc:create(function()
            self:playParallelEffectByLv(skillId,skillLevel)
        end))
        self:runAction(delayAction)
    else
        self:playParallelEffectByLv(skillId,skillLevel)
    end
end

-- ***************** 并列式播放特效 ************************
function TrapActor:playParallelEffectByLv(skillId, skillLevel)
    if not self._queueEffectNode then
        return
    end

    local effectParabolaActor = EffectParallelActor.new(self, skillId, 0)
    self._queueEffectNode:addChild(effectParabolaActor)
    
    table.insert(self._parallelEffectActorArr, effectParabolaActor)

    if skillId == SkillEnum.SKILL_MERCY_GROUND then
        local effectMetas = CacheManager:getHitMetas(skillId,skillLevel) or {}
        local tempMetas = {}
        if self._trapData and self._trapData:getGroundIndex() then
            local groundIndex = self._trapData:getGroundIndex()
            local changeGroundIndex = {1, 4, 7, 2, 5, 8, 3, 6, 9}
            local offsetPosArr = {
                {x = 48, y = -24}, {x = 0, y = -24}, {x = -48, y = -24}, {x = 48, y = 0}, {x = 0, y = 0}, {x = -48, y = 0}, {x = 48, y = 24}, {x = 0, y = 24}, {x = -48, y = 24}
            }
            groundIndex = changeGroundIndex[groundIndex]
            if offsetPosArr[groundIndex] then
                effectParabolaActor:setPosition(offsetPosArr[groundIndex].x, offsetPosArr[groundIndex].y)
            end
            if groundIndex == 5 then
                tempMetas[1] = effectMetas[1]
            end
            tempMetas[#tempMetas+1] = effectMetas[groundIndex+1]
        end
        for i,meta in ipairs(tempMetas) do
            meta._order = i
        end

        if tempMetas[#tempMetas] and tempMetas[#tempMetas].getOrder then
            effectParabolaActor:setLoopOrder(tempMetas[#tempMetas]:getOrder())
        end
        effectParabolaActor:addEffect(skillId, tempMetas) 
    elseif skillId == SkillEnum.SKILL_INSTALL_TRAP then
        local effectMetas = CacheManager:getHitMetas(skillId,skillLevel)
        effectParabolaActor:setLoopOrder(1)
        effectParabolaActor:addEffect(skillId, effectMetas)
    elseif skillId == SkillEnum.MAGIC_REGENERATION then
        local effectMetas = CacheManager:getBuffMetas(skillId,skillLevel)
        effectParabolaActor:setLoopOrder(2)
        effectParabolaActor:addEffect(skillId, effectMetas)
    elseif skillId == SkillEnum.SKILL_SHINE_SWORD then
        local effectMetas = CacheManager:getHitMetas(skillId,skillLevel)
        effectParabolaActor:addEffect(skillId, effectMetas)
    elseif skillId == SkillEnum.SKILL_HEAVEN_GROUND then
        local effectMetas = CacheManager:getBuffMetas(skillId,skillLevel)
        effectParabolaActor:addEffect(skillId, effectMetas)
    elseif skillId == SkillEnum.SKILL_DRAGON_TORNADO then -- 巨龙卷风
        local effectMetas = CacheManager:getBuffMetas(skillId,skillLevel)
        if self._trapData:getIsTornadoParent() == 1 then
            effectParabolaActor:addEffect(skillId, {effectMetas[1]})
        else
            if effectMetas[2] then
                effectMetas[2]:setOrder(1)
            end
            effectParabolaActor:addEffect(skillId, {effectMetas[2]})
        end
    elseif skillId == SkillEnum.MAGIC_GROUND_ATTACK then
        local effectMetas = CacheManager:getBuffMetas(skillId,skillLevel)
        effectParabolaActor:addEffect(skillId, effectMetas)
    elseif skillId == SkillEnum.MAGIC_BLOODY_SNAKE 
    or skillId == SkillEnum.SKILL_ICE_WAVE
    then
        local effectMetas = CacheManager:getProcessMetas(skillId, skillLevel)
        effectParabolaActor:addEffect(skillId, effectMetas)
    elseif skillId == SkillEnum.SKILL_THROWING_AXE 
    or skillId == SkillEnum.SKILL_CHOPPING_FIREWOOD 
    or skillId == SkillEnum.SKILL_CHAIN_THROWING_AXE 
    or skillId == SkillEnum.SKILL_MULTI_THROWING_AXE 
    then
        local effectMetas = CacheManager:getBuffMetas(skillId, skillLevel)
        effectParabolaActor:addEffect(skillId, effectMetas)
        local delayTime = effectMetas[1]:getDelayFrame() / 1000
        ScheduleUtil:performWithDelayGlobal(function()
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_EVENTFLAG_SHAKE_SCREEN, {eventDelay = 500, parameter3 = 3, eventType = Constant.SHARK_SCREEN_TYPE.EVENTID_METEOR_SHAKE})
        end, delayTime)

    elseif skillId == SkillEnum.SKILL_SWORD_OF_THOR then
        local effectMetas = CacheManager:getProcessMetas(skillId,skillLevel)
        effectParabolaActor:addEffect(skillId, effectMetas)

        ---三个永久的
        --[[
        固定多久消失， -》多久出现
        ]]
        local hitMetas = CacheManager:getHitMetas(skillId,skillLevel)
        self._specialEffectArr = {}
        for key, hitMeta in ipairs(hitMetas) do
            local delayTime = hitMeta:getDelayFrame() / 1000
            ScheduleUtil:performWithDelayGlobal(function()
                if self and self._specialEffectArr then
                    local effectActor = lt.EffectActor.new(hitMeta, 1, nil, true)
                    if hitMeta:getEffectId() == 1007 then
                        effectActor:setRandomDraw(true)
                    end
                    table.insert(self._specialEffectArr, effectActor)
                    self:addChild(effectActor)
                    effectActor:setPosition(-25, 15)
                end
            end, delayTime)
        end

        ScheduleUtil:performWithDelayGlobal(function()
            if self and self._specialEffectArr then
                for _, effectActor in pairs(self._specialEffectArr) do
                    effectActor:setVisible(false)
                end
            end
        end, 0.24)

        ScheduleUtil:performWithDelayGlobal(function()
            if self and self._specialEffectArr then
                for _, effectActor in pairs(self._specialEffectArr) do
                    effectActor:setVisible(true)
                end
            end
        end, 0.37)
    end
end

-- 清除某个持续特效
function TrapActor:removeParalEffect(skillId)
    for i, effectActor in ipairs(self._parallelEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            effectActor:onClear()
            table.remove(self._parallelEffectActorArr, i)
            break
        end
    end
end

-- 主要是停止循环播放的队列
function TrapActor:stopParallelEffect(skillId)
    for i, effectActor in ipairs(self._parallelEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            effectActor:stopParallelEffect()
            break
        end
    end
end

function TrapActor:onUpdateParalEffect()
	local parallelEffectActorArr = self._parallelEffectActorArr 
	if not parallelEffectActorArr or #parallelEffectActorArr == 0 then
		return
	end
    local removeTable = {}
	for index, effectActor in ipairs(parallelEffectActorArr) do
        if effectActor then
            if effectActor:isCloseEffect() then
                removeTable[index] = true
                if self._trapData:getSkillId() == SkillEnum.SKILL_CHAIN_THROWING_AXE
                or self._trapData:getSkillId() == SkillEnum.SKILL_THROWING_AXE
                or self._trapData:getSkillId() == SkillEnum.SKILL_CHOPPING_FIREWOOD
                or self._trapData:getSkillId() == SkillEnum.SKILL_MULTI_THROWING_AXE then
                    --BOSS飞斧特殊释放
                    if self._agent:inDisappearing() then
                        self._agent:deleteSelfFromTable()
                    end
                end
            else
                effectActor:onUpdate()
            end
        end
	end

    self:removeEffectFromRemoveTable(parallelEffectActorArr, removeTable)
end

-- ***************** 列表式播放特效 ************************
function TrapActor:playQueueEffect(skillId)
    if not self._queueEffectNode then
        return
    end

    local effectQueueActor = EffectQueueActor.new(self, skillId, 0)
    self._queueEffectNode:addChild(effectQueueActor)

    -- 此处存在2个一样的技能效果 移除时会出问题，存在不及时移除
    table.insert(self._queueEffectActorArr, effectQueueActor)

    if skillId == SkillEnum.SKILL_GREEN_POISON then
        -- 荧绿之毒 
        effectQueueActor:setLoopOrder(2) -- 循环的队列顺序
        effectQueueActor:addEffectEName(skillId, "result_magic_green_poison")
	elseif skillId == SkillEnum.SKILL_YELLOW_POISON then
		-- 艳黄之毒
		effectQueueActor:setLoopOrder(2) -- 循环的队列顺序
        effectQueueActor:addEffectEName(skillId, "result_magic_yellow_poison")
    elseif skillId == SkillEnum.MAGIC_ACID_SWAMP then
		-- 酸性沼泽
		effectQueueActor:setLoopOrder(2) 
        effectQueueActor:addEffectEName(skillId, "result_magic_acid_swamp")
    elseif skillId == SkillEnum.MAGIC_BLOODY_WALL then
        effectQueueActor:setLoopOrder(1)  --血墙
        effectQueueActor:addEffectEName(skillId, "result_magic_bloody_wall")
    elseif skillId == SkillEnum.SKILL_CASTING_FIRE then
        effectQueueActor:setLoopOrder(2)  --地狱火海
        effectQueueActor:addEffectEName(skillId, "result_skill_prominence_" .. self._trapData:getSkillLevel())
    elseif skillId == SkillEnum.BLOODY_TUNNEL then
        effectQueueActor:setLoopOrder(2)  --血之漩涡
        effectQueueActor:addEffectEName(skillId, "result_magic_bloody_tunnel")
    elseif skillId == SkillEnum.HAND_OF_DARKNESS or skillId == SkillEnum.SKILL_GRAY_DARKNESS then
        local effectMetas = CacheManager:getBuffMetas(skillId)
        effectQueueActor:setLoopOrder(2)
        local random = math.random(0, 4)
        local tempMetas = clone(effectMetas)
        for index, meta in ipairs(tempMetas) do
            meta._spriteId = meta:getSpriteId() + random
        end
        effectQueueActor:addEffect(skillId, tempMetas)
        effectQueueActor:setStartFrameIndex(math.random(1,10))
    else
        effectQueueActor:addEffectGenerator(skillId, 0) 
    end
end

function TrapActor:addSpecialEffect(skillId, metas)
    if not self._queueEffectNode then
        return
    end

    local effectQueueActor = EffectQueueActor.new(self, skillId, 0)
    self._queueEffectNode:addChild(effectQueueActor)
    table.insert(self._queueEffectActorArr, effectQueueActor)

    effectQueueActor:addEffect(skillId, metas)

end

function TrapActor:playQueueEffectByLv(skillId, skillLevel, effectName)
    HeroAndMonsterEffect:playQueueEffectByLv(self, skillId, skillLevel, effectName)
end

-- 主要是停止循环播放的队列
function TrapActor:stopQueueEffect(skillId)
    if self._queueEffectActorArr and (#self._queueEffectActorArr or table.nums(self._queueEffectActorArr)) == 0 then
        if self._agent:inDisappearing() then
            self:checkParalAndQueueEffectEnd()
        end
        return--没有停止的动作
    end
    for i, effectActor in ipairs(self._queueEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            effectActor:stopQueueEffect()
            break
        end
    end
end

-- 清除某个持续特效
function TrapActor:removeQueueEffect(skillId)
    for i, effectActor in ipairs(self._queueEffectActorArr) do
        if skillId == effectActor:getSkillId() then
            effectActor:onClear()
            table.remove(self._queueEffectActorArr, i)
            break
        end
    end
end

function TrapActor:onUpdateQueueEffect()
	local queueEffectActorArr = self._queueEffectActorArr 
	if not queueEffectActorArr or #queueEffectActorArr == 0 then
        if self._agent:inDisappearing() then
            self:checkParalAndQueueEffectEnd()
        end
		return
	end
    local removeTable = {}
	for index, effectActor in pairs(queueEffectActorArr) do
        if effectActor:isEndEffect() then
            removeTable[index] = true
            if self._agent:inDisappearing() then
                self:checkParalAndQueueEffectEnd()
            end
        end
		effectActor:onUpdate()
	end
    self:removeEffectFromRemoveTable(queueEffectActorArr, removeTable)
    
end

-- 清除某个全部持续特效
function TrapActor:removeAllQueueEffect()
    for i, effectActor in ipairs(self._queueEffectActorArr) do
        effectActor:onClear()
        table.remove(self._queueEffectActorArr, i)
        self:checkParalAndQueueEffectEnd()
        break
    end
end
--检测并行和穿行都消失
function TrapActor:checkParalAndQueueEffectEnd()
    if self._trapData:getSkillId() == SkillEnum.SKILL_CHAIN_THROWING_AXE
        or self._trapData:getSkillId() == SkillEnum.SKILL_THROWING_AXE
        or self._trapData:getSkillId() == SkillEnum.SKILL_CHOPPING_FIREWOOD
        or self._trapData:getSkillId() == SkillEnum.SKILL_MULTI_THROWING_AXE then
        --BOSS的技能走并行结束释放
    else
        if self._agent:inDisappearing() then
            self._agent:deleteSelfFromTable()
        end
    end
end
-- ***************** 列表特效 end ************************

function TrapActor:updateSpecicalEffect()
    if not self._specialEffectArr then
        return
    end
    if #self._specialEffectArr > 0 then
        local removeTable = {}
        for index, effect in pairs(self._specialEffectArr) do
            if effect then
                if effect:isEndEffect() then
                    removeTable[index] = true
                else
                    effect:onUpdateEffect()
                end
            end
        end
        self:removeEffectFromRemoveTable(self._specialEffectArr, removeTable)
    end
end

function TrapActor:setAgent(agent)
    self._agent = agent
end
function TrapActor:getAgent()
    return self._agent
end

function TrapActor:conversionOffsetPoint(point, offset, size)
    local conX, conY
    conX = point.x + offset.x + size.width/2
    conY = point.y - offset.y - size.height/2
    return cc.p(conX, conY)
end

function TrapActor:isTrapTop()
    if not self._trapData then
       return false 
    end

    local clientObjId = self._trapData:getClientObjId() or ""

    local start,_,_ = string.find(clientObjId, Constant.CLIENTIDNAME.TRAPTOP)
    return (start or 0) > 0
end

function TrapActor:isTrapBottom()
    if not self._trapData then
       return false 
    end

    local clientObjId = self._trapData:getClientObjId() or ""

    local start,_,_ = string.find(clientObjId, Constant.CLIENTIDNAME.TRAPBOTTOM)
    return (start or 0) > 0
end

function TrapActor:getSlowDown()
    if not self._trapData then
        return lt.Constant.STEPMULTIPLE.ONE
    end
    local isSlowDown = self._trapData:getIsSlowDown()
    if isSlowDown then
        return lt.Constant.STEPMULTIPLE.TWO
    end

    return lt.Constant.STEPMULTIPLE.ONE
end

--清掉所有持续特效
function TrapActor:removeAllParalEffect()
    if self._parabEffectActorArr then
        for i = #self._parabEffectActorArr, 1, -1 do
            if self._parabEffectActorArr[i].onClear then
                self._parabEffectActorArr[i]:onClear()
            end
            table.remove(self._parabEffectActorArr, i)
        end
    end
    
    if self._rotateEffectActorArr then
        for j = #self._rotateEffectActorArr, 1, -1 do
            if self._rotateEffectActorArr[j].onClear then
                self._rotateEffectActorArr[j]:onClear()
            end
            table.remove(self._rotateEffectActorArr,j)
        end
    end
end

function TrapActor:removeAllParallelEffect()
    if self._parallelEffectActorArr == nil then
        return
    end
    for i = #self._parallelEffectActorArr, 1, -1 do
        if self._parallelEffectActorArr[i].onClear then
            self._parallelEffectActorArr[i]:onClear()
        end
        table.remove(self._parallelEffectActorArr, i)
    end
end

function TrapActor:getRotateEffectActorArr()
    return self._rotateEffectActorArr
end

function TrapActor:getDirection()
    return Constant.DIRECTION_LEFT
end

function TrapActor:getRoleData()
    return nil
end

function TrapActor:getQueueEffectNode()
    return self._queueEffectNode
end

function TrapActor:getParabEffectActorArr()
    return self._parabEffectActorArr
end

function TrapActor:getQueueEffectActorArr()
    return self._queueEffectActorArr
end

function TrapActor:addParabEffectActor(parabEffectActor)
    if self._parabEffectActorArr then
        table.insert(self._parabEffectActorArr, parabEffectActor)
    end
end

-- 清理removeTable
function TrapActor:removeEffectFromRemoveTable(originEffectArr, removeTable)
    if  #originEffectArr == 0 or table.nums(removeTable) == 0 then
        return
    end

    for i = #originEffectArr, 1, -1 do
        if removeTable[i] then
            originEffectArr[i]:onClear()
            table.remove(originEffectArr,i)
        end
    end
end

return TrapActor
