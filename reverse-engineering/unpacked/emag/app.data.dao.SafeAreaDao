
local SafeAreaDao = {}

function SafeAreaDao:queryAll()
    local safeAreaMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM SafeArea;") do
        local safeAreaMeta = lt.SafeAreaMeta.new(row)
        if not safeAreaMap[safeAreaMeta:getMapCode()] then
            safeAreaMap[safeAreaMeta:getMapCode()] = {}
        end
        table.insert(safeAreaMap[safeAreaMeta:getMapCode()], safeAreaMeta)
    end

    return safeAreaMap
end

return SafeAreaDao
