local HelpMeta = class("HelpMeta")

function HelpMeta:ctor(row)
    self:initWithRow(row)
end

function HelpMeta:initWithRow(row)
    self._idxId     = row.IdxId
    self._type      = row.Type
    self._typeName  = row.TypeName
    self._race      = row.Race
    self._title     = row.Title
    self._summarize = row.Summarize
    self._content   = row.Content
end

-- AUTO GENERATED GETTERS START
