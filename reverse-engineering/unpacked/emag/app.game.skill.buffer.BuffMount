local BuffMount = class("BuffMount", lt.BufferBaseItem)
local BuffEnum = lt.BuffEnum

--[[
    坐骑
]]
function BuffMount:ctor(agent, itemId, source)
    BuffMount.super.ctor(self, BuffEnum.EFFECT_CLASS_SLAYER_MOUNT, agent, itemId, source)
    local mountInfo = lt.Constant.MOUNT_ITEMS[itemId]
    if not mountInfo then
        return
    end
    yflog:Info("--------itemId=%s == == srcType= %s",itemId,source.srcType)
    agent:changeMountId(itemId)
    -- 上坐骑
    if not agent:getIsSelf() then
        local m, n = agent:getMN()
        local direction = agent:getDirection()
        local cmd = lt.CmdMount.new(m, n, direction)
        agent:getCmdSystem():pop()
        agent:getCmdSystem():push(cmd)
        agent:handleCmd(cmd)
    else
        agent:changeState(lt.HeroStateMountIdle.new(agent))
    end
end

function BuffMount:onClear()
    -- 下坐骑
    self._agent:changeState(lt.HeroStateIdle.new(self._agent))
    self._agent:changeMountId(0)
    BuffMount.super.onClear(self)
end

return BuffMount
