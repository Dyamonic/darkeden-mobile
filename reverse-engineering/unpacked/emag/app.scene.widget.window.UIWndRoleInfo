function UIWndRoleInfo:ctor(param)
    self:registerComponent("UICompRoleSkill","UICompTransfer","UICompMagicO","UICompMagicS","UICompMagicV","UICompSkillTips")
    UIWndRoleInfo.super.ctor(self, param)
    self._selectIndex = nil

    self._clsCom = nil
    self._magicCom = nil
    self._transferCom = nil

    self._attrListLeft = nil
    self._attrItemListLeft = nil
end

function UIWndRoleInfo:onClear()
    self:unregisterAllComponent()
    UIWndRoleInfo.super.onClear(self)
    self._selectIndex = nil

    self._clsCom = nil
    self._magicCom = nil
    self._transferCom = nil

    self._attrListLeft = nil
    self._attrItemListLeft = nil
    self._localZorder = nil
end

function UIWndRoleInfo:onEnter()
    --判断是否清洗技能
    local param = self:getParam().param or {}
    self._type = param.tabId or 1
    self._selectIndex = self._type == Constant.ENTER_TYPES.FORGET and Constant.ENTER_TYPES.LEARN or self._type
end

function UIWndRoleInfo:onShown()
    UIWndRoleInfo.super.onShown(self)
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_HERO_EVENT, handler(self, self.refreshHeroInfo), "UIWndRoleInfo:refreshHeroInfo")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_INIT_PASSIVE_SKILL_LIST, handler(self, self.onRefreshClsList), "UIWndRoleInfo:onRefreshClsList")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_INIT_SKILL_LIST, handler(self, self.onRefreshSkillList), "UIWndRoleInfo:onRefreshSkillList")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_HPMP_EVENT, handler(self, self.refreshAttrLeft), "UIWndRoleInfo:refreshAttrLeft")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CHANGE_SETTINGS, handler(self, self.changeSettings), "UIWndRoleInfo:changeSettings")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_RED_DOT_EVENT, handler(self, self.uptRedDotEvt), "UIWndRoleInfo:uptRedDotEvt")

    for i = 1, #self.btnList do
        self.btnList[i]:setVisible(self._type ~= Constant.ENTER_TYPES.FORGET) 
    end
    self:refreshBtnState()
    self:showCurPanel()
    self:refreshHeroInfo()
    self:setBGOpacity()
    --刷新技能红点
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_RED_DOT_EVENT,{name = "SkillRedTips"})

    self:refreshCloseBtn()
    self:addAllBtnClik()
    self:addInfoAttrClick()
    self:addAttrLeftClick()
    self:fixReview()
end

function UIWndRoleInfo:onHide()
    NtfManager:removeNtfListenerByTag("UIWndRoleInfo:refreshHeroInfo")
    NtfManager:removeNtfListenerByTag("UIWndRoleInfo:onRefreshClsList")
    NtfManager:removeNtfListenerByTag("UIWndRoleInfo:onRefreshSkillList")
    NtfManager:removeNtfListenerByTag("UIWndRoleInfo:refreshAttrLeft")
    NtfManager:removeNtfListenerByTag("UIWndRoleInfo:changeSettings")
    NtfManager:removeNtfListenerByTag("UIWndRoleInfo:uptRedDotEvt")

    local race = GameModule:getHeroRace()
    --清除魔法类型缓存
    if self._magicCom and race == RaceType.Ousters then
        self._magicCom:setType(nil)
    end

    local closeBtn = self:getChild("frame"):getChild("closeButton1")
    closeBtn:removeClickListener()

    self:clearAllBtnClik()
    self:clearInfoAttrClick()
    self:clearAttrLeftClick()
    UIWndRoleInfo.super.onHide(self)
end

function UIWndRoleInfo:resetZOrder()
    local localZorder = self._localZorder or self:getLocalZOrder() - 1
    self:setLocalZOrder(localZorder)
    -- print("UIWndRoleInfo 重置因reopen而叠加上来的zorder:",localZorder)
    self._localZorder = localZorder
end

