function UIWndRoleInfo:refreshCloseBtn()
    local closeBtn = self:getChild("frame"):getChild("closeButton1")
    closeBtn:addClickListener(function()
        if WndLockManager:getWndLockType() == Constant.WndLockType.SkillTips then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndLock", close = true})
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndRoleInfo", close = true})
        end
    end)
end

function UIWndRoleInfo:setBGOpacity()
    local editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.INFO_OPACITY)
    self.isBGOpacity = editTable.switch == 1
    if self.isBGOpacity then
        editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.WINDOW_OPACITY)
        self._diOpacity:setAlpha(editTable.value/100)
    else
        self._diOpacity:setAlpha(1)
    end
    self._bg:setVisible(not self.isBGOpacity)
    self._bgOpacity:setVisible(self.isBGOpacity)
    self._diOpacity:setVisible(self.isBGOpacity)
end

function UIWndRoleInfo:showCurPanel()
    -- 角色界面
    local infoCom = self:getChild("infoCom")
    infoCom:setVisible(self._selectIndex == btnType.role)

    -- 阶级技能界面
    if not self._clsCom then
        self._clsCom = fgui.UIPackage:createObject("RoleInfo", "ClsCom");--self:getChild("clsCom")
        self._clsCom:setPosition(46,33)
        self._clsCom:initUI()
        self._clsCom:insertObjectToFactory(self)
        self:addChild(self._clsCom)
    end
    if self._selectIndex == btnType.lowCls or self._selectIndex == btnType.superCls then
        self._clsCom:setVisible(true)
        self._clsCom:refreshPanelByCls(self._selectIndex,true)
    else
        self._clsCom:setVisible(false)
    end

    -- 转职界面
    if not self._transferCom then
        self._transferCom = fgui.UIPackage:createObject("RoleInfo", "TransferCom");--self:getChild("clsCom")
        self._transferCom:setPosition(46,33)
        self._transferCom:initUI()
        self._transferCom:insertObjectToFactory(self)
        self:addChild(self._transferCom)
    end
    self._transferCom:setVisible(self._selectIndex == btnType.transfer)
    if self._transferCom:isVisible() then
        self._transferCom:refreshCurInfo(true)
    end

    local race = GameModule:getHeroRace()
    -- 魔法界面
    if not self._magicCom then
        local magicComName = nil
        if race == RaceType.Ousters then
            magicComName = "MagicOCom"
        elseif race == RaceType.Slayer then
            magicComName = "MagicSCom"
        else
            magicComName = "MagicVCom"
        end
        self._magicCom = fgui.UIPackage:createObject("RoleInfo", magicComName);--self:getChild("clsCom")
        self._magicCom:setPosition(46,33)
        self._magicCom:initUI()
        self._magicCom:insertObjectToFactory(self)
        self:addChild(self._magicCom)
    end
    self._magicCom:setVisible(self._selectIndex == btnType.magic)
    if self._magicCom:isVisible() then
        if race == RaceType.Ousters then
            if self._type == 1 then
                self._type = Constant.ENTER_TYPES.LEARN
            end
            self._magicCom:setType(self._type)
            self._magicCom:refreshCurInfo()
        else
            self._magicCom:refreshCurInfo(true)
        end
    end

    -- local superClsCom = self:getChild("lowClsCom")
    -- superClsCom:setVisible(self._selectIndex == btnType.superCls)
end


function UIWndRoleInfo:fixReview()
    if _G_IS_EXAMINE then
        self.btnList[btnType.transfer]:setVisible(false)
    end
end

function UIWndRoleInfo:initAllBtn()
    self.btnList = {}
    local race = GameModule:getHeroRace()
    local btnOffsetY = -5
    if race == RaceType.Ousters then
        btnOffsetY = -15
    end
    for i,v in ipairs(btnInfo) do
        local btnItem = fgui.UIPackage:createObject("RoleInfo", "TitleBtn2")
        btnItem.index = i
        self.btnList[btnItem.index] = btnItem
        local size = btnItem:getSize()
        local name = v.name

        local nameText = ccui.Text:create()
        nameText:setFontName(Constant.FONT_4)
        nameText:setFontSize(20)
        nameText:setTextColor(cc.c3b(255, 254, 254))
        nameText:enableShadow(cc.c3b(255, 254, 254), cc.size(0, 0), 3)
        nameText:setPosition(cc.p(59, 18))
        btnItem.nameText = nameText
        btnItem:displayObject():addChild(nameText)
        nameText:setString(name)

        local nameSelect = ccui.Text:create()
        nameSelect:setFontName(Constant.FONT_4)
        nameSelect:setFontSize(20)
        nameSelect:setTextColor(cc.c3b(149, 150, 149))
        nameSelect:setPosition(cc.p(59, 18))
        btnItem.nameSelect = nameSelect
        btnItem:displayObject():addChild(nameSelect)
        nameSelect:setString(name)

        btnItem:setPosition(50+10+(i-1)*(size.width-10),btnOffsetY-15)
        btnItem:setSortingOrder(topOrder-i)
        local isRed = SkillModule:getRedPoint(i)
        btnItem:getChild("reddot"):setVisible(isRed)
        self:addChild(btnItem)
    end
end

function UIWndRoleInfo:addAllBtnClik()
    local function btnClik(context)
        local btnItem = context:getSender()
        if btnItem.index == btnType.role then
            -- print("role")
            self._selectIndex = btnItem.index
        elseif btnItem.index == btnType.lowCls then
            -- print("lowCls")
            local open,tips = lt.FunctionToggleModule:checkOpen(lt.FunctionToggleModule.FunctionHelpId.ClassSkill) 
            if not open then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
                return
            end
            self._selectIndex = btnItem.index
        elseif btnItem.index == btnType.superCls then
            -- print("superCls")
            local open,tips = lt.FunctionToggleModule:checkOpen(lt.FunctionToggleModule.FunctionHelpId.AdvancedClassSkill) 
            if not open then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
                return
            end
            self._selectIndex = btnItem.index
        elseif btnItem.index == btnType.transfer then
            -- print("transfer")
            local open,tips = lt.FunctionToggleModule:checkOpen(lt.FunctionToggleModule.FunctionHelpId.TransferSkill) 
            if not open then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
                return
            end
            local heroData = GameModule:getHeroData()
            local advState = heroData:getAdvanceState()
            if advState == Constant.AdvState.NotAdv then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = roleInfoTips.StringTips40})
                return
            end
            self._selectIndex = btnItem.index
        elseif btnItem.index == btnType.magic then
            -- print("magic")
            local open,tips = lt.FunctionToggleModule:checkOpen(lt.FunctionToggleModule.FunctionHelpId.Skill) 
            if not open then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
                return
            end
            self._selectIndex = btnItem.index
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = roleInfoTips.StringTips1})
            return
            -- print("功能尚未开放")
        end

        self:refreshBtnState()
        self:showCurPanel()

        -- 魔族切换按钮关闭右边技能显示界面
        if GameModule:getHeroRace() == RaceType.Ousters and btnItem.index ~= btnType.magic then
            WndLockManager:closeIgnoreRoleInfo()
            self:resetZOrder()
        end
        return true
    end
    for k,btnItem in pairs(self.btnList or {}) do
        btnItem:addClickListener(btnClik)
    end
end

function UIWndRoleInfo:clearAllBtnClik()
    for k,btnItem in pairs(self.btnList or {}) do
        btnItem:removeClickListener()
    end
end

function UIWndRoleInfo:refreshBtnState()
    local race = GameModule:getHeroRace()
    local index = self._selectIndex or 1
    for k,v in pairs(self.btnList) do
        local icon = self.btnList[k]:getChild("icon")
        local name = self.btnList[k].nameText
        local nameSelect = self.btnList[k].nameSelect
        if k == index then
            local imageName = string.format("bg_xuanzhong_01%s",RaceSkinRes[race])
            icon:setURL(string.format(_GURL.GetCompRoleInfo,imageName))
            name:setVisible(true)
            nameSelect:setVisible(false)
            self.btnList[k]:setSortingOrder(topOrder)
        else
            local imageName = string.format("bg_weixuanzhong_01%s",RaceSkinRes[race])
            icon:setURL(string.format(_GURL.GetCompRoleInfo,imageName))
            name:setVisible(false)
            nameSelect:setVisible(true)
            self.btnList[k]:setSortingOrder(topOrder-k)
        end
    end
end

