function UIWndRoleInfo:refreshRoleInfo()
    local heroData = GameModule:getHeroData()
    local race = GameModule:getHeroRace()
    local infoCom = self:getChild("infoCom")
    for k,v in ipairs(Constant.RaceToJobPanel) do
        if infoCom:getChild(v) then
            infoCom:getChild(v):setVisible(k == race)
        end
    end

    -- 刷新人物头像
    local head = infoCom:getChild("head")
    head:setURL(heroData:getHeadUrl())

    -- 刷新人物信息
    local curJobPanel = infoCom:getChild(Constant.RaceToJobPanel[race])
    if not curJobPanel then
        return
    end

    local infoAttrs = self:getInfoAttrsData()
    for k,v in pairs(infoAttrs) do
        local infoAttr = curJobPanel:getChild(k)
        if infoAttr then
            infoAttr:getChild("name"):setText(v.name or "")
            if v.value then
                infoAttr:getChild("value"):setText(v.value() or "")
            else
                infoAttr:getChild("value"):setText("")
            end

            -- 背景换色
            local bgNameTable = {
                [1] = "bg_neirongkuang_01",
                [2] = "bg_neirongkuang_02",
                [3] = "bg_neirongkuang_03",
                [4] = "bg_neirongkuang_04",
                [5] = "bg_neirongkuang_05",
            }
            
            local curBg = nil
            for k,v in pairs(bgNameTable) do
                if infoAttr:getChild("bg" .. k) then
                    curBg = infoAttr:getChild("bg" .. k)

                    local imageName = string.format("%s%s",v,RaceSkinRes[race])
                    curBg:setURL(string.format(_GURL.GetCompRoleInfo,imageName))
                    break
                end
            end

            -- icon相关
            local icon = infoAttr:getChild("icon")
            if v.icon and icon then
                icon:setVisible(true)
                local iconValue = v.icon
                if type(iconValue) == "function" then
                    iconValue = iconValue()
                end
                icon:setURL(iconValue)
                if curBg then
                    local pos = curBg:getPosition()
                    local size = curBg:getSize()
                    icon:setPosition(pos.x + size.width + 2,0)
                end
            elseif icon then
                icon:setVisible(false)
            end

            -- 进度条相关
            if v.percent and infoAttr:getChild("bar") then
                local percent = v.percent()
                infoAttr:getChild("bar"):setFillAmount(percent)
                local imageName = string.format("bg_jindutiao%s",RaceSkinRes[race])
                infoAttr:getChild("bar"):setURL(string.format(_GURL.GetCompRoleInfo,imageName))
            end

            if v.isHide and v.isHide() then
                infoAttr:setVisible(false)
            else
                infoAttr:setVisible(true)
            end
        end
    end
end

function UIWndRoleInfo:addInfoAttrClick()
    local race = GameModule:getHeroRace()
    local infoCom = self:getChild("infoCom")
    local curJobPanel = infoCom:getChild(Constant.RaceToJobPanel[race])
    if not curJobPanel then
        return
    end

    local infoAttrs = self:getInfoAttrsData()
    for k,v in pairs(infoAttrs) do
        local infoAttr = curJobPanel:getChild(k)
        if infoAttr then
            if not infoAttr.addClick then
                infoAttr:addClickListener(handler(self,function()
                    local itemSize = infoAttr:getSize()
                    local point = infoAttr:localToGlobal({x=itemSize.width/2,y=0})
                    -- print("click---->" .. v.name)
                    local content = v.name
                    if v.textTips then
                        content = v.textTips()
                    end
                    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SHOW_TEXT_TIPS, 
                    {
                        content = content,
                        pt = point
                    })
                end))
                infoAttr.addClick = true
            end
        end
    end
end

function UIWndRoleInfo:clearInfoAttrClick()
    local race = GameModule:getHeroRace()
    local infoCom = self:getChild("infoCom")
    local curJobPanel = infoCom:getChild(Constant.RaceToJobPanel[race])
    if not curJobPanel then
        return
    end

    local infoAttrs = self:getInfoAttrsData()
    for k,v in pairs(infoAttrs) do
        local infoAttr = curJobPanel:getChild(k)
        if infoAttr then
            infoAttr:removeClickListener()
            infoAttr.addClick = nil
        end
    end
end

function UIWndRoleInfo:refreshAttrLeft()
    local infoCom = self:getChild("infoCom")
    if not self._attrItemListLeft then
        self._attrItemListLeft = {}
    end

    local race = GameModule:getHeroRace()
    -- 吸血鬼没有魔法值
    self._attrListLeft = self:getAttrListLeftData()
    if race == RaceType.Vampire then
        table.remove(self._attrListLeft, 5)
    end

