function UIWndRoleInfo:onRefreshSkillList()
    -- 人族鬼族技能列表刷新
    if self._magicCom and self._magicCom:isVisible() and self._selectIndex == btnType.magic and self._magicCom.refreshCurInfo then
        self._magicCom:refreshCurInfo()
    end

    -- 转职技能列表刷新
    if self._transferCom and self._transferCom:isVisible() and self._selectIndex == btnType.transfer and self._transferCom.refreshCurInfo then
        self._transferCom:refreshCurInfo()
    end

    -- 魔族族技能列表刷新
    if self._magicCom and self._magicCom:isVisible() and self._selectIndex == btnType.magic and self._magicCom.refreshCurInfo then
        self._magicCom:refreshCurInfo()
    end
end

function UIWndRoleInfo:refreshHeroInfo(event)
    self:refreshRoleInfo()-- 上面人物信息
    self:refreshAttrLeft()-- 左边属性
    self:refreshAttrRight()-- 右边属性

    -- 阶级技能界面刷新
    self:onRefreshClsList()

    -- 人族鬼族技能列表刷新
    if self._magicCom and self._magicCom:isVisible() and self._selectIndex == btnType.magic and self._magicCom.refreshCurInfo then
        self._magicCom:refreshCurInfo()
    end

    -- 转职技能列表刷新
    if self._transferCom and self._transferCom:isVisible() and self._selectIndex == btnType.transfer and self._transferCom.refreshCurInfo then
        self._transferCom:refreshCurInfo()
    end
end

function UIWndRoleInfo:onRefreshClsList()
    if self._clsCom and self._clsCom:isVisible() and (self._selectIndex == btnType.lowCls or self._selectIndex == btnType.superCls) then
        self._clsCom:refreshPanelByCls(self._selectIndex)
    end
end

