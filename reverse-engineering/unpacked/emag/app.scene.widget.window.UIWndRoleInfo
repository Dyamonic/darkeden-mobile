function UIWndRoleInfo:addAttrLeftClick()
    for i = 1, #self._attrListLeft do
        self._attrItemListLeft[i]:getChild("addBtn"):addClickListener(function()
            local heroData = GameModule:getHeroData()
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {
                class = "UIWndUsePoints",
                confirmCallback = function(attPointTable)
                    if table.nums(attPointTable) > 0 then
                        GameModule:assignAttributePoint(attPointTable[1] or 0,attPointTable[2] or 0,attPointTable[3] or 0)
                    end
                end,
                param = {
                    totalPoints = heroData:getCurSkillPoint(),
                    attrList = {
                        [1] = {name = roleInfoTips.StringTips12, originalValue = heroData:getTotalSTR(),initAddValue = heroData:getAddSTR()},
                        [2] = {name = roleInfoTips.StringTips13, originalValue = heroData:getTotalDEX(),initAddValue = heroData:getAddDEX()},
                        [3] = {name = roleInfoTips.StringTips14, originalValue = heroData:getTotalINT(),initAddValue = heroData:getAddINT()},
                    },
                    needHideAddPointBtn = true,
                }
            })
            return true
            end
        )
        
        if not self._attrItemListLeft[i].addClick then
            self._attrItemListLeft[i]:getChild("btn"):addClickListener(handler(self,function()
                local itemSize = self._attrItemListLeft[i]:getSize()
                local point = self._attrItemListLeft[i]:localToGlobal({x=itemSize.width/2,y=0})
                -- print("click---->" .. v.name)
