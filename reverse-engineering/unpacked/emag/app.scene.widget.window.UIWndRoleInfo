        end
    end
end

function UIWndRoleInfo:clearAttrLeftClick()
    for i = 1, #self._attrListLeft do
        self._attrItemListLeft[i]:getChild("addBtn"):removeClickListener()
        self._attrItemListLeft[i]:getChild("btn"):removeClickListener()
        self._attrItemListLeft[i].addClick = false
    end
end

function UIWndRoleInfo:renderListLeftItem(index, item)
    local heroData = GameModule:getHeroData()
    local race = GameModule:getHeroRace()
    local data = self._attrListLeft[index] or {}
    item:getChild("name"):setText(data.name or "")
    if data.value then
        item:getChild("value"):setText(data.value() or "")
    else
        item:getChild("value"):setText("")
    end
    
    -- 无分配点数隐藏按钮
    local points = heroData:getCurSkillPoint()
    -- local visible = points > 0
    item:getChild("addBtn"):setVisible((index <= 3) and true)
    if index <= 3 then
        item:getChild("addBtn"):getChild("n1"):setVisible(points > 0)
        if points == 0 and race == RaceType.Slayer and heroData:getAdvanceState() == 0 then
            item:getChild("addBtn"):setVisible(false)
        end
    end

    local imageName = string.format("bg_neirongkuang_01%s",RaceSkinRes[race])
    item:getChild("bg"):setURL(string.format(_GURL.GetCompRoleInfo,imageName))
    if race == RaceType.Slayer and index <= 3 then
        item:getChild("bg2"):setVisible(true)
        item:getChild("bar"):setVisible(true)
        item:getChild("bg"):setVisible(false)

        local percent = heroData:calculationPercent(index)
        item:getChild("bar"):setFillAmount(percent)
    else
        item:getChild("bg2"):setVisible(false)
        item:getChild("bar"):setVisible(false)
        item:getChild("bg"):setVisible(true)
    end
end

function UIWndRoleInfo:refreshAttrRight()
    local infoCom = self:getChild("infoCom")
    local listRight = infoCom:getChild("list2")
    local content = listRight:getChildAt(0)
    local race = GameModule:getHeroRace()
    -- 主体内容
    local contentStr = ""
    local textTable = {}
    local attrListRight = self:getAttrListRightData()
    for k,v in ipairs(attrListRight) do
        local isHide = (not (race == RaceType.Ousters) and (k == 7 or k == 8 or k == 9)) --  只有魔族才会显示水火土属性
        if not isHide then
            if v.color then
                table.insert( textTable, "[color=")
                table.insert( textTable, v.color)
                table.insert( textTable, "]")
            end

            table.insert(textTable, v.name or "")
            table.insert(textTable, " : ")
            table.insert(textTable, v.value() or "")
            table.insert( textTable, "\n")

            if v.color then
                table.insert( textTable, "[/color]")
            end
        end
    end
    contentStr = table.concat(textTable)
 
    ------------------------------------------------------------------------------------------------------

    local detailT = content:getChild("detail")
    detailT:setText(contentStr)
    
    -- 设置数据后重构大小
    local detailTSize = detailT:getSize()
    local height = detailTSize.height 
    local showHeight = height
    if showHeight > 229 then
        showHeight = 229
    end

    content:setSize(290,height)
    -- listRight:setItemRenderer(handler(self, self.renderListLeftItem))
    -- listRight:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickLeftItem))
end

--设置改变
function UIWndRoleInfo:changeSettings(params)
    local param = params.param
    if param.index == Constant.SETTINGS_TYPES.INFO_OPACITY or param.index == Constant.SETTINGS_TYPES.WINDOW_OPACITY then
        local editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.INFO_OPACITY)
        self.isBGOpacity = editTable.switch == 1
        if self.isBGOpacity then
            editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.WINDOW_OPACITY)
            self._diOpacity:setAlpha(editTable.value/100)
        else
            self._diOpacity:setAlpha(1)
        end
        self._bg:setVisible(not self.isBGOpacity)
        self._bgOpacity:setVisible(self.isBGOpacity)
        self._diOpacity:setVisible(self.isBGOpacity)
    end
end

function UIWndRoleInfo:uptRedDotEvt(event)
    local param = event.param
    if string.find(param.name, "SkillRedTips") == nil then
        return
    end
    for i, v in ipairs(self.btnList) do
        local isRed = SkillModule:getRedPoint(i)
        self.btnList[i]:getChild("reddot"):setVisible(isRed)
    end
    --魔法界面
    if self._magicCom then
        self._magicCom:uptRedDotEvt()
    end
    --阶级技能界面
    if self._clsCom then
        self._clsCom:uptRedDotEvt()
    end
end

