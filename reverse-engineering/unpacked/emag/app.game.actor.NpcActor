
local NpcActor = class("NpcActor", lt.RoleActor)
local ShadowActor = lt.ShadowActor
local ResManager = lt.ResManager
local ResUtil = lt.ResUtil

NpcActor._direction   = nil
NpcActor._actionId    = nil

NpcActor._actionInfo = nil
NpcActor._sprite     = nil

NpcActor._spriteSelected = nil --混合色源图片

NpcActor._timeTrigger    = nil
NpcActor._nextFrameIndex = nil
NpcActor._loopCount      = nil

NpcActor._nameNode = nil
-- 选中标记
NpcActor._targetMark = nil

local NPC_TYPE = {
    NORMAL = 0, --其他的
    STATUE = 1, --雕像
}

local NAME_TO_MODEL = 30

function NpcActor:ctor(modelId, npcId, name, direction, npcType)

    self._modelId   = modelId
    self._name      = name
    self._direction = direction
    self._npcId     = npcId
 
    self._actionId  = 0
    if self._direction > 7 then
        self._direction = self:getDefaultDirection()
    end

    local zorder = 0
    local ANCHOR_MIDDLE = self.ANCHOR_MIDDLE

    local offsetX, offsetY = -25, 15
    zorder = 1

    -- 人物模型
    self._npcNode = display.newNode()
    self._npcNode:setPosition(offsetX, offsetY)
    self:addChild(self._npcNode, zorder)

    self._spriteNpc = self:CreateSprite(ANCHOR_MIDDLE, ANCHOR_MIDDLE, zorder, self._npcNode)

    -- self._sprite = display.newSprite() --NPC
    -- self._sprite:setAnchorPoint(0.5, 0)
    -- self:addChild(self._sprite)

    self._timeTrigger = lt.TimeTrigger.new()
    self._nextFrameIndex = 1
    self._loopCount = 0


    self._nameNode = display.newNode()

    if npcType == NPC_TYPE.NORMAL then
        self:loadNameNode()
    end
 
    -- 模型影子
    self._shadowActor = ShadowActor.new(2)
    
    self._targetMark = false

    self:initShader()
end

function NpcActor:initShader()
    self:changeModelColor(self._spriteNpc)
end

function NpcActor:changeModelColor(node)
    local npcMeta = lt.CacheManager:queryNpc(self._npcId)
    if not npcMeta then
        return
    end

    local allColor = npcMeta:getColor()
    local monColor = npcMeta:getMonColor()
    -- if monColor or allColor then
        local param = {
            node = node,
            colorB = monColor,
            originColor = allColor,
            pixelSize = self._pixelSize,
            selectColor = self._selectColor,
        }
        lt.ShaderBackendUtil:makeMulModelEffect(param.node, param)
    -- end
end

function NpcActor:hideTargetMark()
    NpcActor.super.hideTargetMark(self)
    self:changeModelColor(self._spriteNpc) --取消描边效果
end

function NpcActor:loadNameNode()
    local modelMeta = lt.CacheManager:getModelMeta(self._modelId)

    --文本
    self._textName = lt.UIManager:createTextNameNodeNpc(self._name)
    self._textName:setAnchorPoint(0.5, 0.5)

    --npc 职业标记
    local raceType = lt.GameModule:getHeroRace()
    local resPath = ResManager:getRoleModelTitleTag(raceType)
    local npcTag = display.newSprite(resPath)
    local scale = 0.6
    local npcTagH = npcTag:getContentSize().height * scale
    npcTag:setAnchorPoint(cc.p(0.5, 0.5))
    npcTag:setScale(scale)
    local textBgW = self._textName:getContentSize().width
    if textBgW < 120 then
        textBgW = 120
    end

    --文本框
    local textbg = display.newSprite(ResManager._NPC_Title_Bg, 0, 0,{scale9 = true, size = cc.size(textBgW, npcTagH), capInsets = cc.rect(14, 8, 2, 12)})

    local titleBGY = modelMeta:getHeight() + modelMeta:getOffsetY() + textbg:getContentSize().height/2 + NAME_TO_MODEL
    textbg:setPosition(0, titleBGY)
    self._nameNode:addChild(textbg)
    self._textName:setPosition(cc.p(0, titleBGY))
    self._nameNode:addChild(self._textName)


    local npcTagX = - textbg:getContentSize().width/2 - 12.5
    npcTag:setPosition(npcTagX, titleBGY)
    self._nameNode:addChild(npcTag)

    --任务目标箭头ICON
    local meta = lt.EffectMeta.new({
        SkillId          = 0,
        OrderId          = 1,
        EffectSpriteType = 2503,
        BltType          = 4,
        Step             = 0.07,
        DelayFrame       = 0,
        Owner            = 0,
        LoopCount        = 1
    })
    self._targetIcon = lt.CompEffectActor.new(meta, 1, true)
    self._targetIcon:setPosition(cc.p(0, titleBGY - 30))
    self._targetIcon:setScale(0.6)
    self._targetIcon:setVisible(false)
    self._nameNode:addChild(self._targetIcon)
end

function NpcActor:onClear()
    self:removeAllChildren()
    NpcActor.super.onClear(self)

    self._nameNode = nil
    self._textName = nil
    self._targetIcon = nil
    self._statusName = nil
    self._spriteSelected = nil

    self._actionInfo = nil
    self._shadowActor = nil
    self._npcNode = nil
    self._spriteNpc = nil
end

function NpcActor:onUpdate()
    self:onUpdateAction()
    self:onUpdateName()


    if self._spriteSelected then
        self._spriteSelected:setVisible(self._targetMark)
    end
    -- if self._selectColor then
        self:changeModelColor(self._spriteNpc)
    -- end
end

function NpcActor:onUpdateAction()
    if not self._actionInfo or not self._actionInfo:getLoop() then
        return
    end


    if self._actionInfo:getLoop() ~= -1 and
       (self._loopCount >= self._actionInfo:getLoop() or self._nextFrameIndex > self._actionInfo:getSpriteFrameCount()) then
        self._actionInfo = nil
        return
    end

    if self._timeTrigger:tick() then
        self:gotoNextFrame()

        if self._nextFrameIndex > self._actionInfo:getSpriteFrameCount() then
            self._nextFrameIndex = 1
            self._loopCount = self._loopCount + 1
        end
    end
end

function NpcActor:onUpdateName()
end

function NpcActor:initActionInfo()
    -- 创建ActionInfo
    self._actionInfo = lt.ActionManager:getActionNpcInfo("monster", self._modelId, self._actionId, self._direction)
    self._shadowActor:LoadMonsterActionInfo(self._modelId, self._actionId, self._direction)

    -- 设置控制参数
    self._timeTrigger:reset(self._actionInfo:getStep())
    self._loopCount = 0
    self._nextFrameIndex = 1

    self:gotoNextFrame()
end

function NpcActor:getDefaultDirection()
    local actionData = lt.ActionManager:getActionData("creature", self._modelId)
    local actionFrameArr = actionData:getAction(self._actionId)
    for directionStr, actionInfo in pairs(actionFrameArr) do
        if table.nums(actionInfo) > 0 then
            local direction = directionStr:match("%d+")
            return direction
        end
    end
end

function NpcActor:gotoNextFrame()
    local frame = self._actionInfo:getSpriteFrame(self._nextFrameIndex)
    if frame then
        self:updateFrame(true)
    end
    self._nextFrameIndex = self._nextFrameIndex + 1
end

function NpcActor:updateFrame(update)
    if not self._actionInfo then
        return
    end
    self._spriteNpc:setVisible(true)
    if update then
        local frame = self._actionInfo:getSpriteFrame(self._nextFrameIndex)

        if frame then
            self._initFrame = true
            self._spriteNpc:setSpriteFrame(frame.sprite)

            local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
            self._spriteNpc:setPosition(pos)

             if self._selectColor then
                self._pixelSize = ResUtil:getPlistPixelSize(frame.sprite)
            end
            
            self._shadowActor:onUpdateFrame(self._nextFrameIndex)
        end
    end
   
end

function NpcActor:setPositionEx(x, y)
    self:setPosition(x, y)

    local _, n = lt.MapUtil:calcMN(x, y)
    self._nameNode:setPosition(x, y)
    self._nameNode:setLocalZOrder(n)
    self._shadowActor:setPosition(x, y)

end


-- Setter && Getter
function NpcActor:getDirection()
    return self._direction
end

function NpcActor:getNameNode()
    return self._nameNode
end

function NpcActor:changeName(name)
    if self._statusName and name then
        self._statusName:setString(name)
    end
end

--更新箭头
function NpcActor:updateTargetArrow(show)
    if not self._targetIcon then
        return
    end
    self._targetIcon:setVisible(show)
end

return NpcActor
