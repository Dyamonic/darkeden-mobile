local EquipTransformDao = {}

function EquipTransformDao:query(id)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM EquipTransform WHERE Id=%d;", tonumber(id))) do
    	local meta = lt.EquipTransformMeta.new(row)
        return meta
    end
end

function EquipTransformDao:queryAll()
    local equipTransformMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM EquipTransform") do
        local meta = lt.EquipTransformMeta.new(row)
        if not equipTransformMap[meta:getCostItemIdx()] then
            equipTransformMap[meta:getCostItemIdx()] = {}
        end
        table.insert(equipTransformMap[meta:getCostItemIdx()], meta)
    end
    return equipTransformMap
end

return EquipTransformDao