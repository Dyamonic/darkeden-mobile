
return [[

varying vec2 v_texCoord;


uniform vec3 u_color;
uniform vec3 u_tColor;
uniform float u_flash; // 控制闪烁的变量
uniform int u_isFlashing; // 使用整数控制是否闪烁的变量
uniform int u_isBorder; 
uniform float u_colorOffset; // 色值倍率

uniform vec3 allColor;
uniform sampler2D u_texture;

const int SAMPLES = 10;
varying vec2 v_OutlineSamples[SAMPLES];
void main() {
    // 获取当前纹理颜色
    vec4 textureColor = texture2D(u_texture, v_texCoord);

    vec4 newColor = vec4(textureColor.rgb, textureColor.a);

    //染色
    float originB = textureColor.b * u_colorOffset; // 色值倍率调整(强化等级修改倍率) 
    //修改备注：2100001防弹衣M 装备需g值包含0
    if (length(u_tColor) >= 0.0 && textureColor.b > 0.031 && textureColor.r == 0.0  && (textureColor.g >= 0.0 && textureColor.g < 0.031) && textureColor.a > 0.0)
    {
        newColor.r = u_tColor.r * originB;
        newColor.g = u_tColor.g * originB;
        newColor.b = u_tColor.b * originB;
    }

    //状态染色
    if ( length(allColor) > 0.0 && textureColor.a > 0.0){
        if (allColor.r == 0.5 && allColor.g == 0.5 && allColor.b == 0.5) 
        {
            float gray = (newColor.r + newColor.g + newColor.b) / 3.0;
            newColor.rgb = vec3(gray, gray, gray);
        }else{
            newColor.rgb = newColor.rgb * allColor.rgb;
        }
    }

    if (u_isBorder == 0){
        gl_FragColor = newColor; // 显示原始纹理颜色
    }else{
        // 计算边缘 alpha
        float edgeAlpha = 0.0;
        for (int i = 0; i < SAMPLES; i++) {
            vec4 sampleColor = texture2D(u_texture, v_OutlineSamples[i]);
            if (sampleColor.a > 0.0) {
                edgeAlpha = max(edgeAlpha, sampleColor.a); // 计算边缘的 alpha
            }
        }

        // 设置边缘颜色为金黄色
        vec4 outlineColor = vec4(u_color.r, u_color.g, u_color.b, edgeAlpha);

        // 计算闪烁颜色
        vec4 flashColor = mix(vec4(1.0, 1.0, 1.0, 1.0), vec4(0.0, 0.0, 1.0, 1.0), (sin(u_flash * 3.14) + 1.0) / 2.0); // 由白色到蓝色的渐变

        if(u_isFlashing==1){
            outlineColor = flashColor;
        }
        // 只有在透明色与颜色交汇处显示金黄色
        if (newColor.a == 0.0 && edgeAlpha > 0.0) {
            gl_FragColor = outlineColor; // 边缘部分显示金黄色
        } else if (newColor.a > 0.0) {
            gl_FragColor = newColor; // 显示原始纹理颜色
        } else {
            gl_FragColor = vec4(0.0, 0.0, 0.0, 0.0); // 透明部分
        }
    }
   
    
}


 
]]
