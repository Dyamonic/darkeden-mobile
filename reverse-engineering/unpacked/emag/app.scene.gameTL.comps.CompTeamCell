---@class CompTeamCell 主界面队伍成员cell
local CompTeamCell = class("CompTeamCell",lt.UIGButtonBase, lt.UICompChangeSkin)

CompTeamCell.ChangeSkinConf = {
    ["Main"] = {
        ["bg"] = "bg_mbxzxt_zuduidi",
        ["headframe"] = "bg_mbxzxt_zuduitouxiangkuang",
    } 
}

local NtfManager   = lt.NtfManager
local AgentManager = lt.AgentManager
local TeamModule   = lt.TeamModule
local CommonModule = lt.CommonModule

function CompTeamCell:ctor()
    CompTeamCell.super.ctor(self)
end

function CompTeamCell:onClear()
    CompTeamCell.super.onClear(self)
end

function CompTeamCell:onConstruct()
    self:startSkin()
    self._nameLabel = self:getChild("label_name")
    self._hpBar = self:getChild("destHP")
    self._headIcon = self:getChild("head")
    self._guildLoader = self:getChild("loader_guild")
    self._playerBtn = self:getChild("bg")
end

function CompTeamCell:onEnter()
    CompTeamCell.super.onEnter(self)
    self._playerBtn:addClickListener(handler(self, self.onPlayerClick))
end

function CompTeamCell:onExit()
    self._playerBtn:removeClickListener()
    CompTeamCell.super.onExit(self)
end

function CompTeamCell:setInfo(playerInfo)
    self._nameLabel:setText(playerInfo.playerName)
    self._hpBar:setFillAmount(playerInfo.curHp / playerInfo.hpMax)
    local headUrl = TeamModule:getHeadUrl(playerInfo.race, playerInfo.sex, playerInfo.faceShape)
    self._headIcon:setURL(headUrl)
    self._guildLoader:setVisible(playerInfo.guildIconId ~= 0)
    if playerInfo.guildIconId ~= 0 then
        self._guildLoader:setURL(string.format(_GURL.GetGuidePath, playerInfo.guildIconId))
    end

    --改变字的颜色和透明度
    local isOnline = playerInfo.online == CommonModule:GetNetCmdEnum("ON_OFF_LINE_ONLINE_ENUM")
    self._nameLabel:setAlpha(isOnline and 1 or 0.5)

    self._playerInfo = playerInfo
end

--血量变化
function CompTeamCell:onHpChange(playerInfo)
    self._hpBar:setFillAmount(playerInfo.curHp / playerInfo.hpMax)
end

function CompTeamCell:onPlayerClick()
    if not self._playerInfo then
        return
    end
    local isOnline = self._playerInfo.online == CommonModule:GetNetCmdEnum("ON_OFF_LINE_ONLINE_ENUM")
    if not isOnline then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_TEAM_HALL_TIPS50})
        return
    end

    local worldAgent = AgentManager:getWorldAgent()
    local heroAgent = worldAgent:getHeroAgent()
    local agent = nil
    if heroAgent and heroAgent:getHeroData():getPlayerId() == self._playerInfo.playerId then
        agent = heroAgent
    end
    if agent == nil then
        local players = worldAgent:getAroundPlayer()
        for i = 1, #players do
            local heroData = players[i]:getHeroData()
            if heroData:getPlayerId() == self._playerInfo.playerId then
                agent = players[i]
                break
            end
        end
    end
    if agent == nil then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_TEAM_HALL_TIPS30})
        return
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SELECT_TARGET, {agent = agent})
    heroAgent:setTargetAgentId(agent:getAgentId())
end

return CompTeamCell