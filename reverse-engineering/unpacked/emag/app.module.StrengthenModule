--根据id获得附魔信息
function StrengthenModule:getEnchantInfo(propId, lv)
    local race = lt.GameModule:getHeroRace()
    --鬼族蓝强制显示成血
    if race == Constant.RaceType.Vampire then
        if propId == Constant.ATTRIBUTES_TYPE.MP then
            propId = Constant.ATTRIBUTES_TYPE.HP
        elseif propId == Constant.ATTRIBUTES_TYPE.MP_ABSORB then
            propId = Constant.ATTRIBUTES_TYPE.HP_ABSORB
        elseif propId == Constant.ATTRIBUTES_TYPE.MP_RELIVE then
            propId = Constant.ATTRIBUTES_TYPE.HP_RELIVE
        end
    end
    local eqMeta = CacheManager:getEnchantingAffixMeta(propId)
    local str = ""
    if eqMeta then
        local attrName = eqMeta:getDisplayName()
        local attrNum = eqMeta:getBaseValue() + (lv - 1) * eqMeta:getValuesPreLevel()
        local isPer = CacheManager:getOptionInfoMeta(eqMeta:getType()):getPercentage()
        str = attrName.."+"..attrNum
        if isPer == 1 then
            --百分比
            str = str.."%"
        end
    end
    return str
end

--根据id获得附魔最大数值
function StrengthenModule:getEnchantMaxInfo(propId)
    local race = lt.GameModule:getHeroRace()
    --鬼族蓝强制显示成血
    if race == Constant.RaceType.Vampire then
        if propId == Constant.ATTRIBUTES_TYPE.MP then
            propId = Constant.ATTRIBUTES_TYPE.HP
        elseif propId == Constant.ATTRIBUTES_TYPE.MP_ABSORB then
            propId = Constant.ATTRIBUTES_TYPE.HP_ABSORB
        elseif propId == Constant.ATTRIBUTES_TYPE.MP_RELIVE then
            propId = Constant.ATTRIBUTES_TYPE.HP_RELIVE
        end
    end
    local lv = self:getEnchantMaxLv(propId)
    local eqMeta = CacheManager:getEnchantingAffixMeta(propId)
    local attrNum = eqMeta:getBaseValue() + (lv - 1) * eqMeta:getValuesPreLevel()
    return attrNum
end

--根据id获得最大等级
function StrengthenModule:getEnchantMaxLv(propId)
    local eqMeta = CacheManager:getEnchantingAffixMeta(propId)
    local maxLv = eqMeta:getAffixMaxLevel()
    return maxLv
end

--获得升级概率
function StrengthenModule:getEnchantRate(props)
    local rate = 0
    local idx = self:getEnchantMaxLv(props[1])
    if props[2] < idx then
        local data = CacheManager:getEquipEnchantingMeta(idx, props[2])
        rate = rate + data:getRate()
    end
    rate = math.floor(rate / 100)
    return rate
end

--获得升级消耗
function StrengthenModule:getEnchantCost(props)
    if #props == 0 then return {} end
    local data = CacheManager:getEquipEnchantingCostMeta(#props)
    return data:getCost()
end

--获得激发消耗
function StrengthenModule:getMotivateCost(itemInfo, lockNum)
    local kind = 20
    local types = 0
    local coin = 0
    local cost = {}
    if itemInfo then
        local itemMeta = itemInfo:getItemMeta()
        kind = itemMeta:getKind()
        types = itemMeta:getType()
    end
    local affixPool = CacheManager:getAffixPooMapMeta(kind, types)
    local motivateItem = affixPool:getMotivateItem()
    --激发消耗
    for k, v in ipairs(motivateItem) do
        if v[1] == lockNum then
            --组装数据
            local list = {}
            table.insert(list, v[2])
            table.insert(list, v[3])
            table.insert(list, v[4])
            table.insert(cost, list)
            break
        end
    end
    --激发锁定词条消耗
    local motivateLockItem = affixPool:getMotivateLockItem()
    for k, v in ipairs(motivateLockItem) do
        if v[1] == lockNum then
            --组装数据
            local list = {}
            table.insert(list, v[2])
            table.insert(list, v[3])
            table.insert(list, v[4])
            table.insert(cost, list)
            break
        end
    end
    --激发消耗金币
    local motivateCost = affixPool:getMotivateCost()
    for k, v in ipairs(motivateCost) do
        if v[1] == lockNum then
            coin = v[4]
            break
        end
    end
    --如果是空重新处理数据
    if itemInfo == nil then
        for k, v in ipairs(cost) do
            v[3] = 0
        end
        coin = 0
    end
    return cost, coin
end

--是否强化到最大等级(单个)
function StrengthenModule:getSingleEnchantMax(props)
    local max = self:getEnchantMaxLv(props[1])
    if props[2] < max then
        return false
    end
    return true
end

--是否强化到最大等级
function StrengthenModule:getEnchantMax(props)
    if #props == 0 then return false end
    for i = 1, #props do
        local max = self:getEnchantMaxLv(props[i][1])
        if props[i][2] < max then
            return false
        end
    end
    return true
end

--获得所有祝福石头
function StrengthenModule:getAllEnchantGem(itemInfo)
    local gemList = {701003, 701004, 701005, 701006, 701008, 701009}
    local gemInfoList = {}
    for i = 1, #gemList do
        local gemInfo = CacheManager:getItemMeta(gemList[i])
        local canUse = StrengthenModule:suitEnchantGem(itemInfo, gemInfo)
        if itemInfo == nil or canUse then
            table.insert(gemInfoList, gemInfo)
        end
    end
    --为了补充到5的整数倍(界面展示)
    if #gemInfoList % 5 > 0 then
        while #gemInfoList % 5 == 0 do
            table.insert(gemInfoList, nil)
        end
    end

    return gemInfoList
end

--是否能祝福
function StrengthenModule:suitEnchantGem(itemInfo, gemInfo)
    if itemInfo == nil then
        return false
    end
    local itemMeta = itemInfo:getItemMeta()
    local kind = itemMeta:getKind()
    local types = itemMeta:getType()
    local affixPool = CacheManager:getAffixPooMapMeta(kind, types)
    if not affixPool then
        return false
    end
    local affixClass = affixPool:getAffixClass()
    local gemType = gemInfo:getEffectParam()[1][2]
    local eqMeta = CacheManager:getEnchantingAffixMeta(gemType)
    if self:checkExit(affixClass, eqMeta:getAffixClass()) then
        return true
    end
    return false
end

--获得第一个能选中的祝福石头idx
function StrengthenModule:getFirstGemIdx(itemInfo, gemlist)
    local index = 0
    for i = 1, #gemlist do
        local isSuit = self:suitEnchantGem(itemInfo, gemlist[i])
        if isSuit then
            local gemId = gemlist[i]:getItemId()
            local gemNum = ItemModule:getItemNum(gemId)
            if gemNum > 0 then
                index = i-1
                break
            end
        end
    end
    return index
end

--转化装备的词条
function StrengthenModule:transformAffix(itemInfo)
    local attr = {}
    if itemInfo then
        local attr1 = itemInfo:getFirstAffixId()
        if attr1 ~= 0 then
            local lv = itemInfo:getFirstAffixLevel()
            table.insert(attr, {attr1, lv})
        end
        local attr2 = itemInfo:getSecondAffixId()
        if attr2 ~= 0 then
            local lv = itemInfo:getSecondAffixLevel()
            table.insert(attr, {attr2, lv})
        end
        local attr3 = itemInfo:getThirdAffixId()
        if attr3 ~= 0 then
            local lv = itemInfo:getThirdAffixLevel()
            table.insert(attr, {attr3, lv})
        end
    end
    return attr
end

--获得装备词条的总等级
function StrengthenModule:getTotalAffixLv(itemInfo)
    local lv = 0
    if itemInfo then
        local attr1 = itemInfo:getFirstAffixId()
        if attr1 ~= 0 then
            local attributeMeta = CacheManager:getAttributeMeta(attr1, itemInfo:getFirstAffixLevel())
            local reqAbility = attributeMeta:getReqAbility()
            if reqAbility then
                lv = lv + reqAbility[1][2]
            end
        end
        local attr2 = itemInfo:getSecondAffixId()
        if attr2 ~= 0 then
            local attributeMeta = CacheManager:getAttributeMeta(attr2, itemInfo:getSecondAffixLevel())
            local reqAbility = attributeMeta:getReqAbility()
            if reqAbility then
                lv = lv + reqAbility[1][2]
            end
        end
        local attr3 = itemInfo:getThirdAffixId()
        if attr3 ~= 0 then
            local attributeMeta = CacheManager:getAttributeMeta(attr3, itemInfo:getThirdAffixLevel())
            local reqAbility = attributeMeta:getReqAbility()
            if reqAbility then
                lv = lv + reqAbility[1][2]
            end
        end
    end
    return lv
end

