    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.CS_EQUIP_UPGRADE_RESP), handler(self, self.onEquipUpgrade), "StrengthenModule:onEquipUpgrade")
    SocketApi:addProtoListener(ServerCmdDef.EQUIP_STRENGTHEN_OPERATE, handler(self, self.onEquipStrengthen), "StrengthenModule:onEquipStrengthen")
    SocketApi:addProtoListener(ServerCmdDef.EQUIP_BLESSING_OPERATE, handler(self, self.onEquipBlessing), "StrengthenModule:onEquipBlessing")
    SocketApi:addProtoListener(ServerCmdDef.EQUIP_COMPOSE_OPERATE, handler(self, self.onEquipCompose), "StrengthenModule:onEquipCompose")
    SocketApi:addProtoListener(ServerCmdDef.EQUIP_INHERIT_OPERATE, handler(self, self.onEquipInherit), "StrengthenModule:onEquipInherit")
    SocketApi:addProtoListener(ServerCmdDef.EQUIP_RECASTING_OPERATE, handler(self, self.onEquipRecasting), "StrengthenModule:onEquipRecasting")
    SocketApi:addProtoListener(ServerCmdDef.EQUIP_PURIFY_OPERATE, handler(self, self.onEquipPurify), "StrengthenModule:onEquipPurify")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_TRANSFORM_EQUIP_RESP), handler(self, self.onEquipTransform), "StrengthenModule:onEquipTransform")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_ADVANCE_EQUIP_TRANSFORM_INFO_RESP), handler(self, self.onAdvanceEquipInfo), "StrengthenModule:onAdvanceEquipInfo")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.CS_EQUIP_MOTIVATE_RESP), handler(self, self.onEquipMotivate), "StrengthenModule:onEquipMotivate")
end

function StrengthenModule:clear()
    SocketApi:removeProtoListenerByTag("StrengthenModule:onEquipLevelup")
    SocketApi:removeProtoListenerByTag("StrengthenModule:onEquipUpgrade")
    SocketApi:removeProtoListenerByTag("StrengthenModule:onEquipStrengthen")
    SocketApi:removeProtoListenerByTag("StrengthenModule:onEquipBlessing")
    SocketApi:removeProtoListenerByTag("StrengthenModule:onEquipCompose")
    SocketApi:removeProtoListenerByTag("StrengthenModule:onEquipInherit")
    SocketApi:removeProtoListenerByTag("StrengthenModule:onEquipRecasting")
    SocketApi:removeProtoListenerByTag("StrengthenModule:onEquipPurify")
    SocketApi:removeProtoListenerByTag("StrengthenModule:onEquipTransform")
    SocketApi:removeProtoListenerByTag("StrengthenModule:onAdvanceEquipInfo")
    SocketApi:removeProtoListenerByTag("StrengthenModule:onEquipMotivate")
end

