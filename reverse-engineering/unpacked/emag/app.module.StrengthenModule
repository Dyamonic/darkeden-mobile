--检测装备是否能转换成转职装备
function StrengthenModule:checkEquipAdvance(itemId)
    local meta = nil
    local transformMeta = self:getTransformData(itemId)
    for i = 1, #transformMeta do
        if transformMeta[i]:getType() == 3 then
            meta = transformMeta[i]
        end
    end
    return meta
end

--获取装备是否能转换成转职装备(剩余次数)
function StrengthenModule:checkEquipAdvanceNum(itemId)
    local meta = CacheManager:queryEquipMeta(itemId)
    local kind = meta:getKind()
    local advanceEquipNumber = CacheManager:getValueById(Constant.Variable.AdvanceEquipNumber)
    local maxNum = advanceEquipNumber[kind] or 0
    local transInfo = self._equipTransferInfo or {}
    local curNum = transInfo[kind] or 0
    if curNum < maxNum then
        return true
    end
    return false
end

--装备还是背包
function StrengthenModule:setFilterEquipType(filterEquipType)
    self._filterEquipType = filterEquipType
end

--检测当前装备是否存在
function StrengthenModule:checkStrengthenEquip(itemInfo, itemInfo2)
    local isExit = false
    local objId = itemInfo:getObjId()
    if self._filterEquipType == Constant.FilterEquipType.RoleEquip then
        --身上装备
        local equipArray = ItemModule:getEquipArray()
        for k, v in ipairs(equipArray) do
            if v:getObjId() == objId then
                isExit = true
                break
            end
        end
        if isExit and itemInfo2 then
            local objId2 = itemInfo2:getObjId()
            for k, v in ipairs(equipArray) do
                if v:getObjId() == objId2 then
                    return true
                end
            end
            return false
        end
    elseif self._filterEquipType == Constant.FilterEquipType.BagEquip then
        --背包装备
        local packageArray = ItemModule:getPackageArray()
        for k, v in ipairs(packageArray) do
            if v:getObjId() == objId then
                isExit = true
                break
            end
        end
        if isExit and itemInfo2 then
            local objId2 = itemInfo2:getObjId()
            for k, v in ipairs(packageArray) do
                if v:getObjId() == objId2 then
                    return true
                end
            end
            return false
        end
    end
    return isExit
end

------------------红点------------------
function StrengthenModule:checkRedTips(main, sub)
    local isRed = false
    if main == Constant.STRENGTHEN_TYPE.LEVELUP then
        --升级
        isRed = ItemModule:getItemNum(LEVELUP_ITEM) > 0
    elseif main == Constant.STRENGTHEN_TYPE.ENCHANT then
        if sub == Constant.SUB_TYPE.SUBTYPE1 then
            --附魔强化
            if ItemModule:getEnchantEquip() then
                for i = 1, #ENCHANT_ITEM do
                    if ItemModule:getItemNum(ENCHANT_ITEM[i]) > 0 then
                        isRed = true
                        break
                    end
                end
            end
        elseif sub == Constant.SUB_TYPE.SUBTYPE2 then
            --附魔祝福
            if ItemModule:getNoEnchantEquip() then
                for i = 1, #ENCHANT_GEM do
                    if ItemModule:getItemNum(ENCHANT_GEM[i]) > 0 then
                        isRed = true
                        break
                    end
                end
            end
        end
    elseif main == Constant.STRENGTHEN_TYPE.FUSION then
        --融合
        isRed = false
    elseif main == Constant.STRENGTHEN_TYPE.SUCCINCT then
        --洗炼
        isRed = false
    end
    self:setRedTips(main, sub, isRed)
end

function StrengthenModule:initRedTips()
    for main = 1, table.nums(Constant.STRENGTHEN_TYPE) do
        local subIdx = 1
        if main == Constant.STRENGTHEN_TYPE.LEVELUP then
            subIdx = 1
        elseif main == Constant.STRENGTHEN_TYPE.ENCHANT then
            subIdx = 2
        elseif main == Constant.STRENGTHEN_TYPE.FUSION then
            subIdx = 2
        elseif main == Constant.STRENGTHEN_TYPE.SUCCINCT then
            subIdx = 2
        end
        for sub = 1, subIdx do
            self:checkRedTips(main, sub)
        end
    end
end

function StrengthenModule:setRedTips(main, sub, bool)
    lt.RedDotModule:setTipsStateByName("StrengthenRedTips_"..main.."_"..sub, bool)
end

function StrengthenModule:getRedPoint(main, sub)
    local race = lt.GameModule:getHeroData():getRace()
    if main == nil and sub == nil then
        for main = 1, table.nums(Constant.STRENGTHEN_TYPE) do
            local subIdx = 1
            if main == Constant.STRENGTHEN_TYPE.LEVELUP then
                subIdx = 1
            elseif main == Constant.STRENGTHEN_TYPE.ENCHANT then
                subIdx = 2
            elseif main == Constant.STRENGTHEN_TYPE.FUSION then
                subIdx = 2
            elseif main == Constant.STRENGTHEN_TYPE.SUCCINCT then
                subIdx = 2
            end
            for sub = 1, subIdx do
                local red = self:getRedPoint(main, sub)
                if red then
                    return true
                end
            end
        end
        return false
    elseif main ~= nil and sub == nil then
        local subIdx = 1
        if main == Constant.STRENGTHEN_TYPE.LEVELUP then
            subIdx = 1
        elseif main == Constant.STRENGTHEN_TYPE.ENCHANT then
            subIdx = 2
        elseif main == Constant.STRENGTHEN_TYPE.FUSION then
            subIdx = 2
        elseif main == Constant.STRENGTHEN_TYPE.SUCCINCT then
            subIdx = 2
        end
        for sub = 1, subIdx do
            local red = self:getRedPoint(main, sub)
            if red then
                return true
            end
        end
        return false
    end
    local isShowRedDot = lt.RedDotModule:getTipsStateByName("StrengthenRedTips_"..main.."_"..sub)
    return isShowRedDot
end

