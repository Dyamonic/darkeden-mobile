--下一级是否超出能力上限
function StrengthenModule:checkOverRequire(itemInfo, idx)
    --装备词条额外等级限制
    local totalAffixLv = lt.StrengthenModule:getTotalAffixLv(itemInfo)
    if idx then totalAffixLv = totalAffixLv + idx end
    local itemConfig = itemInfo:getItemMeta()

    -- 等级限制
    local advState, level = itemConfig:getNeedLevel()
    local heroData = lt.GameModule:getHeroData()
    if advState == Constant.AdvState.NotAdv and level > 0 then -- 转职前等级限制
        level = level + totalAffixLv
        local heroLevel = heroData:getLevel()
        if heroLevel < level then
            return true
        end
    end

    if advState == Constant.AdvState.Adv and level > 0 then -- 转职后等级限制
        local heroLevel = heroData:getAdvanceLevel()
        if heroLevel < level then
            return true
        end
    end
    
    local requireSTR = itemConfig:getRequireSTR()
    if requireSTR > 0 then
        requireSTR = requireSTR + totalAffixLv*2
        local heroStr = heroData:getTotalSTR()
        if heroStr < requireSTR then
            return true
        end
    end

    local requireDEX = itemConfig:getRequireDEX()
    if requireDEX > 0 then
        requireDEX = requireDEX + totalAffixLv
        local heroDex = heroData:getTotalDEX()
        if heroDex < requireDEX then
            return true
        end
    end

    local requireINT = itemConfig:getRequireINT()
    if requireINT > 0 then
        requireINT = requireINT + totalAffixLv
        local heroInt = heroData:getTotalINT()
        if heroInt < requireINT then
            return true
        end
    end
    
    local requireSum = itemConfig:getRequireSum()
    if requireSum > 0 then
        requireSum = requireSum + totalAffixLv
        local heroTotal = heroData:getTotalSTR() + heroData:getTotalDEX() + heroData:getTotalINT()
        if heroTotal < requireSum then
            return true
        end
    end

    return false
end

