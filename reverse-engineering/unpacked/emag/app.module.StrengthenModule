    elseif index == Constant.TYPEFILTER.REFINELEFT then
        if item then
            if item:getItemType() == Constant.ItemType.ITEM_TYPE_PROP then
                local effectParam = item:getEffectParam()
                if effectParam and effectParam ~= "" and effectParam[1][1] == "RefineMaterial" then
                    if effectParam[1][2] ~= itemInfo:getILevel() then
                        str = GReadText.KEY_STRENGTHEN_TIPS108
                    end
                end
            else
                if not self:isSameKindAndType(item, itemInfo) then
                    str = GReadText.KEY_STRENGTHEN_TIPS108
                elseif item:getILevel() ~= itemInfo:getILevel() then
                    str = GReadText.KEY_STRENGTHEN_TIPS109
                end
            end
        else
            str = GReadText.KEY_STRENGTHEN_TIPS105
        end
    elseif index == Constant.TYPEFILTER.REFINERIGHT then
        if itemInfo:getItemType() == Constant.ItemType.ITEM_TYPE_PROP then
            local effectParam = itemInfo:getEffectParam()
            if effectParam and effectParam ~= "" and effectParam[1][1] == "RefineMaterial" then
                if effectParam[1][2] ~= item:getILevel() then
                    str = GReadText.KEY_STRENGTHEN_TIPS107
                end
            end
        else
            if not self:isSameKindAndType(item, itemInfo) then
                str = GReadText.KEY_STRENGTHEN_TIPS106
            elseif item:getILevel() ~= itemInfo:getILevel() then
                str = GReadText.KEY_STRENGTHEN_TIPS107
            end
        end
    end
    return str
end

