--是否为首饰套类型
function StrengthenModule:isJewelrySuit(itemInfo)
    local meta = itemInfo:getItemMeta()
    if meta:getKind() == lt.Constant.EquipKind.CircletSuit
    or meta:getKind() == lt.Constant.EquipKind.PendantsSuit
    or meta:getKind() == lt.Constant.EquipKind.WristletSuit then
        return true
    end
    return false
end

--是否可进阶
function StrengthenModule:getIsAdvanced(itemInfo, lv)
    local meta = itemInfo:getItemMeta()
    local eqMeta = CacheManager:getEquipUpgradeMeta(meta:getRank(), lv+1)
    if eqMeta == nil then
        return 1
    end
    return 0
end

--获取激活的属性
function StrengthenModule:getActiveProp(itemInfo, lv)
    local activeProp = {}
    local tempProp = {}
    local meta = itemInfo:getItemMeta()
    local eqMeta = CacheManager:getEquipUpgradeMeta(meta:getRank(), lv)
    local attributeDisplay = meta:getAttributeDisplay()
    local displays = string.split(attributeDisplay, ",")

    if self:getAttrShow(displays[Constant.EqAttrShowType.DURABILITY]) then
        tempProp[self.TYPE_ACTIVEPROP.DURABILITY] = {value = meta:getDurability() + eqMeta:getDurability(), sort = 1}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.PROTECTION]) then
        tempProp[self.TYPE_ACTIVEPROP.DEFENSE] = {value = meta:getDefense() + eqMeta:getDefense(), sort = 2}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.MINDAMAGE]) then
        tempProp[self.TYPE_ACTIVEPROP.MINDAMAGE] = {value = meta:getMinDamage() + eqMeta:getMinDamage(), sort = 3}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.MAXDAMAGE]) then
        tempProp[self.TYPE_ACTIVEPROP.MAXDAMAGE] = {value = meta:getMaxDamage() + eqMeta:getMaxDamage(), sort = 4}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.DEFENCE]) then
        tempProp[self.TYPE_ACTIVEPROP.DODGE] = {value = meta:getDodge() + eqMeta:getDodge(), sort = 5}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.CRITICALHIT]) then
        tempProp[self.TYPE_ACTIVEPROP.CRITICALHIT] = {value = meta:getCriticalHit() + eqMeta:getCriticalHit(), sort = 6}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.SILVERMAX]) then
        tempProp[self.TYPE_ACTIVEPROP.SILVERMAX] = {value = meta:getSilverMax() + eqMeta:getSilverMax(), sort = 7}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.LUCK]) then
        tempProp[self.TYPE_ACTIVEPROP.LUCK] = {value = meta:getLuck() + eqMeta:getLuck(), sort = 8}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.STR]) then
        tempProp[self.TYPE_ACTIVEPROP.STR] = {value = meta:getStr() + eqMeta:getStr(), sort = 1}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.DEX]) then
        tempProp[self.TYPE_ACTIVEPROP.DEX] = {value = meta:getDex() + eqMeta:getDex(), sort = 2}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.INT]) then
        tempProp[self.TYPE_ACTIVEPROP.INT] = {value = meta:getInt() + eqMeta:getInt(), sort = 3}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.PDAM]) then
        tempProp[self.TYPE_ACTIVEPROP.PDAM] = {value = meta:getPdam() + eqMeta:getPdam(), sort = 6}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.PPRO]) then
        tempProp[self.TYPE_ACTIVEPROP.PPRO] = {value = meta:getPpro() + eqMeta:getPpro(), sort = 7}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.MDAM]) then
        tempProp[self.TYPE_ACTIVEPROP.MDAM] = {value = meta:getMdam() + eqMeta:getMdam(), sort = 8}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.MPRO]) then
        tempProp[self.TYPE_ACTIVEPROP.MPRO] = {value = meta:getMpmo() + eqMeta:getMpmo(), sort = 9}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.ATTR]) then
        tempProp[self.TYPE_ACTIVEPROP.ATTR] = {value = meta:getAttr() + eqMeta:getAttr(), sort = 10}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.DBTM]) then
        tempProp[self.TYPE_ACTIVEPROP.DBTM] = {value = (meta:getDbtm() + eqMeta:getDbtm())/100, sort = 11}
    end
    if self:getAttrShow(displays[Constant.EqAttrShowType.DBTP]) then
        tempProp[self.TYPE_ACTIVEPROP.DBTP] = {value = (meta:getDbtp() + eqMeta:getDbtp())/100, sort = 12}
    end

    for k, v in pairs(tempProp) do
        table.insert(activeProp, k.."|"..v.value.."|"..v.sort)
    end
    table.sort(activeProp, function(a, b)
        return tonumber(string.split(a, "|")[3]) < tonumber(string.split(b, "|")[3])
    end)
    return activeProp
end

--获取下级属性
function StrengthenModule:getNextProp(itemInfo, lv)
    local activeProp = {}
    local meta = itemInfo:getItemMeta()
    local eqMeta = CacheManager:getEquipUpgradeMeta(meta:getRank(), lv)
    if eqMeta and self:getIsAdvanced(itemInfo, lv) == 0 then
        local nextMeta = CacheManager:getEquipUpgradeMeta(meta:getRank(), lv+1)
        activeProp[self.TYPE_ACTIVEPROP.DURABILITY] = nextMeta:getDurability() - eqMeta:getDurability()
        activeProp[self.TYPE_ACTIVEPROP.DEFENSE] = nextMeta:getDefense() - eqMeta:getDefense()
        activeProp[self.TYPE_ACTIVEPROP.MINDAMAGE] = nextMeta:getMinDamage() - eqMeta:getMinDamage()
        activeProp[self.TYPE_ACTIVEPROP.MAXDAMAGE] = nextMeta:getMaxDamage() - eqMeta:getMaxDamage()
        activeProp[self.TYPE_ACTIVEPROP.DODGE] = nextMeta:getDodge() - eqMeta:getDodge()
        activeProp[self.TYPE_ACTIVEPROP.CRITICALHIT] = nextMeta:getCriticalHit() - eqMeta:getCriticalHit()
        activeProp[self.TYPE_ACTIVEPROP.SILVERMAX] = nextMeta:getSilverMax() - eqMeta:getSilverMax()
        activeProp[self.TYPE_ACTIVEPROP.LUCK] = nextMeta:getLuck() - eqMeta:getLuck()
        activeProp[self.TYPE_ACTIVEPROP.STR] = nextMeta:getStr() - eqMeta:getStr()
        activeProp[self.TYPE_ACTIVEPROP.DEX] = nextMeta:getDex() - eqMeta:getDex()
        activeProp[self.TYPE_ACTIVEPROP.INT] = nextMeta:getInt() - eqMeta:getInt()
        activeProp[self.TYPE_ACTIVEPROP.PDAM] = nextMeta:getPdam() - eqMeta:getPdam()
        activeProp[self.TYPE_ACTIVEPROP.PPRO] = nextMeta:getPpro() - eqMeta:getPpro()
        activeProp[self.TYPE_ACTIVEPROP.MDAM] = nextMeta:getMdam() - eqMeta:getMdam()
        activeProp[self.TYPE_ACTIVEPROP.MPRO] = nextMeta:getMpmo() - eqMeta:getMpmo()
        activeProp[self.TYPE_ACTIVEPROP.ATTR] = nextMeta:getAttr() - eqMeta:getAttr()
        activeProp[self.TYPE_ACTIVEPROP.DBTM] = (nextMeta:getDbtm() - eqMeta:getDbtm())/100
        activeProp[self.TYPE_ACTIVEPROP.DBTP] = (nextMeta:getDbtp() - eqMeta:getDbtp())/100
        activeProp.add = true
    elseif eqMeta and self:getIsAdvanced(itemInfo, lv) == 1 and meta:getNextItemIdx() ~= 0 then
        local targetMeta = CacheManager:queryEquipMeta(meta:getNextItemIdx())
        local nextMeta = CacheManager:getEquipUpgradeMeta(targetMeta:getRank(), 1)
        activeProp[self.TYPE_ACTIVEPROP.DURABILITY] = targetMeta:getDurability() + nextMeta:getDurability()
        activeProp[self.TYPE_ACTIVEPROP.DEFENSE] = targetMeta:getDefense() + nextMeta:getDefense()
        activeProp[self.TYPE_ACTIVEPROP.MINDAMAGE] = targetMeta:getMinDamage() + nextMeta:getMinDamage()
        activeProp[self.TYPE_ACTIVEPROP.MAXDAMAGE] = targetMeta:getMaxDamage() + nextMeta:getMaxDamage()
        activeProp[self.TYPE_ACTIVEPROP.DODGE] = targetMeta:getDodge() + nextMeta:getDodge()
        activeProp[self.TYPE_ACTIVEPROP.CRITICALHIT] = targetMeta:getCriticalHit() + nextMeta:getCriticalHit()
        activeProp[self.TYPE_ACTIVEPROP.SILVERMAX] = targetMeta:getSilverMax() + nextMeta:getSilverMax()
        activeProp[self.TYPE_ACTIVEPROP.LUCK] = targetMeta:getLuck() + nextMeta:getLuck()
        activeProp[self.TYPE_ACTIVEPROP.STR] = targetMeta:getStr() + nextMeta:getStr()
        activeProp[self.TYPE_ACTIVEPROP.DEX] = targetMeta:getDex() + nextMeta:getDex()
        activeProp[self.TYPE_ACTIVEPROP.INT] = targetMeta:getInt() + nextMeta:getInt()
        activeProp[self.TYPE_ACTIVEPROP.PDAM] = targetMeta:getPdam() + nextMeta:getPdam()
        activeProp[self.TYPE_ACTIVEPROP.PPRO] = targetMeta:getPpro() + nextMeta:getPpro()
        activeProp[self.TYPE_ACTIVEPROP.MDAM] = targetMeta:getMdam() + nextMeta:getMdam()
        activeProp[self.TYPE_ACTIVEPROP.MPRO] = targetMeta:getMpmo() + nextMeta:getMpmo()
        activeProp[self.TYPE_ACTIVEPROP.ATTR] = targetMeta:getAttr() + nextMeta:getAttr()
        activeProp[self.TYPE_ACTIVEPROP.DBTM] = (targetMeta:getDbtm() + nextMeta:getDefense())/100
        activeProp[self.TYPE_ACTIVEPROP.DBTP] = (targetMeta:getDbtp() + nextMeta:getDefense())/100
        activeProp.add = false
    end
    return activeProp
end

--获取属性是否显示
function StrengthenModule:getAttrShow(attr)
    return attr == showFlag
end

--是否可进阶
function StrengthenModule:isAdvanced(itemInfo, lv)
    if lv <= 0 then return false end
    local meta = itemInfo:getItemMeta()
    local eqMeta = CacheManager:getEquipUpgradeMeta(meta:getRank(), lv)
    local nextEquip = meta:getNextItemIdx()
    if eqMeta and self:getIsAdvanced(itemInfo, lv) == 1 and nextEquip ~= 0 then
        return true
    end
    return false
end

--是否满级
function StrengthenModule:isLevelMax(itemInfo, lv)
    local meta = itemInfo:getItemMeta()
    local eqMeta = CacheManager:getEquipUpgradeMeta(meta:getRank(), lv)
    if eqMeta and self:getIsAdvanced(itemInfo, lv) == 1 then
        return true
    end
    return false
end

--获得升级概率
function StrengthenModule:getLevelUpRate(itemInfo, lv)
    local meta = itemInfo:getItemMeta()
    local eqMeta = CacheManager:getEquipUpgradeMeta(meta:getRank(), lv)
    if not eqMeta then
        return -1
    end
    return eqMeta:getUpgradeRate()/100
end

--获得升级消耗
function StrengthenModule:getItemCost(itemInfo, lv)
    local meta = itemInfo:getItemMeta()
    local eqMeta = CacheManager:getEquipUpgradeMeta(meta:getRank(), lv)
    if meta:getNextItemIdx() == 0 and self:getIsAdvanced(itemInfo, lv) == 1 then
        return 0, 0
    end
    local cost = eqMeta:getItemCost()
    local lord = eqMeta:getLordCost()
    return cost[2], cost[3], lord[3]
end

--获得升级消耗
function StrengthenModule:getLevelUpCost(itemInfo, lv)
    if itemInfo == nil then
        return {{1, 712001, 1}}, 0 
    end
    local meta = itemInfo:getItemMeta()
    local eqMeta = CacheManager:getEquipUpgradeMeta(meta:getRank(), lv)
    if meta:getNextItemIdx() == 0 and self:getIsAdvanced(itemInfo, lv) == 1 then
        return {{1, 712001, 1}}, 0
    end
    local cost = eqMeta:getItemCost()
    local lord = eqMeta:getLordCost()
    return {cost}, lord[3]
end

-- 装备升级
function StrengthenModule:sendEquipLevelup(types, objId, itemUid, costItemUid)
    if types == 1 then
        --升阶
        local msg = netcmd_pb.CS_EquipUpRankReq()
        msg.itemObjId = objId
        SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_EQUIP_UPRANK_REQ), msg)
    else
        --升级
        local msg = netcmd_pb.CS_EquipUpgradeReq()
        msg.itemUid = itemUid
        msg.costItemUid = costItemUid or "0"
        SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_EQUIP_UPGRADE_REQ), msg)
    end
end

--装备升阶回调
function StrengthenModule:onEquipLevelup(event)
    lt.LogUtil:debugInfo("StrengthenModule:onEquipLevelup")
    local proto = event.param
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_EQUIP_LEVELUP, proto)
end

