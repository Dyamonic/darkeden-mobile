----------------------------装备筛选----------------------------
function StrengthenModule:getFilterEquips(index, itemInfo, item)
    --通用(限时装备和圣遗物不符合条件)
    if itemInfo:getItemType() == Constant.ItemType.ITEM_TYPE_EQUIP and (itemInfo:getDeadline() ~= 0 or itemInfo:getMetaRank() == 0) then
        return 0
    end
    local meta = itemInfo:getItemMeta()
    local attr = self:transformAffix(itemInfo)
    if index == Constant.TYPEFILTER.LEVELUP then
        --装备升级/升阶(武器防具首饰未满阶)
        if self:isJewelrySuit(itemInfo) then
            return 0
        end
        local lv = itemInfo:getILevel()
        if self:getIsAdvanced(itemInfo, lv) == 1 then
            if meta:getNextItemIdx() == 0 then
                return 0
            end
        end
        return 1
    elseif index == Constant.TYPEFILTER.STRENGTHNEN then
        --装备强化(所有词条未满级，至少有一个词条)
        if self:isJewelrySuit(itemInfo) then
            return 0
        end
        if #attr == 0 then
            return 0
        else
            if not self:getEnchantMax(attr) then
                return 1
            end
            return 0
        end
    elseif index == Constant.TYPEFILTER.BLESSING then
        --装备祝福(无词条)
        if self:isJewelrySuit(itemInfo) then
            return 0
        end
        if #attr > 0 then
            return 0
        end
        return 1
    elseif index == Constant.TYPEFILTER.COMPOSELEFT then
        --装备合成(左单词条)
        if self:isJewelrySuit(itemInfo) then
            return 0
        end
        if item then
            if item:getObjId() == itemInfo:getObjId() then
                return 1
            end
        end
        if #attr ~= 1 then
            return 0
        end
        if item then
            if not self:isSameKindAndType(item, itemInfo) then
                return 0
            end
            if item:getMetaRank() ~= itemInfo:getMetaRank() then
                return 0
            end
            if math.abs(item:getILevel() - itemInfo:getILevel()) > 2 then
                return 0
            end
            local attr2 = self:transformAffix(item)
            if attr[1][1] == attr2[1][1] then
                return 0
            end
        end
        return 1
    elseif index == Constant.TYPEFILTER.INHERITLEFT then
        --装备传承(左三词条)
        if self:isJewelrySuit(itemInfo) then
            return 0
        end
        if item then
            if item:getObjId() == itemInfo:getObjId() then
                return 1
            end
        end
        if #attr ~= 3 then
            return 0
        end
        if item then
            if #attr ~= 3 then
                return 0
            end
            if not self:isSameKind(item, itemInfo) then
                return 0
            end
        end
        return 1
    elseif index == Constant.TYPEFILTER.RECASTING then
        --装备重铸(满级三词条)
        if self:isJewelrySuit(itemInfo) then
            return 0
        end
        if #attr == 3 then
            if not self:getEnchantMax(attr) then
                return 0
            end
            return 1
        else
            return 0
        end
    elseif index == Constant.TYPEFILTER.PURIFY then
        --装备净化(单/两词条)
        if self:isJewelrySuit(itemInfo) then
            return 0
        end
        if #attr == 1 or #attr == 2 then
            return 1
        end
        return 0
    elseif index == Constant.TYPEFILTER.COMPOSERIGHT then
        --装备合成(右单词条)
        if self:isJewelrySuit(itemInfo) then
            return 0
        end
        if item:getObjId() == itemInfo:getObjId() then
            return 1
        end
        if #attr ~= 1 then
            return 0
        end
        if not self:isSameKindAndType(item, itemInfo) then
            return 0
        end
        if item:getMetaRank() ~= itemInfo:getMetaRank() then
            return 0
        end
        if math.abs(item:getILevel() - itemInfo:getILevel()) > 2 then
            return 0
        end
        local attr2 = self:transformAffix(item)
        if attr[1][1] == attr2[1][1] then
            return 0
        end
        return 1
    elseif index == Constant.TYPEFILTER.INHERITRIGHT then
        --装备传承(右两词条)
        if self:isJewelrySuit(itemInfo) then
            return 0
        end
        if item:getObjId() == itemInfo:getObjId() then
            return 1
        end
        if #attr ~= 2 then
            return 0
        end
        if not self:isSameKind(item, itemInfo) then
            return 0
        end
        return 1
    elseif index == Constant.TYPEFILTER.TRANSFORM then
        --装备转换
        local transformMeta = StrengthenModule:getTransformData(meta:getItemId())
        if #transformMeta <= 0 then
            return 0
        end
        if transformMeta[1]:getType() ~= 1 and  transformMeta[1]:getType() ~= 2 then
            return 0
        end
        return 1
    elseif index == Constant.TYPEFILTER.MOTIVATE then
        --首饰套激发
        if not self:isJewelrySuit(itemInfo) then
            return 0
        end
        return 1
    elseif index == Constant.TYPEFILTER.REFINELEFT then
        --首饰套精炼(左)
        if not self:isJewelrySuit(itemInfo) then
            return 0
        end
        if item then
            if item:getObjId() == itemInfo:getObjId() then
                return 1
            end
            if item:getItemType() == Constant.ItemType.ITEM_TYPE_PROP then
                local effectParam = item:getEffectParam()
                if effectParam and effectParam ~= "" and effectParam[1][1] == "RefineMaterial" then
                    if effectParam[1][2] ~= itemInfo:getILevel() then
                        return 0
                    end
                end
            else
                if not self:isSameKindAndType(item, itemInfo) then
                    return 0
                end
                if item:getILevel() ~= itemInfo:getILevel() then
                    return 0
                end
            end
        end
        return 1
    elseif index == Constant.TYPEFILTER.REFINERIGHT then
        --首饰套精炼(右)
        if not self:isJewelrySuit(itemInfo) then
            return 0
        end
        if item:getObjId() == itemInfo:getObjId() then
            return 1
        end
        local lv = itemInfo:getILevel()
        if self:getIsAdvanced(itemInfo, lv) == 1 then
            if meta:getNextItemIdx() == 0 then
                return 0
            end
        end
        if not self:isSameKindAndType(item, itemInfo) then
            return 0
        end
        if item:getILevel() ~= itemInfo:getILevel() then
            return 0
        end
        return 1
    end
    return 0
end

