--[[ 
创建物品组
data            物品组数据
alignment       对齐方式 UIMgr.ALIGNMENT , 默认左对齐
interval        间距
]]
function UIMgr:createItemGroup(data, param)
    if not data or type(data) ~= "table" then
        return 
    end

    param = param or {}
    local alignment = param.alignment or UIMgr.ALIGNMENT.LEFT
    local interval  = param.interval or 10

    local node = display.newNode()

    local unitX = 0
    local items = {}
    function node:generateItem(data)
        -- 生成物品
        node:removeAllChildren()
        items = {}

        local x, y = 0, 0
        for i,v in ipairs(data) do
            local box = lt.UIWgtItemMetaBox:new()
            box:setItemInfo(v.itemType, v.itemId, v.itemNum)
            node:addChild(box)

            unitX = box:getContentSize().width
            
            items[#items+1] = box
        end

        node:alignment(alignment)
    end

    function node:alignment(alignment)
        -- 仅考虑左对齐 居中对齐
        local anchor, x, y
        if alignment == UIMgr.ALIGNMENT.LEFT then
            anchor = cc.p(0, .5)
            x = 0
            y = 0
        else
            anchor = cc.p(.5, .5)
            local w = #items * unitX + (#items - 1) * interval
            x = -w/2 + unitX/2
            y = 0
        end

        for i,v in ipairs(items) do
            v:setAnchorPoint(anchor)
            v:setPosition(x, y)
            x = x + unitX + interval
        end
    end

    function node:getItems()
        return items
    end

    node:generateItem(data)
    -- node:alignment(alignment)
    return node
end


