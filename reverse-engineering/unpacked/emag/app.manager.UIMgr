-- 新增ui接口 

-- 通过一张 半切图片生成对称图片, 返回父节点
function UIMgr:creatSymmetryImg(params)
    params = params or {}

    local imgKey = params.imgKey or "_none"
    local offset = params.offset or cc.p(0, 0)

    local node = display.newNode()

    local leftImg  = display.newSprite(ResManager:getTex(imgKey), 0, 0)
    leftImg:setAnchorPoint(cc.p(1, .5))
    leftImg:setPosition(cc.p(offset.x, 0))
    node:addChild(leftImg) 

    local rightImg = display.newSprite(ResManager:getTex(imgKey), 0, 0)
    rightImg:setAnchorPoint(cc.p(1, .5))
    rightImg:setPosition(cc.p(-offset.x, 0))
    rightImg:setScaleX(-1)
    node:addChild(rightImg) 

    return node
end

--[[
参数详情,参考TextButton文件
]]
function UIMgr:createButton(image, text, params)
    local button = TextButton.new()
    button:init(image, text, params)
    return button
end


--[[
生成按钮标签组, 选中情况下暂时支持两种模式, 1. 选中按钮特殊图片显示 2. 选中高亮框不变图
参数params包括
@imgNormal      普通情况下的ui资源
@imgSpecial     按钮特殊图片(可选)
@imgSelect      选中高亮框ui资源 默认为 _scale9_select(可选)
@zoomScale      设置zoomScale(可选) 默认不放大即为0
@direction      按钮组方向, 默认垂直 [vertical, horizontal] 水平时以左对齐, 垂直顶对齐
@interval       按钮间距
@reddot         红点相关
@reddotOffset   红点位置偏移
@parent         一般只在节点组加入scrollview使用, 保证按钮点击事件往下传递使用
@btnOffset      一般只在节点组加入scrollview使用, 设置按钮位置 

@offset         文字在按钮上的偏移量, 默认是居中(可选)
-- 文字相关参数
@szTexts        按钮文字组table类型(一般情况根据此参数创建按钮组)
@fontSize       文字大小
@fontColor      文字颜色
@fontLineWidth  文字描边宽度
@fontLineColor  文字描边颜色

-- 美术字文字相关参数
@szImgs         按钮美术字资源

@tags           按钮设置的tag, (默认为标签index) 同时会传递给回调函数

@return         返回按钮父节点及按钮组
]]
function UIMgr:createTabGroup(params)
    params = params or {}
    local mode          = mode or "switch"
    local imgNormal     = params.imgNormal or "_tagBtn02"
    local imgSpecial    = params.imgSpecial or "_tagBtn01"
    local callback      = params.callback or function () end
    local direction     = params.direction or "vertical"
    local parent        = params.parent or display.newNode()
    -- local imgSelect     = params.imgSelect or "_scale9_select"

    local buttons = {}
    local button_size = nil
    if params.szTexts and type(params.szTexts) == "table" then
        for _,v in ipairs(params.szTexts) do
            local btn = self:createButton(imgNormal, v, {
                fontSize = params.fontSize,
                fontColor = params.fontColor,
                fontOffset = params.offset,
                size = params.size,
            })
            button_size = button_size or btn:getContentSize()

            if params.fontLineWidth or params.fontLineColor then
                btn:getTextWidget():setOutLine(params.fontLineColor or lt.Constant.COLOR_OUTLINE, params.fontLineWidth or 1)
            end

            buttons[#buttons+1] = btn
        end
    elseif params.szImgs and type(params.szImgs) == "table" then
        -- for _,v in ipairs(params.szTexts) do
            -- local btn = LabelButton:createImgButton(ResManager:getTex(imgNormal))
            
            -- buttons[#buttons+1] = btn
        -- end
    end

    local interval = params.interval or 0
    local zoomScale = tonumber(params.zoomScale) or 0
    local btnOffset = params.btnOffset or cc.p(0, 0)
    local ox = (direction == "vertical" and 0 or button_size.width/2) + btnOffset.x
    local oy = (direction == "vertical" and -button_size.height/2 or 0) + btnOffset.y

    local curTag  = nil
    local function buttonChgEvt(tag)
        if curTag and curTag == tag then
            return 
        end

        if mode == "switch" then
                -- 切换图片
            if buttons[curTag] then
                local fileName, resType = ResManager:realResPath(imgNormal)
                buttons[curTag]:loadTextureNormal(fileName, resType)
            end
            local fileName, resType = ResManager:realResPath(imgSpecial)
            buttons[tag]:loadTextureNormal(fileName, resType)
        elseif mode == "select" then
            -- 高亮选中标签

        end

        curTag = tag
    end

    local reddot        = params.reddot or false
    local reddotOffset  = params.reddotOffset or cc.p(-3, 2)
    -- local redFilter     = params.redFilter or {}

    local x, y = ox, oy
    for i,v in ipairs(buttons) do
        v:setPosition(cc.p(x, y))
        v:setZoomScale(zoomScale)
        v:addClickEventListener(function ()
            buttonChgEvt(i)
            callback(curTag, buttons[i])
        end)

        if params.tags and tonumber(params.tags[i]) then
            v:setTag(tonumber(params.tags[i]))
        else
            v:setTag(i)
        end

        if reddot then
            self:supportRed(v, cc.p(button_size.width + reddotOffset.x, button_size.height + reddotOffset.y))    
        end

        parent:addChild(v)

        x = direction == "vertical" and ox or x + button_size.width + interval
        y = direction == "vertical" and y - button_size.height - interval or oy
    end

    function parent:getTouchTag()
        return curTag
    end

    -- 只处理了tag ui上的变化, 以及curTag的值更新, 提供给外部单独调用按钮回调同步处理
    function parent:setTouchTag(i)
        buttonChgEvt(i)
    end

    function parent:getButton(tag)
        return buttons[tag]
    end

    -- 自适应, 用于处理部分中间按钮组被隐藏, 外部调用接口
    function parent:adapt()
        local x, y = ox, oy
        for i,v in ipairs(buttons) do
            if v:isVisible() then
                v:setPosition(cc.p(x, y))
                x = direction == "vertical" and ox or x + button_size.width + interval
                y = direction == "vertical" and y - button_size.height - interval or oy
            end
        end
    end

    -- function parent:getHeight()
    --     return y + button_size.height/2
    -- end

    return parent, buttons
end

--[[
暂时只支持简单由左往右的进度显示
@param image        图片资源路径
@param size         进度条最大显示区域
@param capInsets    九宫格拉伸区域大小
@param params       params用于显示进度条,自动创建label, 可配置参数
                    szText
                    fontSize
                    outlineSize
返回ClippingNode节点
@function setPercentage 设置进度 range[0-1]
@function setTextString 设置label文本
@function getLabel      获得label节点
]]
function UIMgr:createProgressTimer(image, size, params)
    params = params or {}

    local progressImg = self:createS9(image, size, params)

    local mask = display.newLayer(cc.c4b(0, 0, 0, 255), size)
    mask:setAnchorPoint(cc.p(0, .5))
    mask:setPosition(cc.p(-size.width/2, -size.height/2))
    local clippingNode = cc.ClippingNode:create(mask)
    clippingNode:setStencil(mask)
    clippingNode:addChild(progressImg)

    local curPer = nil
    clippingNode.setPercent = function (_, p)
        p = p > 1 and 1 or p
        p = p < 0 and 0 or p
        curPer = p
        mask:setContentSize(size.width*p, size.height)
    end
    clippingNode.getPercent = function (_, p)
        return curPer and curPer or 0
    end

    local retNode = clippingNode

    if params.szText then
        retNode = display.newNode()
        retNode:addChild(clippingNode)

        local label = ccui.Text:create()
        label:setString(params.szText or "")
        label:setFontName(Constant.FONT_2)
        label:setFontSize(fontSize or 14)
        label:setColor(params.fontColor or Constant.COLOR_TEXT_WHITE)
        label:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
        -- label:enableOutline(outlineColor or Constant.COLOR_OUTLINE, outlineSize or 2)
        retNode:addChild(label)

        retNode.setPercent = clippingNode.setPercent
        retNode.getPercent = clippingNode.getPercent
        
        retNode.setTextString = function (_, str)
            label:setString(str)
        end
        retNode.getLabel = function (_)
            return label
        end

        retNode.getClippingNode = function (_)
            return clippingNode
        end
    end

    return retNode
end

-- 美术分隔线
function UIMgr:createLine(params)
    params = params or {}
    local padding = params.padding or 10
    local res = params.res or "_imgCommonLine01"
    local w = params.width

    local line = display.newSprite(ResManager:getTex(res))
    line:setContentSize(w, line:getContentSize().height)
    line:setAnchorPoint(0, 0.5)

    return line
end

-- 下划线
function UIMgr:supportUnderLine(nodes, color)
    color = color or Constant.COLOR_BROWN_TIP

    local function _supportUnderLine(n)
        if not iskindof(n, "cc.Node") then
            return
        end

        local color = cc.convertColor(color, "4f")
        color.a = 1

        local underLine = cc.DrawNode:create(1)
        underLine:clear()
        underLine:drawLine(cc.p(0, 2), cc.p(n:getContentSize().width, 2), color)
        n:addChild(underLine)

        function n:getLine()
            return underLine
        end
    end

    if type(nodes) == "table" then
        for i,v in ipairs(nodes) do
            _supportUnderLine(v)
        end
    else
        _supportUnderLine(nodes)
    end
end

function UIMgr:supportRed(node, pos)
    if not pos then
        pos = cc.p(node:getContentSize().width, node:getContentSize().height)
    end

    local rd = display.newSprite(ResManager:getTex("_commonIconRed"), pos.x, pos.y)
    rd:setAnchorPoint(cc.p(1, 1))
    node:addChild(rd)

    function node:setRed(b)
        if rd then
            rd:setVisible(b)
        end
    end

    return rd
end

function UIMgr:supportHighlight(node, size, pos)
    if not pos then
        pos = cc.p(size.width / 2, size.height / 2)
    end
    local sprHighlight = ccui.Scale9Sprite:create(ResManager:resPath("_scale9_select"))
    sprHighlight:setContentSize(size)
    sprHighlight:setAnchorPoint(0.5, 0.5)
    sprHighlight:setPosition(pos.x, pos.y)
    node:addChild(sprHighlight)

    function node:setHighLight(b)
        if sprHighlight then
            sprHighlight:setVisible(b)
        end
    end

    return sprHighlight
end

function UIMgr:supportArrow(node, pos)
    if not pos then
        pos = cc.p(node:getContentSize().width, node:getContentSize().height / 2)
    end
    local arrow  = display.newSprite(ResManager:resPath("_imgSortJiantou"))
    arrow:setAnchorPoint(0.5, 0.5)
    arrow:setPosition(pos.x, pos.y)
    arrow:setRotation(90)
    node:addChild(arrow)

    function node:setArrowRotation(b)
        if arrow then
            arrow:setRotation(b)
        end
    end
end

-- 9宫图
function UIMgr:createS9(image, size, params)
    params = params or {}

    local s9 = ccui.Scale9Sprite:createWithSpriteFrame(ResManager:getSpriteFrame(image))
    s9:setContentSize(size)

    if params.capInsets then
        s9:setCapInsets(params.capInsets)
    end

    return s9
end

-- 勾选框, 带文本
function UIMgr:createOption(szText, params)
    params = params or {}

    local imgBg     = params.imgBg or "_commonTickBg"
    local imgTick   = params.imgTick or "_commonTick"
    local offset    = params.offset or cc.p(10, 0)
    local callback  = params.callback
    local state     = params.state or false

    local parent = display.newNode()
    local box = ccui.CheckBox:create(ResManager:realResPath(imgBg),ResManager:realResPath(imgTick))
    box:setPosition(box:getContentSize().width/2, 0)
    box:setSelected(state)
    if callback then
        box:addEventListener(callback)
    end
    parent:addChild(box)

    if szText then
        local content = StringManager:getString(szText)
        szText = type(content) == "string" and content ~= "" and content or szText
        
        local font = Constant.FONT_2
        local fontColor = params.fontColor or Constant.COLOR_TEXT_WHITE
        local fontSize = params.fontSize or 18
        local szOptionName = lt.LabelEx.new(szText, {
            font=font, size=fontSize, color=fontColor
        })
        szOptionName:setPosition(cc.p(box:getContentSize().width + offset.x, offset.y))
        szOptionName:setAnchorPoint(0, .5)
        parent:addChild(szOptionName)
    end

    function parent:getBox()
        return box
    end

    return parent
end

