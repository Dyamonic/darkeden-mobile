
local ActionInfoMeta = class("ActionInfoMeta")

local CommonFunc = lt.CommonFunc

ActionInfoMeta._skillId      = nil  -- 技能ID
ActionInfoMeta._order        = nil  -- 播放顺序
ActionInfoMeta._name         = nil   -- 
ActionInfoMeta._action       = nil  -- 动作类型
ActionInfoMeta._effectGeneratorId  = nil  -- 效果生成器ID
ActionInfoMeta._spriteId     = nil  -- 特效类型
ActionInfoMeta._bltType      = nil  -- 文件类型 3: screen
ActionInfoMeta._step         = nil  -- 步数
ActionInfoMeta._count        = nil  -- 计数
ActionInfoMeta._linkCount    = nil  -- 链接计数
ActionInfoMeta._soundId      = nil  -- 音效ID
ActionInfoMeta._resultTime   = nil  -- 结束时间
ActionInfoMeta._useCoord     = nil  -- 相同效果
ActionInfoMeta._dalayFrame   = nil  -- 延时多少帧播放
ActionInfoMeta._owner        = nil  -- 作用对象
function ActionInfoMeta:ctor(row)
	self:initWithRow(row)
end

function ActionInfoMeta:initWithRow(row)
    self._skillId       = row.SkillId
    self._order         = row.OrderId
    self._name          = row.EName2
    self._action        = row.Action
    self._effectGeneratorId   = row.EffectGeneratorID
    self._spriteId      = row.EffectSpriteType
    self._bltType       = row.BltType
    self._step          = row.Step
    self._count         = row.Count
    self._linkCount     = row.LinkCount
    self._soundId       = row.SoundId
    self._resultTime    = row.ResultTime
    self._useCoord      = row.UseCoord
    self._dalayFrame    = row.DalayFrame
    self._owner         = row.Owner
    self._playOffsetSpeed     = row.PlayOffsetSpeed

    -- 子弹移动速度偏移值
    local tbl = {}

    if #row.BulletOffsetMoveSpeed > 0 then
        tbl = CommonFunc:analysisJsonToTable(row.BulletOffsetMoveSpeed)
    end

    self._bulletOffsetMoveSpeedArr = tbl
end

-- Setter && Getter
function ActionInfoMeta:getSkillId()
    return self._skillId
end

function ActionInfoMeta:getOrder()
    return self._order
end

function ActionInfoMeta:getEname()
    return self._name
end

function ActionInfoMeta:getAciton()
    return self._action
end

function ActionInfoMeta:getSpriteId()
    return self._spriteId
end

function ActionInfoMeta:getEffectId()
    return self._spriteId
end

function ActionInfoMeta:getBltType()
    return self._bltType
end

function ActionInfoMeta:getSoundId()
    return self._soundId    
end

function ActionInfoMeta:getEffectGeneratorId()
    return self._effectGeneratorId
end

-- 特效播放步数
function ActionInfoMeta:getStep()
    return self._step
end

-- 延时多少动作帧再播放
function ActionInfoMeta:getDelayFrame()
    return self._dalayFrame
end

--[[
    bltType: 对应使用的资源
    1 -> effect
    3 -> effectscreen
    4 -> effecthigh
]]
function ActionInfoMeta:bltType()
    return self._bltType
end

--[[
-- MEffect::SetCount(DWORD last, DWORD linkCount) { 
-- 	m_EndFrame = g_CurrentFrame + last - 1; 
-- 	if (linkCount==MAX_LINKCOUNT) {
-- 		m_EndLinkFrame = m_EndFrame;
-- 	}else{
-- 		m_EndLinkFrame = g_CurrentFrame + linkCount - 1;
-- 	}
-- }
]]
function ActionInfoMeta:getCount()
    return self._count
end


function ActionInfoMeta:getOwner()
    return self._owner
end

--循环播放的配表不支持(-1)
function ActionInfoMeta:getLoopCount()
    return 1
end

-- 特效播放速度 offset
function ActionInfoMeta:getPlayOffsetSpeed()
    return self._playOffsetSpeed
end

-- 子弹移动速度 offset 分阶段级别速度
function ActionInfoMeta:getBulletOffsetMoveSpeed(stage)
    if not stage then
        stage = 1
    end

    if not self._bulletOffsetMoveSpeedArr[stage] then
        return 0
    end

    return self._bulletOffsetMoveSpeedArr[stage]
end

return ActionInfoMeta
