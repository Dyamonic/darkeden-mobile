
local MonsterStateDead = class("MonsterStateDead", lt.MonsterStateBase)

local Constant = lt.Constant

--[[
    已死亡状态的怪物 
    重新上线或者进入新地图时状态
    用于保留最后一帧或2帧
]]
function MonsterStateDead:ctor(monsterAgent)
    MonsterStateDead.super.ctor(self, monsterAgent)
    self._modelId = monsterAgent:getMonsterData():getModelId()

end

function MonsterStateDead:onClear()
end

function MonsterStateDead:onEnter()
    if not lt.SkillEnum.IS_SUMMON_MODEL[self._modelId] then  --技能召唤怪物不播死亡动作
        self._monsterAgent:playDeadAction(Constant.ROLE_ACTION_DIE)
    else
        self._monsterAgent:setCorpseVisible(true)
    end
    self._monsterAgent:setIsOutOfGame(true)
    self._monsterAgent:hideNameNode()
end

function MonsterStateDead:onExit()
end

function MonsterStateDead:onUpdate()
end

function MonsterStateDead:onMessage(msg)
end

function MonsterStateDead:getStateId()
    return Constant.MONSTER_STATE_DEAD
end

function MonsterStateDead:getStateName()
    return "MonsterStateDead"
end

return MonsterStateDead
