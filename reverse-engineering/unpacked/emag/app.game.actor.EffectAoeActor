local EffectAoeActor = class("EffectAoeActor", function()
    return display.newNode()
end)
--[[
    单个序列帧特效
]]

local EffectManager = lt.EffectManager
local TimeTrigger = lt.TimeTrigger

function EffectAoeActor:ctor(actionInfoMeta, direction)
    self._actionInfoMeta = actionInfoMeta
    self._direction = direction

    local sp = display.newSprite()
    sp:setAnchorPoint(0.5, 0.5)
    self:addChild(sp)

    self._spriteEffect = sp

    self._effectLoopCount = 0
    self._nextEffectFrameIndex = 1
    self._timeTrigger = TimeTrigger.new()

    self:playEffect(actionInfoMeta, direction)
end

function EffectAoeActor:onClear()
    self._endEffect = nil
    self._effectInfo = nil

    self:removeAllChildren()
    self:removeFromParent()

    self._spriteEffect = nil
    self._timeTrigger = nil
end

function EffectAoeActor:setPositionEx(x, y)
    self:setPosition(x, y)
end

function EffectAoeActor:onUpdateEffect()
    if not self._isEndEffect then
		return
	end

    local effectInfo = self._effectInfo
    if not effectInfo or effectInfo:getLoop() then
        return
    end

    -- 默认循环1次
    local loop = effectInfo:getLoop()
    local frameCount = effectInfo:getSpriteFrameCount()

    if loop ~= -1 and (self._effectLoopCount >= loop or self._nextEffectFrameIndex > frameCount) then
        return
    end

    if self._timeTrigger:tick() then
        self:gotoNextEffectFrame()

        -- 循环数已到,添加循环次数
        if self._nextEffectFrameIndex > frameCount then
            self._nextEffectFrameIndex = 1
            self._effectLoopCount = self._effectLoopCount + 1

            if self:loopEnd(self._effectLoopCount, loop) then
                -- 关闭显示 
                self:closeLoopEffect()
            end
        end
    end
end

function EffectAoeActor:gotoNextEffectFrame()
    if self._actionPause then
        return
    end

    self:updateEffectFrame(self._spriteEffect, self._nextEffectFrameIndex, self._effectInfo)
    
    self._nextEffectFrameIndex = self._nextEffectFrameIndex + 1
end

-- 显示特效
function EffectAoeActor:updateEffectFrame(effectSprite, frameIdx, effectInfo)
    effectSprite:setVisible(true)
    
    local frame = effectInfo:getSpriteFrame(frameIdx)
    local bltType = effectInfo:getBltType()
    if frame then
        local sprite = frame.sprite
        if sprite == nil then
            return
        end

        effectSprite:setSpriteFrame(sprite)
        if bltType == lt.Constant.BLT_TYPE.BLT_SCREEN then
            effectSprite:setBlendFunc(({src = ccb.BlendFactor.ONE, dst = ccb.BlendFactor.ONE}))
        end

        local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
        effectSprite:setPosition(pos)
    end
end

-- 循环次数是否结束
function EffectAoeActor:loopEnd(loop, maxLoop)
    if maxLoop == -1 then
        return false
    end

    if loop >= maxLoop then
        return true
    end

    return false
end

function EffectAoeActor:closeLoopEffect()
    self._spriteEffect:setVisible(false)

    -- 随时清理
    self:endEffect()
end

function EffectAoeActor:endEffect()
    self._endEffect = false
    self._effectInfo = nil
end


-- 加入播放列表 
function EffectAoeActor:playEffect(actionInfoMeta, direction)
    self._effectInfo = EffectManager:getEffectInfo(actionInfoMeta:getEffectId(), direction or 0, actionInfoMeta:bltType())
    self._timeTrigger:reset(self._effectInfo:getStep())
    self:startEffect()
end

function EffectAoeActor:startEffect(bltType)
    self._effectLoopCount = 0
    self._nextEffectFrameIndex = 1

    self._endEffect = true
end

function EffectAoeActor:getSkillId()
    return self._actionInfoMeta:getSkillId()
end

--[[
    天炼换算偏移值坐标
    天炼坐标系     手游坐标系
   ├──────────     │ 
   │      x        │y
   │y              │     x
   │               ├──────────

    newX = x + offsetX + width/2
    newY = x + offsetY + height/2
]]
function EffectAoeActor:conversionOffsetPoint(point, offset, size)
    local conX, conY
    conX = point.x + offset.x + size.width/2
    conY = point.y - offset.y - size.height/2
    return cc.p(conX, conY)
end

return EffectAoeActor