
local GameManager = {}
GameManager._config = nil

function GameManager:init()
    self:getConfig()
end

function GameManager:clear()
    self._config = nil
end

function GameManager:getConfig()
	if not self._config then
		local path = cc.FileUtils:getInstance():fullPathForFilename("game.plist")
		self._config = cc.FileUtils:getInstance():getValueMapFromFile(path)
	end

	return self._config
end

function GameManager:getUserType()
	return self:getConfig()["GAME_USER_TYPE"]
end

function GameManager:getIOSEnterPrise()
    return ("enterprise" == self:getUserType() or "tianxia" == self:getUserType()) and device.platform == "ios"
end

function GameManager:getIsAZSiPuUserType()
    return "azsipu" == self:getUserType()
end

