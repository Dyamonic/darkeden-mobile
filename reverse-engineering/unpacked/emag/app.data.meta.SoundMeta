local SoundMeta = class("SoundMeta")


function SoundMeta:ctor(row)
	self:initWithRow(row)
end

function SoundMeta:initWithRow(row)
    self._soundID    = row.SoundId
    self._soundName  = row.SoundName
end

function SoundMeta:getSoundPath()
    local soundPath = string.format("audio/sound/%s.wav", self._soundName)
    return soundPath
end

