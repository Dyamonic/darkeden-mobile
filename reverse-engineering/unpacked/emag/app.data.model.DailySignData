local DailySignData = class("DailySignData")

table.merge(DailySignData, {
    _day            = nil,          -- 天数
    _state          = nil,          -- 领取状态
    _extraState     = nil,          -- 额外奖励领取状态
})

function DailySignData:setData(data)
    self._day        = data.day
    self._state      = data.state
    self._extraState = data.ExtraState
end

function DailySignData:getDay()
    return self._day
end

function DailySignData:getState()
    return self._state
end

function DailySignData:getExtraState()
    return self._extraState
end

return DailySignData
