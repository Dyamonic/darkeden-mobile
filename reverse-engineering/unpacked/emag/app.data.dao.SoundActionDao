local SoundActionDao = {}

function SoundActionDao:queryAll()
    local tb = {}
    local db = lt.DbManager:getDb()
     
    for row in db:nrows("SELECT * FROM ActionSound") do
    	local meta = lt.SoundActionMeta.new(row)
        if not tb[meta:getActionCombId()] then
            tb[meta:getActionCombId()] = {}
        end
        if not tb[meta:getActionCombId()][meta:getActionId()] then
            tb[meta:getActionCombId()][meta:getActionId()] = meta
        end
    end

    return tb
end

return SoundActionDao