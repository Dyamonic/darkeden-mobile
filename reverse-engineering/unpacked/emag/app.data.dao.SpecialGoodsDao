local SpecialGoodsDao = {}

function SpecialGoodsDao:query(itemId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM SpecialGoods WHERE ItemId=%d;", tonumber(itemId))) do
    	local meta = lt.SpecialGoodsMeta.new(row)
        return meta
    end
end

function SpecialGoodsDao:querySingle()
    local specialMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM SpecialGoods") do
        local meta = lt.SpecialGoodsMeta.new(row)
        specialMap[meta:getItemId()] = meta
    end
    return specialMap
end

function SpecialGoodsDao:queryAll()
    local specialMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM SpecialGoods") do
        local meta = lt.SpecialGoodsMeta.new(row)
        if not specialMap[meta:getShopType()] then
            specialMap[meta:getShopType()] = {}
        end
        specialMap[meta:getShopType()][meta:getSite()] = meta
    end
    return specialMap
end

return SpecialGoodsDao