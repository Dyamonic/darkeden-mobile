    -- local nextMN = MapUtil:getNextTileByDirection(mHero, nHero, direction)
    -- local sX, sY = lt.MapUtil:calcMNMid(nextMN.x, nextMN.y)
    local sX, sY =  lt.MapUtil:calcMNMid(mHero, nHero)


    local egInfo = {
