-- 技能释放成功效果
function SkillManager:skillReleaseSuccess(proto)
    -- print("GameModule:skillReleaseSuccess(proto)",proto.skillID, proto.x, proto.y, proto.targetX, proto.targetY, proto.ret, proto.extraCode)
    local skillId = proto.skillID
    local skillLevel = SkillModule:getSkillLevel(skillId)
    local skillGrade = SkillModule:getGradeBySkillLevel(skillLevel,skillId)
    local targetM, targetN = proto.targetX, proto.targetY
    local targetID = proto.targetID
    local extraCode = tonumber(proto.extraCode)
    local worldAgent = lt.AgentManager:getWorldAgent()
    local targetAgent = worldAgent:getAgent(targetID)

    local targetAgentId = nil
    if targetAgent then
        targetAgentId = targetAgent:getAgentId()
    end
    local hitCode = tonumber(proto.ret)
    local heroAgent = lt.AgentManager:getHeroAgent()
    if not heroAgent then
        return
    end
    local fromAgentId = heroAgent:getAgentId()
    if skillId == SkillEnum.SKILL_CURE_POISON             -- 解毒
        or skillId == SkillEnum.SKILL_CURE_LIGHT_WOUNDS       -- 治疗术
        or skillId == SkillEnum.SKILL_REMOVE_CURSE            -- 解除诅咒
        then
        self:playQueueEffectDelay(skillId, targetAgent:getAgentId(), SkillEnum.EFFECT_OWNER.OTHER, skillGrade)
    elseif skillId == SkillEnum.SKILL_EVADE     -- 回避术
        or skillId == SkillEnum.SKILL_BLUNTING  -- 防御崩坏
        then
        self:playParallelEffectDelay(skillId, targetAgent:getAgentId())
    elseif skillId == SkillEnum.SKILL_TYPHOON then
        self:playTyphoon(skillId,targetAgent:getAgentId(),skillLevel,extraCode)
    elseif skillId == SkillEnum.SKILL_CONTINUAL_LIGHT then
        local x, y = lt.MapUtil:calcMNMid(targetM, targetN)
        local reX, reY = x + BULLET_OFFSET_X, y + BULLET_OFFSET_Y
        local bullet = BullectScreenQueueEffect.new(skillId, 1, cc.p(reX, reY))
        self:addBullet(bullet)
    elseif skillId ==  SkillEnum.SKILL_BACK_STAB 
        and hitCode == Constant.ErrorCode.Success
        and extraCode == Constant.EXTRE_CODE.SUCCESS then
        if targetAgent then
            self:playBackStabEffect(skillId, fromAgentId, targetAgent:getAgentId(), skillLevel)
        end
    elseif skillId == SkillEnum.SKILL_DETECT_HIDDEN then
        local worldAgent = lt.AgentManager:getWorldAgent()
        local agent = worldAgent:getAgent(targetID)
        if agent then
            agent:playSoleEffect(skillId, SkillEnum.EFFECT_OWNER.OTHER)
        end
    elseif skillId == SkillEnum.SKILL_BLOOD_DRAIN 
    or skillId == SkillEnum.SKILL_ABSORB_SOUL
    then
        if hitCode ~= Constant.ErrorCode.Success then
            --吸血不成功终止动作
            if heroAgent then
                heroAgent:getActor():setStopBloodDrain()
            end
        elseif hitCode == Constant.ErrorCode.Success then
            
        end
    elseif skillId == SkillEnum.SKILL_SHADOW_DANCING then
        if hitCode == Constant.ErrorCode.Success then
            self:playShadowDancing(skillId, heroAgent:getAgentId(), targetAgent:getAgentId())
        end
    elseif skillId == SkillEnum.SKILL_AURA_STORM
        or skillId == SkillEnum.SKILL_VIGOR_DROP then
        self:playAuraStorm(skillId, skillLevel, targetM, targetN, 0)
    elseif skillId == SkillEnum.SKILL_METEOR_STORM
        or skillId == SkillEnum.SKILL_BIG_ROCKFALL then
        self:playMeteorStorm(skillId, skillLevel, targetM, targetN, 0)
    elseif skillId == SkillEnum.SKILL_THUNDER_BOLT -- 雷鸣剑
        or skillId == SkillEnum.SKILL_WIDE_LIGHTNING then -- 大闪电
        self:playThunderBolt(skillId, skillLevel, targetM, targetN, 0)
    elseif skillId == SkillEnum.SKILL_THUNDER_STORM then -- 雷鸣风暴
        self:playThunderStorm(skillId, skillLevel, targetM, targetN, 0)
    elseif skillId == SkillEnum.SKILL_PURIFY then
        self:playPurify(skillId, skillLevel, nil, targetM, targetN, 0)
    elseif skillId == SkillEnum.SKILL_TURN_UNDEAD then -- 不死转换
        self:playTurnUndead(skillId, skillLevel, targetAgent:getAgentId(),0)
    elseif hitCode == Constant.ErrorCode.Success and skillId == SkillEnum.SKILL_LIBERTY then
        self:playLiberty(skillId, skillLevel, heroAgent:getAgentId(), targetAgent:getAgentId(),0)
    elseif hitCode == Constant.ErrorCode.Success and skillId == SkillEnum.SKILL_ICE_LANCE then
        local agentId = nil
        if targetAgent then
            agentId = targetAgent:getAgentId()
        end
        self:playIceLance(skillId, skillLevel, heroAgent:getAgentId(), agentId,0)
    elseif skillId == SkillEnum.MAGIC_BITE_OF_DEATH then
        local heroAgent = lt.AgentManager:getHeroAgent()
        self:playBiteOfDeath(skillId, skillLevel, heroAgent:getAgentId(), hitCode)
    elseif skillId == SkillEnum.SKILL_FIRE_METEO then -- 焚火流星
