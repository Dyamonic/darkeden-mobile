function SkillManager:playStoneAuger(skillId, fromAgentId, targetAgentId, mTouch, nTouch, skillGrade)
    local heroAgent = AgentManager:getAgent(fromAgentId)
    if not heroAgent then
        return
    end
    heroAgent:playParallelEffect(skillId)

    local targetAgent = AgentManager:getAgent(targetAgentId)
    local sX, sY 
    if mTouch and nTouch or not targetAgent then
        sX, sY = mTouch, nTouch
    else
        sX, sY = targetAgent:getMNExactly()
    end
    local points = {
        {0, -1}, {0,0}, {-1, 0}, {1, 0}, {0, 1}
    }
    local function playPhase()
        for _, point in ipairs(points) do
            local sM = sX + point[1]
            local sN = sY + point[2]
            if skillGrade == 0 then
                skillGrade = 1 
            end
            local effectMetas = CacheManager:getSkillEffectBySkillIdAndEName(skillId, "result_skill_stone_auger_" .. skillGrade)
            local x, y = lt.MapUtil:calcMNMid(sM, sN)
            local reX, reY = x + BULLET_OFFSET_X, y + BULLET_OFFSET_Y
    
            local bullet = lt.BullectScreenEffect.new(skillId, 0, cc.p(reX, reY))
            bullet:addEffect(skillId, effectMetas[1])
            BulletManager:addBulletToMap(bullet)
        end
    end
    ScheduleUtil:performWithDelayGlobal(function()
        playPhase()
    end, 0.6)
    ScheduleUtil:performWithDelayGlobal(function()
        playPhase()
    end, 1.4)
end

