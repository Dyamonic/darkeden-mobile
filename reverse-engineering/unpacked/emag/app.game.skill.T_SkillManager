-- 起手特效
-- 获取起手动作延迟时间
function SkillManager:getActionDelayTime(skillId,agentId)
    local agent = AgentManager:getAgent(agentId)
    local param = 1
    if agent and agent.getCurStepMultiple then
        param = agent:getCurStepMultiple() or 1
    end
    local delayTime = CacheManager:getActionDelayTimeBySkillId(skillId) or 0 

    return delayTime*param
end

-- playEffect 延迟
function SkillManager:playEffectDelay(skillId, agentId)
    local delayTime = self:getActionDelayTime(skillId,agentId)
    if delayTime > 0 then
        ScheduleUtil:performWithDelayGlobal(function()
            local agent = AgentManager:getAgent(agentId)
            if agent then
                agent:playEffect(skillId)
            end
        end,delayTime)
    else
        local agent = AgentManager:getAgent(agentId)
        if agent then
            agent:playEffect(skillId)
        end
    end
end

-- 并行特效 延迟
function SkillManager:playParallelEffectDelay(skillId, agentId, owner, skillGrade)
    local curOwner = owner
    local curSkillGrade = skillGrade
    local delayTime = self:getActionDelayTime(skillId,agentId)
    if delayTime > 0 then
        ScheduleUtil:performWithDelayGlobal(function()
            local agent = AgentManager:getAgent(agentId)
            if agent then
                agent:playParallelEffect(skillId, curOwner, curSkillGrade)
            else
                yflog:Info("---->>>>playParallelEffectDelay agent is nil")
            end
        end,delayTime)
    else
        local agent = AgentManager:getAgent(agentId)
        if agent then
            agent:playParallelEffect(skillId, curOwner, curSkillGrade)
        else
            yflog:Info("---->>>>playParallelEffectDelay agent is nil")
        end
    end
end

