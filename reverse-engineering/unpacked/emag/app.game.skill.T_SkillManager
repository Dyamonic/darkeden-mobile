function SkillManager:playBurningSol(skillId, fromAgentId, targetAgentId, skillLevel, mTouch, nTouch)

    -- 起手


    local heroAgent = AgentManager:getAgent(fromAgentId)
    if not heroAgent then return end
    local dir = heroAgent:getDirection()
    local actorM, actorN = heroAgent:getMNExactly()
    local targetAgent = AgentManager:getAgent(targetAgentId)
    if targetAgent then
        actorM, actorN = targetAgent:getMNExactly()
    end
    local zorder = (actorN  * 10000 + actorM + 9999) * 10 * 2
    if dir == Constant.DIRECTION_LEFT_DOWN or dir == Constant.DIRECTION_DOWN or dir == Constant.DIRECTION_RIGHT_DOWN then
        self:playSoleEffectByLvDelay(fromAgentId,skillId,skillLevel,Constant.EFFECT.ACTION)
    else
        self:playSkillEffectDelay(skillId,fromAgentId,skillLevel, Constant.EFFECT.ACTION)
    end


    local function endCb()
        local actionInfoMetas = CacheManager:getHitMetas(skillId,skillLevel)
        if not actionInfoMetas or #actionInfoMetas < 1 then
            return
        end
        local x, y = lt.MapUtil:calcMNMid(mTouch,nTouch)
        local reX, reY = x + BULLET_OFFSET_X, y

        local bullet = lt.BullectScreenEffect.new(skillId, 0, cc.p(reX, reY))
        bullet:addEffect(skillId, actionInfoMetas[1])
        BulletManager:addBulletToMapZOrder(bullet, zorder)
    end
    lt.ScheduleUtil:performWithDelayGlobal(function()
        local mHero, nHero = heroAgent:getMNExactly()
        if math.abs(mHero - mTouch) <= 1 and math.abs(nHero - nTouch) <= 1 then
            endCb()
        else
