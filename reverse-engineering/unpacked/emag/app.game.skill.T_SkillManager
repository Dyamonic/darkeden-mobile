--多个下落技能效果
function SkillManager:playMultiFallEffect(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
    local heroAgent = AgentManager:getAgent(fromAgentId)
    local targetAgent = AgentManager:getAgent(targetAgentId)
    local mHero, nHero = heroAgent:getMNExactly()
    local direction = heroAgent:getDirection()
    local targetM, targetN = mHero, nHero
    if targetAgent and targetAgent:getMNExactly() then
        targetM, targetN = targetAgent:getMNExactly()
    end
    if mTouch then
        targetM, targetN = mTouch, nTouch
    end
    local targetX, targetY = lt.MapUtil:MapToPixel(targetM, targetN)


    local function spreadOutEffect(x, y, z, direction)
        local tM, tN = lt.MapUtil:PixelToMap(x, y)
        local tX, tY = lt.MapUtil:MapToPixel(tM, tN)

        local egInfo = {
            skillId = skillId,
            x0 = tX ,
            y0 = tY,
            z0 = z,
            step = 30,
            count = 8,
            direction = direction
        }
        lt.MSpreadOutEffectGenerator:generate(egInfo)
    end

    local function startEffect()
        local actionInfoMetas = CacheManager:getProcessMetas(skillId)
        local floorMeta = actionInfoMetas[3] --持续meta
        local delayTime = actionInfoMetas[4]:getDelayFrame() / 1000 --延迟meta
        ScheduleUtil:performWithDelayGlobal(function()
            if targetAgent then
                local x, y = targetAgent:getPosition()
                local actorM, actorN = targetAgent:getMNExactly()
                local reX, reY = x + BULLET_OFFSET_X, y + 10
                local bullet = lt.BullectScreenEffect.new(skillId, 0, cc.p(reX, reY))
                bullet:addEffect(skillId, floorMeta, true)
                local zorder = (actorN  * 10000 + actorM + 9999) * 10 * 1 
                BulletManager:addBulletToMapZOrder(bullet, zorder)
                bullet:setEndByDelay(floorMeta:getDelayFrame() / 1000)
            end
        end, delayTime)
    end

    local function callbackEffect(x, y)
        local reX, reY = x + BULLET_OFFSET_X, y + BULLET_OFFSET_Y
        local actionInfoMetas = CacheManager:getProcessMetas(skillId)
        local bullet = lt.BullectScreenEffect.new(skillId, 0, cc.p(reX, reY))
        bullet:addEffect(skillId, actionInfoMetas[2])
        BulletManager:addBulletToMap(bullet)
    end
    local z1 = 0
    if skillId == SkillEnum.SKILL_BLOODY_STORM then
        z1 = 80
    end

    local egInfo = {
        skillId = skillId,
        x0 = targetX,
        y0 = targetY,
        z0 = 70,
        z1 = z1,
        step = 30,
        count = 17,
        direction = heroAgent:getDirection(),
        callback = function(x, y, z, direction,skillId)
            if skillId == SkillEnum.SKILL_BLOODY_STORM then
                spreadOutEffect(x, y, z, direction)
            else
                callbackEffect(x, y)
            end
        end
    }
    if skillId == SkillEnum.SKILL_ICE_HAIL then
        startEffect() --地标特效
    end

    local delayTime = self:getActionDelayTime(skillId)
    if delayTime > 0 then
        ScheduleUtil:performWithDelayGlobal(function()
            lt.MMultipleFallingEffectGenerator:generate(egInfo)
        end, delayTime)
    else
        lt.MMultipleFallingEffectGenerator:generate(egInfo)
    end
 
end

