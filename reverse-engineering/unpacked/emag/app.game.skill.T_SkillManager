function SkillManager:playBullentWindDivider(skillId, fromAgentId, targetAgentId, skillLevel, mTouch, nTouch)
    if not mTouch or not nTouch then return end

    local heroAgent = AgentManager:getAgent(fromAgentId)
    if not heroAgent then return end

    local startX, startY = heroAgent:getPosition()
    local targetX, targetY = MapUtil:calcMNMid(mTouch, nTouch)

    local delta = cc.p(targetX - startX, startY - targetY)
    local angle = math.atan2(delta.y, delta.x)

    local width, height = lt.SkillModule:getSkillOperatorSize(skillId)
    local cos_angle = math.cos(angle)
    local sin_angle = math.sin(angle)

    local maxDistanceX = math.abs(width * 0.5 / (cos_angle + (cos_angle == 0 and 1e-10 or 0)))
    local maxDistanceY = math.abs(height * 0.5 / (sin_angle + (sin_angle == 0 and 1e-10 or 0)))
    
    local maxDistance = math.min(maxDistanceX, maxDistanceY)
    local delta = {
        x = maxDistance * cos_angle,
        y = maxDistance * sin_angle
    }
    
    local bWorldPosition = cc.pAdd(cc.p(startX, startY), cc.p(delta.x, - delta.y))

    local bullet = BulletWindDivider.new(skillId, skillLevel, heroAgent:getDirection(), cc.p(startX, startY), cc.p(bWorldPosition.x, bWorldPosition.y))
    self:addBullet(bullet)
end

