-- 地板特效
-- 获取地板动作延迟时间
function SkillManager:getActionFloorDelay(agentId)
    local agent = AgentManager:getAgent(agentId)
    if not agent then
        return 0
    end
    local race = agent:getRoleData():getRace()
    local actionId = agent:getActionId()
    local delayTime = 0
    if race and actionId then
        delayTime = (CacheManager:getActionFloorDelay(race,actionId) or 0)/1000
    end

    return delayTime
end

-- 播放地板特效
function SkillManager:playSoleEffectDelay(agentId, skillId, owner)
    local curOwner = owner or SkillEnum.EFFECT_OWNER.SELF
    local delayTime = self:getActionFloorDelay(agentId)
    ScheduleUtil:performWithDelayGlobal(function()
        local agent = AgentManager:getAgent(agentId)
        if agent then
            agent:playSoleEffect(skillId, curOwner)
        end
    end,delayTime)
end

-- 新配置播放地板特效
function SkillManager:playSoleEffectByLvDelay(agentId,skillId,skillLevel,effectName)
    local skillMeta = CacheManager:getSkillEffectByIdLv(skillId,skillLevel)
    if not skillMeta then
        yflog:Info("SKill Config not found --->>> skillId = %s   skillLevel = %s", skillId, skillLevel)
        return
    end

    local key = table.concat({"get" , effectName or "" , "Metas"})
    local metas = {}
    if type(skillMeta[key]) == "function" then
        metas = skillMeta[key](skillMeta)
    end

    local delayTime = self:getActionFloorDelay(agentId)
    if #metas > 0 then
        local approach = metas[1]:getApproach() 
        if Constant.EFFECT_PLAY_TYPE.PARALLEL == approach then -- 脚底特效只有并行
            ScheduleUtil:performWithDelayGlobal(function()
                local agent = AgentManager:getAgent(agentId)
                if agent then
                    agent:playSoleEffectByMetas(metas)
                end
            end,delayTime)
        end
    end
end

return SkillManager
