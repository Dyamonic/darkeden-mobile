function SkillManager:playTurretFire(skillId, skillLevel, fromAgentId, mTouch, nTouch, code)
    local function turretFire()
        local heroAgent = AgentManager:getAgent(fromAgentId)
        if not heroAgent then return end
        
        if code ~= Constant.ErrorCode.Success then
            return
        end

        -- 随机特效
        local numberTable = {1, 2, 3, 4, 5}
        local randomNum = {}
        for _ = 1,2 do
            local numberPos = math.random(1, #numberTable)
            table.insert(randomNum, numberTable[numberPos])
            table.remove(numberTable, numberPos)
        end

        -- 随机位置
        local posTable = {
                {-1,-1}, {0,-1}, {1,-1},
                {-1,0}, {1, 0}, {0, 0},
                {-1, 1}, {0,1}, {1, 1},
        }
        local randomPos = {}
        for _ = 1,2 do
            local posPos = math.random(1, #posTable)
            table.insert(randomPos, posTable[posPos])
            table.remove(posTable, posPos)
        end


        for index,v in ipairs(randomNum) do
            local actionInfoMetas = CacheManager:getBulletMetas(skillId,skillLevel)
            if not actionInfoMetas or #actionInfoMetas < 1 then
                return
            end
            local curPos = randomPos[index] or {0,0}
            local x, y = lt.MapUtil:calcMNMid(mTouch + curPos[1],nTouch + curPos[2])
            local reX, reY = x + BULLET_OFFSET_X, y

            local bullet = lt.BullectScreenEffect.new(skillId, 0, cc.p(reX, reY))
            bullet:addEffect(skillId, actionInfoMetas[v])
            BulletManager:addBulletToMap(bullet)
        end
    end
    
    local heroAgent = AgentManager:getAgent(fromAgentId)
    if not heroAgent then return end
    
    if heroAgent:getIsSelf() then
        turretFire()
    else
        local curShotCount = heroAgent:getCurShotCount()
        local mulFrame, repeatCount, repeatStart = SkillModule:getRepeatConfig(Constant.ACTION_ATTACK,skillId)
        local time = repeatCount*1/20
        if curShotCount and curShotCount <= 1 then
            time = mulFrame*1/20
        end
        ScheduleUtil:performWithDelayGlobal(function()
            turretFire()
        end, time)
    end
end

