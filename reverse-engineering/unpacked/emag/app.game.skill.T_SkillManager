function SkillManager:playMissile(skillId, skillLevel, fromAgentId, targetAgentId, code, extraCode)
    if code ~= Constant.ErrorCode.Success then
        return
    end

    local heroAgent = AgentManager:getAgent(fromAgentId)
    if not heroAgent then
        return
    end
    local direction = heroAgent:getDirection()
    -- self:playSkillEffectDelay(skillId,fromAgentId,skillLevel,Constant.EFFECT.ACTION)
    
    self:playCallbackDelay(skillId, function()
        local worldAgent = lt.AgentManager:getWorldAgent()
        if not worldAgent then
            return
        end

        local heroAgent = AgentManager:getAgent(fromAgentId)
        if not heroAgent then
            return
        end

        local modelId = 226
        local monsterIdx = 1079
        local clientName = "ROCKET_LAUNCHER"
        if skillId == SkillEnum.SKILL_PLASMA_ROCKET_LAUNCHER then
            modelId = 226
            monsterIdx = 1079
            clientName = "ROCKET_LAUNCHER"
        elseif skillId == SkillEnum.SKILL_XRL_MISSILE then
            modelId = 271
            monsterIdx = 1080
            clientName = "XRL_MISSILE"
        end

        local clientId = string.format(clientName .. "_%s_%s_%s" , fromAgentId , targetAgentId , heroAgent:getMissileIndex())

        local monsterData = lt.MonsterData.new(clientId, {
            { properCode = lt.ServerClientEnum.MonsterValueDef.Attr_MonsterIdx ,intValue = monsterIdx},
            { properCode = lt.ServerClientEnum.ObjectValueDef.Attr_Appr ,intValue = modelId },
            { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_Level,intValue = 1},
            { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_MoveSpeedRate,intValue=100},
        })

        local mHero, nHero = heroAgent:getMNExactly()
        local nextPos = lt.MapUtil:getNextTileByDirection(mHero, nHero, direction)
        local curAgent = worldAgent:createMonsterAgent(monsterData, nextPos.x, nextPos.y, direction, false)
        curAgent:playAction(Constant.ROLE_ACTION_MOVE)
        curAgent:playEffect(skillId,false)
        curAgent:setIsOutOfGame(true)
        local delayTime = self:getActionDelayTime(skillId,fromAgentId)
        curAgent:changeState(lt.MissileStateChase.new(curAgent, Constant.MOVE_RUN, targetAgentId, extraCode - delayTime,skillId))
    end)
