-- 人物播放相应的技能动作
function SkillManager:playStartAction(skillId, heroAgent)
    if skillId == SkillEnum.SKILL_BOMB_CRASH_WALK then 
        return 
    end
    if skillId == SkillEnum.SKILL_SET_AFIRE then 
        return 
    end
    local action = nil

    if heroAgent:isMonsterAgent() then
        action = CacheManager:getMonActionBySkillId(skillId)
        if skillId == Constant.SKILL_ID.NORAML_MELEE and heroAgent:isModelId239() then
            action = Constant.ROLE_ACTION_DANCE
        end
    else
        action = CacheManager:getStartActionBySkillId(skillId)
    end

    if action == nil then
        action = Constant.ROLE_ACTION_IDLE
        yflog:Info("not find playStartAction", skillId)
    end
    if skillId == SkillEnum.TRANSFORM_TO_BAT 
        or skillId == SkillEnum.TRANSFORM_TO_WOLF 
        or skillId == SkillEnum.TRANSFORM_TO_WERWOLF 
        then
        --变身不播起手动作
       return  
    end

    -- 暗影剑舞假身动作
    if skillId == SkillEnum.SKILL_SHADOW_DANCING and heroAgent:getRoleData():getFakeCreatureType() == Constant.FAKE_CREATURE_TYPE.FAST_MOVE_ACTION then
        action = Constant.ACTION_SLAYER_SWORD
    elseif skillId == SkillEnum.SKILL_BLITZ_SLIDING then
        return
    end

    -- 人族动作重置
    action = self:getSlayerAction(heroAgent, skillId, action)
    heroAgent:playAction(action, skillId)
    return nil
end


function SkillManager:getSlayerAction(heroAgent, skillId, actionC)
    local action = actionC
    if heroAgent:getAgentType() == Constant.AGENT_TYPE_HERO 
    and heroAgent:getRoleData():getRace() == Constant.RaceType.Slayer 
    and skillId ~= SkillEnum.SKILL_HEART_CATALYST
    and skillId ~= SkillEnum.SKILL_REVEALER
    and skillId ~= SkillEnum.SKILL_CONCEALMENT
    and skillId ~= SkillEnum.SKILL_INSTALL_TRAP
    and skillId ~= SkillEnum.SKILL_INSTALL_TURRET
    and skillId ~= SkillEnum.SKILL_TURRET_FIRE
    and skillId ~= SkillEnum.SKILL_SNIPING
    and skillId ~= SkillEnum.SKILL_OBSERVING_EYE
    then

        local skillMeta = CacheManager:querySkillMeta(skillId)
        local equipLimits = skillMeta:getWeaponMap()
        ---枪类：根据装备枪的种类播不同技能动作
        if table.keyof(equipLimits, 2) then
            local weaponType = heroAgent:getWeaponType()
            local name = Constant.SLAYER_ACTION_SPEED[weaponType][2]
            action = Constant[name]
        end

        --普通攻击要根据不同武器播不同动作
        if skillId == SkillEnum.NORAML_MELEE or skillId == SkillEnum.NORMAL_RANGE then
            local weaponType = heroAgent:getWeaponType()
            if weaponType then
                if weaponType == Constant.WeaponType.Cross or weaponType == Constant.WeaponType.Wand then --十字架权杖使用刀动作
                    action = Constant.ACTION_SLAYER_BLADE
                else
                    local name = Constant.SLAYER_ACTION_SPEED[weaponType][2]
                    action = Constant[name]
                end
            end
        end
    end
    return action
end


