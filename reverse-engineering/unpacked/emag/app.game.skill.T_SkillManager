function SkillManager:playSkillEffectDelay(skillId,targetAgentId,skillLevel,effectName)
    local skillMeta = CacheManager:getSkillEffectByIdLv(skillId,skillLevel)
    if not skillMeta then
        yflog:Info("SKill Config not found --->>> skillId = %s   skillLevel = %s", skillId, skillLevel)
        return
    end

    local key = table.concat({"get" , effectName or "" , "Metas"})
    local metas = {}
    if type(skillMeta[key]) == "function" then
        metas = skillMeta[key](skillMeta)
    end

    -- yflog:Info("playSkillEffectDelay skillId = %s   skillLevel = %s   effectName = %s ", skillId, skillLevel, effectName)

    if #metas > 0 then
        local approach = metas[1]:getApproach()
        if Constant.EFFECT_PLAY_TYPE.PARALLEL == approach then
            self:playParallelEffectByLvDelay(skillId,targetAgentId,skillLevel,effectName)
        elseif Constant.EFFECT_PLAY_TYPE.QUEUE == approach then
            self:playQueueEffectByLvDelay(skillId,targetAgentId,skillLevel,effectName)
        elseif Constant.EFFECT_PLAY_TYPE.SPECIAL == approach then
            if (skillId == SkillEnum.SKILL_QUICK_FIRE or skillId == SkillEnum.SKILL_TRIDENT or skillId == SkillEnum.SKILL_MOLE_SHOT or skillId == SkillEnum.SKILL_MULTI_SHOT)
                 and effectName == Constant.EFFECT.HIT then
                self:playParallelEffectByLv(skillId,targetAgentId,skillLevel,effectName)
            elseif skillId == SkillEnum.SKILL_HETER_CHAKRAM and effectName == Constant.EFFECT.PROCESS then -- 夏布利基因
                self:playParallelEffectByLv(skillId,targetAgentId,skillLevel,effectName)
            end
        elseif Constant.EFFECT_PLAY_TYPE.RANDOM == approach then
            -- 随机 串行
            self:playQueueEffectByLvDelay(skillId,targetAgentId,skillLevel,effectName)
        end
    end
end

