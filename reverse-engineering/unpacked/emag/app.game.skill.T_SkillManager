            local startX, startY = heroAgent:getPosition()
            targetY = targetY + 15
            startY = startY + Constant.MODEL_HIT_Y
            local bullet = BulletSingleEffect.new(skillId,skillLevel, heroAgent:getDirection(), cc.p(startX, startY), cc.p(targetX, targetY))
            bullet:setEndCallBack(endCb)
            BulletManager:addBulletToMapZOrder(bullet, zorder)
        end
    end, 0.65)
end

