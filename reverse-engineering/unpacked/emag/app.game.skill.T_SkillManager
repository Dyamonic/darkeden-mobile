function SkillManager:playSkillAFire(skillId, fromAgentId, skillLevel, code, isReleaseAfter, targetAgentId)
    local heroAgent = AgentManager:getAgent(fromAgentId)
    if not heroAgent then
        return
    end
    if tonumber(code) == Constant.ErrorCode.Success then
        heroAgent:delBuffer(BuffEnum.EFFECT_FIRE) 
        heroAgent:addBuffer(BuffEnum.EFFECT_FIRE) 
        ScheduleUtil:performWithDelayGlobal(function()
            local delayHeroAgent = AgentManager:getAgent(fromAgentId)
            if delayHeroAgent then
                delayHeroAgent:delBuffer(BuffEnum.EFFECT_FIRE)
            end
        end, 1.2)
    end
   

    self:playQueueEffectByLvDelay(skillId,fromAgentId,skillLevel,Constant.EFFECT.PROCESS)
    local targetAgent = AgentManager:getAgent(targetAgentId)
    if not targetAgent then
        return 
    end
    if not isReleaseAfter then
        local mHero, nHero = heroAgent:getMNExactly()
        local mTarget, nTarget = targetAgent:getMNExactly()
        if math.max(math.abs(mTarget - mHero), math.abs(nTarget - nHero)) <= 1 then
            heroAgent:playAction(Constant.ACTION_ATTACK)
            return true
        end
    end
end

