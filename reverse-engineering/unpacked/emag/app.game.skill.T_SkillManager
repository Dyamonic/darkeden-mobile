    if not processMetas or #processMetas < 1 then
        return
    end
    local zorder = {0, 0, 0, 2, 1}
    local function createShot(meta, phase)
        local x, y = lt.MapUtil:calcMNMid(mTouch,nTouch)
        local reX, reY = x + BULLET_OFFSET_X, y + BULLET_OFFSET_Y
        local bullet = lt.BullectScreenEffect.new(skillId, 0, cc.p(reX, reY))
        bullet:addEffect(skillId, meta)
        BulletManager:addBulletToMap(bullet, 100000 + zorder[phase])
    end

    for k, meta in ipairs(processMetas) do
        local delayTime = meta:getDelayFrame() / 1000
        ScheduleUtil:performWithDelayGlobal(function()
            createShot(meta, k)
        end, delayTime)
    end
end

