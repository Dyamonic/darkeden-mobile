function SkillManager:sendAttackCmd(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
    local heroAgent = AgentManager:getAgent(fromAgentId)
    if not heroAgent then
        return
    end

    local targetAgent = AgentManager:getAgent(targetAgentId)
    local skillMeta = CacheManager:querySkillMeta(skillId)
    -- yflog:Info("skillId:%s SkillManager:sendAttackCmd  %s --->>> %s",skillId,fromAgentId, targetAgentId)
    --祝福
    if skillId == SkillEnum.SKILL_BLESS then
        --如果没有目标
        if heroAgent:getIsSelf() and not targetAgent then 
            targetAgent = heroAgent
        end
    end
    
    if skillMeta:getTargetType() == Constant.SkillTargetType.SELF then
        GameModule:sendAttack(skillId, heroAgent:getDirection(), heroAgent:getObjId())
    else
        if mTouch and nTouch or not targetAgent then
            GameModule:sendAttack(skillId, heroAgent:getDirection(), nil, mTouch, nTouch)
        else
            local targetObjId = targetAgent:getObjId()
            if type(targetObjId) == "number" then
                GameModule:sendAttack(skillId, heroAgent:getDirection(), targetObjId)
            end
        end
    end
    if heroAgent:getIsSelf() then
        heroAgent:setAttackCd(skillId)
    end
end

function SkillManager:commonPlaySkill(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
    local heroAgent = AgentManager:getAgent(fromAgentId)

    self:playStartAction(skillId, heroAgent)

    local delayTime = self:getActionDelayTime(skillId)
    local soundName = CacheManager:getSoundNameBySkillId(skillId)

    if soundName then
        if delayTime > 0 then
            ScheduleUtil:performWithDelayGlobal(function()
                AudioManager:playBattleSound(soundName)
            end,delayTime)
        else
            AudioManager:playBattleSound(soundName)
        end
    end


    -- 藤蔓不能使用任何技能
    if heroAgent:hasBuffer(BuffEnum.EFFECT_CLASS_VINE) then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = SkillModule.SKILL_RELESE_TIPS.LIMIT_VINE_BUFF})
        return  
    end

    if skillId == SkillEnum.MAGIC_EAT_CORPSE then
        local targetAgent = lt.AgentManager:getAgent(targetAgentId)
        if targetAgent and targetAgent:isMonsterAgent() and not targetAgent:isDig() then
            lt.MonsterModule:sendDigCorpse(targetAgent)
            return
        end
    end

    if heroAgent:getAgentType() == Constant.AGENT_TYPE_HERO and heroAgent:getIsSelf() then
        local time = 0
        -- FIXME HIT Delay
        -- if skillId == SkillEnum.STONE_AUGER then
        --     time = 0.6
        -- end
        --别人也能看到动作，不进行限制
        local targetAgent = lt.AgentManager:getAgent(targetAgentId)
        local buffer = CacheManager:getBuffBySkillId(skillId)
        if buffer and buffer:isIntercept() then
            if targetAgent then
                local bufferId = buffer:getBuffId()
                if targetAgent:hasBuffer(bufferId) and not buffer:allowRepeat()  then
                    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KET_SKILL_TIPS72})
                    return 
                end
            end
        end

        --攻击模式拦截(种族模式拦截)
        if targetAgent and targetAgent:isHeroAgent() then
            local attackMode = heroAgent:getAttackMode()
            local skillMeta = CacheManager:queryMetaBySkillId(skillId)
            local isSingleTarget = skillMeta:getTargetType() == Constant.SkillTargetType.ONE --单体攻击

            local function isFriendSkill()
                local selectTargetType = skillMeta:getSelectTarget()
                local isFriendAgent = heroAgent:isFriendAgent(targetAgent)
                local isFriendSkill = selectTargetType > 1 and selectTargetType ~= Constant.TARGET_TYPE_SELECT.ENEMY_FRIEND 
                return isFriendSkill and isFriendSkill
            end

            if isSingleTarget and heroAgent:getRaceType() == targetAgent:getRaceType() and attackMode == Constant.ATTACK_MODE.RACE and not isFriendSkill() then
                lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_SKILL_LIMIT_RACE_TIPS})
                return 
            end
        end

        -----------------------------------------------------------------------------------------------
        -- 连击技能延迟发送攻击包
        if SkillEnum.REPEATED_SKILL_ID_TABLE[skillId] then
            local action = lt.SkillManager:getSlayerAction(heroAgent, skillId)
            -- 炮塔火力特殊处理
            if skillId == SkillEnum.SKILL_TURRET_FIRE then
                action = CacheManager:getStartActionBySkillId(skillId)
            end
            if action then
                local mulFrame, _, _ = SkillModule:getRepeatConfig(action,skillId)
                local delayCount = mulFrame or 0
                time = delayCount * 1/20
            end
        end

        -----------------------------------------------------------------------------------------------
        if time == 0 then
            self:sendAttackCmd(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
        elseif time > 0 then
            ScheduleUtil:performWithDelayGlobal(function()
                self:sendAttackCmd(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
            end, time)
        end
    end
end

