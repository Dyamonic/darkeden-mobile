local SkillManager = {}

local AgentManager  = lt.AgentManager
local SkillModule   = lt.SkillModule
local Constant      = lt.Constant
local SkillEnum     = lt.SkillEnum
local CacheManager  = lt.CacheManager
local AudioManager  = lt.AudioManager
local GameModule    = lt.GameModule
local ScheduleUtil  = lt.ScheduleUtil
local MapUtil       = lt.MapUtil
local EffectEnum    = lt.EffectEnum
local BuffEnum      = lt.BuffEnum
local NtfManager    = lt.NtfManager

-- bullet
local BulletManager      = lt.BulletManager
local BulletLinearEffect = lt.BulletLinearEffect
local BulletMoveEffect   = lt.BulletMoveEffect
local BulletSnowEffect   = lt.BulletSnowEffect
local BulletNormalEffect = lt.BulletNormalEffect
local BullectScreenQueueEffect  = lt.BullectScreenQueueEffect
local BulletWindDivider  = lt.BulletWindDivider
local BulletSingleEffect = lt.BulletSingleEffect
local BulletNoDirEffect  = lt.BulletNoDirEffect
local EFFECT_OWNER = SkillEnum.EFFECT_OWNER

local BULLET_OFFSET_X = -25
local BULLET_OFFSET_Y = 15
local BOMBING_START_Z = 400

function SkillManager:playSkill(param)
    local skillId = param.skillId
    local fromAgentId = param.fromAgentId
    local targetAgentId = param.targetAgentId
    local mTouch = param.mTouch
    local nTouch = param.nTouch
    local skillLevel = param.skilllevel
    local code = param.code
    local extraCode = param.extraCode
    self._extraCode = tonumber(extraCode)
    self._hitCode = tonumber(code)

    local heroAgent = AgentManager:getAgent(fromAgentId)
    if not heroAgent then
        return
    end

    if heroAgent:isHeroAgent() and heroAgent:getIsSelf() then
        skillLevel = SkillModule:getSkillLevel(skillId)
    end

    if not skillLevel then
        skillLevel = 1
    end

    local skillGrade = SkillModule:getGradeBySkillLevel(skillLevel,skillId)


    -- 普攻(怪物的普通攻击 == 0)(怪物技能TODO)
    --- 公共(人物动作与发送协议)

    self:commonPlaySkill(skillId, fromAgentId, targetAgentId, mTouch, nTouch)

    -- 熟练度处理 需在发协议之后
    local newSkillId = SkillEnum.NORMAL_2_MASTERY[skillId]
    if newSkillId and extraCode == newSkillId then
        skillId = newSkillId
    end

    -----------------------------------------------------------------------------------------
    -- 怪物技能
    if skillId == SkillEnum.SKILL_AR_ATTACK
    or skillId == SkillEnum.SKILL_SMG_ATTACK then
        self:playSkillEffectDelay(skillId,fromAgentId,skillLevel,Constant.EFFECT.ACTION)
        return
    elseif skillId == SkillEnum.SKILL_LAND_MINE_EXPLOSION then	-- 地雷爆炸
        local heroAgent = AgentManager:getAgent(fromAgentId)
        local mHero, nHero = heroAgent:getMNExactly()
        local targetAgent = AgentManager:getAgent(targetAgentId)
        local mTarget, nTarget
        if mTouch and nTouch or not targetAgent then
            mTarget, nTarget = mTouch, nTouch
        else
            mTarget, nTarget = targetAgent:getMNExactly()   
        end

        local targetX, targetY = lt.MapUtil:MapToPixel(mTarget, nTarget)

        local function generateResultEffect()
            local egInfo = {
                skillId = skillId,
                x0 = targetX,
                y0 = targetY,
            }
            lt.MStopZoneRectEffectGenerator:generate(egInfo)
        end
        generateResultEffect()
        return
    elseif skillId == SkillEnum.SKILL_CLAYMORE_EXPLOSION then	-- 破片雷爆炸
        self:playSkillEffectDelay(skillId,fromAgentId,skillLevel,Constant.EFFECT.PROCESS)
        return
    elseif skillId == SkillEnum.SKILL_PLEASURE_EXPLOSION then	-- 愉悦引爆
        self:playSkillEffectDelay(skillId,fromAgentId,skillLevel,Constant.EFFECT.PROCESS)
        return
    elseif skillId == SkillEnum.SKILL_CRITICAL_GROUND then  -- 大地爆击
        self:playSkillEffectDelay(skillId,fromAgentId,skillLevel,Constant.EFFECT.PROCESS)
        return
    elseif skillId == SkillEnum.SKILL_BLOODY_WARP then -- 血腥扭曲
        local monsterAgent = AgentManager:getAgent(fromAgentId)
        monsterAgent:changeState(lt.MonsterStateFastMove.new(monsterAgent, mTouch - 5, nTouch, skillId))
        return
    end
    -----------------------------------------------------------------------------------------

    local checkIsNew = false
    ------------------------------------- 毒性 -------------------------------------
    if skillId == SkillEnum.SKILL_POISONOUS_HANDS then
        -- 剧毒之触
        self:playSkillPoisonousHands(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.SKILL_GREEN_POISON 
        or skillId == SkillEnum.SKILL_YELLOW_POISON
        or skillId == SkillEnum.MAGIC_BLOODY_WALL 
        or skillId == SkillEnum.HAND_OF_DARKNESS --黑暗之触
        then
        -- 陷阱 荧绿之毒,艳黄之毒
        self:playTrapSkill(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
    elseif skillId == SkillEnum.SKILL_GREEN_STALKER  then
        -- 毒雾
        if skillId == SkillEnum.SKILL_GREEN_STALKER  then
           self:playSkillEffectDelay(skillId,fromAgentId,skillLevel,Constant.EFFECT.ACTION)
        end
        self:palySkillGreenStalker(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.SKILL_DARKBLUE_POISON then
        -- 幽暗之毒
        self:playSkillDarkbluePoison(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.SKILL_POISON_STRIKE --毒性攻击
        or skillId == SkillEnum.SKILL_ACID_STRIKE   --酸性攻击
        or skillId == SkillEnum.SKILL_BLOODY_STRIKE --血腥攻击
        then
        if skillId == SkillEnum.SKILL_POISON_STRIKE then
            self:playSkillEffectDelay(skillId,fromAgentId,skillLevel,Constant.EFFECT.ACTION)
        end
        self:playSkillPoisonStrike(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.SKILL_BLOODY_STORM 
    or skillId == SkillEnum.SKILL_ICE_HAIL 
    or skillId == SkillEnum.SKILL_WIDE_ICE_HAIL
    or skillId == SkillEnum.SKILL_POISON_STORM 
    or skillId == SkillEnum.SKILL_ACID_STORM
    then
        if skillId == SkillEnum.SKILL_POISON_STORM  then
           self:playSkillEffectDelay(skillId,fromAgentId,skillLevel,Constant.EFFECT.ACTION)
        end
        self:playMultiFallEffect(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
    ------------------------------------- 酸性 -------------------------------------
    elseif skillId == SkillEnum.MAGIC_ACID_BOLT or skillId == SkillEnum.MAGIC_ACID_BALL then
        -- 酸矢 酸球
        self:playSkillAcidBolt(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.MAGIC_ACID_SWAMP then
        -- 酸性沼泽
        self:playTrapSkill(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
    ------------------------------------- 诅咒系 -------------------------------------
    elseif (skillId == SkillEnum.SKILL_MAGIC_PARALYZE or 
        skillId == SkillEnum.SKILL_MAGIC_DOOM or
        skillId == SkillEnum.SKILL_MAGIC_SEDUCTION or
        skillId == SkillEnum.SKILL_MAGIC_DEATH or 
        skillId == SkillEnum.SKILL_MEPHISTO or 
        skillId == SkillEnum.SKILL_EXTREME or --黑暗复仇者
        skillId == SkillEnum.RING_OF_FLARE or 
        skillId == SkillEnum.SKILL_WATER_BARRIER or  --水之壁障
        skillId == SkillEnum.SKILL_VINE or --藤蔓 
        skillId == SkillEnum.SKILL_GHOST_BLADE or -- 幽灵之刃
        skillId == SkillEnum.EFFECT_CLASS_GHOST_BLADE -- 飞舞之剑
        ) then
        -- 麻痹 、毁灭、诱惑、致死术、死亡契约（BUFF）
        self:playMagicParalyze(skillId, fromAgentId, targetAgentId)
    ------------------------------------- 召唤系 -------------------------------------
    elseif skillId == SkillEnum.SKILL_NOOSE_OF_WRAITH then
        -- 缚魂术
        self:playNooseOfWraith(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
    ------------------------------------- 血系 -------------------------------------
    elseif skillId == SkillEnum.MAGIC_BLOODY_KNIFE then
        --血刃
        self:playSkillAcidBolt(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.MAGIC_BLOODY_SPEAR then
        --血矛 
        self:playSkillBooldSpear(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.SKILL_BLOODY_WAVE 
    or skillId == SkillEnum.MAGIC_BLOODY_MASTER_WAVE
    then
        self:playBloodyWave(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.MAGIC_BLOODY_BREAKER then
        self:playBloodyBreak(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
     ------------------------------------- 默认 -------------------------------------
    elseif skillId == SkillEnum.MAGIC_RAPID_GLIDING then
        --快速滑行
    elseif skillId == SkillEnum.SKILL_MAGIC_METEOR then
        --陨石术
    elseif skillId == SkillEnum.SKILL_HANDS_OF_WISDOM then
        --智慧之触
        self:playSkillAcidHands(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.SKILL_TALON_OF_CROW then
        --吸血神鸦
        self:playTalonOfCrow(skillId, fromAgentId, targetAgentId)
    -- elseif skillId == SkillEnum.SKILL_INNATE_DEADLY_CLAW --至伤裂爪 
    --     then 
    --     self:playSkillViolentPhantom(skillId, fromAgentId, targetAgentId, skillLevel)
    ------------------------------------- 魔族 -------------------------------------
    elseif skillId == SkillEnum.SKILL_CASTING_FIRE        --地狱火海
        or skillId == SkillEnum.SKILL_ICE_FIELD           --冰之领域
        then
        self:playCastingFire(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
    elseif skillId == SkillEnum.STONE_AUGER then --石钻冲击
        self:playStoneAuger(skillId, fromAgentId, targetAgentId, mTouch, nTouch, skillGrade)
    elseif skillId == SkillEnum.SKILL_CURE_SERIOUS_WOUNDS then --伤害治疗术(人族)
        self:playSeriousWounds(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
    elseif skillId == SkillEnum.SKILL_EVADE then
        --回避术
        self:playSkillEvade(skillId, fromAgentId, targetAgentId, code)
    elseif skillId == SkillEnum.SKILL_BLUNTING then
        -- 防御崩坏
        self:playSkillBlunting(skillId, fromAgentId, targetAgentId, code)
    elseif skillId == SkillEnum.SKILL_EMISSION_WATER then
        -- 液体喷发
        self:playSkillEmissionWater(skillId, fromAgentId, targetAgentId, skillGrade)
    elseif skillId == SkillEnum.SKILL_BEAT_HEAD then
        -- 致命打击
        self:playSkillBeatHead(skillId, fromAgentId, targetAgentId, skillGrade)
    elseif skillId == SkillEnum.SKILL_GNOMES_WHISPER then
        -- 真实视野
        self:playSkillGnomesWhisper(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.SKILL_SUMMON_SYLPH then
        -- 召唤-精灵
        self:playSummonSylph(skillId, fromAgentId, targetAgentId)
    ------------------------------------- 人族 -------------------------------------
    elseif skillId == SkillEnum.SKILL_CAUSE_LIGHT_WOUNDS  -- 光击术
        or skillId == SkillEnum.SKILL_CURE_LIGHT_WOUNDS   -- 治疗术
        then
        self:playSkillCauseLightWounds(skillId, fromAgentId, targetAgentId, code)
    elseif skillId == SkillEnum.SKILL_CURE_POISON             -- 解毒
        or skillId == SkillEnum.SKILL_REMOVE_CURSE            -- 解除诅咒
        or skillId == SkillEnum.SKILL_DETECT_HIDDEN           -- 探测术
        then
        self:playSkillProtectionFromPoison(skillId, fromAgentId, targetAgentId, code)
    elseif skillId == SkillEnum.SKILL_ABSORB_SOUL --灵魂吸收
        then
        self:playSkillAbsorbSoul(skillId, fromAgentId, skillGrade)
    elseif skillId == SkillEnum.SKILL_CONTINUAL_LIGHT then -- 高级照明
        self:playContinualLight(skillId, fromAgentId, targetAgentId, mTouch, nTouch, code)
    elseif skillId == SkillEnum.SKILL_SLAYER_FLARE  then--（人族）光耀之环
        self:playSlayerFlare(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
    elseif skillId ==  SkillEnum.SKILL_BACK_STAB 
        and self._hitCode == Constant.ErrorCode.Success
        and tonumber(extraCode) == Constant.EXTRE_CODE.SUCCESS then
        local targetAgent = AgentManager:getAgent(targetAgentId)
        if targetAgent then
            self:playBackStabEffect(skillId, fromAgentId, targetAgentId, skillLevel)
        end
    elseif skillId == SkillEnum.SKILL_EARTHQUAKE 
    then
        ScheduleUtil:performWithDelayGlobal(function()
            self:playRippleZoneEffect(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
        end, 0.64)
    elseif skillId == SkillEnum.SKILL_POWER_OF_LAND then
        self:playPowerOfLand(skillId, fromAgentId, targetAgentId, mTouch, nTouch)
    elseif skillId == SkillEnum.SKILL_TRANSFUSION then
        self:playTransfusion(skillId, fromAgentId, targetAgentId, mTouch, nTouch)

    elseif skillId == SkillEnum.SKILL_SHADOW_DANCING and self._hitCode == Constant.ErrorCode.Success then
        self:playShadowDancing(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.SKILL_LIBERTY then
        self:playLiberty(skillId, skillLevel,fromAgentId, targetAgentId, code, mTouch, nTouch)
    elseif skillId == SkillEnum.SKILL_ICE_LANCE
        or skillId == SkillEnum.SKILL_ICE_LANCE_M then
        self:playIceLance(skillId, skillLevel,fromAgentId, targetAgentId, code, mTouch, nTouch)
    -- elseif skillId == SkillEnum.SKILL_SLAYER_SWORD_SKY_FIRE then
    --     self:playSlayerSwordSkyFire(skillId, skillLevel,fromAgentId, targetAgentId, code, mTouch, nTouch)
    elseif skillId == SkillEnum.SKILL_WILD_TYPHOON then
        self:playWildTyphoon(skillId, skillLevel,fromAgentId, targetAgentId, {currentPhase = 3})
    elseif skillId == SkillEnum.SKILL_TYPHOON then
        self:playTyphoon(skillId,targetAgentId,skillLevel,extraCode)
    elseif skillId == SkillEnum.SKILL_WHITSUNTIDE then
        self:playSunTide(skillId, skillLevel,fromAgentId, targetAgentId, code, mTouch, nTouch)
    elseif skillId == SkillEnum.SKILL_SWEEP_VICE_3 then
        self:playSweepVice(skillId, skillLevel,fromAgentId, targetAgentId, code, mTouch, nTouch)
    elseif skillId == SkillEnum.SKILL_SHARP_HAIL then
        self:playSharpHail(skillId,fromAgentId, targetAgentId, mTouch, nTouch)
    elseif skillId == SkillEnum.SKILL_SATELLITE_BOMB then
        if code == Constant.ErrorCode.Success then
            self:playSatelliteBomb(skillId,fromAgentId, targetAgentId, mTouch, nTouch)
        end
    elseif skillId == SkillEnum.SKILL_ROTTEN_APPLE then
        self:playRottenApple(skillId, targetAgentId, code)
    elseif skillId == SkillEnum.SKILL_HALO then
        self:playHole(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.SKILL_GORE_GLAND_FIRE then
        self:playGoreGloandFire(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.SKILL_FIERCE_FLAME then
        self:playFierceFlame(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.SKILL_PASSING_HEAL then
        self:playSoleEffectByLvDelay(fromAgentId,skillId,skillLevel,Constant.EFFECT.ACTION)
    elseif skillId == SkillEnum.SKILL_OUSTERS_COMBAT_PENETRATE_WHEEL then
        self:playSkillEffectDelay(skillId,fromAgentId,skillLevel,Constant.EFFECT.PROCESS)
    elseif skillId == SkillEnum.SKILL_WILD_WOLF and code == Constant.ErrorCode.Success then
        self:playWildWolf(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.SKILL_SELF_DESTRUCTION then
        self:playSkillEffectDelay(skillId,fromAgentId,skillLevel,Constant.EFFECT.PROCESS)
    elseif skillId == SkillEnum.SKILL_CANNONADE or skillId == SkillEnum.SKILL_GRENADE_ATTACK then
        self:playCannade(skillId, fromAgentId, targetAgentId)
    elseif skillId == SkillEnum.SKILL_SUMMON_MIGA_ATTACK then
        self:playQueueEffectByLvDelay(skillId, fromAgentId, skillLevel, Constant.EFFECT.HIT)
    elseif skillId == SkillEnum.SKILL_PLAYING_WITH_FIRE then
        self:playWithFire(skillId,fromAgentId, targetAgentId, mTouch, nTouch)
    elseif skillId == SkillEnum.SKILL_THROWING_AXE 
    or skillId == SkillEnum.SKILL_MULTI_THROWING_AXE 
    or skillId == SkillEnum.SKILL_CHAIN_THROWING_AXE
    then
        self:playThrowingAxe(skillId,fromAgentId, targetAgentId, mTouch, nTouch)

    elseif self:checkSkillNew(skillId) then
        checkIsNew = true
    end

    ---------------------------------------------------------------------------------------------------------------------
    -- SkillSpecialEffects 新表 start
    if not checkIsNew then
        return
    end

    -- 判断是否是子弹
    local skillEffectMeta = CacheManager:getSkillEffectByIdLv(skillId,skillLevel)
    if skillId == SkillEnum.SKILL_TRIPLE_BREAK --三倍爆击
        or skillId == SkillEnum.SKILL_DOUBLE_IMPACT --双重打击 
        or skillId == SkillEnum.SKILL_TRIPLE_SLASHER --三倍打击
        or skillId == SkillEnum.SKILL_SINGLE_BLOW   -- 精准打击
        or skillId == SkillEnum.SKILL_SPIRAL_SLAY   -- 罗旋一击
        or skillId == SkillEnum.SKILL_WILD_SMASH    -- 野蛮爆击
        or skillId == SkillEnum.SKILL_THUNDER_SPARK -- 雷光闪电
        then
        --- 三倍暴击
        self:playSlayerMelee(skillId, fromAgentId, targetAgentId, skillLevel)
    elseif skillId == SkillEnum.SKILL_SWORD_WAVE then -- 波浪之剑
        self:playSwordWave(skillId, skillLevel, fromAgentId, targetAgentId, code)
    elseif skillId == SkillEnum.SKILL_ILLENDUE then-- 修罗-破
        self:playIllendue(skillId, skillLevel, fromAgentId, targetAgentId, code)
    elseif skillId == SkillEnum.SKILL_ILLUSION_INVERSION then -- 恐怖幻觉
        self:playIllusionInversion(skillId, skillLevel, fromAgentId, targetAgentId, code)
    elseif skillId == SkillEnum.SKILL_TORNADO_SEVER then -- 断空斩
        self:playTornadoSever(skillId, skillEffectMeta, fromAgentId, mTouch, nTouch)
    elseif skillId == SkillEnum.SKILL_SHINE_SWORD then -- 闪耀之箭
        self:playShineSword(skillId, fromAgentId, targetAgentId, skillLevel)
    elseif skillId == SkillEnum.SKILL_HETER_CHAKRAM then
        self:playSkillEffectDelay(skillId,targetAgentId,skillLevel,Constant.EFFECT.PROCESS)
    elseif skillId == SkillEnum.SKILL_VENOM_CIRCLE then
        self:playVenomCircle(skillId, skillLevel, mTouch, nTouch, code)
    elseif skillId == SkillEnum.SKILL_SHADOW_OF_STORM then
        self:playShadowOfStorm(skillId, skillLevel, fromAgentId, mTouch, nTouch, code)
    elseif skillId == SkillEnum.SKILL_CURE_CRITICAL_WOUNDS
        or skillId == SkillEnum.SKILL_PROTECTION_FROM_ACID
        or skillId == SkillEnum.SKILL_DENIAL_MAGIC
        or skillId == SkillEnum.SKILL_REQUITAL
        or skillId == SkillEnum.SKILL_AURA_SHIELD
        or skillId == SkillEnum.SKILL_AURA_RING
        or skillId == SkillEnum.SKILL_STRIKING
        or skillId == SkillEnum.SKILL_CAUSE_CRITICAL_WOUNDS
        or skillId == SkillEnum.SKILL_SPIRIT_GUARD
        or skillId == SkillEnum.SKILL_GREAT_HEAL 
        or skillId == SkillEnum.MAGIC_CURE_ALL 
        or skillId == SkillEnum.MAGIC_DETECT_INVISIBILITY 
        or skillId == SkillEnum.SKILL_LIGHT --照明术
        or skillId == SkillEnum.SKILL_LIGHTNESS
        or skillId == SkillEnum.SKILL_BLESS
        or skillId == SkillEnum.SKILL_PROTECTION_FROM_CURSE
        or skillId == SkillEnum.SKILL_PROTECTION_FROM_POISON
        or skillId == SkillEnum.SKILL_RESURRECT 
        or skillId == SkillEnum.SKILL_ACTIVATION
        or skillId == SkillEnum.SKILL_PEACE 
        then
        self:playSoleEffectByLvDelay(fromAgentId,skillId,skillLevel,Constant.EFFECT.ACTION)
    elseif skillId == SkillEnum.SKILL_PURIFY then
        self:playPurify(skillId, skillLevel, fromAgentId, mTouch, nTouch, code)
    elseif skillId == SkillEnum.SKILL_AURA_STORM
        or skillId == SkillEnum.SKILL_VIGOR_DROP then
        self:playSoleEffectByLvDelay(fromAgentId,skillId,skillLevel,Constant.EFFECT.ACTION)
        self:playAuraStorm(skillId, skillLevel, mTouch, nTouch, code)
    elseif skillId == SkillEnum.SKILL_METEOR_STORM
        or skillId == SkillEnum.SKILL_BIG_ROCKFALL then
        self:playSoleEffectByLvDelay(fromAgentId,skillId,skillLevel,Constant.EFFECT.ACTION)
        self:playMeteorStorm(skillId, skillLevel, mTouch, nTouch, code)
    elseif skillId == SkillEnum.SKILL_FIRE_METEO then -- 焚火流星
        self:playFireMeteo(skillId, skillLevel, fromAgentId, mTouch, nTouch, code)
    elseif skillId == SkillEnum.SKILL_CAUSE_LIGHT_WOUNDS_H 
        or skillId == SkillEnum.SKILL_BOMBING_STAR 
        or skillId == SkillEnum.SKILL_GENESIS
        or skillId == SkillEnum.MAGIC_VISIBLE
        then
        -- 子弹起手地板
        self:playBulletSkillSole(skillId, skillLevel,fromAgentId, targetAgentId, code, mTouch, nTouch)
    elseif skillId == SkillEnum.SKILL_THUNDER_BOLT -- 雷鸣剑
        or skillId == SkillEnum.SKILL_WIDE_LIGHTNING then -- 大闪电
        self:playThunderBolt(skillId, skillLevel, mTouch, nTouch, code)
    elseif skillId == SkillEnum.SKILL_BOMB_CRASH then -- 雷鸣风暴
        self:playThunderStorm(skillId, skillLevel, mTouch, nTouch, code)
    elseif skillId == SkillEnum.SKILL_TURN_UNDEAD then -- 不死转换
        self:playTurnUndead(skillId, skillLevel, fromAgentId,code)
    elseif skillId == SkillEnum.SKILL_FIRE_PIERCING then 
        self:playFirePiercing(skillId, skillLevel,fromAgentId, targetAgentId, code, mTouch, nTouch)
    elseif skillId == SkillEnum.SKILL_SHIFT_BREAK    -- 回旋斩
        or skillId == SkillEnum.SKILL_FATAL_SNICK    -- 致残之蛇
        or skillId == SkillEnum.SKILL_FATAL_SNICK_M  -- 致残之蛇熟练度
        or skillId == SkillEnum.MAGIC_BLOODY_NAIL    -- 血爪
        or skillId == SkillEnum.SKILL_ACID_HANDS     -- 酸性之触
        or skillId == SkillEnum.SKILL_FLOURISH       -- 活跃攻击
        or skillId == SkillEnum.SKILL_EXPLOSION_WATER-- 制约喷泉
        then
        self:playShiftBreak(skillId, skillLevel, fromAgentId)
    elseif  skillId == SkillEnum.SKILL_DISTANCE_BLITZ  then -- 雷神斩
        self:playDistanceBlitz(skillId, skillLevel,fromAgentId, targetAgentId, code, mTouch, nTouch)
    elseif skillId == SkillEnum.SKILL_DESTRUCTION_SPEAR
        or skillId == SkillEnum.SKILL_DESTRUCTION_SPEAR_M then
        self:playDestructionSpear(skillId, skillLevel,fromAgentId)
    elseif skillId == SkillEnum.MAGIC_BITE_OF_DEATH then
        self:playBiteOfDeath(skillId, skillLevel, fromAgentId, code)
    elseif skillId == SkillEnum.SKILL_BLAZE_BOLT	-- 烈焰之矢
        or skillId == SkillEnum.SKILL_EARTHS_TEETH	-- 大地之牙
        or skillId == SkillEnum.SKILL_KASAS_ARROW   -- 卡萨之箭
        then
        self:playBlazeBolt(skillId, fromAgentId, targetAgentId, skillGrade)
    elseif skillId == SkillEnum.SKILL_HOLY_ARROW -- 神圣箭矢
        or skillId == SkillEnum.SKILL_LIGHT_BALL -- 光球
        or skillId == SkillEnum.SKILL_AURA_BALL  -- 圣光弹
        or skillId == SkillEnum.SKILL_HIT_CONVERT-- 攻击转换
        then
        self:playHolyArrow(skillId, fromAgentId, targetAgentId, 1, skillLevel)
       
    elseif SkillEnum.REPEATED_SKILL_ID_TABLE[skillId] then
        if skillId == SkillEnum.SKILL_SET_AFIRE then
            local isNearly = self:playSkillAFire(skillId, fromAgentId, skillLevel, self._hitCode, false, targetAgentId)
            if self._hitCode ~= Constant.ErrorCode.Success then
                if not isNearly then
                    return
                end
            end
        end
        self:playSlayerGunNew(skillId, skillLevel, fromAgentId, targetAgentId, mTouch, nTouch)
        if skillId == SkillEnum.SKILL_PLASMA_ROCKET_LAUNCHER or skillId == SkillEnum.SKILL_XRL_MISSILE then
            self:playMissile(skillId, skillLevel, fromAgentId, targetAgentId, code, extraCode)
        elseif skillId == SkillEnum.SKILL_TURRET_FIRE then
            self:playTurretFire(skillId, skillLevel, fromAgentId, mTouch, nTouch, code)
        elseif skillId == SkillEnum.SKILL_INFINITY_THUNDERBOLT then
            self:playInfinityThunderbolt(skillId,fromAgentId, targetAgentId, mTouch, nTouch, code)
        elseif skillId == SkillEnum.SKILL_SLAYER_SWORD_SKY_FIRE then
            self:playSlayerSwordSkyFire(skillId, skillLevel,fromAgentId, targetAgentId, code, mTouch, nTouch)
        elseif skillId == SkillEnum.SKILL_SPIT_STREAM or skillId == SkillEnum.SKILL_SLAYER_BLADE_CUT_STORM then
            local heroAgent = lt.AgentManager:getHeroAgent()
            if fromAgentId ~= heroAgent:getAgentId() then
                lt.SkillManager:playSpitStream(skillId,fromAgentId, targetAgentId)
            end
        elseif skillId == SkillEnum.SKILL_MOONLIGHT_SEVER -- 断月斩
            or skillId == SkillEnum.SKILL_LIGHTNING_HAND then  -- 电光铁手
            -- 目标身上的Effect
            local heroAgent = lt.AgentManager:getHeroAgent()
            if fromAgentId ~= heroAgent:getAgentId() then
                local targetAgent = AgentManager:getAgent(targetAgentId)
                if targetAgent then
                    targetAgent:playParallelEffectByLv(skillId, 1, Constant.EFFECT.PROCESS)
                end
            end
        end
    elseif skillId == SkillEnum.SKILL_CLIENT_BURNING_SOL then
        self:playBurningSol(skillId, fromAgentId, targetAgentId, skillLevel, mTouch, nTouch)
    elseif skillEffectMeta:isBullet() then
        -- 子弹起手非地板
        self:playBulletSkill(skillId, skillLevel,fromAgentId, targetAgentId, code, mTouch, nTouch)
    else
        if skillId == SkillEnum.SKILL_SWORD_OF_THOR then 
            return 
        end
        self:playCommonSkill(skillId, skillLevel,fromAgentId, targetAgentId, code)
    end
    -- SkillSpecialEffects 新表 end
    ---------------------------------------------------------------------------------------------------------------------
end

