-- 修罗-破  创建假体
function SkillManager:playIllendue(skillId, skillLevel, fromAgentId, targetAgentId, code)
    if code ~= Constant.ErrorCode.Success then
        return
    end

    local heroAgent = AgentManager:getAgent(fromAgentId)
    if not heroAgent then return  end
    local mHero, nHero = heroAgent:getMNExactly()
    local direction = heroAgent:getDirection()

    local worldAgent = AgentManager:getWorldAgent()
    if not worldAgent  then return end
    local targetAgent = AgentManager:getAgent(targetAgentId or 0)
    if not targetAgent then return end
    local targetX, targetY = targetAgent:getMNExactly()

    local straight =  { { -2, -2 }, { -2,  2 }, { 2,  -2 }, { 2,   2 }, }
    local diagonal = { { 0,  2 }, { 2,  0 }, { -2, 0 }, { 0, -2 }, }
    local position = (math.fmod(direction, 2) == 1) and diagonal or straight
    for i =1,#position do
        local heroData = clone(heroAgent:getHeroData())
        local direction = MapUtil:getDirectionToPosition(mHero, nHero, targetX, targetY)
        local cloneObjId = Constant.CLONETAG.ILLENDUE .. i
        heroData:setObjId(cloneObjId)
        heroData:setDirection(direction)
        heroData:setCrossCounter(true)
        worldAgent:createHeroAgent(heroData, mHero, nHero, direction, false, false)
        local cloneAgent = worldAgent:getAgent(cloneObjId)
        cloneAgent:setIsOutOfGame(true)
        cloneAgent:getActor():setLocalZOrder(cloneAgent:getActor():getLocalZOrder()-1)
        cloneAgent:changeState(lt.HeroStateSplitMove.new(cloneAgent, targetX+position[i][1], targetY+position[i][2], skillId, false, targetX, targetY, targetAgentId))
    end
end

