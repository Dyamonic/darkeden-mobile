function SkillManager:playAuraStorm(skillId, skillLevel, mTouch, nTouch, code)
    if not self:checkPlayEffect(code) then
        return
    end

    local targetX, targetY = MapUtil:calcMNMid(mTouch, nTouch)
    local numEffectPhase, numEffect = 4, 4
    local baseZ, phaseUpper= 350, 150
    local randX, randY = Constant.MAP_BLOCK_WIDTH, 50 

    local ex, ey, ez = {}, {}, {}
    for i = 1, numEffectPhase, 1 do
        -- 偏移纵坐标
        ex[1] = targetX-math.random()*randX - Constant.MAP_BLOCK_WIDTH/2
        ey[1] = targetY-math.random()*randY
        ez[1] = baseZ + math.random()*50

        ex[2] = targetX-math.random()*randX - Constant.MAP_BLOCK_WIDTH/2
        ey[2] = targetY+math.random()*randY
        ez[2] = baseZ + math.random()*50

        ex[3] = targetX+math.random()*randX + Constant.MAP_BLOCK_WIDTH/2
        ey[3] = targetY-math.random()*randY
        ez[3] = baseZ + math.random()*50

        ex[4] = targetX+math.random()*randX + Constant.MAP_BLOCK_WIDTH/2
        ey[4] = targetY+math.random()*randY
        ez[4] = baseZ + math.random()*50

        baseZ = baseZ + phaseUpper
        for j = 1, numEffect, 1 do
            local startX, startY = ex[j], ey[j]+ez[j]
            local endX, endY = ex[j], ey[j]

            local bullet = BulletSingleEffect.new(skillId,skillLevel, Constant.DIRECTION_DOWN, cc.p(startX, startY), cc.p(endX, endY))
            bullet:setEndCallBack(function()
                local actionInfoMetas = CacheManager:getBulletMetas(skillId,skillLevel)
                if not actionInfoMetas or #actionInfoMetas < 1 then
                    return
                end
                local bullet = lt.BullectScreenEffect.new(skillId, 0, cc.p(endX-25, endY+15))
                bullet:addEffect(skillId, actionInfoMetas[2])
                BulletManager:addBulletToMap(bullet)
            end)
            self:addBullet(bullet)
        end
    end
end

