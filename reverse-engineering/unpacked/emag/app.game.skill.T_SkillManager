        return
    end
    local mFromAgent, nFromAgent = fromAgent:getMNExactly()
    local x0, y0 = MapUtil:MapToPixel(mFromAgent, nFromAgent)
    local direction = fromAgent:getDirection()
    local isFirePiecing = math.random() > 0.5
    local allPreviousEffectInfo
    local currentPhase = 1
    local function generateEffect(currentPhase, pEffect)
        local egInfo = {
            skillId = skillId,
            x0 = x0, 
            y0 = y0,
            direction = direction,
            effectSpriteType = 859,
            isFirePiecing = isFirePiecing,
            callback = function(pEffect)
                if pEffect then
                    currentPhase = currentPhase + 1
                    if currentPhase >= 48 then
                        return 
                    end
                    generateEffect(currentPhase, pEffect)
                end
            end
        }
        if currentPhase > 1 then
            egInfo.pPreviousEffect = pEffect
        end

        ScheduleUtil:performWithDelayGlobal(function()
            lt.MPlayingWithFireEffectGenerator:generate(egInfo)
        end, 0.01)
    end
    generateEffect(currentPhase)
    if isFirePiecing then
        x0 = x0 + math.random(0, 2) * 10
        generateEffect(currentPhase)
    end
end


