---命中效果
function SkillManager:skillDamageEffect(proto)
    local skillId = proto.skillID
    if skillId <= 0 then
        return
    end

    if SkillEnum.NONE_EFFECT_HIT[skillId] then
        return 
    end
    local objId = proto.objID
    local skillLevel = proto.skillLevel
    local skillGrade = SkillModule:getGradeBySkillLevel(skillLevel,skillId)
    local worldAgent = lt.AgentManager:getWorldAgent()
    local agent = worldAgent:getAgent(objId)
    local fromObjId = proto.attackerID

    -----------------------------------------------------------------------------------------
    -- 不能对自己释放限制,为了过滤反伤类吸血类受击效果
    local skillMeta = CacheManager:queryMetaBySkillId(skillId)
    if skillMeta and not skillMeta:isToSelf() and fromObjId == objId then return end
    -----------------------------------------------------------------------------------------


    if skillId == SkillEnum.RING_OF_FLARE then
        agent:playEffect(skillId)
        return
    end

    -- 赤雨流焰
    local newSkillId = SkillEnum.NORMAL_2_MASTERY[skillId]
    if newSkillId and lt.SkillModule:hasSkill(newSkillId) then
        skillId = newSkillId
    end

    local hitMetas = CacheManager:getHitMetas(skillId, skillLevel)

    local owner = EFFECT_OWNER.OTHER

    -- 队列特效
    for _, skillCfg in pairs(EffectEnum.DAMAGE_EFFECT_TYPES.QUEUE) do
        if skillCfg.skillId == skillId then
            self:playQueueEffectDelay(skillId, agent:getAgentId(), owner, skillGrade)
            return 
        end
    end

    -- 并行特效
    for _, skillCfg in pairs(EffectEnum.DAMAGE_EFFECT_TYPES.PARALLEL) do
        if skillCfg.skillId == skillId then
            self:playParallelEffectDelay(skillId, agent:getAgentId(), owner, skillGrade)
            return 
        end
    end

    -- 35之后技能
    -- 受击特效播放
    if skillId == SkillEnum.SKILL_THUNDER_BOLT       -- 雷鸣剑
        or skillId == SkillEnum.SKILL_THUNDER_STORM  -- 雷鸣风暴
        or skillId == SkillEnum.SKILL_WIDE_LIGHTNING -- 大闪电
        or skillId == SkillEnum.SKILL_GREAT_HEAL     -- 强力治愈术
        then
        self:playParallelEffectByLv(skillId,agent:getAgentId(),skillLevel,Constant.EFFECT.HIT)
    elseif skillId == SkillEnum.SKILL_MOLE_SHOT
        or skillId == SkillEnum.SKILL_MULTI_SHOT
        or skillId == SkillEnum.SKILL_BULLET_OF_LIGHT
        or skillId == SkillEnum.SKILL_GUN_SHOT_GUIDANCE
        then
        self:playParallelEffectByLv(skillId, agent:getAgentId(),skillLevel, Constant.EFFECT.HIT, fromObjId)
    elseif skillId == SkillEnum.SKILL_MAGNUM_SPEAR_M then -- 赤雨流焰熟练度
        self:playMagnumSpear(skillId,agent:getAgentId(),skillLevel)
    elseif skillId == SkillEnum.SKILL_MAGNUM_SPEAR then -- 赤雨流焰
        -- 伤害不处理释放成功处理
        return
    elseif skillId == SkillEnum.SKILL_WILD_TYPHOON then
        agent:getActor():setTurning()
    elseif skillId == SkillEnum.SKILL_SATELLITE_BOMB then
        local tempMeta = clone(hitMetas[1])
        local spriteId = tempMeta:getSpriteId()
        tempMeta._spriteId = math.random(spriteId, spriteId + 6)
        agent:getActor():playParallelEffectSpecial(skillId, {tempMeta})
    elseif skillId == SkillEnum.SKILL_ROTTEN_APPLE then
        agent:playParallelEffectSpecial(skillId, {hitMetas[2], hitMetas[3], hitMetas[4], hitMetas[5]})
    elseif skillId == SkillEnum.SKILL_DESTINIES then
        self:playParallelEffectByLv(skillId, agent:getAgentId(),skillLevel, Constant.EFFECT.SELF, fromObjId)
    elseif skillId == SkillEnum.SKILL_MAGIC_METEOR then
        self:playParallelEffectByLv(skillId, agent:getAgentId(),skillLevel, Constant.EFFECT.HIT, fromObjId)
    elseif skillId == SkillEnum.SKILL_FROZEN_GLACIER then
        self:playQueueEffectByLvDelay(skillId, agent:getAgentId(), skillLevel, Constant.EFFECT.HIT)
    elseif skillId == SkillEnum.SKILL_BLOODY_STRIKE then
        self:playParallelEffectByLv(skillId, agent:getAgentId(),skillLevel, Constant.EFFECT.HIT, fromObjId)
    elseif skillId == SkillEnum.SKILL_TALON_OF_CROW then
        hitMetas[1]:setEffectId(hitMetas[1]:getOriginalSpriteId() + math.random(3) )
        agent:getActor():playParallelEffectSpecial(skillId, hitMetas)
    elseif skillId == SkillEnum.SKILL_MOLE_SHOT 
    or skillId == SkillEnum.SKILL_BULLET_OF_LIGHT
    or skillId == SkillEnum.SKILL_MULTI_SHOT
    or skillId == SkillEnum.SKILL_DOUBLE_SHOT
    or skillId == SkillEnum.SKILL_TRIPLE_SHOT 
    or skillId == SkillEnum.NORMAL_RANGE 
    then
        self:playParallelEffectByLv(skillId, agent:getAgentId(),skillLevel, Constant.EFFECT.HIT, fromObjId)
    elseif skillId == SkillEnum.SKILL_VIOLENT_PHANTOM then
        local hitMetas = CacheManager:getHitMetas(skillId)
        local actor = agent:getActor()
        if actor then
            actor:playParallelEffectSpecial(skillId, {hitMetas[1],hitMetas[2], hitMetas[3]})
            actor:playSoleParalSpecail(skillId, {hitMetas[4]})
        end
    elseif skillId == SkillEnum.SKILL_SHADOW_DANCING then
        local hitMetas = CacheManager:getHitMetas(skillId)
        local randomMetas = {}
        local firstMeta = hitMetas[math.random(1, #hitMetas)]
        firstMeta:setDelayFrame(hitMetas[1]:getOriginalDelayFrame())
        table.insert(randomMetas,firstMeta)
        for _ = 1, 3 do
            local secondMeta = hitMetas[math.random(1, #hitMetas)]
            secondMeta:setDelayFrame(hitMetas[2]:getOriginalDelayFrame())
            table.insert(randomMetas,secondMeta)
        end
        agent:playParallelEffectSpecial(skillId, randomMetas)
    elseif skillId == SkillEnum.SKILL_JABBING_VEIN then --放血术
        local hitMetas = CacheManager:getHitMetas(skillId)
        agent:playRotateEffect(hitMetas,skillId)
    elseif skillId == SkillEnum.SKILL_PIERCING then	-- 烈焰指（人）
        local hitMetas = CacheManager:getHitMetas(skillId)
        agent:playRotateEffect(hitMetas,skillId)
    elseif skillId == SkillEnum.SKILL_INNATE_DEADLY_CLAW then
        local hitMetas = CacheManager:getHitMetas(skillId)
        agent:playRotateEffectQueue(hitMetas,skillId)
    elseif skillId == SkillEnum.SKILL_TRANSFUSION then
        --血液互补受击动作是救人复活用的，这里不播
    elseif skillId == SkillEnum.SKILL_TANK_ATTACK then -- 坦克攻击
        self:playTankAttack(skillId,fromObjId,objId)
    elseif skillId == SkillEnum.SKILL_BLOODSUCKING_ATTACK then -- 吸血攻击
        self:playBloodSuckingAttack(skillId,fromObjId,objId)
    elseif skillId == SkillEnum.SKILL_BLUESUCKING_ATTACK then -- 吸蓝攻击
        self:playBlueSuckingAttack(skillId,fromObjId,objId)
    elseif self:checkSkillNew(skillId) then
        self:playSkillEffectDelay(skillId,agent:getAgentId(),skillLevel,Constant.EFFECT.HIT)
    end
end

