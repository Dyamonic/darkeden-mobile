---@class GuideLayer 通知层
local GuideLayer = class("GuideLayer", lt.UICompBase)
local NtfManager = lt.NtfManager
local GuideModule = lt.GuideModule
local CacheManager = lt.CacheManager

GuideLayer.WEAK_GUIDE = 1
GuideLayer.STRONG_GUIDE = 2

function GuideLayer:ctor()
    GuideLayer.super.ctor(self)
    self:initUI()
end

function GuideLayer:initUI()
    self._view = fgui.UIPackage:createObject("Guide", "GuideLayer")
    self._view:makeFullScreen()
    self._view:center()
    self._view:setVisible(false)
    self:addChild(self._view)
    --引导层
    self._mask = self._view:getChild("mask")
    self._target = self._view:getChild("target")
    --左右手指
    self._leftGuide = self._view:getChild("guide_left")
    self._leftLabel = self._view:getChild("label_guideleft")
    self._rightGuide = self._view:getChild("guide_right")
    self._rightLabel = self._view:getChild("label_guideright")
    self._controller = self._view:getController("c1")
end

function GuideLayer:onClear()
    self:removeFromParent()
    self._view = nil
    --引导层
    self._mask = nil
    self._target = nil
    --左右手指
    self._leftGuide = nil
    self._leftLabel = nil
    self._rightGuide = nil
    self._rightLabel = nil
    self._controller = nil
    self._touchLayer = nil
    GuideLayer.super.onClear(self)

end

function GuideLayer:onEnter()
    GuideLayer.super.onEnter(self)
    NtfManager:addNtfListener(NtfManager.NTF.NTF_GUIDE_START, handler(self, self.startGuide), "GuideLayer:startGuide")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_GUIDE_END, handler(self, self.endGuide), "GuideLayer:endGuide")

    -- 监听计时器
    NtfManager:addNtfListener(NtfManager.NTF.NTF_GAME_TIME_UPDATE, handler(self, self.timeUpdate), "CompTask:timeUpdate")

    --点击关闭可穿透
    self:addTouch()
end

function GuideLayer:onExit()
    GuideLayer.super.onExit(self)
    
    NtfManager:removeNtfListenerByTag("GuideLayer:startGuide")
    NtfManager:removeNtfListenerByTag("GuideLayer:endGuide")
    NtfManager:removeNtfListenerByTag("GuideLayer:timeUpdate")
    if self._touchLayerEvt then
        cc.Director:getInstance():getEventDispatcher():removeEventListener(self._touchLayerEvt)
        self._touchLayerEvt = nil
    end
end

function GuideLayer:timeUpdate()
    self:refreshTimer()
end

function GuideLayer:startGuide(event)
    local param = event.param
    local guideId = param.guideId
    local guideMeta = CacheManager:getGuideMeta(guideId)
    self._guideMeta = guideMeta
    if guideMeta:getGuideType() == GuideLayer.WEAK_GUIDE then
        --弱引导不显示遮罩,点哪都算结束
        self._mask:setAlpha(0)
    elseif guideMeta:getGuideType() == GuideLayer.STRONG_GUIDE then
        --强引导显示遮罩，只能点高亮
        self._mask:setAlpha(0.7)
    end
    --显示时间大于0的添加引导结束倒计时
    self._time = guideMeta:getShowTime()

    --设置文字
    self._leftLabel:setText("")
    self._rightLabel:setText("")
    self._leftLabel:setText(guideMeta:getGuideWord())
    self._rightLabel:setText(guideMeta:getGuideWord())
    --判断左箭头还是右箭头
    local pos = param.pos
    local size = param.size
    local isLeft = pos.x + size.width/2 > display.width/2
    self._leftGuide:setVisible(isLeft and guideMeta:getGuideWord() ~= "")
    self._rightGuide:setVisible(not isLeft and guideMeta:getGuideWord() ~= "")
    --设置位置
    self._target:setPosition(pos.x + size.width/2, pos.y + size.height/2)
    self._target:setSize(size.width, size.height)
    self._view:setVisible(true)
    --判断用什么大小的框
    self._controller:setSelectedIndex((size.width >= 300 and size.height >= 300) and 1 or 0)
    --多个框
    local poslist = param.poslist
    if poslist and #poslist > 0 then
        for i = 1, #poslist do
            if i > 6 then break end
            local y = display.height - poslist[i].y
            self._view:getChild("target"..i):setPosition(poslist[i].x + size.width/2, y - size.height/2)
            self._view:getChild("target"..i):setSize(size.width * 0.8, size.height * 0.8)
            self._view:getChild("target"..i):setVisible(true)
            self._view:getChild("targettr"..i):setVisible(true)
            self._view:getChild("targetdr"..i):setVisible(true)
            self._view:getChild("targettl"..i):setVisible(true)
            self._view:getChild("targetdl"..i):setVisible(true)
        end
        self._target:setSize(size.width * 0.8, size.height * 0.8)
    end
end

function GuideLayer:endGuide(event)
    self._view:setVisible(false)
    for i = 1, 6 do
        self._view:getChild("target"..i):setVisible(false)
        self._view:getChild("targettr"..i):setVisible(false)
        self._view:getChild("targetdr"..i):setVisible(false)
        self._view:getChild("targettl"..i):setVisible(false)
        self._view:getChild("targetdl"..i):setVisible(false)
    end
    self._guideMeta = nil
    lt.ScheduleUtil:performWithDelayGlobal(function()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_CHECK_GUIDE_EVENT)
    end, 0.1)
end

function GuideLayer:refreshTimer()
    if self._guideMeta == nil then return end
    if self._time and self._time > 0 then
        self._time = self._time - 1
        if self._time <= 0 then
            GuideModule:endGuide(self._guideMeta:getGuideId())
        end
    end
end

function GuideLayer:addTouch()
    if not self._touchLayer then
        local size = self:getSize()
        self._touchLayer = display.newLayer(cc.c4b(0, 0, 0, 255), size)
        self._touchLayer:setOpacity(0)
        self._touchLayer:setAnchorPoint(cc.p(0.5, 0.5))
        self:displayObject():addChild(self._touchLayer)
        self._touchLayer:setTouchMode(cc.EVENT_TOUCH_ONE_BY_ONE)
    end

    if not self._touchLayerEvt then
        self._touchLayerEvt = cc.EventListenerTouchOneByOne:create()
        self._touchLayerEvt:setSwallowTouches(false)
        self._touchLayerEvt:registerScriptHandler(function(touch, event)
            return true
        end, cc.Handler.EVENT_TOUCH_BEGAN)
        self._touchLayerEvt:registerScriptHandler(function(touch, event)
            self:onLayerClick(touch, event)
        end, cc.Handler.EVENT_TOUCH_ENDED)
        cc.Director:getInstance():getEventDispatcher():addEventListenerWithSceneGraphPriority(self._touchLayerEvt,
            self._touchLayer)
    end
end

function GuideLayer:onLayerClick(touch, event)
    if self._guideMeta == nil then return end
    local guideType = self._guideMeta:getGuideType()
    if guideType == GuideLayer.WEAK_GUIDE then
        GuideModule:endGuide(self._guideMeta:getGuideId())
        -- return
    end
    local curPosition = touch:getLocation()
    local pos = self:displayObject():convertToNodeSpace(curPosition)
    local fguiY = self:getSize().height - pos.y
    local node = self._target
    local size = node:getSize()
    local nodeXY = node:getPosition()
    local rect = {width = size.width, height = size.height, x = nodeXY.x - size.width/2, y = nodeXY.y - size.height/2}
    if cc.rectContainsPoint(rect, cc.p(pos.x, fguiY)) then
        if guideType == GuideLayer.STRONG_GUIDE then
            GuideModule:endGuide(self._guideMeta:getGuideId())
        end
        GuideModule:runCallback()
    end
end

return GuideLayer