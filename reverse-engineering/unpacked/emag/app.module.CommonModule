end

--[[ 
比较两个属性table,是否有新增属性或属性值变化
@parma prop 当前属性
@parma targetProp 下一级属性
@return meta[属性名] = 0新增/1提升/-1降低
]]
function CommonModule:ComparePropertys(prop, targetProp)
    local meta = {}
    local isAdd = true
    local TextArray = CommonModule:propertys2TextTable(prop,{ mergeText="  " })
    local NextArray = CommonModule:propertys2TextTable(targetProp,{ mergeText="  " })
    for k,v in pairs(NextArray) do
        isAdd = true
		for j,d in pairs(TextArray) do
			if d.szTitle == v.szTitle then
                isAdd = false
                local temp = string.split(d.szValue,"-") --解析属性判断是增加还是减少
                if #temp > 1 then
                    local temp2 = string.split(v.szValue,"-")
                    if tonumber(temp2[2] or 0) > tonumber(temp[2] or 0) then
                        meta[v.szTitle] = 1
                    elseif tonumber(temp2[2] or 0) < tonumber(temp[2] or 0) then
                        meta[v.szTitle] = -1
                    end
                else
                    local temp1 = v.szValue
                    local temp2 = d.szValue
                    if #string.split(v.szValue,"%") >1 then
                        temp1 = string.split(v.szValue,"%")[1]
                        temp2 = string.split(d.szValue,"%")[1]
                    end
                    local secstr = lt.StringManager:getString(lt.StringManager.KEY_TIME_SECOND)
                    if #string.split(v.szValue,secstr) >1 then
                        temp1 = string.split(v.szValue,secstr)[1]
                        temp2 = string.split(d.szValue,secstr)[1]
                    end
                    if tonumber(temp1 or 0) > tonumber(temp2 or 0) then
                        meta[v.szTitle] = 1
                    elseif tonumber(temp1 or 0) < tonumber(temp2 or 0) then
                        meta[v.szTitle] = -1
                    end
                end
				break
			end
		end
        if isAdd then
            meta[v.szTitle] = 0
        end
    end
    return meta
end

function CommonModule:testButtonTime(btnId)
    local b = true

    -- print("=============> ", btnId)
    local uiConfig = lt.CacheManager:getUIConfig(btnId)
    local tType = uiConfig:getShowTimeType()
    local tValue = uiConfig:getShowTime()

    if tType == CommonModule.BTN_TIME_TYPE.ONLINE_TIME then
    elseif tType == CommonModule.BTN_TIME_TYPE.QUANTUM then
        b = false
        for _, v in ipairs(lt.TimeCounter:splitTimeQuantum(tValue)) do
            b = b or lt.TimeCounter:timeInRange(v.st, v.et)
        end

        -- print("=================> 检测时间段  配置时间段", tValue)
    end

    return b
end

function CommonModule:rechargeIsClose()
    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_ALERT_TIP, {content = StringManager:getString(StringManager.KEY_CLOSE_RECHARGE),btns = {Constant.COMMON_TIP_BTN.BTN_CONFIM}})

    return true
end

