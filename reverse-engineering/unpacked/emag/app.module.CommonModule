        end
    end

    if itemMeta:getMcMin() then
        local v = {}
        v.title = StringManager:getString(StringManager.KEY_ITEM_TIP_MACATK)
        v.value = item:getMagicAtk()
        if v.value ~= "0-0" then
            prop[index] = v;
            index = index + 1;
        end
    end

    if itemMeta:getScMin() then
        local v = {}
        v.title = StringManager:getString(StringManager.KEY_ITEM_TIP_TAO)
        v.value = item:getTaoAtk()
        if v.value ~= "0-0" then
            prop[index] = v;
            index = index + 1;
        end
    end

    if itemMeta:getLucky() and itemMeta:getLucky() > 0 then
        local v = {}
        v.title = StringManager:getString(StringManager.KEY_ITEM_TIP_LUCKY)
        v.value = " + " .. itemMeta:getLucky()
        prop[index] = v;
        index = index + 1;
    end

    if itemMeta["getCurse"] and itemMeta:getCurse() > 0 then
        local v = {}
        v.title = StringManager:getString(StringManager.KEY_ITEM_TIP_CURSE)
        v.value =  " + " .. itemMeta:getCurse()
        prop[index] = v;
        index = index + 1;
    end

    if itemMeta["getBless"] and itemMeta:getBless() > 0 then
        local v = {}
        v.title = StringManager:getString(StringManager.KEY_ITEM_TIP_BLESS)
        v.value =  " + " .. itemMeta:getBless()
        prop[index] = v;
        index = index + 1;
    end
    return prop
end

function CommonModule:getLegendProp(items)
    local prop = {}
    local baseProp = items:getItemMeta():getProp()
    for k,v in pairs(self.LegendArray) do
        if (items:getValue(k) or 0) > 0 then
            if baseProp[v] then
                if items:getValue(k) - baseProp[v] > 0 then
                    prop[v] = items:getValue(k) - baseProp[v]
                end
            else
                prop[v] = items:getValue(k)
            end
        end
    end
    return prop
end

function CommonModule:getServerPrase()
    return self._serverPrase
end

