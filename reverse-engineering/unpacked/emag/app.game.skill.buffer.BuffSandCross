local BuffSandCross = class("BuffSandCross", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local CacheManager = lt.CacheManager

--[[
    沙之祈祷
]]
function BuffSandCross:ctor(time, actor, skilllevel)    
    BuffSandCross.super.ctor(self, BuffEnum.EFFECT_SAND_CROSS, time, actor, skilllevel)

    local skillId = SkillEnum.SKILL_SAND_CROSS
    local actionInfoMetas = CacheManager:getBuffMetas(skillId,skillLevel)
    if not actionInfoMetas or #actionInfoMetas < 1 then
        return
    end
    
    local agent = self._actor:getAgent()
    if not agent then
        return
    end

    local halfSize = 3
    local mTouch, nTouch = agent:getMNExactly()
    for i = -halfSize, halfSize do
        for j = -halfSize, halfSize do
            local isHorizontal = (i == 0) and (j ~= 0)
            local isVertical = (j == 0) and (i ~= 0)
            local isCenter = (i == 0) and (j == 0)
            
            if isHorizontal or isVertical or isCenter then
                local x, y = lt.MapUtil:calcMNMid(mTouch + i,nTouch + j)
                local offsetX, offsetY = -25, 15
                local reX, reY = x + offsetX, y + offsetY
        
                local bullet = lt.BullectScreenEffect.new(skillId, 0, cc.p(reX, reY))
                bullet:addEffect(skillId, actionInfoMetas[1])
                lt.BulletManager:addBulletToMap(bullet)

                local bullet = lt.BullectScreenEffect.new(skillId, 0, cc.p(reX, reY))
                bullet:addEffect(skillId, actionInfoMetas[2])
                lt.BulletManager:addBulletToMap(bullet)
                local zOrder = 0
                bullet:setLocalZOrder(zOrder)
            end
        end
    end
end

function BuffSandCross:onClear()
    BuffSandCross.super.onClear(self)
end

return BuffSandCross
