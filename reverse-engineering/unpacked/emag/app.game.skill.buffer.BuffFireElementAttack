local BuffFireElementAttack = class("BuffFireElementAttack", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local ScheduleUtil  = lt.ScheduleUtil

--[[
    火元素攻击
]]
function BuffFireElementAttack:ctor(time, actor, skilllevel)    
    BuffFireElementAttack.super.ctor(self, BuffEnum.EFFECTSTATUS_FIRE_ELEMENTAL, time, actor)
    local ownerId = self._actor:getAgent():getObjId()
    local objId = string.format("FIRE_ELEMENT_%s", ownerId)

    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent  then
        return 
    end
    local elementAgent = worldAgent:getAgent(objId)
    if elementAgent then
        elementAgent:playAttackAction()
    end
end

function BuffFireElementAttack:onClear()
    BuffFireElementAttack.super.onClear(self)
end


return BuffFireElementAttack
