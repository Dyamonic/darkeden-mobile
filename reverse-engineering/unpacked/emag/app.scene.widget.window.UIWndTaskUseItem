--- npc提交任务界面
---@class UIWndTaskUseItem:UIWindowBase
local UIWndTaskUseItem = class("UIWndTaskUseItem", lt.UIWindowBase)
local NtfManager = lt.NtfManager
local CacheManager = lt.CacheManager
local Constant = lt.Constant
local GameModule = lt.GameModule
local ItemModule = lt.ItemModule
local NpcModule = lt.NpcModule

UIWndTaskUseItem.ChangeSkinConf = {
    ["MessageBox"] = {
        ["bg"] = "bg_tytanchuang_02",
    },
    ["CommonTL"] = {
        ["btn_confirm"] = {bg  = "btn_common_anniu_01"},
        ["closeButton"] = {bg  = "bg_beibao_anniu01", bgup = "bg_beibao_anniu02"},
    }
}

function UIWndTaskUseItem:ctor(param)
    UIWndTaskUseItem.super.ctor(self, param)
    self._npcDesc = nil
    self._costItem = nil
    self._targetMeta = nil
    self._costMeta = nil
end

function UIWndTaskUseItem:onClear()
    self:unregisterAllComponent()
    self._npcDesc = nil
    self._costItem = nil
    self._targetMeta = nil
    self._costMeta = nil
    UIWndTaskUseItem.super.onClear(self)
end

function UIWndTaskUseItem:onInit()
    self:registerComponent("UICompItem")
    UIWndTaskUseItem.super.onInit(self, _GURL.WndTaskUseItem)
    self._npcDesc = self:getChild("intro")
    self._costItem = fgui.UIPackage:createObject("Item", "Item")
    self._costItem:insertObjectToFactory(self)
    self._costItem:setScale(1.2, 1.2)
    self:addChild(self._costItem)
    self._costItem:setPosition(535, 268)
    self._costItem:setItemNums("")
end

function UIWndTaskUseItem:onShown()
    self._costItem:addClickListener(function()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = self._costMeta, tipsType = Constant.PROPTIPS_FORM.Display})
    end)

    local confirmBtn = self:getChild("btn_confirm")
    confirmBtn:addClickListener(handler(self, self.onConfirmBtnClick))

    local closeBtn = self:getChild("closeButton")
    closeBtn:addClickListener(handler(self, self.onCloseBtnClick))

    local param = self:getParam() or {}
    local npcId = param.npcId
    local race = GameModule:getHeroData():getRace()
    local missionMeta = CacheManager:getMissionMeta(Constant["ADVANCE_TASK"..race].HOSTAGE)
    local target = missionMeta:getMissionTarget()[1][2]
    local meta = CacheManager:getAltarOfBloodMeta(target)
    local dungeonTarget = meta:getDungeonTarget()
    self._targetMeta = {1,601,1,1105022,1}
    for i = 1, #dungeonTarget do
        local data = dungeonTarget[i]
        --同种族的npc
        if data[1] == race and data[2] == npcId then
            self._targetMeta = data
            break
        end
    end
    self._costMeta = CacheManager:getItemMeta(self._targetMeta[4])
    self._costItem:setInfo(string.format(_GURL.GetImageItem, self._costMeta:getIconId()))
    local haveNum = ItemModule:getItemNum(self._targetMeta[4])
    local needNum = self._targetMeta[5]
    self._costItem:setNeedNum(haveNum, needNum)
    self._npcDesc:setText(string.format(GReadText.KEY_TASK_TIPS8, self._costMeta:getName()))
end

function UIWndTaskUseItem:onHide()
    self._costItem:removeClickListener()

    local confirmBtn = self:getChild("btn_confirm")
    confirmBtn:removeClickListener()

    local closeBtn = self:getChild("closeButton")
    closeBtn:removeClickListener()

    UIWndTaskUseItem.super.onHide(self)
end

function UIWndTaskUseItem:onConfirmBtnClick()
    local param = self:getParam() or {}
    local canUse = ItemModule:enoughItem(1, self._targetMeta[4], self._targetMeta[5], {tips = true})
    if canUse then
        NpcModule:sendBloodAltarCommit(param.npcId)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTaskUseItem", close = true})
    end
end

function UIWndTaskUseItem:onCloseBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTaskUseItem", close = true})
end

return UIWndTaskUseItem