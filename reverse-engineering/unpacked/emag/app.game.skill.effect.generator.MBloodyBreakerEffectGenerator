local MBloodyBreakerEffectGenerator = class("MBloodyBreakerEffectGenerator", lt.MEffectGenerator)

local function bAnd(a, b)
    local result = 0
    local shift = 0

    while a > 0 or b > 0 do
        local bitA = a % 2
        local bitB = b % 2
        if bitA == 1 and bitB == 1 then
            result = result + 2^shift
        end
        a = math.floor(a / 2)
        b = math.floor(b / 2)
        shift = shift + 1
    end

    return result
end

function MBloodyBreakerEffectGenerator:makeMap(dic, v_cp, p)
	local width = { 0, 1, 1, 2, 2, 2 };
	width[0] = 0
    local mask = {};
	for i = 0, 7 do
		mask[i] = {}
	end

    mask[0].x = -1;
    mask[0].y =  0;
    mask[1].x = -1;
    mask[1].y =  1;
    mask[2].x =  0;
    mask[2].y =  1;
    mask[3].x =  1;
    mask[3].y =  1;
    mask[4].x =  1;
    mask[4].y =  0;
    mask[5].x =  1;
    mask[5].y = -1;
    mask[6].x =  0;
    mask[6].y = -1;
    mask[7].x = -1;
    mask[7].y = -1;	
    
	for i = 1, 6 do
		local x = 0;
		local y = 0;
		
		for j = 0, width[i] do
			x = mask[dic].x * i;
			y = mask[dic].y * i;				
			
			
			if ( j == 0) then
				if( p == i ) then
					local pt = { x = x, y = y, center = 1};
					table.insert(v_cp, pt)
				end
			else
				local left  = ( bAnd(dic, 0x1) == 0 and bAnd((dic + 2) , 0x7) or bAnd((dic + 3) , 0x7) );
				local right = ( bAnd(dic , 0x1) == 0 and bAnd((dic + 6) , 0x7) or bAnd((dic + 5) , 0x7) );
				
				local xl = x + ( mask[left].x * j );
				local yl = y + ( mask[left].y * j );
				
				local xr = x + ( mask[right].x * j );
				local yr = y + ( mask[right].y * j );
				
				if( p == i ) then
					local pt = { x = xl, y = yl, center = 0};
					table.insert(v_cp, pt)
					local pt2 = { x = xr, y = yr, center = 0};
					table.insert(v_cp, pt2)
				end
			end
		end
	end
end

function MBloodyBreakerEffectGenerator:generate(egInfo)

	local currentPhase = egInfo.currentPhase 

	local currentDirection = egInfo.direction;
	local skillId = egInfo.skillId
	local v_cp = {};

	self:makeMap(currentDirection, v_cp, currentPhase);
	if(table.nums(v_cp) < 1) then
		return false;
	end

	local tX, tY = egInfo.tX, egInfo.tY
	
	for i=1, table.nums(v_cp) do
		local tempy, tempx =0, 0;
		if(currentPhase ~= -1) then
			--上下
			if(currentDirection == 7 or currentDirection == 6 or currentDirection == 5) then
				tempy = tempy + (currentPhase-1); -- 0，1，2，3,4,5
			end
			if(currentDirection == 1 or currentDirection == 2 or currentDirection == 3) then
				tempy = tempy - (currentPhase-1);
			end

			--左右
			if(currentDirection == 0 or currentDirection == 1 or currentDirection == 7) then
				tempx = tempx + (currentPhase-1);
			end
			if(currentDirection == 5 or currentDirection == 4 or currentDirection == 3) then
				tempx = tempx - (currentPhase-1);
			end
		end
		local effectMetas = lt.CacheManager:getSkillEffectBySkillIdAndEName(skillId, "magic_bloody_breaker")
		local sX, sY = v_cp[i].x+ tX, v_cp[i].y+ tY 
        local x, y = lt.MapUtil:calcMNMid(sX, sY)
		local offsetX, offsetY = -25, 15
		local reX, reY = x + offsetX, y + offsetY
        local bullet = lt.BullectScreenEffect.new(skillId, 0, cc.p(reX, reY))
        bullet:addEffect(skillId, effectMetas[1])
		local zorder = (sY  * 10000 + sX + 9999) * 10 + 1

        lt.BulletManager:addBulletToMapZOrder(bullet, zorder)
	end

	return true;
end

return MBloodyBreakerEffectGenerator
