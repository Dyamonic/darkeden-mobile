---@class UICompTeamApplyCell
---
local UICompTeamApplyCell = class("UICompTeamApplyCell", lt.UICompBase, lt.UICompChangeSkin)

UICompTeamApplyCell.ChangeSkinConf = {
    ["Team"] = {
        ["img_bg"] = "bg_zuduixitong_sqlbhuadond",
        ["loader_frame"] = "bg_zuduixitong_touxiangkuang",
    },
    ["CommonTL"] = {
        ["btn_reject"] = {bg = "sort"},
        ["btn_agree"] = {bg = "sort"},
    }
}

local TeamModule = lt.TeamModule
local CacheManager = lt.CacheManager
local Constant = lt.Constant

function UICompTeamApplyCell:ctor()
    UICompTeamApplyCell.super.ctor(self)
    --UI
    self._nameLabel = nil
    self._levelLabel = nil
    self._jobLoader = nil
    self._guildLabel = nil
    self._rejectBtn = nil
    self._agreeBtn = nil
    self._stateLabel = nil
    --数据
    self._playerInfo = nil
end

function UICompTeamApplyCell:onClear()
    --UI
    self._nameLabel = nil
    self._levelLabel = nil
    self._jobLoader = nil
    self._guildLabel = nil
    self._rejectBtn = nil
    self._agreeBtn = nil
    self._stateLabel = nil
    --数据
    self._playerInfo = nil
    UICompTeamApplyCell.super.onClear(self)
end

function UICompTeamApplyCell:onConstruct()
    self:startSkin()
    self._nameLabel = self:getChild("label_name")
    self._levelLabel = self:getChild("label_level")
    self._jobLoader =  self:getChild("loader_job")
    self._guildLabel = self:getChild("label_guild")
    self._rejectBtn = self:getChild("btn_reject")
    self._agreeBtn = self:getChild("btn_agree")
    self._stateLabel = self:getChild("label_state")
end

function UICompTeamApplyCell:onEnter()
    UICompTeamApplyCell.super.onEnter(self)
    self._rejectBtn:addClickListener(handler(self, self.onRejectBtnClick))
    self._agreeBtn:addClickListener(handler(self, self.onAgreeBtnClick))

end
function UICompTeamApplyCell:onExit()
    self._rejectBtn:removeClickListener()
    self._agreeBtn:removeClickListener()
    UICompTeamApplyCell.super.onExit(self)
end

function UICompTeamApplyCell:setInfo(playerInfo)
    self._nameLabel:setText(playerInfo.playerName)
    local isAdvanve = playerInfo.advanceState
    if isAdvanve == Constant.AdvState.NotAdv then
        local level = playerInfo.level or 0
        self._levelLabel:setText("Lv."..level)
    else
        local level = playerInfo.advanceLv or 1
        self._levelLabel:setText("Av."..level)
    end
    self._guildLabel:setText(playerInfo.guildName)
    self._jobLoader:setURL(string.format(_GURL.GetImageJob, playerInfo.iconId))
    self._playerInfo = playerInfo
end

function UICompTeamApplyCell:onRejectBtnClick()
    TeamModule:sendRejectInTeam(self._playerInfo.playerId)
end

function UICompTeamApplyCell:onAgreeBtnClick()
    TeamModule:sendAgreeInTeam(self._playerInfo.playerId)
end

return UICompTeamApplyCell