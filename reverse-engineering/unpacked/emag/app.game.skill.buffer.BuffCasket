local BuffCasket = class("BuffCasket", lt.BufferBase)
local SkillEnum = lt.SkillEnum
local Constant = lt.Constant
local TRANSFORM = SkillEnum.TRANSFORM

--[[
    变身-棺材
]]


function BuffCasket:ctor(time, actor, skilllevel, source, bufferId)   
    BuffCasket.super.ctor(self, bufferId, time, actor)
    self._casketOwnAgent = actor:getAgent()
    if self._casketOwnAgent then
        self._casketOwnAgent:playAction(Constant.ROLE_ACTION_IDLE)
        self._casketOwnAgent:casketInvisible(TRANSFORM.CASKET) 
    end
    actor:setHideDarkRevengeNode(true)
end

function BuffCasket:onClear()
    if self._casketOwnAgent then
        self._casketOwnAgent:casketInvisible(TRANSFORM.NONE)
        self._casketOwnAgent:setTransformId(0)
    end
    self._actor:setHideDarkRevengeNode(false)
    BuffCasket.super.onClear(self)
end

return BuffCasket
