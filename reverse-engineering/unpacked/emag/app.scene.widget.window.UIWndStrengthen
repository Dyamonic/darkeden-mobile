function UIWndStrengthen:onGildScrollChange(event)
    local posY = self._scrollPane:getPosY()
    local top = math.floor(posY/68)
    if self.scroolTopPosY ~= top then
        self.scroolTopPosY = math.floor(posY/68)
        self.downPosY = self.scroolTopPosY + 8
        -- print("当前的计划顶点是:",self.scroolTopPosY,"底点是：",self.downPosY," 窗口高度：",posY)
        self:updateTiledItem(self.scroolTopPosY,self.downPosY)
    end
end

function UIWndStrengthen:updateTiledItem(top,down)
    --归还视图外的格子
    for row, _ in pairs(self._tiledsTab) do
        if row < top or row > down then
            if self._tiledsTab[row] then
                for _, tiled in pairs(self._tiledsTab[row]) do
                    if not self._gridList:isChildInView(tiled) then
                        self._gridManger:pushTiledGird(tiled)
                    end
                    self._tiledsTab[row] = nil
                end
            end
        end
    end
    --从缓存中取格子
    for row = top, down do
        if self._tiledsTab[row] == nil then
            for col = 1, 6 do
                local tiled = self._gridManger:popTiledGird()
                self:showTiledInPanel(row,col,tiled)
            end
        end
    end
    --归还视图外的道具
    for key, item in pairs(self._itemsTab) do
        if not self._gridList:isChildInView(item) or self._itemDataTable[key] == nil then
            -- print("update清除道具：",item:getItemInfo():getItemMeta():getName(),key)
            item:removeFromParent()
            self._gridManger:pushBagItem(item)
            self._itemsTab[key] = nil
        end
    end
    if self._itemDataTable then
        for _, itemdata in pairs(self._itemDataTable) do
            if not self._itemsTab[itemdata:getObjId()] and self._gridManger:isItemInWindow(itemdata,top,down) then
                -- if self._sp then
                --     self:showItemInPanle(itemdata,self._objId, self._objId2)
                -- else
                --     self:showItemInPanle(itemdata,self._objId)
                -- end
                self:showItemInPanle(itemdata)
            end
        end
    end
end

-- 创建单个格子
function UIWndStrengthen:showTiledInPanel(row, col,tiled)
    -- 复用已存在的格子或创建新格子
    if not tiled:getParent() then 
        tiled:insertObjectToFactory(self)
        tiled:setPivot(0.5, 0.5, true)
        self._tiledPanel:addChild(tiled)
    end
    self._tiledsTab[row] = self._tiledsTab[row] or {}
    self._tiledsTab[row][col] = tiled
    local centerPos = self._gridManger:getTiledCenterXY(col, row)
    tiled:setPosition(centerPos.x, centerPos.y)
    --占用态
    if self._tiledMapSelectTab[row] and self._tiledMapSelectTab[row][col] then
        tiled:setSelectedShow(true)
    else
        tiled:setSelectedShow(false)
    end
end

function UIWndStrengthen:showItemInPanle(itemInfo)
    local select_ObjId = nil
    if self._special then
        if self._itemInfo then
            select_ObjId = self._objId
            if not select_ObjId then
                select_ObjId = self._itemInfo:getObjId()
            end
        end
    else
        select_ObjId = self._objId
    end
    local select_objId2 = nil
    if self._itemInfo2 then
        select_objId2 = self._objId2
        if not select_objId2 then
            select_objId2 = self._itemInfo2:getObjId()
        end
    end
    
    local gridSizeIndex = itemInfo:getItemMeta():getItemSize()
    local objId = itemInfo:getObjId()
    if not self._itemsTab[objId]  then
        local item = self._gridManger:popBagItem(gridSizeIndex)
        self._itemsTab[objId] = item
        if not item:getParent() then
            item:insertObjectToFactory(self)
            item:setPivot(0.5,0.5, true)
            item:setFromWnd(self)
            item:setSortingOrder(10)
            self._itemsPanel:addChild(item)
        end
    end
    self._itemsTab[objId]:setItemInfo(itemInfo,2)
    self._itemsTab[objId]:setItemSelect(false)
    --设置默认选中
    if select_objId2 then
        if itemInfo:getObjId() == select_ObjId then
            self._selectItem = self._itemsTab[objId]
            self._itemInfo = itemInfo
            self._selectItem:setItemSelect(true)
        elseif itemInfo:getObjId() == select_objId2 then
            self._selectItem2 = self._itemsTab[objId]
            self._itemInfo2 = itemInfo
            self._selectItem2:setItemSelect(true)
        end
    else
        if select_ObjId and itemInfo:getObjId() == select_ObjId then
            if self._special then
                if self._itemInfo ~= nil then
                    self._selectItem = self._itemsTab[objId]
                    self._itemInfo = itemInfo
                    self._selectItem:setItemSelect(true)
                else
                    self._selectItem2 = self._itemsTab[objId]
                    self._itemInfo2 = itemInfo
                    self._selectItem2:setItemSelect(true)
                end
            elseif self._itemInfo == nil then
                self._selectItem = self._itemsTab[objId]
                self._itemInfo = itemInfo
                self._selectItem:setItemSelect(true)
            end
        end
    end
    if select_objId2 and itemInfo:getObjId() == select_objId2 then
        self._itemsTab[objId]:setItemSelect(true)
    end
    if select_ObjId and itemInfo:getObjId() == select_ObjId then
        self._itemsTab[objId]:setItemSelect(true)
    end
    local isFilter = itemInfo:getFilter()
    self._itemsTab[objId]:setGrayed(isFilter == 0)
    self:pushItemInBag(self._itemsTab[objId],isFilter == 0)
    if self._sp then
        self._itemsTab[objId]:setClickCallback(function()
            if itemInfo:getFilter() == 0 then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_STRENGTHEN_TIPS51})
                return
            end
            self:selectEquip(self._itemsTab[objId])
            self:refreshSubView()
        end)
    else
        self._itemsTab[objId]:setClickCallback(function()
            if itemInfo:getFilter() == 0 then
                local str = StrengthenModule:getErrorStr(self._index, itemInfo, self._info)
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = str})
                return
            end
            self:selectEquip(self._itemsTab[objId], true)
            self:refreshSubView()
        end)
    end
    self._itemsTab[objId]:setLongCallback(function()
        self:showTips(itemInfo)
    end)
end

---添加一个物品到格子上
function UIWndStrengthen:pushItemInBag(pItem,noSelect)
    local gridX, gridY = pItem:getGridX(), pItem:getGridY()
    local gridWidth = pItem:getGridWidth()
    local gridHeight = pItem:getGridHeight()
    local isFilter = pItem:getItemInfo():getFilter()
    pItem:setGrayed(isFilter == 0)
    if not gridY then
        return
    end
    for i = gridY, gridY + gridHeight - 1 do
        for j = gridX, gridX + gridWidth - 1 do
            if not noSelect then
                self:showTiledSelect(j, i)
            end
            local cellPos = self._gridManger:getCenterXY(pItem)
            pItem:setPosition(cellPos.x, cellPos.y)
        end
    end
end

function UIWndStrengthen:showTiledSelect(gridX, gridY)
    self._tiledMapSelectTab[gridY] = self._tiledMapSelectTab[gridY] or {}
    self._tiledMapSelectTab[gridY][gridX] = true
    if self._tiledsTab[gridY] and self._tiledsTab[gridY][gridX] then
        self._tiledsTab[gridY][gridX]:setSelectedShow(true)
    end
end

function UIWndStrengthen:hideTiledSelect(gridX, gridY)
    self._tiledMapSelectTab[gridY] = self._tiledMapSelectTab[gridY] or {}
    self._tiledMapSelectTab[gridY][gridX] = nil
    if self._tiledsTab[gridY] and self._tiledsTab[gridY][gridX] then
        self._tiledsTab[gridY][gridX]:setSelectedShow(false)
    end
end

function UIWndStrengthen:resetTiledAndItem()
    if self._tiledsTab then
        for row, _ in pairs(self._tiledsTab) do
            if self._tiledsTab[row] then
                for _, tiled in pairs(self._tiledsTab[row]) do
                    tiled:removeFromParent()
                    self._gridManger:pushTiledGird(tiled)
                    self._tiledsTab[row] = nil
                end
            end
        end
    end
    self._tiledsTab = {} --视图中的格子
    if self._itemsTab then
        for key, item in pairs(self._itemsTab) do
            -- print("清除道具：",item:getItemInfo():getItemMeta():getName(),key)
            item:removeFromParent()
            self._gridManger:pushBagItem(item)
            self._itemsTab[key] = nil
        end
    end
    self._itemsTab = {}        -- 视图中的道具
    self.scroolTopPosY = nil   -- 顶部格子坐标系高度
    self._tiledMapSelectTab = {}--存放格子选中态数据
end

function UIWndStrengthen:onUpdate(dt)
    if self._itemsTab then
        for key, item in pairs(self._itemsTab) do
            item:onUpdate(dt)
        end
    end
end

return UIWndStrengthen