    self._gridPanel:setSize(self._gridManger:getGridSize())

    if not itemArray then return end

    self._sp = true
    
    self:resetTiledAndItem()
    self:createItemDataTable(itemArray)
    self:onGildScrollChange()
end

function UIWndStrengthen:showCurPanel()
    if self._selectItem then
        self:selectEquip(self._selectItem)
    end
    if self._openViewType == FITER_TYPES.LEVELUP then
        -- 升级界面
        if not self._levelupPanel then
            self._levelupPanel = fgui.UIPackage:createObject("Strengthen", "LevelupPanel")
            self._levelupPanel:setRegClass(self)
            self._levelupPanel:insertObjectToFactory(self)
            self._levelupPanel:setPosition(470, 41)
            self._emptyNode:addChild(self._levelupPanel)
        end
        self._levelupPanel:refreshView(self._itemInfo)
    elseif self._openViewType == FITER_TYPES.ENCHANT then
        --附魔界面
        if not self._enchantPanel then
            self._enchantPanel = fgui.UIPackage:createObject("Strengthen", "EnchantPanel")
            self._enchantPanel:insertObjectToFactory(self)
            self._enchantPanel:setPosition(470, 41)
            self._emptyNode:addChild(self._enchantPanel)
        end
        self._enchantPanel:refreshView(self._itemInfo, self._subViewType)
    elseif self._openViewType == FITER_TYPES.FUSION then
        --融合界面
        if not self._fusionPanel then
            self._fusionPanel = fgui.UIPackage:createObject("Strengthen", "FusionPanel")
            self._fusionPanel:insertObjectToFactory(self)
            self._fusionPanel:setPosition(470, 41)
            self._emptyNode:addChild(self._fusionPanel)
        end
        self._fusionPanel:refreshView1(self._itemInfo, self._subViewType)
        self._fusionPanel:refreshView2(self._itemInfo2, self._subViewType)
    elseif self._openViewType == FITER_TYPES.SUCCINCT then
        --洗炼界面
        if not self._succinctPanel then
            self._succinctPanel = fgui.UIPackage:createObject("Strengthen", "SuccinctPanel")
            self._succinctPanel:insertObjectToFactory(self)
            self._succinctPanel:setPosition(470, 41)
            self._emptyNode:addChild(self._succinctPanel)
        end
        self._succinctPanel:refreshView(self._itemInfo, self._subViewType)
    end
    --显示
    if self._levelupPanel then
        self._levelupPanel:setVisible(self._openViewType == FITER_TYPES.LEVELUP)
    end
    if self._enchantPanel then
        self._enchantPanel:setVisible(self._openViewType == FITER_TYPES.ENCHANT)
    end
    if self._fusionPanel then
        self._fusionPanel:setVisible(self._openViewType == FITER_TYPES.FUSION)
    end
    if self._succinctPanel then
        self._succinctPanel:setVisible(self._openViewType == FITER_TYPES.SUCCINCT)
    end
end


function UIWndStrengthen:refreshSubView()
    --刷新右侧界面
    if self._openViewType == FITER_TYPES.LEVELUP then
        if self._levelupPanel then
            self._levelupPanel:refreshView(self._itemInfo)
        end
    elseif self._openViewType == FITER_TYPES.ENCHANT then
        if self._enchantPanel then
            self._enchantPanel:refreshView(self._itemInfo, self._subViewType)
        end
    elseif self._openViewType == FITER_TYPES.FUSION then
        if self._fusionPanel then
            self._fusionPanel:refreshView1(self._itemInfo, self._subViewType)
            self._fusionPanel:refreshView2(self._itemInfo2, self._subViewType)
        end
    elseif self._openViewType == FITER_TYPES.SUCCINCT then
        if self._succinctPanel then
            self._succinctPanel:refreshView(self._itemInfo, self._subViewType)
        end
    end
end

--刷新左侧装备界面
function UIWndStrengthen:refreshEquipView(event)
    local param = event.param or {}
    local objId = param.objId
    local noRefresh = param.noRefresh
    self:refreshItemInfo(objId)
    if not noRefresh then
        self:showCurPanel()
    end
end

--确认融合结果
function UIWndStrengthen:equipFusionSure(event)
    if self._fusionPanel then
        self._fusionPanel:onSureBtnClick()
    end
end

------------------------- grid -------------------------------
function UIWndStrengthen:initGridData()
    self._gridManger = lt.InventoryGridManger.new(Constant.STRENGTHEN_SIZE.WIDTH, Constant.STRENGTHEN_SIZE.HEIGHT, true)
end

function UIWndStrengthen:clearAllSelectTiled()
    self._tiledMapSelectTab = {}
end

------------------------- tips ---------------------------------
function UIWndStrengthen:showTips(itemInfo)
    local itemType = itemInfo:getItemType()
    if itemType ==  Constant.ItemType.ITEM_TYPE_PROP then
        self:showPropTips(itemInfo)
    elseif itemType ==  Constant.ItemType.ITEM_TYPE_EQUIP then
        self:showEquipTips(itemInfo)
    end
end

function UIWndStrengthen:showPropTips(itemInfo)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemInfo, tipsType = Constant.PROPTIPS_FORM.Display})
end

function UIWndStrengthen:showEquipTips(itemInfo)
    if self._itemInfo and self._itemInfo:getObjId() ~= itemInfo:getObjId() and self._itemInfo:getMetaKind() == itemInfo:getMetaKind() and self._itemInfo:getMetaType() == itemInfo:getMetaType() then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo, compareItemInfo = self._itemInfo, tipsType = Constant.EquipShowTipsType.Display})
    elseif self._itemInfo2 and self._itemInfo2:getObjId() ~= itemInfo:getObjId() and self._itemInfo2:getMetaKind() == itemInfo:getMetaKind() and self._itemInfo2:getMetaType() == itemInfo:getMetaType() then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo, compareItemInfo = self._itemInfo2, tipsType = Constant.EquipShowTipsType.Display})
    else
