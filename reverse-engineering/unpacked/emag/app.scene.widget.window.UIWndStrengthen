function UIWndStrengthen:selectEquip(item, active)
    --融合特殊处理
    if self._openViewType == FITER_TYPES.FUSION then
        if self._itemInfo and item:getItemInfo():getObjId() == self._itemInfo:getObjId() then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_EQUIP_CHOOSE, {types = 1, needRefresh = true})
        elseif self._itemInfo2 and item:getItemInfo():getObjId() == self._itemInfo2:getObjId() then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_EQUIP_CHOOSE, {types = 2, needRefresh = true})
        else
            if self._itemInfo == nil then
                --刷新选中状态
                if self._selectItem then
                    self._selectItem:setItemSelect(false)
                end
                self._selectItem = item
                self._selectItem:setItemSelect(true)
                self._itemInfo = item:getItemInfo()
                --融合且第一次选择需要刷新左侧装备
                local objId = item:getItemInfo():getObjId()
                if self._itemInfo2 == nil then
                    self:refreshItemInfo(objId, true)
                else
                    local objId2 = self._itemInfo2:getObjId()
                    self:refreshItemInfoSp(objId, objId2)
                end
            else
                --刷新选中状态
                if self._selectItem2 then
                    self._selectItem2:setItemSelect(false)
                end
                self._selectItem2 = item
                self._selectItem2:setItemSelect(true)
                self._itemInfo2 = item:getItemInfo()
                
                local objId1 = self._itemInfo:getObjId()
                local objId2 = self._itemInfo2:getObjId()
                self:refreshItemInfoSp(objId1, objId2)
            end
        end
    else
        if active and self._itemInfo and item:getItemInfo():getObjId() == self._itemInfo:getObjId() then
            --如果选中已选中的则卸下
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_EQUIP_CHOOSE, {needRefresh = false})
        else
            --刷新选中状态
            if self._selectItem then
                self._selectItem:setItemSelect(false)
            end
            self._selectItem = item
            self._selectItem:setItemSelect(true)
            self._itemInfo = item:getItemInfo()
        end
    end
end

function UIWndStrengthen:cancelEquipChoose(event)
    --融合特殊处理
    local param = event.param or {}
    if self._openViewType == FITER_TYPES.FUSION then
        local types = param.types or 1
        if types == 1 then
            if self._selectItem and self._selectItem.setItemSelect then
                self._selectItem:setItemSelect(false)
            end
            self._selectItem = nil
            self._itemInfo = nil
            self._objId = nil
            local objId = self._itemInfo2 and self._itemInfo2:getObjId() or nil
            self:refreshItemInfo(objId, true)
            self:refreshSubView()
        else
            if self._selectItem2 and self._selectItem2.setItemSelect then
                self._selectItem2:setItemSelect(false)
            end
            self._selectItem2 = nil
            self._itemInfo2 = nil
            self._objId2 = nil
            local objId = self._itemInfo and self._itemInfo:getObjId() or nil
            self:refreshItemInfo(objId, true)
            self:refreshSubView()
        end
    else
        local needRefresh = param.needRefresh
        if self._selectItem then
            self._selectItem:setItemSelect(false)
        end
        self._selectItem = nil
        self._itemInfo = nil
        if needRefresh then
            self:refreshItemInfo()
        end
        self:refreshSubView()
    end
end

