function UIWndStrengthen:ctor(param)
    UIWndStrengthen.super.ctor(self, param)
    self._tipsShow = false
    self._fiterBtns = {}
    self._fiterEquipBtns = {}
    self._selectItem = nil
    self._itemInfo = nil
    self._levelupPanel = nil
    self._enchantPanel = nil
    self._fusionPanel = nil
    self._succinctPanel = nil
    self._gridList = nil
    self._gridPanel = nil
    self._controlTab = nil
    self._emptyNode = nil
    self._mask = nil
    self._oustersFrame = nil
    self._tiledPanel = nil
    self._itemsPanel = nil
    self._equipControlTab = nil
    --融合专属
    self._selectItem2 = nil
    self._itemInfo2 = nil
    self._sp = false
    -- 背包物品存储
    self._bagItems = {}
end

function UIWndStrengthen:onClear()
    self:clear()
    if self._gridManger then
        self._gridManger:clearTiledItem()
        self._gridManger = nil
    end
    self:unregisterAllComponent()
    self:removeChildren()
    self._tipsShow = nil
    self._fiterBtns = nil
    self._fiterEquipBtns = nil
    self._selectItem = nil
    self._itemInfo = nil
    self._levelupPanel = nil
    self._enchantPanel = nil
    self._fusionPanel = nil
    self._succinctPanel = nil
    self._gridList = nil
    self._gridPanel = nil
    self._controlTab = nil
    self._emptyNode = nil
    self._mask = nil
    self._oustersFrame = nil
    self._tiledPanel = nil
    self._itemsPanel = nil
    self._equipControlTab = nil

    --融合专属
    self._selectItem2 = nil
    self._itemInfo2 = nil
    UIWndStrengthen.super.onClear(self)
end

function UIWndStrengthen:onInit()
    self:registerComponent("UICompItem", "UICompInventoryTiled", "UICompStLevelup", "UICompStEnchant", "UICompStFusion", "UICompStSuccinct", "UICompAttrItem")
    UIWndStrengthen.super.onInit(self, _GURL.WndStrengthen)
    self:initUI()
    self:initGridData()
end

function UIWndStrengthen:onShown()
    self:enableUpdateEvent(true)

    NtfManager:addNtfListener(NtfManager.NTF.NTF_CANCEL_EQUIP_CHOOSE, handler(self, self.cancelEquipChoose), "UIWndStrengthen:cancelEquipChoose")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SELECT_SUBVIEW, handler(self, self.selectSubView), "UIWndStrengthen:selectSubView")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_OPEN_STRENGTHEN_MASK, handler(self, self.showMaskView), "UIWndStrengthen:showMaskView")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CONFIRM_BLESSING, handler(self, self.blessingConfirm), "UIWndStrengthen:blessingConfirm")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CONFIRM_FUSION, handler(self, self.fusionConfirm), "UIWndStrengthen:fusionConfirm")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CONFIRM_SUCCINCT, handler(self, self.succinctConfirm), "UIWndStrengthen:succinctConfirm")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_RECASTING_RESULT, handler(self, self.recastingResult), "UIWndStrengthen:recastingResult")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_EQUIP_VIEW, handler(self, self.refreshEquipView), "UIWndStrengthen:refreshEquipView")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_EQUIP_STENCHANT, handler(self, self.equipEnchantFinish), "UIWndStrengthen:equipEnchantFinish")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_EQUIP_FUSION_SURE, handler(self, self.equipFusionSure), "UIWndStrengthen:equipFusionSure")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CHECK_GUIDE_EVENT, handler(self, self.checkGuide), "UIWndStrengthen:checkGuide")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_ITEM_EVENT, handler(self, self.refreshItemNum), "UIWndStrengthen:refreshItemNum")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_MONEY_EVENT, handler(self, self.refreshMoney), "UIWndStrengthen:refreshMoney")
    --服务器回调相关
    NtfManager:addNtfListener(NtfManager.NTF.NTF_EQUIP_LEVELUP, handler(self, self.equipLevelUp), "UIWndStrengthen:equipLevelUp")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_EQUIP_STRENGTHEN, handler(self, self.equipStrengthen), "UIWndStrengthen:equipStrengthen")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_EQUIP_BLESSING, handler(self, self.equipBlessing), "UIWndStrengthen:equipBlessing")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_EQUIP_MOTIVATE, handler(self, self.equipMotivate), "UIWndStrengthen:equipMotivate")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_EQUIP_COMPOSE, handler(self, self.equipCompose), "UIWndStrengthen:equipCompose")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_EQUIP_INHERIT, handler(self, self.equipInherit), "UIWndStrengthen:equipInherit")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_EQUIP_RECASTING, handler(self, self.equipRecasting), "UIWndStrengthen:equipRecasting")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_EQUIP_PURIFY, handler(self, self.equipPurify), "UIWndStrengthen:equipPurify")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_EQUIP_TRANSFORM, handler(self, self.equipTransform), "UIWndStrengthen:equipTransform")

    local closeButton = self:getChild("closeButton")
    closeButton:addClickListener(handler(self, self.onCloseBtnClick))

    for k, v in ipairs(self._fiterBtns) do
        v:addClickListener(handler(self, self.openFiterBtnClick))
    end

    for k, v in ipairs(self._fiterEquipBtns) do
        v:addClickListener(handler(self, self.openFiterEquipBtnClick))
    end

    local param = self:getParam().param or {}
    local mainIdx = param.index or 1
    local subIdx = param.subIdx or 1
    local defaultView = self._fiterBtns[mainIdx]
    defaultView:setSortingOrder(3)
    
    local objId = param.objId
    self._filterEquipType = param.filterType or Constant.FilterEquipType.RoleEquip
    StrengthenModule:setFilterEquipType(self._filterEquipType)
    self._equipControlTab:setSelectedIndex(self._filterEquipType - 1)

    self:openFiterView(defaultView, subIdx, objId)

    self._fiterBtns[2]:setVisible(FunctionToggleModule:checkEnterVisible(FunctionToggleModule.FunctionHelpId.EquipmentEnchant))
    self._fiterBtns[3]:setVisible(FunctionToggleModule:checkEnterVisible(FunctionToggleModule.FunctionHelpId.EquipmentFusion))
    self._fiterBtns[4]:setVisible(FunctionToggleModule:checkEnterVisible(FunctionToggleModule.FunctionHelpId.EquipmentWash))

    -- 监听滚动事件
    self._gridList:addEventListener(fgui.UIEventType.Scroll,handler(self, self.onGildScrollChange))
end

function UIWndStrengthen:onHide()
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:cancelEquipChoose")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:selectSubView")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:showMaskView")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:blessingConfirm")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:fusionConfirm")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:succinctConfirm")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:recastingResult")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:refreshEquipView")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:equipFusionSure")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:checkGuide")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:refreshItemNum")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:refreshMoney")
    --服务器回调相关
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:equipLevelUp")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:equipStrengthen")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:equipBlessing")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:equipMotivate")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:equipCompose")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:equipInherit")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:equipRecasting")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:equipPurify")
    NtfManager:removeNtfListenerByTag("UIWndStrengthen:equipTransform")
    
    self._gridList:removeEventListener(fgui.UIEventType.Scroll)
    local closeButton = self:getChild("closeButton")
    closeButton:removeClickListener()

    for k, v in ipairs(self._fiterBtns) do
        v:removeClickListener()
    end

    for k, v in ipairs(self._fiterEquipBtns) do
        v:removeClickListener()
    end

    --中断GTween延迟
    if self._levelupPanel then
        self._levelupPanel:resetTargetAction()
    end
    if self._enchantPanel then
        self._enchantPanel:resetTargetAction()
    end
    self._equipControlTab:setSelectedIndex(0)
    
    UIWndStrengthen.super.onHide(self)
end

function UIWndStrengthen:initUI()
    self._gridList = self:getChild("gridList")
    self._gridList:setScrollItemToViewEnabled(false)
    self._gridPanel = self._gridList:addItemFromPool()
    self._controlTab = self:getController("tabs")
    self._emptyNode = self:getChild("emptyNode")
    self._emptyNode:setSortingOrder(99)
    self._mask = self:getChild("mask")
    self._mask:setSortingOrder(999)
    self._scrollPane = self._gridList:getScrollPane()
    self._listSize = self._gridList:getSize()
    self._oustersFrame = self:getChild("ousters_frame")
    local race = GameModule:getHeroRace()
    self._oustersFrame:setVisible(race == Constant.RaceType.Ousters)

    local closeButton = self:getChild("closeButton")
    -- closeButton:setSortingOrder(100)

    self._tiledPanel = fgui.GComponent:create()
    self._itemsPanel = fgui.GComponent:create()
    self._gridPanel:addChild(self._tiledPanel)
    self._gridPanel:addChild(self._itemsPanel)

    for fiterType = 1, table.nums(FITER_TYPES) do
        local obj = self:getChild("btnFiter"..fiterType)
        obj.fiterType = fiterType
        self._fiterBtns[fiterType] = obj
    end

    --页签
    for fiterType = 1, table.nums(FITER_EQUIP_TYPES) do
        local obj = self:getChild("btn_yeqian"..fiterType)
        obj.fiterType = fiterType
        self._fiterEquipBtns[fiterType] = obj
    end
    self._equipControlTab = self:getController("equipTabs")
end

function UIWndStrengthen:clear(special)
    if self._mask then
        self._mask:setVisible(false)
    end
    self._gridManger:clear()
    self:clearAllSelectTiled()
    self:resetTiledAndItem()
    --融合特殊处理
    if not special then
        self._selectItem = nil
        self._itemInfo = nil
        self._selectItem2 = nil
        self._itemInfo2 = nil
    end
end

function UIWndStrengthen:openFiterView(sender, subIdx, objId)
    -- if self._openViewType == sender.fiterType and self._subViewType == subIdx then 
    --     return 
    -- end
    self._openViewType = sender.fiterType
    self._subViewType = subIdx
    self._controlTab:setSelectedIndex(self._openViewType - 1)

    --刷新页签
    for fiterType = 1, table.nums(FITER_EQUIP_TYPES) do
        local obj = self._fiterEquipBtns[fiterType]
        obj:setVisible(self._openViewType ~= FITER_TYPES.FUSION)
        if self._openViewType == FITER_TYPES.SUCCINCT and self._subViewType == 3 then
            obj:setVisible(false)
        end
    end

    self._gridList:scrollToView(0)
    self:refreshItemInfo(objId)
    self:showCurPanel()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_EQUIP_FUSION_SURE)
end

function UIWndStrengthen:refreshItemInfo(objId, special)
    self._objId = objId
    self._special = special
    --计算数据
    local index = Constant.TYPEFILTER.LEVELUP
    if self._openViewType == FITER_TYPES.LEVELUP then
        index = Constant.TYPEFILTER.LEVELUP
    elseif self._openViewType == FITER_TYPES.ENCHANT then
        if self._subViewType == 1 then
            index = Constant.TYPEFILTER.STRENGTHNEN
        elseif self._subViewType == 2 then
            index = Constant.TYPEFILTER.BLESSING
        elseif self._subViewType == 3 then
            index = Constant.TYPEFILTER.MOTIVATE
        end
    elseif self._openViewType == FITER_TYPES.FUSION then
        if self._subViewType == 1 then
            if self._itemInfo == nil then
                index = Constant.TYPEFILTER.COMPOSELEFT
            else
                index = Constant.TYPEFILTER.COMPOSERIGHT
            end
        elseif self._subViewType == 2 then
            if self._itemInfo == nil then
                index = Constant.TYPEFILTER.INHERITLEFT
            else
                index = Constant.TYPEFILTER.INHERITRIGHT
            end
        elseif self._subViewType == 3 then
            if self._itemInfo == nil then
                index = Constant.TYPEFILTER.REFINELEFT
            else
                index = Constant.TYPEFILTER.REFINERIGHT
            end
        end
    elseif self._openViewType == FITER_TYPES.SUCCINCT then
        if self._subViewType == 1 then
            index = Constant.TYPEFILTER.RECASTING
        elseif self._subViewType == 2 then
            index = Constant.TYPEFILTER.PURIFY
        elseif self._subViewType == 3 then
            index = Constant.TYPEFILTER.TRANSFORM
        end
    end
    self._index = index
    local info = (special and self._itemInfo2) and self._itemInfo2 or self._itemInfo
    self._info = info
    local maxHeight = ItemModule:fiterStrengthenItems(index, info, self._filterEquipType)
    local itemArray = ItemModule:getFiterStrengthenArr()

    --清理
    self:clear(special)

    --重新设置高度
    self._gridManger:setGridHeight(maxHeight)
    self._gridManger:clear()
    self._gridPanel:setSize(self._gridManger:getGridSize())

    if not itemArray then return end

    self._sp = false
    self:resetTiledAndItem()
    self:createItemDataTable(itemArray)
    self:onGildScrollChange()
end

function UIWndStrengthen:refreshItemInfoSp(objId1, objId2)
    self._objId = objId1
    self._objId2 = objId2
    local index = Constant.TYPEFILTER.LEVELUP
    if self._openViewType == FITER_TYPES.LEVELUP then
        index = Constant.TYPEFILTER.LEVELUP
    elseif self._openViewType == FITER_TYPES.ENCHANT then
        if self._subViewType == 1 then
            index = Constant.TYPEFILTER.STRENGTHNEN
        elseif self._subViewType == 2 then
            index = Constant.TYPEFILTER.BLESSING
        elseif self._subViewType == 3 then
            index = Constant.TYPEFILTER.MOTIVATE
        end
    elseif self._openViewType == FITER_TYPES.FUSION then
        if self._subViewType == 1 then
            if self._itemInfo == nil then
                index = Constant.TYPEFILTER.COMPOSELEFT
            else
                index = Constant.TYPEFILTER.COMPOSERIGHT
            end
        elseif self._subViewType == 2 then
            if self._itemInfo == nil then
                index = Constant.TYPEFILTER.INHERITLEFT
            else
                index = Constant.TYPEFILTER.INHERITRIGHT
            end
        elseif self._subViewType == 3 then
            if self._itemInfo == nil then
                index = Constant.TYPEFILTER.REFINELEFT
            else
                index = Constant.TYPEFILTER.REFINERIGHT
            end
        end
    elseif self._openViewType == FITER_TYPES.SUCCINCT then
        if self._subViewType == 1 then
            index = Constant.TYPEFILTER.RECASTING
        elseif self._subViewType == 2 then
            index = Constant.TYPEFILTER.PURIFY
        elseif self._subViewType == 3 then
            index = Constant.TYPEFILTER.TRANSFORM
        end
    end
    self._index = index
    local maxHeight = ItemModule:fiterStrengthenItemsSp(index, self._itemInfo, self._itemInfo2)
    local itemArray = ItemModule:getFiterStrengthenArr()

    --清理
    self:clear(true)

    --重新设置高度
    self._gridManger:setGridHeight(maxHeight)
