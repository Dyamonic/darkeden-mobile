local HeroStateRapidMove = class("HeroStateRapidMove", lt.HeroStateBase)

local MapUtil = lt.MapUtil
local AgentManager = lt.AgentManager
local Constant = lt.Constant
local PI = 3.141592


-- 目标位置
HeroStateRapidMove._mTarget       = nil
HeroStateRapidMove._nTarget       = nil
HeroStateRapidMove._xTarget       = nil
HeroStateRapidMove._yTarget       = nil

-- hero位置
HeroStateRapidMove._mHeroX = nil
HeroStateRapidMove._mHeroY = nil

--[[
    技能: 快速滑行  血腥巅峰
]]

function HeroStateRapidMove:ctor(heroAgent, mTarget, nTarget, skillId, mAgentTarget, nAgentTarget)
    HeroStateRapidMove.super.ctor(self, heroAgent)

    self._skillId = skillId
    self._mAgentTarget = mAgentTarget
    self._nAgentTarget = nAgentTarget
    self._isEnd = false
    self._fastMoveShadowMax = 2
    if self._skillId == lt.SkillEnum.MAGIC_BLOODY_ZENITH or self._skillId == lt.SkillEnum.SKILL_BLOODS_SYMPOSION then
        self._fastMoveShadowMax = 8
    end
    self._moveAction = nil
    self:initMove(mTarget, nTarget)
end

function HeroStateRapidMove:onClear()
    -- if self._moveAction then
    --     self._heroActor:stopAction(self._moveAction)
    --     self._moveAction = nil
    -- end
    
    self._mTarget = nil
    self._nTarget = nil
    self._xTarget = nil
    self._yTarget = nil
    self._mHeroX  = nil
    self._mHeroY  = nil
    self._oMHeroX = nil
    self._oMHeroY = nil
    self._skillId = nil
    self._isEnd   = nil
    self._frames  = nil
    self._mAgentTarget = nil
    self._nAgentTarget = nil
    self._directionVO  = nil
    self._showMultiple = nil
    self._heroActor    = nil
    self._cloneActorArr= nil
    self._fastMoveShadowMax = nil
    HeroStateRapidMove.super.onClear(self)
end

function HeroStateRapidMove:initMove(mNext, nNext)
    -- hero 目标格子位置
    self._mTarget = mNext
    self._nTarget = nNext
    self._heroActor = self._heroAgent:getActor()

    -- 转换坐标
    self._xTarget, self._yTarget = MapUtil:calcMNMid(self._mTarget, self._nTarget)

    -- 设置方向
    local xHero, yHero = self._heroAgent:getPosition()

    -- 换算方向
    local direction = MapUtil:calcDirectionXY(self._xTarget - xHero, self._yTarget - yHero)
    self._heroAgent:setDirection(direction)
    self._mHeroX = xHero
    self._mHeroY = yHero
    self._oMHeroX = xHero
    self._oMHeroY = yHero

    -- 修改MapAgent的AgentSystem
    local mapAgent = AgentManager:getWorldAgent():getMapAgent()
    mapAgent:changeAgentMN(self._heroAgent, self._mTarget, self._nTarget)

    -- 总的位移距离
    self._directionVO = cc.pSub(cc.p(self._xTarget, self._yTarget), cc.p(self._oMHeroX, self._oMHeroY))

    -- 播放平移动画
    self._heroAgent:playAction(Constant.ROLE_ACTION_MOVE)
    self._heroActor:setNextFrameIndex(4)
    self._heroActor:updateFrame(true)

    self._showMultiple = true
    if self._skillId == lt.SkillEnum.MAGIC_RAPID_GLIDING then
        self._heroActor:setActionPause(true)
    end
end

function HeroStateRapidMove:getMapActor()
    local worldAgent = AgentManager:getWorldAgent()
    if not worldAgent then
        return nil
    end

    local mapAgent = worldAgent:getMapAgent()
    if not mapAgent then
        return nil
    end

    local mapActor = mapAgent:getMapActor()
    if not mapActor then
        return nil
    end

    return mapActor
end


function HeroStateRapidMove:createPhantom(phase,curIndex,isSecond)
    local addIndex = 0
    if isSecond then
        addIndex = 1
    end
    -- 创造影子
    local startPos = cc.p(self._heroAgent:getPosition())
    local phantom = self._heroActor:clone(phase+addIndex)  -- 克隆角色
    phantom:setAnchorPoint(0.5,0)
    self._xTarget, self._yTarget = MapUtil:calcMNMid(self._mTarget, self._nTarget)
    local offsetXY = self:getOffectXYByDirection(self._heroActor:getDirection())
    local offsetX = offsetXY.x*phase
    local offsetY = offsetXY.y*phase
    local offsetSinX = 0
    local offsetSinY = 0
    if self._skillId == lt.SkillEnum.MAGIC_BLOODY_ZENITH or self._skillId == lt.SkillEnum.SKILL_BLOODS_SYMPOSION then
        local function getDirectionFlag(value)
            return value > 0 and 1 or (value == 0 and 0 or -1)
        end

        local flagX = getDirectionFlag(offsetXY.x)
        local flagY = getDirectionFlag(offsetXY.y)

        offsetX = (phase ~= 0 and flagX * math.abs(self._directionVO.x) / self._fastMoveShadowMax * phase) or 0
        offsetY = (phase ~= 0 and flagY * math.abs(self._directionVO.y) / self._fastMoveShadowMax * phase) or 0

        curIndex = curIndex - 1
        if curIndex >= phase then
            offsetSinY = math.sin((curIndex - phase) * PI / self._fastMoveShadowMax) * self:checkHeight(math.sqrt(self._directionVO.x^2 + self._directionVO.y^2))
        end
    end
    phantom:setPosition(cc.p(startPos.x + offsetX + offsetSinX + 2, startPos.y + offsetY + offsetSinY - 2))
    phantom:setOpacity(100)  -- 设置透明度

    -- 添加到场景
    self:getMapActor():addPhantom(phantom)

    phantom:setVisible(self._heroActor:isVisible())
    -- phantom:setLocalZOrder(self._heroActor:getLocalZOrder()-10)
    table.insert(self._cloneActorArr, phantom)
end

function HeroStateRapidMove:onEnter()
end

function HeroStateRapidMove:onExit()
    -- if self._moveAction then
    --     self._heroActor:stopAction(self._moveAction)
    --     self._moveAction = nil
    -- end
    self:clearActorArr()
    self._heroActor:setActionPause(false)
end

function HeroStateRapidMove:onUpdate()
    self:clearActorArr()
    
    if self._isEnd then
        return
    end

    local directionV = cc.pSub(cc.p(self._xTarget, self._yTarget), cc.p(self._mHeroX, self._mHeroY))
    local disV = math.sqrt(directionV.x^2 + directionV.y^2)

    local disVO = math.sqrt(self._directionVO.x^2 + self._directionVO.y^2)
    local curIndex = self._fastMoveShadowMax - math.floor(disV/disVO*self._fastMoveShadowMax)
    
    if self._skillId == lt.SkillEnum.MAGIC_BLOODY_ZENITH or self._skillId == lt.SkillEnum.SKILL_BLOODS_SYMPOSION then
        local offsetSinY = math.sin((curIndex) * PI / self._fastMoveShadowMax ) * self:checkHeight(disVO)
        self._heroActor:setSpriteOffsetY(offsetSinY)
    end

    if not self._isEnd then
        local step = disVO / 0.2 * lt.GameBoard:getDeltaTime()
        if cc.pGetLength(directionV) < step then

            self._isEnd = true
            -- 到达
            self._heroAgent:setPosition(self._xTarget, self._yTarget)
            if self._skillId == lt.SkillEnum.MAGIC_RAPID_GLIDING then
                self._heroActor:setActionPause(false)
            end
            if self._skillId ~= lt.SkillEnum.MAGIC_BLOODY_ZENITH and self._skillId ~= lt.SkillEnum.SKILL_BLOODS_SYMPOSION then
                self._showMultiple = false
                self:clearActorArr()
                self:onUpdateFinalDir()
                self._heroAgent:changeState(lt.HeroStateIdle.new(self._heroAgent))
            else
                self._showMultiple = false
                self:clearActorArr()
                self:onUpdateFinalDir()
                self._heroActor:setSpriteOffsetY(nil)
                self._heroAgent:setPosition(self._xTarget, self._yTarget)
                self._heroAgent:changeState(lt.HeroStateIdle.new(self._heroAgent))
                -- self._heroAgent:playAction(Constant.ROLE_ACTION_ATTACK,self._skillId)
                -- 血之盛宴播放过程特效
                -- if self._skillId == lt.SkillEnum.SKILL_BLOODS_SYMPOSION then
                --     self._heroAgent:playParallelEffectByLv(self._skillId, 1, Constant.EFFECT.PROCESS)
                -- end
                -- self:onUpdateFinalDir()
                -- local delay = 0.5
                -- if self._heroActor and self._heroActor:getActionInfo() then
                --     delay = self._heroActor:getActionInfo():getStep() * self._heroActor:getActionInfo():getSpriteFrameCount() * self._heroAgent:getCurStepMultiple()
                -- end
                -- self._moveAction = cc.Sequence:create(cc.DelayTime:create(delay),cc.CallFunc:create(function()
                --     self._showMultiple = false
                --     self:clearActorArr()
                --     self:onUpdateFinalDir()
                --     self._heroActor:setSpriteOffsetY(nil)
                --     self._heroAgent:setPosition(self._xTarget, self._yTarget)
                --     self._heroAgent:changeState(lt.HeroStateIdle.new(self._heroAgent))
                -- end))
                -- self._heroActor:runAction(self._moveAction)
                -- self:checkCmd()
            end
            return
        else
            -- 未到
            directionV = cc.pMul(cc.pNormalize(directionV), step)
            self._mHeroX = self._mHeroX + directionV.x
            self._mHeroY = self._mHeroY + directionV.y
            self._heroAgent:setPosition(self._mHeroX, self._mHeroY)
        end
    end

    -----------------------------------------------------------------------------------------
    -- 快速滑行播放固定帧数
    if self._skillId == lt.SkillEnum.MAGIC_RAPID_GLIDING then
        if not self._frames then
            self._frames = 1
            self._heroActor:setNextFrameIndex(4)
            self._heroActor:updateFrame(true)
        else
            self._frames = self._frames + 1
            if self._frames == 5 or self._frames == 8 then
                self._heroActor:addNextFrameIndex(2)
                self._heroActor:updateFrame(true)
            elseif self._frames == 12 then
                self._heroAgent:playAction(Constant.ROLE_ACTION_IDLE)
                self._heroActor:updateFrame(true)
            elseif self._frames > 12 then
                -- 在群怪中，使用快速滑行卡死在HeroStateRapidMove 状态机无法出去
                yflog:Info("快速滑行脱离卡死")
                self:clearActorArr()
                self._heroAgent:changeState(lt.HeroStateIdle.new(self._heroAgent))
            end
        end
    end
    -----------------------------------------------------------------------------------------

    if self._showMultiple then
        for i = 1, self._fastMoveShadowMax do
            if self._isEnd then
                local nextFrameIndex = self._heroActor:getNextFrameIndex() - 1
                if nextFrameIndex <= 2 then
                    nextFrameIndex = 2
                elseif nextFrameIndex <= 4 then
                    nextFrameIndex = 4
                elseif nextFrameIndex <= 6 then
                    nextFrameIndex = 6
                elseif nextFrameIndex > 6 and nextFrameIndex < 9 then
                    nextFrameIndex = 8
                end
                
                if nextFrameIndex <= i and nextFrameIndex <= self._fastMoveShadowMax then
                    self:createPhantom(self._fastMoveShadowMax - i,curIndex,true)
                end
                if nextFrameIndex > (self._fastMoveShadowMax) then
                    self._showMultiple = false
                end
            else
                self:createPhantom(i,curIndex)
            end
        end
    end
end

function HeroStateRapidMove:checkCmd()
    if  not self._heroAgent:getIsSelf() then
        local cmd = self._heroAgent:getCmdSystem():get()
        if cmd then
            if cmd:getCmdId() == Constant.CmdId.CMD_JUMP then
                self._heroAgent:getCmdSystem():pop()
                self:initMove(cmd:getMNext(), cmd:getNNext())
            else
                self._heroAgent:getCmdSystem():pop()
                self._heroAgent:handleCmd(cmd)
            end
        else
            self._heroAgent:changeState(lt.HeroStateIdle.new(self._heroAgent))
        end
    end
end

function HeroStateRapidMove:onUpdateFinalDir()
    if self._mTarget == self._mAgentTarget and self._nTarget == self._nAgentTarget then
        return
    end
    -- 设置最终方向  面向怪方向
    local xHero, yHero = self._heroAgent:getPosition()
    local xAgentTarget, yAgentTarget = MapUtil:calcMNMid(self._mAgentTarget, self._nAgentTarget)
    local direction = MapUtil:calcDirectionXY(xAgentTarget - xHero, yAgentTarget - yHero)
    self._heroAgent:setDirection(direction)
end

function HeroStateRapidMove:clearActorArr()
    for _,v in ipairs(self._cloneActorArr or {}) do
        v:removeFromParent()
    end
    self._cloneActorArr = {}
end

function HeroStateRapidMove:checkHeight(height)
    local curHeight = height
    if curHeight > 100 then
        curHeight = 100
    end

    return curHeight
end

-- 根据方向获取偏移量
function HeroStateRapidMove:getOffectXYByDirection(direction)
    local offsetXY = cc.p(0,0)
    if direction == Constant.DIRECTION_LEFT then
        offsetXY = cc.p(32,0)
    elseif direction == Constant.DIRECTION_RIGHT then
        offsetXY = cc.p(-32,0)
    elseif direction == Constant.DIRECTION_DOWN then
        offsetXY = cc.p(0,32)
    elseif direction == Constant.DIRECTION_UP then
        offsetXY = cc.p(0,-32)
    elseif direction == Constant.DIRECTION_LEFT_DOWN then
        offsetXY = cc.p(15,15)
    elseif direction == Constant.DIRECTION_LEFT_UP then
        offsetXY = cc.p(15,-15)
    elseif direction == Constant.DIRECTION_RIGHT_DOWN then
        offsetXY = cc.p(-15,15)
    elseif direction == Constant.DIRECTION_RIGHT_UP then
        offsetXY = cc.p(-15,-15)
    end

    return offsetXY
end

function HeroStateRapidMove:onMessage(msg)
end

function HeroStateRapidMove:getStateId()
    return Constant.HERO_STATE_FAST_MOVE
end

function HeroStateRapidMove:getStateName()
    return "HeroStateRapidMove"
end

return HeroStateRapidMove