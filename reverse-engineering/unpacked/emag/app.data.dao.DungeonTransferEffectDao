local DungeonTransferEffectDao = {}

function DungeonTransferEffectDao:queryAll()
    local table = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM DungeonTransferEffect")) do
        local meta = lt.DungeonTransferEffectMeta.new(row)
        table[meta:getSpkId()] = meta
    end
    return table
end

return DungeonTransferEffectDao
    