
local ModelMeta = class("ModelMeta")



function ModelMeta:ctor(row)
	self:initWithRow(row)
end

function ModelMeta:initWithRow(row)
    self._id            = row.Id
    self._name          = row.ModName
    self._atlasCount    = row.AtlasCount
    self._radius        = row.Radius
    self._height        = row.Height
    self._offsetX       = row.OffsetX
    self._offsetY       = row.OffsetY
    self._moveInterval  = row.MoveInterval/1000
    self._attackTime    = row.AttackTime
    self._deadRadius    = row.dead_radius
    self._deadHeight    = row.dead_height
    self._deadOffsetX   = row.dead_offsetX
    self._deadOffsetY   = row.dead_offsetY
    self._nameOffsetY   = row.NameOffsetY or 0

    -- 以下未使用
    -- self._bornAudio     = row.BornAudio
    -- self._attackAudio   = row.AttackAudio
    -- self._hitAudio      = row.HitAudio
    -- self._dieAudio      = row.DieAudio
    -- self._directionNum  = row.DirectionNum 
    -- self._deathActionNum = row.DeathNum          --临死和死亡动作朝向数
    -- self._showShadow    = row.Shadow or 0
    -- self._npcScale      = row.Scale or 10000
end

-- AUTO GENERATED GETTERS START
-- 以下方法由脚本自动生成，请勿手动修改

function ModelMeta:getId() return self._id end
function ModelMeta:getName() return self._name end
function ModelMeta:getRadius() return self._radius end
function ModelMeta:getAtlasCount() return self._atlasCount end
function ModelMeta:getHeight() return self._height end
function ModelMeta:getNameOffsetY() return self._nameOffsetY end
function ModelMeta:getOffsetX() return self._offsetX end
function ModelMeta:getOffsetY() return self._offsetY end
function ModelMeta:getMoveInterval() return self._moveInterval end
function ModelMeta:getAttackTime() return self._attackTime end
function ModelMeta:getDeadRadius() return self._deadRadius end
function ModelMeta:getDeadHeight() return self._deadHeight end
function ModelMeta:getDeadOffsetX() return self._deadOffsetX end
function ModelMeta:getDeadOffsetY() return self._deadOffsetY end

-- AUTO GENERATED GETTERS END
return ModelMeta
