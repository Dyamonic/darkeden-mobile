
local EnchantingAffixMeta = class("EnchantingAffixMeta")
local Constant = lt.Constant

function EnchantingAffixMeta:ctor(row)
    self._id            = row.idxId
    self._type          = row.Type
    self._affixClass    = row.AffixClass
    self._displayName   = row.DisplayName
    self._baseValue     = row.BaseValue
    self._preValue      = row.AddValuePreLevel
    self._maxValue      = row.MaxLevel
    self._color         = row.Color
    local colorArray    = string.split(self._color, ",")
    if #colorArray == 3 then
        self._glColor = cc.vec3(colorArray[1] / 255, colorArray[2] / 255, colorArray[3] / 255 )
    end 
end

function EnchantingAffixMeta:getId()
    return self._id
end

function EnchantingAffixMeta:getType()
    return self._type
end

function EnchantingAffixMeta:getAffixClass()
    return self._affixClass
end

function EnchantingAffixMeta:getDisplayName()
	return self._displayName
end

function EnchantingAffixMeta:getBaseValue()
	return self._baseValue
end

function EnchantingAffixMeta:getValuesPreLevel()
	return self._preValue
end

function EnchantingAffixMeta:getAffixMaxLevel()
	return self._maxValue
end

function EnchantingAffixMeta:getColor()
    return self._glColor or Constant.DEFALUT_CLOTH_COLOR
end

return EnchantingAffixMeta
