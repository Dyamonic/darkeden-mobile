local FGUIRichText = class("FGUIRichText",function()
    return fgui.GRichTextField:create()
end)

local COLORS = {
    white = "#FFFFFF", -- white
    green = "#00FF00", -- green
    blue = "#0000FF", -- blue
    black = "#000000", -- black
    yellow0 = "#E8C800", -- yellow
    red = "#FF0000", -- red
    orange = "#FF8000", -- Orange
    purple = "#FF00FF", -- Purple
    gray = "#C0C0C0", -- Gray
    gold = "#FFFF00",
    lightyellow = "#FFDD00", -- yellow
    pressBtn = "#FF0000", -- press按钮
    title = "#D69A7B", -- press按钮
    text = "#BE8C6E",    --
    purple2 = "#c6c3ff", --道具tips key的颜色

    yellow = "#ffff00",
    red2 = "#ff5152",
    yellow2 = "#ff8242",
}
local DEFUAL_COLOR = "#FFFFFF"

local defaultOutlineColor = cc.c3b(0, 0, 0)
local defaultFontSize = 22
local isUBB = true

function FGUIRichText:ctor(param)
    self:setFontSize(param.fontSize or defaultFontSize)
    self:setOutlineColor(param.outlineColor or defaultOutlineColor)
    self:setUBBEnabled(param.isUBB or isUBB)
    self:setAutoSize(param.autoSizeType or fgui.AutoSizeType.HEIGHT)
    if not param.size then
        param.size = cc.size(500, 500)
    end
    self:setSize(param.size.width, param.size.height)
    local text = self:parseRichText(param.textTable)
    self:setText(text)
    self:addEventListener(fgui.UIEventType.ClickLink, function(context)
        if param.clickLink then
            param.clickLink(context)
        end
    end);
end


function FGUIRichText:setContent(textTable)
    local text = self:parseRichText(textTable)
    self:setText(text)
end


---兼容旧的解析格式
function FGUIRichText:parseRichText(textTable)
    local richText = ""
    for _,textInfo in ipairs(textTable) do
        local color = textInfo.color or DEFUAL_COLOR
        if COLORS[textInfo.color] then
            color = COLORS[textInfo.color]
        end 
        local parseTxt = ""
        if textInfo.oType == "wrap" then
            parseTxt =  "<br/>"
        elseif textInfo.oType == "font" then
            parseTxt = string.format("[size=%s][color=%s]%s[/color][/size]", textInfo.fontSize or defaultFontSize,  COLORS[textInfo.color] or DEFUAL_COLOR, textInfo.content)
            
            if textInfo.unLine then
                parseTxt = string.format("[color=%s][u]%s[/u][/color]⊡⊡", color, textInfo.clickName, textInfo.content)
            end
            if textInfo.button then
                parseTxt = string.format("[color=%s][u][url=%s]%s[/url][/u][/color]⊡⊡",color, textInfo.command, textInfo.content)
            end
        elseif textInfo.oType == "img" then
            parseTxt = string.format("[img]%s[/img]", textInfo.content)
        end
        richText = richText .. parseTxt
    end
    return richText
end


--TODO 纯英文不换行问题
function FGUIRichText:wrapText(text, maxWidth, fontSize, fontName)
    local words = {}
    for word in string.gmatch(text, "%S+") do
        table.insert(words, word)
    end

    local wrappedText = ""
    local currentLine = ""

    for _, word in ipairs(words) do
        local testLine = currentLine .. (currentLine ~= "" and " " or "") .. word
        local label = fgui.GBasicTextField:create(testLine, fontSize)
        label:setFontSize(fontSize) -- 字体大小
        label:setText(testLine)

        if label:getSize().width > maxWidth then
            if currentLine ~= "" then
                wrappedText = wrappedText .. currentLine .. "\n"
            end
            currentLine = word
        else
            currentLine = testLine
        end
    end

    if currentLine ~= "" then
        wrappedText = wrappedText .. currentLine
    end

    return wrappedText
end

