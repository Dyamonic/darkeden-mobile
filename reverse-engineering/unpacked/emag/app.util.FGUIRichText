function FGUIRichText:supportImage(url)
    return {
        oType = "img",
        content = url,
    }
end

function FGUIRichText:newLine()
    return {
        oType = "wrap",
    }
end

function FGUIRichText:newText(text)
    return {
        oType = "font",
        content = text
    }
end

function FGUIRichText:clear()
    self:removeFromParent()
end

return FGUIRichText