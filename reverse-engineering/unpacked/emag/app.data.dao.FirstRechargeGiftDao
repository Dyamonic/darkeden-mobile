local FirstRechargeGiftDao = {}

function FirstRechargeGiftDao:queryAll()
    local table = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM FirstRechargeGift")) do
        local meta = lt.FirstRechargeGiftMeta.new(row)
        table[meta:getId()] = meta
    end
    return table
end

return FirstRechargeGiftDao
