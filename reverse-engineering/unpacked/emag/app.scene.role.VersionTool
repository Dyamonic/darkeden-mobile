local VersionTool = class("VersionTool")
local LAUNCHER_VERSION_TXT = "version.txt"
local GAME_MAP_TXT = "res_map.txt"
--- 游戏使用
function VersionTool:isGameInstall(gameType)
	if not gameType then
		return false
	end

	local status = cc.UserDefault:getInstance():getIntegerForKey("GAME_STARTER_GAME_INSTALL_"..gameType, 0)
	if status == 0 then
		local resPath = gameType .. "/res_map.txt"
		if cc.FileUtils:getInstance():isFileExist(resPath) then
			status = 1
		else
			status = 2
		end
		cc.UserDefault:getInstance():setIntegerForKey("GAME_STARTER_GAME_INSTALL_"..gameType, status)
		cc.UserDefault:getInstance():flush()
	end

	return status == 1
end

function VersionTool:getLocalGameVersion()
	return io.readfile(self:getLocalGameVersionPath())
end

function VersionTool:getLocalLauncherVersionPath()
	local path = device.writablePath
	if device.platform == "mac" or device.platform == "windows" then
		path = path .. "download/"
	end

	local filePath = path .. LAUNCHER_VERSION_TXT
	if not io.exists(filePath) then
		cc.FileUtils:getInstance():createDirectory(path)

		local fullPath = cc.FileUtils:getInstance():fullPathForFilename(LAUNCHER_VERSION_TXT)
		local dataFromFile = cc.FileUtils:getInstance():getDataFromFile(fullPath)

		local file = io.open(filePath, "w+b")
        file:write(dataFromFile)
        file:close()
	end

	return filePath
end

function VersionTool:getLocalLauncherVersion()
	return io.readfile(self:getLocalLauncherVersionPath())
end

function VersionTool:getLocalGameVersionPath()
	local gameType = _G_GAME_INFO and _G_GAME_INFO.type
    if not gameType then
		gameType = "win32"
	end

	local path = device.writablePath
	if device.platform == "mac" or device.platform == "windows" then
		path = path .. "download/"
	end
	path = path .. gameType .. "/"


	local filePath = path .. LAUNCHER_VERSION_TXT
	if not io.exists(filePath) then
		cc.FileUtils:getInstance():createDirectory(path)

		local fullPath = cc.FileUtils:getInstance():fullPathForFilename(gameType .. "/" .. LAUNCHER_VERSION_TXT)
		local dataFromFile = cc.FileUtils:getInstance():getDataFromFile(fullPath)

		local file = io.open(filePath, "w+b")
        file:write(dataFromFile)
        file:close()
	end

	return filePath
end
return VersionTool