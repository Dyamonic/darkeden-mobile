
local RoleModule = {}

local RoleData = lt.RoleData
local SocketApi = lt.SocketApi
local cliggproto = lt.CliGgProto
local CacheManager = lt.CacheManager
local Constant = lt.Constant

RoleModule._select    = nil
RoleModule._roleArray = nil
RoleModule._roleCount = nil
RoleModule._delRoleArray = nil

RoleModule._recoverIndex = nil

RoleModule._curRoleName = nil

function RoleModule:init()
    self._select = 0
    self._curPage = 0
    self._roleArray = {}
    self._delRoleArray = {}
    self._roleCount = 0 
    self._recoverIndex = 0
    self._inviteCode = ""
    self._pid = ""
    self._scaleRole =  CacheManager:getVariableById(Constant.Variable.ScaleRole) or 1.1
end

function RoleModule:clear()
    self._select    = 0
    self._curPage = 0
    self._roleArray = {}
    self._delRoleArray = {}
    self._roleCount = 0
    self._recoverIndex = 0
    self._inviteCode = nil
end

function RoleModule:refreshData(data)
    if data then
    	self:clear()
        self._select = (data._bySelect or 0) + 1
        self._curPage = math.ceil(self._select / 2) - 1
        self._roleCount = data._byRoleCount or 0
        if data._astRoleList then
            for i,v in ipairs(data._astRoleList) do
                local roleData = RoleData.new()
                roleData:addRole(v)

                local rolePos = roleData:getRolePos()
                if rolePos then
                    if roleData:getDelete() ~= 1 then
                        self._roleArray[rolePos] = roleData
                    else
                       table.insert(self._delRoleArray,roleData)
                    end
                end
            end
        end
    end
end

function RoleModule:deletRole(index)
	if self._roleArray[index] then
		local role = self._roleArray[index]
		role:setDelete(1)
		local date = os.date("%Y-%m-%d %H:%M:%S");
		role:setDltTime(date)
		table.insert(self._delRoleArray, role)
		-- table.remove(self._roleArray, index)
        self._roleArray[index] = nil
	end

    self._select = math.min(#self._roleArray, self._select)
    self._curPage = math.ceil(self._select / 2) - 1
end

function RoleModule:recoverRole()
	if self._delRoleArray[self._recoverIndex] then
		local role = self._delRoleArray[self._recoverIndex]
		role:setDelete(0)
		role:setDltTime(0)
		table.insert(self._roleArray, role)
		table.remove(self._delRoleArray, self._recoverIndex)
		self._recoverIndex = 0
	end
    -- recover成功后选中恢复的角色
    self._select = #self._roleArray
    self._curPage = math.ceil(self._select / 2) - 1
end


function RoleModule:setSelect(select)
    self._select = select
end

function RoleModule:getSelect()
	return self._select 
end

function RoleModule:getRoleCount()
	return self._roleCount
end

function RoleModule:getRoleArray()
    return self._roleArray
end

function RoleModule:getOwnRoleCount()
    return #self._roleArray
end

function RoleModule:getDelRoleArray()
    return self._delRoleArray
end

function RoleModule:isDelRoleLimit()
    return #self._delRoleArray > 3
end

function RoleModule:isHaveRole()
    return self._roleArray and #self._roleArray > 0
end

function RoleModule:setInviteCode(inviteCode)
    self._inviteCode = inviteCode
end

function RoleModule:getInviteCode()
    return self._inviteCode
end

function RoleModule:hasInviteCode()
    return self._inviteCode and self._inviteCode ~= ""
end

---------------------------------Socket--------------------------------------------------------

-- 选角色请求--
function RoleModule:selectRoleReq(szRoleName)
    local selchr = cliggproto.PKG_CLI_GG_SelectRole_REQ.new()
    selchr._szRoleName = szRoleName
    local data = cliggproto:encode(cliggproto.MessageID.CLI_GG_SelectRole_REQ, selchr)
    SocketApi:_sendData(data, #data)
end

-- 创建角色请求--
function RoleModule:createRoleReq(param)
    local createchr = cliggproto.PKG_CLI_GG_CreateRole_REQ.new()
	createchr._szRoleName = param.szRoleName
    createchr._byPos = param.byPos
	createchr._byRace = param.byRace
	createchr._bySex = param.bySex
	createchr._byFaceShape = param.byFaceShape
	createchr._byHairColor = param.byHairColor
	createchr._bySkinColor = param.bySkinColor
	createchr._wSTR = param.wSTR
	createchr._wDEX = param.wDEX
	createchr._wINT = param.wINT
	createchr._szInvite = param.szInvite

    local data = cliggproto:encode(cliggproto.MessageID.CLI_GG_CreateRole_REQ,createchr)
    SocketApi:_sendData(data,#data)
end

-- 删除角色请求--
function RoleModule:deleteRoleReq(szRoleName)
    local delchr = cliggproto.PKG_CLI_GG_DelRole_REQ.new()
    delchr._szRoleName = szRoleName
    local data = cliggproto:encode(cliggproto.MessageID.CLI_GG_DelRole_REQ,delchr)
    SocketApi:_sendData(data,#data)
end

-- 恢复角色请求--
function RoleModule:unDeleteRoleReq(szRoleName)
    local undelchr = lt.CliGgProto.PKG_CLI_GG_UnDelRole_REQ.new()
    undelchr._szRoleName = szRoleName
    local data = lt.CliGgProto:encode(lt.CliGgProto.MessageID.CLI_GG_UnDelRole_REQ,undelchr)
    SocketApi:_sendData(data,#data)
end

-- 登出消息
function RoleModule:logoutReq()
    local logout = cliggproto.PKG_CLI_GG_Logout_NTF.new()
    local data = cliggproto:encode(cliggproto.MessageID.CLI_GG_Logout_NTF,logout)
    SocketApi:_sendData(data,#data)
end

-- Setter && Getter
function RoleModule:setCurRoleName(curRoleName)
    self._curRoleName = curRoleName
end

function RoleModule:getCurRoleName()
    return self._curRoleName
end

function RoleModule:getCurRoleCreateTime()
    local roleData = self:getCurRole()
    if not roleData then
        return ""
    end
    
    return roleData:getCreateTime()
end

function RoleModule:getCurRole()
    if not self._curRoleName then
        return nil
    end

    for _, roleData in ipairs(self._roleArray) do
        if roleData:getName() == self._curRoleName then
            return roleData
        end
    end

    return nil
end

function RoleModule:getCreateTimeByPlayerId(playerId)
    if not playerId then
        return os.time()
    end
    for _, roleData in ipairs(self._roleArray) do
        if roleData:getPlayerId() == playerId then
            return lt.CommonUtil:string2time(roleData:getCreateTime())
        end
    end
    return os.time()
end

function RoleModule:getMaxRoleNum()
    return 4
end

function RoleModule:getNumEachPage()
    return 2
end

function RoleModule:setCurPage(page)
    local maxPage = math.ceil(#self._roleArray / 2) - 1
    page = page > maxPage and 0 or page
    page = page < 0 and maxPage or page

    self._curPage = page
    -- self._select = page * self:getNumEachPage() + 1
end

function RoleModule:getCurPage()
    return self._curPage
end

function RoleModule:setPID(pid)
    self._pid = pid
end
function RoleModule:getPID()
    return self._pid
end

function RoleModule:getCurrentPos()
    local roleArray = RoleModule:getRoleArray()
    if table.nums(roleArray) == 0 then
        return 1
    end
    local filter = {1, 2, 3}
    for key, roleData in pairs(roleArray) do
        local rolePos = roleData:getRolePos()
        if rolePos ~= 0 then
            table.removebyvalue(filter, rolePos)
        end
    end
    return filter[1] or 1
end

function RoleModule:getScaleRole()
    return self._scaleRole
end

--------------------------------------------------------------------------
--- 角色临时数据组装
-- 选角
function RoleModule:createSelectHeroData(objectId, roleModelInfo)
    -- 后续数据自行扩展
    local objprops = {
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_Race,       intValue = roleModelInfo.race },
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_Gender,     intValue = roleModelInfo.gender or 0 },
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_HairColor,  intValue = roleModelInfo.hair },
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_SkinColor,  intValue = roleModelInfo.skin },
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_FaceShape,  intValue = roleModelInfo.faceShape },
    }

    local heroData = lt.HeroData.new(objectId, objprops)

    return heroData
end

-- 创角
function RoleModule:createHeroData(objectId, roleModelInfo)
    -- 后续数据自行扩展
    local objprops = {
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_Race,         intValue = roleModelInfo.race },
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_Gender,       intValue = roleModelInfo.gender or 0 },
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_HairColor,    intValue = roleModelInfo.hair },
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_SkinColor,    intValue = roleModelInfo.skin },
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_FaceShape,    intValue = roleModelInfo.faceShape },
        { properCode = lt.ServerClientEnum.PlayerValueDef.Attr_AdvanceState,   intValue = roleModelInfo.advanced or 0 },
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_WeaponAppr,   strValue = roleModelInfo.weaponAppr   or "0,0,0" },
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_Shield,       strValue = roleModelInfo.shieldAppr   or "0,0,0" },
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_Helmet,       strValue = roleModelInfo.helmetAppr   or "0,0,0" },
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_BodyAppr,     strValue = roleModelInfo.bodyAppr     or "0,0,0"},
        { properCode = lt.ServerClientEnum.CreatureValueDef.Attr_Trousers,     strValue = roleModelInfo.trousersAppr or "0,0,0" },
    }

    local heroData = lt.HeroData.new(objectId, objprops)

    return heroData
end


function RoleModule:getSelectRoleInfo()
    local roleArray = RoleModule:getRoleArray()
    local idx = RoleModule:getSelect()
    return roleArray[idx]
end

return RoleModule
