local FGUIUtil = class("FGUIUtil")

FGUIUtil.URL_PREFIX = "ui://";

function FGUIUtil:normalizeURL(url)
    if not url or url == "" then
        return url
    end

    local pos1 = string.find(url, "/")
    if not pos1 then
        return url
    end

    local tmp = string.sub(url, pos1 + 2)
    local pos2 = string.find(tmp, '/')
    if pos2 == nil then
        return url
    else
        local pkgName = string.sub(tmp, 1, pos2 - 1)
        local resName = string.sub(tmp, pos2 + 1)
        return pkgName, resName
    end

end

function CC_SAFE_RELEASE(obj)
    if obj and not tolua.isnull(obj) then
        obj:release()
    end
end


function CC_SAFE_RETAIN(obj)
    if obj and not tolua.isnull(obj) then
        obj:retain()
    end
end

function FGUIUtil:cocosPosToFGui(pos)
    return cc.p(pos.x,  pos.y - display.height) ;
end


function FGUIUtil:fGuiPosToCocos(pos)
    return cc.p(pos.x,  pos.y + display.height) ;
end

function FGUIUtil:checkItemByURL(url)
    if DEBUG > 0 then
        local checkUrlItem  = fgui.UIPackage:hasItemByURL(url) --仅调试模式使用
        assert(checkUrlItem, string.format("[error] function 'fgui.checkItemByURL' url:[%s] is not exist, fix path correct.", url))
    end
end

function FGUIUtil:getImageNameByPath(filePath)
    local filename = string.match(filePath, "([^/]+)%.png$")
    return filename
end

---添加包围盒（用于开发调试）
---@param obj fgui.GObject
---@param pos cc.Value
---@param size cc.size
function FGUIUtil:drawBoundingBox(obj,pos, size)
    if not pos then pos = cc.p(0, 0) end
    if not size then size = obj:getSize() end
    local graph = fgui.GGraph:create();
    graph:setPosition(pos.x, pos.y);
    graph:drawRect(size.width, size.height, 1, cc.c4f(1,0,0,1), cc.c4f(1,0,0,0));
    graph:setTouchable(false)
    obj:addChild(graph);
end

---添加点（用于开发调试）
---@param obj fgui.GObject
---@param pos cc.Value
function FGUIUtil:drawPoint(obj,pos)
    if not pos then pos = cc.p(0, 0) end
    local graph = fgui.GGraph:create();
    graph:setPosition(pos.x, pos.y);
    graph:drawRect(10, 10, 1, cc.c4f(1,0,0,1), cc.c4f(1,0,0,1));
    graph:setTouchable(false)
    obj:addChild(graph);
end

---cocos 添加点
function FGUIUtil:drawCocosPoint(obj, pos)
    local drawNode = cc.DrawNode:create()
    if not pos then pos = cc.p(0, 0) end
    drawNode:drawPoint(pos, 10, lt.Constant.COLOR_4F_GREEN_H)
    -- drawNode:setEnabled(false)
    obj:addChild(drawNode)
end

--cocos 添加矩形
function FGUIUtil:drawCocosRect(obj, pos, size)
    if not pos then pos = cc.p(0, 0) end
    if not size then size = obj:getContentSize() end
    local drawNode = cc.DrawNode:create()
    drawNode:drawRect(pos, cc.p(size.width, size.height), lt.Constant.COLOR_4F_GREEN_H)
    obj:addChild(drawNode)
end


return FGUIUtil