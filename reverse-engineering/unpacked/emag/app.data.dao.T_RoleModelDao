
local RoleModelDao = {}
--[[
    角色外观表.xlsx
]]

function RoleModelDao:queryAll()
    local tb = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM RoleModel;") do
        local model = lt.RoleModelMeta.new(row)
        tb[model:getModleKey()] = model
        tb[model:getModleSKey()] = model
    end
    return tb
end

return RoleModelDao
