function MainUILayer:btnSwitchClick()
    local curIndex = self._switchFunc:getSelectedIndex()
    local layerManager = display.getRunningScene():getLayerManager()
    layerManager:getControlLayer():setSkillShowControl(curIndex)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MAINLAYER_SWITCH, {idx = curIndex})

    if curIndex == 0 then
        self._comFunc:refreshTimer()
    end
end

function MainUILayer:switchBattle()
    local battleIndex = 1
    self._switchFunc:setSelectedIndex(battleIndex)
    local layerManager = display.getRunningScene():getLayerManager()
    layerManager:getControlLayer():setSkillShowControl(battleIndex)
    local curIndex = self._switchFunc:getSelectedIndex()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MAINLAYER_SWITCH, {idx = curIndex})
end

function MainUILayer:onReselRole(event)
    lt.LogUtil:debugInfo("MainUILayer:onReselRole")
    local data = event.param
    if data and data._byResult == lt.CliGgProto.PROTO_SUCCESS then
        -- 角色注销
        GameModule:reset()

        lt.RoleModule:refreshData(data._stReply)

        local roleScene = lt.RoleScene.new()
        display.runScene(roleScene)
    end
end

--新队伍监听弹出队伍界面
function MainUILayer:newTeamChange()
    self._showBtn:setSelected(false)
    self._showTaskController:setSelectedIndex(0)
    self._compTask:changeSelectedIdx(Constant.LEFT_CORNER.TEAM)
end

--设置修改
function MainUILayer:changeSettings(params)
    local param = params.param or {}
    local index = param.index
    if index == Constant.SETTINGS_TYPES.MUSIC_SOUND or index == Constant.SETTINGS_TYPES.EFFECT_SOUND then -- 音乐 音效 刷新
        AudioManager:reloadConfig()
    elseif index == Constant.SETTINGS_TYPES.LEFT_OFFSET then -- 左侧屏幕边缘偏移
        self:refreshLeftUIOffset(index)
    elseif index == Constant.SETTINGS_TYPES.RIGHT_OFFSET then -- 右侧屏幕边缘偏移
        self:refreshRightUIOffset(index)
    elseif index == Constant.SETTINGS_TYPES.SHOW_PING then -- ping值
        local isOpen = lt.AutoFightManager:getPingValueOpen()
        self._pingText:setVisible(isOpen)
    end
end

function MainUILayer:refreshPingVisible()
    local isOpen = lt.AutoFightManager:getPingValueOpen()
    self._pingText:setVisible(isOpen)
end

-- 左侧屏幕边缘偏移
function MainUILayer:refreshLeftUIOffset(index)
    local race = GameModule:getHeroRace() or 1
    local leftUITable = {
        "compTask",       -- 任务
        "btnShow",        -- 任务切换按钮
        "compHP" .. race,
        -- "CompDur".. race,
    }

    lt.AutoFightManager:refreshLeftUIOffset(leftUITable,self._view,index)
end

-- 右侧屏幕边缘偏移
function MainUILayer:refreshRightUIOffset(index)
    local rightUITable = {
        "btnSwitch",      -- 切换按钮
        "comFunc",        -- 功能界面
        "btnShowMiniMap", -- 小地图切换按钮
    }

    lt.AutoFightManager:refreshRightUIOffset(rightUITable,self._view,index)
end

function MainUILayer:onChangeVip()
    local isShow = FunctionToggleModule:checkEnterVisible(FunctionToggleModule.FunctionHelpId.VIP)
    self._btnVip:setVisible(isShow)
    self:refreshPrivilegeBtn()
end

--根据等级开启的功能入口
function MainUILayer:onLevelChange()
    self:onChangeVip()
    self:onChangeSevenDay()
    self:refreshWelfareGiftBtnsRedTips()
    self:refreshDayGiftBtnsRedTips()
    self:onChangeRankBtton()
    self:refreshAdvanceTaskBtn()
    self:refreshMonthCardBtn()
    self:refreshEnergyBtn()
    self:refreshDayTaskBtn()
    self:refreshActivityBtn()
    self:refreshShopPing()
    --
    self:refreshAllBtnPos()
end

function MainUILayer:refreshAllBtnPos()
    self:refreshTopBtnPos()
    self:refreshSecondBtnPos()
end

function MainUILayer:refreshTopBtnPos()
    local nodeActivity = self._view:getChild("node_activity")
    local pos = nodeActivity:getPosition()
    local index = 0
    for k,v in ipairs(topBtnArray) do
        local target = self._view:getChild(v.name)
        if target and target:isVisible() then
            index = index + 1
            target:setPosition(pos.x - (index-1) * 56 + 160, 0)
        end
    end
end

function MainUILayer:refreshDayTaskBtn()
    local isShow = FunctionToggleModule:checkEnterVisible(FunctionToggleModule.FunctionHelpId.DayTask)
    self._btnDailyTask:setVisible(isShow)
end

function MainUILayer:refreshActivityBtn()
    local isShow = FunctionToggleModule:checkEnterVisible(FunctionToggleModule.FunctionHelpId.Activity)
    self._btnActivity:setVisible(isShow)
end
function MainUILayer:refreshShopPing()
    local isShow = FunctionToggleModule:checkEnterVisible(FunctionToggleModule.FunctionHelpId.Mall)
    self._btnShopping:setVisible(isShow)
end

function MainUILayer:refreshSecondBtnPos()
    local nodeActivity = self._view:getChild("node_activity")
    local pos = nodeActivity:getPosition()
    local index = 0
    for k,v in ipairs(secondBtnArray) do
        local target = self._view:getChild(v.name)
        if target and target:isVisible() then
            index = index + 1
            local offsetY = math.ceil(index/4)*60
            local indexX = (index-1)%4
            target:setPosition(pos.x - (indexX) * 56 + 160, offsetY)
        end
    end
end

--刷新特权按钮显示
function MainUILayer:refreshPrivilegeBtn()
    self._btnPrivilege:setVisible(self._btnVip:isVisible() or self._btnMonthCard:isVisible())
end

function MainUILayer:onChangeSevenDayNtf()
    self:onChangeSevenDay()
    self:refreshSecondBtnPos()
end

function MainUILayer:refreshDayGiftBtnsRedTipsNtf()
    self:refreshDayGiftBtnsRedTips()
    self:refreshSecondBtnPos()
    self:refreshWelfareGiftBtnsRedTips()
end

function MainUILayer:onChangeSevenDay()
   local open = FunctionToggleModule:checkEnterVisible(FunctionToggleModule.FunctionHelpId.SevenDayEvent)
   if not open then
        self._btnSeven:setVisible(false)
        return
   end
   local list =  lt.SevenDayModule:getSevenDayListInfo()
   self._btnSeven:setVisible(#list>0)
end

function MainUILayer:onChangeRankBtton()
    local open = FunctionToggleModule:checkEnterVisible(FunctionToggleModule.FunctionHelpId.Rank)
    if not open then
        self._btnRank:setVisible(false)
        return
    end
    self._btnRank:setVisible(true)
end

function MainUILayer:onChangeTriggerGiftNtf()
    self:onChangeTriggerGift()
    self:refreshSecondBtnPos()
end

function MainUILayer:onChangeTriggerGift()
    local open = FunctionToggleModule:checkEnterVisible(FunctionToggleModule.FunctionHelpId.TriggerGift)
    if not open then
        self._btnTriggerGift:setVisible(false)
        return
    end
   local length =  lt.TriggerGiftModule:onGetTriggerGiftTableLength()
   self._btnTriggerGift:setVisible(length>0)
end

--显示复活界面
function MainUILayer:showRevive()
    self._reviveAnim:play()
    self._comRevive:refreshView()
    self._comRevive:setVisible(true)
end

function MainUILayer:uptRedDotEvt(event)
    local param = event.param
    if param.name == "VipRedTips"
    or string.find(param.name, "RechargeRedTips"..Constant.ACTIVITY_RED_TYPE.MONTHCARD) then
        --vip红点
        local isShowRedDot1 = lt.VipModule:getRedPoint()
        self._btnVip:getChild("red"):setVisible(isShowRedDot1)
        --月卡红点
        local isShowRedDot2 = lt.RechargeModule:getRedPoint(Constant.ACTIVITY_RED_TYPE.MONTHCARD)
        self._btnMonthCard:getChild("red"):setVisible(isShowRedDot2)
        --特权红点
        local isShowRedDot = isShowRedDot1 or isShowRedDot2
        self._btnPrivilege:getChild("red"):setVisible(isShowRedDot)
    elseif string.find(param.name, "SkillRedTips") or param.name == "GuildApplyRedTips" then
        --角色红点
        local isShowRedDot = SkillModule:getRedPoint() or lt.GuildModule:getRedPoint()
        self._btnSwitch:getChild("reddot"):setVisible(isShowRedDot)
        self._btnRole:getChild("reddot"):setVisible(SkillModule:getRedPoint())
    elseif string.find(param.name, "SevenDayTaskRewardTips") 
        or string.find(param.name, "SevenDayTaskRedTips") 
        or param.name == "SevenDayTaskBoxTips" then 
        local isShowRedDot = lt.SevenDayModule:getRedPointAll()
        self._btnSeven:getChild("red"):setVisible(isShowRedDot)
    elseif string.find(param.name, "TaskTypeRedTips") or string.find(param.name, "TaskBoxTypeRedTips") then 
        local isShowRedDot = lt.TaskModule:getRedPointAll()
        self._btnDailyTask:getChild("red"):setVisible(isShowRedDot)
    elseif string.find(param.name, "WorldBossRedTips") then
        --活动红点
        local isShowRedDot = HolyFightModule:getRedPoint()
        self._btnActivity:getChild("red"):setVisible(isShowRedDot)
    end
end

--刷新自动战斗动画
function MainUILayer:startAutoFight()
    self._autoAnim:setVisible(true)
    self._autoTrans:setVisible(true)
end

function MainUILayer:endAutoFight()
    self._autoAnim:setVisible(false)
    self._autoTrans:setVisible(false)
end

--检测提升数据
function MainUILayer:refreshImproveTips()
    if self._compImprove:isVisible() then
        self._mask:setVisible(false)
        self._compImprove:setVisible(false)
        return
    end
    local improveList = {}
    --属性点
    if SkillModule:getRedPoint(Constant.ROLE_MAINIDX.ROLE) then
        local tb = {}
        tb.name = GReadText.KEY_IMPROVE_TIPS1
        tb.func = function()
            GameModule:gotoSystemFunc(FunctionToggleModule.FunctionHelpId.Character)
            self._mask:setVisible(false)
            self._compImprove:setVisible(false)
        end
        table.insert(improveList, tb)
    end
    --技能可学习
    if SkillModule:getRedPoint(Constant.ROLE_MAINIDX.MAGIC) then
        local tb = {}
        tb.name = GReadText.KEY_IMPROVE_TIPS2
        tb.func = function()
            GameModule:gotoSystemFunc(FunctionToggleModule.FunctionHelpId.Skill)
            self._mask:setVisible(false)
            self._compImprove:setVisible(false)
        end
        table.insert(improveList, tb)
    end
    --低级阶级技能可学习
    if SkillModule:getRedPoint(Constant.ROLE_MAINIDX.LOWCLS) then
        local tb = {}
        tb.name = GReadText.KEY_IMPROVE_TIPS3
        tb.func = function()
            GameModule:gotoSystemFunc(FunctionToggleModule.FunctionHelpId.ClassSkill)
            self._mask:setVisible(false)
            self._compImprove:setVisible(false)
        end
        table.insert(improveList, tb)
    end
    --高级阶级技能可学习
    if SkillModule:getRedPoint(Constant.ROLE_MAINIDX.SUPERCLS) then
        local tb = {}
        tb.name = GReadText.KEY_IMPROVE_TIPS4
        tb.func = function()
            GameModule:gotoSystemFunc(FunctionToggleModule.FunctionHelpId.AdvancedClassSkill)
            self._mask:setVisible(false)
            self._compImprove:setVisible(false)
        end
        table.insert(improveList, tb)
    end
    --装备可升级
    if StrengthenModule:getRedPoint(Constant.STRENGTHEN_TYPE.LEVELUP) then
        local open, tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.EquipmentUpgradeSubpage)
        if open then
            local tb = {}
            tb.name = GReadText.KEY_IMPROVE_TIPS5
            tb.func = function()
                GameModule:gotoSystemFunc(FunctionToggleModule.FunctionHelpId.EquipmentUpgradeSubpage)
                self._mask:setVisible(false)
                self._compImprove:setVisible(false)
            end
            table.insert(improveList, tb)
        end
    end
    --装备词条可强化
    if StrengthenModule:getRedPoint(Constant.STRENGTHEN_TYPE.ENCHANT, Constant.SUB_TYPE.SUBTYPE1) then
        local open, tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.EquipmentStrengthen)
        if open then
            local tb = {}
            tb.name = GReadText.KEY_IMPROVE_TIPS6
            tb.func = function()
                GameModule:gotoSystemFunc(FunctionToggleModule.FunctionHelpId.EquipmentStrengthen)
                self._mask:setVisible(false)
                self._compImprove:setVisible(false)
            end
            table.insert(improveList, tb)
        end
    end
    --装备可祝福
    if StrengthenModule:getRedPoint(Constant.STRENGTHEN_TYPE.ENCHANT, Constant.SUB_TYPE.SUBTYPE2) then
        local open, tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.EquipmentBless)
        if open then
            local tb = {}
            tb.name = GReadText.KEY_IMPROVE_TIPS7
            tb.func = function()
                GameModule:gotoSystemFunc(FunctionToggleModule.FunctionHelpId.EquipmentBless)
                self._mask:setVisible(false)
                self._compImprove:setVisible(false)
            end
            table.insert(improveList, tb)
        end
    end
    -- 宠物开启二次功能
    if RedDotModule:getTipsStateByName("PetModule_checkPetFunction") then
        local tb = {}
        tb.name = GReadText.KEY_IMPROVE_TIPS8
        tb.func = function()
            GameModule:gotoSystemFunc(FunctionToggleModule.FunctionHelpId.Pet)
            self._mask:setVisible(false)
            self._compImprove:setVisible(false)
        end
        table.insert(improveList, tb)
    end

    if #improveList > 0 then
        self._mask:setVisible(true)
        self._compImprove:setVisible(true)
        self._compImprove:refreshView(improveList)
    end
end

--商业化按钮提醒状态刷新
function MainUILayer:refreshBtnsRedTips()
    --首充礼包可以领取
    if lt.RechargeModule:getFirstRechargeData() then
        self._btnFirstGift:setVisible(lt.RechargeModule:getFirstRechargeBtnIsOpen())
        if lt.RechargeModule:getFirstRechargeEntryRed() then
            self._btnFirstGift:getChild("red"):setVisible(true)
        else
            self._btnFirstGift:getChild("red"):setVisible(false)
        end
    end
end

function MainUILayer:refreshDayGiftBtnsRedTips()
    if lt.RechargeModule:getDayGiftBagData() or lt.RechargeModule:dailyRechargeIsOpen() then
        self._btnDailyGift:setVisible(true)
        local isRed = lt.RechargeModule:getDayGiftRed() or false
        if not isRed then
            isRed = lt.RechargeModule:getDayDayReChargeRed() or false
        end
        if isRed then
            self._btnDailyGift:getChild("red"):setVisible(true)
        else
            self._btnDailyGift:getChild("red"):setVisible(false)
        end
    end
end

--刷新背包已满
function MainUILayer:refreshBagFull(event)
    local param = event.param
    local isFull = param.isFull
    self._imgBagFull:setVisible(isFull)
end

function MainUILayer:refreshWelfareGiftBtnsRedTips()
    if lt.WelfareModule:getGiftRewardOpen() then
        self._btnWelfare:setVisible(true)
        if lt.WelfareModule:getBtnGiftRed() then
            self._btnWelfare:getChild("red"):setVisible(true)
        else
            self._btnWelfare:getChild("red"):setVisible(false)
        end
    else
        self._btnWelfare:setVisible(false)
    end
end

--检查引导
function MainUILayer:checkGuide()
    local layerManager = display.getRunningScene():getLayerManager()
    --主界面的引导需要没有任何弹窗
    if not layerManager:isWindowEmpty() then
        return
    end

    local heroAgent = AgentManager:getWorldAgent():getHeroAgent()
    if not heroAgent then
        return  
    end

    --不在安全区不触发引导
    -- if not heroAgent:isInSafeArea() then
    --     return
    -- end

    --精力系统引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.ENERGY1) then
        local btn = self._btnEnergy
        local pos = self._view:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x - 5, pos.y + 5)
        GuideModule:triggerGuide(Constant.GUIDE_ID.ENERGY1, btn, pos, function()
            self:btnEnergyClick()
        end)
    end

    --坐骑系统引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.MOUNT1) then
        local btn = self._btnMount
        local pos = self._view:displayObject():convertToWorldSpace(btn:getPosition())
        pos = cc.p(pos.x, pos.y)
        GuideModule:triggerGuide(Constant.GUIDE_ID.MOUNT1, btn, pos, function()
            self:btnMountClick()
        end)
    end
    
    --技能编辑引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.SKILL_EDIT1) then
        local skillList = SkillModule:getActiveSkillTable()
        local race = GameModule:getHeroData():getRace()
        local bornSkills = 1
        local maxSkills = 10
        if race == Constant.RaceType.Vampire then
            bornSkills = 3
        elseif race == Constant.RaceType.Ousters then
            bornSkills = 2
        end
        maxSkills = maxSkills + bornSkills
        --获得10个主动技能弹引导
        if table.nums(skillList) >= maxSkills then
            --如果是战斗界面
            local index = self._switchFunc:getSelectedIndex()
            if index == 1 then
                local btnSwitch = self._btnSwitch
                local pos = self._view:displayObject():convertToWorldSpace(btnSwitch:getPosition())
                pos = cc.p(pos.x - btnSwitch:getSize().width, pos.y)
                GuideModule:triggerGuide(Constant.GUIDE_ID.SKILL_EDIT1, btnSwitch, pos, function()
                    self._switchFunc:setSelectedIndex(0)
                    self:btnSwitchClick()
                end)
            else
                GuideModule:directEndGuide({Constant.GUIDE_ID.SKILL_EDIT1})
            end
            return
        end
    end

    --了解宠物引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.PETFIGHT1) then
        self:checkSwitchGuide(Constant.GUIDE_ID.PETFIGHT1)
        return
    end

    --宠物出战引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.PETFIGHT11) then
        local pets = PetModule:getAllPets()
        if #pets > 0 then
            self:checkSwitchGuide(Constant.GUIDE_ID.PETFIGHT11)
            return
        end
    end

    --宠物喂养引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.PETFEED1) then
        local pets = PetModule:getAllPets()
        if #pets > 0 then
            self:checkSwitchGuide(Constant.GUIDE_ID.PETFEED1)
            return
        end
    end

    --了解公会引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.GUILD1) then
        self:checkSwitchGuide(Constant.GUIDE_ID.GUILD1)
        return
    end

    --了解交易行引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.TRANSACTION1) then
        self:checkSwitchGuide(Constant.GUIDE_ID.TRANSACTION1)
        return
    end

    --装备传承引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.INHERIT1) then
        self:checkSwitchGuide(Constant.GUIDE_ID.INHERIT1)
        return
    end

    --装备转换引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.TRANSFORM1) then
        self:checkSwitchGuide(Constant.GUIDE_ID.TRANSFORM1)
        return
    end

    --装备洗炼引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.PURIFY1) then
        self:checkSwitchGuide(Constant.GUIDE_ID.PURIFY1)
        return
    end

    --装备升级引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.LEVELUP1) then
        self:checkSwitchGuide(Constant.GUIDE_ID.LEVELUP1)
        return
    end

    --装备附魔引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.ENCHANT1) then
        self:checkSwitchGuide(Constant.GUIDE_ID.ENCHANT1)
        return
    end

    --刷新子节点引导
    local index = self._switchFunc:getSelectedIndex()
    if index == 0 then
        self._comFunc:checkGuide()
    end
end

--切换按钮引导
function MainUILayer:checkSwitchGuide(guideId)
    local index = self._switchFunc:getSelectedIndex()
    --如果是战斗界面
    if index == 1 then
        local btnSwitch = self._btnSwitch
        local pos = self._view:displayObject():convertToWorldSpace(btnSwitch:getPosition())
        pos = cc.p(pos.x - btnSwitch:getSize().width, pos.y)
        GuideModule:triggerGuide(guideId, btnSwitch, pos, function()
            self._switchFunc:setSelectedIndex(0)
            self:btnSwitchClick()
        end)
    else
        GuideModule:directEndGuide({guideId})
    end
end

function MainUILayer:getChild(name)
    return self._view:getChild(name)
end

function MainUILayer:insertObject()
    --"CompMiniMap", "CompQuickItem", "CompQuickBar", "CompFunc", "CompChat", "CompLeftTime", "CompAutoEquip", "CompImprove")
    -- local nodeNameList = {"compMiniMap", "compQuickItem", "comFunc", "comChat", "lblTime", "CompAutoEquip", "CompImprove"}
    local nodeNameList = {"compMiniMap","compQuickItem", "lblTime", "CompAutoEquip", "CompImprove","CompBuffItem","compRevive","CompMainTimeIcon"}
    for i, nodeName in ipairs(nodeNameList) do
        yflog:Info("nodeName:%s",nodeName)
        local node = self._view:getChild(nodeName)
        if node then
           node:insertObjectToFactory(self) 
        end
    end
end

function MainUILayer:addTouch()
    if not self._touchLayer then
        local size = self:getSize()
        self._touchLayer = display.newLayer(cc.c4b(0, 0, 0, 255), size)
        self._touchLayer:setOpacity(0)
        self._touchLayer:setAnchorPoint(cc.p(0.5, 0.5))
        self:displayObject():addChild(self._touchLayer)
        self._touchLayer:setTouchMode(cc.EVENT_TOUCH_ONE_BY_ONE)
        self._touchLayer:setVisible(false)
    end
    
    if not self._touchLayerEvt then
        -- print("_touchLayerEvt--------------->add")
        self._touchLayerEvt = cc.EventListenerTouchOneByOne:create()
        self._touchLayerEvt:setSwallowTouches(false)
        self._touchLayerEvt:registerScriptHandler(function(touch, event)
            return true
        end, cc.Handler.EVENT_TOUCH_BEGAN)
        self._touchLayerEvt:registerScriptHandler(function (touch, event)
            if self._touchLayer:isVisible() then
                lt.ScheduleUtil:performWithDelayGlobal(function()
                    self:onLayerClick()
                end, 0)
            end
        end, cc.Handler.EVENT_TOUCH_ENDED)
        cc.Director:getInstance():getEventDispatcher():addEventListenerWithSceneGraphPriority(self._touchLayerEvt, self._touchLayer)
    end
end

function MainUILayer:onLayerClick()
    self._touchLayer:setVisible(false)
    self._privilegeNode:setVisible(false)
end

return MainUILayer