function MainUILayer:ctor()
    MainUILayer.super.ctor(self)
    self._times = 0
    self._captureTimer = 0
    self._btnPickupTouchTime = 0
    self._cachedPingColor = nil

    self:registerComponent("CompMiniMap", "CompQuickBar", "CompQuickItem", "CompFunc", "CompChat", "CompLeftTime", "CompAutoEquip", 
        "CompImprove","CompBuffItem","CompPromptSysItem","CompRevive","CompMainTimeIcon")
    self._view = fgui.UIPackage:createObject("Main", "MainUILayer")
    -- self._view:setPivot(0.5, 0.5 , true)
    -- self._view:setPosition(display.cx, display.cy)
    self._view:makeFullScreen()
    self._view:center()
    self:addChild(self._view)
    self:initComp()
    self:startSkin()
    self:insertObject()
end

function MainUILayer:onClear()
    self:unregisterAllComponent()
    self._view = nil
    self._switchFunc = nil
    self._btnVip = nil
    self._comBuff = nil
    self._btnRank = nil
    self._comFunc = nil
    self._compTarget = nil
    self._autoAnim = nil
    self._btnPickup = nil
    self._lblTime = nil
    self._compQuickItem = nil
    self._btnGoHome = nil
    self._autoTrans = nil
    self._btnEnergy = nil
    self._btnEnergyIcon = nil
    self._btnEnergyBg = nil
    self._btnEnergyReddot = nil
    self._btnBag = nil
    self._imgBagFull = nil
    self._btnEquip = nil
    self._btnRole = nil

    --捕捉
    self._btnCapture = nil
    self._captureIcon = nil
    self._selectImg = nil
    self._numLabel = nil
    self._counter = nil
    self._maxCounter = nil
    self._captureing = nil
    self._times = nil

    self._compTask = nil
    self._showBtn = nil
    self._btnAdvanceTask = nil
    self._btnSeven = nil
    self._btnDailyTask = nil
    self._btnShopping = nil
    self._btnActivity = nil
    self._btnMount = nil
    self._btnDailyGift = nil
    self._btnFirstGift = nil
    self._btnTriggerGift = nil
    self._btnWelfare = nil
    self._btnDailyGiftTime = nil
    self._btnMonthCard = nil
    self._btnPrivilege = nil
    self._privilegeNode = nil
    self._comRevive = nil
    self._reviveAnim = nil
    self._iconTime = nil
    self._touchLayer = nil
    self._touchLayerEvt = nil
    self._cachedPingColor = nil
    MainUILayer.super.onClear(self)
end

function MainUILayer:onEnter()
    MainUILayer.super.onEnter(self)
    SocketApi:addProtoListener(SocketApi._Event.ReselRole_ACK, handler(self, self.onReselRole), "MainUILayer:onReselRole")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_NEW_TEAM_CHANGE, handler(self, self.newTeamChange), "MainUILayer:newTeamChange")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CHANGE_MAP, handler(self, self.refreshMap), "MainUILayer:refreshMap")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SELECT_TARGET, handler(self, self.refreshCaptureBtn), "MainUILayer:refreshCaptureBtn")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_PET_CAPTURE_START, handler(self, self.petCaptureStart), "MainUILayer:petCaptureStart")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_PET_CAPTURE_END, handler(self, self.petCaptureEnd), "MainUILayer:petCaptureEnd")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CHANGE_SETTINGS, handler(self, self.changeSettings), "MainUILayer:changeSettings")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_PICK_UP_OPREATE, handler(self, self.onPickUpOpreate), "MainUILayer:onPickUpOpreate")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_PICK_UP, handler(self, self.onRefreshPickUp), "MainUILayer:onRefreshPickUp")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_VIP_REFRESH_BY_LEVEL, handler(self, self.onLevelChange), "MainUILayer:onLevelChange")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_RED_DOT_EVENT, handler(self, self.uptRedDotEvt),"MainUILayer:uptRedDotEvt")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_TASK_MY, handler(self, self.refreshAdvanceTaskBtn), "MainUILayer:refreshAdvanceTaskBtn")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_AUTOFIGHT_START, handler(self, self.startAutoFight), "MainUILayer:startAutoFight")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_AUTOFIGHT_END, handler(self, self.endAutoFight), "MainUILayer:endAutoFight")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_IMPROVE_TIPS, handler(self, self.refreshImproveTips), "MainUILayer:refreshImproveTips")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CS_FIRST_RECHARGE_TIPS, handler(self, self.refreshBtnsRedTips), "MainUILayer:refreshBtnsRedTips")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CS_DAILY_GIFT_TIPS, handler(self, self.refreshDayGiftBtnsRedTipsNtf), "MainUILayer:refreshDayGiftBtnsRedTipsNtf")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SEVENDAY_LIST_ALL_CHANGE, handler(self, self.onChangeSevenDayNtf), "MainUILayer:refreshSevenDayBtn")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_ENERGY_EXP, handler(self, self.refreshEnergyExp), "MainUILayer:refreshEnergyExp")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CHECK_GUIDE_EVENT, handler(self, self.checkGuide), "MainUILayer:checkGuide")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_DAY_DAY_RECHARGE, handler(self, self.refreshDayGiftBtnsRedTips), "MainUILayer:NTF_REFRESH_DAY_DAY_RECHARGE")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_BAG_FULL, handler(self, self.refreshBagFull), "MainUILayer:refreshBagFull")
    self:addUIListenerEvent()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_WELFARE_CHANGE_EVENT, handler(self, self.refreshWelfareGiftBtnsRedTips), "MainUILayer:refreshWelfareGiftBtnsRedTips")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_TRIGGERGIFT_LIST_CHANGE, handler(self, self.onChangeTriggerGiftNtf), "MainUILayer:onChangeTriggerGiftNtf")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SHOW_REVIVE_EVENT, handler(self, self.showRevive), "MainUILayer:showRevive")
    self:addTouch()
    --默认切到战斗界面
    self._switchFunc:setSelectedIndex(1)
end

function MainUILayer:onExit()
    SocketApi:removeProtoListenerByTag("MainUILayer:onReselRole")
    NtfManager:removeNtfListenerByTag("MainUILayer:newTeamChange")
    NtfManager:removeNtfListenerByTag("MainUILayer:refreshMap")
    NtfManager:removeNtfListenerByTag("MainUILayer:refreshCaptureBtn")
    NtfManager:removeNtfListenerByTag("MainUILayer:petCaptureStart")
    NtfManager:removeNtfListenerByTag("MainUILayer:petCaptureEnd")
    NtfManager:removeNtfListenerByTag("MainUILayer:changeSettings")
    NtfManager:removeNtfListenerByTag("MainUILayer:onPickUpOpreate")
    NtfManager:removeNtfListenerByTag("MainUILayer:onRefreshPickUp")
    NtfManager:removeNtfListenerByTag("MainUILayer:onLevelChange")
    NtfManager:removeNtfListenerByTag("MainUILayer:uptRedDotEvt")
    NtfManager:removeNtfListenerByTag("MainUILayer:refreshAdvanceTaskBtn")
    NtfManager:removeNtfListenerByTag("MainUILayer:startAutoFight")
    NtfManager:removeNtfListenerByTag("MainUILayer:endAutoFight")
    NtfManager:removeNtfListenerByTag("MainUILayer:refreshImproveTips")
    NtfManager:removeNtfListenerByTag("MainUILayer:refreshBtnsRedTips")
    NtfManager:removeNtfListenerByTag("MainUILayer:refreshDayGiftBtnsRedTipsNtf")
    NtfManager:removeNtfListenerByTag("MainUILayer:refreshSevenDayBtn")
    NtfManager:removeNtfListenerByTag("MainUILayer:refreshEnergyExp")
    NtfManager:removeNtfListenerByTag("MainUILayer:NTF_REFRESH_DAY_DAY_RECHARGE")
    NtfManager:removeNtfListenerByTag("MainUILayer:checkGuide")
    NtfManager:removeNtfListenerByTag("MainUILayer:refreshBagFull")
    NtfManager:removeNtfListenerByTag("MainUILayer:refreshWelfareGiftBtnsRedTips")
    NtfManager:removeNtfListenerByTag("MainUILayer:onChangeTriggerGiftNtf")
    NtfManager:removeNtfListenerByTag("MainUILayer:showRevive")
    self:removeUIListenerEvent()
    if self._touchLayerEvt then
    	cc.Director:getInstance():getEventDispatcher():removeEventListener(self._touchLayerEvt)
    	self._touchLayerEvt = nil
    end
end


function MainUILayer:onUpdate(dt)
    if self._compBuff then
        self._compBuff:onUpdate(dt)
    end

    self:refreshTimer(dt)
    if self._pingText and self._pingText:isVisible() then
        local pingValue = self:getNetPingMs()
        self._pingText:setText(pingValue)
        if self._cachedPingColor then
            self._pingText:setColor(self._cachedPingColor)
        end
    end

    -- 刷新捕捉倒计时
    self:refreshCaptureCountDown(dt)

    -- 长按
    self:longPressUpdate(dt)
end

function MainUILayer:refreshTimer(dt)
    self._times = self._times + dt
    if self._times >= 1 then
        self._times = 0
        local _, time = GameModule:getGameTime()
        self._txtTime:setText(time)
        self._iconTime:refreshTimer(time)
        -- if self._btnDailyGiftTime then
        --     local _lastTime = lt.TimeCounter:getNowDayLastTime()
        --     local day, hour, minite,seconds= lt.CommonFunc:secondsToTime(_lastTime)
        --     self._btnDailyGiftTime:setText(string.format("%02d:%02d:%02d",hour, minite,seconds))
        -- end
    end
end

function MainUILayer:refreshMap(event)
    if self._lblTime then
        self._lblTime:checkNpcHide()
    end
end

function MainUILayer:addUIListenerEvent()
    self._btnGoHome:addClickListener(handler(self, self.btnGoHomeClick));
    self._btnSwitch:addClickListener(handler(self, self.btnSwitchClick));
    self._btnBag:addClickListener(handler(self, self.btnBagClick));
    self._btnEquip:addClickListener(handler(self, self.btnEquipClick));
    self._btnRole:addClickListener(handler(self, self.btnRoleClick));
    self._btnGM:addClickListener(handler(self, self.btnGMClick));
    self._btnGMNew:addClickListener(handler(self, self.btnGMNewClick));
    self._btnVip:addClickListener(handler(self, self.btnVipClick))
    self._btnRank:addClickListener(handler(self, self.btnRankClick))
    self._btnSeven:addClickListener(handler(self, self.btnSevenClick))
    self._btnDailyTask:addClickListener(handler(self, self.btnDailyTaskClick))
    self._btnShopping:addClickListener(handler(self, self.btnShoppingClick))
    self._btnActivity:addClickListener(handler(self, self.btnActivityClick))
    self._btnMount:addClickListener(handler(self, self.btnMountClick))
    self._btnFirstGift:addClickListener(handler(self, self.btnFirstGiftClick))
    self._btnTriggerGift:addClickListener(handler(self, self.btnTriggerGiftClick))
    self._btnWelfare:addClickListener(handler(self, self.btnWelfareClick))
    self._btnDailyGift:addClickListener(handler(self, self.btnDailyGiftClick))
    self._btnDailyGiftTime = self._btnDailyGift:getChild("textTime")
    self._btnDailyGiftTime:setVisible(false)
    self._btnCapture:addClickListener(handler(self, self.btnCaptureClick))
    self._btnAdvanceTask:addClickListener(handler(self, self.btnAdvanceTaskClick))
    self._btnPickup:addEventListener(fgui.UIEventType.TouchBegin, handler(self, self.btnPickUpOnTouchBegin))
    self._btnPickup:addEventListener(fgui.UIEventType.TouchEnd, handler(self, self.btnPickUpOnTouchEnd))
    self._mask:addEventListener(fgui.UIEventType.TouchBegin, handler(self, self.onMaskOnTouchBegin))
    self._compQuickItem:addEventListener(fgui.UIEventType.DragEnd, handler(self, self.onQuickItemDrag))
    self._btnAutoFight:addClickListener(function()
        AutoFightManager:startAutoFight()
    end)
    self._btnMonthCard:addClickListener(handler(self, self.btnMonthCardClick))
    self._btnPrivilege:addClickListener(handler(self, self.btnPrivilegeClick))
    self._btnEnergy:addClickListener(handler(self, self.btnEnergyClick))
end

function MainUILayer:removeUIListenerEvent()
    self._btnGoHome:removeClickListener()
    self._btnSwitch:removeClickListener()
    self._btnBag:removeClickListener()
    self._btnEquip:removeClickListener()
    self._btnRole:removeClickListener()
    self._btnGM:removeClickListener()
    self._btnGMNew:removeClickListener()
    self._btnVip:removeClickListener()
    self._btnRank:removeClickListener()
    self._btnSeven:removeClickListener()
    self._btnDailyTask:removeClickListener()
    self._btnShopping:removeClickListener()
    self._btnActivity:removeClickListener()
    self._btnMount:removeClickListener()
    self._btnFirstGift:removeClickListener()
    self._btnTriggerGift:removeClickListener()
    self._btnWelfare:removeClickListener()
    self._btnDailyGift:removeClickListener()
    self._btnCapture:removeClickListener()
    self._btnAdvanceTask:removeClickListener()
    self._btnPickup:removeEventListener(fgui.UIEventType.TouchBegin)
    self._btnPickup:removeEventListener(fgui.UIEventType.TouchEnd)
    self._mask:removeEventListener(fgui.UIEventType.TouchBegin)
    self._compQuickItem:removeEventListener(fgui.UIEventType.DragEnd)
    self._btnAutoFight:removeClickListener()
    self._btnMonthCard:removeClickListener()
    self._btnPrivilege:removeClickListener()
    self._btnEnergy:removeClickListener()
end

function MainUILayer:initComp()
    self._compQuickItem = self._view:getChild("compQuickItem");
    self._compQuickItem:setDraggable(true)

    local cache = lt.PrefManager:getUserValueByKey("QUICK_ITEM_DRAG") or ""
    --腰带保存位置
    local x = tonumber(string.split(cache, "|")[1])
    local y = tonumber(string.split(cache, "|")[2])
    if x and y then
        self._compQuickItem:setPosition(x, y)
    end
    self._compQuickItem:setType(lt.Constant.BeltBarType.Main)

    self._btnGoHome = self._view:getChild("btnGoHome")
    self._btnSwitch = self._view:getChild("btnSwitch")
    self._switchFunc = self._view:getController("switchFunc");
    self._btnBag = self._view:getChild("btn_bag_s")
    self._imgBagFull = self._view:getChild("img_full")
    self._btnEquip = self._view:getChild("btn_equip_s")
    self._btnRole = self._view:getChild("btn_role_s")
    self._btnGM = self._view:getChild("btnGM")
    self._btnGMNew = self._view:getChild("btnGMNew")
    self._btnVip = self._view:getChild("btnVip")
    self._btnRank = self._view:getChild("btnRank")
    self._btnSeven = self._view:getChild("btnSeven")
    self._btnDailyTask = self._view:getChild("btnDailyTask")
    self._btnDailyTask:setVisible(false)
    self._btnShopping = self._view:getChild("btnShopping")
    self._btnActivity = self._view:getChild("btnActivity")
    self._btnMonthCard = self._view:getChild("btnMonthCard")
    self._btnPrivilege = self._view:getChild("btnPrivilege")
    self._privilegeNode = self._view:getChild("node_privilege")
    self._privilegeNode:setVisible(false)
    self._btnMount = self._view:getChild("btnMount")
    self._btnSeven:setVisible(false)
    self._btnVip:setVisible(false)
    self._comFunc = self._view:getChild("comFunc")
    self._showTaskController = self._view:getController("showTask")
    --精力
    self._btnEnergy = self._view:getChild("btnEnergy")
    self._btnEnergyIcon = self._btnEnergy:getChild("icon")
    self._btnEnergyBg = self._btnEnergy:getChild("bg")
    self._btnEnergyReddot = self._btnEnergy:getChild("reddot")

    if tonumber(ConfigLoader:isDev()) == 1 then
        self._btnGM:setVisible(false)
        self._btnGMNew:setVisible(false)
        self._btnGoHome:setVisible(false)
    end

    local hpBarByRace = self._view:getController("showHPByRace")
    local race = GameModule:getHeroRace()
    hpBarByRace:setSelectedIndex(race - 1)

    local compHP = self._view:getChild("compHP"..race);
    self:addChild(lt.CompHP.new(compHP))
    -- compHP:setDraggable(true);

    -- 耐久度提示
    local compDur = self._view:getChild("CompDur"..race)
    self:addChild(lt.CompDurability.new(compDur))

    local compDestInfo = self._view:getChild("compDestInfo")
    self:addChild(lt.CompDestInfo.new(compDestInfo))
    compDestInfo:setVisible(false)
    -- 人族子弹显示
    local bullet = self._view:getChild("bullet")
    self:addChild(lt.CompBullet.new(bullet))

    -- 提示系统  2.加点邮件等
    local comBuffSp = self._view:getChild("compMsgList")
    self:addChild(lt.CompPromptSys.new(comBuffSp))

    -- buff列表
    self._comBuff = self._view:getChild("comBuff")
    self._compBuff = lt.CompBuff.new(self._comBuff)
    self:addChild(self._compBuff)

    --任务/队伍/目标
    local compTask = self._view:getChild("compTask")
    self._compTask = lt.CompTask.new(compTask)
    self._showBtn = self._view:getChild("btnShow")
    self:addChild(self._compTask)

    --攻击模式
    local compTarget = self._view:getChild("compTarget")
    self._compTarget = lt.CompTarget.new(compTarget)
    self:addChild(self._compTarget)


    self._txtTime = self._view:getChild("txtTime")
    local _, time = GameModule:getGameTime()
    self._txtTime:setText(time)
    self._iconTime = self._view:getChild("iconTime")

    self._lblTime = self._view:getChild("lblTime")
    local _lblTimeOff = self._lblTime:getPosition()
    self._lblTime:setPosition(display.cx,_lblTimeOff.y)
    --首充
    self._btnFirstGift = self._view:getChild("btnFirstGift")
    self._btnFirstGift:setVisible(false)

    --触发礼包
    self._btnTriggerGift = self._view:getChild("btnTriggerGift")
    self._btnTriggerGift:setVisible(false)
    --每日特惠
    self._btnDailyGift = self._view:getChild("btnDailyGift")
    self._btnDailyGift:setVisible(false)
    --捕捉
    self._btnCapture = self._view:getChild("btn_capture")
    
    self._captureIcon = self._btnCapture:getChild("loader_item")
    self._selectImg = self._btnCapture:getChild("img_select")
    self._numLabel = self._btnCapture:getChild("label_num")
    self._btnCapture:setVisible(false)
    self._counter = 0

    --转职任务
    self._btnAdvanceTask = self._view:getChild("btn_advanceTask")
    self._btnAdvanceTask:setVisible(false)
    
    --拾取
    self._btnPickup = self._view:getChild("btnPickup")

    --自动战斗
    self._btnAutoFight = self:getChild("btnAutoFight")
    self._autoTrans = self._btnAutoFight:getChild("anim_rotate")
    self._autoTrans:setVisible(false)

    --自动战斗spine
    self._autoAnim = self._view:getChild("node_autofight")
    self._autoAnim:setVisible(false)
    local effect = SkeletonManager:createSkeletonEffectWithFile("AutoBattle", "Autobattle_skeleton")
    self._view:getChild("node_anim"):displayObject():addChild(effect)
    effect:setAnimation(0, "Autobattle", true)

    --提升界面
    self._compImprove = self._view:getChild("CompImprove")
    self._compImprove:setVisible(false)
    --关闭遮罩
    self._mask = self._view:getChild("mask")
    self._mask:setVisible(false)
    --每日特惠
    self._btnWelfare = self._view:getChild("btnWelfare")
    self._btnWelfare:setVisible(false)

    --复活界面
    self._comRevive = self._view:getChild("compRevive")
    self._reviveAnim = self._view:getTransition("t0")
    self._comRevive:setVisible(false)

    -- ping值
    self._pingText = self._view:getChild("pingTxt")
    local pingValue = self:getNetPingMs()
    self._pingText:setText(pingValue)
    if self._cachedPingColor then
        self._pingText:setColor(self._cachedPingColor)
    end
    self:refreshPingVisible()

    self:refreshLeftUIOffset(Constant.SETTINGS_TYPES.LEFT_OFFSET)
    self:refreshRightUIOffset(Constant.SETTINGS_TYPES.RIGHT_OFFSET)

    --刷新月卡红点
    local isRed = not RechargeModule:getMonthCardRewardTime()
    self._btnMonthCard:getChild("red"):setVisible(isRed)
    --刷新特权红点
    self._btnPrivilege:getChild("red"):setVisible(isRed)

    if FunctionToggleModule:getReady() then
        self:onLevelChange()
    end

    -- self:refreshEnergyBtn()
    -- self:onChangeRankBtton()
    -- self:onChangeVip()
    -- self:refreshAllBtnPos()
end

function MainUILayer:getNetPingMs()
    local pingValue = tonumber(string.format("%.3f", SocketManager:getAlivePing())) * 1000
    local pingStr = string.format("Ping:%sms",pingValue)
    for _, config in ipairs(Constant.COLOR_PING) do
        if pingValue <= config.max then
            self._cachedPingColor = config.color
            break
        end
    end
    return pingStr
end

function MainUILayer:onMaskOnTouchBegin()
    self._mask:setVisible(false)
    self._compImprove:setVisible(false)
end

function MainUILayer:onQuickItemDrag()
    local pos = self._compQuickItem:getPosition()
    lt.PrefManager:setUserValueByKey("QUICK_ITEM_DRAG", pos.x.."|"..pos.y)
end

--捡东西或者掏尸体
function MainUILayer:btnPickupClick()
    --获取目标
    local worldAgent = lt.AgentManager:getWorldAgent()
    local heroAgent = worldAgent:getHeroAgent()
    if not heroAgent then
        return
    end
    local agent = heroAgent:getMonsterBodyOrDropItem()
    --判断是否在自身2格范围内
    if agent == nil then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_MAINUI_TIPS1})
        return
    end
    --蝙蝠\棺材不能挖掘尸体
    local isTransforming, transformId = lt.SkillModule:isTransforming()
    if transformId == lt.SkillEnum.TRANSFORM.BAT or transformId == lt.SkillEnum.TRANSFORM.CASKET then return end

    --直接捡东西或者掏尸体
    if agent:isItemAgent() then
        --发送捡东西
        heroAgent:pickUpDrop(agent)
    else
        --发送挖掘尸体
        lt.MonsterModule:sendDigCorpse(agent)
    end
end

-- 长按
function MainUILayer:longPressUpdate(dt)
    if not self._isBtnPickupTouch then
        return
    end

    if self._isBtnPickLongPress then
        return
    end

    self._btnPickupTouchTime = self._btnPickupTouchTime + dt
    if self._btnPickupTouchTime <= 0.2 then
        return
    end

    self._btnPickupTouchTime = 0
    if not self._isBtnPickLongPress then
        self._isBtnPickLongPress = true
        self:btnPickupClick()
    end
end

function MainUILayer:btnPickUpOnTouchBegin()
    --先调用一次
    self:btnPickupClick()
    self._isBtnPickupTouch = true

    self._isBtnPickLongPress = false
    self._btnPickupTouchTime = 0

end

function MainUILayer:btnPickUpOnTouchEnd()
    self._isBtnPickupTouch = false
    self._btnPickupTouchTime = 0
    self._isBtnPickLongPress = false
end

function MainUILayer:onPickUpOpreate()
    if self._isBtnPickLongPress then
        self:btnPickupClick()
    end
end

function MainUILayer:onRefreshPickUp()
    -- 怪物尸体相关刷新
    local heroAgent = AgentManager:getWorldAgent():getHeroAgent()
    local map = GameModule:checkDropAndBodyGridMap()

    local isShow = map and #map > 0 and (not heroAgent:hasBuffer(lt.BuffEnum.EFFECT_SUMMON_SYLPH))
    -- self._btnPickup:setVisible(isShow)
    if isShow then
        -- 第一个显示描边效果
        local agent = heroAgent:refreshMonsterBodyOrDropItemShader()
        self._btnPickup:setText((agent and agent:isMonsterAgent()) and GReadText.KET_SKILL_TIPS43 or GReadText.KET_SKILL_TIPS44)
    else
        self._btnPickup:setText(GReadText.KET_SKILL_TIPS43)
    end
end

