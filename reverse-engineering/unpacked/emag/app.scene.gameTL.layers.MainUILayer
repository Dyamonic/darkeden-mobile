--刷新精力系统总加成
function MainUILayer:refreshEnergyExp()
    local totalExp = EnergyModule:getTotalExpAdd()
    if totalExp == 0 then
        self._btnEnergy:setText("0%")
        self._btnEnergyIcon:setVisible(false)
        self._btnEnergyBg:setURL(string.format(_GURL.GetImageMain, "bg_jyjc_di"))
    else
        self._btnEnergy:setText((totalExp == -1 and 0 or totalExp).."%")
        self._btnEnergyIcon:setVisible(totalExp ~= -1)
        self._btnEnergyBg:setURL(string.format(_GURL.GetImageMain, totalExp ~= -1 and "bg_jyjc_di" or "bg_jyjc_di2"))
    end
    local isAchieve = EnergyModule:getAchieveEnergy()
    self._btnEnergyReddot:setVisible(not isAchieve)
end

function MainUILayer:btnCaptureClick()
    --判断是否正在捕捉
    if self._captureing then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS25})
        return
    end

    local heroAgent = AgentManager:getWorldAgent():getHeroAgent()
    if not heroAgent then return end
    
    local targetId = heroAgent:getTargetAgentId()
    if not targetId then return end
    
    local targetAgent = AgentManager:getAgent(targetId)
    if not targetAgent then return end

    --判断距离
    local targetM, targetN = targetAgent:getMNExactly()
    local mHero, nHero = heroAgent:getMNExactly()
    local distance = lt.MapUtil:getMNDistance(mHero, nHero, targetM, targetN)
    if distance > 1 then
        heroAgent:onMessage({msgId = Constant.MSG_CAPTURE})
        -- NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS24})
        return
    end

    local monsterData = targetAgent:getHeroData()
    local monsterId = monsterData:getMonsterId()
    local itemId = PetModule:getPetCaptureItem(monsterId)
    local canUse = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, itemId, 1, {tips = true})
    if not canUse then
        return
    end

    --捕捉
    -- local uid = ItemModule:getUidById(itemId)
    PetModule:sendPetCapture(monsterData:getObjId(), itemId)
end

--刷新捕捉按钮
function MainUILayer:refreshCaptureBtn(event)
    if self._btnAdvanceTask:isVisible() then
        self._btnCapture:setVisible(false)
        return
    end
    local param = event.param
    local agent = param.agent
    if agent == nil then
        self._btnCapture:setVisible(false)
        return
    end
    if agent:getAgentType() ~= Constant.AGENT_TYPE_MONSTER or agent:isPet() then
        self._btnCapture:setVisible(false)
        return
    end
    local monsterData = agent:getHeroData()
    local meta = monsterData:getMonsterInfoMeta()
    if not meta:canCapture() then
        self._btnCapture:setVisible(false)
        return
    end
    local monsterId = monsterData:getMonsterId()
    local itemId = PetModule:getPetCaptureItem(monsterId)
    self._captureIcon:setURL(string.format(_GURL.GetImageItem, itemId))
    local itemNum = ItemModule:getItemNum(itemId)
    self._numLabel:setText(itemNum.."/1")
    self._btnCapture:setVisible(true)
end

function MainUILayer:petCaptureStart(event)
    local param = event.param
    local maxCounter = param.counter * 10
    self._maxCounter = maxCounter
    self._counter = maxCounter
    self._selectImg:setFillAmount(0)
    self._selectImg:setVisible(true)
    self._captureing = true
end

function MainUILayer:petCaptureEnd(event)
    local param = event.param
    local success = param.success
    self._selectImg:setVisible(false)
    if success then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS26})
        self._btnCapture:setVisible(false)
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS27})
        self._captureing = false
        self._counter = nil
        self._maxCounter = nil
    end
    --刷新数据
    local heroAgent = lt.AgentManager:getHeroAgent()
    local targetAgent = heroAgent:getTargetAgent()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SELECT_TARGET, {agent = targetAgent})
end

--刷新捕捉倒计时
function MainUILayer:refreshCaptureCountDown(dt)
    --刷新捕获倒计时
    if not self._captureing then
        return
    end

    self._captureTimer = self._captureTimer+dt
    if self._captureTimer < 0.1 then
        return
    end

    self._captureTimer = 0


    self._counter = self._counter - 1
    if self._counter < 0 then
        self._captureing = false
        self._counter = nil
        self._maxCounter = nil
        return
    end
    self._selectImg:setFillAmount(1-self._counter/self._maxCounter)
end

--转职任务接取
function MainUILayer:btnAdvanceTaskClick()
    local missions = CacheManager:getVariableById(Constant.Variable.InitialAdvanceMission)
    local race = GameModule:getHeroRace()
    local missionId = tonumber(string.split(string.split(missions, "|")[race], ":")[2])
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTaskTalk", missionId = missionId-1,
    confirmCallback = function()
        local missionMeta = CacheManager:getMissionMeta(missionId)
        local npcId = missionMeta:getAcceptanceNPCID() or 0
        TaskModule:sendTaskLeading(npcId, missionId)
    end})
end

--刷新转职任务按钮
function MainUILayer:refreshAdvanceTaskBtn(event)
    if event and event.param then
        local typeTab = event.param.taskTypes
        if typeTab[Constant.TASK_TYPES.ADVANCE] then
            --转职任务刷新
        else
            return--于此无关的不要刷新
        end
    end
    if not FunctionToggleModule:checkEnterVisible(FunctionToggleModule.FunctionHelpId.TransferTaskMain) then
        self._btnAdvanceTask:setVisible(false) 
        return
    end
    local missions = CacheManager:getVariableById(Constant.Variable.InitialAdvanceMission)
    local race = GameModule:getHeroRace()
    local myLv = GameModule:getHeroData():getLevel()
    local missionId = tonumber(string.split(string.split(missions, "|")[race], ":")[2])
    local isVisible = myLv == Constant.TransferLevel and TaskModule:getTaskState(missionId) == nil
    self._btnAdvanceTask:setVisible(isVisible)
end

--刷新月卡按钮
function MainUILayer:refreshMonthCardBtn()
    local unlock = RechargeModule:getMonthCardUnlock()
    self._btnMonthCard:setVisible(unlock)
    self:refreshPrivilegeBtn()
end

--刷新精力系统按钮
function MainUILayer:refreshEnergyBtn()
