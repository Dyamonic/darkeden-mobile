-- 坐骑
function MainUILayer:btnMountClick()
    local open,tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.Mount) 
    if not open then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
        return
    end
    local heroAgent = AgentManager:getWorldAgent():getHeroAgent()
    if not heroAgent then return end
    if heroAgent:hasBuffer(lt.BuffEnum.EFFECT_CLASS_SLAYER_MOUNT) 
        or heroAgent:hasBuffer(lt.BuffEnum.EFFECT_SUMMON_SYLPH)
        or heroAgent:hasBuffer(lt.BuffEnum.EFFECT_CLASS_TRANSFORM_TO_BAT) then
        MountModule:onMountDown()
    else
        local keySelect = lt.PrefManager:getUserValueByKey(MountModule.MOUNT_SELECT) or 0
        local type = tonumber(keySelect)
        if type > 0 then
            MountModule:onUseMountReq(type)
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = GReadText.KEY_MOUNT_TIPS8})
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndMountMain"})
            return
        end
    end
end

