---@class UICompAutoRecycleMenuCell 帮助菜单 cell
---
local UICompAutoRecycleMenuCell          = class("UICompAutoRecycleMenuCell", lt.UIGButtonBase)

local NtfManager                         = lt.NtfManager
local Constant                           = lt.Constant
local RaceSkinRes                        = Constant.RaceSkinRes
local GameModule                         = lt.GameModule
local CommonUtil                         = lt.CommonUtil
local PrefManager                        = lt.PrefManager

local BTN_WIDTH                          = 99
local BTN_HEIHT                          = 50

UICompAutoRecycleMenuCell.ChangeSkinConf = {
    ["CommonTL"] = {
        ["btn_choose"] = "bg_zdcs_yq",
    },
}


function UICompAutoRecycleMenuCell:ctor()
    UICompAutoRecycleMenuCell.super.ctor(self)
    self._race = GameModule:getHeroData():getRace()
end

function UICompAutoRecycleMenuCell:onEnter()
    UICompAutoRecycleMenuCell.super.onEnter(self)
    self._icon:addClickListener(handler(self, self.onIconBtnClick))
    self._list:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickTargetItem))
end

function UICompAutoRecycleMenuCell:onExit()
    self._list:removeEventListener(fgui.UIEventType.ClickItem)
    self._icon:removeClickListener()
    UICompAutoRecycleMenuCell.super.onExit(self)
end

function UICompAutoRecycleMenuCell:onClear()
    self._list = nil
    self._helpList = nil
    UICompAutoRecycleMenuCell.super.onClear(self)
end

function UICompAutoRecycleMenuCell:onConstruct()
    self._list = self:getChild("list_choose")
    self._list:setItemRenderer(handler(self, self.renderTargetItem))
    self._icon = self:getChild("btn_choose")
    self:getController("c1"):setSelectedIndex(1)
end

function UICompAutoRecycleMenuCell:setObjInfo(list, index)
    self._helpList = list
    self._index = index
    self._list:setNumItems(#self._helpList)
    self._list:setSize(BTN_WIDTH, BTN_HEIHT * #self._helpList)
end

function UICompAutoRecycleMenuCell:checkAutoRecycle(list)
    if not list then
        return
    end
    for k, v in pairs(list or {}) do
        local class = v:getClass() or 0
        if class == Constant.ItemType.ITEM_TYPE_PROP then
            return false
        end
        local defaultSwitch = v:getDefaultSwitch() or 0
        local keySetting    = PrefManager:getUserValueByKey(GameModule.AUTO_RECYCLE_SETTING .. v:getIdx())
        local select        = 0
        if not keySetting then
            select = defaultSwitch
        else
            select = tonumber(keySetting)
        end
        if select == 1 then
            return false
        end
    end
    return true
end

function UICompAutoRecycleMenuCell:renderTargetItem(index, obj)
    local index = index + 1
    local meta = self._helpList[index][1]
    local showtips = self:checkAutoRecycle(self._helpList[index])
    obj:getChild("red"):setVisible(showtips)
    obj:getChild("tip"):setVisible(showtips)
    obj:getChild("title"):setText(meta:getTypeName())
    obj:getChild("icon"):setURL(
        string.format(_GURL.GetImageCommonTL, "bg_zdcs_yq" .. RaceSkinRes[self._race]))
    obj.index = index
end

function UICompAutoRecycleMenuCell:onClickTargetItem(context)
    local obj = context:getData()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_AUTORECYCLE_SUBIDX, { subIdx = obj.index })
end

function UICompAutoRecycleMenuCell:onIconBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_AUTORECYCLE_MAINIDX, { mainIdx = self._index })
end

--选中二级按钮回调
function UICompAutoRecycleMenuCell:selectSubIdx(subIdx)
    local childs = self._list:getChildren()
    for i = 1, #childs do
        local select = childs[i].index == subIdx
        childs[i]:getChild("black"):setVisible(not select)
        local color = (select) and CommonUtil:convertColorWithX("#ffffff") or
            CommonUtil:convertColorWithX("#7f7f7f")
        childs[i]:getChild("title"):setColor(color)
    end
end

function UICompAutoRecycleMenuCell:checkSelectAutoRecycle(subIdx)
    local childIndex = self._list:itemIndexToChildIndex(subIdx - 1)
    local obj = self._list:getChildAt(childIndex)

    if obj then
        local showtips = self:checkAutoRecycle(self._helpList[subIdx])
        obj:getChild("red"):setVisible(showtips)
        obj:getChild("tip"):setVisible(showtips)
    end
end

return UICompAutoRecycleMenuCell
