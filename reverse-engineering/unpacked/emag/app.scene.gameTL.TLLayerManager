---@class TLLayerManager 主界面层级管理器
local TLLayerManager  = class("TLLayerManager")

local ZORDER = {
    MAPGUIDE = 97,
    EDIT = 98,
    TIPS = 99,
    SURE = 100,
    GUIDE = 101,
    TRANSITION = 102,
    TOP = 103,
    NOTICE = 104,
}

function TLLayerManager:ctor(groot)
    self._gRoot = groot
    self:initLayers()
end

function TLLayerManager:initLayers()
    self._gameLayer = lt.GameLayer.new(self)

    -- 控制层
    self._controlLayer = lt.ControlLayer.new()

    -- 主UI层
    self._mainUILayer = lt.MainUILayer.new()

    -- 窗口层
    self._wndLayer = lt.TLWndLayer.new()


    self._editLayer = lt.TLEditLayer.new()
    self._tipsLayer = lt.TLTipsLayer.new()
    self._sureLayer = lt.TLSureLayer.new()
    self._noticeLayer = lt.TLNoticeLayer.new()
    self._topLayer = lt.TLTopLayer.new()
    self._guideLayer = lt.TLGuideLayer.new()
    self._mapGuideLayer = lt.TLMapGuideLayer.new()
    self._transitionLayer = lt.TLTransitionLayer.new()

   
    self._gRoot:addChild(self._gameLayer)
    self._gRoot:addChild(self._controlLayer)
    self._gRoot:addChild(self._mainUILayer)

    self._gRoot:addChild(self._wndLayer)

    ---
    self._gRoot:addChild(self._editLayer)
    self._editLayer:setSortingOrder(ZORDER.EDIT)
    self._gRoot:addChild(self._tipsLayer)

    self._gRoot:addChild(self._transitionLayer)
    self._transitionLayer:setSortingOrder(ZORDER.TRANSITION)

    self._gRoot:addChild(self._mapGuideLayer)
    self._mapGuideLayer:setSortingOrder(ZORDER.MAPGUIDE)

    self._tipsLayer:setSortingOrder(ZORDER.TIPS)
    self._gRoot:addChild(self._sureLayer)
    self._sureLayer:setSortingOrder(ZORDER.SURE)  
    self._gRoot:addChild(self._noticeLayer)
    self._noticeLayer:setSortingOrder(ZORDER.NOTICE)
    self._gRoot:addChild(self._topLayer)
    self._topLayer:setSortingOrder(ZORDER.TOP)
    self._gRoot:addChild(self._guideLayer)
    self._guideLayer:setSortingOrder(ZORDER.GUIDE)
end

-- 调度中心入口在 GameLayer 中
function TLLayerManager:onUpdate( delta )
    if self._mainUILayer then
        self._mainUILayer:onUpdate(delta)
    end

    if self._wndLayer then
        self._wndLayer:onUpdate(delta)
    end

    if self._controlLayer then
        self._controlLayer:onUpdate(delta)
    end

    if self._mapGuideLayer then
        self._mapGuideLayer:onUpdate(delta)
    end

    if self._editLayer then
        self._editLayer:onUpdate(delta)
    end

    if self._noticeLayer then
        self._noticeLayer:onUpdate(delta)
    end
end

function TLLayerManager:getControlLayer()
    return self._controlLayer
end
function TLLayerManager:getMainUILayer()
    return self._mainUILayer
end
function TLLayerManager:getEditLayer()
    return self._editLayer
end
function TLLayerManager:getTipsLayer()
    return self._tipsLayer
end

function TLLayerManager:getGameLayer()
    return self._gameLayer:getGameLayer()
end

function TLLayerManager:getWndLayer()
    return self._wndLayer
end

function TLLayerManager:hideAll(isShow)
    self._controlLayer:setVisible(isShow)
    self._mainUILayer:setVisible(isShow)
    self._wndLayer:setVisible(isShow)
    self._editLayer:setVisible(isShow)
    self._tipsLayer:setVisible(isShow)
    self._sureLayer:setVisible(isShow)
    self._noticeLayer:setVisible(isShow)
    self._guideLayer:setVisible(isShow)
end

function TLLayerManager:isWindowEmpty()
    return self._wndLayer:isEmpty() and not self._editLayer:isEdit()
end

function TLLayerManager:checkHasTips()
    return self._tipsLayer:checkHasTips()
end

function TLLayerManager:onClear()
    self._gameLayer:onClear()
    self._controlLayer:onClear()
    self._mainUILayer:onClear()
    self._wndLayer:onClear()
    self._editLayer:onClear()
    self._tipsLayer:onClear()
    self._sureLayer:onClear()
    self._noticeLayer:onClear()
    self._topLayer:onClear()
    self._guideLayer:onClear()
    self._mapGuideLayer:onClear()
    self._transitionLayer:onClear()
    
    self._gameLayer = nil
    self._controlLayer = nil
    self._mainUILayer = nil
    self._wndLayer = nil
    self._editLayer = nil
    self._tipsLayer = nil
    self._sureLayer = nil
    self._noticeLayer = nil
    self._topLayer = nil
    self._guideLayer = nil
    self._mapGuideLayer = nil
    self._transitionLayer = nil
    self._gRoot = nil
end

return TLLayerManager
