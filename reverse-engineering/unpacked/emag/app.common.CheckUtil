
local CheckUtil = {}

function CheckUtil:step(tag, reset)
	if not self._clock or reset then
		self._clock = socket.gettime()
	else
		local curClock = socket.gettime()
		local delta = curClock - self._clock
		if delta > 0.001 then
			print(string.format("[CheckUtil:step][%s] %.6f", tag or "nil", delta))
		end
		self._clock = curClock
	end
end

return CheckUtil
