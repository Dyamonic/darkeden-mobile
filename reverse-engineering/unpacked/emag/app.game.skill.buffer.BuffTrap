local BuffTrap = class("BuffTrap", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local Constant = lt.Constant
local CacheManager = lt.CacheManager
local ScheduleUtil = lt.ScheduleUtil
--[[
    陷阱
]]
function BuffTrap:ctor(time, actor, skilllevel)    
    BuffTrap.super.ctor(self, BuffEnum.EFFECT_CLASS_TRAPPED, time, actor)
    local agent = actor:getAgent()
 
    self._skillId = SkillEnum.SKILL_INSTALL_TRAP
    -- 播放特效 1为目标对象
    local effectName = Constant.EFFECT.SELF
    local skillMeta = CacheManager:getSkillEffectByIdLv(self._skillId)
    if not skillMeta then
        yflog:Info("SKill Config not found --->>> self._skillId = %s   skillLevel = %s", self._skillId)
        return
    end

    local effectName = Constant.EFFECT.SELF
    local targetAgentId = actor:getAgent():getAgentId()
    local key = table.concat({"get" , effectName or "" , "Metas"})
    local metas = {}
    if type(skillMeta[key]) == "function" then
        metas = skillMeta[key](skillMeta)
    end

    local bottomMetas = {metas[1]}
    local leftMetas = {metas[2], metas[3], metas[4]}
    local rightMetas = {metas[5], metas[6], metas[7]}

    -- lt.ScheduleUtil:performWithDelayGlobal(function()
    --     local effectMetas = {bottomMetas, leftMetas, rightMetas}
    --     for i, effectMeta in ipairs(effectMetas) do
    --         actor:playParallelEffectSpecial(self._skillId, effectMeta)
    --     end
    -- end, 0.2)


    local effectMetas = {leftMetas, rightMetas}
    self._clientSkillId = self._skillId .. "CLIENT"
    local objId = actor:getAgent():getObjId()
 

    self._delayHandler = lt.ScheduleUtil:performWithDelayGlobal(function()
        actor:playParallelEffectSpecial(self._skillId, bottomMetas)
        local actorM, atorN = actor:getAgent():getMNExactly()
        local worldAgent = lt.AgentManager:getWorldAgent()
        local zorder = {-1000 , 1000}
        self._trapAgents = {}
        for index = 1, 2 do
            local trapAgent = worldAgent:createClientTrap(self._clientSkillId, "", objId, actorM, atorN, index)
            trapAgent:getActor():addSpecialEffect(self._clientSkillId, effectMetas[index])
            trapAgent:setPosition(actor:getPosition())
            local zorderIndex = index == 1 and -1 or index
            trapAgent:getActor():setLocalZOrder(((atorN + zorderIndex)  * 10000  + actorM + 9999) * 10 * 1 + zorder[index])
            self._trapAgents[index] = trapAgent
        end
        agent:addBuffer(lt.BuffEnum.EFFECT_CLASS_DELAY_TRAP)

    end, 0.2)
end


function BuffTrap:onClear()
    if self._delayHandler then
		ScheduleUtil:unscheduleGlobal(self._delayHandler)
		self._delayHandler = nil
	end

    local worldAgent = lt.AgentManager:getWorldAgent()
    local actorM, atorN = self._actor:getAgent():getMNExactly()
    -- stop 播放
    for index = 1, 2 do
        if self._trapAgents and self._trapAgents[index] then
            local objId = self._trapAgents[index]:getObjId()
            worldAgent:deleteAgent(objId)
        end
    end
    local agent = self._actor:getAgent()
    agent:delBuffer(lt.BuffEnum.EFFECT_CLASS_DELAY_TRAP)
    -- self._actor:stopParallelEffect(SkillEnum.SKILL_INSTALL_TRAP)
    BuffTrap.super.onClear(self)
end

return BuffTrap
