
local CmdTransform = class("CmdTransform", lt.CmdBase)
CmdTransform._buffId     = nil
CmdTransform._state       = nil
CmdTransform._isExist = nil
function CmdTransform:ctor(bufferId, isExist, state ,srcId)
    CmdTransform.super.ctor(self, lt.Constant.CmdId.CMD_TRANSFORM)
    self._buffId = bufferId
    self._isExist = isExist
    self._state = state
    self._srcId = srcId
end

-- Setter && Getter
function CmdTransform:getBuffId()
    return self._buffId
end
function CmdTransform:getState()
    return self._state
end
function CmdTransform:getIsExist()
    return self._isExist
end

function CmdTransform:getSrcId()
    return self._srcId
end

return CmdTransform
