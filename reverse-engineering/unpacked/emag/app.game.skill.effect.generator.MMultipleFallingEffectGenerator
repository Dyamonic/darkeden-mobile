        ey[n] = egInfo.y0 + math.random(randY)
        ez[n] = baseZ + math.random(50)
        
        n = n + 1
        ex[n] = egInfo.x0 + math.random(randX) + TILE_X_HALF
        ey[n] = egInfo.y0 - math.random(randY)
        ez[n] = baseZ + math.random(50)
        
        n = n + 1
        ex[n] = egInfo.x0 + math.random(randX) + TILE_X_HALF
        ey[n] = egInfo.y0 + math.random(randY)
        ez[n] = baseZ + math.random(50)
        
        baseZ = baseZ + phaseUpper
        dropCount = dropCount + dropCountInc
        
        for j = 1, numEffect do
            x = ex[j]
            y = ey[j]
            z = ez[j]
            --由直接创建修改为异步
