            lt.BulletSystem:requestBullet({
                    skillId = skillId, 
                    direction = egInfo.direction, 
                    srcPixelPosition = {x = x, y = y, z = egInfo.z0 + z},
                    targetPixelPosition = {x = x, y = y, z = zt, step = egInfo.step},
                    lastBullet = true,
                    callback = egInfo.callback,
                }
