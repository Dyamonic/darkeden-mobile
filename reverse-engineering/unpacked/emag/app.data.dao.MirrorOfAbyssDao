local MirrorOfAbyssDao = {}

function MirrorOfAbyssDao:query(dungeonId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM MirrorOfAbyss WHERE DungeonId=%d;", tonumber(dungeonId))) do
    	local meta = lt.MirrorOfAbyssMeta.new(row)
        return meta
    end
end

function MirrorOfAbyssDao:queryAll()
    local map = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM MirrorOfAbyss") do
        local meta = lt.MirrorOfAbyssMeta.new(row)
        map[meta:getDungeonId()] = meta
    end
    return map
end

return MirrorOfAbyssDao