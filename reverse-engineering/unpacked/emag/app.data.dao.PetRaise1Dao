
local PetRaise1Dao = {}

function PetRaise1Dao:queryByAttributeId(attributeId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM PetRaise1 WHERE AttributeId=%d;", attributeId)) do
        local meta = lt.PetRaise1Meta.new(row)
        return meta
    end
end

function PetRaise1Dao:queryAll()
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM PetRaise1")) do
        local meta = lt.PetRaise1Meta.new(row)
        return meta
    end
end

return PetRaise1Dao