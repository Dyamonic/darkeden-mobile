function RankEXPInfoDao:query(id)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM ClassLevelExpInfo WHERE Level=%d;", id)) do
        local rankExp = lt.RankEXPInfoMeta.new(row)
        return rankExp
    end
end

