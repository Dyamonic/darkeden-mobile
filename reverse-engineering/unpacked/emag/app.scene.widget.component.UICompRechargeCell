---@class UICompRechargeCell 商城cell
---
local UICompRechargeCell = class("UICompRechargeCell", lt.UIGButtonBase)

local NtfManager = lt.NtfManager

function UICompRechargeCell:ctor()
    UICompRechargeCell.super.ctor(self)
    --UI
    self._list = nil
    self._icon = nil
    --数据
    self._shoppingList = nil
end

function UICompRechargeCell:onClear()
    UICompRechargeCell.super.onClear(self)
    --UI
    self._list = nil
    self._icon = nil
    --数据
    self._shoppingList = nil
end

function UICompRechargeCell:onConstruct()
    self._list = self:getChild("list")
    self._list:setItemRenderer(handler(self, self.renderTargetItem))
    self._icon = self:getChild("icon")
end

function UICompRechargeCell:onEnter()
    UICompRechargeCell.super.onEnter(self)
    self._list:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickTargetItem))
    self._icon:addClickListener(handler(self, self.onIconBtnClick))
end
function UICompRechargeCell:onExit()
    self._icon:removeClickListener()
    self._list:removeEventListener(fgui.UIEventType.ClickItem)
    UICompRechargeCell.super.onExit(self)
end

function UICompRechargeCell:setObjInfo(shoppingList)
    self._shoppingList = shoppingList
    self._list:setNumItems(#self._shoppingList)
    self._list:setSize(149, 55 * #self._shoppingList)
end

function UICompRechargeCell:renderTargetItem(index, obj)
    local meta = self._shoppingList[index + 1]
    obj:getChild("title"):setText(meta[1]:getType2Name())
    obj.index = index + 1
end

function UICompRechargeCell:onClickTargetItem(context)
    local obj = context:getData()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_RECHARGE_SELECT_SUBIDX, {subIdx = obj.index})
end

function UICompRechargeCell:onIconBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_RECHARGE_SELECT_MAINIDX, {mainIdx = self.index})
end

--选中二级按钮回调
function UICompRechargeCell:selectSubIdx(subIdx)
    local childs = self._list:getChildren()
    for i = 1, #childs do
        if childs[i].index == subIdx then
            childs[i]:getChild("icon"):setURL(string.format(_GURL.GetRechargeFGUI, "btn_sdiancz_zuoyeqian_03"))
        else
            childs[i]:getChild("icon"):setURL(string.format(_GURL.GetRechargeFGUI, "btn_sdiancz_zuoyeqian_04"))
        end
    end
end

return UICompRechargeCell