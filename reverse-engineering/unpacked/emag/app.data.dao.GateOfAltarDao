local GateOfAltarDao = {}

function GateOfAltarDao:query(dungeonId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM GateOfAltar WHERE DungeonId=%d;", tonumber(dungeonId))) do
    	local meta = lt.GateOfAltarMeta.new(row)
        return meta
    end
end

function GateOfAltarDao:queryAll()
    local map = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM GateOfAltar") do
        local meta = lt.GateOfAltarMeta.new(row)
        map[meta:getDungeonId()] = meta
    end
    return map
end

return GateOfAltarDao