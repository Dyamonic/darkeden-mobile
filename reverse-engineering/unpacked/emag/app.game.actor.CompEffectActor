local CompEffectActor = class("CompEffectActor", function()
    return display.newNode()
end)
local EffectInfo = lt.EffectInfo
--[[
    单个序列帧特效 UI使用
]]

function CompEffectActor:ctor(actionInfoMeta, direction, isloop)
    self:enableNodeEvents()
    self._actionInfoMeta = actionInfoMeta
    self._direction = direction
    self._isloop = isloop

    local sp = display.newSprite()
    sp:setAnchorPoint(0.5, 0.5)
    self:addChild(sp)

    self._spriteEffect = sp

    self:playUIEffect()
end

function CompEffectActor:onCleanup()
    self:stopAllActions()
    self._spriteEffect = nil
end


function CompEffectActor:playUIEffect()
    local effectId = self._actionInfoMeta:getEffectId()
    local bltType = self._actionInfoMeta:bltType()
    local effectInfo = EffectInfo.new(effectId, self._direction or 0, bltType)
    local time = effectInfo:getStep()
    local index = 1
    self:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(time), cc.CallFunc:create(function()
        local frameCount = effectInfo:getSpriteFrameCount()
        local frame = effectInfo:getSpriteFrame(index)
        if frame and frame.sprite then
            self._spriteEffect:setSpriteFrame(frame.sprite)
        end
        if bltType == lt.Constant.BLT_TYPE.BLT_SCREEN then
            self._spriteEffect:setBlendFunc(({ src = ccb.BlendFactor.ONE, dst = ccb.BlendFactor.ONE }))
        end
        self._spriteEffect:setPosition(cc.p(0, 0))
        if index >= frameCount then
            if self._isloop then
                index = 1
            else
                self:stopAllActions()
                self:removeFromParent()
            end
        end
        index = index + 1
    end))))
end

return CompEffectActor
