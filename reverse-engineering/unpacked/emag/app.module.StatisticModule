function StatisticModule:httpStatistic(params)
    if not params then
        return
    end

    if params.type == StatisticModule.STATISTIC_TYPE.REPORT_BYTES then
        local p = {
            type = params.type,
            value = params.value,
            serverId = tonumber(SocketManager:getServerId()),
            serverName = tostring(SocketManager:getServerName()),
            roleId = GameModule:getHeroPlayerId(),
            roleName = RoleModule:getCurRoleName(),
            roleLevel = GameModule:getHeroLevel(),
            userId = tostring(SocketManager:getUserId()),
        }

        HttpApi:reportBytes(p)
    end
end

function StatisticModule:JunmpToComment( roleLevel )
    if not lt.FunctionToggleModule:getReady() then
        return
    end
    if not lt.FunctionToggleModule:checkOpen(lt.FunctionToggleModule.FunctionHelpId.IOSAppraise) then
        return--等级未达到不弹出ios点评
    end
    if device.platform ~= "ios" or lt.PrefManager:getJumpToCommentStatus() then
        return
    end

    lt.PrefManager:setJumpToCommentStatus(true)
    cpp.SdkService:shared():jumpToComment()
end

return StatisticModule
