local StatisticModule      = {}

local ScheduleUtil = lt.ScheduleUtil
local SocketApi = lt.SocketApi
local ServerCmdDef = lt.ServerCmdDef
local CommonUtil = lt.CommonUtil
local HttpApi = lt.HttpApi

local SocketManager = lt.SocketManager
local RoleModule = lt.RoleModule
local GameModule = lt.GameModule

--[[__fmt
    数据统计
]]

StatisticModule.STATISTIC_TYPE = {
    REPORT_BYTES = 1,
}

-- 使用流量
StatisticModule._usingBytes = 0

-- 已上报流量
StatisticModule._reportBytes = 0

function StatisticModule:init()
    self._usingBytes = 0
    self._reportBytes = 0

    SocketApi:addProtoListener(ServerCmdDef.C_STATISTIC_BYTES, handler(self, self.onStatisticBytes), "StatisticModule:onStatisticBytes")

    self:statisticsReportBytes()
end

function StatisticModule:clear()
    SocketApi:removeProtoListenerByTag("StatisticModule:onStatisticBytes")

    if self._scheduleStatistics then
        ScheduleUtil:unscheduleGlobal(self._scheduleStatistics)
        self._scheduleStatistics = nil
    end

    self._usingBytes = 0
    self._reportBytes = 0
end

function StatisticModule:onStatisticBytes(event)
    local params = event.param
    if not params then
        return
    end

    self:statisticsBytes(params.bytes or 0)
end

-- 流量统计
function StatisticModule:statisticsBytes(bytes)
    self._usingBytes = self._usingBytes + bytes
end

function StatisticModule:statisticsReportBytes()
    if not self._scheduleStatistics then
        -- 每一分钟统计一次
        self._scheduleStatistics = ScheduleUtil:scheduleGlobal(function()
            local reportByte = self._usingBytes - self._reportBytes
            if reportByte > 0 then
                local params = {
                    type = StatisticModule.STATISTIC_TYPE.REPORT_BYTES,
                    value = reportByte
                }

                self._reportBytes = self._reportBytes + reportByte

                self:httpStatistic(params)
            end

        end, 300)
    end
end

