---@class CompChat 主界面下面的聊天
local CompChat         = class("CompChat", lt.UICompBase)

local NtfManager       = lt.NtfManager
local Constant         = lt.Constant
local ChatModule       = lt.ChatModule
local AutoFightManager = lt.AutoFightManager

function CompChat:ctor(view)
    CompChat.super.ctor(self)
end

function CompChat:onConstruct()
    self._bg   = self:getChild("bg")
    self._icon = self:getChild("icon")
    self._btn  = self:getChild("btn")
    self:initUI()
end

function CompChat:onEnter()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_FLOAT_CHAT, handler(self, self.onChatCompMsg), "CompChat:onChatCompMsg")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CHANGE_SETTINGS, handler(self, self.changeSettings),
        "CompChat:changeSettings")
    -- NtfManager:addNtfListener(NtfManager.NTF.NTF_MAINLAYER_SWITCH, handler(self, self.changeSwitch),
    --     "CompChat:changeSwitch")
    self._btn:addClickListener(handler(self, self.onClickBtn))
    CompChat.super.onEnter(self)
end

function CompChat:onExit()
    NtfManager:removeNtfListenerByTag("CompChat:onChatCompMsg")
    NtfManager:removeNtfListenerByTag("CompChat:changeSettings")
    -- NtfManager:removeNtfListenerByTag("CompChat:changeSwitch")
    self._btn:removeClickListener()
    CompChat.super.onExit(self)
end

function CompChat:onClear()
    self._bg        = nil
    self._icon      = nil
    self._list_chat = nil
    CompChat.super.onClear(self)
end

function CompChat:initUI()
    self._list_chat = self:getChild("list_chat")
    self._list_chat:setItemRenderer(handler(self, self.renderChatItem))
    self._list_chat:setVirtual()
    self:checkItemNum()
    self:setBGOpacity()
end

function CompChat:onClickBtn()
    ChatModule:openChatUI()
end

function CompChat:initCompStr(chatinfo)
    if not chatinfo then
        return
    end
    local tableStr = {}
    if chatinfo.chatType == Constant.MESSAGE_TALK_TYPE.LANTERN_NOTICE then -- 喇叭
        table.insert(tableStr, "[img]" .. _GURL.GetImageLaba .. "[/img]")
    else
        local chatTypeStr = "[" .. (ChatModule.CHATTYPESTR[chatinfo.chatType] or "") .. "]"
        local chatTypeColor = ChatModule.CHATTYPECOLOR[chatinfo.chatType] or ""
        table.insert(tableStr, string.format("[color=%s]", chatTypeColor))
        table.insert(tableStr, chatTypeStr)
        table.insert(tableStr, "[/color]")
    end
    local strName = ""
    if chatinfo.sendMan and chatinfo.chatType ~= Constant.MESSAGE_TALK_TYPE.LANTERN_NOTICE then
        strName = chatinfo.sendMan .. "> "
        table.insert(tableStr, "[color=#59ABFF]" .. strName .. "[/color]")
    end
    tableStr = ChatModule:initChatMsg(tableStr, chatinfo, nil, 2)
    return table.concat(tableStr)
end

-- 没必要全都渲染
function CompChat:renderChatItem(index, obj)
    local chatinfoArr = ChatModule:getChatInfo()
    local chatinfo = chatinfoArr[index + 1]
    if chatinfo then
        local str = self:initCompStr(chatinfo)
        local txt_str = obj:getChild("txt_str")
        txt_str:setText(str)
    end
end

function CompChat:changeSwitch(param)
    local index = param.param.idx
    if index and index == 1 then
        return
    end
    self:checkItemNum()
end

function CompChat:onChatCompMsg(event)
    self:checkItemNum()
end

function CompChat:checkItemNum()
    local chatinfo = ChatModule:getChatInfo()
    if chatinfo then
        self._list_chat:setNumItems(#chatinfo)
        if #chatinfo > 0 then
            self._list_chat:scrollToView(#chatinfo - 1)
        end
    end
end

function CompChat:setBGOpacity()
    local editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.CHAT_OPACITY)
    self.isBGOpacity = editTable.switch == 1
    if self.isBGOpacity then
        editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.WINDOW_OPACITY)
        self._bg:setAlpha(editTable.value / 100)
    else
        self._bg:setAlpha(1)
    end
    self._bg:setVisible(not self.isBGOpacity)
    self._icon:setVisible(self.isBGOpacity)
end

--设置改变
function CompChat:changeSettings(params)
    local param = params.param
    if param.index == Constant.SETTINGS_TYPES.CHAT_OPACITY or param.index == Constant.SETTINGS_TYPES.WINDOW_OPACITY then
        local editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.CHAT_OPACITY)
        self.isBGOpacity = editTable.switch == 1
        if self.isBGOpacity then
            editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.WINDOW_OPACITY)
            self._bg:setAlpha(editTable.value / 100)
        else
            self._bg:setAlpha(1)
        end
        self._bg:setVisible(not self.isBGOpacity)
        self._icon:setVisible(self.isBGOpacity)
    end
end

return CompChat
