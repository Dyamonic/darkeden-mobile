
local MonsterStateSkill = class("MonsterStateSkill", lt.MonsterStateBase)

local SkillManager = lt.SkillManager
local ActionManager = lt.ActionManager
local Constant = lt.Constant
local TimeTrigger = lt.TimeTrigger

MonsterStateSkill._skillId   = nil
MonsterStateSkill._skillLevel  = nil
MonsterStateSkill._direction   = nil
MonsterStateSkill._targetObjId = nil
MonsterStateSkill._targetM     = nil
MonsterStateSkill._targetN     = nil

MonsterStateSkill._isAttacking = nil
MonsterStateSkill._timeTrigger = nil

MonsterStateSkill._orgDirection = nil

MonsterStateSkill._speedRate     = 1

function MonsterStateSkill:ctor(monsterAgent, skillId, skillLevel, direction, targetObjId, targetM, targetN)
    MonsterStateSkill.super.ctor(self, monsterAgent)


    self._skillId   = skillId
    self._skillLevel  = skillLevel
    self._direction   = direction
    self._targetObjId = targetObjId
    self._targetM     = targetM
    self._targetN     = targetN

    self._isAttacking = false

    -- 计算动作时间
    self._attackTime = 0.6

    self._attackTime = monsterAgent:getAttackInterval() * monsterAgent:getCurStepMultiple(self._skillId)

    local action = self._monsterAgent:getActor():getActionId()
    if self._attackTime <= 0 then
        local frameCount = ActionManager:getCreatureFrameCount("monster", modelId, action, monsterAgent:getDirection())
        self._attackTime = frameCount * 0.06 * monsterAgent:getCurStepMultiple(self._skillId)
        -- yflog:Info("modelId:%d, Constant.ROLE_ACTION_ATTACK:%d,monsterAgent:getDirection():%d, frameCount:%d self._attackTime:%.2f%%",modelId, Constant.ROLE_ACTION_ATTACK, monsterAgent:getDirection(), frameCount, self._attackTime)
    end
    self._speedRate = 1
    local leftCount = monsterAgent:getCmdSystem():getCmdCount()
    --普攻最小间隔
    if leftCount > 0 then
        self._speedRate = 1 + leftCount * 0.3
    end
    
    self._timeTrigger = TimeTrigger.new(self._attackTime / self._speedRate)
    monsterAgent:setCurSpeedRate(self._speedRate)
end

function MonsterStateSkill:onClear()
end

function MonsterStateSkill:onEnter()
    self._isAttacking = true
    self._monsterAgent:setDirection(self._direction)

    local worldAgent = lt.AgentManager:getWorldAgent()
    local targetAgent = worldAgent:getAgent(self._targetObjId)
    local targetAgentId = nil
    if targetAgent then
        targetAgentId = targetAgent:getAgentId()
    end
    local params = {
        skillId = self._skillId, 
        fromAgentId =  self._monsterAgent:getAgentId(), 
        targetAgentId = targetAgentId,
        mTouch = self._targetM, 
        nTouch = self._targetN, 
        skilllevel = self._skilllevel, 
        code = self._code, 
        extraCode = self._extraCode,
    }
    SkillManager:playSkill(params)
end

function MonsterStateSkill:onExit()
    if self._monsterAgent:getMonsterData():getModelId() == 20088 then
        if self._orgDirection then
            self._monsterAgent:setDirection(self._orgDirection)
        end

        self._monsterAgent:setPosition(self._monsterAgent:getPosition())
    end
    --恢复播放帧率
    self._monsterAgent:setCurSpeedRate(Constant.STEPMULTIPLE.ONE)
end

function MonsterStateSkill:onUpdate()
    local deltaTime = lt.GameBoard:getDeltaTime()
    -- yflog:Info("self._isAttacking=%s", self._isAttacking)
    if self._isAttacking then
        if self._timeTrigger:tick(deltaTime) then
            self._isAttacking = false
            -- self._timeTrigger:reset(0.2 / self._speedRate)
            --[[ 攻击完成后，设置时间间隔，
                1. 用于继续查找队列中是否有可执行cmd, 如果cmd为空则间隔时间到切换为Idle
                2. 主要用于播放帧与动作切换的时间差，播放帧慢，此处需要通过攻击动作的播放帧速切换到待机动作的时间差
                例如：播放14帧攻击动作需要0.05秒，self._attackTime是通过帧数*0.1计算得出，则有0.05秒的误差，需要通过reset时间缓冲
                即0.1秒切换状态
            ]]
            self._timeTrigger:reset(0.1 / self._speedRate)
            -- yflog:Info("TimeTrigger reset  speeddRate:%02f, %02f ",self._speedRate, 0.2 / self._speedRate)
        end
    else
        --间隔结束再切换
        if self._timeTrigger:tick(deltaTime) then
            if not self._monsterAgent:hasBuffer(lt.BuffEnum.EFFECT_CLASS_BLOOD_DRAINING) then  
                self:changeNextCmdSystem()
            end
        end
    end
end

function MonsterStateSkill:changeNextCmdSystem()
    local cmd = self._monsterAgent:getCmdSystem():get()
    if cmd and cmd:getCmdId() == Constant.CmdId.CMD_ATTACK then
        self._monsterAgent:getCmdSystem():pop()

        local leftCount = self._monsterAgent:getCmdSystem():getCmdCount()
        self._skillId   = cmd:getSkillId()
        self._skillLevel  = cmd:getSkillLevel()
        self._direction   = cmd:getDirection()
        self._targetObjId = cmd:getTargetObjId()
        self._targetM     = cmd:getTargetM()
        self._targetN     = cmd:getTargetN()

        --普攻最小间隔
        if leftCount > 0 then
            self._speedRate = 1 + leftCount * 0.3
        else
            self._speedRate = 1
        end
        self._monsterAgent:setCurSpeedRate(self._speedRate)
        self._isAttacking = true
        if self._timeTrigger then
            self._timeTrigger:reset(self._attackTime / self._speedRate)
        else
            self._timeTrigger = TimeTrigger.new(self._attackTime / self._speedRate)
        end
        -- print(string.format("对象%s 卡帧数量为：%d ,技能id为：%d,当前间隔为:%f",self._monsterAgent:getName(),leftCount,self._skillId,self._attackTime / self._speedRate))
        self._monsterAgent:setDirection(self._direction)

        local worldAgent = lt.AgentManager:getWorldAgent()
        local targetAgent = worldAgent:getAgent(self._targetObjId)
        local targetAgentId = nil
        if targetAgent then
            targetAgentId = targetAgent:getAgentId()
        end

        local params = {
            skillId = self._skillId, 
            fromAgentId =  self._monsterAgent:getAgentId(), 
            targetAgentId = targetAgentId,
            mTouch = self._targetM, 
            nTouch = self._targetN, 
            skilllevel = self._skilllevel, 
            code = self._code, 
            extraCode = self._extraCode,
        }
        SkillManager:playSkill(params)
    else
        self._monsterAgent:changeState(lt.MonsterStateIdle.new(self._monsterAgent))
    end
end

function MonsterStateSkill:onMessage(msg)
end

function MonsterStateSkill:getStateId()
    return Constant.MONSTER_STATE_SKILL
end

function MonsterStateSkill:getStateName()
    return "MonsterStateSkill"
end

function MonsterStateSkill:getSkillId()
    return self._skillId
end

return MonsterStateSkill
