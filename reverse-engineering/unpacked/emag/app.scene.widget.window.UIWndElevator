---@电梯界面
---@class UIWndElevator:UIWindowBase
local UIWndElevator = class("UIWndElevator", lt.UIWindowBase)

local NtfManager = lt.NtfManager
local AgentManager = lt.AgentManager
local Constant = lt.Constant

function UIWndElevator:ctor(param)
    UIWndElevator.super.ctor(self, param)

    self._controlTab = nil
end

function UIWndElevator:onInit()
    UIWndElevator.super.onInit(self, "ui://MiniMap/ElevatorPanel")
    self:initUI()
end

function UIWndElevator:initUI()
    self._controlTab = self:getController("tabs")
    self._touchLayer = self:getChild("touchLayer")
end

function UIWndElevator:onShown()
    local sureBtn = self:getChild("btn_sure")
    sureBtn:addClickListener(handler(self, self.onSureBtnClick))

    local backBtn = self:getChild("btn_back")
    backBtn:addClickListener(handler(self, self.onBackBtnClick))

    self._touchLayer:addClickListener(handler(self, self.onBackgroundClose))

    local heroAgent = AgentManager:getHeroAgent()
    if heroAgent then
        heroAgent:onMessage({msgId = Constant.MSG_ROUTE_STOP})
    end
end

function UIWndElevator:onHide()
    UIWndElevator.super.onHide(self)
    local sureBtn = self:getChild("btn_sure")
    sureBtn:removeClickListener()

    local backBtn = self:getChild("btn_back")
    backBtn:removeClickListener()

    self._touchLayer:removeClickListener()

    local heroAgent = AgentManager:getHeroAgent()
    if heroAgent then
        heroAgent:resetProtalSending()
    end
end

function UIWndElevator:onSureBtnClick()
    local param = self:getParam().param
    local zoneIds = param.zoneIds
    local idx = self._controlTab:getSelectedIndex()
    if idx > 0 then
        local worldAgent = AgentManager:getWorldAgent()
        local myMapMeta = worldAgent:getMapAgent():getMapMeta()
        local mymapcode = myMapMeta:getMapCode()
        local mapCode = zoneIds[idx]
        if mapCode == tonumber(mymapcode) then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_ELEVATOR_TIPS1})
            return
        end
        --电梯传送
        lt.MapModule:sendProtal(mapCode)
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndElevator", close = true})
end

function UIWndElevator:onBackBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndElevator", close = true})
end

function UIWndElevator:onBackgroundClose()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndElevator", close = true})
end

function UIWndElevator:onClear()
    self._controlTab = nil
    self._touchLayer = nil
    UIWndElevator.super.onClear(self)
end

return UIWndElevator