function UICompTransactionBuy:ctor()
    self:registerComponent("UICompTransactionMenuCell", "UICompTransactionBuySimpleCell",
        "UICompTransactionBuyDetailCell")
    UICompTransactionBuy.super.ctor(self)
    --UI
    self._targetList     = nil
    self._itemList       = nil
    self._detailList     = nil
    self._lblPoint       = nil
    self._lblCoin        = nil
    self._input          = nil
    self._btnAddPoint    = nil
    self._btnAddCoin     = nil
    self._btnBack        = nil
    self._btnFind        = nil
    self._btnSort        = nil
    self._sortController = nil
    self._btnFilter      = nil
    self._btnNode        = nil
    self._cc             = nil
    self._down           = nil
    --数据
    self._mainIdx        = 1
    self._subIdx         = 1
    self._oldMainIdx     = 1
    self._oldSubIdx      = 1
    self._filter         = 99
    self._id             = 0
    self._curDetailList  = {}
    self._race           = GameModule:getHeroRace()
end

function UICompTransactionBuy:onClear()
    --UI
    self._targetList = nil
    if self._itemList then
        self._itemList:removeChildrenToPool()
        self._itemList:removeItemRenderer()
        self._itemList:removeEventListener(fgui.UIEventType.ClickItem)
        self._itemList = nil
    end
    if self._numInput then
        self._numInput:removeEditHandler()
        self._numInput:removeSelf()
        self._numInput = nil
    end
    self._detailList     = nil
    self._lblPoint       = nil
    self._lblCoin        = nil
    self._input          = nil
    self._btnAddPoint    = nil
    self._btnAddCoin     = nil
    self._btnBack        = nil
    self._btnFind        = nil
    self._btnSort        = nil
    self._sortController = nil
    self._btnFilter      = nil
    self._btnNode        = nil
    self._cc             = nil
    self._btnFilterList  = nil
    self._lblEmpty       = nil
    self._down           = nil
    --数据
    self._filter         = nil
    self._mainIdx        = nil
    self._subIdx         = nil
    self._oldMainIdx     = nil
    self._oldSubIdx      = nil
    self._curDetailList  = nil
    self:unregisterAllComponent()
    UICompTransactionBuy.super.onClear(self)
end

function UICompTransactionBuy:onEnter()
    UICompTransactionBuy.super.onEnter(self)

    self._itemList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    self._btnAddPoint:addClickListener(handler(self, self.onRechargeBtnClick))
    self._btnAddCoin:addClickListener(handler(self, self.onRechargeBtnClick))
    self._btnBack:addClickListener(handler(self, self.onBackBtnClick))
    self._btnFind:addClickListener(handler(self, self.onFindBtnClick))
    self._btnSort:addClickListener(handler(self, self.onSortBtnClick))
    self._btnFilter:addClickListener(handler(self, self.onFilterBtnClick))
    if self._btnFilterList then
        for _, obj in pairs(self._btnFilterList) do
            obj:addClickListener(handler(self, self.onFilterSelectClick))
        end
    end
end

function UICompTransactionBuy:onExit()
    self._sortController:setSelectedIndex(0)
    self._btnNode:setVisible(false)
    self._down:setVisible(true)
    self._filter = 99
    self._itemList:removeEventListener(fgui.UIEventType.ClickItem)
    self._btnAddPoint:removeClickListener()
    self._btnAddCoin:removeClickListener()
    self._btnBack:removeClickListener()
    self._btnFind:removeClickListener()
    self._btnSort:removeClickListener()
    self._btnFilter:removeClickListener()
    if self._btnFilterList then
        for _, obj in pairs(self._btnFilterList) do
            obj:removeClickListener()
        end
    end
    UICompTransactionBuy.super.onExit(self)
end

function UICompTransactionBuy:onConstruct()
    self._targetList = self:getChild("list_menu")
    self._targetList:setItemRenderer(handler(self, self.targetRender))
    self._itemList = self:getChild("list_item")
    self._itemList:setItemRenderer(handler(self, self.itemRender))
    self._detailList = self:getChild("list_detail")
    self._detailList:setItemRenderer(handler(self, self.itemDetailRender))
    self._lblPoint       = self:getChild("lbl_point")
    self._lblCoin        = self:getChild("lbl_coin")
    self._input          = self:getChild("input")
    self._btnAddPoint    = self:getChild("btn_addPoint")
    self._btnAddCoin     = self:getChild("btn_addCoin")

    self._btnBack        = self:getChild("btn_back")
    self._btnFind        = self:getChild("btn_find")
    self._btnSort        = self:getChild("btn_sort")
    self._sortController = self._btnSort:getController("c1")

    self._btnFilter      = self:getChild("btn_filter")
    self._btnNode        = self._btnFilter:getChild("node_btn")
    self._down           = self._btnFilter:getChild("n16")
    self._lblEmpty       = self:getChild("lbl_empty")
    self._btnFilterList  = {}
    for i = 1, #btnTypeList do
        self._btnFilterList[i] = self._btnFilter:getChild(btnTypeList[i].name)
        self._btnFilterList[i]:setText(btnTypeList[i].showName)
        self._btnFilterList[i].index = i
    end

    self._cc = self:getController("c1")
    self:initCocosInputUI()
    self:refreshView()
end

function UICompTransactionBuy:initUI()

end

function UICompTransactionBuy:refreshView()
    self._cc:setSelectedIndex(0)
    if #self._targetList:getChildren() > 0 then
        local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
        local context = self._targetList:getChildAt(childIndex)
        context:getChild("icon"):setURL(string.format(_GURL.GetTransactionImg,
            "bg_pmh_yeqian02" .. Constant.RaceSkinRes[self._race]))
        context:getChild("title"):setColor(cc.c3b(179, 179, 179))
        context:setSize(BTN_WIDTH, BTN_HEIHT)
        context:getChild("list"):setVisible(false)
        context:getChild("icon_up"):setVisible(self._mainIdx > 1)
    end
    local mainList = TransactionModule:getTransactionCurData()
    self._targetList:setNumItems(#mainList)
    self._targetList:scrollToView(0)
    self:resetFilter()
    self:selectMainIdx(1)
    self:refreshGold()
end

function UICompTransactionBuy:initCocosInputUI()
    if not self._numInput then
        self._numInput = ccui.EditBox:create(cc.size(138, 34), "", ccui.TextureResType.localType)
        self._numInput:setAnchorPoint(cc.p(0, 0))
        self._numInput:setPlaceHolder("搜索物品")
        self._numInput:setPosition(cc.p(10, 2))
        self._numInput:setFontName(lt.Constant.FONT_4)
        self._numInput:setFontSize(24)
        self._numInput:setReturnType(cc.KEYBOARD_RETURNTYPE_SEND)
        self._numInput:setInputMode(cc.EDITBOX_INPUT_MODE_SINGLELINE)
        self._numInput:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_LEFT)
        self._numInput:registerScriptEditBoxHandler(handler(self, self.editBoxEvent))
        self:getChild("bg_search"):displayObject():addChild(self._numInput)
    end
end

function UICompTransactionBuy:editBoxEvent(eventType, sender)
    if eventType == "began" then
    elseif eventType == "ended" then
    elseif eventType == "changed" then
        local str = sender:getText()
        str = string.gsub(str, " ", "") --过滤掉空格
        str = string.gsub(str, "\n", "")
        str = CommonUtil:rmSpecChars(str)
        local count = string.len(str)
        local reCount = 0
        local beginIndex = -1
        local reString = ""
        for i = 1, count do
            local s = string.sub(str, i, i)
            local t = string.byte(s)
            if t < 128 then
                reCount = reCount + 1 --1字节文字，长度加1
            elseif t >= 192 then
                reCount = reCount + 2 --1字节以上文字，长度加2
            end
            if reCount > 20 then
                beginIndex = i - 1
                break
            end
            beginIndex = i
        end
        reString = string.sub(str, 1, beginIndex)
        sender:setText(reString)
    elseif eventType == "return" then
    end
end

function UICompTransactionBuy:resetFilter()
    self._btnNode:setVisible(false)
    self._down:setVisible(true)
    self._filter = 99
    local index = self._filter == 99 and 1 or self._filter + 2
    self._btnFilter:setText(btnTypeList[index].showName)
    self._btnFilter:getChild("title"):setColor(btnTypeList[index].color)
end

--选中一级按钮回调
function UICompTransactionBuy:selectMainIdx(mainIdx, subIdx)
    if self._mainIdx == mainIdx then
        local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
        local context = self._targetList:getChildAt(childIndex)
        if context:getSize().height > BTN_HEIHT then
            context:getChild("icon"):setURL(string.format(_GURL.GetTransactionImg,
                "bg_pmh_yeqian01" .. Constant.RaceSkinRes[self._race]))
            context:getChild("title"):setColor(cc.c3b(179, 179, 179))
            context:setSize(BTN_WIDTH, BTN_HEIHT)
            context:getChild("list"):setVisible(false)
            context:getChild("icon_up"):setVisible(self._mainIdx > 1)
            context:getChild("icon_down"):setVisible(false)
        else
            if self._mainIdx ~= 1 then
                local secondList = context._secondList or nil
                context:setSize(BTN_WIDTH, BTN_HEIHT + #secondList * BTN_SECOND_HEIHT + 2)
                context:getChild("list"):setVisible(true)
                context:getChild("icon_up"):setVisible(false)
                context:getChild("icon_down"):setVisible(true)
                self._targetList:scrollToView(childIndex)
            else
                context:getChild("icon_up"):setVisible(false)
                context:getChild("icon_down"):setVisible(false)
                context:getChild("icon"):setURL(string.format(_GURL.GetTransactionImg,
                    "bg_pmh_yeqian02" .. Constant.RaceSkinRes[self._race]))
                context:getChild("title"):setColor(cc.c3b(255, 255, 255))
            end
        end

        self:selectSubIdx(subIdx or 1)
        return
    end
    local mainList = TransactionModule:getTransactionCurData()
    if self._mainIdx <= #mainList then
        local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
        local context = self._targetList:getChildAt(childIndex)
        context:getChild("icon"):setURL(string.format(_GURL.GetTransactionImg,
            "bg_pmh_yeqian01" .. Constant.RaceSkinRes[self._race]))
        context:getChild("title"):setColor(cc.c3b(179, 179, 179))
        context:setSize(BTN_WIDTH, BTN_HEIHT)
        context:getChild("list"):setVisible(false)
        context:getChild("icon_up"):setVisible(self._mainIdx > 1)
        context:getChild("icon_down"):setVisible(false)
    end

    self._mainIdx = mainIdx

    local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
    local newContext = self._targetList:getChildAt(childIndex)
    newContext:getChild("icon"):setURL(string.format(_GURL.GetTransactionImg,
        "bg_pmh_yeqian02" .. Constant.RaceSkinRes[self._race]))
    newContext:getChild("title"):setColor(cc.c3b(255, 255, 255))
    if self._mainIdx ~= 1 then
        local secondList = newContext._secondList or nil
        newContext:setSize(BTN_WIDTH, BTN_HEIHT + #secondList * BTN_SECOND_HEIHT + 2)
        newContext:getChild("list"):setVisible(true)
        newContext:getChild("icon_up"):setVisible(false)
        newContext:getChild("icon_down"):setVisible(true)
        self._targetList:scrollToView(childIndex)
    else
        newContext:getChild("icon_up"):setVisible(false)
        newContext:getChild("icon_down"):setVisible(false)
    end
    self:selectSubIdx(subIdx or 1)
end

--选中二级按钮回调
function UICompTransactionBuy:selectSubIdx(subIdx)
    self:resetFilter()
    self._subIdx = subIdx
    local itemList = nil
    if self._mainIdx ~= 1 then
        local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
        local context = self._targetList:getChildAt(childIndex)
        context:selectSubIdx(self._subIdx)
        local firstList = TransactionModule:getTransactionCurData()
        itemList = firstList[self._mainIdx][self._subIdx]
    else
        itemList = TransactionModule:getCollectList(self._filter, self._sortController:getSelectedIndex())
    end
    --切换到一级界面
    self._cc:setSelectedIndex(self._mainIdx == 1 and 1 or 0)
    self._itemList:setNumItems(0)
    self._detailList:setNumItems(0)
    self._btnSort:setVisible(self._mainIdx ~= 1)
    self._btnFilter:setVisible(self._mainIdx ~= 1)
    if self._mainIdx ~= 1 then
        if #itemList == 0 then
            self._itemList:setNumItems(0)
            return
        end
        --组装信息发送服务器
        local list = {}
        for i = 1, #itemList do
            table.insert(list, tostring(itemList[i]:getId()))
        end
        TransactionModule:sendTransactionSimpleListReq(list, 0)
        self._lblEmpty:setVisible(false)
    else
        self._detailList:setNumItems(#itemList)
        if #itemList > 0 then
            self._detailList:scrollToView(0)
            self._lblEmpty:setVisible(false)
        else
            self._lblEmpty:setText("暂无关注物品")
            self._lblEmpty:setVisible(true)
        end
    end
end

function UICompTransactionBuy:targetRender(index, obj)
    local name = ""
    local data = {}
    if index == 0 then
        name = GReadText.KEY_TRANSACTION_TIPS13
        data = {}
    else
        local firstList = TransactionModule:getTransactionCurData()
        local secondList = firstList[index + 1]
        name = secondList[1][1]:getFirstName()
        data = secondList
    end

    obj:getChild("title"):setText(name)
    if #data > 0 then
        obj:setObjInfo(data)
        obj.index = index + 1
    end
end

function UICompTransactionBuy:itemRender(index, obj)
    local firstList = TransactionModule:getTransactionCurData()
    local itemData = nil
    if self._mainIdx == 1 then
    else
        itemData = firstList[self._mainIdx][self._subIdx][index + 1]
    end
    if itemData then
        obj:setObjInfo(itemData)
        obj.index = index + 1
    end
end

function UICompTransactionBuy:onClickItem(context)
    local obj = context:getData()
    local itemId = obj._itemInfo:getItemId()
    local id = obj._itemInfo:getId()

    if TransactionModule:getNumbyId(id) == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = "没有在售物品" })
        return
    end
    self._id = id
    self:openTransactionDetail(id)
end

function UICompTransactionBuy:refreshGold()
    local heroData = GameModule:getHeroData()
    self._lblPoint:setText(heroData:getGold())
    self._lblCoin:setText(heroData:getJinBi())
end

function UICompTransactionBuy:onRechargeBtnClick()
    local open,tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.RechargePage) 
    if not open then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
        return
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW,
        { class = "UIWndRecharge", param = { type = Constant.RECHARGE_TYPE.RECHARGE }, reopen = true })
end

-- 返回上一级  没有上上一级说法
function UICompTransactionBuy:onBackBtnClick()
    self:resetFilter()
    self._cc:setSelectedIndex(self._oldMainIdx == 1 and 1 or 0)
    if self._oldMainIdx ~= 1 then
        local curData = TransactionModule:getTransactionCurData()
        local vv = curData[self._oldMainIdx][self._oldSubIdx]
        if vv then
            self._itemList:setNumItems(#vv)
            self:selectMainIdx(self._oldMainIdx, self._oldSubIdx)
            -- if #vv > 0 and self._oldKey <= #vv then
            --     self._itemList:scrollToView(self._oldKey - 1)
            -- end
            self._oldMainIdx = 1 -- 上一级
            self._oldSubIdx  = 1 -- 上一级
        end
    else
        local curData = TransactionModule:getCollectList(self._filter, self._sortController:getSelectedIndex())
        self._detailList:setNumItems(#curData)
        self:selectMainIdx(self._oldMainIdx, self._oldSubIdx)
    end
end

-- 搜寻  跳到当前页签
function UICompTransactionBuy:onFindBtnClick()
    -- local text = self._input:getText()
    local text = self._numInput:getText()
    local curData = TransactionModule:getTransactionCurData()
    if text == "" then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = GReadText.KEY_CHAT_TIPS2 })
        return
    end
    for i, v in ipairs(curData or {}) do
        for ii, vv in ipairs(v or {}) do
            for iii, vvv in ipairs(vv or {}) do
                local itemName = vvv:getItemName() or ""
                if string.find(itemName, text) then
                    self._oldMainIdx = self._mainIdx
                    self._oldSubIdx  = self._subIdx
                    self:selectMainIdx(i, ii)
                    return
                end
            end
        end
    end

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = GReadText.KEY_TRANSACTION_TIPS12 })
end

--价格排序
function UICompTransactionBuy:onSortBtnClick()
    local selectIdx = self._sortController:getSelectedIndex()
    self._sortController:setSelectedIndex(selectIdx == 0 and 1 or 0)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_TRANSACTION_DETAIL_LIST_CHANGE)
end

function UICompTransactionBuy:onFilterSelectClick(context)
    local index = context:getSender().index
    self._btnFilter:setText(btnTypeList[index].showName)
    self._btnFilter:getChild("title"):setColor(btnTypeList[index].color)
    self._filter = index == 1 and 99 or index - 2
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_TRANSACTION_DETAIL_LIST_CHANGE)
end

function UICompTransactionBuy:onSimpleListChange()
    local itemList = nil
    if self._mainIdx ~= 1 then
        local childIndex = self._targetList:itemIndexToChildIndex(self._mainIdx - 1)
        local context = self._targetList:getChildAt(childIndex)
        context:selectSubIdx(self._subIdx)
        local firstList = TransactionModule:getTransactionCurData()
        itemList = firstList[self._mainIdx][self._subIdx]
    else
        itemList = {}
    end
    self._itemList:setNumItems(#itemList)
    if #itemList > 0 then
        self._itemList:scrollToView(0)
    end
end

function UICompTransactionBuy:openTransactionDetail(id)
    --切换到二级界面
    self._cc:setSelectedIndex(1)
    --请求数据
    local transactions = CacheManager:getTransactionsById(id)
    if transactions:getType() == Constant.ItemType.ITEM_TYPE_PROP then
        local list = {}
        table.insert(list, tostring(id))
        TransactionModule:sendTransactionSimpleListReq(list, 1)
    elseif transactions:getType() == Constant.ItemType.ITEM_TYPE_EQUIP then
        TransactionModule:sendTransactionListReq(TransactionModule.TRANSACTIONTYPE.ITEM_DETAIL, id)
    end
end

function UICompTransactionBuy:onDetailListChange()
    self._curDetailList = {}
    if self._mainIdx ~= 1 then
        self._curDetailList = TransactionModule:getTransactionDetailList(self._filter,
            self._sortController:getSelectedIndex())
        self._lblEmpty:setText("没有道具上架")
    else
        self._curDetailList = TransactionModule:getCollectList(self._filter, self._sortController:getSelectedIndex())
        self._lblEmpty:setText("暂无关注物品")
    end
    self._detailList:setNumItems(#self._curDetailList)
    if #self._curDetailList > 0 then
        self._detailList:scrollToView(0)
    end
    self._lblEmpty:setVisible(#self._curDetailList == 0)

    self._btnSort:setVisible(self._mainIdx ~= 1)
    self._btnFilter:setVisible(self._mainIdx ~= 1)
end

function UICompTransactionBuy:itemDetailRender(index, obj)
    if self._curDetailList[index + 1] then
        local hadPrice = 0
        if self._mainIdx ~= 1 then
            hadPrice = 0
        else
            hadPrice = 1
        end
        obj:setObjInfo(self._curDetailList[index + 1], hadPrice)
        obj.index = index + 1
    end
end

function UICompTransactionBuy:onClickItemDetail(index)
    local data = self._curDetailList[index]
    if data then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW,
            {
                class = (data.IsBidding and data.IsBidding == 1) and "UIWndTransactionBidTips" or
                    "UIWndTransactionBuyTips",
                data = data
            })
    end
end

function UICompTransactionBuy:onTransactionBuyResp()
    if self._id > 0 then
        self:openTransactionDetail(self._id)
    end
end

function UICompTransactionBuy:onFilterBtnClick()
    self._btnNode:setVisible(not self._btnNode:isVisible())
    self._down:setVisible(not self._btnNode:isVisible())
end

return UICompTransactionBuy
