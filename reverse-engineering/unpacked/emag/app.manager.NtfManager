function NtfManager:init()
    cc.load("event").new():bind(self)
end

function NtfManager:addNtfListener(id, theHandler, tag)
    self:addEventListener(id, theHandler, tag)
end

function NtfManager:removeNtfListenerById(id)
    self:removeEventListenersByEvent(id)
end

function NtfManager:removeNtfListenerByTag(tag)
    self:removeEventListenersByTag(tag)
end

function NtfManager:dispatchNtf(id, param)
    -- print("NtfManager:dispatchNtf", id)
    self:dispatchEvent({name=id,param=param})
end

function NtfManager:clear()
    self:removeAllEventListeners()
end

return NtfManager
