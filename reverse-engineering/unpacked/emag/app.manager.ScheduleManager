-- @Desc    : 每帧刷新定时器管理（区分于TimeCounterManager每1s 进行刷新）

local ScheduleManager = {}

-- CounterName
ScheduleManager.TC = {
    USE_POINTS_CREATE_UPDATE   = "USE_POINTS_CREATE_UPDATE",   --按钮加点更新
    MAGIC_OUTERS_TIPS_UPDATE   = "MAGIC_OUTERS_TIPS_UPDATE",   --魔族技能tips
    VAMPIRE_POINT_CLEAN_UPDATE = "VAMPIRE_POINT_CLEAN_UPDATE", --鬼族技能清洗
    TRANSACTION_SELL_UPDATE    = "TRANSACTION_SELL_UPDATE",    --交易行出售
    EQUIP_STFUSION_UPDATE      = "EQUIP_STFUSION_UPDATE",      --装备融合

   
}

function ScheduleManager:init()
    self._tcTable = {}
    self._markerTable = {}
    self._tickHandler = lt.ScheduleUtil:scheduleGlobal(handler(self, self.tick), 0)
    self._deltaTime = 0
end

function ScheduleManager:clear()
    if self._tickHandler then
        lt.ScheduleUtil:unscheduleGlobal(self._tickHandler)
        self._tickHandler = nil
    end
    self._tcTable = {}
    self._markerTable = {}
end

-- 记录器
function ScheduleManager:startTimeMark(name, params)
    if not self._markerTable[name] then
        self._markerTable[name] = { counter = lt.TimeCounter.new(name) }
    end
    self._markerTable[name].counter:mark()

    return self._markerTable[name].counter
end

function ScheduleManager:stopTimeMark(name)
    self._markerTable[name] = nil
end

function ScheduleManager:getTimeMarker(name, params)
    if not self._markerTable[name] then
        self:startTimeMark(name, params)
    end

    return self._markerTable[name].counter
end

-- 获取距离记录器开始记录时到当前的时间间隔
function ScheduleManager:getMarkInterval(name)
    local tr = self:getTimeMarker(name)
    return tr:getMarkInterval()
end

-- 定时器 (需要定时触发事件使用以下接口)
function ScheduleManager:startTimeCounter(name, params)
    params = params or {}
    self._tcTable[name] = { counter = lt.TimeCounter.new(name), callback = params.callback }
end

function ScheduleManager:stopTimeCounter(name)
    self._tcTable[name] = nil
end

function ScheduleManager:getTimeCounter(name, params)
    if not self._tcTable[name] then
        self:startTimeCount(name, params)
    end

    return self._tcTable[name].counter
end

function ScheduleManager:tick(dt)
    self._deltaTime = dt
    for _, v in pairs(self._tcTable) do
        v.counter:tick()

        if v.callback then
            v.callback(v.counter:getTickTime(),self._deltaTime)
        end
    end
end

function ScheduleManager:getTickTime(name)
    local tc = self:getTimeCounter(name)
    return tc:getTickTime()
end

return ScheduleManager
