
local HeroStateIdle = class("HeroStateIdle", lt.HeroStateBase)
local Constant = lt.Constant
local AutoFightManager = lt.AutoFightManager

HeroStateIdle._timeTriggerHit    = nil
-- HeroStateIdle._timeTriggerPickUp = nil
HeroStateIdle._timeTriggerLarash = nil

HeroStateIdle._handleSkillRet = nil
HeroStateIdle._isHit = false

function HeroStateIdle:ctor(heroAgent, delayHandle)
    HeroStateIdle.super.ctor(self, heroAgent)

    -- self._timeTriggerPickUp = lt.TimeTrigger.new(0.5)

    -- 其他玩家烈炎剑连击
    if not self._heroAgent:getIsSelf() then
        self._timeTriggerLarash = lt.TimeTrigger.new(0.1)
    end

    lt.GameModule:clearAttackCd()


    self._handleSkillRet = true

    self._delayHandle = delayHandle
end

function HeroStateIdle:onClear()
    self._timeTriggerHit = nil
    self._delayHandle = nil
    HeroStateIdle.super.onClear(self)
end

function HeroStateIdle:onEnter()
    -- self._heroAgent:checkPickUp()
    self._heroAgent:playAction(Constant.ROLE_ACTION_IDLE)

    self._heroAgent:setSkillId(nil)
    self._heroAgent:setAutoSkill(false)
end

function HeroStateIdle:onExit()
    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_OUT_IDLE)
end

function HeroStateIdle:onUpdate()
    if not self._heroAgent then
        return 
    end
    -- 受击动作
    if self._timeTriggerHit and self._timeTriggerHit:tick(lt.GameBoard:getDeltaTime()) then
        self._timeTriggerHit = nil

        self._isHit = false
        self._heroAgent:playAction(Constant.ROLE_ACTION_IDLE)
    end

    if self._delayTimeHitTrigger and self._delayTimeHitTrigger:tick(lt.GameBoard:getDeltaTime()) then
        self._delayTimeHitTrigger = nil
        self._heroAgent:playAction(Constant.ROLE_ACTION_Hit)
    end


    -- 其他玩家
    if not self._heroAgent:getIsSelf() then
        local cmd = self._heroAgent:getCmdSystem():pop()
        if cmd then
            self._heroAgent:handleCmd(cmd)

            -- 烈炎剑 连击清除
            if (cmd:getCmdId() ~= Constant.CmdId.CMD_ATTACK) or (cmd:getCmdId() == Constant.CmdId.CMD_ATTACK and cmd:getSkillId() ~= lt.SkillEnum.SKILL_LAR_SLASH) then
                self._heroAgent:clearLarSlashMultip()
            end
        end

        if self._timeTriggerLarash and self._timeTriggerLarash:tick(lt.GameBoard:getDeltaTime()) then
            self._timeTriggerLarash = nil
            self._heroAgent:clearLarSlashMultip()
        end
        return
    end
    local deltaTime = lt.GameBoard:getDeltaTime()

    -- 捡取
    -- if self._timeTriggerPickUp:tick(deltaTime) then
    --     self._heroAgent:checkPickUp()
    -- end

    if self._heroAgent:getIsOutOfGame() then
        self._heroAgent:changeState(lt.HeroStateDie.new(self._heroAgent))
        return
    end

    if self._delayHandle and self._delayHandle > 0 then
        self._delayHandle = self._delayHandle - deltaTime
        if self._delayHandle > 0 then
            return
        end
    end

    local skillId,level = self:getCurUseSkillId(self._heroAgent)
    if skillId then
        local isSuccess = self:handleSkill(skillId, {level = level})
        --技能释放失败设置autoskill = false
        if not isSuccess then
            self._heroAgent:setAutoSkill(false)
        end
    end
end

function HeroStateIdle:onMessage(msg)
    if msg.msgId == Constant.MSG_ON_HIT then
        -- 受击
        if self._isHit then
            return
        end
        self._isHit = true
        
        -- 延迟受击动作
        self._delayHitTime = tonumber(msg.delayTime)
        if self._delayHitTime == 0 then
            self._heroAgent:playAction(Constant.ROLE_ACTION_Hit)
        else
            self._delayTimeHitTrigger = lt.TimeTrigger.new(self._delayHitTime)
        end

        self._timeTriggerHit = lt.TimeTrigger.new(0.3 + self._delayHitTime)

    elseif msg.msgId == Constant.MSG_MOVE_JOYSTICK or msg.msgId == Constant.MSG_MOVE_TOUCH then
        -- 炮塔改变方向
        if self._heroAgent:hasBuffer(lt.BuffEnum.EFFECT_INSTALL_TURRET) then
            if msg.moveDirection then
                self._heroAgent:setDirection(msg.moveDirection)
            end
        end

        -- 无法移动
        if not self._heroAgent:canMove() then
            return
        end

        if msg.msgId == Constant.MSG_MOVE_TOUCH and msg.moveType == Constant.MOVE_NONE then
            return
        end

        -- 摇杆控制移动/点击控制移动
        self._heroAgent:changeState(lt.HeroStateMove.new(self._heroAgent, msg.moveType, msg.moveDirection, msg.mNext, msg.nNext))
        return

    elseif msg.msgId == Constant.MSG_SKILL then
        -- 技能
        self._heroAgent:handleSkillMsg(msg)
    elseif msg.msgId == Constant.MSG_ROUTE then
        -- 炮塔改变方向
        if self._heroAgent:hasBuffer(lt.BuffEnum.EFFECT_INSTALL_TURRET) then
            local mTarget, nTarget = msg.mTarget, msg.nTarget
            local mHero, nHero = self._heroAgent:getMNExactly()
            if mTarget and nTarget then
                local direction = lt.MapUtil:getDirectionToPosition(mHero, nHero, mTarget, nTarget)
                self._heroAgent:setDirection(direction)
            end
        end
        -- 寻路处理
        self._heroAgent:handleRouteMsg(msg)
    elseif msg.msgId == Constant.MSG_CAPTURE then
        -- 捕捉宠物
        local targetAgent = self._heroAgent:getTargetAgent()
        self._heroAgent:changeState(lt.HeroStateMoveToCapture.new(self._heroAgent, targetAgent:getAgentId()))
    end
end

function HeroStateIdle:getStateId()
    return Constant.HERO_STATE_IDLE
end

function HeroStateIdle:getStateName()
    return "HeroStateIdle"
end

function HeroStateIdle:handleSkill(skillId, params)
    params = params or {}
    params.showTips = self._handleSkillRet
    self._handleSkillRet = self._heroAgent:handleSkill(skillId, params)
    return self._handleSkillRet
end

function HeroStateIdle:getCurUseSkillId(heroAgent)
    local skillId, level = heroAgent:getSkillId()
    if not skillId then
        return nil, nil
    end

    -- 等级为0 不释放技能
    if level == 0 then
        return nil, nil
    end

    -- 技能Cd完毕
    if not lt.SkillCdManager:isReady(skillId) then
        return nil, nil
    end

    -- 验证技能是否已使用
    local canUse = not heroAgent:getIsSkillIdUsed(skillId)
    if not canUse then
        return nil, nil
    end

    return skillId,level
end

return HeroStateIdle
