local ALTreasureDao = {}

function ALTreasureDao:query(alId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Mission WHERE ALId=%d;", tonumber(alId))) do
    	local meta = lt.ALTreasureMeta.new(row)
        return meta
    end
end

function ALTreasureDao:queryAll()
    local map = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM ALTreasure") do
        local meta = lt.ALTreasureMeta.new(row)
        if not map[meta:getALType()] then
            map[meta:getALType()] = {}
        end
        table.insert(map[meta:getALType()], meta)
    end
    return map
end

return ALTreasureDao