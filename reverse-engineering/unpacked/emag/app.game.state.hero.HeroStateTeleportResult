--- 瞬间移动后续
local HeroStateTeleportResult = class("HeroStateTeleportResult", lt.HeroStateBase)

local Constant = lt.Constant
local SkillEnum = lt.SkillEnum
local ScheduleUtil = lt.ScheduleUtil
local ActionManager = lt.ActionManager

-- 目标位置
HeroStateTeleportResult._mTarget       = nil
HeroStateTeleportResult._nTarget       = nil
HeroStateTeleportResult._xTarget       = nil
HeroStateTeleportResult._yTarget       = nil

-- hero位置
HeroStateTeleportResult._mHeroX = nil
HeroStateTeleportResult._mHeroY = nil

--[[
    技能: 巨炮轰击目标点
]]
local BombCrashWalkResultActionId = Constant.ACTION_SLAYER_BLADE_2 --巨炮轰击到达目标点播放的动作
function HeroStateTeleportResult:ctor(heroAgent, mTarget, nTarget, skillId, targetObjId, knockedTarget)
    HeroStateTeleportResult.super.ctor(self, heroAgent)
    self._skillId = skillId
    self._visibleFlag = false
    self._moveEffect = nil
    self._knockedTarget = knockedTarget
    local count, step = ActionManager:getActorFrameCount(self._heroAgent:getHeroData():getModelName(), BombCrashWalkResultActionId, self._heroAgent:getDirection(),self._heroAgent:getTransformId(),self._heroAgent:getCurStepMultiple())
    self._attackActionTime = count * step
    self._mTarget, self._nTarget = mTarget, nTarget
    if self._skillId == SkillEnum.SKILL_BOMB_CRASH_WALK then
        local worldAgent = lt.AgentManager:getWorldAgent()
        if not worldAgent then 
            return 
        end
        local targetAgent =  worldAgent:getAgent(targetObjId)
        if targetAgent then
            self._mTarget, self._nTarget = targetAgent:getMNExactly()
        end
    end
    self:skillResult()
end

function HeroStateTeleportResult:onClear()
                                
    HeroStateTeleportResult.super.onClear(self)
end



function HeroStateTeleportResult:skillResult()
    if self._skillId == SkillEnum.SKILL_BOMB_CRASH_WALK then
        -- self._heroAgent:playAction(BombCrashWalkResultActionId)
        self:playCrashWalkResultEffect()

        --- 发生击退不进行攻击action 播放
        if self._knockedTarget then 
            self._heroAgent:changeState(lt.HeroStateIdle.new(self._heroAgent))
        else
            ScheduleUtil:performWithDelayGlobal(function()
                if self._heroAgent then
                    self._heroAgent:changeState(lt.HeroStateIdle.new(self._heroAgent))
                end
            end, 0) --self._attackActionTime
        end
    end
    
end

--- 巨炮轰炸到达目标点播放特效
function HeroStateTeleportResult:playCrashWalkResultEffect()
    --- result effect
    local sX, sY = self._mTarget, self._nTarget

    local function attachTargetEffect()
        local effectMetas = lt.CacheManager:getHitMetas(self._skillId)
        local effectMeta = effectMetas[1]
        local x, y = lt.MapUtil:calcMNMid(sX, sY)
		local offsetX, offsetY = -25, 15
		local reX, reY = x + offsetX, y + offsetY
        local bullet = lt.BullectScreenEffect.new(self._skillId, 0, cc.p(reX, reY))
        bullet:addEffect(self._skillId, effectMeta)

        local zorder = (sY  * 10000 + sX + 9999) * 10 + 1

        lt.BulletManager:addBulletToMapZOrder(bullet, zorder)
    end
    attachTargetEffect()
    

    local egInfo = {
        skillId = self._skillId,
        tX = sX,
        tY = sY
    }
    for currentPhase = 1, 3 do
        ScheduleUtil:performWithDelayGlobal(function()
            egInfo.currentPhase = currentPhase
            lt.MBloodyWaveEffectGenerator:generate(egInfo)
        end, currentPhase * 0.1 + 0.4)
    end
    if not self._knockedTarget then
        -- self._heroAgent:playAction(Constant.ACTION_ATTACK)
    end
end

function HeroStateTeleportResult:onUpdate()

end

function HeroStateTeleportResult:onEnter()
end

function HeroStateTeleportResult:onExit()
end


function HeroStateTeleportResult:onMessage(msg)
end

function HeroStateTeleportResult:getStateId()
    return Constant.HERO_STATE_TELEPORT_RET
end

function HeroStateTeleportResult:getStateName()
    return "HeroStateTeleportResult"
end

return HeroStateTeleportResult