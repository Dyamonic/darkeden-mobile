
local MonsterStateMove = class("MonsterStateMove", lt.MonsterStateBase)

local Constant = lt.Constant

MonsterStateMove._moveType = nil
MonsterStateMove._mTarget = nil
MonsterStateMove._nTarget = nil
MonsterStateMove._xTarget = nil
MonsterStateMove._yTarget = nil
MonsterStateMove._speedRate     = 1

function MonsterStateMove:ctor(monsterAgent, moveType, direction, mTarget, nTarget)
    MonsterStateMove.super.ctor(self, monsterAgent)

    self:initMove(moveType, direction, mTarget, nTarget)
end

function MonsterStateMove:onClear()
end

function MonsterStateMove:onEnter()
    local leftCount = self._monsterAgent:getCmdSystem():getCmdCount()
    if leftCount > 0 then
        self._speedRate = 1 + leftCount * 0.3
        self._monsterAgent:setCurSpeedRate(self._speedRate)
    end
end

function MonsterStateMove:onExit()
    --恢复播放帧率
    if self._monsterAgent then
        self._monsterAgent:setCurSpeedRate(Constant.STEPMULTIPLE.ONE)
    end
end

function MonsterStateMove:onUpdate()
        -- 无法移动
    if not self._monsterAgent:canMove() then
        self._monsterAgent:changeState(lt.MonsterStateIdle.new(self._monsterAgent))
        return false
    end
    local xMonster, yMonster = self._monsterAgent:getPosition()
    local directionV = cc.pSub(cc.p(self._xTarget, self._yTarget), cc.p(xMonster, yMonster))
    local length = cc.pGetLength(directionV)

    local step = self._monsterAgent:getMoveSpeed(self._moveType) * lt.GameBoard:getDeltaTime() * self._speedRate
    if length < step or length > 300 then
        -- 到达
        self._monsterAgent:setPosition(self._xTarget, self._yTarget)
        
        if not self:checkMoveOn() then
            self._monsterAgent:changeState(lt.MonsterStateIdle.new(self._monsterAgent))
            return
        end
    else
        -- 未到到
        directionV = cc.pMul(cc.pNormalize(directionV), step)
        self._monsterAgent:setPosition(xMonster + directionV.x, yMonster + directionV.y)
    end
end

function MonsterStateMove:onMessage(msg)
end

function MonsterStateMove:getStateId()
    return Constant.MONSTER_STATE_MOVE
end

function MonsterStateMove:getStateName()
    return "MonsterStateMove"
end

function MonsterStateMove:checkMoveOn()
    local cmd = self._monsterAgent:getCmdSystem():get()
    if cmd and cmd:getCmdId() == Constant.CmdId.CMD_MOVE then
        self._monsterAgent:getCmdSystem():pop()

        self:initMove(cmd:getMoveType(), cmd:getDirection(), cmd:getMNext(), cmd:getNNext())

        local leftCount = self._monsterAgent:getCmdSystem():getCmdCount()
        if leftCount > 0 then
            self._speedRate = 1 + leftCount * 0.3
        else
            self._speedRate = 1
        end
        self._monsterAgent:setCurSpeedRate(self._speedRate)
            
        return true
    else
        self._monsterAgent:changeState(lt.MonsterStateIdle.new(self._monsterAgent))
        return false
    end
end

function MonsterStateMove:initMove(moveType, direction, mNext, nNext)
    self._moveType = moveType
    self._mTarget = mNext
    self._nTarget = nNext
    self._xTarget, self._yTarget = lt.MapUtil:calcMNMid(self._mTarget, self._nTarget)

    -- 修改MapAgent的AgentSystem
    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
    mapAgent:changeAgentMN(self._monsterAgent, self._mTarget, self._nTarget)

    -- 宠物修正方向
    if self._monsterAgent:isPet() then
        local xMonster, yMonster = self._monsterAgent:getPosition()
        local directionV = cc.pSub(cc.p(self._xTarget, self._yTarget), cc.p(xMonster, yMonster))
        direction = self:getDirection(directionV)
    end
    -- 设置方向
    self._monsterAgent:setDirection(direction)

    -- 播放动画
    self:playMoveAction()
end

function MonsterStateMove:playMoveAction()
    if self._moveType == Constant.MOVE_FORWARD  then
        self._monsterAgent:playAction(Constant.ROLE_ACTION_IDLE)
    else --if self._moveType == Constant.MOVE_RUN then
        self._monsterAgent:playAction(Constant.ROLE_ACTION_MOVE)
    end
end

function MonsterStateMove:getDirection(directionV)
    if directionV.x < 0 and directionV.y == 0 then
        return Constant.DIRECTION_LEFT
    elseif directionV.x < 0 and directionV.y < 0 then
        return Constant.DIRECTION_LEFT_DOWN
    elseif directionV.x == 0 and directionV.y < 0 then
        return Constant.DIRECTION_DOWN
    elseif directionV.x > 0 and directionV.y < 0 then
        return Constant.DIRECTION_RIGHT_DOWN
    elseif directionV.x > 0 and directionV.y == 0 then
        return Constant.DIRECTION_RIGHT
    elseif directionV.x > 0 and directionV.y > 0 then
        return Constant.DIRECTION_RIGHT_UP
    elseif directionV.x == 0 and directionV.y > 0 then
        return Constant.DIRECTION_UP
    elseif directionV.x < 0 and directionV.y > 0 then
        return Constant.DIRECTION_LEFT_UP
    end
end

return MonsterStateMove
