local BuffBlind = class("BuffBlind", lt.BufferBase)
local SkillEnum = lt.SkillEnum
local CacheManager = lt.CacheManager
local Constant = lt.Constant

--[[
    --卫星轰击致盲效果
]]
function BuffBlind:ctor(time, actor, skilllevel,source,bufferId)    
    BuffBlind.super.ctor(self, bufferId, time, actor)
    self._skillId = SkillEnum.SKILL_HARPOON_BOMB
    self._agent = actor:getAgent()
    local buffMetas = CacheManager:getBuffMetas(self._skillId, 0)
    actor:playParallelEffectSpecial(self._skillId, buffMetas)
    if self._agent and self._agent:isHeroAgent() and actor:isSelf() then
        actor:createBlindShot()
    end
end

function BuffBlind:onClear()
    if self._agent and self._agent:isHeroAgent() and self._actor:isSelf() then
        self._actor:removeBlindShot()
    end
    self._actor:stopParallelEffect(self._skillId)
    BuffBlind.super.onClear(self)
end

return BuffBlind
