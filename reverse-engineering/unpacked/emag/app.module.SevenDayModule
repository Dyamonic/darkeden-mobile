-- 七日活动
local SevenDayModule         = {}

local SocketApi              = lt.SocketApi
local netcmd_pb              = lt.netcmd_pb
local CommonModule           = lt.CommonModule
local ServerCmdDef           = lt.ServerCmdDef
local ClientCmdDef           = lt.ClientCmdDef
local NtfManager             = lt.NtfManager
local RedDotModule           = lt.RedDotModule
local GameModule             = lt.GameModule
local CacheManager           = lt.CacheManager
local Constant               = lt.Constant
local TaskModule             = lt.TaskModule

SevenDayModule.CONTROL_INDEX = {
    TASK   = 0, --任务
    REWARD = 1, --奖励
}

SevenDayModule._infoList     = {}
SevenDayModule._alProgress   = 0 -- 已领取活跃度
SevenDayModule._alTotal      = 0 -- 总活跃度
SevenDayModule._maxDay       = 0 -- 激活天数


function SevenDayModule:init()
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_QUERY_SEVEN_DAY_RESP),
        handler(self, self.onQuerySevenDayResp), "SevenDayModule:onQuerySevenDayResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_SEVEN_DAY_INFO_NTF),
        handler(self, self.onSevenDayInfoNtf), "SevenDayModule:onSevenDayInfoNtf")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GET_SEVEN_DAY_REWARD_RESP),
        handler(self, self.onGetSevenDayRewardResp), "SevenDayModule:onGetSevenDayRewardResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_GET_SEVEN_DAY_ALREWARD_RESP),
        handler(self, self.onGetSevenDayAlrewardResp), "SevenDayModule:onGetSevenDayAlrewardResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_SEVEN_DAY_TASK_JUMP_MAP_RESP),
        handler(self, self.onSevenDayTaskJumpMapResp), "SevenDayModule:onSevenTaskJumpMapResp")
end

function SevenDayModule:clear()
    SocketApi:removeProtoListenerByTag("SevenDayModule:onQuerySevenDayResp")
    SocketApi:removeProtoListenerByTag("SevenDayModule:onSevenDayInfoNtf")
    SocketApi:removeProtoListenerByTag("SevenDayModule:onGetSevenDayRewardResp")
    SocketApi:removeProtoListenerByTag("SevenDayModule:onGetSevenDayAlrewardResp")
    SocketApi:removeProtoListenerByTag("SevenDayModule:onSevenDayTaskJumpMapResp")
    self._infoList = {}
end

----------------------------请求----------------------------
function SevenDayModule:onQuerySevenDayReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_QUERY_SEVEN_DAY_REQ))
end

--获取奖励
function SevenDayModule:onGetSevenDayRewardReq(day, type, id)
    local msg = netcmd_pb.CS_GetSevenDayRewardReq()
    msg.day   = day
    msg.type  = type --类型(0 任务 1 礼包)
    msg.id    = id   --任务ID/礼包ID
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GET_SEVEN_DAY_REWARD_REQ), msg)
end

--活跃度奖励
function SevenDayModule:onGetSevenDayAlrewardReq(al)
    local curAl = al or self._alProgress
    local msg   = netcmd_pb.CS_GetSevenDayAlrewardReq()
    msg.al      = curAl --活跃度
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_GET_SEVEN_DAY_ALREWARD_REQ), msg)
end

--任务跳地图
function SevenDayModule:onSevenDayTaskJumpMapReq(taskId)
    local msg  = netcmd_pb.CS_SevenDayTaskJumpMapReq()
    msg.taskId = taskId --任务id
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_SEVEN_DAY_TASK_JUMP_MAP_REQ), msg)
end

--任务前往
function SevenDayModule:onSevenDayTaskJump(taskId)
    local meta = CacheManager:getSevenDayMissionMeta(taskId)
    if meta:getFunctionId() ~= 0 then
        GameModule:gotoSystemFunc(meta:getFunctionId())
    else
        SevenDayModule:onSevenDayTaskJumpMapReq(taskId)
    end
end
----------------------------回调----------------------------
--查询七日嘉年华数据 全量
function SevenDayModule:onQuerySevenDayResp(event)
    local proto         = event.param
    local day_info_list = proto.day_info_list
    self._alProgress    = proto.al_progress -- 已领取活跃度数量
    self._alTotal       = proto.total_al    -- 总活跃活跃度
    self._maxDay        = proto.max_day
    self._closeTime     = proto.close_time
    self._infoList      = {}
    for _, v in ipairs(day_info_list or {}) do
        self._infoList[v.day] = v
    end
    -- 红点
    self:initSevenDayTaskRedTips()
    self:initSevenDayRewardRedTips()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SEVENDAY_LIST_ALL_CHANGE)
    if #self._infoList == 0 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndSevenDay", close = true })
    end
end

--七日嘉年华数据更新通知 非全量
function SevenDayModule:onSevenDayInfoNtf(event)
    local proto         = event.param
    self._alProgress    = proto.al_progress -- 已领取活跃度数量
    self._alTotal       = proto.total_al    -- 总活跃活跃度
    local day_info_list = proto.day_info_list
    self._maxDay        = proto.max_day
    self._closeTime     = proto.close_time

    for _, v in ipairs(day_info_list or {}) do
        if not self._infoList[v.day] then
            return
        end
        -- 初始化当天的数据结构
        for ti, tv in ipairs(v.tasklist or {}) do
            local myTasklist = self._infoList[v.day].tasklist
            for mti, mtv in ipairs(myTasklist or {}) do
                if tv.taskId == mtv.taskId then
                    myTasklist[mti] = tv
                    break
                end
            end
        end


        for ti, tv in ipairs(v.giftlist or {}) do
            local myGiftlist = self._infoList[v.day].giftlist
            for mgi, mtv in ipairs(myGiftlist or {}) do
                if tv.giftId == mtv.giftId then
                    myGiftlist[mgi] = tv
                    break
                end
            end
        end
    end

    -- 红点
    self:initSevenDayTaskRedTips()
    self:initSevenDayRewardRedTips()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SEVENDAY_LIST_ALL_CHANGE)
end

--获取奖励
function SevenDayModule:onGetSevenDayRewardResp(event)
    local proto = event.param
    local ret   = proto.ret
    -- yflog:Info("--------------------onGetSevenDayRewardResp-" .. ret)
end

--活跃度奖励
function SevenDayModule:onGetSevenDayAlrewardResp(event)
    local proto      = event.param
    local ret        = proto.ret
    self._alProgress = proto.al_progress -- 已领取活跃度数量
    self._alTotal    = proto.total_al    -- 总活跃活跃度
    -- yflog:Info("--------------------onGetSevenDayAlrewardResp-" .. ret)

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SEVENDAY_LIST_CHANGE)
end

