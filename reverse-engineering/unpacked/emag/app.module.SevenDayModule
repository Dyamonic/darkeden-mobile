    local ret   = proto.ret
    -- yflog:Info("--------------------onSevenTaskJumpMapResp-" .. ret)
end

----------------------------方法----------------------------
-- 活跃度
function SevenDayModule:getSevenDayMaxDay()
    local maxDay = self._maxDay or 0
    maxDay = math.min(maxDay, 7)
    return maxDay or 0
end

function SevenDayModule:getSevenDayCloseTime()
    return self._closeTime or 0
end

function SevenDayModule:getSevenDayAl()
    return self._alTotal or 0, self._alProgress or 0
end

function SevenDayModule:getSevenDayListInfo()
    return self._infoList or {}
end

function SevenDayModule:getSevenDayTaskInfo(day, taskId)
    if self._infoList or self._infoList[day] then
        return nil
    end
    local list = self._infoList[day].tasklist
    for i, v in ipairs(list or {}) do
        if v.taskId == taskId then
            return v
        end
    end
    return nil
end

function SevenDayModule:getSevenDayRewardInfo(day, giftId)
    if self._infoList or self._infoList[day] then
        return nil
    end
    local list = self._infoList[day].giftlist
    for i, v in ipairs(list or {}) do
        if v.giftId == giftId then
            return v
        end
    end
    return nil
end

-- 根据种族分类
function SevenDayModule:getSevenDayMap()
    local heroData = GameModule:getHeroData()
    if not heroData then
        return {}
    end
    local myRace = heroData:getRace()
    local list = CacheManager:getSevenDayMissionMap()
    local mapTable = {}
    for i, meta in pairs(list or {}) do
        local condi = tonumber(meta:getRace()) or 0
        if condi == 0 or myRace == condi then
            local first = meta:getActivityDay()
            if not mapTable[first] then
                mapTable[first] = {}
            end
            table.insert(mapTable[first], meta)
        end
    end
    return mapTable
end

function SevenDayModule:getSevenDayTaskMap(day)
    if not self._infoList or not self._infoList[day] then
        return {}
    end
    local tasklist = self._infoList[day].tasklist or {}
    table.sort(tasklist, function(a, b)
        if a.taskState == Constant.TASK_STATE.FINISH and b.taskState ~= Constant.TASK_STATE.FINISH then
            return true
        elseif a.taskState ~= Constant.TASK_STATE.FINISH and b.taskState == Constant.TASK_STATE.FINISH then
            return false
        else
            if a.taskState == b.taskState then
                return a.taskId < b.taskId
            else
                return a.taskState < b.taskState
            end
        end
    end
    )
    return tasklist
end

function SevenDayModule:getSevenDayGiftMap(day)
    if not self._infoList or not self._infoList[day] then
        return {}
    end
    local giftlist = self._infoList[day].giftlist or {}
    table.sort(giftlist, function(a, b)
        return a.giftId < b.giftId
    end
    )
    return giftlist
end

-- 根据种族分类
function SevenDayModule:getActivityGiftMap()
    local heroData = GameModule:getHeroData()
    if not heroData then
        return {}
    end
    local myRace = heroData:getRace()
    local list = CacheManager:getActivityGiftMap()
    local mapTable = {}
    for i, meta in pairs(list or {}) do
        local condi = tonumber(meta:getRace()) or 0
        if condi == 0 or myRace == condi then
            local first = meta:getActivityType()
            local second = meta:getDate()
            if not mapTable[first] then
                mapTable[first] = {}
            end
            if not mapTable[first][second] then
                mapTable[first][second] = {}
            end
            table.insert(mapTable[first][second], meta)
        end
    end
    return mapTable
end

-- 根据种族分类
function SevenDayModule:getALTreasureMap()
    local heroData = GameModule:getHeroData()
    if not heroData then
        return {}
    end
    local myRace = heroData:getRace()
    local list = TaskModule:getALTreasureMeta(Constant.ALType.SEVENDAY) or {}
    local mapTable = {}
    for i, meta in pairs(list or {}) do
        local condi = tonumber(meta:getRace()) or 0
        if condi == 0 or myRace == condi then
            table.insert(mapTable, meta)
        end
    end
    return mapTable
end

----------------------------红点----------------------------
--判断任务是否完成
function SevenDayModule:checkSevenDayTaskComplete(day)
    if not self._infoList[day] then
        return false
    end
    local list = self._infoList[day].tasklist
    for i, v in ipairs(list or {}) do
        if v.taskState == Constant.TASK_STATE.FINISH then
            return true
        end
    end
    return false
end

-- 是否可以领取
function SevenDayModule:setSevenDayTaskRedTips(day, bool)
    -- yflog:Info("------------SevenDayTaskRedTips-" .. day .. "bool-" .. tostring(bool))
    RedDotModule:setTipsStateByName("SevenDayTaskRedTips" .. day, bool)
end

function SevenDayModule:setSevenDayRewardRedTips(day, bool)
    -- yflog:Info("------------SevenDayTaskRewardTips-" .. day .. "bool-" .. tostring(bool))
    RedDotModule:setTipsStateByName("SevenDayTaskRewardTips" .. day, bool)
end

function SevenDayModule:setSevenDayBoxRedTips(bool)
    -- yflog:Info("------------SevenDayTaskBoxTips-" .. tostring(bool))
    RedDotModule:setTipsStateByName("SevenDayTaskBoxTips", bool)
end

function SevenDayModule:getSevenDayTaskRedTips(day)
    return RedDotModule:getTipsStateByName("SevenDayTaskRedTips" .. day)
end

function SevenDayModule:getSevenDayRewardRedTips(day)
    return RedDotModule:getTipsStateByName("SevenDayTaskRewardTips" .. day)
end

function SevenDayModule:getSevenDayBoxRedTips()
    return RedDotModule:getTipsStateByName("SevenDayTaskBoxTips")
end

function SevenDayModule:getRedPointAll()
    local listData = self._infoList
    for i, v in ipairs(listData or {}) do
        local tpoint = self:getSevenDayTaskRedTips(i)
        if tpoint then
            return true
        end
        local rpoint = self:getSevenDayRewardRedTips(i)
        if rpoint then
            return true
        end
        local box = self:getSevenDayBoxRedTips()
        if box then
            return true
        end
    end
    return false
end

-- 初始化任务
function SevenDayModule:initSevenDayTaskRedTips()
    local tasklist = self._infoList
    for i, v in ipairs(tasklist or {}) do
        local hasUnclaimed = false
        for ii, vv in ipairs(v.tasklist or {}) do
            if vv.taskState == Constant.TASK_STATE.FINISH then
                hasUnclaimed = true
                break
            end
        end
        SevenDayModule:setSevenDayTaskRedTips(i, hasUnclaimed)
    end
end

---- 初始化任务
function SevenDayModule:initSevenDayRewardRedTips()
    local infoList = self._infoList
    for i, v in ipairs(infoList or {}) do
        local hasUnclaimed = false
        local giftlist = v.giftlist or {}
        for _, gift in ipairs(giftlist) do
            local giftMeta = CacheManager:getSevenDayGiftMeta(gift.giftId)
            if giftMeta then
                local buyLimit = giftMeta:getBuyLimit()
                local price = giftMeta:getPrice() or 0
                local reward_times = gift.reward_times or 0
                local recharge_times = gift.recharge_times or 0 -- 充值次数
                if price == 0 then
                    if reward_times < buyLimit then             --领取次数 < 限购
                        hasUnclaimed = true
                        break
                    end
                else
                    if recharge_times > reward_times then -- 充值次数 > 领取次数
                        hasUnclaimed = true
                        break
                    end
                end
            end
        end
        SevenDayModule:setSevenDayRewardRedTips(i, hasUnclaimed)
    end
end

function SevenDayModule:initBoxes()
    local boxes = self:getALTreasureMap()
    local curTotalAl, curProgress = self:getSevenDayAl()
    for i = 1, #boxes do
        local alnum = boxes[i]:getALNum() or 0
        local bg = self._boxBtns[i]:getChild("bg")
        local red = self._boxBtns[i]:getChild("red")
        -- 可以领取 给个提醒
        if curProgress < alnum and alnum <= curTotalAl then
            self:setSevenDayBoxRedTips(true)
            return
        end
    end
    self:setSevenDayBoxRedTips(false)
end

return SevenDayModule
