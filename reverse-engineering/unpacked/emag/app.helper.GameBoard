
local GameBoard = {}

GameBoard._deltaTime    = nil
GameBoard._controlParam = nil
GameBoard._skillIdNext  = nil
GameBoard._skillMNext  = nil
GameBoard._skillNNext  = nil
GameBoard._skillMNext2  = nil
GameBoard._skillNNext2  = nil

GameBoard._outRangeTipsElapse = 0
GameBoard._noManaTipsElapse = 0
GameBoard._noTargetTipsElapse = 0

function GameBoard:reset()
    self._deltaTime = 0
end

function GameBoard:onUpdate(delta)
    self:clear()

    self._outRangeTipsElapse = self._outRangeTipsElapse + delta
    if self._outRangeTipsElapse > 2 then
        self:setOutRangeTips(true)
    end
    self._noManaTipsElapse = self._noManaTipsElapse + delta
    if self._noManaTipsElapse > 2 then
        self:setNoManaTips(true)
    end
    self._noTargetTipsElapse = self._noTargetTipsElapse + delta
    if self._noTargetTipsElapse > 2 then
        self:setNoTargetTips(true)
    end
end

function GameBoard:clear()
    -- self._deltaTime    = 0
    self._controlParam = nil
end

function GameBoard:clearSkillNext()
    self._skillIdNext  = nil
    self._skillMNext   = nil
    self._skillNNext   = nil
end

function GameBoard:getOSTime()
    return os.time()
end

-- Setter && Getter
function GameBoard:setDeltaTime(deltaTime)
    -- 系统 deltaTime 0.016666000708938
    self._deltaTime = deltaTime
end

function GameBoard:getDeltaTime()
    return self._deltaTime or 0
end

function GameBoard:setControlParam(controlParam)
    self._controlParam = controlParam
end

function GameBoard:getControlParam()
    return self._controlParam
end

function GameBoard:setSkillIdNext(skillIdNext)
    self._skillIdNext = skillIdNext
end

function GameBoard:getSkillIdNext()
    return self._skillIdNext
end

function GameBoard:setSkillMNext(skillMNext)
    self._skillMNext = skillMNext
end

function GameBoard:getSkillMNext()
    return self._skillMNext
end

function GameBoard:setSkillNNext(skillNNext)
    self._skillNNext = skillNNext
end

function GameBoard:getSkillNNext()
    return self._skillNNext
end

-- 常驻 不会被帧清除
function GameBoard:setSkillMNext2(skillMNext)
    self._skillMNext2 = skillMNext
end

function GameBoard:getSkillMNext2()
    return self._skillMNext2
end

function GameBoard:setSkillNNext2(skillNNext)
    self._skillNNext2 = skillNNext
end

function GameBoard:getSkillNNext2()
    return self._skillNNext2
end

function GameBoard:clearSkillMNNext2()
    self._skillMNext2 = nil
    self._skillNNext2 = nil
end

-- 用于一次性消息提示
function GameBoard:setSkillTipsOn()
    self:setOutRangeTips(true)
    self:setNoTargetTips(true)
    self:setNoManaTips(true)
end

function GameBoard:setOutRangeTips(outRangeTips)
    self._outRangeTips = outRangeTips

    if not self._outRangeTips then
        self._outRangeTipsElapse = 0
    end
end
function GameBoard:isOutRangeTips()
    return self._outRangeTips
end

function GameBoard:setNoTargetTips(noTargetTips)
    self._noTargetTips = noTargetTips

    if not self._noTargetTips then
        self._noTargetTipsElapse = 0
    end
end
function GameBoard:isNoTargetTips()
    return self._noTargetTips
end

function GameBoard:setNoManaTips(noManaTips)
    self._noManaTips = noManaTips

    if not self._noManaTips then
        self._noManaTipsElapse = 0
    end
end
function GameBoard:isNoManaTips()
    return self._noManaTips
end

return GameBoard
