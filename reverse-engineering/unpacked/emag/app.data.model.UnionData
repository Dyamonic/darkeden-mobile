
local UnionData = class("UnionData")

local Constant = lt.Constant
local StringManager = lt.StringManager

UnionData._unionId     = nil  -- 
UnionData._name        = nil  -- 
UnionData._num         = nil  -- 
UnionData._limitLv     = nil  -- 限制等级
UnionData._text        = nil  -- 
UnionData._masterName  = nil  -- 

UnionData._onlineNum   = nil  -- 
UnionData._memberArray = nil  -- 成员信息
UnionData._jobArray    = nil  -- 职位列表
UnionData._purviewArray= nil  -- 职位列表

function UnionData:ctor(perUnionData)
    assert(perUnionData ~= nil, "perUnionData is nil !")
    self._memberArray = {}
    self._jobArray = {}
    self._purviewArray = {}
    self:initUnionData(perUnionData)
end

function UnionData:initUnionData(perUnionData)
    self._unionId = perUnionData.guildID
    self._name = perUnionData.guildName
    self._num = perUnionData.playerNum
    self._limitLv = perUnionData.joinLevel
    self._text = perUnionData.recruitText
    self._noticeText = perUnionData.noticeText
    self._masterName = perUnionData.masterName
    self._condition = perUnionData.joinOption
    self._applyState = perUnionData.applyState
    self._declareWarCount = perUnionData.declareWarCount
    self._warInfoList = perUnionData.warInfoList

    self._onlineNum = perUnionData.onlineNum
    self:initJobInfo(perUnionData.CustomizeDutyInfo)

    for i,v in ipairs(perUnionData.memberInfo) do
        local member = lt.UnionMemberData.new(v)
        if self._jobArray[member:getUnionJob()] then
            member:setUnionJobName(self._jobArray[member:getUnionJob()])
        end
        table.insert(self._memberArray, member)
    end
    for i,v in ipairs(perUnionData.guildAuthorityInfo) do
        local purview = lt.UnionPurviewData.new(v)
        table.insert(self._purviewArray, purview)
    end
    if self._purviewArray and #self._purviewArray > 1 then 
        table.sort(self._purviewArray, function(a,b)
            return a:getJob() < b:getJob()
        end)
    end
    -- self:dump()
end

function UnionData:initJobInfo(jobStr)
    if not jobStr then  return end
    
    local msg = string.split(jobStr,";")
    for i=1,#msg do
        local ns = msg[i] ~= "" and msg[i] or StringManager:getDefaultUnionJobName(i)
        table.insert(self._jobArray, ns)
    end
end

function UnionData:getUnionId()
    return self._unionId
end

function UnionData:getName()
    return self._name
end

function UnionData:getNum()
    return self._num
end

function UnionData:getLimitLv()
    return self._limitLv
end

function UnionData:getCondition()
    return self._condition or 1
end

function UnionData:getText()
    return self._text
end

function UnionData:getNoticeText()
    return self._noticeText
end

function UnionData:getMasterName()
    return self._masterName
end

function UnionData:getOnlineNum()
    return self._onlineNum
end

function UnionData:getMemberArray()
    return self._memberArray
end

function UnionData:getJobArray()
    return self._jobArray
end

function UnionData:getJobName()
    return self._jobName
end

function UnionData:getPurviewArray()
    return self._purviewArray or {}
end

function UnionData:setApplyState(value)
    self._applyState = value
end

function UnionData:getApplyState()
    return self._applyState or 0
end

function UnionData:getDeclareNum()
    return self._declareWarCount
end

function UnionData:setDeclareNum(num)
    self._declareWarCount = num
end

function UnionData:getWarList()
    return self._warInfoList
end

function UnionData:dump()
    lt.LogUtil:debug(">>>>>>>>>>>>>>>>>>>> UnionData >>>>>>>>>>>>>>>>>>>>")
    lt.LogUtil:debug("self._unionId = "..tostring(self._unionId))
    lt.LogUtil:debug("self._name = "..tostring(self._name))
    lt.LogUtil:debug("self._num = "..tostring(self._num))
    lt.LogUtil:debug("self._limitLv = "..tostring(self._limitLv))
    lt.LogUtil:debug("self._text = "..tostring(self._text))
    lt.LogUtil:debug("self._masterName = "..tostring(self._masterName))
    lt.LogUtil:debug("self._onlineNum = "..tostring(self._onlineNum))
    lt.LogUtil:debug("<<<<<<<<<<<<<<<<<<<< UnionData <<<<<<<<<<<<<<<<<<<<")
end

return UnionData
