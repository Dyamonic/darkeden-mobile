local PrivilegeDao = {}


function PrivilegeDao:queryAll()
    local mapTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Privilege") do
        local mapMeta = lt.PrivilegeMeta.new(row)
        mapTable[mapMeta:getId()] = mapMeta
    end
    return mapTable
end

return PrivilegeDao
