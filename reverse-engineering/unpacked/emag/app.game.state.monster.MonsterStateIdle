
local MonsterStateIdle = class("MonsterStateIdle", lt.MonsterStateBase)

local Constant = lt.Constant

MonsterStateIdle._timeTriggerHit = nil
MonsterStateIdle._sabukWallDoor = false
MonsterStateIdle._sabukWallDoorIdx = nil

MonsterStateIdle._isHit = false

function MonsterStateIdle:ctor(monsterAgent)
    MonsterStateIdle.super.ctor(self, monsterAgent)

    --[[ 沙巴克城墙门
    local modelId = monsterAgent:getMonsterData():getModelId()
    self._sabukWallDoor = modelId >= 20187 and modelId <= 20193
    ]]
end

function MonsterStateIdle:onClear()
end

function MonsterStateIdle:onEnter()
    self:updateAction()
end

function MonsterStateIdle:onExit()
end

function MonsterStateIdle:updateAction()
    if self._sabukWallDoor then
        -- 门的动作收到血量影响
        local actionArray = {84, 83, 82, 81, Constant.ROLE_ACTION_IDLE}
        local hpPercent = self._monsterAgent:getMonsterData():getHpPercent()
        local idx = math.ceil(hpPercent * #actionArray)
        if not self._sabukWallDoorIdx or self._sabukWallDoorIdx ~= idx and idx > 0 then
            self._sabukWallDoorIdx = idx
            self._monsterAgent:playAction(actionArray[idx])
        end
    else
        self._monsterAgent:playAction(Constant.ROLE_ACTION_IDLE)
    end
end

function MonsterStateIdle:onUpdate()
    -- 受击动作
    if self._timeTriggerHit and self._timeTriggerHit:tick(lt.GameBoard:getDeltaTime()) then
        self._timeTriggerHit = nil
        self._isHit = false
        self._monsterAgent:playAction(Constant.ROLE_ACTION_IDLE)
    end

    if self._delayTimeHitTrigger and self._delayTimeHitTrigger:tick(lt.GameBoard:getDeltaTime()) then
        self._delayTimeHitTrigger = nil
        self._monsterAgent:playAction(Constant.ROLE_ACTION_Hit)
    end

    if self._sabukWallDoor then
        self:updateAction()
    end

    local isDeathExplosion = self._monsterAgent:isDeathExplosion()
    if isDeathExplosion then
        -- 队列检查需要执行的命令
        local cmd = self._monsterAgent:getCmdSystem():pop()
        if cmd then
            self._monsterAgent:handleCmd(cmd)
            return
        end
    end
    
    -- 优先检查是否死亡
    local cmd = self._monsterAgent:getDieCmd()
    if cmd then
        self._monsterAgent:handleCmd(cmd)
        return
    end

    if not isDeathExplosion then
        -- 队列检查需要执行的命令
        local cmd = self._monsterAgent:getCmdSystem():pop()
        if cmd then
            self._monsterAgent:handleCmd(cmd)
        end
    end
end

function MonsterStateIdle:onMessage(msg)
    if msg.msgId == Constant.MSG_ON_HIT then
        if self._isHit then
            return
        end
        if not self._sabukWallDoor then
            self._isHit = true
            -- 延迟受击动作
            self._delayHitTime = tonumber(msg.delayTime)
            if self._delayHitTime == 0 then
                self._monsterAgent:playAction(Constant.ROLE_ACTION_Hit)
            else
                self._delayTimeHitTrigger = lt.TimeTrigger.new(self._delayHitTime)
            end

            self._timeTriggerHit = lt.TimeTrigger.new(0.3 + self._delayHitTime)
        end
    end
end

function MonsterStateIdle:getStateId()
    return Constant.MONSTER_STATE_IDLE
end

function MonsterStateIdle:getStateName()
    return "MonsterStateIdle"
end

return MonsterStateIdle
