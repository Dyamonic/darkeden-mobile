local MaskGLProgramState = class("MaskGLProgramState")

local ccbEngine = ccb
local ccEngine = cc
local ShaderBackendUtil = lt.ShaderBackendUtil

MaskGLProgramState._program       = nil
MaskGLProgramState._programState  = nil

function MaskGLProgramState:ctor(node, maskNode, program)
    -- 创建state
    self._programState = ccbEngine.ProgramState:new(program)

    local nodeSize = node:getContentSize()
    local maskSize = maskNode:getContentSize()

    self._node = node
    self._maskNode = maskNode

    local rect = node:getTextureRect()
    local textureWidth  = node:getTexture():getPixelsWide()
    local textureHeight  = node:getTexture():getPixelsHigh()

    self._node_frameRect = cc.vec4(rect.x / textureWidth, rect.y / textureHeight, rect.width / textureWidth, rect.height / textureHeight)
    self._altas_size = cc.p(textureWidth, textureHeight)

    self._node_size = cc.p(nodeSize.width, nodeSize.height)
    self._mask_size = cc.p(maskSize.width, maskSize.height)

    self:initBase()
end

function MaskGLProgramState:onClear()
    -- node 是用的池子里的，所以需要将node还原
    if self._node then
        ShaderBackendUtil:makeNodeToNormal(self._node)
        self._node = nil
    end
    if self._programState then
        self._programState = nil
    end

    -- self._node = nil
    self._maskNode = nil
end

--[[
    设置ProgramState的参数
]]
function MaskGLProgramState:initBase()
    local programState = self._programState
    -- self._node_frameRect
    -- yflog:Info("self._node_frameRect x:%s y:%s z:%s w:%s", self._node_frameRect.x,self._node_frameRect.y,self._node_frameRect.z,self._node_frameRect.w)
    -- 顶点坐标rect参数
    programState:setUniform("u_frameRect", ccEngine.bytearray.from_vec4(self._node_frameRect))
    programState:setUniform("u_atlasSize", ccEngine.bytearray.from_vec2(self._altas_size))

    local dest = programState:getUniformLocation("u_mask_texture")
    programState:setTexture(dest, ccEngine.ShaderStage.VERTEX_AND_FRAGMENT, self._maskNode:getTexture():getBackendTexture())

    -- yflog:Info("self.node_size:%s, self.mask_size:%s", yflog:Positon(self._node_size), yflog:Positon(self._mask_size))

    programState:setUniform("sp_size", ccEngine.bytearray.from_vec2(self._node_size))
    programState:setUniform("mask_size", ccEngine.bytearray.from_vec2(self._mask_size))
    programState:setUniform("v_offset", ccEngine.bytearray.from_vec2(cc.p(0, 0)))
    programState:setUniform("u_enable", ccEngine.bytearray.from_float(1.0))
    self:updateRotated(false)
end

function MaskGLProgramState:updateOffset(offset)
    -- yflog:Info("offset.x:%d, offset.y:%d ",offset.x, offset.y)
    self._programState:setUniform("v_offset", ccEngine.bytearray.from_vec2(offset))
end

function MaskGLProgramState:updateEnable(enable)
    local u_enable = 1.0
    if not enable then
        u_enable = 0.0
    end

    self._programState:setUniform("u_enable", ccEngine.bytearray.from_float(u_enable))
end

function MaskGLProgramState:updateRotated(isRotated)
    local u_isRotated = 1.0
    if not isRotated then
        u_isRotated = 0.0
    end

    self._programState:setUniform("u_isRotated", ccEngine.bytearray.from_float(u_isRotated))
end

function MaskGLProgramState:getProgramState()
    return self._programState
end

function MaskGLProgramState:getMaskSize()
    return self._mask_size
end

function MaskGLProgramState:getNodeSize()
    return self._node_size
end


return MaskGLProgramState

