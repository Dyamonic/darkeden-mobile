---@class CompBullet 主界面-目标血条
local CompBullet = class("CompBullet", lt.UICompBase)

local GameModule = lt.GameModule
local Constant = lt.Constant
local NtfManager = lt.NtfManager
local AutoFightManager = lt.AutoFightManager

function CompBullet:ctor(view)
    CompBullet.super.ctor(self)
    self._view = view
    self:initUI()
end

function CompBullet:onClear()
    CompBullet.super.onClear(self)
    self._view = nil
end

function CompBullet:initUI()

end

function CompBullet:onEnter()
    self._race = GameModule:getHeroRace()
    -- 只有人族才有子弹
    if self._race ~= lt.Constant.RaceType.Slayer then
        self._view:setVisible(false)
        return
    end
    self:refreshBulletInfo()
    self:addAllListener()
end

function CompBullet:onExit()
    self:removeAllListener()
end

function CompBullet:addAllListener()
    NtfManager:addNtfListener(lt.NtfManager.NTF.NTF_UPDATE_HERO_EQUIP_EVENT, handler(self, self.refreshBulletInfo), "CompBullet:EQUIP")
end

function CompBullet:removeAllListener()
    NtfManager:removeNtfListenerByTag("CompBullet:EQUIP")
end

-- 刷新子弹信息
function CompBullet:refreshBulletInfo()
    local trans = self._view:getTransition("t0")
    local item = lt.ItemModule:getEquipItemByPos(Constant.SlayerEquipPos.Arms)
    if not item then
        self._view:setVisible(false)
        trans:setPaused(false)
        return
    end
    
    local itemConfig = item:getItemMeta()
    local itemType = itemConfig:getType()
    local isGun = Constant.IsGun[itemType]
    if not isGun then
        self._view:setVisible(false)
        trans:setPaused(false)
        return
    end
    -- 检查装备类型是否是子弹
    local bulletMax = item:getAmmoMaxCount()
    local bullet = item:getAmmoCount()

    --取消装弹状态
    if AutoFightManager:isAddBullet() and bullet == bulletMax then
        AutoFightManager:setAddBullet(false)
    end
    
    yflog:Info("-------->>>>>>>>bulletMax:%s,bullet:%s",bulletMax,bullet)
    local num = self._view:getChild("num")
    num:setText(bullet)
    num:setColor(Constant.COLOR_TEXT_WHITE)

    local imageIcon = self._view:getChild("icon")
    imageIcon:setColor(Constant.COLOR_TEXT_WHITE)
    imageIcon:setAlpha(1)
    num:setAlpha(1)

    local percent = bullet / bulletMax
    local showAction = false
    if percent < 0.2 then
        showAction = true
        num:setColor(Constant.COLOR_TITLE_YELLOW)
    end

    if bullet == 0 then
        showAction = true
        num:setColor(Constant.COLOR_TEXT_RED)
        imageIcon:setColor(Constant.COLOR_TEXT_RED)
    end

    if showAction then
        trans:setPaused(false)
    else
        trans:setPaused(true)
    end
    
    self._view:setVisible(true)
end

return CompBullet