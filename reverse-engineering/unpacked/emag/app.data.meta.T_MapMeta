
local MapMeta = class("MapMeta")



function MapMeta:ctor(row)
	self:initWithRow(row)
end

function MapMeta:initWithRow(row)
    self._mapCode   = row.MapCode
    self._mapName   = row.MapName
    self._musicId   = row.MusicId
    self._resCode   = row.ResCode
    self._minimapId = row.MinimapCode
    self._mapLevel  = row.MapLevel
    self._mapCoord  = row.MapCoord
    self._mapArea   = row.MapArea
    self._rectJson  = row.RectJson
    self._width     = row.Width
    self._height    = row.Height
    self._wholeMapSafe = row.WholeMapSafe
    self._upMapId   = row.UpMapId
    self._downMapId = row.DownMapId
    self._testInterphone  = row.TestInterphone
end

function MapMeta:getLvlRecommend()
    if self._mapLevel == "" then
        return
    end

    local mapLevel = self._mapLevel:gsub("%[", ""):gsub("%]", "")
    local levelTabel = string.split(mapLevel, ",")
    return tonumber(levelTabel[1]), tonumber(levelTabel[2])
end

function MapMeta:isSmallMap()
    if tonumber(self._mapCode) >= 61 and tonumber(self._mapCode) <= 64 then
        return true
    end
    return false
end

function MapMeta:isLimitSkill()
    return tonumber(self._wholeMapSafe) == 1
end

-- AUTO GENERATED GETTERS START
-- 以下方法由脚本自动生成，请勿手动修改

function MapMeta:getMapCode() return self._mapCode end
function MapMeta:getMapName() return self._mapName end
function MapMeta:getMusicId() return self._musicId end
function MapMeta:getResCode() return self._resCode end
function MapMeta:getMinimapId() return self._minimapId end
function MapMeta:getMapLevel() return self._mapLevel end
function MapMeta:getMapCoord() return self._mapCoord end
function MapMeta:getMapArea() return self._mapArea end
function MapMeta:getRectJson() return self._rectJson end
function MapMeta:getWidth() return self._width end
function MapMeta:getHeight() return self._height end
function MapMeta:getWholeMapSafe() return self._wholeMapSafe end
function MapMeta:getUpMapId() return self._upMapId end
function MapMeta:getDownMapId() return self._downMapId end
function MapMeta:getTestInterphone() return self._testInterphone end

-- AUTO GENERATED GETTERS END
return MapMeta
