
require("game")
require("app.Init")
require("app.log.Log")

_GURL = nil --FGUI URL 管理


local Game = class("Game", cc.load("mvc").AppBase)

function Game:onCreate()
    math.randomseed(os.time())

    if _G_Game and _G_Game.clear then
        _G_Game:clear()
    end
    _G_Game = self

    self:init()
end

function Game:init()
    self:initSearchPath()    
    -- 不锁屏 TODO:C++实现
    -- cc.Device:setKeepScreenOn(true)

    math.newrandomseed()
    
    _GURL= lt.FGUIURL

    lt.ReadTextManager:init()   -- 文本初始化
    lt.MathTableManger:init()
    lt.PrefManager:init()
    lt.NtfManager:init()
    lt.DbManager:init()
    lt.AssetManager:init()
    lt.GameManager:init()
    lt.SocketApi:init()
    lt.PoolManager:init()
    lt.StringManager:init()
    lt.RoleModule:init()
    lt.ShaderBackendUtil:init()
    lt.AudioManager:init()
    lt.AutoManager:init()
    lt.SkillCdManager:init()
    lt.UIManager:init()
    lt.UIMgr:init()
    lt.ConnectManager:init()
    lt.MapbinManager:init()
    lt.MapManager:init()
    lt.SkeletonManager:init()
    lt.ActionManager:init()
    lt.EffectManager:init()
    lt.EffectPoolManager:init()
    lt.FGuiManager:init()

    

    cpp.RouteManager:getInstance():init()

    -- 判断是否第一次启动
    if lt.PrefManager:getInitialized() ~= lt.PrefManager.STRING_TRUE then
        lt.PrefManager:setInitialized()
    end

    self:executeLuajit()

    local timeCounter = lt.TimeCounter.new("load xml")
    cpp.MapManager:getInstance():init("map/list_objects.xml", "map/list_smtiles.xml")
    timeCounter:finish()

    -- 注册
    local eventDispatcher = cc.Director:getInstance():getEventDispatcher()
    self._customListenerClearSession = cc.EventListenerCustom:create("onClearSession", handler(self, self.onClearSession))
    eventDispatcher:addEventListenerWithFixedPriority(self._customListenerClearSession, -300)

end

-- 部分模拟器可选择关闭luajit
function Game:executeLuajit()
    if not lt.PrefManager:getLocalLuajit() then
        local isJit = (jit and jit.status and jit.status()) or false
        if isJit then
            jit.off()
            print("============================== close jit ==============================")
        else
            print("Runing under standard lua (JIT not active)")
        end

        isJit = (jit and jit.status and jit.status()) or false
        print("============================== jit status ",isJit," ==============================")
    end
end

-- 初始化索引路径 下载>包体
function Game:initSearchPath()
    if _G_STARTER_MODE then
        return
    end

    if not _G_BASE_SEARCH_PATHS then
        _G_BASE_SEARCH_PATHS = cc.FileUtils:getInstance():getSearchPaths()
    end

    local searchPaths = {}
    local writablePath = device.writablePath

    if device.platform == "mac" or device.platform == "windows" then
        searchPaths[#searchPaths + 1] = writablePath.."download/res/"
        searchPaths[#searchPaths + 1] = writablePath.."download/src/"
        searchPaths[#searchPaths + 1] = writablePath.."download/src/app/thirdparty/protobuf/"
        searchPaths[#searchPaths + 1] = writablePath.."download/"

        if device.platform == "windows" then
            local workPath = ""
            if _G_BASE_SEARCH_PATHS then
                workPath = _G_BASE_SEARCH_PATHS[1]
            end

            searchPaths[#searchPaths + 1] = workPath.."res/"
            searchPaths[#searchPaths + 1] = workPath.."src/"
            searchPaths[#searchPaths + 1] = workPath.."src/app/thirdparty/protobuf/"
            searchPaths[#searchPaths + 1] = workPath
        end
        
        searchPaths[#searchPaths + 1] = "res/"
        searchPaths[#searchPaths + 1] = "src/"
        searchPaths[#searchPaths + 1] = "src/app/thirdparty/protobuf/"
        searchPaths[#searchPaths + 1] = ""
    else
        searchPaths[#searchPaths + 1] = writablePath.."res/"
        searchPaths[#searchPaths + 1] = writablePath.."src/"
        searchPaths[#searchPaths + 1] = writablePath.."src/app/thirdparty/protobuf/"
        searchPaths[#searchPaths + 1] = writablePath

        searchPaths[#searchPaths + 1] = "res/"
        searchPaths[#searchPaths + 1] = "src/"
        searchPaths[#searchPaths + 1] = "src/app/thirdparty/protobuf/"
        searchPaths[#searchPaths + 1] = ""
    end

    cc.FileUtils:getInstance():setSearchPaths(searchPaths)

    print("============================== game search path begin ==============================")
    for i, path in ipairs(searchPaths) do
        print(i, path)
    end
    print("============================== game search path end ==============================")
end

-- 清理内容(因为会切换游戏所以需要清理所有创建的实力 尤其是单例)
function Game:clear()
    Game.super.clear(self)

    lt.PrefManager:clear()
    lt.DbManager:clear()
    lt.GameManager:clear()
    lt.SocketApi:clear()
    lt.PoolManager:clear()
    lt.StringManager:clear()
    lt.ShaderBackendUtil:clear()
    lt.AudioManager:clear()
    lt.AutoManager:clear()
    lt.SkillCdManager:clear()
    lt.UIManager:clear()
    lt.ConnectManager:clear()
    lt.MapbinManager:clear()
    lt.MapManager:clear()
    lt.ReadTextManager:clear()
    lt.SkeletonManager:clear()
    lt.AssetManager:clear()
    lt.ActionManager:clear()
    lt.EffectManager:clear()
    lt.EffectPoolManager:clear()
    lt.FGuiManager:clear()

    local eventDispatcher = cc.Director:getInstance():getEventDispatcher()
    eventDispatcher:removeEventListener(self._customListenerClearSession)
end

function Game:onEnterBackground()
    print("Game:onEnterBackground")
    self._enterBackground = true

    Game.super.onEnterBackground(self)

    -- 断开游戏
    if lt.SocketManager:isAlive() then
        -- 网络挂起
        lt.SocketManager:pending()
    end
end

function Game:onEnterForeground()
    print("Game:onEnterForeground")

    -- 重连
    if self._enterBackground then
        lt.SocketManager:connect()
    end

    Game.super.onEnterForeground(self)

    self._enterBackground = false
end

function Game:onClearSession()
    self._enterBackground = false

    lt.ScheduleUtil:performWithDelayGlobal(function()
        self:resetScene()
    end, 0)
end

-- 代码清理
function Game:reload(deep)
    local loadedTable = package.loaded
    for k,v in pairs(loadedTable) do
        local subStr = string.sub(k, 1, 8)
        if subStr ~= "updater." then
            loadedTable[k] = nil
        end
    end

    if deep then
        for k,v in pairs(lt) do
            if not string.find(k, "Manager") and not isset(lt[k], "init") then
                lt[k] = nil
            end
        end
    end
end

-- 游戏重启
function Game:resetGo()
    lt.ScheduleUtil:performWithDelayGlobal(function()
        require("app.Game"):create():run()
    end, 0)

    self:reload()
end

function Game:resetScene()
    if _G_STARTER_MODE then

        -- 安全的移除 从game场景退出到启动器时，需要更安全的清理数据
        lt.ScheduleUtil:performWithDelayGlobal(function()
            self:clear()
        end, 0)

        _G_Game = nil

        local launcherScene = require("launcher.LauncherScene").new()
        display.runScene(launcherScene)
    else
        -- 普通模式
        local initScene = lt.InitScene.new(true)
        display.runScene(initScene)
    end
end

function Game:run()
    if _G_STARTER_MODE then
        -- 启动器模式
        local layer = lt.InitLauncherLayer.new()
        local scene = display.getRunningScene()
        if scene then
            scene:addDelegateLayer(layer)
        end
    else
        local initScene = lt.InitScene.new()
        display.runScene(initScene)
    end
end

return Game
