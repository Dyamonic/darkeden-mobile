---@class UICompLeaderDropItem
local UICompLeaderDropItem = class("UICompLeaderDropItem", lt.UIGButtonBase)

local NtfManager    = lt.NtfManager
local Constant      = lt.Constant

function UICompLeaderDropItem:ctor()
    UICompLeaderDropItem.super.ctor(self)
end
   
function UICompLeaderDropItem:onConstruct()
    self._item = fgui.UIPackage:createObject("Item", "Item")
    self._item:setPivot(0.5, 0.5, true)
    self:getChild("node_item"):addChild(self._item)
end

function UICompLeaderDropItem:onClear()
    self._item = nil
    self._info = nil
end

function UICompLeaderDropItem:onEnter()
    self._item:addClickListener(function()
        self:showTips()
    end)
end

function UICompLeaderDropItem:onExit()
    self._item:removeClickListener()
end

function UICompLeaderDropItem:setObjInfo(info)
    self._itemInfo = info
    self._item:setItemInfo(info)
    self._item:setItemNums("")
    self._item:insertObjectToFactory(self:getRegClass())
end

function UICompLeaderDropItem:showTips()
    local itemType = self._itemInfo:getItemType()
    if itemType ==  Constant.ItemType.ITEM_TYPE_PROP then
        self:showPropTips()
    elseif itemType ==  Constant.ItemType.ITEM_TYPE_EQUIP then
        self:showEquipTips()
    end
end

function UICompLeaderDropItem:showPropTips()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = self._itemInfo, tipsType = Constant.PROPTIPS_FORM.Display})
end

function UICompLeaderDropItem:showEquipTips()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = self._itemInfo, tipsType = Constant.EquipShowTipsType.Display})
end

return UICompLeaderDropItem