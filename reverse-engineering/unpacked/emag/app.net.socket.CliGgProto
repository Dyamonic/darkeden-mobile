
require("pack")
local pack=string.pack

local CliGgProto = {}

CliGgProto._DecodePkgArray = {}
CliGgProto._netdata = lt.NetData.new()

CliGgProto.ROLENAME_MAX_LEN = 32
CliGgProto.ROLE_MAX_NUM_ALL = 10
CliGgProto.PROTO_SUCCESS = 1
CliGgProto.PROTO_FAILURE = 0
CliGgProto.TIME_STRING_LEN = 20
CliGgProto.PLAYERID_STRING_LEN = 21
CliGgProto.PTID_LEN = 64
CliGgProto.PASSWORD_LEN = 33
CliGgProto.ACCOUNT_LEN = 33
CliGgProto.LOGIN_MY = 1
CliGgProto.LOGIN_AP = 2
CliGgProto.INVITECODE_LEN = 12


----------------------------------------------------
CliGgProto.CLIGGPROTO_MSGID_OFFSET = 19
CliGgProto.CLIGGPROTO_MSGID_RANGE  = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 19

CliGgProto.MessageID =
{
	CLI_GG_Login_REQ              = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 1,
	GG_CLI_Login_ACK              = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 2, 

	CLI_GG_SelectRole_REQ         = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 3, 
	GG_CLI_SelectRole_ACK         = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 4, 

	CLI_GG_CreateRole_REQ         = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 5, 
	GG_CLI_CreateRole_ACK         = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 6, 

	CLI_GG_DelRole_REQ            = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 7, 
	GG_CLI_DelRole_ACK            = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 8, 

	CLI_GG_ReselRole_REQ          = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 9, 
	GG_CLI_ReselRole_ACK          = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 10, 

	CLI_GG_UnDelRole_REQ          = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 11, 
	GG_CLI_UnDelRole_ACK          = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 12, 

	GG_CLI_KickOff_NTF            = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 13, 
	CLI_GG_Logout_NTF             = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 14, 
	GG_CLI_WaitQue_NTF            = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 15, 

	CLI_GG_GS_MSG             	  = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 16, 
	GS_GG_CLI_MSG                 = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 17, 

	CLI_GG_VerifyUserName_REQ     = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 18,  --37
    GG_CLI_VerifyUserName_ACK     = CliGgProto.CLIGGPROTO_MSGID_OFFSET + 19,  --38
}

----------------------------------------------------------

function CliGgProto:init()

	self._DecodePkgArray[CliGgProto.MessageID.GG_CLI_Login_ACK]=CliGgProto.PKG_GG_CLI_Login_ACK
	self._DecodePkgArray[CliGgProto.MessageID.GG_CLI_SelectRole_ACK]=CliGgProto.PKG_GG_CLI_SelectRole_ACK
	self._DecodePkgArray[CliGgProto.MessageID.GG_CLI_CreateRole_ACK]=CliGgProto.PKG_GG_CLI_CreateRole_ACK
	self._DecodePkgArray[CliGgProto.MessageID.GG_CLI_DelRole_ACK]=CliGgProto.PKG_GG_CLI_DelRole_ACK
	self._DecodePkgArray[CliGgProto.MessageID.GG_CLI_ReselRole_ACK]=CliGgProto.PKG_GG_CLI_ReselRole_ACK
	self._DecodePkgArray[CliGgProto.MessageID.GG_CLI_UnDelRole_ACK]=CliGgProto.PKG_GG_CLI_UnDelRole_ACK
	self._DecodePkgArray[CliGgProto.MessageID.GG_CLI_KickOff_NTF]=CliGgProto.PKG_GG_CLI_KickOff_NTF
	self._DecodePkgArray[CliGgProto.MessageID.GG_CLI_WaitQue_NTF]=CliGgProto.PKG_GG_CLI_WaitQue_NTF
	self._DecodePkgArray[CliGgProto.MessageID.GG_CLI_VerifyUserName_ACK]=CliGgProto.PKG_GG_CLI_VerifyUserName_ACK
	
end


function CliGgProto:getDataLen()
	return self._netdata:getDataLen()
end

function CliGgProto:getData()
	return self._netdata:getData()
end

function CliGgProto:beatHeart()
	self._netdata:reset()

	self._netdata:writeWord(20000)
	self._netdata:writeWord(0)
	self._netdata:writeByte(0)
	self._netdata:writeByte(0)
	return self._netdata:getData()
end

function CliGgProto:encode(MsgID, MsgData)
	if(MsgID<=CliGgProto.CLIGGPROTO_MSGID_OFFSET or MsgID>CliGgProto.CLIGGPROTO_MSGID_RANGE) then
		return nil
	end

	self._netdata:reset()

	self._netdata:writeWord(MsgID)
	self._netdata:writeWord(0)
	self._netdata:writeByte(0)
	self._netdata:writeByte(0)

	MsgData:pack()

	local bodylen = self._netdata:getDataLen() - 6
	szBodylen = pack(">H",bodylen)
	self._netdata:set(2,szBodylen)
	
	return self._netdata:getData()
end

function CliGgProto:decode(MsgID, byArray, len)

	if(MsgID<=CliGgProto.CLIGGPROTO_MSGID_OFFSET or MsgID>CliGgProto.CLIGGPROTO_MSGID_RANGE) then
		return nil
	end

	local pkg = self._DecodePkgArray[MsgID]
	if pkg == nil then
		return nil
	end
	self._netdata:reset()
	self._netdata:prepare(byArray,len)

	local msg = pkg.new()
	msg:unPack()

	if self._netdata:getError() ~= 0 then
		return nil
	end

	return msg
end

