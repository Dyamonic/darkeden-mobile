----------------------------------------------------------
--------小退回应------
CliGgProto.PKG_GG_CLI_ReselRole_ACK=class("PKG_GG_CLI_ReselRole_ACK")
--成员
CliGgProto.PKG_GG_CLI_ReselRole_ACK._byResult = 0
CliGgProto.PKG_GG_CLI_ReselRole_ACK._stReply = nil
--构造
function CliGgProto.PKG_GG_CLI_ReselRole_ACK:ctor()
	self._byResult = byResult
	self._stReply = nil
end

function CliGgProto.PKG_GG_CLI_ReselRole_ACK:unPack()
	self._byResult = CliGgProto._netdata:readByte()

	if self._byResult==CliGgProto.PROTO_SUCCESS then
		self._stReply = CliGgProto.SRoleList.new()
	elseif self._byResult==CliGgProto.PROTO_FAILURE then
		self._stReply = CliGgProto.SErrCode.new()
	end
	if self._stReply~=nil then
		self._stReply:unPack()
	end 

end

