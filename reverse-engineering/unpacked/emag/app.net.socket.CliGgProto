--------角色列表------


CliGgProto.SRoleList = class("SRoleList")
--成员
CliGgProto.SRoleList._bySelect = 0
CliGgProto.SRoleList._byRoleCount = 0
CliGgProto.SRoleList._astRoleList = nil --SRoleBasicInfo list
--构造

function CliGgProto.SRoleList:ctor()
	self._bySelect = 0
	self._byRoleCount = 0
	self._astRoleList = {} --SRoleBasicInfo list
end

function CliGgProto.SRoleList:pack()

	CliGgProto._netdata:writeByte(self._bySelect)
	CliGgProto._netdata:writeByte(self._byRoleCount)

	for i = 1, self._byRoleCount, 1 do
		self._astRoleList[i]:pack()
	end

end

function CliGgProto.SRoleList:unPack()

	self._bySelect = CliGgProto._netdata:readByte()
	self._byRoleCount = CliGgProto._netdata:readByte()

	if (self._byRoleCount > CliGgProto.ROLE_MAX_NUM_ALL) then
       return
    end

	for i = 1, self._byRoleCount, 1 do
		self._astRoleList[i] = CliGgProto.SRoleBasicInfo.new()
		self._astRoleList[i]:unPack()
	end

end
