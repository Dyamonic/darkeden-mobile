CliGgProto.PKG_GG_CLI_Login_SUC=class("PKG_GG_CLI_Login_SUC")
--成员
CliGgProto.PKG_GG_CLI_Login_SUC._szPTID = ""
CliGgProto.PKG_GG_CLI_Login_SUC._stLoginData = nil;
CliGgProto.PKG_GG_CLI_Login_SUC._stRoleList= nil
--构造
function CliGgProto.PKG_GG_CLI_Login_SUC:ctor()
	self._szPTID = ""
	self._stLoginData= CliGgProto.LoginData.new()
	self._stRoleList= CliGgProto.SRoleList.new()
end

function CliGgProto.PKG_GG_CLI_Login_SUC:unPack()
	self._szPTID = CliGgProto._netdata:readString(CliGgProto.PTID_LEN)
	self._stLoginData:unPack()
	self._stRoleList:unPack()
end

----------------------------------------------------------
--------登录回应------
CliGgProto.PKG_GG_CLI_Login_ACK=class("PKG_GG_CLI_Login_ACK")
--成员
CliGgProto.PKG_GG_CLI_Login_ACK._byResult = 0
CliGgProto.PKG_GG_CLI_Login_ACK._stReply = nil
--构造
function CliGgProto.PKG_GG_CLI_Login_ACK:ctor()
	self._byResult = 0
	self._stReply = nil
end

function CliGgProto.PKG_GG_CLI_Login_ACK:unPack() 
	self._byResult = CliGgProto._netdata:readByte()

    if self._byResult==CliGgProto.PROTO_SUCCESS then
		self._stReply =  CliGgProto.PKG_GG_CLI_Login_SUC.new()
	elseif self._byResult==CliGgProto.PROTO_FAILURE then
		self._stReply =  CliGgProto.SErrCode.new()
	end

	if self._stReply~=nil then
		self._stReply:unPack()
	end 

end

