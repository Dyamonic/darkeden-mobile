--------请求登录------
CliGgProto.PKG_CLI_GG_Login_REQ=class("PKG_CLI_GG_APLogin_REQ")
--成员
CliGgProto.PKG_CLI_GG_Login_REQ._szAuthAct = ""
CliGgProto.PKG_CLI_GG_Login_REQ._szAuthStr = ""
CliGgProto.PKG_CLI_GG_Login_REQ._wAPType = 0
CliGgProto.PKG_CLI_GG_Login_REQ._dwClientVersion = 0
CliGgProto.PKG_CLI_GG_Login_REQ._wClientType = 0
CliGgProto.PKG_CLI_GG_Login_REQ._dwServerID = 0
CliGgProto.PKG_CLI_GG_Login_REQ._szInviteCode = ""
CliGgProto.PKG_CLI_GG_Login_REQ._dwReserve = 0

--构造
function CliGgProto.PKG_CLI_GG_Login_REQ:ctor()
	self._szAuthAct = ""
	self._szAuthStr = ""
	self._wAPType = 0
	self._dwClientVersion = 0
	self._wClientType = 0
	self._dwServerID = 0
	self._szInviteCode = ""
	self._dwReserve = 0
end


function CliGgProto.PKG_CLI_GG_Login_REQ:pack()
	CliGgProto._netdata:writeString(self._szAuthAct, CliGgProto.ACCOUNT_LEN)
	CliGgProto._netdata:writeString(self._szAuthStr, CliGgProto.PASSWORD_LEN)
	CliGgProto._netdata:writeWord(self._wAPType)
	CliGgProto._netdata:writeDword(self._dwClientVersion)
	CliGgProto._netdata:writeWord(self._wClientType)
	CliGgProto._netdata:writeDword(self._dwServerID)
	CliGgProto._netdata:writeString(self._szInviteCode, CliGgProto.INVITECODE_LEN)
	CliGgProto._netdata:writeDword(self._dwReserve)
end

