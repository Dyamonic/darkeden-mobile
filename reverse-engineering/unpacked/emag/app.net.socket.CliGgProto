CliGgProto.LoginData._nDataLen = 0;
CliGgProto.LoginData._szDataBuf = "";
--构造
function CliGgProto.LoginData:ctor()
	self._nDataLen = 0;
	self._szDataBuf = "";
end

function CliGgProto.LoginData:unPack()
	self._nDataLen = CliGgProto._netdata:readWord()
	self._szDataBuf = CliGgProto._netdata:readBuf(self._nDataLen)
end


