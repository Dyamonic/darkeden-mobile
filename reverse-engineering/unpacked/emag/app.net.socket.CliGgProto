CliGgProto.PKG_CLI_GG_CreateRole_REQ=class("PKG_CLI_GG_CreateRole_REQ")
--成员
CliGgProto.PKG_CLI_GG_CreateRole_REQ._szRoleName = ""
CliGgProto.PKG_CLI_GG_CreateRole_REQ._byPos = 0
CliGgProto.PKG_CLI_GG_CreateRole_REQ._byRace = 0
CliGgProto.PKG_CLI_GG_CreateRole_REQ._bySex = 0
CliGgProto.PKG_CLI_GG_CreateRole_REQ._byFaceShape = 0
CliGgProto.PKG_CLI_GG_CreateRole_REQ._byHairColor = 0
CliGgProto.PKG_CLI_GG_CreateRole_REQ._bySkinColor = 0

CliGgProto.PKG_CLI_GG_CreateRole_REQ._wSTR = 0 --力量
CliGgProto.PKG_CLI_GG_CreateRole_REQ._wDEX = 0 --敏捷
CliGgProto.PKG_CLI_GG_CreateRole_REQ._wINT = 0 --智力
CliGgProto.PKG_CLI_GG_CreateRole_REQ._szInvite = ""
--构造
function CliGgProto.PKG_CLI_GG_CreateRole_REQ:ctor()
	self._szRoleName = ""
	self._byPos = 0
	self._byRace = 0
	self._bySex = 0
	self._byFaceShape = 0
	self._byHairColor = 0
	self._bySkinColor = 0

	self._wSTR = 0
	self._wDEX = 0
	self._wINT = 0
	
	self._szInvite = ""
end

function CliGgProto.PKG_CLI_GG_CreateRole_REQ:pack()
	CliGgProto._netdata:writeString(self._szRoleName, CliGgProto.ROLENAME_MAX_LEN)
	CliGgProto._netdata:writeByte(self._byPos)
	CliGgProto._netdata:writeByte(self._byRace)
	CliGgProto._netdata:writeByte(self._bySex)
	CliGgProto._netdata:writeByte(self._byFaceShape)
	CliGgProto._netdata:writeByte(self._byHairColor)
	CliGgProto._netdata:writeByte(self._bySkinColor)
	
	CliGgProto._netdata:writeWord(self._wSTR)
	CliGgProto._netdata:writeWord(self._wDEX)
	CliGgProto._netdata:writeWord(self._wINT)

	CliGgProto._netdata:writeString(self._szInvite, CliGgProto.INVITECODE_LEN)
end

----------------------------------------------------------
--------创建角色回应------
CliGgProto.PKG_GG_CLI_CreateRole_ACK=class("PKG_GG_CLI_CreateRole_ACK")
--成员
CliGgProto.PKG_GG_CLI_CreateRole_ACK._byResult = 0
CliGgProto.PKG_GG_CLI_CreateRole_ACK._stReply = nil
--构造
function CliGgProto.PKG_GG_CLI_CreateRole_ACK:ctor()
	self._byResult = 0
	self._stReply =  nil
end

function CliGgProto.PKG_GG_CLI_CreateRole_ACK:unPack()
	self._byResult = CliGgProto._netdata:readByte()
	self._stReply =  CliGgProto.URoleOpAck.new(self._byResult)
	self._stReply:unPack()
end

