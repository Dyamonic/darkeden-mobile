--------协议头------
CliGgProto.STNetMsgHeader = class("STNetMsgHeader")
--成员
CliGgProto.STNetMsgHeader._wMsgID = 0
CliGgProto.STNetMsgHeader._wDataLen = 0
CliGgProto.STNetMsgHeader._byCompress = 0
CliGgProto.STNetMsgHeader._byCheckSum = 0
--构造
function CliGgProto.STNetMsgHeader:ctor()
	self._wMsgID = 0
	self._wDataLen = 0
	self._byCompress = 0
	self._byCheckSum = 0
end

function CliGgProto.STNetMsgHeader:pack()
	CliGgProto._netdata:writeWord(self._wMsgID)
	CliGgProto._netdata:writeWord(self._wDataLen)
	CliGgProto._netdata:writeByte(self._byCompress)
	CliGgProto._netdata:writeByte(self._byCheckSum)
end

function CliGgProto.STNetMsgHeader:unPack()
	self._wMsgID = CliGgProto._netdata:readWord()
	self._wDataLen = CliGgProto._netdata:readWord()
	self._byCompress = CliGgProto._netdata:readByte()
	self._byCheckSum = CliGgProto._netdata:readByte()
end

