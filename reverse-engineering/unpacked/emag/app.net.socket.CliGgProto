CliGgProto.SRoleBasicInfo = class("SRoleBasicInfo")
--成员
CliGgProto.SRoleBasicInfo._szRoleName = ""
CliGgProto.SRoleBasicInfo._byPos = 0
CliGgProto.SRoleBasicInfo._byJob = 0
CliGgProto.SRoleBasicInfo._bySex = 0
CliGgProto.SRoleBasicInfo._byFaceShape = 0
CliGgProto.SRoleBasicInfo._byHairColor = 0
CliGgProto.SRoleBasicInfo._bySkinColor = 0
CliGgProto._wSTR = 0
CliGgProto._wDEX = 0
CliGgProto._wINT = 0
CliGgProto.SRoleBasicInfo._wLevel      = 0
CliGgProto.SRoleBasicInfo._wBladeLevel = 0
CliGgProto.SRoleBasicInfo._wSwordLevel = 0
CliGgProto.SRoleBasicInfo._wGunLevel   = 0
CliGgProto.SRoleBasicInfo._wHealLevel  = 0
CliGgProto.SRoleBasicInfo._wBlessLevel = 0

CliGgProto.SRoleBasicInfo._dwRepute   = 0
CliGgProto.SRoleBasicInfo._byGrade    = 0
CliGgProto.SRoleBasicInfo._byAdvanced = 0
CliGgProto.SRoleBasicInfo._szWeaponAppr   = ""
CliGgProto.SRoleBasicInfo._szShieldAppr   = ""
CliGgProto.SRoleBasicInfo._szHelmetAppr   = ""
CliGgProto.SRoleBasicInfo._szBodyAppr     = ""
CliGgProto.SRoleBasicInfo._szTrousersAppr = ""
-- CliGgProto.SRoleBasicInfo._dwWeaponAppr = 0
-- CliGgProto.SRoleBasicInfo._dwBodyAppr = 0

CliGgProto.SRoleBasicInfo._szDeleteTime = ""
CliGgProto.SRoleBasicInfo._byDelete     = 0
CliGgProto.SRoleBasicInfo._dwServerID   = 0
CliGgProto.SRoleBasicInfo._szPlayerID   = ""
CliGgProto.SRoleBasicInfo._szCreateTime = ""

--构造
function CliGgProto.SRoleBasicInfo:ctor()
	self._szRoleName = ""
	self._byPos = 0
	self._byJob = 0
	self._bySex = 0
	self._byFaceShape = 0
	self._byHairColor = 0
	self._bySkinColor = 0
	self._wSTR   = 0
	self._wDEX   = 0
	self._wINT   = 0
	self._wLevel = 0
	self._wBladeLevel = 0
	self._wSwordLevel = 0
	self._wGunLevel   = 0
	self._wHealLevel  = 0
	self._wBlessLevel = 0
	
	self._dwRepute = 0
	self._byGrade  = 0
	self._byAdvanced     = 0
	self._szWeaponAppr   = ""
	self._szShieldAppr   = ""
	self._szHelmetAppr   = ""
	self._szBodyAppr     = ""
	self._szTrousersAppr = ""
	
	self._szDeleteTime = ""
	self._byDelete     = 0
	self._dwServerID   = 0
	self._szPlayerID   = ""
	self._szCreateTime = ""
end


function CliGgProto.SRoleBasicInfo:pack()
	CliGgProto._netdata:writeString(self._szRoleName, CliGgProto.ROLENAME_MAX_LEN)
	CliGgProto._netdata:writeByte(self._byPos)

	CliGgProto._netdata:writeByte(self._byJob)
	CliGgProto._netdata:writeByte(self._bySex)

	CliGgProto._netdata:writeByte(self._byFaceShape)
	CliGgProto._netdata:writeByte(self._byHairColor)
	CliGgProto._netdata:writeByte(self._bySkinColor)

	CliGgProto._netdata:writeWord(self._wSTR)
	CliGgProto._netdata:writeWord(self._wDEX)
	CliGgProto._netdata:writeWord(self._wINT)
	
	CliGgProto._netdata:writeWord(self._wLevel)
	CliGgProto._netdata:writeWord(self._wBladeLevel)
	CliGgProto._netdata:writeWord(self._wSwordLevel)
	CliGgProto._netdata:writeWord(self._wGunLevel)
	CliGgProto._netdata:writeWord(self._wHealLevel)
	CliGgProto._netdata:writeWord(self._wBlessLevel)


	CliGgProto._netdata:writeDword(self._dwRepute)
	CliGgProto._netdata:writeByte(self._byGrade)
	CliGgProto._netdata:writeByte(self._byAdvanced)
	CliGgProto._netdata:writeString(self._szWeaponAppr, CliGgProto.ROLENAME_MAX_LEN)
	CliGgProto._netdata:writeString(self._szShieldAppr, CliGgProto.ROLENAME_MAX_LEN)
	CliGgProto._netdata:writeString(self._szHelmetAppr, CliGgProto.ROLENAME_MAX_LEN)
	CliGgProto._netdata:writeString(self._szBodyAppr  , CliGgProto.ROLENAME_MAX_LEN)
	CliGgProto._netdata:writeString(self._szTrousersAppr, CliGgProto.ROLENAME_MAX_LEN)

	CliGgProto._netdata:writeString(self._szDeleteTime, CliGgProto.TIME_STRING_LEN)
	CliGgProto._netdata:writeByte(self._byDelete)
	CliGgProto._netdata:writeDword(self._dwServerID)
	CliGgProto._netdata:writeString(self._szPlayerID, CliGgProto.PLAYERID_STRING_LEN)
	CliGgProto._netdata:writeString(self._szCreateTime, CliGgProto.TIME_STRING_LEN)

end

function CliGgProto.SRoleBasicInfo:unPack()
	self._szRoleName = CliGgProto._netdata:readString(CliGgProto.ROLENAME_MAX_LEN)
	self._byPos      = CliGgProto._netdata:readByte()

	self._byJob = CliGgProto._netdata:readByte()
	self._bySex = CliGgProto._netdata:readByte()

	self._byFaceShape = CliGgProto._netdata:readByte()
	self._byHairColor = CliGgProto._netdata:readByte()
	self._bySkinColor = CliGgProto._netdata:readByte()

	self._wSTR = CliGgProto._netdata:readWord()
	self._wDEX = CliGgProto._netdata:readWord()
	self._wINT = CliGgProto._netdata:readWord()
	
	self._wLevel      = CliGgProto._netdata:readWord()
	self._wBladeLevel = CliGgProto._netdata:readWord()
	self._wSwordLevel = CliGgProto._netdata:readWord()
	self._wGunLevel   = CliGgProto._netdata:readWord()
	self._wHealLevel  = CliGgProto._netdata:readWord()
	self._wBlessLevel = CliGgProto._netdata:readWord()

	self._dwRepute       = CliGgProto._netdata:readDword()
	self._byGrade        = CliGgProto._netdata:readByte()
	self._byAdvanced     = CliGgProto._netdata:readByte()
	self._szWeaponAppr   = CliGgProto._netdata:readString(CliGgProto.ROLENAME_MAX_LEN)
	self._szShieldAppr   = CliGgProto._netdata:readString(CliGgProto.ROLENAME_MAX_LEN)
	self._szHelmetAppr   = CliGgProto._netdata:readString(CliGgProto.ROLENAME_MAX_LEN)
	self._szBodyAppr     = CliGgProto._netdata:readString(CliGgProto.ROLENAME_MAX_LEN)
	self._szTrousersAppr = CliGgProto._netdata:readString(CliGgProto.ROLENAME_MAX_LEN)

	self._szDeleteTime = CliGgProto._netdata:readString( CliGgProto.TIME_STRING_LEN)
	self._byDelete     = CliGgProto._netdata:readByte()
	self._dwServerID   = CliGgProto._netdata:readDword()
	self._szPlayerID   = CliGgProto._netdata:readString(CliGgProto.PLAYERID_STRING_LEN)
	self._szCreateTime = CliGgProto._netdata:readString(CliGgProto.TIME_STRING_LEN)
end
