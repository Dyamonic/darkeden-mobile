--------角色操作回应------
CliGgProto.URoleOpAck = class("URoleOpAck")
--成员
CliGgProto.URoleOpAck._iSelect = 0
CliGgProto.URoleOpAck._stSucc = nil
CliGgProto.URoleOpAck._stFail = nil
--构造
function CliGgProto.URoleOpAck:ctor(iSelect)
    self._iSelect = iSelect
	if iSelect == CliGgProto.PROTO_SUCCESS then
		self._stSucc = CliGgProto.SRoleList.new()
	elseif iSelect == CliGgProto.PROTO_FAILURE then
		self._stFail = CliGgProto.SErrCode.new()
	end
end

function CliGgProto.URoleOpAck:pack()

	if self._iSelect == CliGgProto.PROTO_SUCCESS then
		self._stSucc:pack()
	elseif self._iSelect == CliGgProto.PROTO_FAILURE then
		self._stFail:pack()
	end
end

function CliGgProto.URoleOpAck:unPack()

	if self._iSelect == CliGgProto.PROTO_SUCCESS then
		self._stSucc:unPack()
	elseif self._iSelect == CliGgProto.PROTO_FAILURE then
		self._stFail:unPack()
	end
end
