
local EnchantingAffixDao = {}

function EnchantingAffixDao:query(id)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM EnchantingAffix WHERE idxId=%d;", id)) do
        local enchantingAffix = lt.EnchantingAffixMeta.new(row)
        return enchantingAffix
    end
end

function EnchantingAffixDao:queryAll()
    local enchantingAffixTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM EnchantingAffix") do
        local enchantingAffix = lt.EnchantingAffixMeta.new(row)
        enchantingAffixTable[enchantingAffix:getType()] = enchantingAffix
    end
    return enchantingAffixTable
end

return EnchantingAffixDao
