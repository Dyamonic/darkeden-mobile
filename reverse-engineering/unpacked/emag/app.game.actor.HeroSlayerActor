local HeroSlayerActor = class("HeroSlayerActor", lt.RoleActor)

local ActionManager = lt.ActionManager
local SlayerPos = lt.Constant.SlayerPos
local ResUtil = lt.ResUtil
    
--[[
    人族 actor model: 头盔 衣服 裤子

    Helmet 头盔 model 身体(衣服) pants 裤子
]]

-- HeroSlayerActor._actorType = nil

function HeroSlayerActor:ctor(roleData, node, zorder)
    self._roleData = roleData
    self._helmetName, self._modelName, self._pantsName, self._hairName = roleData:getModelName()

    self._spritePants = self:CreateSprite(0.5, 0.5, zorder, node)
    zorder = zorder + 2
    self._spriteHair = self:CreateSprite(0.5, 0.5, zorder, node)
    zorder = zorder + 5
    self._spriteHelmet = self:CreateSprite(0.5, 0.5, zorder, node)
    self._pixelUVTable = {}
end

function HeroSlayerActor:onClear()
    self:removeAllChildren()
    self._spriteHelmet = nil
    self._spritePants = nil
    self._spriteHair = nil
    self._actionHelmetInfo = nil
    self._actionPantsInfo = nil
    self._actionHairInfo = nil
    self._isPause = nil
    self._pixelUVTable = nil
    self._roleData = nil
end

function HeroSlayerActor:LoadHeroActionInfo(actionId, dirction)
    local helmetName, pantsName, hairName = self._helmetName, self._pantsName, self._hairName
    local helmetId = self._roleData:getHelmet()
    if helmetId ~= 0 then
        self._actionHelmetInfo = ActionManager:getAcitonHeroInfo(helmetName, actionId, dirction)
        self._spriteHelmet:setVisible(true)
    else
        self._actionHelmetInfo = nil
        self._spriteHelmet:setVisible(false)
    end
    self._actionPantsInfo = ActionManager:getAcitonHeroInfo(pantsName, actionId, dirction)

    self._actionHairInfo = ActionManager:getAcitonHeroInfo(hairName, actionId, dirction)
end

function  HeroSlayerActor:onUpdateFrame(nextFrameIndex)
    self:onUpdateHelmet(nextFrameIndex)
    self:onUpdatePants(nextFrameIndex)
    self:onUpdateHair(nextFrameIndex)
end

function HeroSlayerActor:onUpdateHelmet(nextFrameIndex)
    if self._actionHelmetInfo then
        self:updateFrame(self._spriteHelmet, self._actionHelmetInfo, nextFrameIndex, SlayerPos.HelMet)
    end
end

function HeroSlayerActor:onUpdatePants(nextFrameIndex)
    self:updateFrame(self._spritePants, self._actionPantsInfo, nextFrameIndex, SlayerPos.Pants)
end

function HeroSlayerActor:onUpdateHair(nextFrameIndex)
    self:updateFrame(self._spriteHair, self._actionHairInfo, nextFrameIndex, SlayerPos.Hair)
end

function HeroSlayerActor:updateFrame(nodeSprite, actionInfo, nextFrameIndex, pos)
    if self._isPause then
        return
    end
    if not actionInfo then
        return
    end

    nodeSprite:setVisible(true)
    local frameHelmet = actionInfo:getSpriteFrame(nextFrameIndex)
    if frameHelmet then
        local spriteFrame = frameHelmet.sprite
        nodeSprite:setSpriteFrame(spriteFrame)
        local texture = nodeSprite:getTexture()
        texture:setAliasTexParameters()
        
        self._pixelUVTable[pos] = ResUtil:getPlistPixelSize(spriteFrame)

        local shadowPos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frameHelmet.x, frameHelmet.y), frameHelmet.size)
        nodeSprite:setPosition(shadowPos)
    end
end

function HeroSlayerActor:hideNode()
    self._spriteHelmet:setVisible(false)
    self._spritePants:setVisible(false)
    self._spriteHair:setVisible(false)
end

function HeroSlayerActor:setPause()
    self._isPause = true
end

function HeroSlayerActor:setResume()
    self._isPause = false
end

function HeroSlayerActor:isPause()
    return self._isPause
end

function HeroSlayerActor:getOtherNode()
    return self._spriteHelmet, self._spritePants, self._spriteHair
end

function HeroSlayerActor:changeHelmetName(helmetName)
    self._helmetName = helmetName
end

function HeroSlayerActor:changePantsName(pantsName)
    self._pantsName = pantsName
end

function HeroSlayerActor:getPixelSlayerInfo()
    return self._pixelUVTable
end
function HeroSlayerActor:changeHairName(hairName)
    self._hairName = hairName
end

return HeroSlayerActor