---@class UICompTeamHallTab
---
local UICompTeamHallTab = class("UICompTeamHallTab",lt.UICompBase, lt.UICompChangeSkin)

UICompTeamHallTab.ChangeSkinConf = {
    ["Team"] = {
        ["n0"] = "bg_zuduixitong_yeqiandi02",
    },
}

function UICompTeamHallTab:ctor()
    UICompTeamHallTab.super.ctor(self)
    --UI
    self._titleLabel = nil
    self._selectImg = nil
    self._maskImg = nil
    self._btnController = nil
end

function UICompTeamHallTab:onClear()
    --UI
    self._titleLabel = nil
    self._selectImg = nil
    self._maskImg = nil
    self._btnController = nil
    UICompTeamHallTab.super.onClear(self)
end

function UICompTeamHallTab:onConstruct()
    self:startSkin()
    self._titleLabel = self:getChild("title")
    self._selectImg = self:getChild("img_select")
    self._maskImg = self:getChild("img_mask")
    self._btnController = self:getController("button")
end

function UICompTeamHallTab:setInfo(text)
    self._titleLabel:setText(text)
    local size =  self._titleLabel:getSize()
    if size.width > 142 then
        local scale = 142/size.width
        self._titleLabel:setScale(scale,scale)
    else
        self._titleLabel:setScale(1,1)
    end
end

function UICompTeamHallTab:setSelected(select)
    self._selectImg:setVisible(select)
    self._maskImg:setVisible(not select)
    self._btnController:setSelectedIndex(select and 1 or 0)
end

return UICompTeamHallTab