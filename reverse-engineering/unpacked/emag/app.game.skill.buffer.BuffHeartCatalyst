local BuffHeartCatalyst = class("BuffHeartCatalyst", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum

--[[
    快速恢复
]]
function BuffHeartCatalyst:ctor(time, actor, skilllevel)    
    BuffHeartCatalyst.super.ctor(self, BuffEnum.EFFECT_HEART_CATALYST, time, actor, skilllevel)
    actor:playZorderEffect(SkillEnum.SKILL_HEART_CATALYST, SkillEnum.EFFECT_OWNER.SELF)
end

function BuffHeartCatalyst:onClear()
    self._actor:removeZorderEffect(SkillEnum.SKILL_HEART_CATALYST)
    BuffHeartCatalyst.super.onClear(self)
end

return BuffHeartCatalyst
