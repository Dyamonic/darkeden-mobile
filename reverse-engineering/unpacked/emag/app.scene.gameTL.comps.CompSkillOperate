function CompSkillOperate:ctor()
    CompSkillOperate.super.ctor(self)
    self._skillBtnGroups = {}
    self._operateMode = 0 -- 操作模式：1：战斗 2：编辑正常中 3：正在设置技能 4：设置位置
    self._equipPos = nil
    self._editorData = nil
    self._skillActor = nil
    self._operateBtn = nil
    self._editCom = nil
    self._replaceSkillId = nil
    self._maxZorder = 0
    self._heroAgent = nil
    self._touchLayer = nil
    self._conditionOfType = {}
    self.rightUITablePos = nil
end

function CompSkillOperate:onConstruct()
    self:startSkin()
    
    self._btnSwitchIn = self:getChild('btnSwitchIn')
    self._btnSwitchOut = self:getChild('btnSwitchOut')
    
    self._switchOutController = self:getController("switchOut")
    self._switchInController = self:getController("switchIn")

    self._btnSelMonster = self:getChild('btnSelMonster')
    self._btnSelRole = self:getChild('btnSelRole')

    self._btnCancel = self:getChild("btnCanel")
    self._btnCancel:setVisible(false)
    self._touchLayer = self:getChild("touch")
    self._touchLayer:setVisible(false)
    self._touchLayer:setSortingOrder(9999)

    
    local editTable = lt.AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.RIGHT_OFFSET) or {}
    local value = editTable.value or 0
    local defaultConf = lt.SkillEditDefaultConf
    -- 39个技能按钮位置初始化
    for index = 1, MAX_BTN_COUNT do
        local skillBtn = self:getChild("skill"..index)
        skillBtn.index = index
        table.insert(self._skillBtnGroups, skillBtn)

        local pos = skillBtn:getPosition()
        if defaultConf and defaultConf and not defaultConf[index].x then
            defaultConf[index].x = pos.x - value
            defaultConf[index].y = pos.y
            defaultConf[index].offsetX = value
        end
    end
end

function CompSkillOperate:onClear()
    self:unregisterAllComponent()
    for index, _ in pairs(self._skillBtnGroups) do
        self._skillBtnGroups[index] = nil
    end
    self._skillBtnGroups = nil
    self._operateMode = nil 
    self._equipPos = nil
    self._editorData = nil
    self._skillActor = nil
    self._operateBtn = nil
    self._editCom = nil
    self._replaceSkillId = nil
    self._maxZorder = nil
    self._heroAgent = nil
    self._touchLayer = nil
    self._btnSwitchIn = nil
    self._btnSwitchOut = nil

    self._switchOutController = nil
    self._btnSelMonster = nil

    self._btnCancel = nil
    self._touchLayer = nil

    self._newXY = nil
    self._conditionOfType  = nil
    self.rightUITablePos = nil
    CompSkillOperate.super.onClear(self)
end

function CompSkillOperate:onEnter()
    CompSkillOperate.super.onEnter(self)
    self._btnSwitchIn:addClickListener(handler(self, self.btnSwitchInClick))
    self._btnSwitchOut:addClickListener(handler(self, self.btnSwitchOutClick))
    self._btnSelMonster:addClickListener(handler(self, self.btnSelMonsterClick))
    self._btnSelRole:addClickListener(handler(self, self.btnSelRoleClick))

    for _, skillBtn in pairs(self._skillBtnGroups) do
        skillBtn:addClickListener(handler(self, self.btnSkillBtnClick))
    end

    --技能轮盘条件刷新
    NtfManager:addNtfListener(NtfManager.NTF.NTF_HERO_DIE, handler(self, self.onDieConditionUI), "CompSkillOperate:NTF_HERO_DIE")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_HERO_EQUIP_EVENT, handler(self, self.onEquipConditionUI), "CompSkillOperate:NTF_UPDATE_HERO_EQUIP_EVENT")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_ITEM_EVENT, handler(self, self.onItemConditionUI), "CompSkillOperate:NTF_UPDATE_ITEM_EVENT")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPT_SKILL_SLOT_CONDITION, handler(self, self.onConditionUI), "CompSkillOperate:NTF_UPT_SKILL_SLOT_CONDITION")

    NtfManager:addNtfListener(NtfManager.NTF.NTF_AUTOFIGHT_START, handler(self, self.refreshAutoFightBtn), "CompSkillOperate:NTF_AUTOFIGHT_START")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_AUTOFIGHT_END, handler(self, self.refreshAutoFightBtn), "CompSkillOperate:NTF_AUTOFIGHT_END")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_SLOT, handler(self, self.refreshSlot), "CompSkillOperate:NTF_REFRESH_SLOT")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CHANGE_SETTINGS, handler(self, self.changeSettings), "CompSkillOperate:changeSettings")

    if self._operateMode == Operate.Battle then
        local isAuto = AutoFightManager:isAuto()
        local param = {param = {noAnim = true}}
        self:refreshAutoFightBtn(param)
    end

    --这两个方法都会修改技能按钮位置
    self:refreshRightUIOffset(Constant.SETTINGS_TYPES.RIGHT_OFFSET)
    self:refreshSlot()

    if self._operateMode > 1 then
        self._btnSelMonster:setTouchable(false)
        self._btnSelRole:setTouchable(false)
    else
        NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_HERO_EVENT, handler(self, self.refreshHero), "CompSkillOperate:refreshHero")
        self:operateBattle()
    end

    self:onlyRefreshConditionUI()

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_PICK_UP)
end

function CompSkillOperate:onUpdate(dt)
    if self._skillBtnGroups then
        for _, skillBtn in pairs(self._skillBtnGroups) do
            skillBtn:onUpdate(dt)
        end
    end
end

function CompSkillOperate:onExit()
    NtfManager:removeNtfListenerByTag("CompSkillOperate:refreshHero")
    NtfManager:removeNtfListenerByTag("CompSkillOperate:NTF_HERO_DIE")
    NtfManager:removeNtfListenerByTag("CompSkillOperate:NTF_UPT_SKILL_SLOT_CONDITION")
    NtfManager:removeNtfListenerByTag("CompSkillOperate:NTF_UPDATE_HERO_EQUIP_EVENT")
    NtfManager:removeNtfListenerByTag("CompSkillOperate:NTF_UPDATE_ITEM_EVENT")
    NtfManager:removeNtfListenerByTag("CompSkillOperate:NTF_AUTOFIGHT_START")
    NtfManager:removeNtfListenerByTag("CompSkillOperate:NTF_AUTOFIGHT_END")
    NtfManager:removeNtfListenerByTag("CompSkillOperate:NTF_REFRESH_SLOT")
    NtfManager:removeNtfListenerByTag("CompSkillOperate:changeSettings")
    NtfManager:removeNtfListenerByTag("CompSkillOperate:onReturnSkill")
    NtfManager:removeNtfListenerByTag("CompSkillOperate:onResetAllSkill")

    self._btnSwitchIn:removeClickListener()
    self._btnSwitchOut:removeClickListener()
    self._btnSelMonster:removeClickListener()
    self._btnSelRole:removeClickListener()

    for _, skillBtn in pairs(self._skillBtnGroups) do
        skillBtn:removeClickListener()
        skillBtn:removeEventListener(fgui.UIEventType.DragStart)
        skillBtn:removeEventListener(fgui.UIEventType.DragMove)
        skillBtn:removeEventListener(fgui.UIEventType.DragEnd)

    end
    CompSkillOperate.super.onExit(self)
end

function CompSkillOperate:onDieConditionUI()
    self:onConditionUI({param = {type = SLOT_CONDITION_TYPE.DIE}})
end
function CompSkillOperate:onItemConditionUI()
    self:onConditionUI({param = {type = SLOT_CONDITION_TYPE.ITEM}})
end
function CompSkillOperate:onEquipConditionUI()
    self:onConditionUI({param = {type = SLOT_CONDITION_TYPE.EQUIP}})
end

function CompSkillOperate:refreshHero(event)
    local param = event.param
    if param and param.isInit then
        local worldAgent = lt.AgentManager:getWorldAgent()
        local heroAgent = worldAgent:getHeroAgent()
        if not heroAgent or heroAgent:getIsOutOfGame() then
            return
        end
        self._skillActor = heroAgent:getActor():getSkillActor()
        self._heroAgent = heroAgent
        
        self:refreshSlot()
    end
end

