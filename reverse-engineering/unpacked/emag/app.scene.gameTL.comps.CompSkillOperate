function CompSkillOperate:editPosClick(btn)
    if self._operateBtn then
        self:setSelectTagShow(false)
    end
    self._operateBtn = btn
    local maxZorder = self:getMaxZorder()
    local curZorder = maxZorder + 1
    self:setMaxZorder(curZorder)
    self._operateBtn:setSortingOrder(curZorder)
    SkillModule:setEditConfByIndex(self._operateBtn.index, {zorder = curZorder})
    self:setSelectTagShow(true)
    self._editCom:refreshEditUI(btn.index)
end

function CompSkillOperate:setLight(isLight)
    for index = 1, MAX_BTN_COUNT do
        if index ~= AUTO_NORMAL_INEDX then
            local skillBtn = self:getChild("skill"..index)
            skillBtn:setSelect(isLight)
        end
    end
end

--- edit pos----------
function CompSkillOperate:setDrag(isDrag)
    for _, btn in pairs(self._skillBtnGroups) do
        btn:setDraggable(isDrag)
        btn:addEventListener(fgui.UIEventType.DragStart, function(context)
            self:editPosClick(btn)
            context:captureTouch() 
        end);
        btn:addEventListener(fgui.UIEventType.DragMove, function(context)
            local evt = context:getInput();
            self._editCom:setOpenControl(2)
            self._editCom:setHideBtnState(1)
            local pt = self:globalToLocal(evt:getPosition());
            local oript = fgui.GRoot:getInstance():globalToLocal(evt:getPosition())
            local calcX, calcY = self:excludeXY(pt.x, pt.y, oript.x, oript.y)
            btn:setPosition(calcX, calcY)
        end)
        
        btn:addEventListener(fgui.UIEventType.DragEnd, function(context)
            SkillModule:setEditConfByIndex(self._operateBtn.index, {
                x = self._newXY.x,
                y = self._newXY.y,
            })
            self._editCom:setOpenControl(1)
            self._editCom:setHideBtnState(0)
            context:uncaptureTouch()
        end)
    end
end


function CompSkillOperate:excludeXY(newX, newY, oriX, oriY)
    --适配
    local disX = oriX - newX
    local disY = oriY - newY
    local width = self._operateBtn:getWidth()/2 * 1.5
    local height = self._operateBtn:getHeight()/2* 1.5

    local editTable = lt.AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.LEFT_OFFSET) or {}
    local value = editTable.value or 0

    local left = MOVE_MINX + width - disX
    local right = MOVE_MAXX - width - disX
    local top = MOVE_MAXY - height - disY
    local bottom = MOVE_MINY + height - disY

    if newX < left then
        newX = left
    elseif newX > right then
        newX = right
    end

    if newY < bottom then
        newY = bottom
    elseif newY > top then
        newY = top
    end

    local exclude_minx = EXCLUDE_MINX - disX
    local exclude_miny = EXCLUDE_MINY - disY
    local excludeMaxX = exclude_minx + EXCLUDE_WIDTH + width + value
    local excludeMaxY = exclude_miny + EXCLUDE_HEIGHT + height
    if newX >= exclude_minx and newX <= excludeMaxX and newY >= exclude_miny and newY <= excludeMaxY then
        if self._newXY.y >= excludeMaxY then
            newY = excludeMaxY
        end
        if self._newXY.x >= excludeMaxX then
            newX = excludeMaxX
        end
        return newX,newY
    end
    self._newXY = cc.p(newX, newY)
    return newX, newY
end

function CompSkillOperate:startScale(scale)
