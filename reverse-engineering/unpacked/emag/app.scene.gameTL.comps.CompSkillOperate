function CompSkillOperate:editorClick(btn)
    if self._operateMode == Operate.Edit_Normal
    or self._operateMode == Operate.Auto_Normal then
        if btn.index == AUTO_NORMAL_INEDX then
            --自动挂机的普攻也不能卸下
            return
        end
        if btn:isComVisible() then
            self:takeoff(btn)
        end
        return 
    elseif self._operateMode == Operate.Edit_Set
    or self._operateMode == Operate.Auto_Set then
        if btn.index == AUTO_NORMAL_INEDX then
            --自动挂机的普攻也不能卸下
            return
        end
        btn:setComVisible(true)

        if self._selectSkillId == btn.skillId then
            self._editCom:takeonSuccess()
            return 
        end
        local iconId = lt.SkillModule:getSkillIcon(self._selectSkillId)
        local isCondition = SkillModule:isBtnUICondition(self._selectSkillId)

        btn:setIconUrl(string.format(_GURL.GetImageSkill, iconId))
        btn:setIsCondition(isCondition)
        if btn.skillId then
            self._replaceSkillId = btn.skillId
        else
            self._replaceSkillId = nil
        end
        btn.skillId = self._selectSkillId
      
        self:takeon(btn)
    elseif self._operateMode == Operate.Edit_Pos then
        self:editPosClick(btn)
    end
end

function CompSkillOperate:takeon(btn)
    if self._equipPos then ---已经装备了
        self:clearSkill(self._equipPos)
    end
    SkillModule:setEditConfByIndex(btn.index, {skillId = self._selectSkillId})
    self._editCom:takeonSuccess(self._replaceSkillId)
end

function CompSkillOperate:takeoff(btn)
    if btn.skillId then
        self._editCom:takeoffSuccess(btn.skillId)
        self:clearSkill(btn.index)
    end
end


function CompSkillOperate:clearSkill(index)
    self._skillBtnGroups[index]:setComVisible(false) --清空
    SkillModule:setEditConfByIndex(index, {skillId = "nil"})
    self._skillBtnGroups[index].skillId = nil
end

