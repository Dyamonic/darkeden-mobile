end

function CompSkillOperate:btnSkillBtnClick(context)
    local btn = context:getSender()
    if self._operateMode > 1 then 
        self:editorClick(btn)
    end
end

function CompSkillOperate:refreshSlot()
    self._editorData = SkillModule:getEditConf()
    for nodeId = 1, MAX_BTN_COUNT do
        local skillBtn = self:getChild("skill"..nodeId)
        local nodeInfo = self._editorData[nodeId]
        local skillId = nodeInfo.skillId
    
        if self._operateMode == Operate.Battle and not skillId then
            skillBtn:setVisible(false)
        else
            skillBtn:setVisible(true)
            skillBtn:setNodeComVisible(true)
            local isCondition = false
            local url = ""
            if skillId then
                skillBtn.skillId = skillId
                local iconId = SkillModule:getSkillIcon(skillId)
                url = string.format(_GURL.GetImageSkill, iconId)
                local skillInfo = SkillModule:getSkillTable()[skillId]
                if skillInfo then
                    local skillCd = skillInfo:getSkillCd()
                    if SkillCdManager:isSet(skillId) then
                        skillCd = lt.SkillCdManager:getCd(skillId)
                    end
                    if skillCd then
                        SkillCdManager:setCd(skillId, skillCd)
                    end
                end
                for _, conType in pairs(Constant.SLOT_CONDITION_TYPE) do
                    if conType then
                        if not self._conditionOfType[skillId] then
                            self._conditionOfType[skillId] = {}
                        end
                        isCondition = SkillModule:isBtnUIConditionByType(skillId, conType)
                        
                        self._conditionOfType[skillId][conType] = isCondition == true and 1 or 0
                        if table.keyof(self._conditionOfType[skillId], 0) then
                            isCondition = false
                        end
                    else
                        isCondition = SkillModule:isBtnUICondition(skillId)
                    end
                end
            else
               isCondition = true
               skillBtn.skillId = nil
            end
            skillBtn:setItemInfo({nodeInfo = nodeInfo, url = url, isCondition = isCondition, operateMode = self._operateMode, parent = self})
        end
    end
    
    self:setSelectTagShow(false)
end

