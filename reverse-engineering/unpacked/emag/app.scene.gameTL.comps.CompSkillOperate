    self._operateBtn.skillId = nil
    self._operateBtn:setIconUrl("")
    self._operateBtn:setSelectTag(false)
    self._operateBtn:setScale(DEFAULT_SCALE, DEFAULT_SCALE)
    SkillModule:setEditConfByIndex(self._operateBtn.index, {
        isAdd = false,
        skillId = "nil",
        scale = DEFAULT_SCALE,
        x = 1408,
        y = 768,
    })
    self._operateBtn = nil
    
end

function CompSkillOperate:addBtn(index)
