function CompSkillOperate:operateBattle()
    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return
    end

    local heroAgent = worldAgent:getHeroAgent()
    if not heroAgent or heroAgent:getIsOutOfGame() then
        return
    end
    self._skillActor = heroAgent:getActor():getSkillActor()
    self._heroAgent = heroAgent
end


function CompSkillOperate:checkCancelRect(pt)
    local size = self._btnCancel:getSize()
    local btnCanelXY = self._btnCancel:getPosition()
    local cpt = self:globalToLocal(pt); 
    local rect = {x = btnCanelXY.x, y = btnCanelXY.y, width = size.width, height = size.height}
    return cc.rectContainsPoint(rect, cpt)
end

function CompSkillOperate:onConditionUI(event)
    local param = event.param
    self:onlyRefreshConditionUI(param.type)
end

--- 刷新技能释放UI显示
function CompSkillOperate:onlyRefreshConditionUI(conType)
    local heroAgent = lt.AgentManager:getHeroAgent()
    if not heroAgent then
        return
    end
    
    for nodeId = 1, MAX_BTN_COUNT do
        local skillBtn = self:getChild("skill"..nodeId)
        local skillId = skillBtn.skillId
        if skillId then
            local isCondition = true
            if conType then
                if not self._conditionOfType[skillId] then
                    self._conditionOfType[skillId] = {}
                end
                isCondition = SkillModule:isBtnUIConditionByType(skillId, conType)
                
                self._conditionOfType[skillId][conType] = isCondition == true and 1 or 0
                if table.keyof(self._conditionOfType[skillId], 0) then
                    isCondition = false
                end
            else
                isCondition = SkillModule:isBtnUICondition(skillId, conType)
            end


            skillBtn:setIsCondition(isCondition)

            -----------------------------------------------------------------------------------------
            -- 变身图标修改
            if table.keyof(SkillEnum.TRANSFORM_SKILL, skillId) then
                local isTransforming, transformId = SkillModule:isTransforming()
                if isTransforming then
                    if SkillEnum.TRANSFORM_SKILL[transformId] == skillId then
                        skillBtn:setTransformIcon(true)
                    end
                else
                    skillBtn:setTransformIcon(false)
                end
            end
            -----------------------------------------------------------------------------------------
            -- 炮塔图标修改
            if skillId == SkillEnum.SKILL_INSTALL_TURRET and self._heroAgent then  -- 安装炮塔
                skillBtn:setTransformIcon(self._heroAgent:hasBuffer(lt.BuffEnum.EFFECT_INSTALL_TURRET))
            end
        end
    end
end

