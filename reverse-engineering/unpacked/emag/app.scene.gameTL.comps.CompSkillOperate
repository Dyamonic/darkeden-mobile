function CompSkillOperate:getMaxZorder()
    if not self._maxZorder then
        local maxZorder = 0
        for _, itemInfo in pairs(self._editorData) do
            if itemInfo.zorder > maxZorder then
                maxZorder = itemInfo.zorder
            end
        end
        self._maxZorder = maxZorder
    end
    return self._maxZorder
end
function CompSkillOperate:setMaxZorder(zorder)
    self._maxZorder = zorder
end

function CompSkillOperate:showAutoFightUi(show)
    self:getChild("node_operate"):setVisible(not show)
    self:getChild("node_autofight"):setVisible(show)
end

function CompSkillOperate:playControlAnim(noAnim)
    local isAuto = AutoFightManager:isAuto()
    local anim1 = self:getTransition("autofightToOperate")
    local anim2 = self:getTransition("operateToAutofight")
    local noAnim1 = self:getTransition("normal")
    local noAnim2 = self:getTransition("autofight")
    if isAuto then
        if noAnim then
            noAnim2:play()
        else
            if anim1:isPlaying() then
                anim1:stop()
            end
            anim2:play()
        end
    else
        if noAnim then
            noAnim1:play()
        else
            if anim2:isPlaying() then
                anim2:stop()
            end
            anim1:play()
        end
    end
end

--设置修改
function CompSkillOperate:changeSettings(params)
    local param = params.param or {}
    local index = param.index
    if index == Constant.SETTINGS_TYPES.RIGHT_OFFSET then -- 右侧屏幕边缘偏移
        self:refreshRightUIOffset(index)
    end
end

-- 右侧屏幕边缘偏移
function CompSkillOperate:refreshRightUIOffset(index)
    local editTable = lt.AutoFightManager:getEditConfByIndex(index) or {}
    local value = editTable.value or 0

    -- 固定位置设置偏移
    local rightUITable = {
        "node_control",
        "btnCanel",
    }
    if not self.rightUITablePos then
        self.rightUITablePos = {}
    end
    for _, v in ipairs(rightUITable) do
        local ui = self:getChild(v)
        if ui then
            local pos = ui:getPosition()
            if not self.rightUITablePos[v] then
                self.rightUITablePos[v] = pos
            end

            if self.rightUITablePos[v] then
                ui:setPosition(self.rightUITablePos[v].x-value,self.rightUITablePos[v].y)
            end
        end
    end

    self._editorData = SkillModule:getEditConf()
    -- 39个技能按钮设置偏移量
    for index = 1, MAX_BTN_COUNT do
        local skillBtn = self:getChild("skill"..index)
        if self._editorData[index] then
            local offsetX = self._editorData[index].offsetX or 0
            self._editorData[index].x = self._editorData[index].x + offsetX - value
            self._editorData[index].offsetX = value
            skillBtn:setPosition(self._editorData[index].x,self._editorData[index].y)
        end
    end
end

