
local PetCapsuleMeta = class("PetCapsuleMeta")



function PetCapsuleMeta:ctor(row)
	self:initWithRow(row)
end

function PetCapsuleMeta:initWithRow(row)
    self._id        = row.Id
    self._type      = row.Type
    self._skillType = row.SkillType
    self._param     = row.Param
    self._image     = row.Image
    self._image2    = row.Image2
end

function PetCapsuleMeta:getDesc()
    if self._skillType == 2 then
        return string.format(GReadText.KEY_PET_TIPS42, self._param .. "%")
    else
        local skillMeta = lt.CacheManager:querySkillMeta(self._param)
        if skillMeta then
            return skillMeta:getName()
        end
    end

    return ""
end

