local EveryLvLuckyBagData = class("EveryLvLuckyBagData")

--[[
    新手引导
]]

table.merge(EveryLvLuckyBagData, {
    _id            = nil,           -- 礼包ID
    _state         = nil,           -- 领取状态
})

function EveryLvLuckyBagData:setData(data)
    self._id    = data.GiftNo
    self._state = data.state
end

function EveryLvLuckyBagData:getId()
    return self._id
end

function EveryLvLuckyBagData:getState()
    return self._state
end

return EveryLvLuckyBagData
