--[[
说明
    实现原理：
        通过 回调函数 renderItemCallBack 获取 listview 的 item 信息(大小 标记（用于多种widget支持）)
        回收超过边界的node节点 通过getItemFromCache 函数 获取已回收的节点重复利用（注意 重复利用是 item里面的一些状态需要重置）

    local cfg = {
        renderItemCallBack = function( list, index, info )
            local isCacheNode = true
            local item = list:getItemFromCache()
            if not item then
                item = UIWgt.new()
                isCacheNode = false
            end
            -- 渲染代码
            item:setInfo()
            --回传的参数
            info.item = item
            info.size = item:getContentSize()
            --注册controll btn 事件  index 索引 _onTriggerTouch 点击回调函数 也可以用 function end
            list:registerBtnHandler(index,"btnChooseServer", "_onTriggerTouch" )
            --或者可以自定义回调函数  list:registerClickHandler
            return isCacheNode
        end,
        multiItems = 2,
        spaceY = 3,
        spaceX = 4,
        totalNumber = #self._loginHistory,
    }
    -- self.historyListParent --layer
    self._loginHistoryList = ListView.new(self.historyListParent,cfg)
    
    --其他 常用 可选参数
    headIndex  3  listview 最顶上 指定到相对应的index item 
    tailIndex  10 以index = 10 在 listview 底部
    isVertical true 垂直滑动 false 水平滑动
    enableShadow 控制阴影（topShadow bottomShadow leftShadow rightShadow 自定义阴影） 
    ignoreCanDrag 当items的整体高度小于widgets高度 可以滑动
    scrollEndCallBack 滑动到底部 回调函数
    scrollBeginCallBack 滑动到头部 回调函数
    curOffset 滑动区域 底部留空 
    curOriginOffset 滑动区域 头部留空
    spaceY y方向间距
    spaceX x方向间距
    autoCenter 当不能滑动时 并且ignoreCanDrag = false时 自动居中 水平模式下生效
    scrollDelegate 滚动代理 
    -- 常用函数
    function ListView:getCurTouchIndex(  ) --获取当前触摸到得index
    function ListView:getItemByIndex( index )  --获取指定索引的 item
    function ListView:reload( param )   --reload数据 
    function ListView:refreshData( )  -- 刷新数据 必须保证 数据的值 不会影响 item 大小  没变 否则 可能已发 bug
    function ListView:refreshAddData( ) -- 刷新数据 可增加大小 用于完成下拉刷新机制
    function ListView:startScrollToIndex( index, isTail,speed, callback) -- 滚动到指定索引  index 指定的索引   isTail index结尾 还是开头   speed 滚动速度 默认 20
    function ListView:startScrollToPosScheduler(distance,time,isRollBack, callback, isCanNotTouchStop)  --滚动一段距离 distance 滚动距离  time 滚动时间  isRollBack 是否是回滚 callback 回调 isCanNotTouchStop 是否可以触摸中断
]]

local ListView = class("ListView",function(layer)
    -- body
    return layer
end)

local QVerticalListViewImp = {}
local QHorizontalListViewImp = {}

ListView.GESTURE_V = 0
ListView.GESTURE_H = 1

-- 
function ListView:findFather(node)
    if not node then return nil end

    if node._param then
        return node._param.layerName
    end

    local father 
    father = node:getParent()

    if not father then return nil end

    if father._param then
        return father.__cname
    else
        return self:findFather(father)
    end
end

function ListView:setParentLayerName(name)
    self._layerName = name or "null"
end

function ListView:ctor( layer,option )
    self:setParentLayerName(self:findFather(layer))
    print("<<<<<<<<<<<<<<<<<<<<<create ListView>>>>>>>>>>>>>>>>>>>>>>>>>> ",self._layerName)

    if not option then
        option = {}
        -- return
    end
    local isSwallow = option.isSwallow 
    self._renderItemCallBack = option.renderItemCallBack
    self._isVertical = option.isVertical 
    self._cacheCond = option.cacheCond or 0.5
    self._headIndex = option.headIndex          --当前视口的起始索引
    self._tailIndex = option.tailIndex         --当前视口的结束索引
    self._maxItemNum = option.maxItemNum
    self._multiItems = option.multiItems or 1   -- 一行有2个或者多个
    self._totalNumber = option.totalNumber or 0
    -- self._scrollToIndexCallBack = option.scrollToIndexCallBack
    self._enableShadow = option.enableShadow
    self._topShadow = option.topShadow
    self._bottomShadow = option.bottomShadow 
    self._leftShadow = option.leftShadow
    self._rightShadow = option.rightShadow
    self._spaceY = option.spaceY or 0
    self._spaceX = option.spaceX or 0
    self._curOffset =  option.curOffset or 0
    self._curOriginOffset = option.curOriginOffset or 0
    self._enableScrollBar = option.enableScrollBar 
    self._scrollBarParentNode = option.scrollBarParentNode 
    self._scrollBar = option.scrollBar
    self._scrollBarPos =  option.scrollBarPos or cc.p(0,0)
    self._ignoreCanDrag = option.ignoreCanDrag
    self._autoCenter = option.autoCenter
    self._autoCenterOffset = option.autoCenterOffset
    self._scrollDelegate = option.scrollDelegate
    self._endRate = option.endRate or 0.2
    self._headIndexPosOffset = option.headIndexPosOffset or 0  --只支持 垂直 水平的暂时没有添加该功能
    self._relatedLayer = layer


    self._scrollEndCallBack = option.scrollEndCallBack
    self._scrollBeginCallBack = option.scrollBeginCallBack

   
    if self._isVertical == nil then
        self._isVertical = true
    end

    if self._enableShadow == nil then
        self._enableShadow = true
    end

    if self._enableScrollBar == nil then
        self._enableScrollBar = false
    end

    if isSwallow == nil then
        isSwallow = true
    end
    --当要设置 起始index 或者 结束index 时 cacheCond >1 否则当 index 等于最后一个的时候  可能导致不能滑动
    if (self._headIndex or self._tailIndex) and self._cacheCond < 1 then
        self._cacheCond = 1
    end

    if self._maxItemNum and self._totalNumber and self._maxItemNum < self._totalNumber then
        self._totalNumber = self._maxItemNum
    end
    self._baseStartIndex =  option.baseStartIndex or 1
    self._baseEndIndex = self._baseStartIndex + self._totalNumber -1
    if self._multiItems ~=1 and self._baseStartIndex % self._multiItems ~= 1 then
        self._baseStartIndex = self._baseStartIndex - (self._baseStartIndex -1)%self._multiItems + self._multiItem
        -- return
    end

    -- self._startIndex = nil       --当前视口 加上 缓存高度或则宽度的索引  
    -- self._endIndex = nil
    self._cacheNodes = {}
    self._itemsInfo = {}
    self._touchInfos = {}
    self._touchHandlers = {}
    self._touchEvent = nil
    self._unTouchRegionNode = nil
    self._unTouchRegionNodeArr = {}
    self._touchPriority = {}
    self._startIndex = 1
    self._endIndex = 1

    if self._isVertical then
        self._curOffset = self._curOffset - self._spaceY
        self._listViewImp = QVerticalListViewImp
    else
        self._curOffset = self._curOffset - self._spaceX
        self._listViewImp = QHorizontalListViewImp
    end

    -- body
    local size = self:getContentSize()
    self._width = size.width
    self._height = size.height
    local pos 
    if tolua.cast(self,"cc.Layer") then
       pos = self:convertToWorldSpace(cc.p(0,0))
    else
       pos = self:convertToWorldSpaceAR(cc.p(0,0))
    end

    self._rect = cc.rect(0,0,self._width,self._height)
    self._touchBoundingBox = cc.rect(pos.x,pos.y,self._width * self:_getTouchScaleX(),self._height * self:_getTouchScaleY())

  
    --创建剪裁节点
    self._stencilLayer = cc.LayerColor:create(cc.c4b(0, 0, 0, 150), self._width, self._height)
    local ccclippingNode = cc.ClippingNode:create(self._stencilLayer)
    self:addChild(ccclippingNode)
    -- ccclippingNode:setStencil(stencilLayer)
    self._baseRootNode = cc.Node:create()
    ccclippingNode:addChild(self._baseRootNode)
    self._content = cc.Node:create()
    -- self._content:setTouchCaptureEnabled(false)
    -- self._content:setTouchEnabled(false)
    self._baseRootNode:addChild(self._content)

    self._touchLayer = cc.Layer:create()
    self:addChild(self._touchLayer)
    -- self._touchLayer:setCascadeBoundingBox(self._touchBoundingBox)
    self._touchLayer:setTouchEnabled(true)
    self._touchLayer:setTouchMode(cc.EVENT_TOUCH_ONE_BY_ONE)
    -- self._touchLayer:setSwallowTouches(isSwallow)
    self._listener = cc.EventListenerTouchOneByOne:create()
    self._listener:setEnabled(true)
    self._listener:setSwallowTouches(true)
    self._listener:registerScriptHandler(handler(self, self.onTouchBegan), cc.Handler.EVENT_TOUCH_BEGAN)
    self._listener:registerScriptHandler(handler(self, self.onTouchMoved), cc.Handler.EVENT_TOUCH_MOVED)
    self._listener:registerScriptHandler(handler(self, self.onTouchEnded), cc.Handler.EVENT_TOUCH_ENDED)
    cc.Director:getInstance():getEventDispatcher():addEventListenerWithSceneGraphPriority(self._listener, self._touchLayer)
    -- self._touchLayer:addEventListener(cc.Handler.EVENT_TOUCH_ENDED, handler(self, ListView.onTouch))
    --
    -- self:addEventListener(cc.NODE_ENTER_FRAME_EVENT, handler(self, ListView.onFrame))
    -- self._onFrameHandler = self:scheduleUpdateWithPriorityLua(handler(self, ListView.onFrame), 0)

    self:scheduleUpdate(handler(self, ListView.onFrame),0)

    self._listViewImp.initListView(self)
end

local function _scaleX(node)
    return node and (node:getScaleX() * _scaleX(node:getParent())) or 1
end
function ListView:_getTouchScaleX()
    if self._relatedLayer then
        return _scaleX(self._relatedLayer)
    else
        return 1.0
    end
end

local function _scaleY(node)
    return node and (node:getScaleX() * _scaleY(node:getParent())) or 1
end
function ListView:_getTouchScaleY()
    if self._relatedLayer then
        return _scaleY(self._relatedLayer)
    else
        return 1.0
    end
end

--[[
    对外接口

]]

function ListView:resetTouchRect()
    local size = self:getContentSize()
    self._width = size.width
    self._height = size.height

    self._rect = cc.rect(0,0,self._width,self._height)
    local pos 
    if tolua.cast(self,"CCLayer") then
       pos = self:convertToWorldSpace(cc.p(0,0))
    else
       pos = self:convertToWorldSpaceAR(cc.p(0,0))
    end
    self._touchBoundingBox = cc.rect(pos.x,pos.y,self._width * self:_getTouchScaleX(),self._height * self:_getTouchScaleY())
    -- self._touchLayer:setCascadeBoundingBox(self._touchBoundingBox)
    self._stencilLayer:setContentSize(size)

    if self._isInitShadow then
        if self._isVertical then
            if self._topShadow ~= nil then
                self._topShadow:setPosition(0, self._height - 25)
                self._topShadow:setContentSize(cc.size(self._width, 25))
            end
            if self._bottomShadow then
                self._bottomShadow:setPosition(0, 0)
                self._bottomShadow:setContentSize(cc.size(self._width, 25))
            end
        else
            if self._leftShadow ~= nil then
                self._leftShadow:setPosition(0, 0)
                self._leftShadow:setContentSize(cc.size(25, self._height))
            end
            if self._rightShadow then
                self._rightShadow:setPosition(self._width - 25, 0)
                self._rightShadow:setContentSize(cc.size(25, self._height))
            end
        end
    end
end
--清空所有items
function ListView:clear( isCleanUp )
    -- body
    self._listViewImp.clearAllItems(self,isCleanUp)
end

-- 移动的距离
function ListView:getDistanceY()
    return self._dragY
end

function ListView:getDistanceX()
    return self._dragX
end

function ListView:getCurHeight()
    return self._curHeight
end

function ListView:getHeight()
    return self._height
end

function ListView:getCanDistanceY()
    return self._curHeight - self._height
end

function ListView:setScollDelegate( callback )
    -- body
    self._scrollDelegate = callback
end

--reload数据
function ListView:reload( param )
    -- body
    self:clear(param.isCleanUp)
    
    self._headIndex = param.headIndex or self._headIndex        --当前视口的起始索引
    self._tailIndex = param.tailIndex or self._tailIndex        --当前视口的结束索引
    self._totalNumber = param.totalNumber or self._totalNumber
    self._isVertical = param.isVertical == nil and self._isVertical or param.isVertical
    self._maxItemNum = param.maxItemNum or self._maxItemNum
    self._renderItemCallBack = param.renderItemCallBack or self._renderItemCallBack
    self._multiItems = param.multiItems or self._multiItems    -- 一行有2个或者多个
    self._curOffset = param.curOffset or self._curOffset
    self._curOriginOffset = param.curOriginOffset or self._curOriginOffset
    self._spaceY = param.spaceY or self._spaceY
    self._spaceX = param.spaceX or self._spaceX
    self._headIndexPosOffset = param.headIndexPosOffset or self._headIndexPosOffset
    self._relatedLayer = param.node
   
    if self._maxItemNum and self._totalNumber and self._maxItemNum < self._totalNumber then
        self._totalNumber = self._maxItemNum
    end

    self._baseStartIndex =  param.baseStartIndex or 1
    self._baseEndIndex = self._baseStartIndex + self._totalNumber -1
    if self._multiItems ~=1 and self._baseStartIndex % self._multiItems ~= 1 then
        self._baseStartIndex = self._baseStartIndex - (self._baseStartIndex -1)%self._multiItems + self._multiItem
    end

    if self._isVertical then
        if param._curOffset then
            self._curOffset = self._curOffset - self._spaceY
        end
        self._listViewImp = QVerticalListViewImp
    else
        if param._curOffset then
            self._curOffset = self._curOffset - self._spaceX
        end
        
        self._listViewImp = QHorizontalListViewImp
    end
    self._content:setPosition(0,0)

    self._listViewImp.initListView(self)
end

-- 刷新数据  --必须保证 数据的值 不会影响 item 大小  没变 否则 可能已发 bug
function ListView:refreshData( )
    self._listViewImp.stopSpeedScheduler(self)
    self:stopLongPressScheduler()
    self:stopScrollToPosScheduler()
    self:stopScrollToIndex()

    self:clearAllClickHandler()
    self:clearAllTouchHandler()
    self._curTouchIndex = nil
    self._curTouchNodeName = nil
    self._startScrollToIndex = nil
    for i = self._startIndex,self._endIndex do
        self:refreshItem(i)
    end
    self._listViewImp.onScroll(self)
end


function ListView:refreshAddData(param)
    self._listViewImp.stopSpeedScheduler(self)
    self:stopLongPressScheduler()
    self:stopScrollToPosScheduler()
    self:stopScrollToIndex()
    self:clearAllClickHandler()
    self:clearAllTouchHandler()
    self._curTouchIndex = nil
    self._curTouchNodeName = nil
    self._startScrollToIndex = nil

    -- self:setBaseNodePosY(self._dragY)

    self._totalNumber = param.totalNumber or self._totalNumber
    self._renderItemCallBack = param.renderItemCallBack or self._renderItemCallBack
    self._baseEndIndex = self._baseStartIndex + self._totalNumber -1
    for i = self._startIndex,self._endIndex do
        self:refreshItem(i)
    end
    self._listViewImp.onScroll(self)
end

-- renderItemCallBack 回调函数中使用  从缓存中 获取node
function ListView:getItemFromCache( tag )
    -- body
    tag = tag or "default"
    if self._cacheNodes[tag] and #self._cacheNodes[tag] > 0 then
        local item = self._cacheNodes[tag][1]
        table.remove(self._cacheNodes[tag],1)
        return item
    end
end
--滚动到指定索引  index 指定的索引   isTail index结尾 还是开头   speed 滚动速度 默认 20
function ListView:startScrollToIndex( index, isTail,speed, callback)
    -- body
    if index > self._baseEndIndex or index < self._baseStartIndex then
        print("error index  must <= self._baseEndIndex and must >= self._baseStartIndex index ",index, "  self._baseEndIndex ",self._baseEndIndex," self._baseStartIndex ",self._baseStartIndex)
        return
    end
    self._scrollToIndexTargetIndex = index - (index -1)%self._multiItems
    self._scrollToIndexIsTail = isTail or true
    self._scrollToIndexSpeed = speed or 20
    self._scrollToIndexTargetPos = nil
    self._startScrollToIndex = true
    self._scrollToIndexCallBack = callback
end

function ListView:stopScrollToIndex( )
    -- body
    self._scrollToIndexTargetIndex = nil
    self._scrollToIndexIsTail = nil
    self._scrollToIndexSpeed = nil
    self._scrollToIndexTargetPos = nil
    self._startScrollToIndex = nil
    if self._scrollToIndexCallBack then
        self._scrollToIndexCallBack()
        self._scrollToIndexCallBack = nil
    end
end

--获取指定索引的 item
function ListView:getItemByIndex( index )
    if index >= self._startIndex and index <= self._endIndex then
        return self._itemsInfo[index].item
    end
end

--获取item的数量
function ListView:getItemCount()
    return #self._itemsInfo
end

-- 预先增加 高度  一般不要直接修改
function ListView:getRect( )
    -- body
    return self._rect
end

--屏蔽触摸事件
function ListView:setShieldTouch( trueOrFalse )
    -- body
    self._shieldTouch = trueOrFalse
end

--设置是否可以 触摸移动
function ListView:setCanNotTouchMove( trueOrFalse )
    -- body
    self._canNotTouchMove = trueOrFalse
end

function ListView:getCanDrag()
    if self._isVertical then
        return self._canDragY
    else
        return self._canDragX
    end
end

function ListView:getItemPosToTopDistance( index )
    -- body
    local itemInfo = self._itemsInfo[index]
    if itemInfo then
        if self._isVertical then    
            return math.abs(itemInfo.pos.y - self._baseRootY) - self._dragY
        end 
    end
    return 0
end

--[[
    内部函数 
]]
-- function ListView:onTouch(event)
--     if event.name == "began" then
--         self._touchBeganRet = self._listViewImp.onTouchBegin(self, event.x, event.y)
--         return self._touchBeganRet
--     elseif event.name == "moved" then
--         self._listViewImp.onTouchMove(self, event.x, event.y)
--     elseif event.name == "ended" then
--         self._listViewImp.onTouchEnd(self, event.x, event.y)
--         self._touchBeganRet = nil
--     end
-- end

function ListView:onTouchBegan(touch, event)

    local p = self:convertToNodeSpace(touch:getLocation())
    self._touchBeganRet = self._listViewImp.onTouchBegin(self, touch:getLocation().x, touch:getLocation().y)
    if self._touchBeganRet then
        print("ListView:onTouchBegan Occupy from layer ", self._layerName)
    end

    return self._touchBeganRet
end

function ListView:onTouchMoved(touch, event)
    local p = self:convertToNodeSpace(touch:getLocation())

    self._listViewImp.onTouchMove(self, touch:getLocation().x, touch:getLocation().y)
end

function ListView:onTouchEnded(touch, event)
    local p = self:convertToNodeSpace(touch:getLocation())
    self._listViewImp.onTouchEnd(self, touch:getLocation().x, touch:getLocation().y)
    self._touchBeganRet = nil
end

function ListView:onFrame( dt )
    self._listViewImp.scrollToIndexOnFrame(self,dt)
    self._listViewImp.getSpeedOnFrame(self, dt)
    self._listViewImp.scrollToPosOnFrame(self, dt)
    self:longPressOnFrame(dt)
end

function ListView:setBaseNodePosX( dragx )
    -- body
    self._baseRootNode:setPositionX(dragx)
    if self._scrollDelegate then
        self._scrollDelegate(dragx, 0)  
    end
end

function ListView:setBaseNodePosY( dragy )
    -- body
    self._baseRootNode:setPositionY(dragy)
    if self._scrollDelegate then
        self._scrollDelegate(0, dragy)  
    end
end

function ListView:addItemToCache( index, info )
    -- body
    local item = info.item
    local tag = info.tag or "default"
    if not self._cacheNodes[tag] then
        self._cacheNodes[tag] = {}
    end
    item:setVisible(false)
    self:unRegisterTouchHandler(index)
    self:unregisterUnClickRegionHandlers(index)
    self:unRegisterClickHandler(index)
    table.insert(self._cacheNodes[tag],item)
end

function ListView:renderItem( index, info )
    -- body
    local isCacheNode = self._renderItemCallBack(self,index,info)

    if not info.item  or not info.size then
        print("error  info is empty")
        return 
    end
    local item = info.item
    if not isCacheNode then
        item:setVisible(false)
        self._content:addChild(item)
    end
    info.size.height = info.size.height + self._spaceY
    info.size.width = info.size.width + self._spaceX
    
    return item
end


function ListView:refreshItem( index )
    -- body
    local info = self._itemsInfo[index]
    if not info then
        return
    end
    self:addItemToCache(index, info)
    self:renderItem(index,info)
    info.item:setPosition(info.pos)
end

function ListView:addItem( isAutoScroll )
    -- body
    self._listViewImp.addItem(self,isAutoScroll)
end


function ListView:getCurGesture(  )
    -- body
    return self._curGesture
end

------------------------触摸点击逻辑---------------
function ListView.isTouchInside( node, x, y)
    -- body
    local  parent = node:getParent()
    if parent then
        local point = parent:convertToNodeSpace(cc.p(x,y))
        local rt = node:getBoundingBox()

        return cc.rectContainsPoint(rt, point)
    else
        print("error can not find parent")
    end
    return false
end

function ListView.isTouchNodeVisible( node )
    -- body
    if node:isVisible() then
        local parent = node:getParent()
        if parent then
            return ListView.isTouchNodeVisible(parent)
        else
            return true
        end
    end
end
---
function ListView.doBtnPressIn( x, y, touchNodeNode, list)
    local ret = false
    if touchNodeNode:isEnabled() and ListView.isTouchNodeVisible(touchNodeNode) and  ListView.isTouchInside(touchNodeNode, x, y) then
        touchNodeNode:setHighlighted(true)
        -- item:setScale(0.95)
        ret = true
    end
    return ret
end

function ListView.doBtnCancelPressIn( x , y, touchNodeNode, list)
    -- body
    -- item:setScale(1)
    touchNodeNode:setHighlighted(false)
end



function ListView.doItemBoxPressIn( x, y, touchNodeNode, list )
    -- body
    local ret = false
    if touchNodeNode and touchNodeNode and touchNodeNode.sprite_back then
        local node = tolua.cast(touchNodeNode.sprite_back, "cc.Sprite")
        if node then
            if ListView.isTouchInside(node, x, y) then
                ret = true
            end
        end
    end
    
    return ret
end

function ListView.doItemBoxClickIn( x, y, touchNodeNode, list )
    -- body
    if touchNodeNode then
        app.tip:itemTip(touchNodeNode._itemType, touchNodeNode._itemID)
    end
end


function ListView:startLongPressScheduler(  )
    -- body
    self._longPressTime = 0
end


function ListView:stopLongPressScheduler(  )
    -- body
    self._longPressTime = nil
end

function ListView:longPressOnFrame(dt)
    -- body
    if self._longPressTime then
        self._longPressTime = self._longPressTime + dt
        if self._longPressTime > 0.4 then
            if self._lastPressX and self._lastPressY then
                self:doLongPressIn(self._lastPressX, self._lastPressY)
                self:stopLongPressScheduler()
            end
        end
    end
end


function ListView:calculateTouchIndex( x, y )
    -- body
    local pos = self._content:convertToNodeSpace(cc.p(x,y))
    if not pos then
        lt.LogUtil:debugError("pos is nil")
    end
    for i = self._startIndex,self._endIndex do
        local info = self._itemsInfo[i]
        --判断点击index
        if pos.x > info.pos.x and pos.x <= info.pos.x + info.size.width and pos.y < info.pos.y and pos.y >= info.pos.y - info.size.height then
            self._curTouchIndex = i
            break;
        end
    end
end

function ListView:resetTouchIndex()
   self._curTouchIndex = nil
end

--[[
ListView._touchHandlers中
1. 可以注册cc.Node节点, 会自动调用节点的回调方法[onListViewTouchBegan, onListViewTouchMoved, onListViewTouchEnded]
   节点会检测是否在节点的显示区域, 调用成功目前会吞噬事件
2. 可以注册回调函数
3. 可以注册方法名, 会调用cell对应的方法名
4. 可以注册table, table可以由以上三种类型进行组合.

使用这里事件可以对于ListView 滑动事件不向下传递的一些处理.
]]
function ListView:doTouchBegin( x,y )
    if not self._curTouchIndex  then
        if self._touchEvent then
            if type(self._touchEvent) == "function" then
                self._touchEvent({name = "began", x = x, y = y})
            end
        end
        return 
    end

    local touchHandler = self._touchHandlers[self._curTouchIndex]
    local _process = function (obj)
        if iskindof(obj, "cc.Node") then
            if obj:isVisible() and cc.rectContainsPoint(obj:getBoundingBox(), obj:getParent():convertToNodeSpace(cc.p(x,y))) then 
                if obj["onListViewTouchBegan"] then
                    obj["onListViewTouchBegan"](obj, {name = "began", x = x, y = y})
                    return true
                end
            end
        elseif type(obj) == "function" then
            touchHandler({name = "began", x = x, y = y})
        elseif type(obj) == "string" then
            local item  = self._itemsInfo[self._curTouchIndex].item
            if item then
                item[obj](item, {name = "began", x = x, y = y})
            end
        end
    end

    if type(touchHandler) == "table" then
        for _,v in pairs(touchHandler) do
            if _process(v) then
                break
            end
        end
    else
        _process(touchHandler)   
    end
end


function ListView:doTouchMove( x, y )
    if not self._curTouchIndex then
        if self._touchEvent then
            if type(self._touchEvent) == "function" then
                self._touchEvent({name = "moved", x = x, y = y})
            end
        end
        return 
    end

    local touchHandler = self._touchHandlers[self._curTouchIndex]
    local _process = function (obj)
        if iskindof(obj, "cc.Node") then
            if obj:isVisible() and obj["onListViewTouchMoved"] then
                obj["onListViewTouchMoved"](obj, {name = "moved", x = x, y = y})
            end
        elseif type(obj) == "function" then
            touchHandler({name = "moved", x = x, y = y})
        elseif type(obj) == "string" then
            local item  = self._itemsInfo[self._curTouchIndex].item
            if item then
                item[obj](item, {name = "moved", x = x, y = y})
            end
        end
    end

    if type(touchHandler) == "table" then
        for _,v in pairs(touchHandler) do
            _process(v)
        end
    else
        _process(touchHandler)   
    end

    -- local touchHandler = self._touchHandlers[self._curTouchIndex]
    -- if type(touchHandler) == "function" then
    --     touchHandler({name = "moved", x = x, y = y})
    -- elseif type(touchHandler) == "string" then
    --     local item  = self._itemsInfo[self._curTouchIndex].item
    --     if item then
    --         item[touchHandler](item, {name = "moved", x = x, y = y})
    --     end
    -- end
end

function ListView:doTouchEnd( x, y )  
    if not self._curTouchIndex then
        if self._touchEvent then
            if type(self._touchEvent) == "function" then
                self._touchEvent({name = "ended", x = x, y = y})
            end
        end
        return 
    end

    local touchHandler = self._touchHandlers[self._curTouchIndex]
    local _process = function (obj)
        if iskindof(obj, "cc.Node") then
            if obj:isVisible() and obj["onListViewTouchEnded"] then
                obj["onListViewTouchEnded"](obj, {name = "ended", x = x, y = y})
            end
        elseif type(obj) == "function" then
            touchHandler({name = "ended", x = x, y = y})
        elseif type(obj) == "string" then
            local item  = self._itemsInfo[self._curTouchIndex].item
            if item then
                item[obj](item, {name = "ended", x = x, y = y})
            end
        end
    end

    if type(touchHandler) == "table" then
        for _,v in pairs(touchHandler) do
            _process(v)
        end
    else
        _process(touchHandler)   
    end

    -- if type(touchHandler) == "function" then
    --     touchHandler({name = "ended", x = x, y = y})
    -- elseif type(touchHandler) == "string" then
