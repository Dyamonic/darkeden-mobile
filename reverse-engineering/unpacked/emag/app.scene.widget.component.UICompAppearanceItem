---@class UICompAppearanceItem 染色物品item
---
local UICompAppearanceItem = class("UICompAppearanceItem", lt.UIGButtonBase, lt.UICompChangeSkin)

local Constant = lt.Constant

UICompAppearanceItem.ChangeSkinConf = {
   ["Inventory"] = {
        ["bg"] = "tiled_bg",
        ["grid"] = "tiled",
        ["isExist"] = "tiled_bgSelect",
   } 
}

function UICompAppearanceItem:ctor()
    self._itemId   = nil
    self._icon     = nil
    self._select   = nil
    self._active   = nil
    self._callback = nil
    self._isExist  = nil
    UICompAppearanceItem.super.ctor(self)
end

function UICompAppearanceItem:onClear()
    self._itemId   = nil
    self._icon     = nil
    self._select   = nil
    self._active   = nil
    self._callback = nil
    self._isExist  = nil
    UICompAppearanceItem.super.onClear(self)
end

function UICompAppearanceItem:onEnter()
    self:addClickListener(handler(self, self.clickFunc))
end

function UICompAppearanceItem:onExit()
    self:removeClickListener()
end

function UICompAppearanceItem:onConstruct()
    self:startSkin()

    self._icon = self:getChild("icon")
    self._select = self:getChild("select")
    self._active = self:getChild("active")
    self._isExist = self:getChild("isExist")
end

function UICompAppearanceItem:setInfo(itemId,callback,appearanceType)
    self._itemId = itemId
    self._callback = callback
    local itemMeta = lt.CacheManager:getItemMeta(itemId)
    if not itemMeta then
        self._icon:setVisible(false)
        self._select:setVisible(false)
        self._active:setVisible(false)
        self._isExist:setVisible(false)
        return
    end

    self._icon:setVisible(true)
    self._icon:setURL(string.format(_GURL.GetImageItem, itemMeta:getIconId()))

    local curNum = lt.ItemModule:getItemNum(itemId)
    if curNum < 1 then
        -- self._icon:setGrayed(true)
        self._isExist:setVisible(false)
        -- if appearanceType == Constant.Appearance.Hair then
        --     self._icon:setURL(string.format(_GURL.GetImageItem, 802009))
        -- end
    else
        -- self._icon:setGrayed(false)
        self._isExist:setVisible(true)
    end
end

function UICompAppearanceItem:setInfoEmpty()
    self._itemId = nil
    self._icon:setVisible(false)
    self._select:setVisible(false)
    self._active:setVisible(false)
    self._isExist:setVisible(false)
end

function UICompAppearanceItem:clickFunc()
    if not self._itemId then
       return
    end

    if self._callback then
        self._callback()
    end
end

function UICompAppearanceItem:setSelected(value)
    self._select:setVisible(value)
end

function UICompAppearanceItem:getItemId()
    return self._itemId
end

return UICompAppearanceItem