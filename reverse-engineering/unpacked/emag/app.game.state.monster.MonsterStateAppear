
local MonsterStateAppear = class("MonsterStateAppear", lt.MonsterStateBase)
local Constant = lt.Constant
local CacheManager = lt.CacheManager

local dirFrameCount = 16
local dirStepTime   = 0.05

--[[
    怪物出场特效   宠物出场特效
]]

MonsterStateAppear._timeTrigger = nil
MonsterStateAppear._runDirStepCount = 0
MonsterStateAppear._timeRunDir = nil

function MonsterStateAppear:ctor(monsterAgent)
    MonsterStateAppear.super.ctor(self, monsterAgent)

    self._monsterActor = self._monsterAgent:getActor()

    -- 怪出现方式时间获取
    local time = dirFrameCount*dirStepTime
    if self._monsterAgent:isPet() then  -- 宠物出现方式读配置表
        local monsterData = self._monsterAgent:getMonsterData()
        local petMeta = lt.CacheManager:getPetMeta(monsterData:getMonsterId())
        time = petMeta:getTime()/1000
    end
    self._timeTrigger = lt.TimeTrigger.new(time)
    self:showAppear()
end

function MonsterStateAppear:onClear()
end

function MonsterStateAppear:onEnter()
end

function MonsterStateAppear:onExit()
end

function MonsterStateAppear:onUpdate()
    local deltaTime = lt.GameBoard:getDeltaTime()
    if self._timeTrigger:tick(deltaTime) then
        self._monsterAgent:changeState(lt.MonsterStateIdle.new(self._monsterAgent))
        self._monsterActor:setActionPause(false)
        return
    end

    self:updateDir()
end

function MonsterStateAppear:showAppear()
    ----------------------------------------------------------------------------------------
    -- 旋转参数初始化
    self._runDirStepCount = 0
    self._timeRunDir = nil
    ----------------------------------------------------------------------------------------

    if self._monsterAgent:isPet() then
        -- 特定宠物根据特定方式出现
        self:showPetAppear()
    else
        -- 普通出现方式
        self:showCommonAppear()
    end
end
function MonsterStateAppear:onMessage(msg)
end

function MonsterStateAppear:getStateId()
    return lt.Constant.MONSTER_STATE_APPEAR
end

function MonsterStateAppear:getStateName()
    return "MonsterStateAppear"
end


----------------------------------------------------------------------------------------
-- 普通出现方式
function MonsterStateAppear:showCommonAppear()
    self._monsterAgent:playAction(Constant.ACTION_STAND)

    local skillId = 992 -- 利用技能特效表
    local effectMetas = CacheManager:getProcessMetas(skillId)
    self._monsterAgent:playSoleParalSpecail(skillId,{effectMetas[1]})
    self._monsterAgent:playParallelEffectSpecial(skillId,{effectMetas[2]})
    
    -- 旋转
    self._runDirStepCount = dirFrameCount
    self._timeRunDir = lt.TimeTrigger.new(dirStepTime)

    -- 裁减
    self._monsterActor:setActionPause(true)
    self._monsterActor:updateClipFrame(0)
end

----------------------------------------------------------------------------------------
-- 宠物出现方式
function MonsterStateAppear:showPetAppear()
    self._monsterAgent:playAction(Constant.ACTION_PET_DIG)
end
----------------------------------------------------------------------------------------
-- 旋转
function MonsterStateAppear:updateDir()
    if self._runDirStepCount <= 0 then
        self._timeRunDir = nil
        return
    end

    if not self._timeRunDir then
        return
    end

    local curDir = self._monsterAgent:getDirection()
    local deltaTime = lt.GameBoard:getDeltaTime()
    local direction = curDir + 1
    if self._timeRunDir:tick(deltaTime) then
        if direction < Constant.DIRECTION_LEFT then direction = Constant.DIRECTION_LEFT_UP end
        if direction > Constant.DIRECTION_LEFT_UP then direction = Constant.DIRECTION_LEFT end
        self._monsterAgent:setDirection(direction)
        self._timeRunDir = lt.TimeTrigger.new(dirStepTime)
        self._runDirStepCount = self._runDirStepCount - 1

        self._monsterActor:updateClipFrame((dirFrameCount-self._runDirStepCount)/dirFrameCount)
    end
end

return MonsterStateAppear
