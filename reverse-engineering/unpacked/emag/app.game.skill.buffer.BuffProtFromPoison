local BuffProtFromPoison = class("BuffProtFromPoison", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum

--[[
    毒液抵抗
]]
function BuffProtFromPoison:ctor(time, actor, skilllevel, source)    
    BuffProtFromPoison.super.ctor(self, BuffEnum.EFFECT_PROTECTION_FROM_POISON, time, actor, skilllevel)
    -- 脚底长效特效
    actor:playSoleEffect(SkillEnum.SKILL_PROTECTION_FROM_POISON, SkillEnum.EFFECT_OWNER.OTHER, true)

    -- 瞬时上层特效
    local isExist = (source or {}).isExist or false
    if not isExist then
        actor:playParallelEffect(SkillEnum.SKILL_PROTECTION_FROM_POISON)
    end
end

function BuffProtFromPoison:onClear()
    self._actor:removeSoleEffect(SkillEnum.SKILL_PROTECTION_FROM_POISON, true)
    BuffProtFromPoison.super.onClear(self)
end

return BuffProtFromPoison
