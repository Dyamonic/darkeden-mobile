local SevenDayMissionDao = {}
function SevenDayMissionDao:queryAll()
    local mapTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM SevenDayMission") do
        local meta = lt.SevenDayMissionMeta.new(row)
        mapTable[#mapTable + 1] = meta
    end
    return mapTable
end

function SevenDayMissionDao:query(missionId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM SevenDayMission WHERE MissionId=%d;", tonumber(missionId))) do
        local meta = lt.SevenDayMissionMeta.new(row)
        return meta
    end
end

return SevenDayMissionDao
