-- 排行榜tips
---@class UICompRankInfoTips
local UICompRankInfoTips   = class("UICompRankInfoTips", lt.UIGButtonBase)

local Constant             = lt.Constant
local NtfManager           = lt.NtfManager
local BtnType              = Constant.GuildTipBtns
local FriendModule         = lt.FriendModule
local RaceSkinRes          = Constant.RaceSkinRes
local GameModule           = lt.GameModule
local TeamModule           = lt.TeamModule
local FunctionToggleModule = lt.FunctionToggleModule

local BTN_HEIHT            = 47

local BTN_GROUPS           = {
    [BtnType.CheckPlayer]  = { name = GReadText.KEY_GUILD_TIPS3, type = BtnType.CheckPlayer },
    [BtnType.PrivateChat]  = { name = GReadText.KEY_CHAT_TIPS6, type = BtnType.PrivateChat },
    [BtnType.FriendAdd]    = { name = GReadText.KEY_CHAT_TIPS7, type = BtnType.FriendAdd },
    [BtnType.UpDuty]       = { name = GReadText.KEY_GUILD_TIPS5, type = BtnType.UpDuty },
    [BtnType.ChangeMaster] = { name = GReadText.KEY_GUILD_TIPS6, type = BtnType.ChangeMaster },
    [BtnType.DownDuty]     = { name = GReadText.KEY_GUILD_TIPS7, type = BtnType.DownDuty },
    [BtnType.KickGuild]    = { name = GReadText.KEY_GUILD_TIPS8, type = BtnType.KickGuild },
    [BtnType.InviteInTeam] = { name = GReadText.KEY_TEAM_HALL_TIPS31, type = BtnType.InviteInTeam },
    [BtnType.ApplyInTeam]  = { name = GReadText.KEY_TEAM_HALL_TIPS32, type = BtnType.ApplyInTeam },
}

function UICompRankInfoTips:ctor()
    UICompRankInfoTips.super.ctor(self)
    self:makeFullScreen()
    self._touchLayer = nil
end

function UICompRankInfoTips:onClear()
    self._touchLayer = nil
    self._btnTabList = nil
    self._bg         = nil
    UICompRankInfoTips.super.onClear(self)
end

function UICompRankInfoTips:onEnter()
    UICompRankInfoTips.super.onEnter(self)
    self._btnTabList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickBtnHandler))
    self._touchLayer:addEventListener(fgui.UIEventType.TouchBegin, handler(self, self.onLayerClick))
end

function UICompRankInfoTips:onExit()
    self._btnTabList:removeEventListener(fgui.UIEventType.ClickItem)
    self._touchLayer:removeEventListener(fgui.UIEventType.TouchBegin)
    UICompRankInfoTips.super.onExit(self)
end

function UICompRankInfoTips:onConstruct()
    self._btnTabList = self:getChild("tabList")
    self._bg         = self:getChild("bg")
    self._touchLayer = self:getChild("touch")
end

function UICompRankInfoTips:onLayerClick()
    self:hideSelf()
end

function UICompRankInfoTips:hideSelf()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_RANK_INFO_TIPS)
end

function UICompRankInfoTips:refreshTips(param)
    -- 传入数据
    self._roleData = param.roleData
    self._btnTabList:setNumItems(0)
    self:btnGroupsShow()

    local pos = param.pos
    if pos then
        self._bg:setPosition(pos.x, pos.y)
        self._btnTabList:setPosition(pos.x, pos.y + 2)
    end
end

function UICompRankInfoTips:btnGroupsShow()
    local btnsGroups = {}
    -- 查看信息
    table.insert(btnsGroups, BTN_GROUPS[BtnType.CheckPlayer])


    -- 判断一个种族 ->组队

    local targetRace = self._roleData.race
    local heroData = GameModule:getHeroData()
    local myRace = heroData:getRace()
    if targetRace == myRace then
        -- 私聊
        local openChat, tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.Chat)
        if openChat then
            table.insert(btnsGroups, BTN_GROUPS[BtnType.PrivateChat])
        end

        -- 申请好友
        if not FriendModule:checkIsFriend(self._roleData.playerName) then
            -- 申请好友
            local openFriend, tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.Friend)
            if openFriend then
                table.insert(btnsGroups, BTN_GROUPS[BtnType.FriendAdd])
            end
        end


        local openTeam, tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.Team)
        if openTeam then
            local teamId = self._roleData.teamId or 0
            if teamId == 0 then
                -- 邀请组队
                table.insert(btnsGroups, BTN_GROUPS[BtnType.InviteInTeam])
            else
                -- 申请入队
                if heroData:getTeamId() == 0 then
                    table.insert(btnsGroups, BTN_GROUPS[BtnType.ApplyInTeam])
                end
            end
        end
    end


    for _, btnInfo in ipairs(btnsGroups) do
        local btnNode = self._btnTabList:addItemFromPool()
        btnNode:setTitle(btnInfo.name)
        btnNode:setIcon((string.format(_GURL.GetImageDestInfoTipsIcon, RaceSkinRes[GameModule:getHeroRace()])))
        btnNode.btnType = btnInfo.type
    end

    local originalSize = self._btnTabList:getSize()
    self._btnTabList:setSize(originalSize.width, BTN_HEIHT * #btnsGroups + #btnsGroups * 2)
    self._bg:setSize(self._bg:getSize().width, BTN_HEIHT * #btnsGroups + #btnsGroups * 2 + 2)
end

function UICompRankInfoTips:onClickBtnHandler(context)
    local btn = context:getData()
    local type = btn.btnType
    self:btnUseByType(type)
    self:hideSelf()
end

function UICompRankInfoTips:btnUseByType(type)
    if not self._roleData then
        return
    end
    if type == BtnType.CheckPlayer then
        lt.RankModule:onQueryPlayerReq(self._roleData.playerId)
    elseif type == BtnType.PrivateChat then
        if not lt.FriendModule:checkIsFriend(self._roleData.playerName) then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, { content = GReadText.KEY_RANK_TIPS4 })
            return
        end
        lt.ChatModule:openChatUI(self._roleData.playerName)
    elseif type == BtnType.FriendAdd then
        FriendModule:sendFriendApplyReq(self._roleData.playerId, self._roleData.playerName)
    elseif type == BtnType.InviteInTeam then
        local heroData = GameModule:getHeroData()
        --自己没队伍先创建队伍
        if heroData:getTeamId() == 0 then
            TeamModule:fastCreateTeam(self._roleData.playerId)
        else
            TeamModule:sendInviteTeam(self._roleData.playerId)
        end
    elseif type == BtnType.ApplyInTeam then
        TeamModule:sendApplyInTeam(self._roleData.teamId)
    end
end

return UICompRankInfoTips
