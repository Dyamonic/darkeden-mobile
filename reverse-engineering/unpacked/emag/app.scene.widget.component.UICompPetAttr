function UICompPetAttr:checkGuide()
    --宠物出战引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.PETFIGHT15) then
        local pos = self:displayObject():convertToWorldSpace(self._summonBtn:getPosition())
        pos = cc.p(pos.x, pos.y + self._summonBtn:getSize().height/2 + 10)
        GuideModule:triggerGuide(Constant.GUIDE_ID.PETFIGHT15, self._summonBtn, pos, function()
            self:onSummonBtnClick()
        end)
        return
    end

    --宠物喂养引导
    if GuideModule:checkCanGuide(Constant.GUIDE_ID.PETFEED4) then
        local pos = self:displayObject():convertToWorldSpace(self._btnFeed:getPosition())
        pos = cc.p(pos.x, pos.y + self._btnFeed:getSize().height/2 + 10)
        GuideModule:triggerGuide(Constant.GUIDE_ID.PETFEED4, self._btnFeed, pos, function()
            self:onBtnFeedClick()
        end)
        return
    end
end

return UICompPetAttr