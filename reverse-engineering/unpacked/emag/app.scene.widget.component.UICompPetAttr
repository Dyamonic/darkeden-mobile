function UICompPetAttr:refreshTime()
    local btnCountDown = self:getChild("btn_count_down")
    local btnFastForward = self:getChild("btn_fast_forward")
    if not self._petInfo then
        btnCountDown:setVisible(false)
        btnFastForward:setVisible(false)
        return
    end
    btnFastForward:setVisible(true)
    local digSpeedUpTime = PetModule:getDigSpeedUpTime(self._petInfo,true)
    if digSpeedUpTime == 0 then
        btnCountDown:setVisible(false)
    else
        btnCountDown:setVisible(true)
        btnCountDown:getChild("time"):setText(digSpeedUpTime)
    end
    local expSpeedUpTime = PetModule:getExpSpeedUpTime(self._petInfo,true)
    if expSpeedUpTime == 0 then
        btnFastForward:setVisible(false)
    else
        btnFastForward:setVisible(true)
        btnFastForward:getChild("time"):setText(expSpeedUpTime)
    end
    -- yflog:Info("digSpeedUpTime = %s, expSpeedUpTime = %s", digSpeedUpTime, expSpeedUpTime)
end

function UICompPetAttr:onSourceBtnClick()
    if self._petInfo.meta then
        if PET_PENGUIN == self._petInfo.meta:getId() then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndVip", param = {selectIndex = 6}})
            return
        end

        local itemMeta = CacheManager:getItemMeta(self._petInfo.meta:getItemId())
        local access = itemMeta:getAccess()
        if access then
            local jumpStore = access[1][2]
            lt.RechargeModule:openRechargeByItemId(jumpStore)
        end
    else
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndRecharge"})
    end
end

function UICompPetAttr:ontakebackBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {type = 2, content = GReadText.KEY_PET_TIPS30, confirmCallback = function()
        PetModule:sendPetTakeOut(self._petInfo)
    end})
end

function UICompPetAttr:onSummonBtnClick()
    local petData = self._petInfo.data
    if petData:getStatus() == 0 then
        --出战
        PetModule:sendPetFight(self._petInfo, true)
    else
        --休息
        PetModule:sendPetFight(self._petInfo, false)
    end
end

function UICompPetAttr:onSelectBtnClick()
    local petData = self._petInfo.data
    local iid = tostring(petData:getUid())
    local toppingId = PetModule:getToppingId()
    if toppingId == iid then
        PetModule:setToppingId(tostring(0))
    else
        PetModule:setToppingId(iid)
    end
    self._controlBtn:setSelectedIndex(toppingId == iid and 0 or 1)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_PET_LIST)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_RESET_PET_INDEX)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_PET_MY)
end

function UICompPetAttr:onDigBtnClick()
    local petInfo = (self._petInfo or {}).data
    if not petInfo then
        -- 没有宠物数据
        return
    end
    if PetModule:isDie(petInfo:getDeadTime()) then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS56})
        return
    end
    if not petInfo:getDig() then
        if petInfo:getOpenDigLeftTimes() == 0 then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS86})
            return
        end
        --开启挖头
        PetModule:sendPetOpenDig(self._petInfo)
    else
        -- 遗忘挖头 TODO
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS86})
        yflog:Info("close dig")
    end
end

