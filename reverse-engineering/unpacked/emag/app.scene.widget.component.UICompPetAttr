    self._sourceBtn:addClickListener(handler(self, self.onSourceBtnClick))
    self._takebackBtn:addClickListener(handler(self, self.ontakebackBtnClick))
    self._summonBtn:addClickListener(handler(self, self.onSummonBtnClick))
    self._selectBtn:addClickListener(handler(self, self.onSelectBtnClick))
    self._digBtn:addClickListener(handler(self, self.onDigBtnClick))
    self._skinBtn:addClickListener(handler(self, self.onSkinBtnClick))
    self._btnFeed:addClickListener(handler(self, self.onBtnFeedClick))
    self._btnRevive:addClickListener(handler(self, self.onBtnReviveClick))
    self._btnAddExp:addClickListener(handler(self, self.onBtnAddExpClick))
end

function UICompPetAttr:onExit()
    UICompPetAttr.super.onExit(self)

    self._sourceBtn:removeClickListener()
    self._takebackBtn:removeClickListener()
    self._summonBtn:removeClickListener()
    self._selectBtn:removeClickListener()
    self._digBtn:removeClickListener()
    self._skinBtn:removeClickListener()
    self._btnFeed:removeClickListener()
    self._btnRevive:removeClickListener()
    self._btnAddExp:removeClickListener()
    

    self:stopTC()
end

function UICompPetAttr:onUpdate(dt)
    if self._petActor1 then
        self._petActor1:onUpdate(dt)
    end
    if self._petActor2 then
        self._petActor2:onUpdate(dt)
    end
end

