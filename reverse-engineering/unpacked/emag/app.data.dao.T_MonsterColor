local MonsterColor = {}

function MonsterColor:queryAll()
    local monsColor = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM MonsterColorList;") do
        local meta = lt.MonsterColorMeta.new(row)
        table.insert(monsColor, meta)
    end
    return monsColor
end

return MonsterColor
