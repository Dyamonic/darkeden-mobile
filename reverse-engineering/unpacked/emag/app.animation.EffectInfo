-- effectBase + step + loop 
-- EffectManager:getEffectInfo
local EffectInfo = class("EffectInfo")
local EffectManager = lt.EffectManager

function EffectInfo:ctor(effectId, direction, bltType, step, loop)
    self._step = step
    self._loopCount = nil
    self._effectId = effectId

    self._effectInfo = EffectManager:getEffectBaseInfo(effectId, direction, bltType, step or 0.05, loop or 1)
    setmetatable(self, {__index = self._effectInfo})
end

function EffectInfo:getLoop()
    return self._loopCount
end
function EffectInfo:setLoop(loopCount)
    self._loopCount = loopCount
end

function EffectInfo:getStep()
    return self._step
end
function EffectInfo:setStep(step)
    self._step = step
end

function EffectInfo:getEffectId()
    return self._effectId
end

function EffectInfo:getBaseEffectInfo()
    return self._effectInfo
end

return EffectInfo