local MonsterInfoDao = {}

function MonsterInfoDao:query(id)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM MonsterInfo WHERE ID=%d;", id)) do
    	local meta = lt.MonsterInfoMeta.new(row)
        return meta
    end
end

function MonsterInfoDao:queryAll()
    local monsTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM MonsterInfo;") do
        local meta = lt.MonsterInfoMeta.new(row)
        table.insert(monsTable, meta)
    end
    return monsTable
end

return MonsterInfoDao
