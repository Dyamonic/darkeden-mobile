---@装备附魔结果弹窗
---@class UICompStEnchantResult
local UICompStEnchantResult = class("UICompStEnchantResult", lt.UIGButtonBase, lt.UICompChangeSkin)

UICompStEnchantResult.ChangeSkinConf = {
    ["Strengthen"] = {
        ["img_di2"] = "bg_zhuangbei_di1",
    },
    ["MessageBox"] = {
        ["img_di"] = "bg_tytanchuang_03",
    },
    ["CommonTL"] = {
        ["btn_confirm"] = {bg = "sort"},
    }
}

local NtfManager = lt.NtfManager
local StrengthenModule = lt.StrengthenModule

function UICompStEnchantResult:ctor()
    self:registerComponent("UICompItem", "UICompEnchantItem")
    UICompStEnchantResult.super.ctor(self)
    --UI
    self._equipIcon = nil
    self._attrlist = nil
    self._btnConfirm = nil
    self._icon = nil
    --数据
    self._attr = nil
end

function UICompStEnchantResult:onClear()
    --UI
    self._equipIcon = nil
    self._btnConfirm = nil
    self._icon = nil
    --数据
    self._attr = nil

    if self._attrlist then
        self._attrlist:removeChildrenToPool()
        self._attrlist:removeItemRenderer()
        self._attrlist = nil
    end
    self:unregisterAllComponent()
    UICompStEnchantResult.super.onClear(self)
end

function UICompStEnchantResult:onConstruct()
    self:startSkin()
    self:initUI()
end

function UICompStEnchantResult:onEnter()
    self._btnConfirm:addClickListener(handler(self, self.onConfirmBtnClick))
end

function UICompStEnchantResult:onExit()
    self._btnConfirm:removeClickListener()
end

function UICompStEnchantResult:initUI()
    self._equipIcon = self:getChild("panel_icon")
    self._attrlist = self:getChild("list_attr")
    self._attrlist:setItemRenderer(handler(self, self.renderListItem))
    self._btnConfirm = self:getChild("btn_confirm")
end

function UICompStEnchantResult:refreshView(itemInfo)
    if self._icon == nil then
        self._icon = fgui.UIPackage:createObject("Item", "Item")
        self._icon:insertObjectToFactory(self)
        self._icon:setPivot(0.5,0.5, true)
        self._equipIcon:addChild(self._icon)
    end
    self._icon:setItemInfo(itemInfo)

    self._attr = StrengthenModule:transformAffix(itemInfo)
    self._attrlist:setNumItems(#self._attr)
end

function UICompStEnchantResult:closeView()
    self:setVisible(false)
end

function UICompStEnchantResult:onConfirmBtnClick()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CONFIRM_BLESSING)
    self:closeView()
end

function UICompStEnchantResult:renderListItem(index, obj)
    local equipProp = self._attr[index + 1]
    obj:setAttr(equipProp)
    obj:insertObjectToFactory(self)
end

return UICompStEnchantResult