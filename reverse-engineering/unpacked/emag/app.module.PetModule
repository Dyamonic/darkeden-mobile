--宠物胶囊TODO
function PetModule:sendPetCapsule(petUid, itemId)
    local msg = netcmd_pb.CS_Pet_CapsuleReq()
    msg.petUid = petUid
    msg.itemId = itemId
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_PET_CAPSULE_REQ), msg)
    self._learnSkillState = Constant.PETLEARNSKILL.START
    self._learnSkillItem  = itemId
end

--宠物胶囊回调TODO
function PetModule:onPetCapsule(event)
    yflog:Info("PetModule:onPetCapsule")
    local proto = event.param or {}
    if proto.ret == 0 then
        yflog:Info("onPetCapsule----->>>> success")
        -- 技能学习成功
        self._learnSkillState = Constant.PETLEARNSKILL.SUCCESS
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_PET_CAPSULE_REFRESH)
    else
        self._learnSkillState = nil
    end
end

function PetModule:getLearnSkillState()
    return self._learnSkillState
end

function PetModule:clearLearnSkillState()
    self._learnSkillState = nil
end

function PetModule:getLearnSkillItem()
    return self._learnSkillItem
end

function PetModule:clearLearnSkillItem()
    self._learnSkillItem = nil
end

--宠物合成TODO
function PetModule:sendPetCompose(petUid, petUid2)
    local msg = netcmd_pb.CS_Pet_ComposeReq()
    msg.petUid  = petUid
    msg.petUid2 = petUid2
    if petUid2 > 0 then
        self._petComposeUid2 = petUid2
    else
        self._petComposeUid2 = nil
    end
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_PET_COMPOSE_REQ), msg)
end

--宠物合成回调TODO
function PetModule:onPetCompose(event)
    lt.LogUtil:debugInfo("PetModule:onPetCompose")
    local proto = event.param or {}
    if proto.ret == 0 then
        if self._petComposeUid2 then
            self._petComposeState = Constant.PETCOMPOSE.SUCCESS
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS61})
        else
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS60})
        end
    end
    local toppingId = self:getToppingId()
    for i = 1, #self._petList do
        if self._petComposeUid2 == self._petList[i]:getUid() then
            table.remove(self._petList, i)
            break
        end
    end
    if tostring(self._petComposeUid2) == toppingId then
        --宠物置顶取消
        self:setToppingId(0)
    end
    self._petComposeUid2 = nil
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_PET_COMPOSE_REFRESH) -- 合成刷新并且记录uid
    -- NtfManager:dispatchNtf(NtfManager.NTF.NTF_RESET_PET_INDEX)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_PET_LIST)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_PET_MY)
end

function PetModule:getPetComposeState()
    return self._petComposeState
end

function PetModule:clearPetComposeState()
    self._petComposeState = nil
end

--宠物数据更新NTF
function PetModule:onPetUpdate(event)
    lt.LogUtil:debugInfo("PetModule:onPetUpdate")
    local proto = event.param
    local petData = proto.pet
    local petlist = self._petList or {}
    local isNew = true
    for i = 1, #petlist do
        if petlist[i]:getUid() == petData.uid then
            petlist[i]:setPetInfo(petData)
            isNew = false
            break
        end
    end
    --新增
    if isNew then
        table.insert(self._petList, lt.PetUIData.new(petData))
        local petMeta = CacheManager:getPetMeta(petData.id)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = petMeta:getPetName()..GReadText.KEY_PET_TIPS34})
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_PET_MY)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_PET_LIST)
    lt.RedDotModule:onRedDotNotice(Constant.SYSTEM_TYPES.PET)
end

--宠物捕获结果NTF
function PetModule:onPetCaptureNtf(event)
    lt.LogUtil:debugInfo("PetModule:onPetCaptureNtf")
    local proto = event.param
    local success = proto.success
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_PET_CAPTURE_END, {success = success})
end

-------------------------------------------------------------------------------------------------------
-- 宠物皮肤相关
function PetModule:getSkinDataById(id)
    return self._petSkinList[id]
end

--宠物皮肤升级
function PetModule:sendPetSkinLvUp(skinId)
    local msg = netcmd_pb.CS_Pet_Skin_LvUpReq()
    msg.skinId  = skinId
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_PET_SKIN_LVUPREQ), msg)
    self._petSkinUpId = skinId
end

--宠物皮肤升级回调
function PetModule:onPetSkinLvUp(event)
    local proto = event.param or {}
    if proto.ret == 0 then
        -- 宠物皮肤升级成功
        if self._petSkinUpId then
            local petData = self._petSkinList[self._petSkinUpId] 
            if petData and petData:getLevel() == 1 then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS91})
            end
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_PET_SKIN_UP)
        lt.RedDotModule:onRedDotNotice(Constant.SYSTEM_TYPES.PET)
    end
    self._petSkinUpId = nil
end

function PetModule:onPetSkinNtf(event)
    local proto = event.param
    local skin = proto.skin
    if skin then
        if self._petSkinList[skin.skinId] then
            self._petSkinList[skin.skinId]:setPetSkinInfo(skin)
        else
            local petSkinData = lt.PetSkinData.new(skin)
            self._petSkinList[petSkinData:getSkinId()] = petSkinData
        end
    end

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_PET_SKIN)
end

-- 使用皮肤
function PetModule:sendPetUseSkin(skinId, petUid)
    local msg = netcmd_pb.CS_Pet_Skin_WearReq()
    msg.skinId = skinId
    msg.petUid = petUid
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_PET_SKIN_WEAR_REQ), msg)
end

function PetModule:onPetUseSkin(event)
    local proto = event.param
    if proto.ret == 0 then
        -- 使用成功
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS64})
    end
end

-- 取消皮肤
function PetModule:sendPetCancelSkin(petUid)
    local msg = netcmd_pb.CS_Pet_Skin_UnWearReq()
    msg.petUid = petUid
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_PET_SKIN_UNWEAR_REQ), msg)
end

function PetModule:onPetCancelSkin(event)
    local proto = event.param
    if proto.ret == 0 then
        -- 取消成功
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_PET_TIPS65})
    end
end

function PetModule:getPetSkinAttrById(skinId)
    local skinData = PetModule:getSkinDataById(skinId)
    if skinData then
        local curLevel = skinData:getLevel()
        local levelUpCfg = CacheManager:getPetSkinById(skinId)
        local race = lt.GameModule:getHeroRace()
        local accumAttr = levelUpCfg[curLevel]:getAccumAttrByRace(race)
        return accumAttr
    end
end

function PetModule:getPetSkinAttrList()
    local skinAttrTable = {}
    local race = lt.GameModule:getHeroRace()
    local petSkinData = CacheManager:getPetSkinTypeMap() or {}
    for _,skinCfg in pairs(petSkinData) do
        local skinId = skinCfg:getId()
        local skinData = PetModule:getSkinDataById(skinId)
        if skinData then
            local curLevel = skinData:getLevel()
            local levelUpCfg = CacheManager:getPetSkinById(skinId)
            local accumAttr = levelUpCfg[curLevel]:getAccumAttrByRace(race)
            for k,v in ipairs(accumAttr) do
                local key = v[1]
                local value = v[2] or 0
                if key then
                    if skinAttrTable[key] then
                        skinAttrTable[key] = skinAttrTable[key] + value
                    else
                        skinAttrTable[key] = value
                    end
                end
            end
        end
    end

    local skinAttrList = {}
    for k,v in pairs(skinAttrTable) do
        table.insert(skinAttrList, {k, v})
    end

    return skinAttrList
end

-- 小红点，1. 宠物皮肤 2.宠物开启二次能力
function PetModule:initRedTips()
    ---------------------------------------------------------------------
    -- 1. 宠物皮肤
    local isRed = self:checkPetSkinRed()
    lt.RedDotModule:setTipsStateByName("PetModule_checkPetUp", isRed)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_RED_DOT_EVENT,{name = "PetModule_checkPetUp"})
    ---------------------------------------------------------------------
    -- 2.宠物开启二次能力
    local isRed2 = self:checkPetFunctionRed()
    lt.RedDotModule:setTipsStateByName("PetModule_checkPetFunction", isRed2)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_RED_DOT_EVENT,{name = "PetModule_checkPetFunction"})
end

function PetModule:checkPetSkinRed()
    local skinTypeMap = CacheManager:getPetSkinTypeMap()
    for _,v in pairs(skinTypeMap) do
        local petSkinId = v:getId()
        if PetModule:checkPetUp(petSkinId) then
            return true
        end
    end

    return false
end

function PetModule:checkPetFunctionRed()
    for _,v in ipairs(self._petList or {}) do
        local isDig            = v:getDig()
        local openDigLeftTimes = v:getOpenDigLeftTimes()
        local isRed = not isDig and openDigLeftTimes ~= 0
        if isRed then
            return true
        end
    end
    return false
end

function PetModule:checkPetUp(petSkinId)
    local skinData = PetModule:getSkinDataById(petSkinId)
    local levelUpCfg = CacheManager:getPetSkinById(petSkinId)
    local nextCfg = nil
    if not skinData then -- 未激活
        nextCfg = levelUpCfg[1]
    else
        local curLevel = skinData:getLevel()
        if curLevel < #levelUpCfg then
            nextCfg = levelUpCfg[curLevel+1]
        end
    end

    if not nextCfg then
        return false
    end

    -- 第一个消耗(金币)
    local consumeItem = nextCfg:getConsumeItem()
    if consumeItem and consumeItem[1] and #consumeItem > 1 then
        local needItem = consumeItem[1][3] or 0
        local itemId = consumeItem[1][2]
        local curItemNum = ItemModule:getValueItem(consumeItem[1][1], itemId)
        if curItemNum < needItem then
            return false
        end
    end

    -- 资源消耗显示
    if consumeItem and consumeItem[#consumeItem] then
        local itemId = consumeItem[#consumeItem][2]
        local curItemNum = ItemModule:getItemNum(itemId)
        local needItem = consumeItem[#consumeItem][3] or 0
        if curItemNum < needItem then
            return false
        end
    end

    return true
end

return PetModule