---@class CompHP 主界面-血条
local CompHP = class("CompHP", lt.UICompBase)
local RaceType = lt.Constant.RaceType
local GameModule = lt.GameModule
local CacheManager = lt.CacheManager
local Constant = lt.Constant
local NtfManager = lt.NtfManager

function CompHP:ctor(view)
    CompHP.super.ctor(self)
    self._view = view
    self._hpBar = nil
    self._mpBar = nil
    self._mpBar1 = nil
    self._mpBar2 = nil
    self._mpBar3 = nil
    self._expBar = nil
    self._perPos = nil
    self._expBar1 = nil
    self._expBar2 = nil
    self._lvImg = nil
    self._avImg = nil
    self._titleLb = nil
    self._levelLb = nil
    self._line1 = nil
    self._line2 = nil

    self:initUI()
end

function CompHP:onClear()
    --可能onExit没清理事件，放到clear里再清一次
    self:removeAllListener()
    self._view = nil
    self._hpBar = nil
    self._mpBar = nil
    self._mpBar1 = nil
    self._mpBar2 = nil
    self._mpBar3 = nil
    self._expBar = nil
    self._perPos = nil
    self._expBar1 = nil
    self._expBar2 = nil
    self._lvImg = nil
    self._avImg = nil
    self._titleLb = nil
    self._levelLb = nil
    self._line1 = nil
    self._line2 = nil
    CompHP.super.onClear(self)
end

function CompHP:initUI()
    local race = GameModule:getHeroRace()
    self._hpBar = self._view:getChild("hpBar")
    if race ==  RaceType.Slayer then
        self._mpBar = self._view:getChild("mpBar")
        self._expBar1 = self._view:getChild("lvBar")
        self._expBar2 = self._view:getChild("avBar")
        self._lvImg = self._view:getChild("img_lv")
        self._avImg = self._view:getChild("img_av")
        self._titleLb = self._view:getChild("label_title")
        self._levelLb = self._view:getChild("label_lv")
        self._line1 = self._expBar1:getChild("line")
        self._line2 = self._expBar2:getChild("line")
    elseif race == RaceType.Vampire then
        self._expBar = self._view:getChild("expBar")
        self._silver = self._hpBar:getChild("silver")
        self._lvImg = self._view:getChild("img_lv")
        self._avImg = self._view:getChild("img_av")
        self._titleLb = self._view:getChild("label_title")
        self._levelLb = self._view:getChild("label_lv")
    elseif race == RaceType.Ousters then
        self._mpBar1 = self._view:getChild("mpBar1")
        self._mpBar2 = self._view:getChild("mpBar2")
        self._mpBar3 = self._view:getChild("mpBar3")
        self._expBar = self._view:getChild("expBar")
        self._silver = self._hpBar:getChild("silver")
        self._lvImg = self._view:getChild("img_lv")
        self._avImg = self._view:getChild("img_av")
        self._titleLb = self._view:getChild("label_title")
        self._levelLb = self._view:getChild("label_lv")
    end
end

function CompHP:onEnter()
    self:refreshBarInfo()
    self:addAllListener()
end

function CompHP:onExit()
    self:removeAllListener()
end

function CompHP:addAllListener()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_LEVEL_EXP_CHANGE, handler(self, self.refreshBarInfoExp), "CompHP:refreshBarInfoExp")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_HPMP_EVENT, handler(self, self.refreshBarInfoHPMP), "CompHP:refreshBarInfoHPMP")
end

function CompHP:removeAllListener()
    NtfManager:removeNtfListenerByTag("CompHP:refreshBarInfoExp")
    NtfManager:removeNtfListenerByTag("CompHP:refreshBarInfoHPMP")
end

function CompHP:refreshBarInfo()
    self:refreshBarInfoExp()
    self:refreshBarInfoHPMP()
end

function CompHP:refreshBarInfoExp()
    local heroData = GameModule:getHeroData()
    if not heroData then
        return
    end
    local race = GameModule:getHeroRace()
    -- 经验相关
    local level = heroData:getLevel()
    local curExp = heroData:getExp()
    local advState = heroData:getAdvanceState()
    local curAdvLvl = heroData:getAdvanceLevel()
    local advanceExp = heroData:getAdvanceExp()

    if race ==  RaceType.Slayer then
        -- 人族经验显示
        -- advState == Constant.AdvState.Adv 转职后显示
        if advState == Constant.AdvState.Adv and curAdvLvl > 0 then
            local advLevelInfo = CacheManager:getAdvLevelExpInfoMeta(curAdvLvl)
            local maxExp = advLevelInfo:getExp()
            self:setSlayerExpValue(advanceExp, maxExp)
            self._titleLb:setText("AV")
            self._levelLb:setText(curAdvLvl)
        else
            local area = heroData:getMaxLevel()
            local expMeta = CacheManager:getSLevelExpInfoMeta(area, level)
            local maxExp = expMeta:getExp() or 1
            local slayerExp = heroData:getSlayerExpTable()
            curExp = slayerExp[area]
            self:setSlayerExpValue(curExp, maxExp)
            self._titleLb:setText(GReadText["KEY_DOMAIN_NAME_"..area])
            self._levelLb:setText(level)
        end
        self._expBar1:setVisible(advState ~= Constant.AdvState.Adv or curAdvLvl == 0)
        self._expBar2:setVisible(advState == Constant.AdvState.Adv and curAdvLvl > 0)
    elseif race == RaceType.Vampire then
        -- 鬼族经验显示
        -- advState == Constant.AdvState.Adv 转职后显示
        if advState == Constant.AdvState.Adv and curAdvLvl > 0 then
            local advLevelInfo = CacheManager:getAdvLevelExpInfoMeta(curAdvLvl)
            local maxExp = advLevelInfo:getExp()
            self:setExpValue(advanceExp,maxExp)
            self._titleLb:setText("AV")
            self._levelLb:setText(curAdvLvl)
        else
            local expMeta = CacheManager:getLevelExpInfoMeta(level) or {}
            local maxExp = expMeta:getExp()
            self:setExpValue(curExp,maxExp)
            self._titleLb:setText("LV")
            self._levelLb:setText(level)
        end
    elseif race == RaceType.Ousters then
        -- 魔族经验显示
        -- advState == Constant.AdvState.Adv 转职后显示
        if advState == Constant.AdvState.Adv and curAdvLvl > 0 then
            local advLevelInfo = CacheManager:getAdvLevelExpInfoMeta(curAdvLvl)
            local maxExp = advLevelInfo:getExp()
            self:setExpValue(advanceExp,maxExp)
            self._titleLb:setText("AV")
            self._levelLb:setText(curAdvLvl)
        else
            local expMeta = CacheManager:getLevelExpInfoMeta(level) or {}
            local maxExp = expMeta:getExp()
            self:setExpValue(curExp,maxExp)
            self._titleLb:setText("LV")
            self._levelLb:setText(level)
        end
    end
    self._lvImg:setVisible(advState ~= Constant.AdvState.Adv or curAdvLvl == 0)
    self._avImg:setVisible(advState == Constant.AdvState.Adv and curAdvLvl > 0)
end

function CompHP:refreshBarInfoHPMP()
    local heroData = GameModule:getHeroData()
    local race = GameModule:getHeroRace()
    -- 血量相关
    local curHp = heroData:getCurHp()
    local maxHp = heroData:getMaxHp()

    -- 蓝相关
    local curMp = heroData:getCurMp()
    local maxMp = heroData:getMpMax()

    -- 镀银
    local silver = heroData:getSilver()
    -- yflog:Info("------------>>>>>>>Silver:%s",silver)

    if race ==  RaceType.Slayer then
        self:setHPValue(curHp,maxHp) -- 人族血条
        self:setMpValue(self._mpBar,curMp,maxMp) -- 人族蓝显示
    elseif race == RaceType.Vampire then
        self:setHPValue(curHp,maxHp,silver) -- 鬼族血条
        self:setSilver(silver,maxHp) -- 镀银
    elseif race == RaceType.Ousters then
        self:setHPValue(curHp,maxHp,silver) -- 魔族血条
        self:setSilver(silver,maxHp) -- 镀银

        -- 魔族蓝显示
        if curMp > 2*maxMp then
            self:setMpValue(self._mpBar1, maxMp, maxMp)
            self:setMpValue(self._mpBar2, maxMp, maxMp)
            self._mpBar2:setVisible(true)
            self:setMpValue(self._mpBar3, curMp-2*maxMp, maxMp)
            self._mpBar3:setVisible(true)
        elseif curMp > maxMp then
            self:setMpValue(self._mpBar1, maxMp, maxMp)
            self:setMpValue(self._mpBar2, curMp-maxMp, maxMp)
            self._mpBar2:setVisible(true)
            self._mpBar3:setVisible(false)
        else
            self:setMpValue(self._mpBar1, curMp, maxMp)
            self._mpBar2:setVisible(false)
            self._mpBar3:setVisible(false)
        end
    end
end

function CompHP:setHPValue(curHp,maxHp,silver)
    self._hpBar:setValue(curHp)
    self._hpBar:setMax(maxHp)
    -- 镀银值大于0显示
    if silver and (silver > 0) then
        self._hpBar:getChild("title"):setText(string.format("%s/%s(S:%s)",curHp,maxHp,silver))
    end
end

function CompHP:setMpValue(target,curMp,maxMp)
    if not target then
        return
    end
    target:setValue(curMp)
    target:setMax(maxMp)
end

function CompHP:setSilver(silver,maxHp)
    local percent = silver/maxHp
    if percent > 1 then
       percent = 1 
    end
    -- yflog:Info("Silver------>percent:%s",percent)
    self._silver:setFillAmount(percent)
end

function CompHP:setExpValue(curExp,maxExp)
    self._expBar:setValue(curExp)
    self._expBar:setMax(maxExp)
end

function CompHP:setSlayerExpValue(curExp,maxExp)
    self._expBar1:setValue(curExp)
    self._expBar1:setMax(maxExp)
    self._line1:setY(30 - 30*curExp/maxExp)
    self._expBar2:setValue(curExp)
    self._expBar2:setMax(maxExp)
    self._line2:setY(30 - 30*curExp/maxExp)
end

return CompHP