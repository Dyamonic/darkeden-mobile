
-- 管理UI
local UIManager = {}

local ccui = ccui
local Constant = lt.Constant
local ResManager = lt.ResManager
local StringManager = lt.StringManager

UIManager.UICONFIG_KEY = "__UICONFIG__"

UIManager._uiConfigJson  = nil
UIManager._uiConfigTable = nil


function UIManager:init()
end

function UIManager:clear()
    self._uiConfigJson  = nil
    self._uiConfigTable = nil
end

function UIManager:createTextNormal(str, fontSize, outlineSize)
    local text = ccui.Text:create()
    text:setString(str)
    text:setFontName(Constant.FONT_2)
    text:setFontSize(fontSize or 14)
    text:setColor(Constant.COLOR_TEXT_WHITE)
    text:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
    text:enableOutline(Constant.COLOR_OUTLINE, outlineSize or 2)
    return text
end

function UIManager:createTextNameNode(str, fontSize)
    local text = ccui.Text:create()
    text:setString(str)
    text:setFontName(Constant.FONT_4)
    text:setFontSize(fontSize)
    text:setColor(Constant.COLOR_TEXT_WHITE_PURE)
    text:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
    text:enableOutline(Constant.COLOR_OUTLINE, 1)
    return text
end

function UIManager:createTextNameNodeNpc(str)
    local text = ccui.Text:create()
    text:setString(str)
    text:setFontName(Constant.FONT_4)
    text:setFontSize(16)
    text:setColor(Constant.COLOR_NPC_NAME)
    text:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
    text:enableShadow(cc.c4b(0, 0, 0, 255), cc.size(1,-1), 2)
    return text
end

function UIManager:createLabel(content, cfg)

    local label = cc.Label:createWithTTF(content, Constant.FONT_2, cfg.fontSize or 15, cc.size(0, 0), cc.TEXT_ALIGNMENT_LEFT, cc.VERTICAL_TEXT_ALIGNMENT_TOP)

    if cfg.color then
        if Constant.COLORS[cfg.color] then
            label:setColor(Constant.COLORS[cfg.color])
        else
            label:setColor(cfg.color)
        end
    else
        label:setColor(Constant.COLOR_TEXT_WHITE_PURE)
    end

    if cfg.outline then
        local color4b = cfg.outlineColor
        local outlineSize = cfg.outlineSize

        if not color4b then color4b = lt.Constant.COLOR_OUTLINE end
        if not outlineSize then outlineSize = 2 end
        label:enableOutline(color4b, outlineSize)
    end


    return label
end

function UIManager:addNormalLab(str, size, color, outline)
    local lab = lt.LabelEx.new(str, {font=Constant.FONT_2,
                                            size=size,
                                            color=color,
                                            outline=outline,
                                            outlineColor=Constant.COLOR_OUTLINE,
                                            outlineSize=2})
    return lab
end

function UIManager:addNewPlayTips(key, widget, x, y, w, h, hide)
    local isClose = lt.PrefManager:getUserValueByKey(key)
    local meta = lt.CacheManager:queryAdditionTipsMetaByKey(key)
    
    if not isClose then
        local tips = lt.UIWgtPlayTips.new({width = w, posH = h, hide = hide})
        tips:setPosition(x, y)
        widget:addChild(tips, 999)

        tips:setCallBack(function ()
            if tips then
                tips:removeSelf()
                tips = nil
            end
        end)

        tips:setTipsInfo(meta:getTips())
        lt.PrefManager:setUserValueByKey(key, "1")
    end
end

function UIManager:createButtonNormal(str)
    local param = {
        font=Constant.FONT_2,
        size=18,
        color=Constant.COLOR_BTN_0,
        outline=true,
        outlineColor=Constant.COLOR_OUTLINE,
        outlineSize=2
    }
    return lt.LabelButton.new(lt.ResManager:resPath("_btnNormal"), str, param)
end

function UIManager:createTabButtonShort(x, y, word, callback, widget)
    return self:createNormalTabButton(widget, ResManager:resPath("_btnvertical"), x, y, word, callback, true)
end

function UIManager:createTabButtonLong(x, y, word, callback, widget)
    return self:createNormalTabButton(widget, ResManager:resPath("_btnvertical2"), x, y, word, callback)
end

function UIManager:createNormalTabButton(widget, path, x, y, word, callback, isShort)
    local btn = ccui.Button:create(path)
    btn:setAnchorPoint(1, 0.5)
    btn:setPosition(x, y)
    btn:addClickEventListener(function()
        if callback then
            callback()
        end
    end)
    widget:addChild(btn)

    local w = btn:getContentSize().width
    local h = btn:getContentSize().height

    local selectSp = ccui.Scale9Sprite:create(ResManager:resPath("_bgleftselect"), cc.rect(0, 0, 38, 64), cc.rect(18, 31, 2, 2))
    selectSp:setPosition(w/2, h/2)
    selectSp:setContentSize(w, h)
    selectSp:setTag(5)
    btn:addChild(selectSp)

    local lab = lt.LabelEx.new(word, {font=Constant.FONT_2,
                                            size=18,
                                            color=Constant.COLOR_BTN_0,
                                            outline=true,
                                            outlineColor=Constant.COLOR_OUTLINE,
                                            outlineSize=2})
    
    lab:setPosition(w/2, h/2 + 1)
    if not isShort then
        lab:setLineHeight(18)
    end
    btn:addChild(lab)

    local redDot = display.newSprite(ResManager:resPath("_redDot"))
    redDot:setPosition(w - 6, h - 6)
    redDot:setTag(6)
    btn:addChild(redDot)
    redDot:setVisible(false)
    
    return btn
end

--[[
暂时只支持简单由左往右的进度显示
@param image        图片资源路径
@param size         进度条最大显示区域
@param capInsets    九宫格拉伸区域大小
@param params       params用于显示进度条,自动创建label, 可配置参数
                    szText
                    fontSize
                    outlineSize
返回ClippingNode节点
@function setPercentage 设置进度 range[0-1]
@function setTextString 设置label文本
@function getLabel      获得label节点
]]
function UIManager:createProgressTimer(image, size, capInsets, params)
    local progressImg = ccui.Scale9Sprite:create(capInsets, image)
    progressImg:setContentSize(size)

    local mask = display.newLayer(cc.c4b(0, 0, 0, 255), size)
    mask:setAnchorPoint(cc.p(0, .5))
    mask:setPosition(cc.p(-size.width/2, -size.height/2))
    local clippingNode = cc.ClippingNode:create(mask)
    clippingNode:setStencil(mask)
    clippingNode:addChild(progressImg)

    local curPer = nil
    clippingNode.setPercent = function (_, p)
        p = p > 1 and 1 or p
        p = p < 0 and 0 or p
        curPer = p
        mask:setContentSize(size.width*p, size.height)
    end
    clippingNode.getPercent = function (_, p)
        return curPer and curPer or 0

    end

    local retNode = clippingNode

    if params and type(params) == "table" then
        retNode = display.newNode()
        retNode:addChild(clippingNode)

        local szText = params.szText or ""
        local label = self:createTextNormal(params.szText, params.fontSize, params.outlineSize)
        retNode:addChild(label)

        retNode.setPercent = clippingNode.setPercent
        retNode.getPercent = clippingNode.getPercent
        
        retNode.setTextString = function (_, str)
            label:setString(str)
        end
        retNode.getLabel = function (_)
            return label
        end

        retNode.getClippingNode = function (_)
            return clippingNode
        end
    end

    return retNode
end

function UIManager:supportUnderLine(node, color)
    color = color or Constant.COLOR_BROWN_TIP

    local function _supportUnderLine(n)
        if not iskindof(n, "cc.Node") then
            return
        end

        local color = cc.convertColor(color, "4f")
        color.a = 1

        local underLine = cc.DrawNode:create(1)
        underLine:clear()
        underLine:drawLine(cc.p(0, 2), cc.p(n:getContentSize().width, 2), color)
        underLine:setTag(1)
        n:addChild(underLine)
    end

    if type(node) == "table" then
        for i,v in ipairs(node) do
            _supportUnderLine(v)
        end
    else
        _supportUnderLine(node)
    end
end

-- -------------------EditDlg Storage-------------------------------
function UIManager:insertUIEditStroageTableDb(configArray)
    local tableName = self:getUIEditStroageDefautName()
    local keyArray = self:getUIEditStroageDefautKey()

    lt.PrefManager:insertTableDb(keyArray, configArray, tableName)
end

function UIManager:deleteUIEditStorageTableDbByName(name)
    local tableName = self:getUIEditStroageDefautName()
    local key = "Name"

    lt.PrefManager:deleteTableDb(key, name, tableName)
end

function UIManager:deleteUIEditStorageTableByName(name)
    local tableName = self:getUIEditStroageTableName(name)
    
    lt.PrefManager:deleteTable(tableName)
end

function UIManager:saveUIEditStroageUIConfigDb(name)
    local tableName = self:getUIEditStroageTableName(name)
    self:saveUIConfigByDefautDb(nil, tableName)
end

--  获得存储的项目列表 name  data  time
function UIManager:getUIEditStorageDefautArray()
    local tableName = self:getUIEditStroageDefautName()
    local storageArray = {}
    if lt.PrefManager:getDbTableIsExist(tableName) then
        storageArray = lt.UIConfigDao:queryStorageDefautArray(tableName)
    end
    return storageArray
end

function UIManager:getUIEditStroageDefautName()
    local playerId = lt.GameModule:getHeroData():getPlayerId()
    return string.format("uiconfigStorage_%s", playerId)
end

function UIManager:getUIEditStroageDefautKey()
    return {"Name", "Data", "Time"}
end

function UIManager:getUIEditStroageTableName(name)
     local playerId = lt.GameModule:getHeroData():getPlayerId()
    return string.format("storage_%s_%s",name, playerId)
end

-- -------------------uiconfig--------------------------------------
function UIManager:loadUIConfigByDefautDb(tableName)
    if lt.PrefManager:getDbTableIsExist(tableName) then
        self._uiConfigTable = lt.UIConfigDao:queryDefaultUIConfigByTableName(tableName)
        if table.nums(self._uiConfigTable) == 0 then
            self._uiConfigTable = nil
        end
    else
        self._uiConfigTable = nil
    end
    return self._uiConfigTable
end

function UIManager:saveUIConfigByDefautDb(configTable, storageName)
    local tableName = self:getUIConfigDefautName()
    local keyArray = self:getUIConfigDefautKey()

    if configTable then
       lt.PrefManager:createTableDb(keyArray, configTable, tableName)
    else
        configTable = lt.UIConfigDao:queryStorageUIConfigByTableName(tableName)
        lt.PrefManager:createTableDb(keyArray, configTable, storageName)
    end
end
function UIManager:saveUIBtnByDefautDb(btnArray)
    self:getUIConfigTable()
    self._uiConfigTable[btnArray[1]] = btnArray

    local tableName = self:getUIConfigDefautName()
    local keyArray = self:getUIConfigDefautKey()
    if btnArray then
        lt.PrefManager:insertTableDb(keyArray, btnArray, tableName)
    end
end

function UIManager:getUIConfigTable()
    if not self._uiConfigTable then
        local tableName = self:getUIConfigDefautName()
        self._uiConfigTable = self:loadUIConfigByDefautDb(tableName)
    end
    return self._uiConfigTable
end

function UIManager:getUIConfigTableByName(name)
    local tableName = self:getUIConfigDefautName()
    if name then
        tableName = self:getUIEditStroageTableName(name)
    end
    local storageArray = {}
    if lt.PrefManager:getDbTableIsExist(tableName) then
        storageArray = lt.UIConfigDao:queryStorageUIConfigByTableName(tableName)
    end
    return storageArray
end

function UIManager:getUIConfigDefautName()
    local playerId = lt.GameModule:getHeroData():getPlayerId()
    return string.format("uiconfig_%s", playerId)
end

function UIManager:getUIConfigDefautKey()
    return {"Id","PosType", "PosX", "PosY"}
end

-- ---------------------------uiconfig userid---------------------

function UIManager:setUserValueByUIConfigKey(value)
    lt.PrefManager:setUserValueByKey(UIManager.UICONFIG_KEY, value)
end

function UIManager:getUserValueByUIConfigKey()
    return lt.PrefManager:getUserValueByKey(UIManager.UICONFIG_KEY)
end

-- ---------------------uiconfig json-----------------------------

-- 自定义UI相关
function UIManager:loadUIConfigJson()
    local uiConfigString = lt.ResUtil:loadUIConfigString()
    if uiConfigString and #uiConfigString > 0 then
        self._uiConfigJson = json.decode(uiConfigString)
        return self._uiConfigJson
    end
end

function UIManager:saveUIConfigJson(jsonTable)
    if jsonTable then
        local jsonString = json.encode(jsonTable)
        lt.ResUtil:saveUIConfigString(jsonString)
    elseif self._uiConfigJson then
        local jsonString = json.encode(self._uiConfigJson)
        lt.ResUtil:saveUIConfigString(jsonString)
    end
end

-- Setter && Getter
function UIManager:getUIConfigJson()
    if not self._uiConfigJson then
        self._uiConfigJson = self:loadUIConfigJson()
    end

    return self._uiConfigJson
end



return UIManager
