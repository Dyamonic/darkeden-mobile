function MonsterAgent:queryMasterAgent()
    local masterObjId = self:getMasterObjId()
    if not masterObjId or masterObjId <= 0 then
        return nil
    end

    local worldAgent = lt.AgentManager:getWorldAgent()
    if not worldAgent then
        return nil
    end

    local masterAgent = worldAgent:getAgent(masterObjId)
    if not masterAgent or masterAgent:getAgentType() ~= Constant.AGENT_TYPE_HERO then
        return nil
    end
    
    return masterAgent
end

function MonsterAgent:isPet()
    local masterObjId = self:getMasterObjId()
    if masterObjId and masterObjId > 0 and self._monsterData:isPet() then
        return true
    end
    return false
end

