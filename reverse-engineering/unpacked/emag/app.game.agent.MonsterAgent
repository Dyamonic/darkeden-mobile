-- 命令
function MonsterAgent:hasDieCmd()
    return self._cmdSystem:hasDieCmd()
end

function MonsterAgent:getDieCmd()
    return self._cmdSystem:getDieCmd()
end

function MonsterAgent:handleCmd(cmd)
    if cmd:getCmdId() == Constant.CmdId.CMD_MOVE then
        --print("怪物移动cmd:", cmd:getMoveType(), cmd:getDirection(), cmd:getMNext(), cmd:getNNext())
        self:move(cmd:getMoveType(), cmd:getDirection(), cmd:getMNext(), cmd:getNNext())
    elseif cmd:getCmdId() == Constant.CmdId.CMD_ATTACK then
        -- print("怪物攻击cmd:", cmd:getSkillId(), cmd:getSkillLevel(), cmd:getDirection(), cmd:getTargetObjId(), cmd:getTargetM(), cmd:getTargetN())
        self:attack(cmd:getSkillId(), cmd:getSkillLevel(), cmd:getDirection(), cmd:getTargetObjId(), cmd:getTargetM(), cmd:getTargetN())
    elseif cmd:getCmdId() == Constant.CmdId.CMD_DIE then
        -- 执行怪物死亡命令
        self:die(cmd:getM(), cmd:getN(), cmd:getDirection())
    elseif cmd:getCmdId() == Constant.CmdId.CMD_JUMP then
        self:jump(cmd)
    elseif cmd:getCmdId() == Constant.CmdId.CMD_TRANSFORM then
        self:changeState(lt.HeroStateTransform.new(self, cmd:getBuffId(), cmd:getIsExist(), cmd:getState(), cmd:getSrcId()))
    elseif cmd:getCmdId() == Constant.CmdId.CMD_PROPERTY then
        self:propertyChange(cmd:getProperty(),cmd:getValue())
    end
end

function MonsterAgent:propertyChange(property,value)
    if property == lt.ServerClientEnum.CreatureValueDef.Attr_Hide then
        self:changeSkillHide(value)
    elseif property == lt.ServerClientEnum.CreatureValueDef.Attr_MoveSpeedRate then
        self:getRoleData():setValue(property, value)
    end
end

function MonsterAgent:move(moveType, direction, mNext, nNext)
    if self:getMonsterId() == lt.MonsterEnum.NORMAL_RANGE then
        --夜啸鬼移动加残影
        self:changeState(lt.MonsterStateFastMove.new(self, mNext, nNext))
        return
    end
    self:changeState(lt.MonsterStateMove.new(self, moveType, direction, mNext, nNext))
end

function MonsterAgent:attack(skillCode, skillLevel, direction, targetObjId, targetM, targetN)
    self:changeState(lt.MonsterStateSkill.new(self, skillCode, skillLevel, direction, targetObjId, targetM, targetN))
end

function MonsterAgent:jump(cmd)
    lt.GameModule:agentJump(cmd:getProto())
end

-- 执行怪物死亡 -> 躺尸
function MonsterAgent:die(m, n, direction)
    self:setPositionAndOffset(self._monsterData:getModelId(), m, n)
    self:setDirection(direction)

    -- 是否完成挖掘，用于判断播放死亡动作的最后一帧
    self._monsterActor:setDie()

    -- 怪物死亡特效
    -- EffectScreen 74 写死
    self._monsterActor:playDieEffect()

    self:changeState(lt.MonsterStateDie.new(self))
    -- lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MINIMAP_DEL_MN, {agentId=self._agentId})
    
    -- 小地图消失通知
    GameModule:addUpdateEventMiniMap(lt.NtfManager.NTF.NTF_MINIMAP_DEL_MN, {agentId=self._agentId})

    -- 添加怪物挖掘列表
    GameModule:addDropAndBodyGridMap(self)

    --击杀的判断是否需要吸蓝
    AutoFightManager:setAbsorbSoul(true)

    -- 测试模型框 debug模式
    self:refreshSpriteRect()
end

-- 刷新死亡完成挖掘 播放死亡动作的最后一帧
function MonsterAgent:refreshDieFinishDig()
    self._monsterActor:dieFinishDig()
    GameModule:removeDropAndBodyGridMap(self)
    -- self:roleRemoveAnentMN()
end

-- 是否需要移除地图上占用的格子
function MonsterAgent:roleRemoveAnentMN()
    -- if not self._monsterData:isAlive() and self._monsterData:isDig() then
    if not self._monsterData:isAlive() then
        -- 普通移除地图上占用的点 死亡完成挖掘后不占用格子
        local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
        mapAgent:removeAgentMN(self, self:getMNExactly())
    end

end

-- 执行怪物消失
function MonsterAgent:disappear(m,n, direction)
