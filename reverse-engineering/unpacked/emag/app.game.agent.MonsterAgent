function MonsterAgent:getPosition()
    return self._xCur, self._yCur
    -- return self._monsterActor:getPosition()
end

function MonsterAgent:setPosition(x, y)
    self._xCur = x
    self._yCur = y

    self._monsterActor:setPositionEx(x, y)

    local m, n = self:getMN()
    local zOrderOffset = 1
    if self._monsterData:getFakeCreatureType() == Constant.FAKE_CREATURE_TYPE.WILD_WOLF then
        zOrderOffset = -100
    end
    local zOrder = (n * 10000 + m + 9999) * 10 + zOrderOffset
    self._monsterActor:setLocalZOrder(zOrder)
    -- self._monsterActor:setLocalZOrder((n  * 10000 + m + 9999) * 10 + 1)
    

    --[[
        local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
        if mapAgent:isMNMask(m, n) then
            self._monsterActor:setAlpha(0.5)
        else
            self._monsterActor:setAlpha(1)
        end
    ]]
end

