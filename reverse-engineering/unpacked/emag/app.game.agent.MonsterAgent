function MonsterAgent:addDelayEffect(skillId)
    -- self._monsterActor:addDelayEffect(skillId)
end

function MonsterAgent:changeDarkness(darknessId)
    -- yflog:Info("MonsterAgent:changeDarkness(darknessId)", darknessId)
    for index, bitInfo in pairs(SkillEnum.DARKNESS_BITS) do
        if CommonUtil:isBitSet(darknessId, bitInfo.bit) == 1 then
            if bitInfo.buffId ~= BuffEnum.EFFECT_GROUND_VISIBLE  then --怪物土精灵隐身忽略
                self:addBuffer(bitInfo.buffId)
            end
        else
            if self:hasBuffer(bitInfo.buffId) then
                self:delBuffer(bitInfo.buffId)
            end
        end
    end
    self._monsterData:setDarkness(darknessId)
end

