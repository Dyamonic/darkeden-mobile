-- 位移
function MonsterAgent:getRect()
    if self:isDead() then
        return self:getDieRect()
    end

    local modelRadius = 0
    local modelHeight = 0
    local offsetX = 0
    local offsetY = 0
    local modelMeta = self:getModelMeta()
    if modelMeta then
        modelRadius = modelMeta:getRadius()
        modelHeight = modelMeta:getHeight()
        -- x y 坐标便宜
        offsetX = modelMeta:getOffsetX()
        offsetY = modelMeta:getOffsetY()
    end

    local x, y = self:getPosition()
    local ox, oy = self:getPositionOffset(self._monsterData:getModelId(), false)
    local radiusScale = (ox ~= 0) and 4 or 2
    return cc.rect(x - modelRadius + offsetX + ox, y + offsetY + oy, modelRadius * radiusScale, modelHeight)
end

function MonsterAgent:getDieRect()
    local modelRadius = 0
    local modelHeight = 0
    local offsetX = 0
    local offsetY = 0
    local modelMeta = self:getModelMeta()
    if modelMeta then
        modelRadius = modelMeta:getDeadRadius()
        modelHeight = modelMeta:getDeadHeight()
        offsetX = modelMeta:getDeadOffsetX()
        offsetY = modelMeta:getDeadOffsetY()
    end

    local x, y = self:getPosition()
    local ox, oy = self:getPositionOffset(self._monsterData:getModelId(), false)
    local radiusScale = (ox ~= 0) and 4 or 2

    return cc.rect(x - modelRadius + offsetX + ox, y + offsetY + oy, modelRadius * radiusScale, modelHeight)
end

-- 怪物移动速度
function MonsterAgent:getMoveSpeed()
    if not self._moveSpeedMap then
        self._moveSpeedMap = {}
    end

    if not self._moveSpeedMap[self:getDirection()] then
        local modelMeta = self:getModelMeta()
        if not modelMeta then
            self._moveSpeedMap[self:getDirection()] = Constant:getMonsterWalkSpeed(self:getDirection())
            return self._moveSpeedMap[self:getDirection()]
        end
        
        -- modelMeta:getMoveInterval() 移动间隔 距离
        self._moveSpeedMap[self:getDirection()] = Constant:getMonsterWalkSpeedByTime(self:getDirection(), modelMeta:getMoveInterval())
    end

    local moveRate = self._monsterData:getMoveSpeed()
    if moveRate == 0 then
        moveRate = 100
    end
    local moveSpeedRate = moveRate / 100

    return self._moveSpeedMap[self:getDirection()] * moveSpeedRate
end

