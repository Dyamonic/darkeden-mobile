end

function MonsterAgent:changePetLevel(value)
    local petLevel = self._monsterData:getPetLevel()
    if petLevel ~= value and self:getActor() then
        self:getActor():showLevelUpSpine()
    end
    self._monsterData:setPetLevel(value)
end

function MonsterAgent:getKillObjId()
    return self._monsterData:getKillObjId()
end

function MonsterAgent:getPetUid()
    return self._monsterData:getPetUid()
end

function MonsterAgent:getIsSelf()
    return false
end

---------------------------------------------------------------------
-- 迷幻术
function MonsterAgent:setHalluCreature()
    self._isHallu = lt.Constant.HALLUMODLE[math.random(1,#lt.Constant.HALLUMODLE)]
    self:initActionInfo()
end

function MonsterAgent:unSetHalluCreature()
    self._isHallu = nil
    self:initActionInfo()
end

function MonsterAgent:initActionInfo()
    local actor = self:getActor()
    if actor and actor.initActionInfo then
        actor:initActionInfo()
    end
end

function MonsterAgent:getIsHallu()
    return self._isHallu
end

---------------------------------------------------------------------
--- 分身术
function MonsterAgent:addDuplicateList(objectId)
    if not self._duplicateList then
        self._duplicateList = {}
    end
    table.insert(self._duplicateList, objectId)
end

function MonsterAgent:clearDuplicateList()
    self._duplicateList = nil
end

function MonsterAgent:getDuplicateList()
    return self._duplicateList or {}
end
---------------------------------------------------------------------
-- 隐蔽
function MonsterAgent:changeSkillHide(hide)
    self._monsterData:setSkillHide(hide)
    self._monsterActor:changeSkillHide()
end

function MonsterAgent:isSkillHide()
    if not self._monsterData then
        return false
    end
    
    return self._monsterData:isSkillHide()
end

---------------------------------------------------------------------

---------------------------------------------------------------------
-- 初始化特殊buff逻辑处理（隐身等）
function MonsterAgent:addEffectStatus()
    if self:hasBuffer(BuffEnum.EFFECT_CLASS_INVISIBILITY) then
        self:getActor():getCreature():setInvisibleSoon()
    end
end

---------------------------------------------------------------------
-- 是否是爆炸物
function MonsterAgent:isDeathExplosion()
    if not self._monsterData then
        return false
    end
    return  Constant.EXPLOSION[self._monsterData:getMonsterId() or 0] or false
end

---------------------------------------------------------------------
-- 移动模式
function MonsterAgent:getCurMoveMode()
    if self._monsterData then
        return self._monsterData:getMoveMode()
    else
        return 0
    end
end

function MonsterAgent:isStateTelePort()
    return false
end

function MonsterAgent:showBorder()
    yflog:Info("MonsterAgent:showBorder")
end

function MonsterAgent:isCrossCount()
    if self._monsterData then
        return self._monsterData:isCrossCount()
    else
        return false
    end
end

function MonsterAgent:isGroundElf()
    local modelId = self:getModelId()
    return modelId == SkillEnum.SUMMON.SUMMON_GROUND
end

function MonsterAgent:isSkillHide()
    if self._monsterData then
        return self._monsterData:isSkillHide()
    else
        return true
    end
end

function MonsterAgent:getTransformId()
    return self._transformId
end
function MonsterAgent:setTransformId(transformId)
    self._transformId = transformId
end

function MonsterAgent:checkIsMoveAction(actionId)
    -- 移动动作
    if actionId == Constant.ACTION_MOVE then
        return true
    end

    return false
end

return MonsterAgent
