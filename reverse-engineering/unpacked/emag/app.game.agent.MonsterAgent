function MonsterAgent:defaultState()
    if not self._monsterData then
        return
    end

    if self._monsterData:isAlive() then
        self:changeState(lt.MonsterStateIdle.new(self))
    else
        self:changeState(lt.MonsterStateDead.new(self))
    end
end

function MonsterAgent:getCurState()
    return self._stateMachine:getCurState()
end

function MonsterAgent:getCurStateId()
    if not self._stateMachine then
        return
    end
    return self._stateMachine:getCurStateId()
end

function MonsterAgent:isAlive()
    if not self._monsterData then
        return false
    end

    return self._monsterData:isAlive()
end

-- State
function MonsterAgent:changeState(newState)
