
local MonsterAgent = class("MonsterAgent", lt.BaseAgent)

local Constant = lt.Constant
local GameModule = lt.GameModule
local CacheManager = lt.CacheManager
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local CommonUtil = lt.CommonUtil
local AutoFightManager = lt.AutoFightManager
local WOLFAM = Constant.WILD_WOLF_ATTACK_MODE

MonsterAgent._monsterData  = nil
MonsterAgent._monsterActor = nil
MonsterAgent._stateMachine = nil
MonsterAgent._isOutOfGame  = nil

MonsterAgent._cmdSystem    = nil
MonsterAgent._bufferSystem = nil

-- MN，与服务器严格对应
MonsterAgent._mCur = nil
MonsterAgent._nCur = nil

MonsterAgent._xCur = nil
MonsterAgent._yCur = nil

MonsterAgent._duplicateList = nil -- 怪物技能临时列表

function MonsterAgent:ctor(monsterData, m, n, direction)
    MonsterAgent.super.ctor(self, Constant.AGENT_TYPE_MONSTER)

    self._monsterData = monsterData
    self._mCur        = m
    self._nCur        = n
    self._xCur        = 0
    self._yCur        = 0
    
    self._heroData = GameModule:getHeroData()

    self._monsterActor = lt.MonsterActor.new(self._monsterData, direction, self._heroData)
    self:setAgent()

    self:setPositionAndOffset(monsterData:getModelId(), m, n)
    
    if monsterData:isAlive() then
        -- 活着
        self._stateMachine = lt.StateMachine.new(lt.MonsterStateIdle.new(self), lt.MonsterStateGlobal.new(self))

        -- lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MINIMAP_ADD_MN, {agentId=self._agentId,m=m,n=n,colorType=Constant.MINIMAP_GREEN})
        GameModule:addUpdateEventMiniMap(lt.NtfManager.NTF.NTF_MINIMAP_ADD_MN, {agentId=self._agentId,m=m,n=n,colorType=Constant.MINIMAP_GREEN})

        self._isOutOfGame = false
    else
        -- 死亡
        -- 是否完成挖掘，用于判断播放死亡动作的最后一帧
        self._monsterActor:setDead()
        if self:isDig() then
            self._monsterActor:dieFinishDig()
        end
    
        self._stateMachine = lt.StateMachine.new(lt.MonsterStateDead.new(self), lt.MonsterStateGlobal.new(self))
        self._isOutOfGame = true
    end

    lt.AgentManager:addAgent(self)
    self._cmdSystem = lt.CmdSystem.new()
    self._bufferSystem = lt.BufferSystem.new(self._monsterActor)

    -- 测试
    if DEBUG > 0 then
        -- local rect = self:getRect()
        -- local modelMeta = self:getModelMeta()

        -- local offsetX = 0
        -- local offsetY = 0
        -- if modelMeta then
        --     offsetX = modelMeta:getOffsetX()
        --     offsetY = modelMeta:getOffsetY()
        -- end

        -- local spriteRect = display.newSprite("ui/common/rect.png")
        -- spriteRect:setAnchorPoint(0.5, 0)
        -- spriteRect:setScale(rect.width / 100, rect.height / 100)

        -- local ox, oy = self:getPositionOffset(self._monsterData:getModelId(), false)
        -- spriteRect:setPosition(offsetX + ox, offsetY + oy)

        -- self._monsterActor:addChild(spriteRect, 999999)

        -- self._spriteRect = spriteRect
    end

    -- 龙卷风不显示名字
    if self:getModelId() == SkillEnum.SUMMON.SUMMON_WIND then
        self:hideNameNode()
    end
    if self:getModelId() == SkillEnum.SUMMON.SUMMON_MIGA then
        self:setIsOutOfGame(true)
    end
    if monsterData:getFakeCreatureType() == Constant.FAKE_CREATURE_TYPE.WILD_WOLF then
        self:hideNameNode()
        lt.ScheduleUtil:performWithDelayGlobal(function()
            self:changeState(lt.MonsterWolfAttack.new(self))
        end,  lt.GameBoard:getDeltaTime())
    end
end


-- 能否移动
function MonsterAgent:canMove()
    return self._bufferSystem:canMove()
end

function MonsterAgent:refreshSpriteRect()
    if not self._spriteRect then
        return
    end

    local rect = self:getRect()
    local modelMeta = self:getModelMeta()

    local offsetX = 0
    local offsetY = 0
    if modelMeta then
        offsetX = modelMeta:getOffsetX()
        offsetY = modelMeta:getOffsetY()
    end

    self._spriteRect:setScale(rect.width / 100, rect.height / 100)
    local ox, oy = self:getPositionOffset(self._monsterData:getModelId(), false)
    self._spriteRect:setPosition(offsetX + ox, offsetY + oy)
end

function MonsterAgent:setPositionAndOffset(mid, m, n)
    -- 特殊城门怪对齐位置偏移处理
    local monsterX, monsterY = lt.MapUtil:calcMNMid(m, n)
    local ox, oy = self:getPositionOffset(mid, true)
    self:setPosition(monsterX + ox, monsterY + oy)
end

function MonsterAgent:getPositionOffset(mid, off)
    local ox = 0
    local oy = 0
    if mid == 20187 then
        ox = 23
        oy = -59
    elseif mid == 20188 then
        ox = 10
        oy = -58
    elseif mid == 20189 then
        ox = -11
        oy = -70
    elseif mid == 20190 then
        ox = 10
        oy = -90
    else
        return ox, oy 
    end
    if off then
        return -ox, -oy
    end
    return ox, oy
end

function MonsterAgent:onClear()
    GameModule:removeDropAndBodyGridMap(self)
    -- 从AgentManager中移除
    lt.AgentManager:removeAgent(self)
    self._delayedFrame = nil
    if self._stateMachine then
        self._stateMachine:onClear()
    end
    if self._monsterActor then
        self._monsterActor:onClear()
    end

    self._monsterActor = nil
    self._stateMachine = nil
    self._cmdSystem = nil
    self._bufferSystem = nil

    self:clearDuplicateList()

    -- lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MINIMAP_DEL_MN, {agentId=self._agentId})
    -- lt.GameModule:addUpdateEventMiniMap(lt.NtfManager.NTF.NTF_MINIMAP_DEL_MN, {agentId=self._agentId})
end

function MonsterAgent:onUpdate(dt)
    local delta = lt.GameBoard:getDeltaTime()
    if self._stateMachine then
        self._stateMachine:onUpdate()
    end
    if self._delayedFrame and self._delayedFrame > 0 then
        if self._monsterActor then
            local _deltatime = delta*0.5
            self._monsterActor:onUpdate(_deltatime)
            self._monsterActor:onUpdate(_deltatime)
        end
        self._delayedFrame = self._delayedFrame - 1
    end
    if self._monsterActor then
        self._monsterActor:onUpdate(delta)
    end
end

function MonsterAgent:onDelayUpdate(dt,delaylevel)
    if delaylevel >= 3 then
        if not self:isAlive() then
            return
        end
    end
    local delta = lt.GameBoard:getDeltaTime()
    if self._stateMachine then
        self._stateMachine:onUpdate()
    end
    if delaylevel >= 3 then
        self._delayedFrame = self._delayedFrame or 0
        self._delayedFrame = self._delayedFrame + 1
    else
        if self._monsterActor then
            self._monsterActor:onUpdate(delta)
        end
    end
end

function MonsterAgent:checkDieDelayUpdate()
    if self._delayedFrame then
        local delta = lt.GameBoard:getDeltaTime()
        for i = 1,self._delayedFrame do
            if self._stateMachine then
                self._stateMachine:onUpdate()
                if self._monsterActor then
                    self._monsterActor:onUpdate(delta)
                end
            end
        end
        self._delayedFrame = nil
    end
end

function MonsterAgent:onMessage(msg)
    if self._stateMachine then
        self._stateMachine:onMessage(msg)
    end
end

function MonsterAgent:hideNameNode()
    if self._monsterActor then
        self._monsterActor:hideNameNode()
