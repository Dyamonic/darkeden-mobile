---@class CompTaskCell 主界面任务cell
local CompTaskCell = class("CompTaskCell",lt.UIGButtonBase, lt.UICompChangeSkin)

local NtfManager = lt.NtfManager
local Constant = lt.Constant
local CacheManager = lt.CacheManager
local ItemModule = lt.ItemModule
local SkeletonManager = lt.SkeletonManager
local TimeCounter = lt.TimeCounter
--
local TASK_SPINE_SIZE_HEGHT = 94
local TASK_SPINE_OFFY = 58
function CompTaskCell:ctor()
    CompTaskCell.super.ctor(self)

    self._metaTime = 0
    self._lastTime = 0
end

function CompTaskCell:onEnter()
    CompTaskCell.super.onEnter(self)
end
function CompTaskCell:onExit()
    CompTaskCell.super.onExit(self)
end
function CompTaskCell:onClear()
    self._titleLabel = nil
    self._tagLabel = nil
    self._contentLabel = nil
    self._numLabel = nil
    self._timeLabel = nil
    self._stateLabel = nil
    self._effectnNode = nil
    if self._spine1 then
        self._spine1:removeSelf()
        self._spine1 = nil
    end
    if self._spine2 then
        self._spine2:removeSelf()
        self._spine2 = nil
    end
    CompTaskCell.super.onClear(self)
end

function CompTaskCell:onConstruct()
    self._titleLabel = self:getChild("txtTaskContent")
    self._tagLabel = self:getChild("txtTaskTag")
    self._contentLabel = self:getChild("txtTaskTitle")
    self._numLabel = self:getChild("txtTaskNum")
    self._timeLabel = self:getChild("txtTaskTime")
    self._stateLabel = self:getChild("txtTaskState")
    self._effectnNode = self:getChild("node_effect")

    --创建特效spine
    self._spine1 = SkeletonManager:createSkeletonEffectWithFile("task_complete_sketon", "task_complete_sketon")
    self._effectnNode:displayObject():addChild(self._spine1)
    self._spine1:setVisible(false)
    self._spine1:setAnimation(0, "task_complete_sketon", true)

    self._spine2 = SkeletonManager:createSkeletonEffectWithFile("task_refresh_sketon", "task_refresh_sketon")
    self._effectnNode:displayObject():addChild(self._spine2)
    self._spine2:setCallback(handler(self, self.spineAnimationEnd))
    self._spine2:setVisible(false)
end

function CompTaskCell:timeUpdate()
    -- yflog:Info("CompTaskCell:timeUpdate self._metaTime:%s self._lastTime:%s", self._metaTime, self._lastTime)
    if self._metaTime <= 0 then
        return
    end

    if self._lastTime <= 0 then
        return
    end
    
    self:refreshTimer()
end

function CompTaskCell:setInfo(taskData)
    self._taskData = taskData
    local missionId = taskData.taskId
    local meta = CacheManager:getMissionMeta(missionId)
    self._titleLabel:setText(meta:getMissionName())
    self._tagLabel:setText("【"..GReadText["KEY_TASKTYPE_TIPS"..meta:getMissionType()].."】")
    local desc = string.split(meta:getMissionObject(), ";")
    local missionTarget = meta:getMissionTarget()
    local targetStr = ""
    local targetNum = ""
    local isFinish = true
    for i = 1, #desc do
        local cur = (taskData.hadNumMap and taskData.hadNumMap[i]) and taskData.hadNumMap[i].value or 0
        local tempStr = desc[i]
        if meta:getObjectType() == Constant.TASK_FINISH_TYPES.SEARCH then
            local itemId = tonumber(missionTarget[i][3])
            cur = ItemModule:getItemNum(itemId)
        elseif meta:getObjectType() == Constant.TASK_FINISH_TYPES.KILLMONSTER then
            local monsterId = missionTarget[i][2]
            if monsterId ~= 0 then
                local monsterCfg = CacheManager:getMonsterInfoMeta(monsterId)
                tempStr = string.format(desc[i], monsterCfg:getName())
            end
        end
        local max = tonumber(missionTarget[i][1])
        if cur > max then cur = max end
        targetStr = targetStr..tempStr
        targetNum = targetNum..cur.."/"..max
        if i < #desc then
            targetStr = targetStr.."\n"
        end
        if cur < max then
            isFinish = false
        end
    end
    self._isFinish = isFinish
    self._contentLabel:setText(targetStr)
    self._contentLabel:setColor(isFinish and Constant.COLOR_GREEN_H or Constant.COLOR_TEXT_WHITE_PURE)
    self._numLabel:setText(targetNum)
    self._numLabel:setColor(isFinish and Constant.COLOR_GREEN_H or Constant.COLOR_TEXT_WHITE_PURE)
    self._timeLabel:setVisible(meta:getTime() > 0)
    self._stateLabel:setText(isFinish and GReadText.KEY_ACTIVITY_TASK_TIPS5 or GReadText.KEY_ACTIVITY_TASK_TIPS13)
    self._stateLabel:setColor(Constant.COLORS.green)

    self._metaTime = meta:getTime()
    if self._metaTime > 0 then
        self:refreshTimer()
    end
    self._spine1:setVisible(isFinish and meta:getClickComplete() == 1)
    self._spine1:setScale(1, self:getHeight()/TASK_SPINE_SIZE_HEGHT)
    self._spine1:setPositionY((TASK_SPINE_OFFY-self:getHeight())/2)
    self._spine2:setScale(1, self:getHeight()/TASK_SPINE_SIZE_HEGHT)
    self._spine2:setPositionY((TASK_SPINE_OFFY-self:getHeight())/2)
end

function CompTaskCell:refreshTimer()
    local serverTime = TimeCounter:serverTime()
    local cdTime = self._taskData.expirationTime
    local lastTime = cdTime - serverTime
    local timeStr = lastTime > 0 and lt.CommonFunc:secondsToTime3(lastTime) or "00：00"
    local color = lastTime <= 300 and "[color=#ff0000]" or "[color=#00ff00]"
    self._timeLabel:setText(GReadText.KEY_BUFF_TIPS1..color..timeStr.."[/color]")
    self._timeLabel:setColor(lastTime <= 300 and Constant.COLORS.red or Constant.COLORS.lightblue)
    if lastTime <= 0 then
        if not self._isFinish then
            self._stateLabel:setText(GReadText.KEY_ACTIVITY_TASK_TIPS14)
            self._stateLabel:setColor(Constant.COLORS.red)
        end
    end

    self._lastTime = lastTime
end

--动画回调
function CompTaskCell:spineAnimationEnd(event)
    if event.type == "complete" then
        if event.animation == "task_refresh_sketon" then
            self._spine2:setVisible(false)
        end
    end
end

function CompTaskCell:playReceiveAnim()
    self._spine2:setVisible(true)
    self._spine2:setAnimation(0, "task_refresh_sketon", false)
end

return CompTaskCell