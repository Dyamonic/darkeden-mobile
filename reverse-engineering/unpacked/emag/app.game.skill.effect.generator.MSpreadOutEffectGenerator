local MSpreadOutEffectGenerator = class("MSpreadOutEffectGenerator", lt.MEffectGenerator)
local MapUtil = lt.MapUtil
local SkillEnum = lt.SkillEnum
local Constant = lt.Constant
local CacheManager = lt.CacheManager
local MapUtil = lt.MapUtil

function MSpreadOutEffectGenerator:generate(egInfo)
    local bOK = false

    local est = egInfo.effectSpriteType
    -- local bltType = g_pEffectSpriteTypeTable[est].BltType
    -- local frameID = g_pEffectSpriteTypeTable[est].FrameID

    local skillId = egInfo.skillId

    -- local maxFrame = MapUtil:GetMaxEffectFrame(bltType, frameID)

    local pTarget = egInfo.pEffectTarget

    -- 开始坐标
    local sx = egInfo.x0
    local sy = egInfo.y0
    local sz = 0

    -- 目标坐标
    local cx, cy
    local tx, ty, tz = sz, sz, sz

    for dir = 1, 8, 1 do
        local d = dir - 1
        local movePixel = egInfo.step

        local m, n = MapUtil:PixelToMap(sx, sy)

        local x, y = MapUtil:getPositionToDirection(m, n, d)

        tx, ty = MapUtil:MapToPixel(x, y)
   
        cx = sx - tx
        cy = sy - ty

        local currentPixel = math.sqrt(cx * cx + cy * cy)

        local basis = (cx == 0) and 0 or (cy / cx)

        if currentPixel ~= 0 then
            movePixel = movePixel * (1.0 - math.abs(cy / (2.0 * currentPixel)))
            local movePixelStep = movePixel * egInfo.count

            tx = sx - (cx * movePixelStep / currentPixel)
            ty = sy - (cy * movePixelStep / currentPixel)
        end

        -- 创建效果
        local pEffect = lt.BulletLinear.new(skillId)
        -- pEffect:setFrameID(frameID, maxFrame)
        pEffect:setPixelPosition(sx, sy, sz)
        pEffect:setTarget(tx, ty, tz, egInfo.step)
        -- pEffect:setStepPixel(egInfo.step)
        -- pEffect:setCount(egInfo.count, egInfo.linkCount)
        pEffect:setDirection(d)
        if skillId == SkillEnum.SKILL_BLOODY_STORM then
            local actionInfoMetas = lt.CacheManager:getProcessMetas(skillId)
            pEffect:addEffetMeta(actionInfoMetas[2])
        elseif skillId == SkillEnum.MAGIC_BLOODY_BALL then
            local actionInfoMetas = lt.CacheManager:getProcessMetas(skillId)
            pEffect:addEffetMeta(actionInfoMetas[2])
        end
        pEffect:setEndCallBack(egInfo.callback)
        lt.BulletManager:addBulletToMap(pEffect)
        -- pEffect:setPower(egInfo.power)

        -- -- 添加到 Zone
        -- if d == 0 then
        --     bOK = g_pZone:AddEffect(pEffect)

        --     if bOK then
        --         if pTarget == nil then
        --             pEffect:SetLink(egInfo.nActionInfo, nil)
        --         else
        --             pEffect:SetLink(egInfo.nActionInfo, pTarget)
        --             pTarget:Set(tx, ty, tz, egInfo.creatureID)
        --         end
        --     end
        -- else
        --     if g_pZone:AddEffect(pEffect) then
        --         if pTarget == nil then
        --             pEffect:SetLink(egInfo.nActionInfo, nil)
        --         else
        --             local pEffectTarget2 = MEffectTarget.new(pTarget)
        --             pEffect:SetLink(egInfo.nActionInfo, pEffectTarget2)
        --             pEffectTarget2:Set(tx, ty, tz, egInfo.creatureID)
        --         end
        --     end
        -- end
    end

    return bOK
end
return MSpreadOutEffectGenerator