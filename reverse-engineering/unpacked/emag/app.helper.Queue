
local Queue = class("Queue")

Queue._left  = nil
Queue._right = nil
Queue._table = nil

function Queue:ctor()
    self._left  = 0
    self._right = 0
    self._table = {}
end

function Queue:push(obj)
    self._table[self._right] = obj
    self._right = self._right + 1
end

function Queue:pop()
    if self._left >= self._right then
        return
    end

    local obj = self._table[self._left]

    self._table[self._left] = nil
    self._left = self._left + 1

    return obj
end

function Queue:get()
    if self._left >= self._right then
        return
    end

    return self._table[self._left]
end

function Queue:getSize()
    return self._right - self._left
end

function Queue:getArray()
    return self._table, self._left, self._right
end

return Queue
