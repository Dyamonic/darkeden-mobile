local BufferGreenStalker = class("BufferGreenStalker", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum

--[[
    毒物
]]
function BufferGreenStalker:ctor(time, actor, skilllevel)    
    BufferGreenStalker.super.ctor(self, BuffEnum.EFFECT_CLASS_GREEN_STALKER, time, actor)

    -- 播放特效 1为目标对象
    actor:playQueueEffect(SkillEnum.SKILL_GREEN_STALKER, 1)
end

function BufferGreenStalker:onClear()
    -- stop 播放
    self._actor:stopQueueEffect(SkillEnum.SKILL_GREEN_STALKER)

    BufferGreenStalker.super.onClear(self)
end

return BufferGreenStalker
