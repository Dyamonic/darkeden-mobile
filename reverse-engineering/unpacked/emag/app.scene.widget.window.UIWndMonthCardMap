--- 月卡地图
---@class UIWndMonthCardMap:UIWindowBase
local UIWndMonthCardMap = class("UIWndMonthCardMap", lt.UIWindowBase)

local NtfManager        = lt.NtfManager
local GameModule        = lt.GameModule
local CacheManager      = lt.CacheManager
local Constant          = lt.Constant
local MapModule         = lt.MapModule
local RaceSkinRes       = Constant.RaceSkinRes
local ItemModule        = lt.ItemModule
local CommonFunc        = lt.CommonFunc
local RechargeModule    = lt.RechargeModule
local AgentManager      = lt.AgentManager


UIWndMonthCardMap.ChangeSkinConf = {
    ["Dungeon"] = {
        ["bg"] = "bg_youjian_tanchuangdi",
        ["bg_di"] = "bg_ykdt_dikuang",
        ["bg_biaoti"] = "bg_fuben_biaoti",
        ["bg_jl"] = "bg_fuben_fbjl",
    },
    ["CommonTL"] = {
        ["frame"] = {
            closeButton = { bg = "bg_beibao_anniu01", bgup = "bg_beibao_anniu02" },
        },
        ["btn_enter"] = { bg = "btn_lunpan_liang" },
        ["btn_team"] = { bg = "btn_lunpan_liang" },
    }
}

function UIWndMonthCardMap:ctor(param)
    UIWndMonthCardMap.super.ctor(self, param)
    self._rewardList = nil
    self._curMate    = nil
    self._item       = nil
    self._meta       = nil
    self._itemMeta   = nil
end

function UIWndMonthCardMap:onInit()
    UIWndMonthCardMap.super.onInit(self, _GURL.MonthCardMapPanel)

    self._listReward = self:getChild("list_reward")
    self._lblDesc    = self:getChild("lbl_desc")
    self._lblDiff    = self:getChild("lbl_diff")
    self._lblTjLv    = self:getChild("lbl_tjLv")
    self._lblPk      = self:getChild("lbl_pk")
    self._lblName    = self:getChild("lbl_name")
    self._btnEnter   = self:getChild("btn_enter")
    self._btnTeam    = self:getChild("btn_team")
    self._itemCost   = self:getChild("itemCost")
    self._lblCost    = self:getChild("lbl_cost")

    self._listReward:setItemRenderer(handler(self, self.onRenderItem))
end

function UIWndMonthCardMap:onShown()
    self._listReward:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    self._btnEnter:addClickListener(handler(self, self.onBtnEnterClick))
    self._btnTeam:addClickListener(handler(self, self.onBtnTeamClick))
    self._itemCost:addClickListener(handler(self, self.onItemClick))

    self:initUI()

    local heroAgent = AgentManager:getHeroAgent()
    if heroAgent then
        heroAgent:onMessage({msgId = Constant.MSG_ROUTE_STOP})
    end
end

function UIWndMonthCardMap:onHide()
    if self._listReward then
        self._listReward:removeEventListener(fgui.UIEventType.ClickItem)
    end
    self._btnEnter:removeClickListener()
    self._btnTeam:removeClickListener()
    self._itemCost:removeClickListener()

    local heroAgent = AgentManager:getHeroAgent()
    if heroAgent then
        heroAgent:resetProtalSending()
    end

    UIWndMonthCardMap.super.onHide(self)
end

function UIWndMonthCardMap:onClear()
    self._listReward = nil
    self._lblDesc    = nil
    self._lblDiff    = nil
    self._lblTjLv    = nil
    self._lblPk      = nil
    self._lblName    = nil
    self._btnEnter   = nil
    self._btnTeam    = nil
    self._itemCost   = nil
    self._lblCost    = nil

    self._rewardList = nil
    self._curMate    = nil
    self._item       = nil
    self._meta       = nil
    self._itemMeta   = nil

    UIWndMonthCardMap.super.onClear(self)
end

function UIWndMonthCardMap:initUI()
    local param = self:getParam().param
    local mapCode = param.mapCode
    local moonCardMap = CacheManager:getMonthCardMap() or {}
    if moonCardMap[mapCode] then
        local meta = moonCardMap[mapCode]
        self._lblDesc:setText(meta:getMapDescription())
        self._lblDiff:setText(meta:getMapDifficulty())

        self._lblPk:setText(meta:getPKType())
        self._lblName:setText(meta:getMapName())
        local LvList = CommonFunc:analysisJsonToTable(meta:getRecommendLevel(), true)
        local heroData = GameModule:getHeroData()
        local advState = heroData:getAdvanceState()
        local level = 0
        if advState == Constant.AdvState.NotAdv then
            level = heroData:getLevel()
        else
            local curAdvLvl = heroData:getAdvanceLevel()
            level = curAdvLvl + Constant.TransferLevel
        end
        local lvColor = (level >= LvList[1]) and Constant.COLOR_GREEN or Constant.COLOR_TEXT_RED
        local lvStr = string.format("Lv.%s-Lv.%s", LvList[1], LvList[2])
        self._lblTjLv:setText(lvStr)
        self._lblTjLv:setColor(lvColor)
        local reward = nil
        local heroData = GameModule:getHeroData()
        if heroData:isSlayer() then
            reward = meta:getMapPriceS()
        elseif heroData:isVampire() then
            reward = meta:getMapPriceV()
        elseif heroData:isOusters() then
            reward = meta:getMapPriceO()
        end

        -- 消耗
        local itemMeta = ""
        local iconPath = ""
        local itemCost = meta:getEnterItem()
        if itemCost[1] == Constant.ItemType.ITEM_TYPE_PROP then
            iconPath = "prop"
            itemMeta = CacheManager:getItemMeta(itemCost[2])
        elseif itemCost[1] == Constant.ItemType.ITEM_TYPE_EQUIP then
            iconPath = "equip"
            itemMeta = CacheManager:queryEquipMeta(itemCost[2])
        end

        local allCount = ItemModule:getItemAllCountByItemId(itemMeta:getItemId(), itemMeta:getItemType())
        local resUrl = string.format("ui://Item/%s_%s", iconPath, itemMeta:getIconId())
        self._itemCost.itemMeta = itemMeta
        self._itemCost:setURL(resUrl)
        self._lblCost:setText(itemCost[3] .. "/" .. allCount)
        local lvColor = tonumber(allCount) < tonumber(itemCost[3]) and Constant.COLOR_TEXT_RED or Constant.COLOR_GREEN
        self._lblCost:setColor(lvColor)

        self._rewardList = reward
        self._curMate = meta
        self._listReward:setNumItems(#reward)
    end
end

function UIWndMonthCardMap:onRenderItem(index, obj)
    local index = index + 1
    local meta = self._rewardList[index]
    if meta then
        local selfRace = GameModule:getHeroData():getRace()
        obj:getChild("bg"):setURL(string.format(_GURL.GetDungeonItem, RaceSkinRes[selfRace]))
        obj:getChild("lbl_count"):setText("")
        local bgWen = obj:getChild("bg_wen")
        --是否至灰色
        if meta[1] == 1 then
            local resUrl = string.format(string.format(_GURL.GetTaskPath, "icon_cwrw_wenhao"))
            bgWen:setURL(resUrl)
        else
            bgWen:setURL("")
        end
        local resUrl = ""
        local itemMeta = ""
        local iconPath = ""
        if meta[2] == Constant.ItemType.ITEM_TYPE_PROP then
            iconPath = "prop"
            itemMeta = CacheManager:getItemMeta(meta[3])
        elseif meta[2] == Constant.ItemType.ITEM_TYPE_EQUIP then
            iconPath = "equip"
            itemMeta = CacheManager:queryEquipMeta(meta[3])
        end
        if itemMeta then
            resUrl = string.format("ui://Item/%s_%s", iconPath, itemMeta:getIconId())
            local bgProp = obj:getChild("bg_prop")
            bgProp:setGrayed(meta[1] == 1)
            bgProp:setURL(resUrl)
            obj.itemMeta = itemMeta
            obj.meta = meta
        end
    end
end

function UIWndMonthCardMap:onClickItem(context)
    local obj = context:getData()
    self._meta = obj.meta
    self._itemMeta = obj.itemMeta
    self._item = obj
    self:showTips()
end

function UIWndMonthCardMap:showTips()
    if self._meta[1] == 1 then
        --圣物读其他字段
        local itemSize = self._item:getSize()
        local point = self._item:localToGlobal({ x = itemSize.width, y = itemSize.height })
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_TEXT_TIPS,
            {
                content = self._curMate:getIconDescribe(),
                pt = point,
                pivot = cc.p(0, 1),
                width = 180
            })
    else
        local itemType = self._itemMeta:getItemType()
        if itemType == Constant.ItemType.ITEM_TYPE_PROP then
            self:showPropTips()
        elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
            self:showEquipTips()
        end
    end
end

function UIWndMonthCardMap:showPropTips()
    local itemInfo = ItemModule:getItemDataByConfig(self._itemMeta)
    local point = self._item:localToGlobal({ x = self._item:getSize().width, y = 0 })
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,
        { itemInfo = itemInfo, pt = point, pivot = cc.p(0, 0.5), tipsType = Constant.PROPTIPS_FORM.Display })
end

function UIWndMonthCardMap:showEquipTips()
    local itemInfo = ItemModule:getItemDataByConfig(self._itemMeta, nil)
    local point = self._item:localToGlobal({ x = self._item:getSize().width, y = 0 })
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,
        { itemInfo = itemInfo, pt = point, tipsType = Constant.EquipShowTipsType.Display })
end

function UIWndMonthCardMap:onBtnEnterClick()
    local isMonthCard = RechargeModule:checkMonthCard()
    --是否拥有月卡
    if not isMonthCard then
        --没有月卡判断次票数量
        local itemCost = self._curMate:getEnterItem()
        local isEnough = ItemModule:enoughItem(itemCost[1], itemCost[2], itemCost[3], {tips = true})
        if not isEnough then
            return
        end
    end
    local param = self:getParam().param
    local mapCode = param.mapCode
    MapModule:sendTransferReq(mapCode)
end

function UIWndMonthCardMap:onBtnTeamClick(target)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndTeam" })
end

function UIWndMonthCardMap:onItemClick(target)
    local itemMeta = target:getSender().itemMeta
    if itemMeta then
        ItemModule:showTipsByType(itemMeta)
    end
end

return UIWndMonthCardMap
