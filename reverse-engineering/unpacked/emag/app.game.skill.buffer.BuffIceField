local BuffIceField = class("BuffIceField", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local Constant = lt.Constant

--[[
    冰之领域
]]
function BuffIceField:ctor(time, actor, skilllevel, source)    
    BuffIceField.super.ctor(self, BuffEnum.EFFECT_CLASS_ICE_FIELD_TO_CREATURE, time, actor, skilllevel, source)
    -- if source.srcId == SkillEnum.SKILL_FROZEN_ARMOR then
        actor:playParallelEffectByLv(SkillEnum.SKILL_FROZEN_ARMOR, 1, Constant.EFFECT.HIT)
    -- end
end

function BuffIceField:onClear()
    -- if self._source.srcId == SkillEnum.SKILL_FROZEN_ARMOR then
        self._actor:stopParallelEffect(SkillEnum.SKILL_FROZEN_ARMOR)
    -- end
    BuffIceField.super.onClear(self)
end

return BuffIceField
