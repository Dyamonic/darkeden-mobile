
local EquipDao = {}

function EquipDao:query(id)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Equip WHERE ItemIdx=%d;", id)) do
        local equip = lt.EquipMeta.new(row)
        return equip
    end
end

function EquipDao:queryAll()
    local equipTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Equip;") do
        local equip = lt.EquipMeta.new(row)
        equipTable[equip:getItemId()] = equip
    end
    return equipTable
end

function EquipDao:queryAllByKind()
    local equipTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Equip") do
        local equip = lt.EquipMeta.new(row)
        if not equipTable[equip:getKind()] then
            equipTable[equip:getKind()] = {}
        end
        table.insert(equipTable[equip:getKind()], equip)
    end
    return equipTable
end

return EquipDao
