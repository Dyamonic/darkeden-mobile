local BulletMoveEffect = class("BulletMoveEffect", lt.BulletBase)
--[[
    追踪
]]

local AgentManager = lt.AgentManager
local Constant = lt.Constant
local GameBoard = lt.GameBoard
local CacheManager = lt.CacheManager
local EffectEnum = lt.EffectEnum
local EffectActor = lt.EffectActor
local SkillEnum     = lt.SkillEnum


BulletMoveEffect._targetAgentId  = nil
BulletMoveEffect._effectActor = nil

---参数说明
---@param skillId number 技能ID
---@param targetAgentId number 目标ID
---@param startXY vec2_table 起始坐标
---@param direction number 方向
---@param groupId number 子弹组ID
---@param isChase boolean 是否追击
---@param isLinear boolean 是否为直线性

function BulletMoveEffect:ctor(param)
    BulletMoveEffect.super.ctor(self, param.skillId, param.groupId)
    self._skillId = param.skillId
    self._targetAgentId = param.targetAgentId
    self._direction = param.direction
    self._isChase = param.isChase -- 是否进行追踪目标
    self._isLinear = param.isLinear -- 是否为直线性
    self._startPos = param.startXY
    self._endXY = param.endXY
    self:setPosition(self._startPos)

    -- 计算方向
    local targetAgent = AgentManager:getAgent(self._targetAgentId)
    if targetAgent then
        self._endX, self._endY = targetAgent:getPosition()
        self._endY = self._endY + 50
        self._targetAgent = targetAgent
    else
        if self._endXY then
            self._endX, self._endY = self._endXY.x, self._endXY.y
        else
            return 
        end
    end
    
    local offsetX = -25
    local offsetY = -Constant.MODEL_HERO_Y/2
    self._effectNode = display.newNode()
    self._effectNode:setPosition(offsetX, offsetY)
    self:addChild(self._effectNode)
    self._isEndEffect = false
    self:addEffectActor(self._skillId)
end

function BulletMoveEffect:onClear()
    if self._effectActor then
        self._effectActor:onClear()
        self._effectActor = nil
    end
    
    self:removeAllChildren()

    self._isEndEffect = nil
    self._effectNode = nil
end

function BulletMoveEffect:addEffectActor(skillId)
    local effectGeneratorID = EffectEnum.EFFECTGENERATORID_ATTACK_CREATURE
    local owner = SkillEnum.EFFECT_OWNER.SELF

    if skillId == SkillEnum.MAGIC_BLOODY_KNIFE then
        effectGeneratorID = EffectEnum.EFFECTGENERATORID_ATTACK_CREATURE
        owner = 1
    end

    local actionInfoMetas = CacheManager:getSkillEffectBySkillIdAndGenerator(skillId, effectGeneratorID, owner)
    if not actionInfoMetas or #actionInfoMetas < 1 then
        yflog:InfoLine(" BulletMoveEffect the skill:%d has no skill effect meta", skillId)
        return
    end

    local meta = actionInfoMetas[1]
    -- 存在旋转 所以需要加上锚点
    local anchorPoint = self:getAnchorPointByDirection(self._direction)
    -- if self._isLinear then
    --     -- anchorPoint = cc.p(0.5, 0.5)
    -- end
    self._effectActor = EffectActor.new(meta, self._direction, anchorPoint, true)
    self._effectNode:addChild(self._effectActor)

    self._actionInfoMeta = meta

    self._isEndEffect = true
end

function BulletMoveEffect:onUpdate()
    self:onUpdateMove()
    self:onUpdateEffect()
end

function BulletMoveEffect:onUpdateMove()
    if not self._effectActor then
        return
    end
    -- 只做距离移动
    local targetAgent = AgentManager:getAgent(self._targetAgentId)
    -- if not targetAgent then
    --     self._waitingForClear = true
    --     return
    -- end

    if self._isChase and targetAgent then
        local endX, endY = targetAgent:getPosition()
        self._endX = endX
        self._endY = endY + 18
    end
   

    local offsetXY = self:getOffectXYByDirection(self._direction)
    local endPos = cc.p(self._endX+offsetXY.x, self._endY+offsetXY.y)

   
    local curX, curY = self:getPosition()

    if self._isLinear then
        endPos = cc.p(curX, endPos.y)
    end

    local meta = self._actionInfoMeta
    local offsetSpeed = meta:getBulletOffsetMoveSpeed(1)
    local speed = Constant.MODEL_BULLET_SPEED + offsetSpeed

    local step = speed * GameBoard:getDeltaTime()

    local directionV = cc.pSub(endPos, cc.p(curX, curY))
    if cc.pGetLength(directionV) < step  then
   
        self:setPosition(endPos)
        self._waitingForClear = true
    else
        -- 旋转对应的方向: 弧度转角度(x除以y的商的反正切值)
        -- self._effectActor:setActorRotation(self:getRotationByDirection(directionV, self._direction))

        directionV = cc.pMul(cc.pNormalize(directionV), step)
        self:setPosition(curX + directionV.x, curY + directionV.y)
    end
end

function BulletMoveEffect:onEnd(isLastGroupMember)
    if isLastGroupMember then
        
    end
    self:onClear()
end

function BulletMoveEffect:onUpdateEffect()
    if not self._isEndEffect then
		return
	end

    if not self._effectActor then 
        return
    end

    self._effectActor:onUpdateEffect()
end


return BulletMoveEffect
