function AutoFightManager:isAutoBuyItem(itemId)
	if self._potionHpAutoBuy and self._potionHpAutoBuy.itemId and self._potionHpAutoBuy.itemId == itemId then
		return true
	end
	if self._potionMpAutoBuy and self._potionMpAutoBuy.itemId and self._potionMpAutoBuy.itemId == itemId then
		return true
	end
	return false
end

