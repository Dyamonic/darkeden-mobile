--检测自动使用药品
function AutoFightManager:reloadPostionConfig()
    if self:getRace() == Constant.RaceType.Slayer then
		self:setAutoUsePotion(Constant.SETTINGS_TYPES.SLAYER_HP)
		self:setAutoUsePotion(Constant.SETTINGS_TYPES.SLAYER_MP)
    elseif self:getRace() == Constant.RaceType.Vampire then
		self:setAutoUsePotion(Constant.SETTINGS_TYPES.VAMPIRE_HP)
    elseif self:getRace() == Constant.RaceType.Ousters then
		self:setAutoUsePotion(Constant.SETTINGS_TYPES.OUSTERS_HP)
		self:setAutoUsePotion(Constant.SETTINGS_TYPES.OUSTERS_EP)
    end
end

function AutoFightManager:setAutoUsePotion(settingType)
	if settingType == Constant.SETTINGS_TYPES.SLAYER_HP or
		settingType == Constant.SETTINGS_TYPES.VAMPIRE_HP or
		settingType == Constant.SETTINGS_TYPES.OUSTERS_HP then
		local editTable = self:getEditConfByIndex(settingType)
		if editTable and editTable.switch == 1 then
			self._potionHp = {}
			self._potionHp.itemId = editTable.selectId
			self._potionHp.limited = editTable.value/100
			local itemMeta = CacheManager:getItemMeta(editTable.selectId)
			self._potionHp.interval = itemMeta:getPotionTime()
			self._potionHp.cd = itemMeta:getPotionTime()
		else
			self._potionHp = nil
		end

		local editTable = self:getEditConfByIndex(settingType)
		if editTable and editTable.isAutoBuy == 1 then
			self._potionHpAutoBuy = {}
			self._potionHpAutoBuy.itemId = editTable.selectId
			self._potionHpAutoBuy.isAutoBuy = editTable.isAutoBuy
			self._potionHpAutoBuy.autoBuyCount = editTable.autoBuyCount
		else
			self._potionHpAutoBuy = nil
		end
	elseif settingType == Constant.SETTINGS_TYPES.SLAYER_MP or
			settingType == Constant.SETTINGS_TYPES.OUSTERS_EP then
		local editTable = self:getEditConfByIndex(settingType)
		if editTable and editTable.switch == 1 then
			self._potionMp = {}
			self._potionMp.itemId = editTable.selectId
			self._potionMp.limited = editTable.value/100
			local itemMeta = CacheManager:getItemMeta(editTable.selectId)
			self._potionMp.interval = itemMeta:getPotionTime()
			self._potionMp.cd = itemMeta:getPotionTime()
		else
			self._potionMp = nil
		end

		local editTable = self:getEditConfByIndex(settingType)
		if editTable and editTable.isAutoBuy == 1 then
			self._potionMpAutoBuy = {}
			self._potionMpAutoBuy.itemId = editTable.selectId
			self._potionMpAutoBuy.isAutoBuy = editTable.isAutoBuy
			self._potionMpAutoBuy.autoBuyCount = editTable.autoBuyCount
		else
			self._potionMpAutoBuy = nil
		end
	end
end

-- 更新自动使用药品
function AutoFightManager:onUpdateAutoPotion(dt, heroAgent)
	if not heroAgent then
		return
	end

	local heroData = heroAgent:getHeroData()
	if not heroData then
		return
	end

	--1秒检测一次
	if self._autoCheckPotionTimer < 1 then
		self._autoCheckPotionTimer = self._autoCheckPotionTimer + dt
		return
	end
	self._autoCheckPotionTimer = 0

	-- FIXME delay 需要增加开关，在血量变化的时候才去检测
	if self._potionHp and self._potionHp.itemId then
		if self._potionHp.cd < self._potionHp.interval then
			self._potionHp.cd = self._potionHp.cd + 1
		end
		local hpPercent = heroData:getHpPercentReal()
		if hpPercent < self._potionHp.limited then
			local itemId = self._potionHp.itemId
			local item = ItemModule:getItemByItemId(itemId, Constant.ItemType.ITEM_TYPE_PROP)
			if item then
				if self._potionHp.cd >= self._potionHp.interval then
					self._potionHp.cd = 0
					ItemModule:sendUseItem(item:getObjId())
				end
			end
		elseif hpPercent == 1 then
			self._potionHp.cd = self._potionHp.interval
		end
	end

	if self._potionMp and self._potionMp.itemId then
		if self._potionMp.cd < self._potionMp.interval then
			self._potionMp.cd = self._potionMp.cd + 1
		end
		local mpPercent = heroData:getMpPercent()
		if mpPercent < self._potionMp.limited then
			local itemId = self._potionMp.itemId
			local item = ItemModule:getItemByItemId(itemId, Constant.ItemType.ITEM_TYPE_PROP)
			if item then
				if self._potionMp.cd >= self._potionMp.interval then
					self._potionMp.cd = 0
					ItemModule:sendUseItem(item:getObjId())
				end
			end
		elseif mpPercent == 1 then
			self._potionMp.cd = self._potionMp.interval
		end
	end
end


function AutoFightManager:onUpdateAutoBuy(dt, heroAgent)
	if not heroAgent then
		return
	end

	--10秒检测一次
	if self._autoCheckAutoBuyTimer < 10 then
		self._autoCheckAutoBuyTimer = self._autoCheckAutoBuyTimer + dt
		return
	end
	self._autoCheckAutoBuyTimer = 0
	local function onAutoBuy(config)
		if not config or not config.itemId then return end

		local itemId = config.itemId
		local count = tonumber(config.autoBuyCount)
		local item = ItemModule:getItemByItemId(itemId, Constant.ItemType.ITEM_TYPE_PROP)
		if item then return end  -- 有货就不买
		
		local meta = lt.VipModule:getCurVipMeta()
		if not meta or meta:getAutoMedication() ~= 1 then
			return
		end
		local itemMeta = ItemModule:getItemMetaByItemId(Constant.ItemType.ITEM_TYPE_PROP, itemId)
		if not itemMeta then return end

		local access = itemMeta:getAccess()
		for i,v in ipairs(access or {}) do
			local type = tonumber(v[1])
			if type == Constant.PROPTIPS_ACCESS.SHOP then
				lt.RechargeModule:autoBuyByShopId(v[2], count)
				break  -- 防止重复购买
			end
		end
	end

	onAutoBuy(self._potionHpAutoBuy)
	onAutoBuy(self._potionMpAutoBuy)
end


--自动加弹药
function AutoFightManager:onUpdateAutoBullet(dt, heroAgent)
	if not heroAgent then
		return
	end

	if self._autoCheckBulletTimer < 5 then
		self._autoCheckBulletTimer = self._autoCheckBulletTimer + dt
		return
	end

	local gunEquip = ItemModule:getEquipGun()
	if not gunEquip then return end

	if gunEquip:getAmmoCount() > 0 then
		return
	end

	local isAdd = ItemModule:autoAddBullet()
	--5秒内不再检测
	if not isAdd then
		self._autoCheckBulletTimer = 0
	else
		self._autoCheckBulletTimer = 0
		self._isAddBullet = true
		-- heroAgent:onMessage({msgId = Constant.MSG_ROUTE_STOP})
		self:stopAutoRoute(heroAgent)
	end
end

