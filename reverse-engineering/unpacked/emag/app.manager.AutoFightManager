--获得地图里有效的随机点
function AutoFightManager:getRandomPos(heroAgent)
	local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
	local mapData = mapAgent:getMapData()
    local mCount = mapData:getMCount()
    local nCount = mapData:getNCount()
	-- local m, n = heroAgent:getMNExactly()
	-- local mMin = m - 10
	-- local mMax = m + 10
	-- local nMin = n - 10
	-- local nMax = n + 10
	-- --寻路终点避开边界五格
	-- local border = 5
	-- mMin = mMin <= border and border or mMin
	-- mMax = mMax >= mCount - border and mCount - border or mMax
	-- nMin = nMin <= border and border or nMin
	-- nMax = nMax >= nCount - border and nCount or nMax
    -- local x = math.random(mMin, mMax)
    -- local y = math.random(nMin, nMax)
	local x = math.random(1, mCount)
	local y = math.random(1, nCount)
    if mapAgent and (mapAgent:isBlocked(x, y) or mapAgent:isTrans(x, y)) then
        return self:getRandomPos(heroAgent)
    end
    return x, y
end

