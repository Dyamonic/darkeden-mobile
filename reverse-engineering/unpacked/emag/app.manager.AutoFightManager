--重载设置
function AutoFightManager:reloadConfig(roleId, race)
	self:setRace(race)
	self._configMap = {}
	self:reloadSettingConfig(roleId)
	self:reloadPostionConfig()
end

function AutoFightManager:reloadSettingConfig(roleId)
	local config = {}
    local dataString = cc.UserDefault:getInstance():getStringForKey("Save_Common_Edit_Of_Settings" .. roleId, "{}")
    if dataString == "{}" then
		--初始化
        self:setDefaultConf()
		return
	end
	config = json.decode(dataString)
	--对新的设置选项进行赋初值
	self:compareDefaultConf(config)
end

function AutoFightManager:setDefaultConf()
    local config = {}
    local settingMeta = CacheManager:getAllSettingMeta()
    for index, meta in pairs(settingMeta) do
        if meta:getOccupation() == 0 or meta:getOccupation() == self:getRace() then
            local editTable = {}
            if meta:getSettingClass() == Constant.COMPONENT_TYPES.TYPE1 then
                editTable.value = meta:getDefaultValue()
                editTable.switch = meta:getDefaultSwitch()
                editTable.selectId = meta:getSettingList()[1][2]
				editTable.isAutoBuy = meta:getDefaultSelect()
                editTable.autoBuyCount = meta:getDefaultInputValue()
            elseif meta:getSettingClass() == Constant.COMPONENT_TYPES.TYPE2 then
                editTable.value = meta:getDefaultValue()
            elseif meta:getSettingClass() == Constant.COMPONENT_TYPES.TYPE3 then
                editTable.switch = meta:getDefaultSwitch()
            elseif meta:getSettingClass() == Constant.COMPONENT_TYPES.TYPE4
			or meta:getSettingClass() == Constant.COMPONENT_TYPES.TYPE6 then
                editTable.value = meta:getDefaultValue()
            elseif meta:getSettingClass() == Constant.COMPONENT_TYPES.TYPE5 then
                editTable.value = meta:getDefaultValue()
                editTable.switch = meta:getDefaultSwitch()
            end
            config[tostring(index)] = editTable
        end
    end
	self._configMap[SETTINGS_TYPE.SYSTEM] = config
end

function AutoFightManager:compareDefaultConf(config)
	local settingMeta = CacheManager:getAllSettingMeta()
	for index, meta in pairs(settingMeta) do
        if meta:getOccupation() == 0 or meta:getOccupation() == self:getRace() then
			if not config[tostring(index)] then
				local editTable = {}
				if meta:getSettingClass() == Constant.COMPONENT_TYPES.TYPE1 then
					editTable.value = meta:getDefaultValue()
					editTable.switch = meta:getDefaultSwitch()
					editTable.selectId = meta:getSettingList()[1][2]
					editTable.isAutoBuy = meta:getDefaultSelect()
					editTable.autoBuyCount = meta:getDefaultInputValue()
				elseif meta:getSettingClass() == Constant.COMPONENT_TYPES.TYPE2 then
					editTable.value = meta:getDefaultValue()
				elseif meta:getSettingClass() == Constant.COMPONENT_TYPES.TYPE3 then
					editTable.switch = meta:getDefaultSwitch()
				elseif meta:getSettingClass() == Constant.COMPONENT_TYPES.TYPE4
				or meta:getSettingClass() == Constant.COMPONENT_TYPES.TYPE6 then
					editTable.value = meta:getDefaultValue()
				elseif meta:getSettingClass() == Constant.COMPONENT_TYPES.TYPE5 then
					editTable.value = meta:getDefaultValue()
					editTable.switch = meta:getDefaultSwitch()
				end
				config[tostring(index)] = editTable
			end
        end
    end
	self._configMap[SETTINGS_TYPE.SYSTEM] = config
end

function AutoFightManager:setEditConfByIndex(index, key, value)
    if self._configMap[SETTINGS_TYPE.SYSTEM][tostring(index)] then
        self._configMap[SETTINGS_TYPE.SYSTEM][tostring(index)][key] = value
    end
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_CHANGE_SETTINGS, {index = index})
end

function AutoFightManager:getEditConfByIndex(index)
	if not self._configMap then
		return {}
	end
    return self._configMap[SETTINGS_TYPE.SYSTEM][tostring(index)] or {}
end

function AutoFightManager:saveEditConf(roleId)
    local dataString = json.encode(self._configMap[SETTINGS_TYPE.SYSTEM])
    cc.UserDefault:getInstance():setStringForKey("Save_Common_Edit_Of_Settings" .. roleId, dataString)
    cc.UserDefault:getInstance():flush()
end

-- 左侧屏幕边缘偏移
function AutoFightManager:refreshLeftUIOffset(uiTable,parent,index)
    local editTable = AutoFightManager:getEditConfByIndex(index) or {}
    local value = editTable.value or 0

    for _, v in ipairs(uiTable) do
        local ui = parent:getChild(v)
        if ui then
            local pos = ui:getPosition()
            ui:setPosition(value,pos.y)
        end
    end
end

-- 左侧屏幕边缘偏移
function AutoFightManager:refreshLeftInnerUIOffset(uiTable,parent,index)
    local editTable = AutoFightManager:getEditConfByIndex(index) or {}
    local value = editTable.value or 0

    for k, v in pairs(uiTable) do
        local ui = parent:getChild(k)
        if ui then
            local pos = ui:getPosition()
            ui:setPosition(v+value,pos.y)
        end
    end
end

-- 右侧屏幕边缘偏移
function AutoFightManager:refreshRightUIOffset(uiTable,parent,index)
    local editTable = AutoFightManager:getEditConfByIndex(index) or {}
    local value = editTable.value or 0

    local visibleSize = cc.Director:getInstance():getVisibleSize()
    for _, v in ipairs(uiTable) do
        local ui = parent:getChild(v)
        if ui then
            local pos = ui:getPosition()
            ui:setPosition(visibleSize.width-value,pos.y)
        end
    end
end

function AutoFightManager:getEditConfOffsetValue()
	local rightEditTable = lt.AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.RIGHT_OFFSET) or {}
    local rightValue = rightEditTable.value or 0
    local leftEditTable = lt.AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.LEFT_OFFSET) or {}
    local leftValue = leftEditTable.value or 0
    local offsetValue = (-rightValue + leftValue) / 2

	return offsetValue
end

--ping值
function AutoFightManager:getPingValueOpen()
	local editTable = self:getEditConfByIndex(Constant.SETTINGS_TYPES.SHOW_PING)
	return editTable.switch == 1
end

