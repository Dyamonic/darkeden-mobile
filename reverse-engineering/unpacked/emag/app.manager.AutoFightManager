local AutoFightManager = {}

local Constant = lt.Constant
local GameModule = lt.GameModule
local ItemModule = lt.ItemModule
local SkillModule = lt.SkillModule
local MonsterModule = lt.MonsterModule
local CacheManager = lt.CacheManager
local SocketManager = lt.SocketManager
local NtfManager = lt.NtfManager
local SkillEnum = lt.SkillEnum
local BuffEnum = lt.BuffEnum

AutoFightManager._oldAuto = false		--断线前是否处于自动战斗状态
AutoFightManager._isAuto = false		--是否处于自动战斗模式
AutoFightManager._isSearch = false		--是否处于自动索敌状态中
AutoFightManager._isPickUp = false		--是否处于自动拾物状态中
AutoFightManager._isStopPickUp = false	--是否停止自动拾物
AutoFightManager._isAutoSkill = false	--是否处于自动释放技能中
AutoFightManager._canAuto = true		--是否可以执行自动战斗(因为外部点击技能会夺取控制权)
AutoFightManager._isAddBullet = false	--是否处于自动装弹状态中
AutoFightManager._randomPoint = nil		--是否在随机寻路
AutoFightManager._searchStep = nil		--自动寻路的格子数
AutoFightManager._absorbSoul = false	--是否可以自动灵魂吸收

AutoFightManager._autoCheckPotionTimer = 0
AutoFightManager._autoCheckFightTimer = 0.5
AutoFightManager._autoCheckBulletTimer = 5
AutoFightManager._autoCheckSearchTimer = 0
AutoFightManager._autoCheckAutoBuyTimer    = 0

local Distance1 = 3					--怪物检测范围1(目标选择)
local Distance2 = 12				--怪物检测范围2(目标选择)
local AreaDistance = 2				--怪物附近检测范围(单体群体)
local MaxRepeat = 99				--最大连击数
local TotalTime = 60				--在寻路状态的最大时间
local NormalSpeed = 0.5				--自动战斗正常速度


local SETTINGS_TYPE = {
	SYSTEM = "SYSTEM", --系统设置
}

function AutoFightManager:init()
	self:reset()
	self:setWorldAgent(lt.AgentManager:getWorldAgent())
	NtfManager:addNtfListener(NtfManager.NTF.NTF_STOP_AUTO_ROUTE, handler(self, self.onStopAutoRoute), "AutoFightManager:onStopAutoRoute")
end

function AutoFightManager:clear()
	NtfManager:removeNtfListenerByTag("AutoFightManager:onStopAutoRoute")
	self._isAuto = nil
	self._isSearch = nil
	self._isPickUp = nil
	self._isStopPickUp = nil
	self._isAutoSkill = nil
	self._isAddBullet = nil
	self._canAuto = nil
	self._worldAgent = nil
	self._randomPoint = nil
	self._searchStep = nil
	self._absorbSoul = nil
	self._targetPosX = nil
	self._targetPosY = nil
	self._race = nil
	self._potionHp = nil
	self._potionMp = nil
	self._potionHpAutoBuy = nil  -- 自动购买
	self._potionMpAutoBuy = nil  -- 自动购买
end

function AutoFightManager:reset()
	self._isAuto = false
	self._isSearch = false
	self._isPickUp = false
	self._isStopPickUp = false
	self._isAutoSkill = false
	self._isAddBullet = false
	self._canAuto = true
	self._autoCheckPotionTimer = 0
	self._autoCheckFightTimer = 0.5
	self._autoCheckBulletTimer = 5
	self._autoCheckSearchTimer = 0
	self._autoCheckAutoBuyTimer = 0
	self._randomPoint = false
	self._searchStep = 0
	self._absorbSoul = false
	self._targetPosX = nil
	self._targetPosY = nil
end

---------------------------自动战斗------------------------------
function AutoFightManager:onUpdate(dt, heroAgent)
	-- 网络有问题 暂停处理
	if not SocketManager:isAlive() then
		return
	end

	if not heroAgent then
		return
	end

	--自动检测药水使用
	self:onUpdateAutoPotion(dt, heroAgent)
	--自动加弹药
	self:onUpdateAutoBullet(dt, heroAgent)
	--自动战斗检测
	self:onUpdateAutoFight(dt, heroAgent)
	--自动买药
	self:onUpdateAutoBuy(dt, heroAgent)
end

--[[_
	longPress
	cd 普攻检测 -> 释放
	释放列表 nextskill
]]
function AutoFightManager:onUpdateAutoFight(dt, heroAgent)
	--不是自动战斗状态
	if not self:isAuto() then return end

	--是否可以执行自动战斗
	if not self._canAuto then return end

	--在自动释放技能
	if self._isAutoSkill then return end

	--在自动拾物状态
	if self._isPickUp then return end

	--无法移动
	if not heroAgent:canMove() then return end

	--0.5秒检测一次
	if self._autoCheckFightTimer < NormalSpeed then
		self._autoCheckFightTimer = self._autoCheckFightTimer + dt
		return
	end
	self._autoCheckFightTimer = 0

	--非鬼族检测回血技能
	if self:checkHealSkill(heroAgent) then return end

	--检测增益技能
	if self:checkBuffSkill(heroAgent) then return end

	--[[ 战斗检测 ]]
	-- 自动装弹状态
	if self._isAddBullet then return end

	--在自动索敌状态
	if self._isSearch then
		-- if self._randomPoint then
		-- 	self._autoCheckSearchTimer = self._autoCheckSearchTimer + 0.5
		-- 	if self._autoCheckSearchTimer >= TotalTime then
		-- 		self._autoCheckSearchTimer = 0
		-- 		--寻找地图中怪物坐标
		-- 		GameModule:sendSearchMonster()
		-- 	end
		-- end
		return
	end

	--判断灵魂吸收
	if self._absorbSoul then
		self._absorbSoul = false
		if self:checkOustersSkill(heroAgent) then
			return
		end
	end
	
	--3格周围有怪物(打怪)
	local nearestMonster1, nearestMonster2 = self:checkAroundMonster(heroAgent)
	local isArea = self:checkHasMonster(heroAgent, nearestMonster1)
	if isArea ~= nil then
		-- aoe 技能自动施法
		if self:checkFightSkill(heroAgent, isArea) then
			-- self:resetSearchTime()
			return
		end
	end

	--没怪检测脚下是否有物品和尸体
	if self:checkAutoItem(heroAgent) then
		-- self:resetSearchTime()
		return
	end

	--检测12格内有没有物品和尸体
	if self:checkNearbyItem(heroAgent) then
		-- self:resetSearchTime()
		return
	end
	
	--12格周围有怪物(打怪)
	isArea = self:checkHasMonster(heroAgent, nearestMonster2)
	if isArea ~= nil then
		if self:checkFightSkill(heroAgent, isArea) then
			-- self:resetSearchTime()
			return
		end
	end

	-- 自动寻路到随机点
	self:moveRandomPoint(heroAgent)
end

function AutoFightManager:checkNextSkill(heroAgent)
	--不是自动战斗状态
	if not self:isAuto() then return end

	--是否可以执行自动战斗
	if not self._canAuto then return end

	--无法移动
	if not heroAgent:canMove() then return end

	--非鬼族检测回血技能
	if self:checkHealSkill(heroAgent) then return end

	--检测增益技能
	if self:checkBuffSkill(heroAgent) then return end

	--判断灵魂吸收
	if self._absorbSoul then
		self._absorbSoul = false
		if self:checkOustersSkill(heroAgent) then
			return
		end
	end

	--3格周围有怪物(打怪)
	local nearestMonster1, nearestMonster2 = self:checkAroundMonster(heroAgent)
	local isArea = self:checkHasMonster(heroAgent, nearestMonster1)
	if isArea ~= nil then
		-- aoe 技能自动施法
		if self:checkFightSkill(heroAgent, isArea) then
			-- self:resetSearchTime()
			return
		end
	end
end

--检测回血技能
function AutoFightManager:checkHealSkill(heroAgent)
	-- 非鬼族检测回血技能
	if self:getRace() == Constant.RaceType.Vampire then
		return false
	end

	--在安全区里不战斗
	if heroAgent:isInSafeArea() ~= nil then
        return false
    end

	local autoSkillList = {}
	local heroData = heroAgent:getHeroData()
	local healSkills = SkillModule:getAutoHealSkills()
	--配置了回血技能
	if #healSkills > 0 then
		--血量小于30%自定释放回血技能
		local hpPercent = heroData:getHpPercent()
		if hpPercent < 0.3 then
			for k, v in ipairs(healSkills) do
				table.insert(autoSkillList, v)
			end
		end
	end

	if #autoSkillList > 0 then
		local canUse = self:playAutoSkill(heroAgent, autoSkillList, true)
		return canUse
	end

	return false
end

--检测增益技能
function AutoFightManager:checkBuffSkill(heroAgent)
	--在安全区里不战斗
	if heroAgent:isInSafeArea() ~= nil then
        return false
    end

	local autoSkillList = {}
	local buffSkills = SkillModule:getAutoBuffSkills()
	for k, v in pairs(buffSkills) do
		--检测身上是否还有buff
		if not heroAgent:hasBuffer(v) then
			table.insert(autoSkillList, k)
		end
	end

	if #autoSkillList > 0 then
		local canUse = self:playAutoSkill(heroAgent, autoSkillList, true)
		return canUse
	end

	return false
end

-- 检测战斗技能
function AutoFightManager:checkFightSkill(heroAgent, isArea)
	--在安全区里不战斗
	if heroAgent:isInSafeArea() ~= nil then
        return false
    end

	local autoSkillList = {}

	--鬼族判断能否吸血(敌方血量小于30%)
	if self:getRace() == Constant.RaceType.Vampire and self:checkVampireSkill(heroAgent) then
		table.insert(autoSkillList, SkillEnum.SKILL_BLOOD_DRAIN)
	end
	
	--检测其他战斗技能
	if isArea then
		--怪大于等于3个先检测群体技能
		local areaSkills = SkillModule:getAutoAreaSkills()
		for k, v in ipairs(areaSkills) do
			table.insert(autoSkillList, v)
		end
	end

	--再检测单体技能
	local singleSkills = SkillModule:getAutoSingleSkills()
	for k, v in ipairs(singleSkills) do
		table.insert(autoSkillList, v)
	end

	--最后检测普攻
    local normalSkill = SkillModule:getNoramlSkillId()
    table.insert(autoSkillList, normalSkill)

	if #autoSkillList > 0 then
		local canUse = self:playAutoSkill(heroAgent, autoSkillList, false)
		return canUse
	end
end

--鬼族判断能否吸血(敌方血量小于30%)
function AutoFightManager:checkVampireSkill(heroAgent)
	if not heroAgent then return false end

	local targetAgent = heroAgent:getTargetAgent()
	if targetAgent then
		if SkillModule:hasBloodDrain() then
			local hpPercent = targetAgent:getHeroData():getHpPercent()
			local hasBuffer = targetAgent:hasBuffer(BuffEnum.EFFECT_CLASS_BLOOD_DRAIN) or targetAgent:hasBuffer(BuffEnum.EFFECT_MMUNE_TO_BLOOD_DRAIN)
			if not hasBuffer and hpPercent < 1/3 then
				return true
			end
		end
	end
	return false
end

--魔族判断能否吸蓝(自身蓝量<=100%)
function AutoFightManager:checkOustersSkill(heroAgent)
	if not heroAgent then return false end
	if self:getRace() ~= Constant.RaceType.Ousters then return false end

	if SkillModule:hasAbsorbSoul() then
		local mpPercent = heroAgent:getHeroData():getMpPercent()
		if mpPercent <= 1 then
			--判断周围两格是否有尸体
			local monster = heroAgent:getMonsterBody(true)
			if monster then
				local canUse = self:playAutoSkill(heroAgent, {SkillEnum.SKILL_ABSORB_SOUL}, false)
				return canUse
			end
		end
	end
	return false
end

--检测周围怪物数量
function AutoFightManager:checkAroundMonster(heroAgent)
	local targetAgent = heroAgent:getTargetAgent()
	--优先返回自己选中的怪物
	if targetAgent and targetAgent:isMonsterAgent() and targetAgent:getMasterObjId() == 0 then
		local data  = targetAgent:getMonsterData()
		if data and data:getCurHp() > 0 then
			return targetAgent, targetAgent
		else
			-- 切换目标
			if data and data:isAlive() then
				-- 上传bugly 日志
				if buglyReportLuaException then
					local m, n = targetAgent:getMNExactly()
					local msgLog = string.format("title: \n          agentId:%s \n          objId:%s \n          m:%s \n          n:%s", targetAgent:getAgentId(), data:getObjId(), m, n)
					buglyReportLuaException("BUGLY LOG: AutoFightManager:checkHasMonster", msgLog)
				end
			end
		end
	end

	local worldAgent = self:getWorldAgent()
	local nearestMonster1, nearestMonster2 = worldAgent:getNearestMonster(Distance1, Distance2)
	return nearestMonster1, nearestMonster2
end

--检测是否有怪(需要单体群体)
function AutoFightManager:checkHasMonster(heroAgent, nearestMonster)
	if nearestMonster then	--选中最近的怪
		heroAgent:setTargetAgentId(nearestMonster:getAgentId())
		--取怪附近是否大于等于3只怪
		local worldAgent = self:getWorldAgent()
		local needAreaSkill = worldAgent:getAroundMonster(nearestMonster, AreaDistance, 3)
		return needAreaSkill
	end
	return nil
end

--检测技能列表里的技能是否能使用
function AutoFightManager:playAutoSkill(heroAgent, autoSkillList, isSelf)
	local skillId = nil

    for _, v in ipairs(autoSkillList) do
		if heroAgent:checkPlaySkillBaseCondition(v) then
            skillId = v
            break
		end
    end

	-- yflog:Info("AutoFightManager:playAutoSkill #autoSkillList:%s skillId:%s", #autoSkillList, skillId)
    if skillId then
		-- 先打断自动索敌
		-- heroAgent:onMessage({msgId = Constant.MSG_ROUTE_STOP})
		self:stopAutoRoute(heroAgent)

		if isSelf then
			--如果是治疗和增益选中自己
			-- heroAgent:setTargetAgentId(heroAgent:getAgentId())
		else
			if skillId ~= SkillEnum.SKILL_BLOOD_DRAIN and skillId ~= SkillEnum.SKILL_ABSORB_SOUL then
				--伤害类技能放完后，下一个技能优先级最高
				local skillCfg = CacheManager:querySkillMeta(skillId)
				if skillCfg:getIndividualOrGroup() == 2 then
					SkillModule:nextAutoAreaSkills(skillId)
				else
					SkillModule:nextAutoSingleSkills(skillId)
				end
			elseif skillId == SkillEnum.SKILL_ABSORB_SOUL then
				heroAgent:setTargetAgentId(nil)
			end
		end

		--连击技能段数计算
		self:checkComboSkill(heroAgent, skillId)

		--使用技能
		heroAgent:addSelfSkillId(skillId)
		return true
    end
	return false
end

--检测是否为连击技能
function AutoFightManager:checkComboSkill(heroAgent, skillId)
	--先清连击
	heroAgent:clearShotTime()
	local shotRepeatSkill = SkillEnum.GUN_SHOT_SKILL_REPEATED_TIMES_TABLE[skillId]
	local isRepeat = shotRepeatSkill and (shotRepeatSkill == -1 or shotRepeatSkill > 1)
	if isRepeat then
		if SkillEnum.GUN_SHOT_SKILL_ID_TABLE[skillId] then
			--如果是枪技能(走子弹那套)
			local bulletNum = SkillModule:getBulletNum()
			if shotRepeatSkill == -1 then
				shotRepeatSkill = bulletNum
			else
				shotRepeatSkill = math.min(bulletNum, shotRepeatSkill)
			end
		else
			--如果是别的技能(最大上限设置为99)
			if shotRepeatSkill == -1 then
				shotRepeatSkill = MaxRepeat
			end
		end

		--添加连击
		for i = 1, shotRepeatSkill do
			heroAgent:addShotTime()
		end
	end
end

--获得是否自动战斗时开启自动拾取
function AutoFightManager:getAutoPickUp()
	local editTable = self:getEditConfByIndex(Constant.SETTINGS_TYPES.AUTO_PICKUP)
	return editTable.switch == 1
end


--检测拾取物品
function AutoFightManager:checkAutoItem(heroAgent)
	if not self:getAutoPickUp() then
		return false
	end
	--获取地格所能拾取的物品和尸体
	local agent = GameModule:checkCurDropAndBodyGridMap()
	if agent then
		self:setPickUp(true)
		if agent:isItemAgent() then
			--检查有没有停止拾取
			if self._isStopPickUp then
				self:setPickUp(false)
				return false
			end
			--发送捡东西
			heroAgent:pickUpDrop(agent)
		else
			--发送挖掘尸体
			MonsterModule:sendDigCorpse(agent)
		end
		return true
	end
	return false
end

--判断附近有没有没拾取的物品或者尸体
function AutoFightManager:checkNearbyItem(heroAgent)
	if not self:getAutoPickUp() then
		return false
	end
	local worldAgent = self:getWorldAgent()
	local agent = worldAgent:getAroundDig(heroAgent)
	if agent and (agent:isMonsterAgent() or (agent:isItemAgent() and not self._isStopPickUp)) then
		local m1, n1 = heroAgent:getMNExactly()
		local m2, n2 = agent:getMN()
		local route = lt.MapUtil:route(m1, n1, m2, n2)
		if route then
			NtfManager:dispatchNtf(NtfManager.NTF.NTF_MINIMAP_ROUTE_POS,{posx = m2, posy = n2})
			return true
		end
	end
	return false
end

--随机寻路到地图中的一个合法点
function AutoFightManager:moveRandomPoint(heroAgent)
	local m1, n1 = heroAgent:getMNExactly()
	if self._targetPosX and self._targetPosY then
		local route = lt.MapUtil:route(m1, n1, self._targetPosX, self._targetPosY)
		if route then
			NtfManager:dispatchNtf(NtfManager.NTF.NTF_MINIMAP_ROUTE_POS,{posx = self._targetPosX, posy = self._targetPosY})
			self:resetSearchTime()
		end
	else
		local x, y = self:getRandomPos(heroAgent)
		local route = lt.MapUtil:route(m1, n1, x, y)
		if route then
			self._randomPoint = true
			NtfManager:dispatchNtf(NtfManager.NTF.NTF_MINIMAP_ROUTE_POS,{posx = x, posy = y})
		end
	end
end

--记录一个最近的怪物地点xy
function AutoFightManager:setSearchTarget(x, y)
	self._targetPosX = x
	self._targetPosY = y
end

--重置搜索时间
function AutoFightManager:resetSearchTime()
	self._autoCheckSearchTimer = 0
	self:setSearchTarget(nil, nil)
end

--增加自动寻路走的格子数
function AutoFightManager:addAutoSearchStep(heroAgent)
	if not heroAgent then
		return
	end
	--在安全区里不检测
	if heroAgent:isInSafeArea() then
        return
    end
	if self:isAuto() and self._randomPoint then
		self._searchStep = self._searchStep + 1
		if self._searchStep == 3 then
			local worldAgent = self:getWorldAgent()
			local nearestMonster = worldAgent:getNearestMonster(Distance2)
			self._searchStep = 0
			if nearestMonster then
				heroAgent:setTargetAgentId(nearestMonster:getAgentId())
				self:setSearch(false)
			end
		end
	end
end

--开始挂机
function AutoFightManager:startAutoFight(noAnim)
	if self:isAuto() then
		self:endAutoFight()
		return
	end
	local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
	if not heroAgent then
		return
	end
	if not heroAgent:isAlive() then
		return
	end
	--暂停之前的寻路
	self:stopAutoRoute(heroAgent)
	
    self._isAuto = true
	self._canAuto = true
	NtfManager:dispatchNtf(NtfManager.NTF.NTF_AUTOFIGHT_START, {noAnim = noAnim})
end

--结束挂机
function AutoFightManager:endAutoFight(noAnim)
	if not self:isAuto() then
		return
	end
	local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
	if heroAgent then
		heroAgent:clearShotTime()
		-- heroAgent:onMessage({msgId = Constant.MSG_ROUTE_STOP})
		self:stopAutoRoute(heroAgent)
		
		heroAgent:clearSelfSkillId()
    	heroAgent:setAutoSkill(false)
	end
	self:reset()
	NtfManager:dispatchNtf(NtfManager.NTF.NTF_AUTOFIGHT_END, {noAnim = noAnim})
end

