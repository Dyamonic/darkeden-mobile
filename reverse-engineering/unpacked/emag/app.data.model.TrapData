
local TrapData = class("TrapData")
--[[
    陷阱 data
]]
local CacheManager = lt.CacheManager
local ServerClientEnum = lt.ServerClientEnum
local Constant = lt.Constant
local FloorObjDataDef = ServerClientEnum.FloorObjDataDef

TrapData._objId       = nil
TrapData._objType     = nil
TrapData._subObjType     = nil
TrapData._skillId     = nil
TrapData._skillLevel  = nil
TrapData._groundIndex = nil
TrapData._name = nil --显示的名称
TrapData._auther = nil --路牌作者名字
TrapData._isVisible = 0 -- 是否可见
TrapData._itemId = 0   -- 物品id
TrapData._isReplace = 0 --是否覆盖
TrapData._targetId = nil --针对的目标ID
TrapData._clientObjId = nil
TrapData._isSlowDown = nil --是否减速
TrapData._diappearTime = nil --消失时间


function TrapData:ctor(objId, propertyArray)
    self._objId = objId
    for _, v in ipairs(propertyArray) do
        self:setValue(v.properCode, v.intValue, v.strValue)
    end
end

function TrapData:setValue(key, value, strValue)
    if FloorObjDataDef.Attr_FLOOROBJ_SKILLID == key then
        self._skillId = value
    elseif FloorObjDataDef.Attr_FLOOROBJ_LEVEL == key then
        self._skillLevel = value
    elseif FloorObjDataDef.Attr_FLOOROBJ_MERCY_GROUND_INDEX == key then
        self._groundIndex = value
    elseif ServerClientEnum.ObjectValueDef.Attr_SubObjType == key then
        self._subObjType = value
    elseif ServerClientEnum.ObjectValueDef.Attr_DisplayName == key then --显示的名称
        self._name = strValue
    elseif FloorObjDataDef.Attr_FLOOROBT_CUSTOMIZE_TEXT_AUTHOR == key then--路牌作者名字
        self._auther = strValue
    elseif FloorObjDataDef.ATTR_FLOOROBJ_VISIBLE == key then--是否可见
        self._isVisible = value
    -- elseif FloorObjDataDef.ATTR_FLOOROBJ_IS_REPLACED == key then--是否覆盖
    --     self._isReplace = value
    elseif FloorObjDataDef.ATTR_FLOOROBJ_ATTACK_TARGET_ID == key then -- 攻击目标ID 
        self._targetId = value
    elseif FloorObjDataDef.ATTR_FLOOROBJ_ITEMID == key then--物品ID
        self._itemId = value
    elseif FloorObjDataDef.ATTR_FLOOROBJ_IS_REPLACED == key then--是否覆盖
        self._isReplace = value
    elseif FloorObjDataDef.ATTR_FLOOROBJ_ATTACK_SLOW_DOWN == key then--是减速
        self._isSlowDown = value
    elseif FloorObjDataDef.ATTR_FLOOROBJ_DRAGON_TORNADO_PARENT == key then--巨龙卷风
        self._isTornadoParent = value
    elseif ServerClientEnum.ObjectValueDef.Attr_DisappearTime == key then --消失时间
        self._diappearTime = value
    end
end

function TrapData:getValue(key)
end

-- Setter && Getter
function TrapData:getObjId()
    return self._objId
end

function TrapData:getSkillId()
    return self._skillId
end

function TrapData:getObjType()
    return Constant.ObjType.OBJ_FLOOR
end

function TrapData:getSkillLevel()
    return self._skillLevel
end

function TrapData:getGroundIndex()
    return self._groundIndex
end

-- function TrapData:setGroundIndex(value)
--     self._groundIndex = value
-- end

function TrapData:setMN(m, n)
    self._mTrap, self._nTrap = m, n 
end

function TrapData:getMN()
    return self._mTrap, self._nTrap
end

function TrapData:getSubObjType()
    return self._subObjType
end

function TrapData:getName()
    return self._name
end

function TrapData:getAuther()
    return self._auther
end

function TrapData:isVisible()
    return self._isVisible == 1
end

function TrapData:getItemId()
    return self._itemId
end

function TrapData:isReplace()
    return self._isReplace == 1
end

function TrapData:getTargetId()
   return self._targetId
end
function TrapData:setClientObjId(clientObjId)
    self._clientObjId = clientObjId
end

function TrapData:getClientObjId()
    return self._clientObjId
end

function TrapData:getIsSlowDown()
    return self._isSlowDown
end

function TrapData:getIsTornadoParent()
    return self._isTornadoParent
end

function TrapData:getDisappearTime()
    if self._diappearTime then
        return tonumber(self._diappearTime) / 1000 
    else
        return 0
    end
end

function TrapData:isMoveTrap()
    return self._skillId == lt.SkillEnum.SKILL_DRAGON_TORNADO
end

function TrapData:getMoveSpeed()
    if self._skillId == lt.SkillEnum.SKILL_DRAGON_TORNADO then
       return 50 
    end
    return 100
end

return TrapData
