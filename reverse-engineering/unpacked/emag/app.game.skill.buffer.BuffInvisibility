local BuffInvisibility = class("BuffInvisibility", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum

--[[
    隐身
]]
function BuffInvisibility:ctor(time, actor, skilllevel)    
    BuffInvisibility.super.ctor(self, BuffEnum.EFFECT_CLASS_INVISIBILITY, time, actor)

end

function BuffInvisibility:onClear()
    self._actor:getCreature():setVisible()
    self._actor:getAgent():visibleActor(true)
    BuffInvisibility.super.onClear(self)
end

return BuffInvisibility
