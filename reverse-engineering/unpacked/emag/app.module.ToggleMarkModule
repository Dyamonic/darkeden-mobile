local ToggleMarkModule = {}

local NtfManager          = lt.NtfManager

ToggleMarkModule.TYPE = {
    NORMAL  = 0,            
    DAY     = 1,            --根据自然天重置状态
}

ToggleMarkModule.OPTION = {
    BOOL = 0,               --开关选项, 只有true和false状态
    MUTIL = 1,              --多选项, get会直接返回设置的值
}

function ToggleMarkModule:init()
    local tbName = "ToggleMark"
    local isExist = nil
    lt.DbManager:tableIsExist(tbName, function (exist)
        isExist = exist
    end)
    
    if not isExist then
        lt.DbManager:createTable(string.format("CREATE TABLE %s(account string primary key, key string, value int, type int, time int, def int, option int);", tbName), tbName)
    end

    NtfManager:addNtfListener(NtfManager.NTF.NTF_INIT_HERO_DATA, handler(self, self.loadDbData), "ToggleMarkModule:NTF_INIT_HERO_DATA")
end

function ToggleMarkModule:clear()
    NtfManager:removeNtfListenerByTag("ToggleMarkModule:NTF_INIT_HERO_DATA")
end

function ToggleMarkModule:loadDbData()
    self._toggleList = {}

    local playerId = tostring(lt.GameModule:getHeroData():getPlayerId())

    local db = lt.DbManager:getDefaultDb()
    for row in db:nrows(string.format("SELECT * FROM ToggleMark WHERE account='%s';", playerId)) do
        local value = row.value
        local default = row.def
        if row.option == ToggleMarkModule.OPTION.BOOL then
            value = self:n2b(value)
            default = self:n2b(default)
        end
        self._toggleList[row.key] = { value = value, type = row.type, time = row.time, default = default, option = row.option } 
    end
end

function ToggleMarkModule:get(key, default, param)
    param = param or {}

    if not self._toggleList[key] then
        self:set(key, default, param.type, param.option)
    else
        self:testDay(key)
    end

    return self._toggleList[key].value
end

function ToggleMarkModule:set(key, value, tType, option)
    tType  = tType or ToggleMarkModule.TYPE.NORMAL
    option = option or ToggleMarkModule.OPTION.BOOL

    if not self._toggleList[key] then
        self._toggleList[key] = {}
        self._toggleList[key].default = value
        self._toggleList[key].type    = tType
        self._toggleList[key].option  = option
        self._toggleList[key].time    = 0
    end

    self._toggleList[key].value = value

    if tType == ToggleMarkModule.TYPE.DAY then 
        self._toggleList[key].time = lt.TimeCounter:zeroTimeStamp()
    end

    self:saveDbData(key)
end

function ToggleMarkModule:saveDbData(key)
    local playerId = tostring(lt.GameModule:getHeroData():getPlayerId())
    local tbName = "ToggleMark"

    local ret = false
    local db = lt.DbManager:getDefaultDb()
    for row in db:nrows(string.format("SELECT * FROM %s WHERE account='%s' AND key='%s';", tbName, playerId, key)) do
        ret = true
        break
    end
    
    local data = self._toggleList[key]
    local value = data.value
    local default = data.default
    if data.option == ToggleMarkModule.OPTION.BOOL then
        value = self:b2n(value)
        default = self:b2n(default)
    end 

    db:exec('BEGIN') 
    local db_woool_sql = ""
    if ret then
        db_woool_sql = string.format("UPDATE %s SET value='%d', time='%d' WHERE account='%s' AND key='%s';", tbName, value, data.time, playerId, key)
    else
        db_woool_sql = string.format("INSERT INTO %s VALUES('%s', '%s', '%d', '%d', '%d', '%d', '%d')", tbName, playerId, key, value, data.type, data.time, default, data.option)
    end

    db:exec(db_woool_sql, showrow, 'db_woool_exite')
    db:exec('COMMIT')
end

function ToggleMarkModule:testDay(key)
    if self._toggleList[key].type ~= ToggleMarkModule.TYPE.DAY then
        return
    end

    if lt.TimeCounter:serverTime() - self._toggleList[key].time > lt.TimeCounter.DAY then
        self._toggleList[key].value = self._toggleList[key].default
        self._toggleList[key].time = lt.TimeCounter:zeroTimeStamp()

        self:saveDbData(key)
    end
end

function ToggleMarkModule:b2n(value)
    return value and 0 or 1
end

function ToggleMarkModule:n2b(value)
    return value == 0
end

function ToggleMarkModule:exsit(key)
    return self._toggleList[key]
end

return ToggleMarkModule