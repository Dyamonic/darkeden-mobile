local UpdaterCache = class("UpdaterCache")
--[[
    边玩边下 实时热更
    缓存部分

    -- res_map 中选出需要实时loding部分

	_G_CDN_URL cnd更新地址
	_G_TL_URL 服务器拉取地址
	_G_API_CENTER_FLAG 标识
]]

local GAME_VERSION_TXT = "version.txt"
local GAME_MAP_TXT = "dynamics_res_map.txt"

local BaseVersionUrl = _G_TL_URL .. "api/v1/center/getVersion?centerFlag=%s"

function UpdaterCache:ctor()
	if not _G_TL_URL or not _G_CDN_URL or not _G_API_CENTER_FLAG then
		return
	end

	--[[
		动态下载version, 需要从远程地址获取

		测试地址
		_G_TL_URL = "http://tianlian-nw-serverlist-test.yofijoy.com:7201/"
		_G_API_CENTER_FLAG = "tianlian_demo"

		local BaseVersionUrl = _G_TL_URL .. "api/v1/center/getVersion?centerFlag=%s"
		local url = string.format(tostring(BaseVersionUrl), _G_API_CENTER_FLAG)
	]]
	-- 默认初始化设置
    self._gameResUrl = string.format("%swin32_dynamics/v%s/", _G_CDN_URL, "0.0.1")

	-- 远程文件，对应md5
    self._remoteResMap = {}
    self._localResMap = {}

	self:init()
end

function UpdaterCache:onClear()
	self._remoteResMap = nil
	self._localResMap = nil
end

function UpdaterCache:init()
    local localResMap = self:getLocalGameResMap()
    self._localResMap = localResMap

	self._errorCount = 0
    -- 初始化远程 resMap
    self:initRemoteGameDynamicsVersion()
end

function UpdaterCache:initRemoteGameDynamicsVersion()
	local url = string.format(tostring(BaseVersionUrl), _G_API_CENTER_FLAG)

	yflog:Info("UpdaterCache:initUpdateVersion url: %s", url)

	-- 获取动态更新版本
	local request = network.createHTTPRequest(handler(self, self.onGetDynamicsVersion), url, "GET")
	request:start()
end

function UpdaterCache:onGetDynamicsVersion(event)
	local errorCode = nil
	while true do
		if event.name == "failed" then
			errorCode = "onGetDynamicsVersion failed"
			break
		end

		if event.name ~= "completed" then
			return
		end

		local request = event.request
		local code = request:getResponseStatusCode()
		if code ~= 200 then
			errorCode = 10000 + code
			break
		end

		local response = json.decode(request:getResponseString()) or {}
		if not response.data or not response.data.dynamicsVersion or response.data.dynamicsVersion == "" then
			errorCode = self.ERROR_CODE_3
			break
		end

		-- 首先判断 version
		self._remoteVersion = response.data.dynamicsVersion
		self._gameResUrl = string.format("%swin32_dynamics/v%s/", _G_CDN_URL, self._remoteVersion)
		self:initRemoteGameResMap()
		return
	end

	self._errorCount = self._errorCount + 1
	if self._errorCount < 4 then
		-- 重新请求
		self:initRemoteGameDynamicsVersion()
	else
		if errorCode then
			self:checkGameUpdateFail(errorCode)
		end
	end
end

-- 下载远程res_map.txt
function UpdaterCache:initRemoteGameResMap()
    local baseUrl = self._gameResUrl .. GAME_MAP_TXT
    local url = baseUrl

    yflog:Info("UpdaterCache 下载Game远程res_map.txt: %s", url)
    local request = network.createHTTPRequest(handler(self, self.onGetGameResMap), url, "GET")
    request:start()
end


-- 下载res_map.txt返回
function UpdaterCache:onGetGameResMap(event)
    local errorCode = nil
	while true do
		if event.name == "failed" then
			errorCode = -1
			break
		end

		if event.name ~= "completed" then
			return
		end

		local request = event.request
	    local code = request:getResponseStatusCode()
	    if code ~= 200 then
	    	self:checkGameUpdateFail(20000 + code)
	    	return
	    end

		-- res_map.txt 内容，文件更新目录以及md5，大小
	    self._remoteGameResMapStr = request:getResponseString()
		-- yflog:Info("self._remoteGameResMapStr:%s", self._remoteGameResMapStr)
        -- 远程赋值
        self._remoteResMap = self:getRemoteGameResMap()
		return
	end

	self._errorCount = self._errorCount + 1
    -- 拉取4次 
	if self._errorCount < 4 then
		self:initRemoteGameResMap()
	else
		if errorCode then
			self:checkGameUpdateFail(errorCode)
		end
	end
end

-- 更新失败 提示
function UpdaterCache:checkGameUpdateFail(code)
    -- 拉取cdn res_map.txt失败
    yflog:Info("UpdaterCache:checkGameUpdateFail 拉取cdn res_map.txt失败！")
end


-- 保存下载文件信息
function UpdaterCache:saveFileDownloadInfo(value)
    -- [url] = md5
    self._localResMap[value[1]] = value

    -- TODO 此处有优化为不用每次都去存取，可以一起下载好了一起存或者定时存储
    local content = self:converMapToContent(self._localResMap)
    io.writefile(self:getLocalGameResMapPath(), content)
end

function UpdaterCache:converMapToContent(resMap)
    local content = ""

    for key, value in pairs(resMap) do
        local str = string.format("%s,%s,%s\n", tostring(value[1]), tostring(value[2]), tostring(value[3]))

        content = content .. str
    end

    return content
end

-- 当前res_map.txt 内容
function UpdaterCache:getLocalGameResMap()
    local resMap = {}
	local f = io.open(self:getLocalGameResMapPath(), "r")
	if f then
		for line in f:lines()  do
			if line and line ~= "" then
				local value = self:analysisResMapLine(line)
				if value then
					resMap[value[1]] = value
				end
			end
		end

		io.close(f)
	end

	return resMap
end

-- 获取本地res_map.txt
function UpdaterCache:getLocalGameResMapPath()
	local path = device.writablePath
	if device.platform == "mac" or device.platform == "windows" then
		path = path .. "download/"
	end

	local filePath = path .. "win32/" .. GAME_MAP_TXT
	if not io.exists(filePath) then
		cc.FileUtils:getInstance():createDirectory(path)
		
		local fullPath = cc.FileUtils:getInstance():fullPathForFilename("win32/"..GAME_MAP_TXT)
		local dataFromFile = cc.FileUtils:getInstance():getDataFromFile(fullPath)

		local file = io.open(filePath, "w+b")
        file:write(dataFromFile)
        file:close()
	end

	return filePath
end

-- 远程res信息
function UpdaterCache:getRemoteGameResMap()
	local resMap = {}

	if self._remoteGameResMapStr then
		local lines = string.split(self._remoteGameResMapStr, "\n")
		for _, line in ipairs(lines) do
			if line and line ~= "" then
				local value = self:analysisResMapLine(line)
				if value then
					resMap[value[1]] = value
				end
			end
		end
	end

	return resMap
end

-- res_map.txt 文件格式
function UpdaterCache:analysisResMapLine(line)
	local lineArray = string.split(line, ",")
	if #lineArray < 3 then
		return nil
	end

	return {lineArray[1] or "nil", lineArray[2] or "", lineArray[3] or 0}
end

-- ********************** 外部调用 ***********************
-- (localResMap从本地存储里加载，如果为空，则从本地res_map.txt中加载)
function UpdaterCache:getUrlFromLocal(url)
    return self._localResMap[url]
end

function UpdaterCache:getUrlFromRemote(url)
    return self._remoteResMap[url]
end

function UpdaterCache:getRemoteVersion()
    return self._remoteVersion or ""
end


return UpdaterCache