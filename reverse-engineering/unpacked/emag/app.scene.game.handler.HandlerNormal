function HandlerNormal:selectNpc(heroAgent, agent)
    if  heroAgent:getTransformId() == 0 then
        local mTarget, nTarget = agent:getMNExactly()
        local mHero, nHero = heroAgent:getMNExactly()
        if MapUtil:isMNNeighbor(mHero, nHero, mTarget, nTarget) then
            local npcId = agent:getObjId()
            NpcModule:onClickNpc(npcId)
        else
            heroAgent:setTargetAgentId(agent:getAgentId())
            local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
            local moveType, moveDirection, mNext, nNext = mapAgent:calcTouchMove(mHero, nHero, mTarget, nTarget)
            if moveType == Constant.MOVE_NONE then
                return 
            end
            heroAgent:onMessage({msgId=Constant.MSG_MOVE_TOUCH, moveType=Constant.MOVE_RUN_NPC, moveDirection=moveDirection, mNext=mNext, nNext=nNext, isMoveToNpc = true})    
        end
        
    end
end

function HandlerNormal:selectAgent(point)
    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
    local xPoint, yPoint = mapAgent:calcPositionInMap(point)

    --[[
    local rect = lt.AgentManager:getWorldAgent():getHeroAgent():getRect()
    if cc.rectContainsPoint(rect, cc.p(xPoint, yPoint)) then
        print("包含")
    else
        print("不包含")
    end
    --]]

    local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()

    local selectAgentArray = {}
    local mTarget, nTarget = mapAgent:calcMNInMap(point)
    for m = mTarget-1, mTarget + 1 do
        for n = nTarget+10, nTarget, -1 do
            local agentTable = mapAgent:getAgentTableMN(m, n)
            if agentTable then
                for _, agent in pairs(agentTable) do
                    if heroAgent and agent:getAgentId() == heroAgent:getAgentId() then
                        -- 拾取当前格子
                        heroAgent:checkPickUp()
                    else
                        local notDarkness = (lt.GameModule:getHeroRace() == Constant.RaceType.Vampire or agent:isRoleAgent() and agent:getHeroData():getDarkness() ~= 1 or agent:isNpcAgent()) -- 非黑暗触
                        local notItem = agent:getAgentType() ~= Constant.AGENT_TYPE_ITEM  -- 非物品
                        local notEle = agent:getAgentType() ~= Constant.AGENT_TYPE_ELEMENT -- 非元素
                        local isVisible = agent:isVisibleActor() -- 显示状态
                        local noSummonWind = not agent:isMonsterAgent() or (agent:isMonsterAgent() and agent:getModelId() ~= lt.SkillEnum.SUMMON.SUMMON_WIND) --龙卷风
                        local noCrossCount = not (agent.isCrossCount and agent:isCrossCount()) -- 非假体

                        local canTouch = notDarkness and notItem and isVisible and notEle and noSummonWind and noCrossCount
                        if canTouch and cc.rectContainsPoint(agent:getRect(), cc.p(xPoint, yPoint)) then
                            if agent:isRoleAgent() then
                                if agent:isMonsterAgent() and not agent:isPet() then
                                    -- 怪物要挖掘后，才能击穿
                                    if not agent:isDig() then
                                        selectAgentArray[#selectAgentArray + 1] = agent
                                    end
                                else
                                    selectAgentArray[#selectAgentArray + 1] = agent
                                end
                            else
                                selectAgentArray[#selectAgentArray + 1] = agent
                            end
                        end
                    end
                end
            end
        end
    end
    local agentTypeSortValue = {
        [lt.Constant.AGENT_TYPE_NPC] = 99,
        [lt.Constant.AGENT_TYPE_HERO] = 50,
        [lt.Constant.AGENT_TYPE_MONSTER] = 1,
    }

    if #selectAgentArray > 0 then
        table.sort(selectAgentArray, function(agent1, agent2)
            return (agentTypeSortValue[agent1:getAgentType()] or 0) > (agentTypeSortValue[agent2:getAgentType()] or 0)
        end)

        return selectAgentArray[1]
    else
        return nil
    end
end

function HandlerNormal:getControlParam()
    if self._touchType == lt.HandlerNormal.TouchType.MOVE then
        local param = {}
        param.touchMovePoint = self._touchPoint
        return param
    end

    return nil
end

function HandlerNormal:resetRouteTarget()
    self._mTarget = nil
    self._nTarget = nil
end

function HandlerNormal:setRouteTarget(mTarget, nTarget)
    self._mTarget = mTarget
    self._nTarget = nTarget
end

function HandlerNormal:isSameTarget(m,n)
    if not self._mTarget or not self._nTarget then
        return false
    end

    return self._mTarget == m and self._nTarget == n
end

return HandlerNormal
