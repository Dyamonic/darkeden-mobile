
local HandlerNormal = class("HandlerNormal")

local Constant = lt.Constant
local MapUtil = lt.MapUtil
local NpcModule = lt.NpcModule
HandlerNormal.TouchType = {
    MONSTER = 1,
    HERO = 2,
    NPC = 3,
    MOVE = 4,
    SKILL = 5
}

HandlerNormal._touchType = nil
HandlerNormal._touchId = nil
HandlerNormal._touchPoint = nil

function HandlerNormal:cotr()
    self._clickElapse = 0
    self._clickInterval = 1
end

function HandlerNormal:onEnter()
end

function HandlerNormal:onExit()
end

function HandlerNormal:onUpdate()
    if self._touchType == lt.HandlerNormal.TouchType.MOVE and self._touchPoint then
        self._clickElapse = self._clickElapse + lt.GameBoard:getDeltaTime()
        if self._clickElapse > self._clickInterval then
            self._clickElapse = self._clickElapse - self._clickInterval

            -- 地图标记
            if lt.AutoManager:getTouchMove() then
                local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
                mapAgent:drawClickMark(self._touchPoint)
            end
        end
    end

    if self._clearTouchType then
        self._clearTouchType = false
        self._touchType = nil
        self._touchId = nil
        self._touchPoint = nil
        self:resetRouteTarget()
    end

    if self._stopTouchType then
        self._stopTouchType = false
        self._touchType = nil
        self._touchPoint = nil
        self:resetRouteTarget()
    end
end

function HandlerNormal:stopTouchType(isStopTouchType)
    self._stopTouchType = isStopTouchType
end

function HandlerNormal:onTouchBegan(id, point)
    ----[[
    local agent = self:selectAgent(point)
    local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
    if not heroAgent then
        return 
    end
    if not heroAgent:isAlive() then
        return
    end
    if not agent 
       
        or (agent:getAgentType() == Constant.AGENT_TYPE_TRAP and agent:getTrapData():getSkillId() ~= lt.SkillEnum.BLOODY_TUNNEL)
        or (agent:getAgentType() == Constant.AGENT_TYPE_TRAP and agent:getTrapData():getSkillId() == lt.SkillEnum.BLOODY_TUNNEL and heroAgent:getRoleRace() ~= Constant.RaceType.Vampire) 
        then
        local stopHangup = true

        while true do
          
            if heroAgent and heroAgent:_getSkillId() then
                local skillMeta = lt.CacheManager:querySkillMeta(heroAgent:_getSkillId())
                if skillMeta:getTargetType() == lt.Constant.SkillTargetType.ONE_AREA or skillMeta:getTargetType() == lt.Constant.SkillTargetType.AREA then
                    -- 准备释放技能
                    self._touchType = lt.HandlerNormal.TouchType.MOVE
                    break
                end
            end

            if not lt.AutoManager:getTouchMove() then
                -- 点击地图不处理
                stopHangup = false
                self._touchType = nil
                break
            end

            local currentTime = os.time()

            self._touchType = lt.HandlerNormal.TouchType.MOVE
            self._clickTime = currentTime

            break
        end

        --停止挂机
        lt.AutoFightManager:endAutoFight()

        -- 地图标记
        if lt.AutoManager:getTouchMove() then
            local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
            mapAgent:drawClickMark(point)
        end

        self._clickElapse = 0
        self._clickInterval = 1
    end

    self._touchId = id
    self._touchPoint = point
end

function HandlerNormal:onTouchMoved(id, point)
    if self._touchId ~= id then
        return
    end

    if self._touchType == lt.HandlerNormal.TouchType.MOVE then
        self._touchPoint = point
    end
end

