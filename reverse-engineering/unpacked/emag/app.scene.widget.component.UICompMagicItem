---@class UICompMagicItem
---
local UICompMagicItem = class("UICompMagicItem", lt.UICompBase, lt.UICompChangeSkin)

local ShaderBackendUtil = lt.ShaderBackendUtil

UICompMagicItem.ChangeSkinConf = {
--    ["RoleInfo"] = {
--         ["frame1"] = "bg_jineng_zhuanzhi_01",
--         ["frame2"] = "bg_jineng_zhuanzhi_da01",
--    } 
}

local Constant = lt.Constant
local SkillModule = lt.SkillModule
local GameModule = lt.GameModule

function UICompMagicItem:ctor()
    self._skillCfg = nil
    self._spriteId = nil
    self._passiveSkill = nil
    self._skillId = nil
    self._curState = nil
    self._cyanIcon = nil
    UICompMagicItem.super.ctor(self)
end

function UICompMagicItem:onClear()
    self._skillCfg = nil
    self._spriteId = nil
    self._passiveSkill = nil
    self._skillId = nil
    self._curState = nil
    self._cyanIcon = nil
    UICompMagicItem.super.onClear(self)
end

function UICompMagicItem:onEnter()
end

function UICompMagicItem:onExit()
end

function UICompMagicItem:onConstruct()
    self:startSkin()
end

function UICompMagicItem:getSkillCfg()
    return self._skillCfg
end

function UICompMagicItem:getCurState()
    return self._curState
end

function UICompMagicItem:initItem(data, curState)
    if not data then
        return
    end

    local skillId = data:getSkillId()
    local spriteId = data:getSpriteID()
    local skillLevel = SkillModule:getSkillLevel(skillId)
    local needLevel = data:getNeedLevel()
    self._skillCfg = data
    self._spriteId = spriteId
    self._passiveSkill = data:getPassiveSkill()
    self._skillId = skillId
    self._curState = curState

    local name = self:getChild("name")
    name:setText(data:getName())

    local value = self:getChild("value")
    value:setText((GameModule:getHeroRace() == Constant.RaceType.Slayer and curState == Constant.SkillState.Learned) and skillLevel or needLevel)
    if self._passiveSkill == 1 and curState == Constant.SkillState.Learned then
        value:setText(GReadText.KET_SKILL_TIPS11)
    end

    local icon = self:getChild("icon")
    icon:setURL(string.format("ui://Skill/%s", spriteId))
    self:setState(curState, data)
end

function UICompMagicItem:setState(curState, data)

    if self._cyanIcon then
        self._cyanIcon:removeFromParent()
        self._cyanIcon = nil
    end

    local icon = self:getChild("icon")
    local name = self:getChild("name")
    local value = self:getChild("value")
    local exist1 = self:getChild("exist1")
    local exist2 = self:getChild("exist2")
    local empty1 = self:getChild("empty1")
    local empty2 = self:getChild("empty2")
    local expBar = self:getChild("bar")

    if not self._race then
        self._race = lt.GameModule:getHeroRace()
        -- Constant.RaceType = {
        --     Slayer = 1, --人类
        --     Vampire
        if self._race == Constant.RaceType.Vampire then
            exist1:setURL(string.format(_GURL.GetCompRoleInfo,"bg_jineng_gui_03"))
            exist2:setURL(string.format(_GURL.GetCompRoleInfo,"bg_jineng_gui_04"))
            empty1:setURL(string.format(_GURL.GetCompRoleInfo,"bg_jineng_gui_05"))
            empty2:setURL(string.format(_GURL.GetCompRoleInfo,"bg_jineng_gui_06"))
        elseif self._race == Constant.RaceType.Slayer then
            exist1:setURL(string.format(_GURL.GetCompRoleInfo,"bg_jineng_ren_02"))
            exist2:setURL(string.format(_GURL.GetCompRoleInfo,"bg_jineng_ren_03"))
            empty1:setURL(string.format(_GURL.GetCompRoleInfo,"bg_jineng_ren_02_1"))
            empty2:setURL(string.format(_GURL.GetCompRoleInfo,"bg_jineng_ren_03_1"))
        end
    end

    --人族显示技能经验条
    expBar:setVisible(false)
    if self._race == Constant.RaceType.Slayer then
        local subExp = data:getSubExp()
        local skillId = data:getSkillId()
        if subExp > 0 and SkillModule:hasSkill(skillId) then
            local perExp = subExp/100
            local curSkillExp = SkillModule:getSkillExp(skillId)%perExp
            local percent = curSkillExp/perExp
            expBar:setFillAmount(percent)
            expBar:setVisible(true)
        end 
    end
    
    -- 默认都是绿色
    local green = cc.c3b(66, 255, 66)
    value:setColor(green)

    icon:setVisible(true)
    exist1:setVisible(false)
    exist2:setVisible(false)
    empty1:setVisible(true)
    empty2:setVisible(true)

    -----------------------------------------------------------------------------
    local curRace = self._skillCfg:getSkillRace()
    local cyan = cc.c3b(148,203,255)
    if curState == Constant.SkillState.NotLearnable then
        icon:setGrayed(true)
        name:setColor(cc.c3b(198,198,198))
        if curRace == Constant.RaceType.Slayer then
            local levelTable = GameModule:getHeroData():getSlayerLevelTable()
            local domain = math.floor(self._skillId/1000)
            if levelTable[domain] and levelTable[domain] < self._skillCfg:getNeedLevel() then
                value:setColor(Constant.COLOR_TEXT_RED)
            else
                value:setColor(green)
            end
        else
            local level = GameModule:getHeroData():getLevel()
            value:setColor(level >= self._skillCfg:getNeedLevel() and green or Constant.COLOR_TEXT_RED)
        end
    elseif curState == Constant.SkillState.Learnable then
        icon:setGrayed(false)
        icon:setColor(green)
        name:setColor(green)
    elseif curState == Constant.SkillState.Learned then
        icon:setGrayed(false)
        local white = cc.c3b(255,255,255)
        icon:setColor(white)
        local white2 = cc.c3b(255,254,254)
        exist1:setVisible(true)
        exist2:setVisible(true)
        empty1:setVisible(false)
        empty2:setVisible(false)
        -- 如果是被动ICON和NAME一定是变成青色
        if self._passiveSkill == 1 then
            local resPath = string.format("ui://Skill/%s", self._spriteId)
            self._cyanIcon = fgui.UIPackage:createObjectFromURL(resPath)
            self._cyanIcon:setScale(1.6,1.6)
            self._cyanIcon:setPivot(0.5,0.5,true)
            self._cyanIcon:setPosition(31,31)
            self:addChild(self._cyanIcon)
            icon:setVisible(false)
            --[[
                cocos4.0 FIXME:To be verified, shader change use.
            ]] 
            ShaderBackendUtil:makeCyanEffect(self._cyanIcon:displayObject())
            name:setColor(cyan)
        end
        if curRace == Constant.RaceType.Slayer then
            local levelTable = GameModule:getHeroData():getSlayerLevelTable()
            local domain = math.floor(self._skillId/1000)
            if levelTable[domain] and levelTable[domain] < self._skillCfg:getNeedLevel() then
                name:setColor(cc.c3b(198,198,198))
                value:setColor(cc.c3b(198,198,198))
            else
                if self._passiveSkill == 1 then -- 人族被动变青色
                    name:setColor(cyan)
                    value:setColor(cyan)
                else
                    name:setColor(white2)
                    value:setColor(white2)
                end
            end
        elseif curRace == Constant.RaceType.Vampire then -- 鬼族不需要变
            name:setColor(green)
            value:setColor(green)
        end
    end
end

return UICompMagicItem