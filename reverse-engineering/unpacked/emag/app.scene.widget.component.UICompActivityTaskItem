---@class UICompActivityTaskItem 日常周常任务cell
---
local UICompActivityTaskItem = class("UICompActivityTaskItem", lt.UIGButtonBase, lt.UICompChangeSkin)
local CacheManager = lt.CacheManager
local TaskModule = lt.TaskModule
local Constant = lt.Constant
local GameModule = lt.GameModule
local NtfManager = lt.NtfManager
local ItemModule = lt.ItemModule

UICompActivityTaskItem.ChangeSkinConf = {
    ["CommonTL"] = {
        ["btn_sure"] = {bg = "btn_common_anniu_01"},
    }
}

function UICompActivityTaskItem:ctor()
    UICompActivityTaskItem.super.ctor(self)
    --UI
    self._titleLabel = nil
    self._activityItem = nil
    self._numLabel = nil
    self._sureBtn = nil
    self._red = nil
    --数据
    self._taskData = nil
end

function UICompActivityTaskItem:onClear()
    --UI
    self._titleLabel = nil
    self._activityItem = nil
    self._numLabel = nil
    self._sureBtn = nil
    self._red = nil
    --数据
    self._taskData = nil
end

function UICompActivityTaskItem:onConstruct()
    self._titleLabel = self:getChild("label_title")
    self._activityItem = self:getChild("item_activity")
    self._numLabel = self:getChild("label_num")
    self._sureBtn = self:getChild("btn_sure")
    self._red = self._sureBtn:getChild("red")

    self:startSkin()
end

function UICompActivityTaskItem:onEnter()
    self._activityItem:addClickListener(handler(self, self.onActivityBtnClick))
    self._sureBtn:addClickListener(handler(self, self.onSureBtnClick))
end

function UICompActivityTaskItem:onExit()
    self._activityItem:removeClickListener()
    self._sureBtn:removeClickListener()
end

function UICompActivityTaskItem:setObjInfo(taskData)
    self._taskData = taskData
    local missionId = taskData.taskId
    local meta = CacheManager:getMissionMeta(missionId)
    local desc = meta:getMissionObject()
    local missionTarget = meta:getMissionTarget()
    local cur = (taskData.hadNumMap and taskData.hadNumMap[1]) and taskData.hadNumMap[1].value or 0
    if meta:getObjectType() == Constant.TASK_FINISH_TYPES.SEARCH then
        local itemId = tonumber(missionTarget[1][3])
        cur = ItemModule:getItemNum(itemId)
    end
    local max = tonumber(missionTarget[1][1])
    if cur > max then cur = max end
    local color = "#00ff00"
    if cur ~= max then
        color = "#ff0000"
    end
    desc = table.concat({desc,"[color=",color,"]","(",cur,"/",max,")[/color]"})
    
    self._titleLabel:setText(desc)
    self._numLabel:setText(meta:getALReward())

    --按钮状态
    local state = taskData.taskState
    if state == Constant.TASK_STATE.START then
        self._sureBtn:setText(GReadText.KEY_ACTIVITY_TASK_TIPS3)
    elseif state == Constant.TASK_STATE.FINISH then
        self._sureBtn:setText(GReadText.KEY_ACTIVITY_TASK_TIPS4)
    elseif state == Constant.TASK_STATE.REWARD then
        self._sureBtn:setText(GReadText.KEY_ACTIVITY_TASK_TIPS5)
    end
    local isTouch = state ~= Constant.TASK_STATE.REWARD
    self._sureBtn:setGrayed(not isTouch)
    self._sureBtn:setTouchable(state ~= Constant.TASK_STATE.REWARD)
    self._red:setVisible(state == Constant.TASK_STATE.FINISH)
end

function UICompActivityTaskItem:onActivityBtnClick()
    local missionId = self._taskData.taskId
    local meta = CacheManager:getMissionMeta(missionId)
    local itemSize = self._activityItem:getSize()
    local point = self._activityItem:localToGlobal({x = itemSize.width + 60, y = itemSize.height - 45})
    local liveness = meta:getALReward()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_TEXT_TIPS, 
    {
        content = string.format(GReadText.KEY_ACTIVITY_TASK_TIPS10, liveness),
        pt = point,
    })
end

function UICompActivityTaskItem:onSureBtnClick()
    local missionId = self._taskData.taskId
    local state = self._taskData.taskState
    if state == Constant.TASK_STATE.FINISH then
        --领取奖励
        TaskModule:sendTaskReward(missionId)
    elseif state == Constant.TASK_STATE.START then
        local meta = CacheManager:getMissionMeta(missionId)
        --是否达成条件
        local taskData = TaskModule:getTaskById(missionId)
        local isComplete = TaskModule:checkTaskComplete(taskData)
        if isComplete then
            --完成任务
            TaskModule:sendTaskCommit(meta:getAcceptanceNPCID(), missionId)
        else
            --前往
            local transferPoint = meta:getTransferPoint()
            if transferPoint ~= nil then
                TaskModule:sendTaskJumpUp(missionId)
            else
                local functionId = meta:getFunctionId()
                if functionId ~= nil then
                    GameModule:gotoSystemFunc(functionId)
                else
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_ACTIVITY_TASK_TIPS15})
                end
            end
        end
    end
end

return UICompActivityTaskItem