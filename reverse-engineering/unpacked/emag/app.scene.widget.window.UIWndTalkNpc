--- Npc 对话
---@class UIWndTalkNpc:UIWindowBase
local UIWndTalkNpc = class("UIWndTalkNpc", lt.UIWindowBase)
local NtfManager = lt.NtfManager
local TaskModule = lt.TaskModule
local NpcModule = lt.NpcModule
local CacheManager = lt.CacheManager
local RICH_INTRO_SIZE = cc.size(591, 157)
local Constant = lt.Constant
local NpcOpenType = Constant.NpcOpenType
local GameModule = lt.GameModule
local GuildModule = lt.GuildModule
local GuideModule = lt.GuideModule

UIWndTalkNpc.ChangeSkinConf = {
    ["CommonTL"] = {
        ["frame"] = {
            bg = "bg_common_dahaobg_01"
        }
    }
}

---组合窗口类型
local MUL_WINDOWS_TYPE = {
    ["101+102"] = Constant.WndLockType.WareHouse,
    ["110+109"] = Constant.WndLockType.Repair,
    ["111+102"] = Constant.WndLockType.Trade,
    ["110+102"] = Constant.WndLockType.Repair,
}

function UIWndTalkNpc:ctor(param)
    UIWndTalkNpc.super.ctor(self, param)
    self._richText = nil
    self._npcId = nil
end
   

function UIWndTalkNpc:onInit()
    self:registerComponent("UICompNpcTalkItem")
    UIWndTalkNpc.super.onInit(self, _GURL.WndNPC)
    self._npcTalkList = self:getChild("list")
    self._npcHead = self:getChild("npcHead")
    self._npcName = self:getChild("title")
    self._npcIntro = self:getChild("intro")
    self._npcTalkList:setItemRenderer(handler(self, self.answersRender))
end

function UIWndTalkNpc:onClear()
    self:unregisterAllComponent()
    self._npcTalkList = nil
    self._npcHead = nil
    self._npcName = nil
    self._npcIntro = nil
    self._richText = nil

    self._introTalks = nil
    UIWndTalkNpc.super.onClear(self)
end

function UIWndTalkNpc:onShown()
    self._answerTalks = {}
    self._introTalks = {}
    self._startTalkId = nil

    self:initNpcInfo()
    self:initAnswerList()
    self:setVisible(true)
end

function UIWndTalkNpc:onEnter()
    UIWndTalkNpc.super.onEnter(self)
    NtfManager:addNtfListener(NtfManager.NTF.NTF_NPC_REFRESH_INFO, handler(self, self.refreshNpcInfo), "UIWndTalkNpc:refreshNpcInfo")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_CHECK_GUIDE_EVENT, handler(self, self.checkGuide), "UIWndTalkNpc:checkGuide")
end

function UIWndTalkNpc:onExit()
    UIWndTalkNpc.super.onExit(self)
    NtfManager:removeNtfListenerByTag("UIWndTalkNpc:refreshNpcInfo")
    NtfManager:removeNtfListenerByTag("UIWndTalkNpc:checkGuide")
    if self._richText then
        self._richText:clear()
        self._richText = nil
    end
end

function UIWndTalkNpc:getTalkInfo(talkId)
    local meta = CacheManager:queryNpcTalk(talkId)
    if not meta then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = "配置没有找到talkId".. talkId})
        return 
    end
    local content = meta:getNpcTalkText()
    local nextStep = meta:getNpcTalkGoto()
    return content, nextStep
end

function UIWndTalkNpc:initNpcInfo()
    local param = self:getParam()
    self._npcId = param.npcId
    self._startTalkId = param.startTalkId
    self._skip = param.skip

    local worldAgent = lt.AgentManager:getWorldAgent()
    -- local agent = worldAgent:getAgent(self._npcId)
    local npcName = worldAgent:getNpcNameById(param.npcId)
    local name, funcName = unpack(string.split(npcName, "-"))

    -- 括号判断换行
    local index = string.find(name, "%（")
    if index then
        name = string.sub(name, 1, index - 1) .. "<br/>" .. string.sub(name, index)
    end

    self._npcName:setText(name)

    --保存当前点击的npc
    NpcModule:setNpcId(self._npcId)

    ---npc对话
    local meta = CacheManager:queryNpc(self._npcId)
    local headId = meta:getNpcHeadId()
    if not self._startTalkId then
        self._startTalkId = meta:getStartTalkId()
    end
    self._npcHead:setURL(string.format(_GURL.NPCHeadURL, headId))
    local startTitleId, talkOptions = unpack(string.split(self._startTalkId, ":"))
    local talkOptions = string.split(talkOptions, ",")

    local title = self:getTalkInfo(startTitleId)
    if not title then return end

    --选项
    for _, optionId in pairs(talkOptions) do
        local content, nextStep = self:getTalkInfo(optionId)
        table.insert(self._answerTalks, {content = content, nextStep = nextStep, talkId = optionId})
    end

    self._introTalks = TaskModule:parseTaskString(title, true)

    if self._richText then
        self._richText:clear()
        self._richText = nil
    end

    self._richText = lt.FGUIRichText.new({textTable = self._introTalks, fontSize = 22, size = RICH_INTRO_SIZE})
    self:addChild(self._richText)
    self._richText:setPosition(342, 95)
end

function UIWndTalkNpc:initAnswerList()
    local race = GameModule:getHeroRace()
    self._npcTalkList:setSize(race == Constant.RaceType.Ousters and 578 or 599, 266)
    self._npcTalkList:setNumItems(#self._answerTalks)
    self._npcTalkList:scrollToView(0)
end

function UIWndTalkNpc:answersRender(index, obj)
    local curIndex = index + 1
    local curObjInfo = self._answerTalks[curIndex]
    obj:insertObjectToFactory(self)
    obj:setObjInfo({content = curObjInfo.content, index = curIndex, callback = handler(self, self.onClickCallback)})
end

function UIWndTalkNpc:onClickCallback(index)
    local nextStep = self._answerTalks[index].nextStep
    local talkId = self._answerTalks[index].talkId
    --开始解析
    local openType, openParam = unpack(string.split(nextStep, "|"))
    openType = tonumber(openType)
    local param = {}
    if openType == NpcOpenType.Talk then
        param.class = "UIWndTalkNpc"
        param.npcId = self._npcId
        param.startTalkId = openParam
        param.skip = self._skip
        self:npcGoToNext(param)
    elseif openType == NpcOpenType.Map then
        NpcModule:sendGotoMap(self._npcId, talkId)
    elseif openType == NpcOpenType.View then
        local canOpen = self:canOpenView(openParam)
        if canOpen then
            self:setVisible(false)
            param = self:parseClassInfo(openParam)
            self:npcGoToNext(param)
        end
    elseif openType == NpcOpenType.HP then
        NpcModule:sendFullHp(self._npcId)
    elseif openType == NpcOpenType.Exit then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTalkNpc", close = true})
    elseif openType == NpcOpenType.Exchange then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = "等服务端协议： 道具兑换"})
    elseif openType == NpcOpenType.PurchangeBox then
        local buyNum = lt.CacheManager:getValueById(Constant.Variable.StorePrice)
        local jinBi = GameModule:getHeroData():getJinBi()
        if jinBi < buyNum then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = string.format(GReadText.KEY_WAREHOUSE_TIPS6, buyNum)})
            return true
        end

        local heroData = GameModule:getHeroData()
        local getMaxDepotPos = heroData:getMaxDepot()
        local str = ""
        if getMaxDepotPos <= 0 then
            str = "是否花费%d开启仓库"
        else
            str = "是否花费%d扩容仓库"
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
            content = string.format(str,buyNum),
            confirmCallback = function()
                if self._npcId then
                    NpcModule:sendBuyStorge(self._npcId)
                end
            end,
            closeLimitFunc = function()
                if jinBi < buyNum then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = string.format(GReadText.KEY_WAREHOUSE_TIPS6, buyNum)})
                    return true
                end
            end,
        })
    elseif openType == NpcOpenType.FindMoto then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = "等服务端协议： 找回摩托车"})
    elseif openType == NpcOpenType.Donate then
        local heroData = GameModule:getHeroData()
        if heroData:getTendencies() >= -2500 then
            --邪恶或者非常邪恶才能使用
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_NPC_DONATE_TIPS2})
            return
        end
        local costNum = tonumber(string.split(openParam, ",")[1])
        local isEnough = lt.ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN, costNum, {tips = false})
        if not isEnough then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_NPC_DONATE_TIPS1})
            return
        end
        NpcModule:sendDonate(self._npcId, talkId)
    elseif openType == NpcOpenType.Revive then
        NpcModule:sendRecordLive(self._npcId)
    elseif openType == NpcOpenType.LeadingTask then
        local taskIds = string.split(openParam, ",")
        local taskId = TaskModule:getAchieveTask(taskIds)
        if taskId == nil then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_NPC_DONATE_TIPS4})
            return
        end
        TaskModule:sendTaskLeading(self._npcId, taskId)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndTalkNpc", close = true})
    elseif openType == NpcOpenType.CommitTask then
        local tasklist = TaskModule:getTaskList(Constant.TASK_TYPES.BRANCH)
        local taskId = nil
        for i = 1, #tasklist do
            local meta = CacheManager:getMissionMeta(tasklist[i].taskId)
            if meta:getHandingOverNPCID() == self._npcId then
                taskId = tasklist[i].taskId
            end
        end
        if taskId == nil then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_TASK_TIPS11})
            return
        end
        local taskState = TaskModule:getTaskState(taskId)
        if taskState == Constant.TASK_STATE.START then
            --是否达成条件
            local taskData = TaskModule:getTaskById(taskId)
            local isComplete = TaskModule:checkTaskComplete(taskData)
            if isComplete then
                TaskModule:sendTaskCommit(self._npcId, taskId)
            else
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_TASK_TIPS13})
            end
        elseif taskState == Constant.TASK_STATE.FINISH then
            TaskModule:sendTaskReward(taskId)
        end
    elseif openType == NpcOpenType.GiveupTask then
        local tasklist = TaskModule:getTaskList(Constant.TASK_TYPES.BRANCH)
        local taskId = nil
        for i = 1, #tasklist do
            local meta = CacheManager:getMissionMeta(tasklist[i].taskId)
            if meta:getHandingOverNPCID() == self._npcId then
                taskId = tasklist[i].taskId
            end
        end
        if taskId == nil then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_TASK_TIPS11})
            return
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {type = 2, content = GReadText.KEY_TASK_TIPS10,
        confirmCallback = function()
            TaskModule:sendTaskGiveup(taskId)
        end})
    elseif openType == NpcOpenType.Guild then
        local type = tonumber(openParam) or 0
        local heroData = GameModule:getHeroData()
        local myGuildId = heroData:getGuildId()
        if type == 1 then-- 创建公会
            if myGuildId ~= 0 and myGuildId ~= "0" then 
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_GUILD_TIPS13})
                return
            end
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndGuildCreate" })
        elseif  type == 2 then -- 加入公会
            if myGuildId ~= 0 and myGuildId ~= "0" then 
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_GUILD_TIPS14})
                return
            end
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = "UIWndGuildList" })
        elseif  type == 3 then -- 退出公会
            if myGuildId == 0 or myGuildId == "0" then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_GUILD_TIPS15})
                return
            end
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
                content = GReadText.KEY_GUILD_TIPS21,--是否要退出公会
                confirmCallback = function()
                    GuildModule:sendGuildLeaveReq()
                end,
            })
        end
    elseif openType == NpcOpenType.HolyBook then
        local holyBookBorrowList = NpcModule:getHolyBookBorrowHash()
        for k, v in pairs(holyBookBorrowList or {}) do
            NpcModule:onHolyBook_BorrowReq(k,false)
        end
    elseif openType == NpcOpenType.OUSTERSTOWER then
        local heroData = GameModule:getHeroData()
        if heroData:getSignContract() then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = GReadText.KEY_NPC_SKILL_TIPS10})
            return
        end
        --解锁魔灵柱
        NpcModule:sendNpcSignContract(self._npcId)
    else 
        --其他TODO
    end
end

function UIWndTalkNpc:npcGoToNext(param)
    local extParam = {fromNpc = true, reopen = true}
    table.merge(extParam, param)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, extParam)
end

function UIWndTalkNpc:refreshNpcInfo(event)
    self:setVisible(true)
end

function UIWndTalkNpc:parseClassInfo(openParam)
    local param = {}
    local classInfo = string.split(openParam, ";")
    local classLen = table.nums(classInfo)
    --两个界面（两个以上TODO）
    if classLen > 1 then
        param.param = {}
        local classStr = ""
        for index, classInfo in pairs(classInfo) do
            local classViewId, tabId, tabSubId= unpack(string.split(classInfo, "#"))
            local className = CacheManager:getViewNameById(classViewId)
            local viewParam = CacheManager:getViewParamById(classViewId)
            viewParam.dialogueStr, viewParam.answerStr = CacheManager:getViewDialogueById(classViewId)
            param.param[index] = {
                class = className, 
                reopen = true,
                param = {
                    tabId = tonumber(tabId), 
                    tabSubId = tonumber(tabSubId), 
                    viewParam = viewParam,
                },
            }
            if classStr ~= "" then
                classStr = classStr .."+".. classViewId
            else
                classStr = classStr .. classViewId
            end
        end
        param.param.WndLockType = self:getWndLockType(classStr)
        param.param.lockIds = classStr
        param.class = "UIWndLock"
    elseif classLen == 1 then
        local classViewId, tabId, tabSubId = unpack(string.split(classInfo[1], "#"))
        local className = CacheManager:getViewNameById(classViewId)
        local viewParam = CacheManager:getViewParamById(classViewId)
        viewParam.dialogueStr, viewParam.answerStr = CacheManager:getViewDialogueById(classViewId)
        param.class = className
        param.param = {
            tabId = tonumber(tabId),
            tabSubId = tonumber(tabSubId),
            viewParam = viewParam,
        }
    end
    return param
end

function UIWndTalkNpc:getWndLockType(classViewIds)
    local lockType = MUL_WINDOWS_TYPE[classViewIds]
    return lockType
end

function UIWndTalkNpc:canOpenView(openParam)
    local heroData = GameModule:getHeroData()
    if openParam == "111#3;102" then
        --判断是否是转职交换
        if not heroData:isAdvance() then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_DUNGEON_TIPS5})
            return false
        end
    elseif openParam == "112" then
        --判断是否是鬼族洗点
        local coinNum = heroData:getJinBi()
        if coinNum < Constant.CLEANPOINTSCOST then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_NPC_CLS_SKILL_TIPS5})
            return false
        end
    end
    return true
end

--检查引导
function UIWndTalkNpc:checkGuide()
    local race = GameModule:getHeroRace()
    if race == Constant.RaceType.Slayer then
        --人族地图传送引导
        if GuideModule:checkCanGuide(Constant.GUIDE_ID.SLAYER_TRANSMIT1) then
            if self._npcId == 102 then
                for k, v in ipairs(self._answerTalks) do
                    local openType, openParam = unpack(string.split(v.nextStep, "|"))
                    if openParam == "111#1;102" then
                        local btn = self._npcTalkList:getChildAt(k)
                        local pos = self._npcTalkList:displayObject():convertToWorldSpace(btn:getPosition())
                        pos = cc.p(pos.x, pos.y + self._npcTalkList:getSize().height/2 - 5)
                        if #self._answerTalks < 5 then
                            pos.y = pos.y + self._npcTalkList:getSize().height - 63 * #self._answerTalks
                        end
                        GuideModule:triggerGuide(Constant.GUIDE_ID.SLAYER_TRANSMIT1, btn, pos, function()
                            self:onClickCallback(k)
                        end)
                        return
                    end
                end
            end
        end
        --人族出售道具引导
        if GuideModule:checkCanGuide(Constant.GUIDE_ID.SLAYER_SELLITEM) then
            if self._npcId == 163 then
                for k, v in ipairs(self._answerTalks) do
                    if v.talkId == "163104" then
                        local btn = self._npcTalkList:getChildAt(k)
                        local pos = self._npcTalkList:displayObject():convertToWorldSpace(btn:getPosition())
                        pos = cc.p(pos.x, pos.y + self._npcTalkList:getSize().height/2 - btn:getSize().height/2 - 10)
                        if #self._answerTalks < 5 then
                            pos.y = pos.y + self._npcTalkList:getSize().height - 57 * #self._answerTalks
                        end
                        GuideModule:triggerGuide(Constant.GUIDE_ID.SLAYER_SELLITEM, btn, pos, function()
                            self:onClickCallback(k)
                        end)
                        return
                    end
                end
            end
        end
        --人族购买道具引导
        if GuideModule:checkCanGuide(Constant.GUIDE_ID.SLAYER_BUYITEM) then
            if self._npcId == 163 then
                for k, v in ipairs(self._answerTalks) do
                    if v.talkId == "163103" then
                        local btn = self._npcTalkList:getChildAt(k)
                        local pos = self._npcTalkList:displayObject():convertToWorldSpace(btn:getPosition())
                        pos = cc.p(pos.x, pos.y + self._npcTalkList:getSize().height/2 - btn:getSize().height/2 - 10)
                        if #self._answerTalks < 5 then
                            pos.y = pos.y + self._npcTalkList:getSize().height - 57 * #self._answerTalks
                        end
                        GuideModule:triggerGuide(Constant.GUIDE_ID.SLAYER_BUYITEM, btn, pos, function()
                            self:onClickCallback(k)
                        end)
                        return
                    end
                end
            end
        end
        --物品存储引导
        if GuideModule:checkCanGuide(Constant.GUIDE_ID.WAREHOUSE) then
            if self._npcId == 110 then
                for k, v in ipairs(self._answerTalks) do
                    local openType = unpack(string.split(v.nextStep, "|"))
                    openType = tonumber(openType)
                    if openType == NpcOpenType.PurchangeBox then
                        local btn = self._npcTalkList:getChildAt(k)
                        local pos = self._npcTalkList:displayObject():convertToWorldSpace(btn:getPosition())
                        pos = cc.p(pos.x, pos.y + self._npcTalkList:getSize().height/2 - btn:getSize().height/2 - 10)
                        if #self._answerTalks < 5 then
                            pos.y = pos.y + self._npcTalkList:getSize().height - 57 * #self._answerTalks
                        end
                        GuideModule:triggerGuide(Constant.GUIDE_ID.WAREHOUSE, btn, pos, function()
                            if self.onClickCallback then
                                self:onClickCallback(k)
                            end
                        end)
                        return true
                    end
                end
            end
        end
    elseif race == Constant.RaceType.Vampire then
        --鬼族技能学习引导
        if GuideModule:checkCanGuide(Constant.GUIDE_ID.VAMPIRE_SKILL) then
            if self._npcId == 302 then
                for k, v in ipairs(self._answerTalks) do
                    if v.talkId == "302101" then
                        local btn = self._npcTalkList:getChildAt(k)
                        local pos = self._npcTalkList:displayObject():convertToWorldSpace(btn:getPosition())
                        pos = cc.p(pos.x, pos.y + self._npcTalkList:getSize().height/2 - btn:getSize().height/2 - 10)
                        GuideModule:triggerGuide(Constant.GUIDE_ID.VAMPIRE_SKILL, btn, pos, function()
                            if self.onClickCallback then
                                self:onClickCallback(k)
                            end
                        end)
                        return
                    end
                end
            end
        end
        --鬼族出售道具引导
        if GuideModule:checkCanGuide(Constant.GUIDE_ID.VAMPIRE_SELLITEM) then
            if self._npcId == 301 then
                for k, v in ipairs(self._answerTalks) do
                    if v.talkId == "301102" then
                        local btn = self._npcTalkList:getChildAt(k)
                        local pos = self._npcTalkList:displayObject():convertToWorldSpace(btn:getPosition())
                        pos = cc.p(pos.x, pos.y + self._npcTalkList:getSize().height/2 - btn:getSize().height/2 - 10)
                        if #self._answerTalks < 5 then
                            pos.y = pos.y + self._npcTalkList:getSize().height - 57 * #self._answerTalks
                        end
                        GuideModule:triggerGuide(Constant.GUIDE_ID.VAMPIRE_SELLITEM, btn, pos, function()
                            self:onClickCallback(k)
                        end)
                        return
                    end
                end
            end
        end
        --鬼族购买道具引导
        if GuideModule:checkCanGuide(Constant.GUIDE_ID.VAMPIRE_BUYITEM) then
            if self._npcId == 301 then
                for k, v in ipairs(self._answerTalks) do
                    if v.talkId == "301101" then
                        local btn = self._npcTalkList:getChildAt(k)
                        local pos = self._npcTalkList:displayObject():convertToWorldSpace(btn:getPosition())
                        pos = cc.p(pos.x, pos.y + self._npcTalkList:getSize().height/2 - btn:getSize().height/2 - 10)
                        GuideModule:triggerGuide(Constant.GUIDE_ID.VAMPIRE_BUYITEM, btn, pos, function()
                            self:onClickCallback(k)
                        end)
                        return
                    end
                end
            end
        end
        --物品存储引导
        if GuideModule:checkCanGuide(Constant.GUIDE_ID.WAREHOUSE) then
            if self._npcId == 312 then
                for k, v in ipairs(self._answerTalks) do
                    local openType = unpack(string.split(v.nextStep, "|"))
                    openType = tonumber(openType)
                    if openType == NpcOpenType.PurchangeBox then
                        local btn = self._npcTalkList:getChildAt(k)
                        local pos = self._npcTalkList:displayObject():convertToWorldSpace(btn:getPosition())
                        pos = cc.p(pos.x, pos.y + self._npcTalkList:getSize().height/2 - btn:getSize().height/2 - 10)
                        if #self._answerTalks < 5 then
                            pos.y = pos.y + self._npcTalkList:getSize().height - 57 * #self._answerTalks
                        end
                        GuideModule:triggerGuide(Constant.GUIDE_ID.WAREHOUSE, btn, pos, function()
                            if self.onClickCallback then
                                self:onClickCallback(k)
                            end
                        end)
                        return true
                    end
                end
            end
        end
    elseif race == Constant.RaceType.Ousters then
        --魔族地图传送引导
        if GuideModule:checkCanGuide(Constant.GUIDE_ID.OUSTERS_TRANSMIT) then
            if self._npcId == 201 then
                self._npcTalkList:scrollToView(7)
                for k, v in ipairs(self._answerTalks) do
                    if v.talkId == "201105" then
                        local btn = self._npcTalkList:getChildAt(1)
                        local pos = self._npcTalkList:displayObject():convertToWorldSpace(btn:getPosition())
                        pos = cc.p(pos.x, pos.y + self._npcTalkList:getSize().height/2 - btn:getSize().height/2 - 10)
                        GuideModule:triggerGuide(Constant.GUIDE_ID.OUSTERS_TRANSMIT, btn, pos, function()
                            self:onClickCallback(k)
                        end)
                        return
                    end
                end
            end
        end
        --魔族出售道具引导
        if GuideModule:checkCanGuide(Constant.GUIDE_ID.OUSTERS_SELLITEM) then
            if self._npcId == 202 then
                for k, v in ipairs(self._answerTalks) do
                    if v.talkId == "202103" then
                        local btn = self._npcTalkList:getChildAt(k)
                        local pos = self._npcTalkList:displayObject():convertToWorldSpace(btn:getPosition())
                        pos = cc.p(pos.x, pos.y + self._npcTalkList:getSize().height/2 - btn:getSize().height/2 - 10)
                        if #self._answerTalks < 5 then
                            pos.y = pos.y + self._npcTalkList:getSize().height - 57 * #self._answerTalks
                        end
                        GuideModule:triggerGuide(Constant.GUIDE_ID.OUSTERS_SELLITEM, btn, pos, function()
                            self:onClickCallback(k)
                        end)
                        return
                    end
                end
            end
        end
        --魔族购买道具引导
        if GuideModule:checkCanGuide(Constant.GUIDE_ID.OUSTERS_BUYITEM) then
            if self._npcId == 202 then
                for k, v in ipairs(self._answerTalks) do
                    if v.talkId == "202102" then
                        local btn = self._npcTalkList:getChildAt(k)
                        local pos = self._npcTalkList:displayObject():convertToWorldSpace(btn:getPosition())
                        pos = cc.p(pos.x, pos.y + self._npcTalkList:getSize().height/2 - btn:getSize().height/2 - 10)
                        if #self._answerTalks < 5 then
                            pos.y = pos.y + self._npcTalkList:getSize().height - 57 * #self._answerTalks
                        end
                        GuideModule:triggerGuide(Constant.GUIDE_ID.OUSTERS_BUYITEM, btn, pos, function()
                            self:onClickCallback(k)
                        end)
                        return
                    end
                end
            end
        end
        --物品存储引导
        if GuideModule:checkCanGuide(Constant.GUIDE_ID.WAREHOUSE) then
            if self._npcId == 205 then
                for k, v in ipairs(self._answerTalks) do
                    local openType = unpack(string.split(v.nextStep, "|"))
                    openType = tonumber(openType)
                    if openType == NpcOpenType.PurchangeBox then
                        local btn = self._npcTalkList:getChildAt(k)
                        local pos = self._npcTalkList:displayObject():convertToWorldSpace(btn:getPosition())
                        pos = cc.p(pos.x, pos.y + self._npcTalkList:getSize().height/2 - btn:getSize().height/2 - 10)
                        if #self._answerTalks < 5 then
                            pos.y = pos.y + self._npcTalkList:getSize().height - 57 * #self._answerTalks
                        end
                        GuideModule:triggerGuide(Constant.GUIDE_ID.WAREHOUSE, btn, pos, function()
                            if self.onClickCallback then
                                self:onClickCallback(k)
                            end
                        end)
                        return true
                    end
                end
            end
        end
    end
end

return UIWndTalkNpc