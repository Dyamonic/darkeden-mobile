-- 签到礼包
local SignGiftMeta = class("SignGiftMeta")
local Constant = lt.Constant
function SignGiftMeta:ctor(row)
    self:initWithRow(row)
end

function SignGiftMeta:initWithRow(row)
    self._needDay         = row.NeedDay
    self._name          = row.PriceName
    if row.SlayerItems == "" then
        self._slayerItems = {}
    else
        self._slayerItems = json.decode(row.SlayerItems)
    end
    if row.OustersItems == "" then
        self._oampireItems = {}
    else
        self._oampireItems = json.decode(row.OustersItems)
    end
    if row.VampireItems == "" then
        self._vampireItems = {}
    else
        self._vampireItems = json.decode(row.VampireItems)
    end
end

function SignGiftMeta:getRewardItem(race)
    if Constant.RaceType.Slayer == race then
        return self._slayerItems
    elseif Constant.RaceType.Vampire == race then
        return self._vampireItems
    elseif Constant.RaceType.Ousters == race then
        return self._oampireItems
    end
end

function SignGiftMeta:getNeedDay() return self._needDay end
function SignGiftMeta:getName() return self._name end

return SignGiftMeta
