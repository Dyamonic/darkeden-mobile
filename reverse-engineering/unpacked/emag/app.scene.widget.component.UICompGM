---@class UICompGM GM
local UICompGM = class("UICompGM", lt.UICompBase)
local Constant = lt.Constant
local SocketApi = lt.SocketApi
function UICompGM:ctor(param)
    UICompGM.super.ctor(self)
    self._sendCnt = 1
    local obj = fgui.UIPackage:createObjectFromURL(param.url)
    self:addChild(obj)
    self._sendBtn = obj:getChild("sendBtn")
    
    self._gmText = obj:getChild("gmText")
    self._responseText = obj:getChild("responseText")
    self._gmText:setText("@test setprop 125 100000")
end

function UICompGM:onClear()
    self._sendBtn = nil
    self._gmText = nil
    self._responseText = nil
    UICompGM.super.onClear(self)
end

function UICompGM:onEnter()
    SocketApi:addProtoListener(lt.ServerCmdDef.CHAT_MSG, handler(self, self.onChatMsg), "UICompGM:onChatMsg")
    self._sendBtn:addClickListener(handler(self, self.btnSendClick))
end

function UICompGM:onExit()
    SocketApi:removeProtoListenerByTag("UICompGM:onChatMsg")
    self._sendBtn:removeClickListener()
end

function UICompGM:btnSendClick(context)
    local sendman = lt.GameModule:getHeroData():getName()
    local msg = self._gmText:getText()
    if msg ~= "" then
        local gm = string.sub(msg, 1, 1)
        if gm ~= "@" then
            return 
        end
        lt.ChatModule:sendGMChat(msg,2,sendman,"")
    end
end

function UICompGM:onChatMsg(event)
    local proto = event.param
    if proto.chatType == Constant.MESSAGE_TALK_TYPE.TALKTYPE_SERVER or proto.chatType == Constant.MESSAGE_TALK_TYPE.SOUND_HORN  then
        self:addListViewItem(proto)
    elseif proto.chatType == Constant.MESSAGE_TALK_TYPE.TALKTYPE_CENTER then
    elseif proto.chatType == Constant.MESSAGE_TALK_TYPE.TALKTYPE_SYSTEM then
        self:addListViewItem(proto)
    elseif proto.chatType == Constant.MESSAGE_TALK_TYPE.BROWN_NOTICE then
    elseif proto.chatType == Constant.MESSAGE_TALK_TYPE.ITEM_NOTICE then
    elseif proto.chatType == Constant.MESSAGE_TALK_TYPE.TALKTYPE_HEAD then
        self:addListViewItem(proto)
    else
        if lt.ChatModule:getInfoType(proto.chatType) then
            self:addListViewItem(proto)
        end
    end
end

function UICompGM:addListViewItem(info,type,showtype)
    if not info then
        return
    end 
    local idx = string.find(info.chatMsg,"team/?")
    local cutstr = nil
    if idx then
        cutstr = string.sub(info.chatMsg,idx+6)
    else
        cutstr = info.chatMsg
    end

    self._responseText:setText(cutstr)
end


return UICompGM
