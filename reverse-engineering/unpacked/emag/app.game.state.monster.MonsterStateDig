
local MonsterStateDig = class("MonsterStateDig", lt.MonsterStateBase)

--[[
    宠物挖掘尸体
]]

MonsterStateDig._timeTrigger = nil

function MonsterStateDig:ctor(monsterAgent)
    MonsterStateDig.super.ctor(self, monsterAgent)

    -- 计算动作时间 屏蔽
    local monsterData = monsterAgent:getMonsterData()
    local modelId = monsterData:getModelId()
    local direction = monsterAgent:getDirection() or 1
    local frameCount = lt.ActionManager:getCreatureFrameCount("monster", modelId, lt.Constant.ACTION_PET_DIG, direction)

    --宠物
    self._worldAgent = lt.AgentManager:getWorldAgent()
    local pet = self._worldAgent:getOwnPet()
    local petInfo = lt.PetModule:getPetByUid(pet:getPetUid())
    local isDigSpeedUp = lt.PetModule:isDigSpeedUp(petInfo)

    local time = frameCount * 0.1
    if isDigSpeedUp then
        time = time / 2
    end
    self._timeTrigger = lt.TimeTrigger.new(time)
    --挖尸体
    local targetAgent = self._worldAgent:getCanDigMonster()
    if targetAgent then
        lt.MonsterModule:sendDigCorpse(targetAgent, monsterData:getObjId())
    end
end

function MonsterStateDig:onClear()
end

function MonsterStateDig:onEnter()
    self._monsterAgent:playAction(lt.Constant.ACTION_PET_DIG)
end

function MonsterStateDig:onExit()
end

function MonsterStateDig:onUpdate()
    local deltaTime = lt.GameBoard:getDeltaTime()

    if self._timeTrigger:tick(deltaTime) then
        if self._worldAgent:getCanDigMonster() then
            self._monsterAgent:changeState(lt.MonsterStateDig.new(self._monsterAgent))
        else
            self._monsterAgent:changeState(lt.MonsterStateIdle.new(self._monsterAgent))
        end
        return
    end
end

function MonsterStateDig:onMessage(msg)
end

function MonsterStateDig:getStateId()
    return lt.Constant.MONSTER_STATE_DIG
end

function MonsterStateDig:getStateName()
    return "MonsterStateDig"
end

return MonsterStateDig
