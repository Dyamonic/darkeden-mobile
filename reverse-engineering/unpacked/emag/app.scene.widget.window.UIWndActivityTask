function UIWndActivityTask:ctor(param)
    UIWndActivityTask.super.ctor(self, param)
end

function UIWndActivityTask:onInit()
    self:registerComponent("UICompActivityTaskItem")
    UIWndActivityTask.super.onInit(self, _GURL.WndActivityTask)

    self._achieveBtn = self:getChild("btn_achieve")
    self._livenessLoader = self:getChild("loader_liveness")
    self._taskList = self:getChild("list")
    self._taskList:setItemRenderer(handler(self, self.taskRender))
    self._fiterBtns = {}
    for fiterType = 1, table.nums(FITER_TYPES) do
        local obj = self:getChild("btnFiter"..fiterType)
        obj.fiterType = fiterType
        self._fiterBtns[fiterType] = obj
    end
    self._tipsLabel = self:getChild("label_tips")
    self._activityLabel = self:getChild("label_activity")
    self._progressbar = self:getChild("progressbar")
    for i = 1, MAX_NUM do
        self["node_box"..i] = self:getChild("node_box"..i)
        self["label_num"..i] = self:getChild("label_num"..i)
        self["loader_box"..i] = self:getChild("loader_box"..i)
        --创建特效spine
        self["spine_box"..i] = SkeletonManager:createSkeletonEffectWithFile("box_receive", "box_receive_skeleton")
        self["loader_box"..i]:displayObject():addChild(self["spine_box"..i])
        self["spine_box"..i]:setPosition(25, 25)
        self["spine_box"..i]:setVisible(false)
        self["spine_box"..i]:setAnimation(0, "box_receive", true)

        self["spine_boxh"..i] = SkeletonManager:createSkeletonEffectWithFile("box_receive2", "box_receive2_skeleton")
        self["loader_box"..i]:displayObject():addChild(self["spine_boxh"..i])
        self["spine_boxh"..i]:setPosition(25, 30)
        self["spine_boxh"..i]:setVisible(false)
        self["spine_boxh"..i]:setAnimation(0, "box_receive2", true)
    end
    self._controlTab = self:getController("tabs")
    self:resetPanel()
end

function UIWndActivityTask:onShown()
    NtfManager:addNtfListener(NtfManager.NTF.NTF_REFRESH_TASK_MY, handler(self, self.showCurPanel), "UIWndActivityTask:NTF_REFRESH_TASK_MY")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_ITEM_EVENT, handler(self, self.showCurPanel), "UIWndActivityTask:NTF_UPDATE_ITEM_EVENT")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_RED_DOT_EVENT, handler(self, self.uptRedDotEvt),"UIWndActivityTask:uptRedDotEvt")

    self._achieveBtn:addClickListener(handler(self, self.onAchieveBtnClick))
    self._livenessLoader:addClickListener(handler(self, self.onLivenessBtnClick))
    for k, v in ipairs(self._fiterBtns) do
        v:addClickListener(handler(self, self.openFiterBtnClick))
    end
    for i = 1, MAX_NUM do
        self["loader_box"..i]:addClickListener(function()
            self:onBoxClick(i)
        end)
    end

    if self:getContentPane() then
        self:resetPanel()
    end
    self:setVisible(true)
end

function UIWndActivityTask:onHide()
    NtfManager:removeNtfListenerByTag("UIWndActivityTask:NTF_REFRESH_TASK_MY")
    NtfManager:removeNtfListenerByTag("UIWndActivityTask:NTF_UPDATE_ITEM_EVENT")
    NtfManager:removeNtfListenerByTag("UIWndActivityTask:uptRedDotEvt")

    self._achieveBtn:removeClickListener()
    self._livenessLoader:removeClickListener()
    for k, v in ipairs(self._fiterBtns) do
        v:removeClickListener()
    end
    for i = 1, MAX_NUM do
        self["loader_box"..i]:removeClickListener()
    end
    
    UIWndActivityTask.super.onHide(self)
end

function UIWndActivityTask:onClear()
    self:unregisterAllComponent()
    self._achieveBtn = nil
    self._livenessLoader = nil
    self._fiterBtns = nil
    self._tipsLabel = nil
    self._activityLabel = nil
    self._progressbar = nil
    for i = 1, MAX_NUM do
        self["node_box"..i] = nil
        self["label_num"..i] = nil
        self["loader_box"..i] = nil
        self["spine_box"..i] = nil
        self["spine_boxh"..i] = nil
    end
    self._controlTab = nil
    if self._taskList then
        self._taskList:removeChildrenToPool()
        self._taskList:removeItemRenderer()
        self._taskList = nil
    end
    UIWndActivityTask.super.onClear(self)
end

function UIWndActivityTask:taskRender(index, obj)
    local curIndex = index + 1
    local curObjInfo = self._tasklist[curIndex]
    obj:setObjInfo(curObjInfo)
    obj:insertObjectToFactory(self)
end

function UIWndActivityTask:openFiterBtnClick(context)
    local sender = context:getSender()
    for fiterType = 1, table.nums(FITER_TYPES) do
        if fiterType == sender.fiterType then
            self._fiterBtns[fiterType]:setSortingOrder(3)
        else
            self._fiterBtns[fiterType]:setSortingOrder(1)
        end
    end
    self:openFiterView(sender)
end

function UIWndActivityTask:openFiterView(sender)
    if self._openViewType == sender.fiterType then 
        return 
    end
    self._openViewType = sender.fiterType
    self._controlTab:setSelectedIndex(self._openViewType - 1)
    self:showCurPanel()
end

function UIWndActivityTask:showCurPanel()
    local boxes = TaskModule:getALTreasureMeta(self._openViewType)
    if self._openViewType == FITER_TYPES.DAILY then
        --日常
        self._tasklist = TaskModule:getTaskList(Constant.TASK_TYPES.DAILY)
        self._tipsLabel:setText(GReadText.KEY_ACTIVITY_TASK_TIPS1)
        local dailyLiveness = TaskModule:getDailyLiveness()
        if dailyLiveness > boxes[#boxes]:getALNum() then
            dailyLiveness = boxes[#boxes]:getALNum()
        end
        self._activityLabel:setText(dailyLiveness)
        self._progressbar:setWidth(dailyLiveness/boxes[#boxes]:getALNum()*463)
    elseif self._openViewType == FITER_TYPES.WEEKLY then
        --周常
        self._tasklist = TaskModule:getTaskList(Constant.TASK_TYPES.WEEKLY)
        self._tipsLabel:setText(GReadText.KEY_ACTIVITY_TASK_TIPS2)
        local weekendLiveness = TaskModule:getWeekendLiveness()
        if weekendLiveness > boxes[#boxes]:getALNum() then
            weekendLiveness = boxes[#boxes]:getALNum()
        end
        self._activityLabel:setText(weekendLiveness)
        self._progressbar:setWidth(weekendLiveness/boxes[#boxes]:getALNum()*463)
    end
    --宝箱
    for i = 1, #boxes do
        local meta = boxes[i]
        if not meta  or not self["label_num"..i] then
            break
        end
        self["label_num"..i]:setText(meta:getALNum())
        local canOpen = TaskModule:checkBoxCanOpen(self._openViewType, i)
        if self._openViewType == FITER_TYPES.DAILY then
            if TaskModule:checkBoxOpen(FITER_TYPES.DAILY, i) then
                self["loader_box"..i]:setURL(string.format(_GURL.GetTaskPath, "icon_rcrw_mrbx"..(i+5)))
                self["spine_box"..i]:setVisible(false)
            else
                self["loader_box"..i]:setURL(string.format(_GURL.GetTaskPath, "icon_rcrw_mrbx"..i))
                self["spine_box"..i]:setVisible(canOpen)
            end
            self["spine_boxh"..i]:setVisible(false)
        else
            if TaskModule:checkBoxOpen(FITER_TYPES.WEEKLY, i) then
                self["loader_box"..i]:setURL(string.format(_GURL.GetTaskPath, "icon_rcrw_mzbx"..(i+5)))
                self["spine_boxh"..i]:setVisible(false)
            else
                self["loader_box"..i]:setURL(string.format(_GURL.GetTaskPath, "icon_rcrw_mzbx"..i))
                self["spine_boxh"..i]:setVisible(canOpen)
            end
            self["spine_box"..i]:setVisible(false)
        end
        --宝箱设置位置
        self["node_box"..i]:setX(117 + 463 * meta:getALNum() / boxes[5]:getALNum() - 5)
    end
    --任务列表
    self._taskList:setNumItems(#self._tasklist)
end

function UIWndActivityTask:resetPanel()
    self._openViewType = FITER_TYPES.DAILY
    self._controlTab:setSelectedIndex(self._openViewType - 1)
    self:showCurPanel()

    for fiterType = 1, table.nums(FITER_TYPES) do
        local missionType = fiterType + Constant.TASK_TYPES.DAILY - 1
        self._fiterBtns[fiterType]:getChild("red"):setVisible(TaskModule:getRedPoint(missionType))
    end
end

--领取任务奖励
function UIWndActivityTask:onAchieveBtnClick()
    local canAchieve = TaskModule:checkAllTask(self._openViewType)
    if not canAchieve then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_ACTIVITY_TASK_TIPS8})
        return
    end
    TaskModule:sendReceiveAllTaskReward(self._openViewType)
end

--活跃度点击
function UIWndActivityTask:onLivenessBtnClick()
    local itemSize = self._livenessLoader:getSize()
    local point = self._livenessLoader:localToGlobal({x = itemSize.width + 80, y = itemSize.height - 10})
    local liveness = self._openViewType == FITER_TYPES.DAILY and TaskModule:getDailyLiveness() or TaskModule:getWeekendLiveness()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_TEXT_TIPS, 
    {
        content = string.format(GReadText.KEY_ACTIVITY_TASK_TIPS11, liveness),
        pt = point,
    })
end

function UIWndActivityTask:onBoxClick(idx)
    local canOpen = TaskModule:checkBoxCanOpen(self._openViewType, idx)
    if canOpen then
        --领取宝箱奖励
        TaskModule:sendTaskBoxReward(self._openViewType)
    else
        --显示详细信息
        local boxes = TaskModule:getALTreasureMeta(self._openViewType)
        local meta = boxes[idx]
        local itemSize = self["loader_box"..idx]:getSize()
        local point = self["loader_box"..idx]:localToGlobal({x = itemSize.width, y = itemSize.height})
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_TEXT_TIPS, 
        {
            content = meta:getALDescribe(),
            pt = point,
            pivot = cc.p(0, 1),
        })
    end
end

function UIWndActivityTask:uptRedDotEvt(event)
    local param = event.param
    if string.find(param.name, "TaskTypeRedTips") or string.find(param.name, "TaskBoxTypeRedTips") then
        local fiterType = 0
        if string.find(param.name, "TaskTypeRedTips") then
            fiterType = tonumber(string.split(param.name, "TaskTypeRedTips")[2])
        else
            fiterType = tonumber(string.split(param.name, "TaskBoxTypeRedTips")[2])
        end
        local missionType = fiterType + Constant.TASK_TYPES.DAILY - 1
        self._fiterBtns[fiterType]:getChild("red"):setVisible(TaskModule:getRedPoint(missionType))
    end
end

return UIWndActivityTask