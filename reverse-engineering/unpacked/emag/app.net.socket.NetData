require("pack")

local pack=string.pack
local unpack=string.unpack
local sub=string.sub

local NetData = class("NetData")

NetData._szBuf = ""
NetData._iPos = 0
NetData._iSize = 0
NetData._StringBuffer = nil
NetData._error = 0

function NetData:ctor()
	self:reset()
end

function NetData:reset()
	self._szBuf = ""
	self._iPos = 1
	self._iSize = 0
	self._StringBuffer = {}
	self._error = 0
end

function NetData:prepare(data,len)
	self._szBuf = data
	self._iSize = len
end

function NetData:getReadLen()
	return self._iPos-1
end

function NetData:getDataLen()
	return self._iSize
end

function NetData:getData()
	return self:tostr()
end

function NetData:getError()
	return self._error
end

function NetData:append(str)
	table.insert(self._StringBuffer, str)
end

function NetData:set(i,str)
	local len = 0
	local strReplace = self._StringBuffer[i]
	if strReplace ~= nil then
		len = #strReplace
	end
	self._StringBuffer[i] = str
	self._iSize = self._iSize-len
	self._iSize = self._iSize+#str
end

function NetData:insert(i,str)
	table.insert(self._StringBuffer,i,str)
	self._iSize = self._iSize+#str
end

function NetData:tostr()
	return table.concat(self._StringBuffer)
end

function NetData:writeByte(byByte)
	local str = pack(">b",byByte)
	self:append(str)
	self._iSize = self._iSize+1
end

function NetData:readByte()
	if self._iPos > self._iSize then
		self._error = -1
		print("self._iPos", self._iPos, "  self._iSize", self._iSize)
		return nil 
	end
	local substr = sub(self._szBuf,self._iPos,self._iPos)
	local _,byByte = unpack(substr,">b")
	self._iPos = self._iPos + 1
	return byByte
end

function NetData:writeChar(chChar)
	local str = pack(">c",chChar)
	self:append(str)
	self._iSize = self._iSize+1
end

function NetData:readChar()
	if self._iPos > self._iSize then 
		self._error = -1
		return nil 
	end
	local substr = sub(self._szBuf,self._iPos,self._iPos)
	local _,chChar = unpack(substr,">c")
	self._iPos = self._iPos + 1
	return chChar
end

function NetData:writeWord(wWord)
	local str = pack(">H",wWord)
	self:append(str)
	self._iSize = self._iSize+2
end

function NetData:readWord()
	if self._iPos+1 > self._iSize then
		self._error = -1
		return nil 
	end
	local substr = sub(self._szBuf,self._iPos,self._iPos+1)
	local _,wWord = unpack(substr,">H")
	self._iPos = self._iPos + 2
	return wWord
end

function NetData:writeShort(shShort)
	local str = pack(">h",shShort)
	self:append(str)
	self._iSize = self._iSize+2
end

function NetData:readShort()
	if self._iPos+1 > self._iSize then 
		self._error = -1
		return nil 
	end

	local substr = sub(self._szBuf,self._iPos,self._iPos+1)
	local _,shShort = unpack(substr,">h")
	self._iPos = self._iPos + 2
	return shShort
end

function NetData:writeDword(dwDword)
	local str = pack(">I",dwDword)
	self:append(str)
	self._iSize = self._iSize+4
end

function NetData:readDword()
	if self._iPos+3 > self._iSize then
		self._error = -1 
		return nil 
	end
	local substr = sub(self._szBuf,self._iPos,self._iPos+3)
	local _,dwDword = unpack(substr,">I")
	self._iPos = self._iPos + 4
	return dwDword
end

function NetData:writeInt(iInt)
	local str = pack(">i",iInt)
	self:append(str)
	self._iSize = self._iSize+4
end

function NetData:readInt()
	if self._iPos+3 > self._iSize then 
		self._error = -1
		return nil 
	end
	local substr = sub(self._szBuf,self._iPos,self._iPos+3)
	local _,iInt = unpack(substr,">i")
	self._iPos = self._iPos + 4
	return iInt
end

function NetData:readUInt16()
    local b1 = self:readByte()
    local b2 = self:readByte()
    return (b2 * 256) + b1
end

function NetData:readInt16()
	local b1 = self:readByte()
	local b2 = self:readByte()

	if b2 > 0 then
		b2 = b2 - 256
	end
	
	local b = bit.bor(bit.lshift(b2, 8), b1)
	return b

end

function NetData:writeFloat(fFloat)
	local str = pack(">f",fFloat)
	self:append(str)
	self._iSize = self._iSize+4
end

function NetData:readFloat()
	if self._iPos+3 > self._iSize then 
		self._error = -1
		return nil 
	end
	local substr = sub(self._szBuf,self._iPos,self._iPos+3)
	local _,fFloat = unpack(substr,">f")
	self._iPos = self._iPos + 4
	return fFloat
end

function NetData:writeDouble(dbDouble)
	local str = pack(">d",dbDouble)
	self:append(str)
	self._iSize = self._iSize+8
end

function NetData:readDouble()
	if self._iPos+7 > self._iSize then 
		self._error = -1
		return nil 
	end
	local substr = sub(self._szBuf,self._iPos,self._iPos+7)
	local _,dbDouble = unpack(substr,">d")
	self._iPos = self._iPos + 8
	return dbDouble
end

function NetData:writeString(pszString,iSize)
	local len = #pszString
	if len>iSize then 
		self:writeShort(iSize)
		local str = sub(pszString,1,iSize)
		self:append(str)
		self._iSize = self._iSize+iSize
		return
	end

	self:writeShort(len)
	self:append(pszString)

	self._iSize = self._iSize+len
end

function NetData:readString(iSize)
	local len = self:readShort()
	if len == nil then
		return nil
	end
	if self._iPos+len-1 > self._iSize then 
		self._error = -1
		return nil 
	end
	if len+1 > iSize then
		self._error = -1
		return nil 
	end
	
	local substr = sub(self._szBuf,self._iPos,self._iPos+len-1)

	self._iPos = self._iPos + len

	return substr
end

function NetData:writeBuf(pbyBuf)
	self:append(pbyBuf)
	self._iSize = self._iSize+#pbyBuf
end

function NetData:readBuf(iSize)
	if self._iPos+iSize-1 > self._iSize then 
		self._error = -1
		return nil 
	end
	local substr = sub(self._szBuf,self._iPos,self._iPos+iSize-1)
	self._iPos = self._iPos + iSize
	return substr
end

function NetData:readBufs()
	local substr = sub(self._szBuf,self._iPos)
	self._iPos = self._iPos + #substr
	return substr
end

return NetData