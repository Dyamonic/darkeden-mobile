local BulletWindDivider = class("BulletWindDivider", lt.BulletBase)

--[[
    >> 撕裂之风 专属
]]

local Constant = lt.Constant
local GameBoard = lt.GameBoard
local CacheManager = lt.CacheManager
local EffectActor = lt.EffectActor

BulletWindDivider._effectActorArr = nil

function BulletWindDivider:ctor(skillId, skillLevel, direction, startPos, endPos)
    BulletWindDivider.super.ctor(self, skillId)

    self._direction = direction
    self._startPos  = startPos
    self._endPos    = endPos
    self:setPosition(self._startPos)
    
    -- 计算方向
    local offsetX = -25
    local offsetY = 15---Constant.MODEL_HERO_Y/2
    self._effectNode = display.newNode()
    self._effectNode:setPosition(offsetX, offsetY)
    self:addChild(self._effectNode)

    self._isEndEffect = false

    self:addEffectActor(skillId,skillLevel)
end

function BulletWindDivider:onClear()
    if type(self._effectActorArr) == "table" then
        for _,effectActor in ipairs(self._effectActorArr) do
            effectActor:onClear()
        end
        self._effectActorArr = nil
    end
    
    self:removeAllChildren()

    self._isEndEffect = nil
    self._effectNode = nil
end

function BulletWindDivider:addEffectActor(skillId,skillLevel)
    local actionInfoMetas = CacheManager:getBulletMetas(skillId,skillLevel)
    if type(actionInfoMetas) ~= "table" then
        return
    end

    if not self._effectActorArr then
        self._effectActorArr = {} 
    end

    for index = 1,#actionInfoMetas do
        local meta = actionInfoMetas[index]
        local anchorPoint = cc.p(0.5,0.5)
        local isLoop = false
        if index == 2 then
            isLoop = true
        end
        local effectActor = EffectActor.new(meta, self._direction, anchorPoint, isLoop)
        self._effectNode:addChild(effectActor)
        local delayTime = meta:getDelayFrame()/1000
        if index == #actionInfoMetas then
            local speed = meta:getSpeed()
            local time = math.sqrt((self._endPos.y-self._startPos.y)^2 + (self._endPos.x-self._startPos.x)^2)/speed - 0.15---0.15 - 0.06
            delayTime = time
            local perMeta = self._effectActorArr[#actionInfoMetas-1]
            if perMeta then
                perMeta:runAction(cc.Sequence:create(cc.DelayTime:create(time+0.05),cc.CallFunc:create(function()
                    perMeta:stopAllActions()
                    perMeta:setVisible(false)
                end)))
            end
        end
        effectActor:setDelayTime(delayTime)
        table.insert(self._effectActorArr,effectActor)
    end

    self._actionInfoMeta = actionInfoMetas

    self._isEndEffect = true
end

function BulletWindDivider:onUpdate()
    self:onUpdateMove()
    self:onUpdateEffect()
end

function BulletWindDivider:onUpdateMove()
    local endX, endY = self._endPos.x, self._endPos.y
    local endPos = cc.p(endX, endY)
    local curX, curY = self:getPosition()
    
    local speed = 0
    if self._actionInfoMeta[1] then
        speed = self._actionInfoMeta[1]:getSpeed()
    end

    local step = speed * GameBoard:getDeltaTime()
    local directionV = cc.pSub(endPos, cc.p(curX, curY))
    
    if cc.pGetLength(directionV) < step then
        -- 到达
        self:setPosition(endPos)

        self._waitingForClear = true
    else
        directionV = cc.pMul(cc.pNormalize(directionV), step)
        self:setPosition(curX + directionV.x, curY + directionV.y)
    end
end

function BulletWindDivider:onEnd(isLastGroupMember)
    self:onClear()
end

function BulletWindDivider:onUpdateEffect()
    if type(self._effectActorArr) == "table" then
        for _,effectActor in ipairs(self._effectActorArr) do
            effectActor:onUpdateEffect()
        end
    end
end

return BulletWindDivider
