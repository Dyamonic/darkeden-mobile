---@class UICompPetItem 宠物cell
---
local UICompPetItem = class("UICompPetItem", lt.UICompBase)
local PetModule = lt.PetModule

function UICompPetItem:ctor()
    UICompPetItem.super.ctor(self)
    --UI
    self._headLoader = nil
    self._lockImg = nil
    self._fightImg = nil
    self._levelLabel = nil
    self._selectImg = nil
    self._diImg = nil
    self._headImg = nil
end

function UICompPetItem:onClear()
    UICompPetItem.super.onClear(self)
    --UI
    self._headLoader = nil
    self._lockImg = nil
    self._fightImg = nil
    self._levelLabel = nil
    self._selectImg = nil
    self._diImg = nil
    self._headImg = nil
end

function UICompPetItem:onConstruct()
    self._headLoader = self:getChild("loader_head")
    self._lockImg = self:getChild("img_lock")
    self._fightImg = self:getChild("img_fight")
    self._levelLabel = self:getChild("label_level")
    self._selectImg = self:getChild("img_select")

    self._diImg = self:getChild("img_di")
    self._headImg = self:getChild("img_head")
    self._redImg = self:getChild("red")
end

function UICompPetItem:onEnter()
    UICompPetItem.super.onEnter(self)
end

function UICompPetItem:onExit()
    UICompPetItem.super.onExit(self)
end

function UICompPetItem:setInfo(petInfo, toppingId)
    local petMeta = petInfo.meta
    local petData = petInfo.data
    local exp = 0
    if petData then
        exp = petData:getExp()
    end
    self._levelLabel:setText(petData and string.format(GReadText.KEY_STRENGTHEN_TIPS71, PetModule:getPetLevel(exp)) or GReadText.KEY_PET_TIPS1)
    self._levelLabel:setColor(petData and cc.c3b(255, 255, 255) or cc.c3b(160, 160, 160))
    local photos = string.split(petMeta:getPhoto(), ",")
    local photo = photos[1]
    local isDie = false
    local isRed = false
    if petData then
        local stage = PetModule:getPetStateByExp(exp)
        if #photos == 1 then stage = 1 end
        photo = photos[stage]
        isDie = PetModule:isDie(petData:getDeadTime())
        
        local isDig            = petData:getDig()
        local openDigLeftTimes = petData:getOpenDigLeftTimes()
        isRed = not isDig and openDigLeftTimes ~= 0
    end
    self._headLoader:setURL(string.format(_GURL.GetImagePet, "petface_"..photo))
    self._headLoader:setGrayed(petData == nil)
    if isDie then
        self._headLoader:setColor(cc.c3b(255, 0, 0))
    else
        self._headLoader:setColor(cc.c3b(255, 255, 255))
    end
    self._diImg:setGrayed(petData == nil)
    self._headImg:setGrayed(petData == nil)
    self._lockImg:setVisible(petData and toppingId == tostring(petData:getUid()))
    self._fightImg:setVisible(petData and petData:getStatus() == 1 or false)
    self._selectImg:setVisible(false)

    self._redImg:setVisible(isRed)
end

function UICompPetItem:setSelect(select)
    self._selectImg:setVisible(select)
end

return UICompPetItem