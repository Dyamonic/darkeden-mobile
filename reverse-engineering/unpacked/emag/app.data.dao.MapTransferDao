local MapTransferDao = {}

function MapTransferDao:query(mapCode)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM GamblingShop WHERE MapCode=%d;", tonumber(mapCode))) do
    	local meta = lt.MapTransferMeta.new(row)
        return meta
    end
end

function MapTransferDao:queryAll()
    local mapTransferMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM MapTransfer") do
        local meta = lt.MapTransferMeta.new(row)
        if not mapTransferMap[meta:getMapCode()] then
            mapTransferMap[meta:getMapCode()] = {}
        end
        table.insert(mapTransferMap[meta:getMapCode()], meta)
    end
    return mapTransferMap
end

return MapTransferDao