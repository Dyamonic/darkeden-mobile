-- 背包格子管理器
---@class InventoryGridManger
local InventoryGridManger = class("InventoryGridManger")
local Constant = lt.Constant

local CELL_WIDTH = 68  -- 每个格子的宽度 (64 + 格子缝隙)
local CELL_HEIGHT = 68 -- 每个格子的高度 (64 + 格子缝隙)
local INVENTORY_START_X = 0  -- 背包在屏幕上的起始X坐标
local INVENTORY_START_Y = 0  -- 背包在屏幕上的起始Y坐标
local SpecialGrid = {
    {x = 8, y = 1},
    {x = 8, y = 2},
    {x = 8, y = 3},
}

-- InventoryGridManger._girdArray = {}
-- InventoryGridManger._itemMap = {}
function InventoryGridManger:ctor(width, height, nosp)
    self.grid = {}
    self.gridWidth = width 
    self.gridHeight = height
    -- 二维数组 ->  坐标系 
    for i = 1, self.gridHeight do
        self.grid[i] = {}
        for j = 1, self.gridWidth do
            self.grid[i][j] = nil 
        end
    end
    --没有特殊格子
    if not nosp then
        self:setSpecialGrid()
    end
end

function InventoryGridManger:updateGridData(width, height)
    if width == self.gridWidth and height == self.gridHeight then
        return
    elseif height < self.gridHeight then
        for i = self.gridHeight,height,-1 do
            for j = 1, self.gridWidth do
                self.grid[i][j] = nil 
            end
        end
    else
        for i = self.gridHeight,height do
            self.grid[i] = self.grid[i] or {}
            for j = 1, self.gridWidth do
                self.grid[i][j] = nil
            end
        end
    end

    self.gridWidth = width 
    self.gridHeight = height
    --没有特殊格子
    if not nosp then
        self:setSpecialGrid()
    end
end


function InventoryGridManger:addItemToGrid(item, i, j)
    if self.grid[i][j] == true then
        self.grid[i][j] = 2--装备的替换顺序放到背包，取出装备，背包移除，装备移除
        return
    end
    self.grid[i][j] = item
end

function InventoryGridManger:removeItemFromGrid(i, j)
    if self.grid[i] and self.grid[i][j] then
        if self.grid[i][j] == 2 then
            self.grid[i][j] = true
            return
        end
        self.grid[i][j] = nil
    end
end

function InventoryGridManger:getItemGird(i,j)
    if self.grid[i] then
        return self.grid[i][j]
    end
end

function InventoryGridManger:clear()
    for i = 1, self.gridHeight do
        self.grid[i] = {}
        for j = 1, self.gridWidth do
            self.grid[i][j] = nil 
        end
    end
end

function InventoryGridManger:getUsedNum(startH, endH)
    local usedNum = 0
    for i = startH, endH do
        for j = 1, self.gridWidth do
            if self.grid[i][j] ~= nil then
                if j == 8 and (i == 1 or i == 2 or i == 3) then
                    --specialNum = specialNum + 1
                else
                    usedNum = usedNum + 1
                end
            end
        end
    end
    return usedNum
end

---根据格子计算屏幕中心坐标
function InventoryGridManger:getCenterXY(pItem, x, y)
    local gridX = x and x or pItem:getGridX()
    local gridY = y and y or pItem:getGridY()
    local x = INVENTORY_START_X + (gridX - 1) * CELL_WIDTH + (pItem:getGridWidth() * CELL_WIDTH) / 2
    local y = INVENTORY_START_Y + (gridY - 1) * CELL_HEIGHT + (pItem:getGridHeight() * CELL_HEIGHT) / 2
    return cc.p(x, y)
end

---根据格子计算屏幕中心坐标
function InventoryGridManger:getCenterXY2(x, y, width, height)
    local gridX = x
    local gridY = y
    local x = INVENTORY_START_X + (gridX - 1) * CELL_WIDTH + (width * CELL_WIDTH) / 2
    local y = INVENTORY_START_Y + (gridY - 1) * CELL_HEIGHT + (height * CELL_HEIGHT) / 2
    return cc.p(x, y)
end

---根据格子计算屏幕中心坐标
function InventoryGridManger:getTiledCenterXY(gridX, gridY)
    local x = INVENTORY_START_X + (gridX - 1) * CELL_WIDTH +  CELL_WIDTH / 2
    local y = INVENTORY_START_Y + (gridY - 1) * CELL_HEIGHT + CELL_HEIGHT / 2
    return cc.p(x, y)
end

function InventoryGridManger:getScreenXYByGrid(gridX, gridY)
    local x = INVENTORY_START_X + (gridX - 1) * CELL_WIDTH 
    local y = INVENTORY_START_Y + (gridY - 1) * CELL_HEIGHT 
    return cc.p(x, y)
end

function InventoryGridManger:getGridSize()
   return (self.gridWidth) * CELL_WIDTH , (self.gridHeight) * CELL_HEIGHT
end

function InventoryGridManger:setGridHeight(gridHeight)
    self.gridHeight = gridHeight
end

function InventoryGridManger:getGridWH()
    return self.gridWidth, self.gridHeight
end

function InventoryGridManger:isAreaFree(gridX, gridY, width, height)
    if gridX < 1 or gridY < 1 or gridY + height - 1 > self.gridHeight or gridX + width - 1 > self.gridWidth then
        -- print("超出")
        return false
    end

    for i = gridY, gridY + height - 1  do
        for j = gridX, gridX + width -1 do
            if self.grid[i][j] then
                return false  -- 如果有任何格子已被占用，返回 false
            end
        end
    end

    return true
end

function InventoryGridManger:placeItem(gridX, gridY, width, height)
    for i = gridY, gridY + height - 1 do
        for j = gridX, gridX + width -1 do
            self.grid[i][j] = true  -- 标记格子已被占用
        end
    end
end


function InventoryGridManger:setSpecialGrid()
    for _, sp in pairs(SpecialGrid) do
        self.grid[sp.y][sp.x] = true  -- 标记格子已被占用
    end
end

--- 判断扩容背包能否替换
---@param origH number 原扩容长度
---@param replaceH number 替换扩容长度
---@param totalGrid number 背包总行数
function InventoryGridManger:checkExpandGrid(origH, replaceH, totalGrid)
    -- print("checkExpandGrid==============", origH, replaceH, endGridY)
    if replaceH >= origH then
       return true
    end
    local startPos = totalGrid - origH + replaceH
    local height = totalGrid - startPos
    ---按最后行数判断
    if self:isAreaFree(1, startPos,  Constant.INVENTORY_DEFUAL_SIZE.WIDTH, height) then
        return true
    end

    return false
end

--处理当前打开缓存
--格子缓存利用
function InventoryGridManger:pushTiledGird(gird)
    -- 清理纹理的引用
    self._girdArray[#self._girdArray + 1] = gird
end

function InventoryGridManger:popTiledGird()
    self._girdArray = self._girdArray or {}
    if #self._girdArray > 0 then
        local tiled = self._girdArray[#self._girdArray]
        self._girdArray[#self._girdArray] = nil
        return tiled
    else
        local tiled = fgui.UIPackage:createObject("Inventory", "Tiled")
        tiled:retain()
        return tiled
    end
end

function InventoryGridManger:clearTiledItem()
    if self._girdArray then
        for _, tiled in ipairs(self._girdArray) do
            tiled:release()
        end
        self._girdArray = nil
    end
    
    if self._itemMap then
        for _, items in ipairs(self._itemMap) do
            for _,v in ipairs(items) do
                v:release()
            end
        end
        self._itemMap = nil
    end
end

--背包道具循环利用
function InventoryGridManger:pushBagItem(item)
    -- 清理纹理的引用
    local gridSizeIndex = item:getItemInfo():getItemMeta():getItemSize()
    self._itemMap[gridSizeIndex][#self._itemMap[gridSizeIndex] + 1] = item
end

function InventoryGridManger:popBagItem(gridSizeIndex)
    self._itemMap = self._itemMap or {}
    self._itemMap[gridSizeIndex] = self._itemMap[gridSizeIndex] or {}
    if #self._itemMap[gridSizeIndex] > 0 then
        local item = self._itemMap[gridSizeIndex][#self._itemMap[gridSizeIndex]]
        self._itemMap[gridSizeIndex][#self._itemMap[gridSizeIndex]] = nil
        return item
    else
        local item = fgui.UIPackage:createObject("Item", "Item")
        item:retain()
        return item
    end
end
--预算道具是否在窗口内
function InventoryGridManger:isItemInWindow(itemInfo,top,down,all)
    local sizeIndex = itemInfo:getItemMeta():getItemSize()
    local gridSize = Constant.ITEMSIZE[sizeIndex]
    local itemY = 0
    if all then
        itemY = itemInfo:getItemY() + 1
    else
        local gridX,gridY = itemInfo:getFiterXY()
        itemY = gridY
    end
    if itemY == nil then
        return false
    end
    local height = gridSize.height
    if itemY + height - 1 < top then
        return false
    end
    if itemY > down then
        return false
    end
    return true
end


-------------------------- 坐标:端游的拖动逻辑--------------------------
function InventoryGridManger:canReplaceItem(pItem, x, y)
    if x > self.gridWidth or y > self.gridHeight then
        return false
    end

    local width = pItem:getGridWidth()
    local height = pItem:getGridHeight()

    if x + width -1 > self.gridWidth or y + height -1 > self.gridHeight then
        return false
    end

    --- 选中
    local pCheckItem = nil

    for i = y, y + height - 1 do
        for j = x, x + width - 1 do
            local pCurrentCheckItem = self.grid[i][j]
            if pCurrentCheckItem ~= nil then
                if pCheckItem == nil then
                    pCheckItem = pCurrentCheckItem
                else
                    if pCheckItem:getID() ~= pCurrentCheckItem:getID() then
                        ---有多个物品
                        return false
                    end
                end
            end
        end
    end

    return true, pCheckItem
end
---格子是否能放置该物品
function InventoryGridManger:canPlaceItem(pItem, gridX, gridY)
    if gridX == nil or gridY == nil then
       print("起始坐标为空")
       return false 
    end
    local gridWidth = pItem:getGridWidth()
    local gridHeight = pItem:getGridHeight()
    if gridX + gridWidth - 1 > self.gridWidth or gridY + gridHeight - 1 > self.gridHeight then
        return false 
    end
    for i = gridY, gridY + gridHeight - 1 do
        for j = gridX, gridX + gridWidth - 1 do
            if self.grid[i][j] ~= nil then
                return false -- 已经有物品占用
            end
        end
    end
    return true
end
---查找物品的格子坐标
function InventoryGridManger:getGridXYById(Id)
    for i = 1, self.gridHeight do
        for j = 1, self.gridWidth do
            if self.grid[i][j] then
                if self.grid[i][j] then
                    if self.grid[i][j]:getID() == Id then
                        local gridX, gridY = j, i
                        return gridX, gridY
                    end
                end
            end
        end
    end
    return nil, nil
end

function InventoryGridManger:findEmptyGridXY(item)
    for i = 1, self.gridHeight do 
        for j = 1, self.gridWidth do
            if self:canPlaceItem(item, i, j) then
                return i,j
            end
        end
    end
    -- print("not find empty pos")
    return nil -- 没有找到空位置
end

--根据屏幕坐标计算格子
function InventoryGridManger:getGridXYByXY(screenX, screenY)
    -- 计算相对于背包的坐标
    local relativeX = screenX - INVENTORY_START_X
    local relativeY = screenY - INVENTORY_START_Y

    -- 计算行和列
    local gridY = math.ceil(relativeY / CELL_HEIGHT)
    local gridX = math.ceil(relativeX / CELL_WIDTH)
    return gridX, gridY
end

--- 根据屏幕坐标计算装备格子起始位置
function InventoryGridManger:getGridStartXY(pItem, screenX, screenY)
    -- 计算相对于背包的坐标
    local relativeX = screenX - INVENTORY_START_X
    local relativeY = screenY - INVENTORY_START_Y

    -- 计算行和列
    local gridY = math.ceil(relativeY / CELL_HEIGHT)
    local gridX = math.ceil(relativeX / CELL_WIDTH)

    if gridY < 1 or gridY > self.gridHeight or gridX < 1 or gridX > self.gridWidth then
        -- print("超过范围1")
        return
    end

    local width = pItem:getGridWidth()
    local height = pItem:getGridHeight()
    -- 计算实际的行列，调整为格子的左上角
    local fitGridX = gridX - math.floor((width - 1) / 2)
    local fitGridY = gridY - math.floor((height - 1) / 2)
    -- print("fitGridX, fitGridY", fitGridX, fitGridY,width,height)
    if fitGridY < 1 or fitGridY + height - 1 > self.gridHeight or 
        fitGridX < 1 or fitGridX + width - 1 > self.gridWidth then
        -- print("超过范围2")
        return 
    end

    return fitGridX, fitGridY
end

return InventoryGridManger

