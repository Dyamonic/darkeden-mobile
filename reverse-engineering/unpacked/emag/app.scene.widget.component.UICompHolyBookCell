-- 圣书列表cell
---@class UICompHolyBookCell 地图块
local UICompHolyBookCell          = class("UICompHolyBookCell", lt.UIGButtonBase)

local CacheManager                = lt.CacheManager
local ItemModule                  = lt.ItemModule
local NtfManager                  = lt.NtfManager
local Constant                    = lt.Constant
local NpcModule                   = lt.NpcModule

UICompHolyBookCell.ChangeSkinConf = {
    ["NPC"] = {
        ["bg"] = "bg_daojudh_kuang_02",
    },
    ["CommonTL"] = {
        ["btnStudy"] = {
            icon = "bth_common_anniu05"
        }
    }
}
function UICompHolyBookCell:ctor()
    UICompHolyBookCell.super.ctor(self)
    self._info     = nil
    self._itemMeta = nil
end

function UICompHolyBookCell:onEnter()
    UICompHolyBookCell.super.onEnter(self)
    self._btnStudy:addClickListener(handler(self, self.btnStudyTouch))
    self._icon:addClickListener(handler(self, self.onClickIcon))
end

function UICompHolyBookCell:onExit()
    self._btnStudy:removeClickListener()
    self._icon:removeClickListener()
    UICompHolyBookCell.super.onExit(self)
end

function UICompHolyBookCell:onClear()
    self._info     = nil
    self._itemMeta = nil
    self._icon     = nil
    self._name     = nil
    self._prop     = nil
    self._level    = nil
    self._btnStudy = nil
    UICompHolyBookCell.super.onClear(self)
end

function UICompHolyBookCell:onConstruct()
    self._icon     = self:getChild("icon")
    self._name     = self:getChild("name")
    self._prop     = self:getChild("prop")
    self._btnStudy = self:getChild("btnStudy")
end

function UICompHolyBookCell:setInfo(index, info)
    local itemMeta = CacheManager:queryEquipMeta(info)
    self._name:setText(itemMeta:getName())

    -- 默认附加属性
    local str = ""
    local defaultOption = itemMeta:getDefaultOption()
    if defaultOption ~= "" then
        local defaultOptionList = string.split(defaultOption, ",")
        for k, v in ipairs(defaultOptionList) do
            local attrmeta = CacheManager:getAttributeMetaByOptionId(tonumber(v))
            if attrmeta then
                local name = attrmeta:getName()
                if k ~= #defaultOptionList then
                    name = name .. "，"
                end
                str = str .. name
            end
        end
    end
    self._prop:setText(str)
    local size = self._prop:getSize()
    if size.width > 300 then
        local scale = 300/size.width
        self._prop:setScale(scale,scale)
    else
        self._prop:setScale(1,1)
    end
    local iconPath = "equip"
    local holyBookBorrowList = NpcModule:getHolyBookBorrowHash()
    local isborrow = holyBookBorrowList[info] and true or false
    local str = isborrow and GReadText.KEY_HOLYBOOK_TIPS3 or GReadText.KEY_HOLYBOOK_TIPS4 -- "已借取" or "借取"
    -- self._btnStudy:setTouchable(not isborrow)
    self._btnStudy:setTitle(str)
    self._btnStudy:setGrayed(isborrow)
    local resUrl = string.format("ui://Item/%s_%s", iconPath, itemMeta:getIconId())
    self._icon:setURL(resUrl)
    self._itemMeta = itemMeta
    self._info = info
end

function UICompHolyBookCell:btnStudyTouch(target)
    NpcModule:onHolyBook_BorrowReq(self._info, true)
end

function UICompHolyBookCell:onClickIcon(target)
    local itemInfo = ItemModule:getItemDataByConfig(self._itemMeta)
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,
        { itemInfo = itemInfo, tipsType = Constant.EquipShowTipsType.Display })
end

return UICompHolyBookCell
