
-- simulate static variable
local BulletBase_nextBulletId = 1
local BulletBase_nextBulletGroupId = 1
local Constant = lt.Constant
local BulletBase = class("BulletBase", function()
    return display.newNode()
end)

BulletBase._bulletId        = nil
BulletBase._waitingForClear = nil
BulletBase._skillId			= nil

function BulletBase:ctor(skillId, groupId)
    self._bulletId        = BulletBase_nextBulletId
    self._waitingForClear = false
    self._skillId		  = skillId

    BulletBase_nextBulletId = BulletBase_nextBulletId + 1

	-- 一组子弹记录 为群攻子弹做标记用
	if not groupId then
		self._bulletGroupId = BulletBase_nextBulletGroupId
		BulletBase_nextBulletGroupId = BulletBase_nextBulletGroupId + 1
	else
		self._bulletGroupId = groupId
	end

    if self._skillId then
		--[[ 屏蔽音效 
    	local skillMeta = lt.CacheManager:querySkillMeta(self._skillId)
    	if skillMeta and skillMeta:getAudioFly() and skillMeta:getAudioFly() > 0 then
    		self._soundHandle = lt.AudioManager:playBattleSound(skillMeta:getAudioFly(), true)
    	end
		]]
    end
end

function BulletBase:onInit(skillId, groupId)
    self._bulletId        = BulletBase_nextBulletId
    self._waitingForClear = false
    self._skillId		  = skillId

    BulletBase_nextBulletId = BulletBase_nextBulletId + 1

	-- 一组子弹记录 为群攻子弹做标记用
	if not groupId then
		self._bulletGroupId = BulletBase_nextBulletGroupId
		BulletBase_nextBulletGroupId = BulletBase_nextBulletGroupId + 1
	else
		self._bulletGroupId = groupId
	end
end

function BulletBase:onUpdate()
end

function BulletBase:onClear()
	if self._soundHandle then
		lt.AudioManager:stopSound(self._soundHandle)
	end

	self:removeSelf()
end

-- isLastGroupMember: 是否是最后一个组员
function BulletBase:onEnd(isLastGroupMember)
	-- 爆破音效
	if self._skillId then
		--[[ 屏蔽音效 
    	local skillMeta = lt.CacheManager:querySkillMeta(self._skillId)
    	if skillMeta and skillMeta:getAudioEnd() and skillMeta:getAudioEnd() > 0 then
			lt.AudioManager:playBattleSound(skillMeta:getAudioEnd())
    	end
		]]
    end

    self:onClear()
end

-- Setter && Getter
function BulletBase:getBulletId()
    return self._bulletId
end

function BulletBase:getBulletGroupId()
    return self._bulletGroupId
end

function BulletBase:getWaitingForClear()
    return self._waitingForClear
end
function BulletBase:setWaitingForClear(isClear)
    self._waitingForClear = isClear
end

function BulletBase:getAnchorPointByDirection(direction)
    local anchorPoint = cc.p(0.5,0.5)
    if direction == Constant.DIRECTION_LEFT then
        anchorPoint = cc.p(0, 0.5)
    elseif direction == Constant.DIRECTION_RIGHT then
        anchorPoint = cc.p(1, 0.5)
    elseif direction == Constant.DIRECTION_DOWN then
        anchorPoint = cc.p(0.5, 0)
    elseif direction == Constant.DIRECTION_UP then
        anchorPoint = cc.p(0.5, 1)
    elseif direction == Constant.DIRECTION_LEFT_DOWN then
        anchorPoint = cc.p(0, 0)
    elseif direction == Constant.DIRECTION_LEFT_UP then
        anchorPoint = cc.p(0, 1)
    elseif direction == Constant.DIRECTION_RIGHT_DOWN then
        anchorPoint = cc.p(1, 0)
    elseif direction == Constant.DIRECTION_RIGHT_UP then
        anchorPoint = cc.p(1, 1)
    end

    return anchorPoint
end

function BulletBase:getOffectXYByDirection(direction)
    local offsetXY = cc.p(0,0)
    if direction == Constant.DIRECTION_LEFT then
        offsetXY = cc.p(65, Constant.MODEL_HERO_Y/2)
    elseif direction == Constant.DIRECTION_RIGHT then
        offsetXY = cc.p(-65, Constant.MODEL_HERO_Y/2)
    elseif direction == Constant.DIRECTION_DOWN then
        offsetXY = cc.p(0, Constant.MODEL_HERO_Y/2 + 42)
    elseif direction == Constant.DIRECTION_UP then
        offsetXY = cc.p(0, Constant.MODEL_HERO_Y/2 - 51)
    elseif direction == Constant.DIRECTION_LEFT_DOWN then
        offsetXY = cc.p(55, Constant.MODEL_HERO_Y/2 + 28)
    elseif direction == Constant.DIRECTION_LEFT_UP then
        offsetXY = cc.p(55, Constant.MODEL_HERO_Y/2 - 34)
    elseif direction == Constant.DIRECTION_RIGHT_DOWN then
        offsetXY = cc.p(-55, Constant.MODEL_HERO_Y/2 + 28)
    elseif direction == Constant.DIRECTION_RIGHT_UP then
        offsetXY = cc.p(-55, Constant.MODEL_HERO_Y/2 - 34)
    end

    return offsetXY
end

-- 根据方向获取旋转角
function BulletBase:getRotationByDirection(directionV, direction)
    local degree = math.deg(math.atan2(directionV.x, directionV.y))
    if direction == Constant.DIRECTION_LEFT then
        degree = 90 + degree
    elseif direction == Constant.DIRECTION_RIGHT then
        degree = -90 + degree
    elseif direction == Constant.DIRECTION_DOWN then
        degree = - 180 + degree 
    elseif direction == Constant.DIRECTION_UP then
        degree = 0 + degree
    elseif direction == Constant.DIRECTION_LEFT_DOWN then
        degree = 120 + degree
    elseif direction == Constant.DIRECTION_LEFT_UP then
        degree = 60 + degree
    elseif direction == Constant.DIRECTION_RIGHT_DOWN then
        degree = -120 + degree
    elseif direction == Constant.DIRECTION_RIGHT_UP then
        degree = -60 + degree
    end    
    return degree
end

return BulletBase
