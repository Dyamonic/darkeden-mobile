local BuffComa = class("BuffComa", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local CacheManager = lt.CacheManager

--[[
    昏迷
]]
function BuffComa:ctor(time, actor, skilllevel)    
    BuffComa.super.ctor(self, BuffEnum.EFFECT_CLASS_DEAD_BLOOD_LOSS, time, actor)
    local agent = actor:getAgent()
    local skillId = SkillEnum.SKILL_COMA
    local actionInfoMetas = CacheManager:getBuffMetas(skillId, 0)
    if agent:isVampire() then
        -- actor:playParallelEffectSpecial(skillId, {actionInfoMetas[4]})
    else
        actor:playSoleQueueSpecail(skillId, {actionInfoMetas[1],actionInfoMetas[2],actionInfoMetas[3]})
    end
end

function BuffComa:onClear()
    -- stop 播放
    self._actor:stopQueueEffect(SkillEnum.SKILL_COMA)
    BuffComa.super.onClear(self)
end

return BuffComa
