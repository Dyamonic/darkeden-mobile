---@class UICompBranchRewardItem 任务奖励item
---
local UICompBranchRewardItem = class("UICompBranchRewardItem", lt.UIGButtonBase, lt.UICompChangeSkin)
local Constant = lt.Constant
local CacheManager = lt.CacheManager
local NtfManager = lt.NtfManager
local ItemModule = lt.ItemModule

UICompBranchRewardItem.ChangeSkinConf = {
    ["Task"] = {
        ["n10"] = "bg_cwrw_djk",
    },
}

function UICompBranchRewardItem:ctor()
    UICompBranchRewardItem.super.ctor(self)
    --UI
    self._item = nil
    --数据
    self._itemMeta = nil
    self._itemInfo = nil
end

function UICompBranchRewardItem:onClear()
    --UI
    self._item = nil
    --数据
    self._itemMeta = nil
    self._itemInfo = nil
end

function UICompBranchRewardItem:onConstruct()
    self._item = fgui.UIPackage:createObject("Item", "Item")
    self:getChild("itemNode"):addChild(self._item)
    self:startSkin()
end

function UICompBranchRewardItem:onEnter()
    self._item:addClickListener(function()
        self:showTips()
    end)
end

function UICompBranchRewardItem:onExit()
    self._item:removeClickListener()
end

function UICompBranchRewardItem:setObjInfo(itemInfo)
    self._item:insertObjectToFactory(self:getRegClass())
    if itemInfo[2] == 1 then
        --圣物走特殊逻辑
        local resUrl = string.format(string.format(_GURL.GetTaskPath, "icon_cwrw_wenhao"))
        self._item:setInfo(resUrl)
        self._item:setItemNums("")
        self:getChild("num"):setText(itemInfo[5])
    else
        --非圣物
        local itemMeta = ""
        local iconPath = ""
        if itemInfo[1] == Constant.ItemType.ITEM_TYPE_PROP then
            iconPath = "prop"
            itemMeta = CacheManager:getItemMeta(itemInfo[4])
        elseif itemInfo[1] == Constant.ItemType.ITEM_TYPE_EQUIP then
            iconPath = "equip"
            itemMeta = CacheManager:queryEquipMeta(itemInfo[4])
        end
        local resUrl = string.format("ui://Item/%s_%s", iconPath, itemMeta:getIconId())
        self._item:setInfo(resUrl)
        self._item:setItemNums("")
        self:getChild("num"):setText(itemInfo[5])
        self._itemMeta = itemMeta
    end
    --设置尺寸
    local size = self:getSize()
    local itemSize = self._item:size()
    local heightS = (size.width-13)/itemSize.height
    local widthS = (size.height-13)/itemSize.width
    local scale = heightS
    if widthS < heightS then
        scale = widthS
    end
    self._item:setScale(scale, scale)
    self._itemInfo = itemInfo
end

function UICompBranchRewardItem:showTips()
    if self._itemInfo[2] == 1 then
        --圣物读其他字段
        local meta = CacheManager:getRelicSystemMeta(self._itemInfo[4])
        local itemSize = self._item:getSize()
        local point = self._item:localToGlobal({x = itemSize.width, y = itemSize.height})
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_TEXT_TIPS, 
        {
            content = meta:getTaskDescribe(),
            pt = point,
            pivot = cc.p(0, 1),
            width = 180
        })
    else
        local itemType = self._itemMeta:getItemType()
        if itemType ==  Constant.ItemType.ITEM_TYPE_PROP then
            self:showPropTips()
        elseif itemType ==  Constant.ItemType.ITEM_TYPE_EQUIP then
            self:showEquipTips()
        end
    end
end

function UICompBranchRewardItem:showPropTips()
    local itemInfo = ItemModule:getItemDataByConfig(self._itemMeta, self._itemInfo[6], self._itemInfo[5])
    local point = self._item:localToGlobal({x = self._item:getSize().width, y = 0})
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,{itemInfo = itemInfo, pt = point, pivot = cc.p(0, 0.5), tipsType = Constant.PROPTIPS_FORM.Display})
end

function UICompBranchRewardItem:showEquipTips()
    local itemInfo = ItemModule:getItemDataByConfig(self._itemMeta, self._itemInfo[6], self._itemInfo[5])
    local point = self._item:localToGlobal({x = self._item:getSize().width, y = 0})
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,{itemInfo = itemInfo, pt = point, tipsType = Constant.EquipShowTipsType.Display})
end

return UICompBranchRewardItem