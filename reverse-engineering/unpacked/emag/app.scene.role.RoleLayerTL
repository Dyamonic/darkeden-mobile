---@class RoleLayerTL 创建角色
local RoleLayerTL = class("RoleLayerTL", lt.UICompBase)
local NtfManager = lt.NtfManager
local StringManager = lt.StringManager
local RoleModule = lt.RoleModule
local SocketApi = lt.SocketApi
local AudioManager =  lt.AudioManager
local AutoFightManager = lt.AutoFightManager
local StatisticModule = lt.StatisticModule
local VersionTool = lt.VersionTool

local Content = {
    default = "未选择任何角色时显示：“请选择要使用的人物角色。创建新角色请按“创建”按钮，删除已有的角色请按角色名称旁的删除键。要链接到游戏在选择角色后请按下一步按钮”",
    clickEmpty = "选择空角色栏时显示：“点击“创建”按钮来创建新的角色”",
    create = "创建新的人类、吸血鬼、魔灵角色。设定完角色名、性别、脸型、肤色等外观设置后，人类角色可以使用重骰来设定角色的能力值，用保存或读取来储存或导入能力值；吸血鬼无法选择头发颜色和能力值；魔灵无法选择性别和肤色，而能力值可以直接修改。"
}
local OPEN = {
    SELECT = 0,
    CREATE = 1
}
function RoleLayerTL:ctor(param)
    RoleLayerTL.super.ctor(self, param)
    self._viewOpenArray = {}
    self._viewArray = {}
    self:registerComponent("CompCreateRole","CompSelectRole", "CompSelectRoleItem")

    
    self._view = fgui.UIPackage:createObject("CreateRole", "CreateRoleMain")
	self._view:setPivot(0.5, 0.5 , true)
    self._view:setPosition(display.cx, display.cy)
    self._view:makeFullScreen()
    self:addChild(self._view)
    self._selectRole = self._view:getChild("selectRole")
    self._selectRole:setRegClass(self)
    self._selectRole:insertObjectToFactory(self)
    self._createRole = self._view:getChild("createRole")
    self._createRole:setRegClass(self)
    self._createRole:insertObjectToFactory(self)

    self._btnPre = self._view:getChild("btnPre")
    self._btnNext = self._view:getChild("btnNext")
    self._openType = self._view:getController("openType")
    self._btnCreate = self._view:getChild("btnCreate")
    self._txtIntro = self._view:getChild("txtIntro")
    lt.ScheduleManager:init()
end

function RoleLayerTL:onClear()
    lt.ScheduleManager:clear()

    self._view = nil
    self._viewOpenArray = nil
    if type(self._viewArray) == "table" and #self._viewArray > 0 then 
        for _,v in ipairs(self._viewArray) do
            v:onClear()
        end
    end
    self._viewArray = nil
    self._selectRole = nil
    self._createRole = nil
    self._btnPre = nil
    self._btnNext = nil
    self._openType = nil
    self._btnCreate = nil
    self._txtIntro = nil
    self:unregisterAllComponent()
    RoleLayerTL.super.onClear(self)
end

-- 只更游戏时，客户端版本号需要重新获取
function RoleLayerTL:resetClientVer()
    local launcherVer = VersionTool:getLocalLauncherVersion()
    local gameVer = VersionTool:getLocalGameVersion()
    local appVersion = ""
    if cpp.GamePlatform and cpp.GamePlatform.getAppVersion then
        appVersion = cpp.GamePlatform:getAppVersion()
    end
    local channelId = lt.HttpApi:getChannelId()
    local concatVer = string.format("%s_%s_%s_%s_%s",device.platform, appVersion, launcherVer, gameVer, channelId)
    lt.SocketApi:setClientVer(concatVer)
end

function RoleLayerTL:onEnter()
    lt.LogUtil:debug("RoleLayerTL:onEnter")
    lt.ConnectManager:setDelegate(self)
    self:resetClientVer()
    SocketApi:addProtoListener(SocketApi._Event.CreateRole_ACK, handler(self, self.onCreateRoleAck), "RoleLayerTL:onCreateRoleAck")
    SocketApi:addProtoListener(SocketApi._Event.DelRole_ACK, handler(self, self.onDelRoleAck), "RoleLayerTL:onDelRoleAck")
    SocketApi:addProtoListener(SocketApi._Event.UnDelRole_ACK, handler(self, self.onUnDelRoleAck), "RoleLayerTL:onUnDelRoleAck")
    SocketApi:addProtoListener(SocketApi._Event.SelectRole_ACK, handler(self, self.onSelectRoleAck), "RoleLayerTL:onSelectRoleAck")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_DLG_MAIN_VIEW, handler(self, self.openDlgMainView), "RoleLayerTL:openDlgMainView")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_SELECT_ROLE_ENTER_GAME, handler(self, self.seleclRoleEnter), "RoleLayerTL:seleclRoleEnter")
    AudioManager:playMusic("blood")
    self._btnNext:addClickListener(handler(self, self.btnNextClick));
    self._btnPre:addClickListener(handler(self, self.btnPreClick));
    self._btnCreate:addClickListener(handler(self, self.btnCreateClick));
end

function RoleLayerTL:onExit()
    SocketApi:removeProtoListenerByTag("RoleLayerTL:onCreateRoleAck")
    SocketApi:removeProtoListenerByTag("RoleLayerTL:onDelRoleAck")
    SocketApi:removeProtoListenerByTag("RoleLayerTL:onUnDelRoleAck")
    SocketApi:removeProtoListenerByTag("RoleLayerTL:onSelectRoleAck")
    NtfManager:removeNtfListenerByTag("RoleLayerTL:openDlgMainView")
    NtfManager:removeNtfListenerByTag("RoleLayerTL:seleclRoleEnter")
    AudioManager:stopMusic(true)
    self._btnNext:removeClickListener();
    self._btnPre:removeClickListener();
    self._btnCreate:removeClickListener();
end

function RoleLayerTL:onBillBoardCmd(event)
    local proto = event.param
    lt.LogUtil:debug("RoleLayerTL:onBillBoardCmd:" .. proto.msg)
    local gameScene = lt.GameScene.new()
    display.runScene(gameScene)
end

function RoleLayerTL:onCreateRoleAck(event)
    local data = event.param
    if data and data._byResult == lt.CliGgProto.PROTO_SUCCESS then
        RoleModule:refreshData(data._stReply._stSucc)
        self._openType:setSelectedIndex(OPEN.SELECT)
        self._selectRole:refreshUI()
        self:statisticCreateRoleReport()
    elseif data._byResult == lt.CliGgProto.PROTO_FAILURE then
        local errorId = data._stReply._stFail._wErrCode
        if errorId then
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {content = StringManager:getStringByErrorCode(errorId)})
        end
    end
end

function RoleLayerTL:onDelRoleAck(event)
    lt.LogUtil:debug("RoleLayer:onDelRoleAck")
    local data = event.param
    if data and data._byResult == lt.CliGgProto.PROTO_SUCCESS then
        self._selectRole:delRole()
    elseif data._byResult == lt.CliGgProto.PROTO_FAILURE then
        local errorId = data._stReason._wErrCode
        if errorId then
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {content = StringManager:getStringByErrorCode(errorId)})
        end
    end
end

function RoleLayerTL:onSelectRoleAck(event)
    lt.LogUtil:debug("RoleLayer:onSelectRoleAck")
    local data = event.param
    if data and data._byResult == lt.CliGgProto.PROTO_SUCCESS then
        lt.LogUtil:debug("RoleLayer:onSelectRoleAck success")
    else
        lt.LogUtil:debug("onSelectRoleAck Fail")
    end
    --初始化设置
    local role = RoleModule:getSelectRoleInfo()
    local roleId = role:getPlayerId()
    local race = role:getJob()
    AutoFightManager:reloadConfig(roleId, race)
    AudioManager:reloadConfig()
end

function RoleLayerTL:openDlgMainView(event)
    
    local param = event.param
    local layerName = param.class
    local view = nil

    for _,v in ipairs(self._viewOpenArray) do
        if v:getParam().layerName == layerName then
            if not param.reopen or param.close then
                v:onCloseView()
            end
            -- 如果重新打开根据参数设置
            if param.reopen then
                v:setParam(param)
                v:show()
                view:setSelfPos()
                if not param then param = {} end 
                param.layerName = layerName
            end
            return
        end
    end

    for _,v in ipairs(self._viewArray) do
        if v:getParam().layerName == layerName then
            view = v
        end
    end
    if param.close then return end
    
    if view then
        view:setParam(param)
        view:show()
        view:setSelfPos()
        if not param then param = {} end 
        param.layerName = layerName
        view:checkRedTips()
        table.insert(self._viewOpenArray, view)
    else
        param.layerName = layerName
        if lt[layerName] and lt[layerName].new then
            view = lt[layerName].new(param)
        else
            yflog:Info("not found")
        end
        view:setDialogSystem(self)
        view:show()
        view:setSelfPos()
        table.insert(self._viewOpenArray, view)
        table.insert(self._viewArray, view)
    end
end


function RoleLayerTL:closeView(layerName)
    if layerName then
        for k,v in ipairs(self._viewOpenArray) do
            if v:getParam().layerName == layerName then
                v:hide()
                table.remove(self._viewOpenArray, k)
            end
        end
    end
    for k,v in ipairs(self._viewArray) do
        if v:getParam().layerName == layerName then
            table.remove(self._viewArray, k)

            v:onClear()

            break
        end
    end
end

function RoleLayerTL:btnCreateClick()
    local roleArray = RoleModule:getRoleArray()
    if table.nums(roleArray) == 3 then
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_CREATE_ROLE_TIPS1})
        return
    end
    self._openType:setSelectedIndex(1);
end

function RoleLayerTL:btnNextClick()
    local curSelect = self._openType:getSelectedIndex();
    if curSelect == 1 then
        self._createRole:createRoleCheck()
        return 
    end
    if curSelect == 0 then
        self:onClickStart()
        return  
    end
    self._openType:setSelectedIndex(curSelect + 1);
end

function RoleLayerTL:btnPreClick()
    local curSelect = self._openType:getSelectedIndex();
    if curSelect == 0 then
        -- stop all actions
        self._selectRole:stopAll()

        if _G_Game then
            _G_Game:resetScene()
        end

        lt.RoleModule:clear()
        lt.LoginCmd:logoutReq()
        lt.SocketManager:willKick()
        return 
    end
    self._openType:setSelectedIndex(curSelect - 1);
end

function RoleLayerTL:onClickStart(event)
    local roleName = self:getRoleNameCur()
    if not roleName then
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {content = GReadText.KEY_CREATE_ROLE_TIPS2})
        return
    end

    yflog:Info("lt.SocketApi:selectRoleReq roleName:%s",roleName)

    lt.SocketApi:selectRoleReq(roleName)
    self:reportHttpApiRoleInfo() --已点击进入游戏为记录点

    lt.RoleModule:setCurRoleName(roleName)

    local roleInfo = RoleModule:getSelectRoleInfo()
    local roleLevel = roleInfo:getLevel()
    local roleId = roleInfo:getPlayerId()

    -- 设置完名字后统计登录数据
    StatisticModule:statisLogin(roleId, roleLevel)
end


function RoleLayerTL:getRoleNameCur()
    local name = nil
    local roleInfo = RoleModule:getSelectRoleInfo()
    if roleInfo then
        name = roleInfo:getName()
    end
    return name
end

function RoleLayerTL:openSystemTip(event)
    local param = event.param
    self.tips:setVisible(true)
    self.tips:setText(tostring(param.content))
    fgui.GTween:to(1, 0, 1):onComplete(function()
       self.tips:setVisible(false)
    end)
end

function RoleLayerTL:showContent(text)
    self._txtIntro:setText(text)
end

function RoleLayerTL:statisticCreateRoleReport()
    local role = RoleModule:getSelectRoleInfo()
    local roleLevel = role:getLevel()
    local roleName = role:getName()
    local createTime = lt.CommonUtil:string2time(role:getCreateTime())
    local roleId = role:getPlayerId()
    local raceType = role:getJob()

    -- sdk 统计
    StatisticModule:statisCreateRole(createTime, roleId, roleLevel, roleName, raceType)
end

--用于记录上次登录区服的角色信息，下次默认就是该区服
function RoleLayerTL:reportHttpApiRoleInfo()
    local role = RoleModule:getSelectRoleInfo()
    local roleLevel = role:getLevel()
    local roleName = role:getName()
    local createTime = lt.CommonUtil:string2time(role:getCreateTime())
    local roleId = role:getPlayerId()
    local raceType = role:getJob()
    local extData = json.encode({raceType = raceType})

    --用户唯一标识(多渠道不能重复自行拼接)(服务端已拼接)
    local uuid = _G_TOKEN

    local params = {
        timestamp = createTime,
        roleName = roleName,
        roleId = roleId,
        roleLevel = roleLevel,
        uuid = uuid,
        extData = extData
    }
    lt.HttpApi:reportRoleInfo(params,function(code)
        yflog:Info("reportRoleInfo success code:%s",code)
    end, function(code)
        yflog:Info("reportRoleInfo fail :%s",code)
    end)
end

function RoleLayerTL:seleclRoleEnter()
    self:btnNextClick()
end

return RoleLayerTL
