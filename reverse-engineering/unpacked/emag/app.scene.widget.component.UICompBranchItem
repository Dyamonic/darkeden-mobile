---@class UICompBranchItem 支线任务cell
---
local UICompBranchItem = class("UICompBranchItem", lt.UIGButtonBase)
local CacheManager = lt.CacheManager
local TaskModule = lt.TaskModule
local Constant = lt.Constant
local GameModule = lt.GameModule
local TimeCounter = lt.TimeCounter
local ItemModule = lt.ItemModule
local NtfManager = lt.NtfManager

UICompBranchItem.ChangeSkinConf = {
    ["Task"] = {
        ["bg"] = "bg_zxrw_diban02",
    },
    ["CommonTL"] = {
        ["btn_sure"] = {bg = "sort"},
        ["btn_giveup"] = {bg = "sort"},
    }
}

function UICompBranchItem:ctor()
    UICompBranchItem.super.ctor(self)
    --UI
    self._titleLabel = nil
    self._targetLabel = nil
    self._stateLabel = nil
    self._rewardList = nil
    self._sureBtn = nil
    --数据
    self._taskData = nil

    self._metaTime = 0
    self._lastTime = 0
end

function UICompBranchItem:onClear()
    --UI
    self._titleLabel = nil
    self._targetLabel = nil
    self._stateLabel = nil
    self._sureBtn = nil
    --数据
    self._taskData = nil

    if self._rewardList then
        self._rewardList:removeChildrenToPool()
        self._rewardList:removeItemRenderer()
        self._rewardList = nil
    end
end

function UICompBranchItem:onConstruct()
    self._titleLabel = self:getChild("label_title")
    self._targetLabel = self:getChild("label_target")
    self._stateLabel = self:getChild("label_state")
    self._rewardList = self:getChild("list_reward")
    self._rewardList:setItemRenderer(handler(self, self.rewardRender))
    self._sureBtn = self:getChild("btn_sure")
    self._giveupBtn = self:getChild("btn_giveup")

    self:startSkin()
end

function UICompBranchItem:onEnter()
    self._sureBtn:addClickListener(handler(self, self.onSureBtnClick))
    self._giveupBtn:addClickListener(handler(self, self.onGiveupBtnClick))
end

function UICompBranchItem:onExit()
    self._sureBtn:removeClickListener()
    self._giveupBtn:removeClickListener()
end

function UICompBranchItem:timeUpdate()
    if self._metaTime <= 0 then
        return
    end

    if self._lastTime <= 0 then
        return
    end

    self:refreshTimer()
end

function UICompBranchItem:setObjInfo(taskData)
    self._taskData = taskData
    local missionId = taskData.taskId
    local meta = CacheManager:getMissionMeta(missionId)
    self._titleLabel:setText("【"..GReadText["KEY_TASKTYPE_TIPS"..meta:getMissionType()].."】"..meta:getMissionName())
    local desc = string.split(meta:getMissionObject(), ";")
    local missionTarget = meta:getMissionTarget()
    local targetStr = ""
    for i = 1, #desc do
        local cur = (taskData.hadNumMap and taskData.hadNumMap[i]) and taskData.hadNumMap[i].value or 0
        local tempStr = desc[i]
        if meta:getObjectType() == Constant.TASK_FINISH_TYPES.SEARCH then
            local itemId = tonumber(missionTarget[i][3])
            cur = ItemModule:getItemNum(itemId)
        elseif meta:getObjectType() == Constant.TASK_FINISH_TYPES.KILLMONSTER then
            local monsterId = missionTarget[i][2]
            if monsterId ~= 0 then
                local monsterCfg = CacheManager:getMonsterInfoMeta(monsterId)
                tempStr = string.format(desc[i], monsterCfg:getName())
            end
        end
        local max = tonumber(missionTarget[i][1])
        if cur > max then cur = max end
        local colorStr = cur < max and "[color=#ffffff]" or "[color=#00ff00]"
        targetStr = targetStr..colorStr..tempStr.."("..cur.."/"..max..")".."[/color]"
        if i < #desc then
            targetStr = targetStr.."<br>"
        end
    end
    self._targetLabel:setText(targetStr)
    local rewardList = meta:getReward() or {}
    self._rewardList:setNumItems(#rewardList)
    local state = taskData.taskState
    if state == Constant.TASK_STATE.START then
        local isComplete = TaskModule:checkTaskComplete(taskData)
        self._sureBtn:setText(isComplete and GReadText.KEY_ACTIVITY_TASK_TIPS4 or GReadText.KEY_ACTIVITY_TASK_TIPS3)
    elseif state == Constant.TASK_STATE.FINISH then
        self._sureBtn:setText(GReadText.KEY_ACTIVITY_TASK_TIPS4)
    end
    
    --倒计时
    self._metaTime = meta:getTime()
    if self._metaTime > 0 then
        self:refreshTimer()
    end

    self._stateLabel:setVisible(meta:getTime() > 0)
    self._giveupBtn:setVisible(meta:getMissionSkip() == 1)
    -- self._giveupBtn:setX(meta:getMissionType() == Constant.TASK_TYPES.BRANCH and 510 or 619)
    if meta:getMissionSkip() == 1 then
        self._giveupBtn:setVisible(true)
        self._rewardList:setX(223)
    else
        self._giveupBtn:setVisible(false)
        self._rewardList:setX(323)
    end
end

function UICompBranchItem:rewardRender(index, obj)
    local curIndex = index + 1
    local missionId = self._taskData.taskId
    local meta = CacheManager:getMissionMeta(missionId)
    local rewardList = meta:getReward()
    local curObjInfo = rewardList[curIndex]
    obj:setRegClass(self:getRegClass())
    obj:setObjInfo(curObjInfo)
    obj:insertObjectToFactory(self:getRegClass())
end

function UICompBranchItem:refreshTimer()
    local serverTime = TimeCounter:serverTime()
    local cdTime = self._taskData.expirationTime
    local lastTime = cdTime - serverTime
    self._stateLabel:setText(lastTime > 0 and lt.CommonFunc:secondsToTime2(lastTime) or GReadText.KEY_ACTIVITY_TASK_TIPS6)
    self._stateLabel:setColor(lastTime <= 300 and Constant.COLORS.red or Constant.COLORS.lightblue)
    local state = self._taskData.taskState
    if state == Constant.TASK_STATE.FINISH then
        self._stateLabel:setText(GReadText.KEY_ACTIVITY_TASK_TIPS7)
        self._stateLabel:setColor(Constant.COLORS.green)
    end

    self._lastTime = lastTime
end

function UICompBranchItem:onSureBtnClick()
    local missionId = self._taskData.taskId
    local state = self._taskData.taskState
    if state == Constant.TASK_STATE.FINISH then
        --领取奖励
        TaskModule:sendTaskReward(missionId)
    elseif state == Constant.TASK_STATE.START then
        local meta = CacheManager:getMissionMeta(missionId)
        --是否达成条件
        local taskData = TaskModule:getTaskById(missionId)
        local isComplete = TaskModule:checkTaskComplete(taskData)
        if isComplete then
            --完成任务
            TaskModule:sendTaskCommit(meta:getAcceptanceNPCID(), missionId)
        else
            --前往
            local race = GameModule:getHeroRace()
            if meta:getMissionId() == Constant["ADVANCE_TASK"..race].COLUMN then
                lt.MapModule:sendMirrorOfAbyss()
            else
                local transferPoint = meta:getTransferPoint()
                if transferPoint ~= nil then
                    TaskModule:sendTaskJumpUp(missionId)
                else
                    local functionId = meta:getFunctionId()
                    if functionId ~= nil then
                        GameModule:gotoSystemFunc(functionId)
                    end
                end
            end
        end
    end
end

--放弃任务
function UICompBranchItem:onGiveupBtnClick()
    local missionId = self._taskData.taskId
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {type = 2, content = GReadText.KEY_TASK_TIPS10,
    confirmCallback = function()
        TaskModule:sendTaskGiveup(missionId)
    end})
end

return UICompBranchItem