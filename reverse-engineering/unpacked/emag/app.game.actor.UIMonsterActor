---ui类怪物
local UIMonsterActor = class("UIMonsterActor",lt.ActionBaseActor)

local Constant = lt.Constant
local ActionManager = lt.ActionManager
local CacheManager = lt.CacheManager

local offsetX, offsetY = -25, 15

function UIMonsterActor:ctor(scale)
    UIMonsterActor.super.ctor(self)
    scale = scale or 1
    self._petNode = display.newNode()
    self:addChild(self._petNode, 1)
    self._petNode:setScale(scale)
    self._petNode:setPosition(offsetX*scale, offsetY*scale)

    self._spriteHero = display.newSprite()
    self._petNode:addChild(self._spriteHero)
end

--怪物模型
function UIMonsterActor:initActionInfo()
    local modelId = self._actionId
    self._actionInfo = ActionManager:getActionMonsterInfo("monster", modelId, 0, self._direction or Constant.DIRECTION_DOWN)
end

function UIMonsterActor:setMonsterCfg(monsterCfg)
    if monsterCfg then
        self._monsterCfg = monsterCfg
    end
end

function UIMonsterActor:onClear()
    UIMonsterActor.super.onClear(self)
    self._petNode = nil
    self._spriteHero = nil
    self._actionInfo = nil
    self._monsterCfg = nil
end

function UIMonsterActor:onUpdate()
    self:onUpdateAction()
    self:changeModelColor(self._spriteHero)
end

function UIMonsterActor:updateFrame()
    if not self._actionInfo then
        return
    end
    if not self._hideSprite then
        self._spriteHero:setVisible(true)
        local frameCount = self._actionInfo:getSpriteFrameCount()
        local frame = self._actionInfo:getSpriteFrame(self._nextFrameIndex)
        if frame then
            self._spriteHero:setSpriteFrame(frame.sprite)
            local pos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frame.x, frame.y), frame.size)
            self._spriteHero:setPosition(pos)
        end
        if self._nextFrameIndex >= frameCount then
            self._nextFrameIndex = 1
        else
            self._nextFrameIndex = self._nextFrameIndex + 1
        end
    else
        self._spriteHero:setVisible(false)
    end
end

function UIMonsterActor:changeModelColor(node, params)
    if self._monsterCfg == nil then
        return
    end
    params = params or {}
    local spAllColor = self._monsterCfg:getColor()
    local destClothColor = self._monsterCfg:getDestClothColor() or cc.vec3(1.0, 1.0, 1.0)
    if params.ignoreSpColor then
        spAllColor = nil
    end
    local param = {
        node = node,
        colorB = destClothColor,
        colorG32B = nil,
        colorG64B = nil,
        colorG96B = nil,
        darkFactor = params.darkFactor,
        originColor = spAllColor,
    }
    lt.ShaderBackendUtil:makeMulModelEffect(param.node, param)
end

function UIMonsterActor:changeModelGryColor(node)
    local param = {
        node = node,
        originColor = cc.vec4(0.5, 0.5, 0.5, 1),
        grayOffset = 2.5
    }
    lt.ShaderBackendUtil:makeMulModelEffect(param.node, param)
end

function UIMonsterActor:setScale(scale)
    self._petNode:setScale(scale)
    self._petNode:setPosition(offsetX*scale, offsetY*scale)
end

return UIMonsterActor