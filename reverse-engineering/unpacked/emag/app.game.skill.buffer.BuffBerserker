local BuffBerserker = class("BuffBerserker", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local ScheduleUtil  = lt.ScheduleUtil

--[[
    狂暴
]]
function BuffBerserker:ctor(time, actor, skilllevel)    
    BuffBerserker.super.ctor(self, BuffEnum.EFFECT_CLASS_BERSERKER, time, actor)
    -- 播放手上动画
    actor:playBeserkerEffect(SkillEnum.SKILL_BERSERKER)
end

function BuffBerserker:onClear()
    self._actor:removeBindingEffect(SkillEnum.SKILL_BERSERKER)

    BuffBerserker.super.onClear(self)

end

return BuffBerserker
