
local ActionInfoDao = {}

--[[
function ActionInfoDao:query(id)
    local tb = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM SkillEffect WHERE SkillId=%d;", id)) do
    	local meta = lt.ActionInfoMeta.new(row)
        table.insert(tb, meta)
    end

    return tb
end
]]

function ActionInfoDao:queryAll()
    local tb = {}
    local db = lt.DbManager:getDb()
     
    for row in db:nrows("SELECT * FROM SkillEffect") do
    	local meta = lt.ActionInfoMeta.new(row)
        if not tb[meta:getSkillId()] then
            tb[meta:getSkillId()] = {}
        end

        table.insert(tb[meta:getSkillId()], meta)
    end

    return tb
end

return ActionInfoDao
