
local BaseScene = class("BaseScene", function()
    return display.newScene("BaseScene")
end)

function BaseScene:ctor()
    self:enableNodeEvents()
    self._groot = fgui.GRoot:create(self, 3)
    self._groot:retain()
end

function BaseScene:onCleanup()
    self:onClear()
end

function BaseScene:onClear()
    yflog:Info("BaseScene:onClear():%s",self.class.__cname)
    for url,extensiton in pairs(GREG_URL_EXTENDS or {}) do
        if extensiton.obj then
            extensiton.obj:release()
            extensiton.obj = nil
        end
    end
    GREG_URL_EXTENDS = nil
    self._groot:release()
    self._groot = nil
end



function BaseScene:getClassName()
    local className = self.class and self.class.__cname or self.__cname
    return className
end

-- 注册Component
function BaseScene:registerComponent( ... )
    for _, component in ipairs( { ... } ) do
        lt.FGuiManager:registerComponent(self:getClassName(), component)
    end
end

function BaseScene:unregisterComponent( ... )
    for _, component in ipairs( { ... } ) do
        lt.FGuiManager:unregisterComponent(self:getClassName(), component)
    end
end

function BaseScene:unregisterAllComponent()
    lt.FGuiManager:unregisterAllComponent(self:getClassName())
end

-- 管理fgui创建的obj组件
function BaseScene:insertObjectToFactory(node)
    if not node then
        yflog:Error("BaseScene:insertToFactory error node is nil self name:%s", self.__cname)
        return
    end

    local className = node.class and node.class.__cname or node.__cname
    lt.FGuiManager:insertObjectToFactory(className, self:getClassName(), self)
end

return BaseScene
