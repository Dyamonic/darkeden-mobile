---@class CompSkillItem 技能组件
local CompSkillItem = class("CompSkillItem", lt.UIGButtonBase)
local SkillModule = lt.SkillModule
local ShaderBackendUtil = lt.ShaderBackendUtil
function CompSkillItem:ctor()
    CompSkillItem.super.ctor(self)
    self._cyanIcon = nil
end

function CompSkillItem:onConstruct()
    self._icon = self:getChild('icon')
    self._condition = self:getChild('condition')
    self._isEquip = self:getChild('isEquip')
end

function CompSkillItem:onClear()
    self._icon = nil
    self._condition = nil
    self._isEquip = nil
    self._cyanIcon = nil
    CompSkillItem.super.onClear(self)
end

function CompSkillItem:onEnter()
    CompSkillItem.super.onEnter(self)
end

function CompSkillItem:onExit()
    CompSkillItem.super.onExit(self)
end

function CompSkillItem:setItemInfo(skillId, isEquip)
    local iconId = SkillModule:getSkillIcon(skillId)
    self._icon:setURL(string.format(_GURL.GetImageSkill, iconId))
    self:setEquip(isEquip)
    local isCondition = SkillModule:isBtnUICondition(skillId)

    local skillMeta = lt.CacheManager:querySkillMeta(skillId)

    --青色被动
    if not self._cyanIcon then
        local size = self._icon:getSize()
        local resPath = string.format("ui://Skill/%s", skillMeta:getSpriteID())
        self._cyanIcon = fgui.UIPackage:createObjectFromURL(resPath)
        self:addChild(self._cyanIcon)
        self._cyanIcon:setPivot(0.5,0.5,true)
        self._cyanIcon:setPosition(size.width/2, size.height/2)
        self._cyanIcon:setColor(cc.c3b(0,255,0))
        self._cyanIcon:setScale(1.5,1.5)
        --[[
            cocos4.0 FIXME:To be verified, shader change use.
        ]] 
        ShaderBackendUtil:makeCyanEffect(self._cyanIcon:displayObject())
    end
    self._cyanIcon:setVisible(skillMeta:getPassiveSkill() == 1)

    --被动始终生效
    if skillMeta:getPassiveSkill() == 1 then
        isCondition = true
    end
    self._condition:setVisible(not isCondition)
end

function CompSkillItem:setEquip(isEquip)
    self._isEquip:setVisible(isEquip)
end



return CompSkillItem