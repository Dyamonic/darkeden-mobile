local BuffSnipingMode = class("BuffSnipingMode", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum

--[[
    狙击
]]
function BuffSnipingMode:ctor(time, actor, skilllevel)    
    BuffSnipingMode.super.ctor(self, BuffEnum.EFFECT_CLASS_SNIPING_MODE, time, actor)
end

function BuffSnipingMode:onClear()
    self._actor:stopSnipingEffect()

    BuffSnipingMode.super.onClear(self)
end

return BuffSnipingMode
