local SkillEnum = lt.SkillEnum
local CacheManager = lt.CacheManager
local MRippleZonePixelEffectGenerator = class("MRippleZonePixelEffectGenerator",lt.MEffectGenerator)
local Constant = lt.Constant
-- Global
------------------------------------------------------------------------
--MRippleZonePixelEffectGenerator	g_RippleZoneEffectGenerator;

------------------------------------------------------------------------
-- Generate
------------------------------------------------------------------------
function MRippleZonePixelEffectGenerator:generate(egInfo)

	--------------------------------------------------------------
	-- 이번에는 시작좌표(sx,sy)에 Effect를 출력하고
	-- 다음에는 (tx,ty)에 Effect를 출력하게 된다.
	-- MEffectTarget을 수정하면 가능하다.
	--------------------------------------------------------------
	local pTarget = egInfo.pEffectTarget;
	local currentPhase = egInfo.currentPhase

	-- 시작 좌표
	local sx = egInfo.x0;
	local sy = egInfo.y0;
	local sz = 0;--egInfo.z0;

	-- 목표 좌표
	local tx = egInfo.x1; 
	local ty = egInfo.y1;
	local tz = 0;--egInfo.z1;

	local tx2 = tx;
	local ty2 = ty;

	local est = egInfo.effectSpriteType;

	local skillId = egInfo.skillId

	--------------------------------------------------------------
	-- 하드코딩.. ㅋㅋ
	--------------------------------------------------------------
	local bPixelStepMove = false;
	local bGroundEffect = false;
	local bResetTarget = true;
	local startMoveStep = 0;

	--------------------------------------------------------------
	-- Power of Land
	--------------------------------------------------------------
	if (skillId == SkillEnum.SKILL_POWER_OF_LAND or skillId == SkillEnum.SKILL_BOMB_CRASH_WALK) then
		bGroundEffect = true;
		bPixelStepMove = true;
		startMoveStep = 1;
		bResetTarget = false
	end
	-- if (est==EFFECTSPRITETYPE_POWER_OF_LAND_STONE_1)
	
	-- 	-- 1~3사이에 하나를 선택한다.
	-- 	est = EFFECTSPRITETYPE_POWER_OF_LAND_STONE_2 + rand()%3;
		
	-- 	bGroundEffect = true;
	-- 	bPixelStepMove = true;
	-- 	startMoveStep = 1;
	-- 	bResetTarget = false;
	-- end
	--------------------------------------------------------------
	-- Earthquake
	--------------------------------------------------------------
	if (skillId==SkillEnum.SKILL_EARTHQUAKE) then
	
		-- 1~3사이에 하나를 선택한다.
		-- est = EFFECTSPRITETYPE_EARTHQUAKE_1 + rand()%3;
		bGroundEffect = true;
		bPixelStepMove = true;
		startMoveStep = 3;
		bResetTarget = true
	end
	--------------------------------------------------------------
	-- Transfusion
	--------------------------------------------------------------

	if(skillId == SkillEnum.SKILL_TRANSFUSION) then
	
		local pt = cc.p(egInfo.targetX, egInfo.targetY)
		
		local rectEffect = {
			left = egInfo.x0 + (Constant.TILE_X_HALF / 2),
			top = egInfo.y0 + (Constant.TILE_Y_HALF / 2),
			right = egInfo.x0 + Constant.TILE_X_HALF,
			bottom = egInfo.y0 + Constant.TILE_Y_HALF
		}

		local rectChar = {
			left = pt.x,
			top = pt.y,
			right = pt.x + Constant.TILE_X_HALF,
			bottom = pt.y + Constant.TILE_Y_HALF
		}

		if (rectChar.left <= rectEffect.right
		and rectChar.right >= rectEffect.left
		and rectChar.top <= rectEffect.bottom
		and rectChar.bottom >= rectEffect.top) then
			return false;
		end
		

		bGroundEffect = true;
		bPixelStepMove = true;
		startMoveStep = 1;
	end

	if (bPixelStepMove) then
	
		-- 목표까지가는게 아니라.. 일정한 pixel수 만큼 가야한다?
		-- 한 단계 이동..
		local movePixel = egInfo.step;-- * egInfo.count;

		local cx = sx-tx;
		local cy = sy-ty;
		if (bResetTarget and (cx==0 or cy==0) ) then

			local sX, sY = lt.MapUtil:PixelToMap(sx, sy) --转化为地图格子
			local x, y=sX, sY;
			local x, y = self:GetPositionToDirection(x,y, egInfo.direction);

			local tx, ty = lt.MapUtil:MapToPixel(x, y)

			cx = sx - tx;
			cy = sy - ty;
		end

		local currentPixel = math.sqrt(cx*cx + cy*cy);

		local basis = ((cx==0) and  0 or cy / cx);

		if (currentPixel~=0) then
					
			movePixel = movePixel * (1.0 - math.abs(cy / (2.0*currentPixel)));
		
			if (currentPhase==1) then
			
				movePixel = movePixel * startMoveStep;
			end
			local movePixel2 = bit.lshift(movePixel, 1)-- movePixel<<1;
			tx = sx - (cx * movePixel / currentPixel);
			ty = sy - (cy * movePixel / currentPixel);

			tx2 = sx - (cx * movePixel2 / currentPixel);
			ty2 = sy - (cy * movePixel2 / currentPixel);
		end
	end
	local effectMeta = nil
	if skillId == SkillEnum.SKILL_POWER_OF_LAND  then
		local effectMetas = CacheManager:getProcessMetas(skillId)
		effectMeta = effectMetas[1]
	elseif skillId == SkillEnum.SKILL_EARTHQUAKE then
		local effectMetas = CacheManager:getSkillEffectBySkillIdAndGenerator(skillId, 21)
		effectMeta = effectMetas[1]
	elseif skillId == SkillEnum.SKILL_BOMB_CRASH_WALK then
		local effectMetas = CacheManager:getProcessMetas(skillId)
		effectMeta = effectMetas[2]
	elseif skillId == SkillEnum.MAGIC_BLOODY_SNAKE then
		local effectMetas = CacheManager:getProcessMetas(skillId)
		effectMeta = effectMetas[1]
	elseif skillId == SkillEnum.SKILL_TRANSFUSION then
		local effectMetas = CacheManager:getProcessMetas(skillId)
		effectMeta = effectMetas[1]
	end

	local reX, reY = tx, ty
	self:setPreXY(reX, reY)
	if bResetTarget then
		self:setTargetXY(tx2, ty2)
	end
	local bullet = lt.BullectScreenEffect.new(skillId, egInfo.direction, cc.p(reX, reY))
	bullet:addEffect(skillId, effectMeta)

	local zorderOffset = 1 
	if skillId == SkillEnum.SKILL_POWER_OF_LAND then
		zorderOffset = - 1000
	end
	local bM, bN = lt.MapUtil:PixelToMap(reX, reY)
	local zorder = (bN  * 10000 + bM + 9999) * 10 + zorderOffset
	lt.BulletManager:addBulletToMapZOrder(bullet, zorder)
end

function MRippleZonePixelEffectGenerator:setPreXY(reX, reY)
	self._reX, self._reY = reX, reY
end
function MRippleZonePixelEffectGenerator:getPreXY()
	return self._reX, self._reY
end

function MRippleZonePixelEffectGenerator:setTargetXY(tX, tY)
	self._targetX, self._targetY = tX, tY
end
function MRippleZonePixelEffectGenerator:getTargetXY()
	return self._targetX, self._targetY
end

function MRippleZonePixelEffectGenerator:GetPositionToDirection(x, y, direction)
	if direction == Constant.DIRECTION_LEFT_DOWN then
		x = x - 1
		y = y + 1
	elseif direction == Constant.DIRECTION_RIGHT_UP then
		x = x + 1
		y = y - 1
	elseif direction == Constant.DIRECTION_LEFT_UP then
		x = x - 1
		y = y - 1
	elseif direction == Constant.DIRECTION_RIGHT_DOWN then
		x = x + 1
		y = y + 1
	elseif direction == Constant.DIRECTION_LEFT then
		x = x - 1
	elseif direction == Constant.DIRECTION_DOWN then
		y = y + 1
	elseif direction == Constant.DIRECTION_UP then
		y = y - 1
	elseif direction == Constant.DIRECTION_RIGHT then
		x = x + 1
	end
	return x, y
end

return MRippleZonePixelEffectGenerator
