---@class UICompWelfareGiftRewardCell
--- 开服福利子对象
local UICompWelfareGiftRewardCell = class("UICompWelfareGiftRewardCell", lt.UICompBase)
local Constant                 = lt.Constant
local CacheManager             = lt.CacheManager
local NtfManager               = lt.NtfManager
local ItemModule               = lt.ItemModule
local WelfareModule            = lt.WelfareModule

function UICompWelfareGiftRewardCell:ctor(param)
    UICompWelfareGiftRewardCell.super.ctor(self,param)
end

function UICompWelfareGiftRewardCell:onClear()
    if self._rewardList then
        self._rewardList:removeChildrenToPool()
        self._rewardList:removeEventListener(fgui.UIEventType.ClickItem)
        self._rewardList:removeItemRenderer()
        self._rewardList = nil
    end
    if self._btnReward then
        self._btnReward:removeClickListener()
        self._btnReward = nil
    end
    self._textTitle     = nil
    self._btnReward     = nil
    UICompWelfareGiftRewardCell.super.onClear(self)
end

function UICompWelfareGiftRewardCell:onConstruct()
    self._textTitle    = self:getChild("title")
    self._btnReward    = self:getChild("reward")
    self._rewardList = self:getChild("listreward")
    self._rewardList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    self._btnReward:addClickListener(handler(self, self.onBtnGotoClick))
    self._rewardList:setItemRenderer(handler(self, self.onRenderItem))
end

function UICompWelfareGiftRewardCell:setInfo(data,menuIndex,fiterType)
    self._data = data
    self._menuIndex = menuIndex
    self._fiterType = fiterType
    self._textTitle:setText(data:getName())
    self._rewardData = data.Reward
    self._rewardList:setNumItems(#self._rewardData)
    local state = WelfareModule:checkRewardStates(self._fiterType,data)
    self._btnReward:getController("state"):setSelectedIndex(state)
    if state == Constant.WELFARESTATE.TIMEOUT then
        self._btnReward:getChild("red"):setVisible(false)
        self._btnReward:getChild("title"):setText(GReadText.KEY_ACTIVITY_TIPS4)
        self._btnReward.enabled = false
    elseif state == Constant.WELFARESTATE.CANREWARD then
        self._btnReward:getChild("title"):setText(GReadText.KET_MAIL_TIPS11)
        self._btnReward:getChild("red"):setVisible(true)
        self._btnReward.enabled = true
    elseif state == Constant.WELFARESTATE.GETOVER then
        self._btnReward:getChild("red"):setVisible(false)
        self._btnReward:getChild("title"):setText(GReadText.KET_MAIL_TIPS10)
        self._btnReward.enabled = false
    end
end

function UICompWelfareGiftRewardCell:onRenderItem(index, obj)
    local itemData = self._rewardData[index + 1]
    local itemType = tonumber(itemData[1])
    local itemMeta = ""
    local iconPath = ""
    if itemType == Constant.ItemType.ITEM_TYPE_PROP then
        iconPath = "prop"
        itemMeta = CacheManager:getItemMeta(tonumber(itemData[2]))
    elseif itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
        iconPath = "equip"
        itemMeta = CacheManager:queryEquipMeta(tonumber(itemData[2]))
    end
    local resUrl = string.format("ui://Item/%s_%s", iconPath, itemMeta:getIconId())
    obj:getChild("icon"):setURL(resUrl)
    obj:getChild("lbl_count"):setText(itemData[3])
    obj.itemData = itemData
end

function UICompWelfareGiftRewardCell:onClickItem(context)
    local data     = context:getData()
    local itemData = data.itemData
    if tonumber(itemData[1]) == Constant.ItemType.ITEM_TYPE_PROP then
        local itemMeta = CacheManager:getItemMeta(tonumber(itemData[2]))
        local itemInfo = ItemModule:getItemDataByConfig(itemMeta, nil, tonumber(itemData[3]))
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_ITEM_TIPS,
            { itemInfo = itemInfo, tipsType = Constant.PROPTIPS_FORM.WILD })
    elseif tonumber(itemData[1]) == Constant.ItemType.ITEM_TYPE_EQUIP then
        local itemMeta = CacheManager:queryEquipMeta(tonumber(itemData[2]))
        local itemInfo = ItemModule:getItemDataByConfig(itemMeta, nil, tonumber(itemData[3]))
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,
            { itemInfo = itemInfo, tipsType = Constant.EquipShowTipsType.Display })
    end
end

function UICompWelfareGiftRewardCell:onBtnGotoClick()
    if self._btnReward and self._btnReward.enabled then
        WelfareModule:getGiftReward(self._fiterType,self._data)
    end
end

return UICompWelfareGiftRewardCell
