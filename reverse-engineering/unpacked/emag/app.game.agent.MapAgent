
local MapAgent = class("MapAgent", lt.BaseAgent)

local MapManagerInstance = cpp.MapManager:getInstance()

local MapUtil = lt.MapUtil
local Constant = lt.Constant
local ServerClientEnum = lt.ServerClientEnum
local CacheManager = lt.CacheManager
local GameModule = lt.GameModule
local ResUtil = lt.ResUtil
local AutoFightManager = lt.AutoFightManager

MapAgent._mapData  = nil
MapAgent._mapMeta  = nil
MapAgent._mapActor = nil

MapAgent._agentSystem = nil

MapAgent._lastX1 = nil
MapAgent._lastY1 = nil
MapAgent._lastX2 = nil
MapAgent._lastY2 = nil
MapAgent._lastX3 = nil
MapAgent._lastY3 = nil

MapAgent._up    = 0
MapAgent._down  = 0
MapAgent._right = 0
MapAgent._left  = 0

-- 当前地图是否屏蔽技能
MapAgent._skillSlience  = false

function MapAgent:ctor()
    MapAgent.super.ctor(self, Constant.AGENT_TYPE_MAP)
    
    self._mapActor = lt.MapActor.new(self._mapData)

    self._agentSystem = lt.AgentSystem.new()

    self._musicOn = false
    self._musicInfo = nil
    self._musicCheckElapse = 0
    self._musicCheckInterval = 1

    self._safeAreaCheckElapse   = 0
    self._safeAreaCheckInterval = 0.1
end

function MapAgent:onClear()
    self._mapActor:onClear()

    self._mapData = nil
    self._mapActor = nil
    self._agentSystem = nil

    self._musicOn = nil
    self._musicInfo = nil
    self._musicCheckElapse = nil
    self._musicCheckInterval = nil

    self._safeAreaCheckElapse   = nil
    self._safeAreaCheckInterval = nil

    if self._mapSaftProtalActor then
        self._mapSaftProtalActor:onClear()
        self._mapSaftProtalActor = nil
    end

    lt.AudioManager:stopMusic(true)
end

function MapAgent:onUpdate()
    self._mapActor:onUpdate()
end
function MapAgent:getMapName()
    return self._mapName
end

function MapAgent:loadMap(mapMeta)
    if self._mapMeta then
        self._preMapCode = self._mapMeta:getMapCode()
    end
    self._mapMeta = mapMeta
    self._mapName = mapMeta:getMapName()
    local path = string.format("map/data/%s.bin", mapMeta:getResCode())
    local objPath = string.format("map/object/%s.obj", mapMeta:getResCode())

    -- yflog:Info("path: ", path)

    self._mapData = MapManagerInstance:loadMapDataAndObject(path, objPath)
    self._mapActor:setMapMeta(mapMeta)
    self._mapActor:loadMap(self._mapData)

    -- 原传奇用户地图黑边修正
    self._up = 0
    self._down =  0
    self._right = 0
    self._left  = 0

    -- 加载地图安全区和跳转点rect文件
    self:loadMapSafeProtalData(mapMeta)

    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_CHANGE_MAP, {mapMeta=mapMeta})

    

    -- TODO:切换地图背景音乐
    lt.AudioManager:randomPlayMusic()

    -- 地图背景音乐
    -- lt.AudioManager:stopMusic(true)
    -- self._musicOn = false
    -- self._musicId = nil

    self._musicInfo = nil
    if self._mapMeta:getMusicId() and self._mapMeta:getMusicId() ~= "" then
        local musicInfo = json.decode(self._mapMeta:getMusicId()) or {}
        if musicInfo then
            self._musicInfo = musicInfo
        end
    end

    lt.ActionManager:stepRemove()

    -- 安全区载入
    if self._inSafeArea then
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SAFETY_AREA_OUT)
    end
    self._inSafeArea = false
    self._safeAreaArray = nil

 
    lt.TaskModule:removeTaskTransferFlag()

    --[[ 地图限制条件 ]]
    self:setMapSkillSlience(self._mapMeta:isLimitSkill())  -- 本地图是否限制技能释放

    --停止挂机
    AutoFightManager:endAutoFight(true)

    self:setMapScale()
end

function MapAgent:updateMusic(m, n)
    self._musicCheckElapse = self._musicCheckElapse + lt.GameBoard:getDeltaTime()
    if self._musicCheckElapse < self._musicCheckInterval then
        return
    end
    self._musicCheckElapse = self._musicCheckElapse - self._musicCheckInterval

    if not self._musicInfo then
        if self._musicId then
            self._musicId = nil
            lt.AudioManager:stopMusic(true)
        end
        return
    end

    local musicId = nil
    for _, musicInfo in ipairs(self._musicInfo) do
        while true do
            if type(musicInfo) ~= "table" or #musicInfo ~= 9 then
                break
            end

            local p1 = cc.p(musicInfo[2], musicInfo[3])
            local p2 = cc.p(musicInfo[4], musicInfo[5])
            local p3 = cc.p(musicInfo[6], musicInfo[7])
            local p4 = cc.p(musicInfo[8], musicInfo[9])

            local musicOn = lt.MapUtil:inRhombus(m, n, p1, p2, p3, p4)
            if musicOn then
                musicId = musicInfo[1]
            end

            break
        end
    end

    if self._musicId and (not musicId or self._musicId ~= musicId) then
        self._musicId = nil
        lt.AudioManager:stopMusic(true)
    end

    if musicId and (not self._musicId or self._musicId ~= musicId) then
        self._musicId = musicId
        lt.AudioManager:playMusic(musicId)
    end
end

function MapAgent:loadMapSafeProtalData(mapMeta)
    if #mapMeta:getRectJson() > 0 then
        self._mapSaftProtalActor = lt.MapSafeProtalActor.new(mapMeta)
    end
end

-- 地图跳转信息与安全区信息
function MapAgent:getSaftProtalData()
    return self._mapSaftProtalActor
end

-- 初始化安全区和跳转点信息
function MapAgent:initSafeProtalData()
    if not self._mapSaftProtalActor then
        return
    end

    local heroAgent = self:getSelfHeroAgent()

    self._mapSaftProtalActor:initPortalSector(heroAgent:getRoleRace())
    self._mapSaftProtalActor:initSafeRect(heroAgent:getRoleRace())

    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_DRAW_SAFE)
end

function MapAgent:getPortalSector(m, n)
    if not self._mapSaftProtalActor then
        return nil
    end

    return self._mapSaftProtalActor:getPortalSector(m, n)
end

function MapAgent:getSafeRect(m, n)
    if not self._mapSaftProtalActor then
        return nil
    end

    local mMax, mMin, nMax, nMin = self._mapSaftProtalActor:getSafeRectBorder()
    if m > mMax or m < mMin or n > nMax or n < nMin then
        return nil
    end

    return self._mapSaftProtalActor:getSafeRect(m, n)
end

function MapAgent:updateSafeArea(m, n)
    self._safeAreaCheckElapse = self._safeAreaCheckElapse + lt.GameBoard:getDeltaTime()
    if self._safeAreaCheckElapse < self._safeAreaCheckInterval then
        return
    end
    self._safeAreaCheckElapse = self._safeAreaCheckElapse - self._safeAreaCheckInterval

    if not self._safeAreaArray then
        return
    end

    local inSafeArea = false
    for _, safeAreaMeta in ipairs(self._safeAreaArray) do
        local p1 = safeAreaMeta:getP1()
        local p2 = safeAreaMeta:getP2()

        local rect = cc.rect(math.min(p1.x, p2.x), math.min(p1.y, p2.y), math.abs(p1.x - p2.x), math.abs(p1.y - p2.y))
        if cc.rectContainsPoint(rect, cc.p(m, n)) then
            inSafeArea = true
            break
        end
    end

    if self._inSafeArea == inSafeArea then
        return
    end
    self._inSafeArea = inSafeArea

    if self._inSafeArea then
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SAFETY_AREA_IN)
    else
        lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_SAFETY_AREA_OUT)
    end
end

function MapAgent:mapTileSound(m, n)
    if not self._mapData then
        return
    end

    local mapTile = self._mapData:getMapTile(m, n)
    if not mapTile then
        return
    end

    self._tileSound = mapTile:getSound()
end

function MapAgent:mapTileAudio(actionId)
    local sound = lt.MapUtil:getTileSoundId(actionId, self._tileSound)
    if sound then
        lt.AudioManager:playBattleSound(sound)
    end
end

function MapAgent:prepareLoadMap()
    self._agentSystem:clear()
    MapManagerInstance:clearBlocked()
end

function MapAgent:clearAgentSystem()
    self._agentSystem:clear()
end

function MapAgent:drawClickMark(posInScreen)
    local x, y = self:calcPositionInMap(posInScreen)
    x, y = MapUtil:calcMid(x, y)
    self._mapActor:drawClickMark(x, y)
end

function MapAgent:clearClickMark()
    self._mapActor:clearClickMark()
end

function MapAgent:calcMNInMap(posInScreen)
    local x, y = self:calcPositionInMap(posInScreen)
    return MapUtil:calcMN(x, y)
end

function MapAgent:calcPositionInMap(posInScreen)
    local posInMap = self._mapActor:convertToNodeSpace(posInScreen)
    return posInMap.x, posInMap.y
end

function MapAgent:calcPositionInScreen(posInMap)
     -- 移动
    local posInScrren = self._mapActor:convertToWorldSpace(posInMap)
    return posInScrren.x, posInScrren.y
end

function MapAgent:onScroll(scrollY)
    -- 缩放
    local scale = self._mapActor:getScale()
    if scrollY > 0 then
        scale = scale - 0.1
    else
        scale = scale + 0.1
    end

    self:setScale(scale)
end

