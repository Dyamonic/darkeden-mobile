-- 调整坐标(同步并更新坐标)
function MapAgent:adjustPosition(x, y, beQuick)
    local mapX = display.width / 2 - x * self._mapActor:getScale()
    local mapY = display.height / 2 - y * self._mapActor:getScale()
    mapX, mapY = self:checkMapPosition(mapX, mapY, self._mapActor:getScale())
    -- yflog:Info("----------mapX="..mapX.."=mapY="..mapY)
    --mapX, mapY = self:smoothMapPosition(mapX, mapY)
    --[[ no need to refresh map position,just stay.
    local mapXCur, mapYCur = self._mapActor:getPosition()
    local directionV = cc.pSub(cc.p(mapX, mapY), cc.p(mapXCur, mapYCur))
    local diffLength = cc.pGetLength(directionV)
   
    if diffLength > 900 or beQuick then
        self._mapActor:setPosition(mapX, mapY)
    else
        local step = 600 * lt.GameBoard:getDeltaTime()
        -- print("mapXCur = ",mapXCur,"mapX = ", mapX)
        if diffLength < step then
            -- 到达
            self._mapActor:setPosition(mapX, mapY)
        else
            -- 未到
            directionV = cc.pMul(cc.pNormalize(directionV), step)
            self._mapActor:setPosition(mapXCur + directionV.x, mapYCur + directionV.y)
        end
    end
    ]]

    self._mapActor:setPosition(mapX, mapY)

    self._mapActor:updateDraw(x, y)
end

function MapAgent:checkMapPosition(x, y, scale)
    -- return x, y
    local mapX = cc.clampf(x, 0 - self._left * Constant.MAP_BLOCK_WIDTH * scale, display.width - (self._mapData:getMCount() - self._right) * Constant.MAP_BLOCK_WIDTH * scale)
    local mapY = cc.clampf(y, display.height + self._up * Constant.MAP_BLOCK_HEIGHT*scale , (self._mapData:getNCount() - self._down) * Constant.MAP_BLOCK_HEIGHT*scale)
    return mapX, mapY
end

-- 是否是边界
function MapAgent:isCheckMapPosition()
    local scale = self._mapActor:getScale()
    local x ,y = self._mapActor:getPosition()
    
    if x == 0 - self._left * Constant.MAP_BLOCK_WIDTH * scale or x == (display.width - (self._mapData:getMCount() - self._right) * Constant.MAP_BLOCK_WIDTH * scale)  then
        return true
    end
    
    if y == (display.height + self._up * Constant.MAP_BLOCK_HEIGHT*scale) or y == ((self._mapData:getNCount() - self._down) * Constant.MAP_BLOCK_HEIGHT*scale) then
        return true
    end

    return false
end

-- 是边界 1 top 2 right 3 bottom 4 left
function MapAgent:getCheckMapBorder()
    local scale = self._mapActor:getScale()
    local x ,y = self._mapActor:getPosition()
    local top, right , bottom ,left = 0 , 0 , 0 ,0
    if not self._mapData or not self._down or not self._up or not self._left or not self._right then
        return top, bottom , left ,right
    end
    
    if x == 0 - self._left * Constant.MAP_BLOCK_WIDTH * scale  then
        left = 1
    end

    if x == (display.width - (self._mapData:getMCount() - self._right) * Constant.MAP_BLOCK_WIDTH * scale)  then
        right = 1
    end
    
    if y == (display.height + self._up * Constant.MAP_BLOCK_HEIGHT*scale) then
        top = 1
    end

    if y == ((self._mapData:getNCount() - self._down) * Constant.MAP_BLOCK_HEIGHT*scale) then
        bottom = 1
    end
    -- yflog:Info("---------m--"..self._mapData:getMCount().."-n-"..self._mapData:getNCount())
    return top, bottom, left , right, self._mapData:getMCount(), self._mapData:getNCount()
end

function MapAgent:smoothMapPosition(mapX, mapY)
    local count = 1
    local sumX = mapX
    local sumY = mapY
    if self._lastX1 and self._lastY1 then
        sumX  = sumX + self._lastX1
        sumY  = sumY + self._lastY1
        count = count + 1
    end
    if self._lastX2 and self._lastY2 then
        sumX  = sumX + self._lastX2
        sumY  = sumY + self._lastY2
        count = count + 1
    end
    if self._lastX3 and self._lastY3 then
        sumX  = sumX + self._lastX3
        sumY  = sumY + self._lastY3
        count = count + 1
    end

    self._lastX3 = self._lastX2
    self._lastY3 = self._lastY2
    self._lastX2 = self._lastX1
    self._lastY2 = self._lastY1
    self._lastX1 = mapX
    self._lastY1 = mapY

    return sumX / count, sumY / count
end

 -- TODO-LXP: 这两个函数待重构
 -- 摇杆移动，计算移动方向
function MapAgent:calcJoyStickMove(mHero, nHero, moveType, moveDirection)
    --local m1, n1, m2, n2 = MapUtil:calcNext2MN(mHero, nHero, moveDirection)
    local m1, n1, m2, n2, m3, n3 = MapUtil:calcNext3MN(mHero, nHero, moveDirection)

    local isOnHorse = false
    local selfHeroAgent = self:getSelfHeroAgent()
    local curMoveMode = selfHeroAgent:getCurMoveMode()
    if self:isBlocked(m1, n1, curMoveMode) then
        -- 判断相邻两个方向
        local direction1, direction2 = MapUtil:getNeighborDirection(moveDirection)
        local m1, n1, m2, n2, m3, n3 = MapUtil:calcNext3MN(mHero, nHero, direction1)
        if not self:isBlocked(m1, n1, curMoveMode) then
            -- TODO 此处判断移动格子数为2格 骑马可移动3格, 现策划需要测试移动一个的效果，所以现屏蔽此处
            return Constant.MOVE_RUN, direction1, m1, n1
            --[[
            if not self:isBlocked(m2, n2, curMoveMode) then
                if isOnHorse then
                    -- 骑马
                    if not self:isBlocked(m3, n3, curMoveMode) then
                        return Constant.MOVE_RUN_HORSE, direction1, m3, n3
                    else
                        return Constant.MOVE_RUN, direction1, m1, n1
                    end
                else
                    -- 未骑马
                    return Constant.MOVE_RUN, direction1, m2, n2
                end
            else 
                return Constant.MOVE_RUN, direction1, m1, n1
            end
            ]]
        end

        m1, n1, m2, n2, m3, n3 = MapUtil:calcNext3MN(mHero, nHero, direction2)
        if not self:isBlocked(m1, n1, curMoveMode) then
            -- TODO 此处判断移动格子数为2格 骑马可移动3格, 现策划需要测试移动一个的效果，所以现屏蔽此处
            return Constant.MOVE_RUN, direction2, m1, n1
            --[[
            if not self:isBlocked(m2, n2, curMoveMode) then
                if isOnHorse then
                    -- 骑马
                    if not self:isBlocked(m3, n3, curMoveMode) then
                        return Constant.MOVE_RUN_HORSE, direction2, m3, n3
                    else
                        return Constant.MOVE_RUN, direction2, m1, n1
                    end
                else
                    -- 未骑马
                    return Constant.MOVE_RUN, direction2, m2, n2
                end
                return Constant.MOVE_RUN, direction2, m2, n2
            else 
                return Constant.MOVE_RUN, direction2, m1, n1
            end
            ]]
        end

        return Constant.MOVE_NONE, moveDirection
    elseif self:isBlocked(m2, n2, curMoveMode) then
        return Constant.MOVE_RUN, moveDirection, m1, n1
        
    else

        return Constant.MOVE_RUN, moveDirection, m1, n1
        -- TODO 此处判断移动格子数为2格 骑马可移动3格, 现策划需要测试移动一个的效果，所以现屏蔽此处
        --[[
        if isOnHorse then
            -- 骑马
            if self:isBlocked(m3, n3, curMoveMode) then
                return Constant.MOVE_RUN, moveDirection, m1, n1
            else
                -- 骑马跑
                return Constant.MOVE_RUN_HORSE, moveDirection, m3, n3
            end
        else
            -- 未骑马
            return Constant.MOVE_RUN, moveDirection, m2, n2
        end
        ]]
    end
end

-- 点击移动，计算移动方向
function MapAgent:calcTouchMove(mHero, nHero, mTarget, nTarget)
    local x1, y1 = MapUtil:calcMNMid(mHero, nHero)
    local x2, y2 = MapUtil:calcMNMid(mTarget, nTarget)
    local moveDirection = MapUtil:calcDirectionXY(x2 - x1, y2 - y1)

    -- 排除当前所在的格子
    if mTarget == mHero and nTarget == nHero then
        return Constant.MOVE_NONE, moveDirection
    end

    local isOnHorse = false
    local selfHeroAgent = self:getSelfHeroAgent()
    if not selfHeroAgent  then
       return 
    end
    local curMoveMode = selfHeroAgent:getCurMoveMode()

    -- 相邻
    if MapUtil:isMNNeighbor(mHero, nHero, mTarget, nTarget) then
        if self:isBlocked(mTarget, nTarget, curMoveMode) then
            -- 判断相邻两个方向
            local direction1, direction2 = MapUtil:getNeighborDirection(moveDirection)
            local m1, n1, _, _ = MapUtil:calcNext2MN(mHero, nHero, direction1)
            if not self:isBlocked(m1, n1, curMoveMode) then
                return Constant.MOVE_RUN, direction1, m1, n1
            end

            m1, n1, _, _ = MapUtil:calcNext2MN(mHero, nHero, direction2)
            if not self:isBlocked(m1, n1, curMoveMode) then
                return Constant.MOVE_RUN, direction2, m1, n1
            end

            return Constant.MOVE_NONE, moveDirection
        else
            return Constant.MOVE_RUN, moveDirection, mTarget, nTarget
        end
    end

    -- 不相邻
    -- local m1, n1, m2, n2 = MapUtil:calcNext2MN(mHero, nHero, moveDirection)
    local m1, n1, m2, n2, m3, n3 = MapUtil:calcNext3MN(mHero, nHero, moveDirection)
    if self:isBlocked(m1, n1, curMoveMode) then
        -- 判断相邻两个方向
        local direction1, direction2 = MapUtil:getNeighborDirection(moveDirection)
        local m1, n1, m2, n2, m3, n3 = MapUtil:calcNext3MN(mHero, nHero, direction1)
        -- yflog:Info("mHero:%d, nHero:%d direction1:%d m1:%d, n1:%d, m2:%d, n2:%d, m3:%d, n3:%d ", mHero, nHero, direction1, m1, n1, m2, n2, m3, n3)
        if not self:isBlocked(m1, n1, curMoveMode) then
            -- TODO 此处判断移动格子数为2格 骑马可移动3格, 现策划需要测试移动一个的效果，所以现屏蔽此处
            return Constant.MOVE_RUN, direction1, m1, n1
            --[[
                if not self:isBlocked(m2, n2, curMoveMode) then
                    if isOnHorse then
                        -- 骑马
                        if not self:isBlocked(m3, n3, curMoveMode) then
                            return Constant.MOVE_RUN_HORSE, direction1, m3, n3
                        else
                            return Constant.MOVE_RUN, direction1, m1, n1
                        end
                    else
                        -- 未骑马
                        return Constant.MOVE_RUN, direction1, m2, n2
                    end
                else 
                    return Constant.MOVE_RUN, direction1, m1, n1
                end
            ]]

        end

        m1, n1, m2, n2, m3, n3 = MapUtil:calcNext3MN(mHero, nHero, direction2)
        if not self:isBlocked(m1, n1, curMoveMode) then
            -- TODO 此处判断移动格子数为2格 骑马可移动3格, 现策划需要测试移动一个的效果，所以现屏蔽此处
            return Constant.MOVE_RUN, direction2, m1, n1
            --[[
                if not self:isBlocked(m2, n2, curMoveMode) then
                    if isOnHorse then
                        -- 骑马
                        if not self:isBlocked(m3, n3, curMoveMode) then
                            return Constant.MOVE_RUN_HORSE, direction2, m3, n3
                        else
                            return Constant.MOVE_RUN, direction2, m1, n1
                        end
                    else
                        -- 未骑马
                        return Constant.MOVE_RUN, direction2, m2, n2
                    end
                else 
                    return Constant.MOVE_RUN, direction2, m1, n1
                end
            ]]
        end

        return Constant.MOVE_NONE, moveDirection
    elseif self:isBlocked(m2, n2, curMoveMode) then
        return Constant.MOVE_RUN, moveDirection, m1, n1
    else
        -- TODO 此处判断移动格子数为2格 骑马可移动3格, 现策划需要测试移动一个的效果，所以现屏蔽此处
        return Constant.MOVE_RUN, moveDirection, m1, n1
        --[[
        if isOnHorse then
            -- 骑马
            if self:isBlocked(m3, n3, curMoveMode) then
                return Constant.MOVE_RUN, moveDirection, m1, n1
            else
                -- 骑马跑
                return Constant.MOVE_RUN_HORSE, moveDirection, m3, n3
            end
        else
            -- 未骑马
            return Constant.MOVE_RUN, moveDirection, m2, n2
        end
        ]]
    end
end

--[[
    需要根据当前移动生物的状态进行判断
    state 当前状态 2:行走 1:钻地 4:飞行
    MapUtil:IsBlockAll          全阻挡
    MapUtil:IsBlockUnderground  地下阻挡
    MapUtil:IsBlockGround       地面阻挡
    MapUtil:IsBlockFlying       飞行阻挡
]]
function MapAgent:isBlocked(m, n, state, onlyMap)
    -- TODO 查询onlyMap是什么状态
    if onlyMap then
        return self:isMapBlocked(m, n)
    else
        
        local mapTile = self._mapData:getMapTile(m, n)    
        if not mapTile then
            return true
        end
        local isTransforming, transformId = lt.SkillModule:isTransforming()
        if isTransforming and transformId == lt.SkillEnum.TRANSFORM.BAT then
            return false
        end

        -- 地图人物阻挡 则优先返回
        if MapManagerInstance:isMNBlocked(m, n) then
            return true
        end


        -- 角色当前状态 移动 飞行 钻地
        if not state then
            state = ServerClientEnum.RoleMoveMode.MOVE
        end

        -- 获取阻挡点
        local block = mapTile:getBlock()

        -- 无阻挡点 block == 0
        if MapUtil:IsEmpty(block) then
            return false
        end

        -- 阻挡一切 block == all
        if MapUtil:IsBlockAll(block) then
            return true
        end
        
        if ServerClientEnum.RoleMoveMode.MOVE == state then
            return MapUtil:IsBlockGround(block)
        elseif ServerClientEnum.RoleMoveMode.DOWN == state then
            return MapUtil:IsBlockUnderground(block)
        elseif ServerClientEnum.RoleMoveMode.FLY == state then
            return MapUtil:IsBlockFlying(block)
        end

        -- return MapManagerInstance:isMNBlocked(m, n)
    end
end

function MapAgent:isMapBlocked(m, n)
    if MapManagerInstance.queryMNBlocked then
        local value = MapManagerInstance:queryMNBlocked(m, n)
        return value == 99
    else
        return self:isBlocked(m, n)
    end
end

function MapAgent:isThrough(m, n)
    return not self:isBlocked(m, n)
end

function MapAgent:isMNMask(m, n)
    local mapTile = self._mapData:getMapTile(m, n)    
    if mapTile then
        return mapTile:getBlock() == 2
    end

    return false
end

function MapAgent:isTrans(m, n)
    return MapManagerInstance:isMNTrans(m, n)
end

-- 管理Agent
function MapAgent:getAgentTableMN(m, n)
    return self._agentSystem:getAgentTable(m, n)
end

function MapAgent:removeAgentMN(agent, m, n)
    self._agentSystem:removeAgent(agent, m, n)

    MapManagerInstance:setMNBlocked(m, n, self._agentSystem:isBlocked(m, n))
end

function MapAgent:addHeroAgent(heroAgent)
    self._mapActor:addHeroActor(heroAgent:getActor())

    self._agentSystem:addAgent(heroAgent)

    local m, n = heroAgent:getMNExactly()
    if not self:pointInSaveArea(m, n) then
        MapManagerInstance:setMNBlocked(m, n, self._agentSystem:isBlocked(m, n))
    end
end

function MapAgent:setSelfHeroAgent(heroAgent)
    self._heroAgent = heroAgent
    self._mapActor:setSelfHeroActor(heroAgent:getActor())
end

function MapAgent:getSelfHeroAgent()
    if self._heroAgent then
        return self._heroAgent
    end

    local heroAgent = lt.AgentManager:getHeroAgent()
    if not heroAgent then
        return
    end

    self._heroAgent = heroAgent

    return self._heroAgent
end

function MapAgent:addMonsterAgent(monsterAgent)
    self._mapActor:addMonsterActor(monsterAgent:getActor())

    local monsterData = monsterAgent:getMonsterData()
    if monsterData:isAlive() then
        -- 存活才站位
        self._agentSystem:addAgent(monsterAgent)
    else
        if not monsterData:isDig() then
            --没挖添加拾取
            GameModule:addDropAndBodyGridMap(monsterAgent)
        end
    end
    
    local m, n = monsterAgent:getMNExactly()
    if monsterData:getMasterObjId() and monsterData:getMasterObjId() > 0 then
        if not self:pointInSaveArea(m, n) then
            MapManagerInstance:setMNBlocked(m, n, self._agentSystem:isBlocked(m, n))
        end
    else
        MapManagerInstance:setMNBlocked(m, n, self._agentSystem:isBlocked(m, n))
    end
end

function MapAgent:addTrapAgent(trapAgent)
    if #trapAgent:getActors() > 0  then
        for _,actor in ipairs(trapAgent:getActors()) do
            self._mapActor:addTrapActor(actor)
        end
    else
        self._mapActor:addTrapActor(trapAgent:getActor())
    end

    self._agentSystem:addAgent(trapAgent)
end

function MapAgent:addNpcAgent(npcAgent)
    self._mapActor:addNpcActor(npcAgent:getActor())

    self._agentSystem:addAgent(npcAgent)
    
    local m, n = npcAgent:getMNExactly()
    MapManagerInstance:setMNBlocked(m, n, self._agentSystem:isBlocked(m, n))
end

function MapAgent:addElementAgent(elementAgent)
    self._mapActor:addElementActor(elementAgent:getActor())

    self._agentSystem:addAgent(elementAgent)
    
end

function MapAgent:addItemAgent(itemAgent)
    self._mapActor:addItemActor(itemAgent:getItemActor())
    GameModule:addDropAndBodyGridMap(itemAgent)
end

--添加障碍
function MapAgent:addDropAndBodyAgent(agent)
    self._agentSystem:addAgent(agent)
    local m, n = agent:getMNExactly()
    MapManagerInstance:setMNBlocked(m, n, self._agentSystem:isBlocked(m, n))
end

-- 目标agent 位置改变
function MapAgent:changeAgentMN(agent, mNew, nNew)
    self._agentSystem:changeAgentMN(agent, mNew, nNew)

    local mLast, nLast = agent:getMNExactly()
    --MapManagerInstance:changeMNBlocked(mLast, nLast, mNew, nNew)

    local agentType = agent:getAgentType()
    local checkSaveArea = false
    if agentType == lt.Constant.AGENT_TYPE_HERO then
        checkSaveArea = true
    end

    if agentType == lt.Constant.AGENT_TYPE_MONSTER then
        local monsterData = agent:getMonsterData()
        if monsterData:getMasterObjId() and monsterData:getMasterObjId() > 0 then
            checkSaveArea = true
        end
    end

    if checkSaveArea then
        if not self:pointInSaveArea(mLast, nLast) then
            MapManagerInstance:setMNBlocked(mLast, nLast, self._agentSystem:isBlocked(mLast, nLast))
        end

        if not self:pointInSaveArea(mNew, nNew) then
            MapManagerInstance:setMNBlocked(mNew, nNew, self._agentSystem:isBlocked(mNew, nNew))
        end
    else
        MapManagerInstance:setMNBlocked(mLast, nLast, self._agentSystem:isBlocked(mLast, nLast))
        MapManagerInstance:setMNBlocked(mNew, nNew, self._agentSystem:isBlocked(mNew, nNew))
    end

    agent:setMNExactly(mNew, nNew)
end

-- 重置阻挡点
function MapAgent:resetAgentMN(agent)
    local mEle, nEle = agent:getMNExactly()
    self:changeAgentMN(agent, mEle, nEle)
end

function MapAgent:getRandThrough(mCenter, nCenter, dis)
    local loopCount = 0
    local mMin, mMax = math.max(0, mCenter - dis), math.min(self._mapData:getMCount() - 1, mCenter + dis)
    local nMin, nMax = math.max(0, nCenter - dis), math.min(self._mapData:getNCount() - 1, nCenter + dis)

    while true do
        local randM = math.random(mMin, mMax)
        local randN = math.random(nMin, nMax)
        if self:isThrough(randM, randN) and not self:isTrans(randM, randN) then
            return randM, randN
        end

        loopCount = loopCount + 1
        if loopCount > 20 then
            break
        end
    end

    return nil, nil
end

-- Setter && Getter
function MapAgent:getMapData()
    return self._mapData
end

function MapAgent:getMapActor()
    return self._mapActor
end

function MapAgent:getMapMeta()
    return self._mapMeta
end

function MapAgent:getMapCode()
    if not self._mapMeta then
        return -1
    end

    return self._mapMeta:getMapCode()
end

function MapAgent:getPreMapCode()
    return self._preMapCode
end

function MapAgent:getWholeMapSafe()
    return self._mapMeta:getWholeMapSafe() == 1
end

function MapAgent:isMapChange()
    local ret = not self._preMapCode or not self._mapMeta or self._mapMeta:getMapCode() ~= self._preMapCode
    self._preMapCode = self._mapMeta:getMapCode()
    return ret
end

-- 判断两个点之前是否直线直达
function MapAgent:canThrough(mn0, mn1, onlyMap)
    if not mn0 or not mn1 then
        return 0
    end

    local step = math.max(math.abs(mn0.x - mn1.x), math.abs(mn0.y - mn1.y))
    if step == 0 then
        return 0
    end

    local mOffset = (mn1.x - mn0.x) / step
    local nOffset = (mn1.y - mn0.y) / step

    local count = 0
    for i=1,step-1 do
        local tmpM = mn0.x + i * mOffset + 0.5
        local tmpN = mn0.y + i * nOffset + 0.5

        if self:isBlocked(tmpM, tmpN, nil, onlyMap) then
            count = count + 1

            if count >= 3 then
                return -i
            end
        end
    end

    return step
end

function MapAgent:pointInSaveArea(m, n)
    if not self._safeAreaArray then
        return false
    end

    local inSafeArea = false
    for _, safeAreaMeta in ipairs(self._safeAreaArray) do
        local p1 = safeAreaMeta:getP1()
        local p2 = safeAreaMeta:getP2()

        local rect = cc.rect(math.min(p1.x, p2.x), math.min(p1.y, p2.y), math.abs(p1.x - p2.x), math.abs(p1.y - p2.y))
        if cc.rectContainsPoint(rect, cc.p(m, n)) then
            inSafeArea = true
            break
        end
    end

    return inSafeArea
end

-- 更新地图上obj的遮罩
function MapAgent:updateMapObjMask(x, y)
    self._mapActor:updateObjMask(x, y)
end

-- 获得map
function MapAgent:getMapMNCount(resCode)
    local path = string.format("map/data/%s.bin", resCode)
    local objPath = string.format("map/object/%s.obj", resCode)
    local defaultData = MapManagerInstance:loadMapDataAndObject(path, objPath)
    return defaultData:getMCount(), defaultData:getNCount()
end

--初始化转职副本显示
function MapAgent:initAdvanceDungeon()
    self._mapActor:initAdvanceDungeon()
end

--重置副本染色
function MapAgent:resetBlackArea()
    self._mapActor:resetBlackArea()
end

function MapAgent:setMapSkillSlience(isSlience)
    self._skillSlience = isSlience
end

function MapAgent:isMapSkillSlience()
    return self._skillSlience
end

function MapAgent:setMapScale()
    local editTable = AutoFightManager:getEditConfByIndex(lt.Constant.SETTINGS_TYPES.MAP_SCALE)
    if editTable then
        local value = editTable.value or 100
        local scale = value / 100
        self:setScale(scale)
    end
end

function MapAgent:resetCameraMN()
    self._minPx,self._maxPy = self:calcMNInMap(cc.p(0,0))
    self._maxPx,self._minPy = self:calcMNInMap(cc.p(display.width,display.height))
    return self._maxPx - self._minPx
    -- print("_leftPx =",self._leftPx,"_leftPy =",self._leftPy,"_maxPx =",self._maxPx,"_downPy =",self._downPy)
end

--检测点是否在镜头内
function MapAgent:inMapCamera(mTarget,nTarget)
    if mTarget < self._minPx then
        -- print("左侧溢出 _minPx：",self._minPx,"mTarget",mTarget)
        return false
    end
    if mTarget > self._maxPx then
        -- print("右侧溢出 _maxPx",self._maxPx,"mTarget",mTarget)
        return false
    end
    if nTarget < self._minPy then
        -- print("上端溢出 _minPy",self._minPy,"nTarget",nTarget)
        return false
    end
    if nTarget > self._maxPy then
        -- print("底部溢出 _maxPy",self._maxPy,"nTarget",nTarget)
        return false
    end
    return true
end

return MapAgent
