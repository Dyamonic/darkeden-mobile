---@class UIWindowBase fgui基础Window类

local UIWindowBase = class("UIWindowBase", fgui.LuaWindow, lt.UICompChangeSkin)
local NtfManager = lt.NtfManager
local WndLockManager = lt.WndLockManager

-- 不添加遮罩的窗口
local IGNORE_SHADOW = {
    ["UIWndInventory"] = true,
    ["UIWndRoleEquip"] = true,
    ["UIWndRoleInfo"] = true,
    ["UIWndTalkNpc"] = true,
    ["UIWndChat"] = true,
    ["UIWndChatSetting"] = true,
    ["UIWndAutoRecycle"] = true,
    ["UIWndWareHouse"] = true,
    ["UIWndMagicOTips"] = true,
    ["UIWndRepair"] = true,

    ["UIWndTrade"] = true,
    ["UIWndLock"] = true,
    ["UIWndNpcHolyBook"] = true,
    ["UIWndChatPrivate"] = true,
    ["UIWndNpcClsSkill"] = true,
    ["UIWndGuideStart"] = true,
    
}

function UIWindowBase:ctor(param)
    self.isFairyGUI = true
    self:enableWindowEvents()
    self:enableComponentEvents()
    self:retain()
    self:setParam(param)
    self:initVars()
end

function UIWindowBase:onEnter()
end

function UIWindowBase:onExit()
end

function UIWindowBase:onInit(url)
    local pkgName, resName = lt.FGUIUtil:normalizeURL(url)
    self._commonShadow = fgui.UIPackage:createObject("CommonTL", "WndShadow")
    self:addChild(self._commonShadow)

    self:setContentPane(fgui.UIPackage:createObject(pkgName, resName));
    self._contentPane = self:getContentPane()
    self._windowFrame = self:getFrame()
    self._title = self._windowFrame:getChild("title")
    self._dragArea = self._windowFrame:getChild("dragArea")
    self._closeBtn = self._windowFrame:getChild("closeButton")

    local isShowShadow = not self:checkIsLock() and not IGNORE_SHADOW[self._className]
    self._commonShadow:setVisible(isShowShadow)
    
    if self._closeBtn then
        self._closeBtn:addClickListener(handler(self, self.onClosetButtonClick))
    end
       
    self:setProperyByParam()
    self:startSkin()
end

function UIWindowBase:onClosetButtonClick()
    local lock = false
    for k,v in pairs(WndLockManager:getSubWndClass()) do
        if self._className == v then
            lock = true
            break
        end
    end
    -- if not WndLockManager:getSubWndClass() then --当前lock
    if not lock then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, { class = self._className, close = true })
    end
end

function UIWindowBase:doShowAnimation()
    -- self:setScale(0.8, 0.8);
    -- self:setPivot(0.5, 0.5);
    -- fgui.GTween:to(self:getScale(), cc.p(1,1), 0.1):setTarget(self, fgui.TweenPropType.Scale):onComplete(function()
    --     -- self:onShown()
    -- end)
    lt.ScheduleUtil:performWithDelayGlobal(function()
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_CHECK_GUIDE_EVENT)
    end, 0.1)
end

function UIWindowBase:doHideAnimation()
    --handler 会warning
end

--[[__fmt
    onHide 为周期函数，会从onExit调用过来
    此处无需再做close view 操作，只负责自身的逻辑
]]
function UIWindowBase:onHide()
    if self:getParam().reopen then
        yflog:Info("UIWindowBase:onHide() reopen :%s", self._className)
        if self.resetZOrder then
            self:resetZOrder()
        end
       return
    end
    if self:getParam().fromNpc then
        if self._className ~= "UIWndLock" then
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_NPC_REFRESH_INFO)
        end
    end
    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_CHECK_GUIDE_EVENT)
end

function UIWindowBase:onShown()
    lt.AudioManager:playSound(lt.ResManager.SOUND_NUM.MENU_BTN_SUB)
end

function UIWindowBase:initVars()
    self._className = self:getParam().class
end

function UIWindowBase:getChild(name)
    return self._contentPane:getChild(name)
end

function UIWindowBase:getTransition(name)
    if self._contentPane then
        return self._contentPane:getTransition(name)
    end
    return nil
end

function UIWindowBase:getController(name)
    if self._contentPane then
        return self._contentPane:getController(name)
    end
    return nil
end

function UIWindowBase:getChildren()
    return self._contentPane:getChildren()
end

----------------------------功能----------------------------------------

function UIWindowBase:setProperyByParam()
    local params = self:getParam() or {}
    --设置模态窗口
    self:setModal(params.isModel == true)
end

function UIWindowBase:setTitle(title)
    self._title:setText(tostring(title));
end

------------------------------补丁----------------------------------------

function UIWindowBase:onClear()
    self._contentPane = nil
    self._windowFrame = nil
    self._title = nil
    self._dragArea = nil
    self._param = nil
    self._dialogSystem = nil
    self._commonShadow = nil
    if self._closeBtn then
        self._closeBtn:removeClickListener()
        self._closeBtn = nil
    end
    if self:getReferenceCount() > 0 then
        self:release()
    end
end

function UIWindowBase:setDialogSystem(dialogSystem)
    self._dialogSystem = dialogSystem
end
function UIWindowBase:getDialogSystem()
    return self._dialogSystem
end

function UIWindowBase:enableUpdateEvent(b)
    self._param.enableUpdateEvent = b
end

function UIWindowBase:getContentSize()
    return self:getSize()
end

function UIWindowBase:checkRedTips(name)
    
end

function UIWindowBase:setSelfPos()
    self:center()
end

function UIWindowBase:setLocalZOrder(zorder)
    self:displayObject():setLocalZOrder(zorder)
end
function UIWindowBase:getLocalZOrder()
    return self:displayObject():getLocalZOrder()
end

function UIWindowBase:onCloseView()
    self:getDialogSystem():closeView(self:getParam().layerName)
end

function UIWindowBase:onOpenView()
    -- self:show()
end

function UIWindowBase:contain(point)
    local bounds = self:getSize()
    local point = lt.FGUIUtil:fGuiPosToCocos(point)
    local offset = display.cy - point.y
    local calcY = display.cy + offset
    local fguiTouchPoint = cc.p(point.x, calcY)
    local x,y = self:getPosition()
    local rect = {
        x = x,
        y = y,
        width = bounds.width,
        height = bounds.height
    }
    -- local pt = self:globalToLocal(fguiTouchPoint); 
    -- lt.FGUIUtil:drawPoint(self, pt)
    local isContain = cc.rectContainsPoint(rect, fguiTouchPoint)
    return isContain
end

function UIWindowBase:openView(layerName, param)
    if not param then param = {} end
    self:getDialogSystem():openView(layerName,param)
end

function UIWindowBase:setParam(param)
    self._param = param
end

function UIWindowBase:getParam()
    return self._param
end


function UIWindowBase:touchEvent()
    -- self._touchArea = self:getFrame():getChild("dragArea")
    self:addEventListener(fgui.UIEventType.TouchBegin, handler(self, self.onTouchWindowBegan));
    self:addEventListener(fgui.UIEventType.TouchMove, handler(self, self.onTouchWindowMoved));
    self:addEventListener(fgui.UIEventType.TouchEnd, handler(self, self.onTouchWindowEnded));
end

function UIWindowBase:onTouchBegan(point)
    return false
end

function UIWindowBase:onTouchMoved(point) 
    return true
end

function UIWindowBase:onTouchEnded(point)
    return false
end

function UIWindowBase:getPosition()
    return self:getX(), self:getY()
end

function UIWindowBase:setPositionEx(offX, offY)
    local x, y = self:getPosition()
    x = x + offX
    y = y + offY
    
    self:setPosition(x, y)
end

function UIWindowBase:bringToFront()
    self:bringToFront()
end

function UIWindowBase:checkIsLock()
    local lock = false
    for k,v in pairs(WndLockManager:getSubWndClass()) do
        if self._className == v then
            break
        end
    end
    return lock
end

function UIWindowBase:getClassName()
    local className = self.class and self.class.__cname or self.__cname
    return className
end

-- 注册Component
function UIWindowBase:registerComponent(...)
    for _, component in ipairs( {...} ) do
        lt.FGuiManager:registerComponent(self:getClassName(), component)
    end

end

function UIWindowBase:unregisterComponent( ... )
    for _, component in ipairs( {...} ) do
        lt.FGuiManager:unregisterComponent(self:getClassName(), component)
    end
end

function UIWindowBase:unregisterAllComponent()
    lt.FGuiManager:unregisterAllComponent(self:getClassName())
end

return UIWindowBase









