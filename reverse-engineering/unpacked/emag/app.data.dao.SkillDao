
local SkillDao = {}
local Constant = lt.Constant
local SkillEnum = lt.SkillEnum
function SkillDao:queryAll()
    local skillMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Skill;") do
    	local skillMeta = lt.SkillMeta.new(row)
        skillMap[skillMeta:getSkillId()] = skillMeta
    end

    return skillMap
end

function SkillDao:queryByRace(raceId)
    if type(raceId) ~= "number" then
        return
    end

    local selectRace = math.pow(2, raceId-1)

    local skillMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Skill WHERE Race=%d;",selectRace)) do
        local skillMeta = lt.SkillMeta.new(row)
        table.insert(skillMap, skillMeta)
    end

    return skillMap
end

function SkillDao:queryById(skillId)
    if type(skillId) ~= "number" then
        return
    end

    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Skill WHERE SkillId=%d;", skillId)) do
        local skillMeta = lt.SkillMeta.new(row)
        return skillMeta
    end
end

function SkillDao:queryCommonSkill()
    local skillMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Skill WHERE Race=%d;",7)) do
        local skillMeta = lt.SkillMeta.new(row)
        table.insert(skillMap, skillMeta)
    end

    return skillMap
end
function SkillDao:queryById(skillId)
    if type(skillId) ~= "number" then
        return
    end

    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Skill WHERE SkillId=%d;", skillId)) do
        local skillMeta = lt.SkillMeta.new(row)
        return skillMeta
    end
end

function SkillDao:queryAllSkill()
    local skillMap = {}
    local dependSkillMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Skill;") do
    	local skillMeta = lt.SkillMeta.new(row)
        local dependSkills = skillMeta:getRequireSkillList()
        for i = 1, #dependSkills do
            if not dependSkillMap[dependSkills[i]] then
                dependSkillMap[dependSkills[i]] = {}
            end
            table.insert(dependSkillMap[dependSkills[i]], skillMeta)
        end
        skillMap[skillMeta:getSkillId()] = skillMeta
    end
    return skillMap, dependSkillMap
end

