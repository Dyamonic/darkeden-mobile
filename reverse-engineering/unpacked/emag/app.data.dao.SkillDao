    [SkillEnum.SKILL_EXTREME] = {
        [0] = "result_skill_dark_revenge",
        [1] = "result_skill_dark_revenge_move",
        [2] = "result_skill_dark_revenge_attack",
    },
    [SkillEnum.SKILL_BERSERKER] = {
