function ItemData:getPropString(baseMin, baseMax, addMin, addMax)
    if addMin > 0 then
        return string.format("%d-%d(+%d-%d)",baseMin+addMin, baseMax+addMax, addMin, addMax), Constant.COLOR_TEXT_GREEN_H
    elseif addMax > 0 then
        return string.format("%d-%d(+%d)",baseMin, baseMax+addMax, addMax), Constant.COLOR_TEXT_GREEN_H
    else
        return string.format("%d-%d",baseMin, baseMax), Constant.COLOR_TEXT_WHITE
    end
end

function ItemData:getSinglePropString(baseMin, addMin,types)
    if types then
        if addMin > 0 then
            return string.format("%.2f%%(+%.2f%%)",(baseMin+addMin)/100, addMin/100), Constant.COLOR_TEXT_GREEN_H
        else
            return string.format("%.2f%%",baseMin/100), Constant.COLOR_TEXT_WHITE
        end
    else
        if addMin > 0 then
            return string.format("%d(+%d)",baseMin+addMin, addMin), Constant.COLOR_TEXT_GREEN_H
        else
            return string.format("%d",baseMin), Constant.COLOR_TEXT_WHITE
        end
    end
end

