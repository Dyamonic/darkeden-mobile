-- 技能标记道具信息
function ItemData:getMarkInfo()
    if self:getMetaKind() == Constant.PropType.TRANSFER and self:getMetaType() == Constant.PropTypeSub_6.VampireTransformS then
        --特殊的固定传送印章(读配置)
        local effectParam = self:getEffectParam()
        return {
            mapId = effectParam[1][2],
            x = effectParam[1][3],
            y = effectParam[1][4],
        }
    else
        return {
            mapId = self:getValue(ItemValueDef.Attr_Bloody_Mark_Map_Id) or 0,
            x = self:getValue(ItemValueDef.Attr_Bloody_Mark_Map_X) or 0,
            y = self:getValue(ItemValueDef.Attr_Bloody_Mark_Map_Y) or 0,
        }
    end
end

function ItemData:getMarkMapId()
    if self:getMetaKind() == Constant.PropType.TRANSFER and self:getMetaType() == Constant.PropTypeSub_6.VampireTransformS then
        --特殊的固定传送印章(读配置)
        local effectParam = self:getEffectParam()
        return effectParam[1][2]
    else
        return self:getValue(ItemValueDef.Attr_Bloody_Mark_Map_Id) or 0
    end
end

