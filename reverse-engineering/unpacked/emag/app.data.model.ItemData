-- 以下接口外部调用时, 需要自行判断ItemType 为装备

-- 获取装备基础属性列表
function ItemData:getBasePropertys()
    local propertys = {}

    local meta = self:getItemMeta()
    for k,v in pairs(ServerClientEnum.BaseAttr) do
        local funName = "get" .. v
        local value = nil
        if meta[funName] then
            value = meta[funName](meta) or 0
        else
            value = self:getValue(k) or 0
        end

        propertys[k] = value
    end


    setmetatable(propertys, {
        __add = function(ta, tb) 
            for k,v in pairs(tb) do
                if type(k) == "string" then
                    k = lt.CommonModule:propertyKeyatoi(k)
                end

                if ta[k] then
                    ta[k] = ta[k] + tonumber(v)
                else
                    ta[k] = tonumber(v)
                end
            end

            return ta
        end
    })
    
    return propertys
end

-- 获取装备上随机小极品属性列表
function ItemData:getQualityPropertys()
    local propertys = {}
    for k,_ in pairs(ServerClientEnum.BaseAttr) do
        local value = self:getValue(k)
        if value and value > 0 then
            propertys[k] = value
        end
    end

    return propertys
end

-- 获取装备上洗炼属性列表
function ItemData:getNonsuchPropertys()
    return lt.ItemModule:deserializeAttr(self:getValue(ItemValueDef.Attr_NonsuchProp))
end

-- 获取装备上精炼属性列表
function ItemData:getRefinePropertys()
    return lt.ItemModule:deserializeAttr(self:getValue(ItemValueDef.Attr_RefinersProp))
end

-- 小极品属性
function ItemData:getRareNum()
    return table.nums(self:getQualityPropertys())
end

-- 是否包含 小极品属性
function ItemData:isRareEquip()
    return self:getRareNum() > 0 or ((self:getValue(ItemValueDef.Attr_IsNonsuchProp) or 0) == 1)
end

function ItemData:isNaturalRareEquip()
    return (self:getValue(ItemValueDef.Attr_IsNonsuchProp) or 0) == 1
end

-- 
function ItemData:propertys2Combat(prop)
    local job = lt.GameModule:getHeroData():getJob()
    local meta = lt.CacheManager:getBattleChange(job)
    local value = 0

    for i,v in pairs(prop) do
        local skey = lt.CommonModule:propertyKeyitoa(i)
        local tmp = meta:getValue(skey)
        if not tmp then
            print(string.format("========================> [warning] ItemData:propertys2Combat not match key %s, can\'t transform", skey))
        end

        value = value + v * (meta:getValue(skey) or 0)
    end

    return value
end

