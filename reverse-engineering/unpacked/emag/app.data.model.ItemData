function ItemData:getRuneId()
    if self:getItemType() == lt.Constant.ItemType.ITEM_TYPE_RUNE then
        return self._itemMeta:getRuneId()
    else
        return self:getValue(ItemValueDef.Attr_RuneID) or 0
    end
end

function ItemData:getRuneInfo()
