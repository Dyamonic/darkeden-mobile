-- 装备总属性 = 装备属性 + 装备强化属性
-- 获取装备升级表
function ItemData:getUpgradeMeta()
    local ilevel = self:getILevel()
    local rank = self._itemMeta:getRank()
    if rank == 0 then rank = 1 end
    local upgradeMeta = lt.CacheManager:getEquipUpgradeMeta(rank, ilevel)
    return upgradeMeta
end

--获得词条耐久度百分比加成
function ItemData:getAffixDurability(totalDurability)
    local value = 0
    if self:getFirstAffixId() == Constant.AFFIXTYPES.DURABILITY then
        local lv = self:getFirstAffixLevel()
        local eqMeta = lt.CacheManager:getEnchantingAffixMeta(self:getFirstAffixId())
        local attrNum = eqMeta:getBaseValue() + (lv - 1) * eqMeta:getValuesPreLevel()
        value = value + attrNum
    end
    if self:getSecondAffixId() == Constant.AFFIXTYPES.DURABILITY then
        local lv = self:getSecondAffixLevel()
        local eqMeta = lt.CacheManager:getEnchantingAffixMeta(self:getSecondAffixId())
        local attrNum = eqMeta:getBaseValue() + (lv - 1) * eqMeta:getValuesPreLevel()
        value = value + attrNum
    end
    if self:getThirdAffixId() == Constant.AFFIXTYPES.DURABILITY then
        local lv = self:getThirdAffixLevel()
        local eqMeta = lt.CacheManager:getEnchantingAffixMeta(self:getThirdAffixId())
        local attrNum = eqMeta:getBaseValue() + (lv - 1) * eqMeta:getValuesPreLevel()
        value = value + attrNum
    end
    value = totalDurability * (value/100)
    return value
end

-- 总耐久度最大值
function ItemData:getTotalDurability()
    local totalDurability = self._itemMeta:getDurability()
    local upgradeMeta = self:getUpgradeMeta()
    if upgradeMeta then
        totalDurability = totalDurability + upgradeMeta:getDurability()
    end
    --获取词条表属性加成(只有耐久度会显示)
    local addAffixDurability = self:getAffixDurability(totalDurability)
    if addAffixDurability > 0 then
        totalDurability = totalDurability + addAffixDurability
    end
    return totalDurability
end

