end

-- 0bit=1 内绑定
function ItemData:getIsBind()
    local bind = lt.CommonUtil:d2b(self:getBound())
    return bind[32] == 1
end

function ItemData:getBind()
    local bind = lt.CommonUtil:d2b(self:getBound())
    return bind[32]
end

-- 1bit=1 不可丢弃
function ItemData:cantDiscard()
    local bind = lt.CommonUtil:d2b(self:getBound())
    return bind[31] == 1
end
-- 2bit=1 不可存仓
function ItemData:canInDepot()
    local bind = lt.CommonUtil:d2b(self:getBound())
    return bind[30] ~= 1
end

function ItemData:getPrice()
    return self:getValue(ItemValueDef.Attr_Price)
end

function ItemData:getPriceType()
    return self:getValue(ItemValueDef.Attr_PriceType)
end

function ItemData:getType()
    return self:getValue(ItemValueDef.Attr_Type) or 0
end

function ItemData:getKing()
    return self:getValue(ItemValueDef.Attr_King)
end

function ItemData:getQuality()
    local quality = 0
    if self:getItemType() == Constant.ItemType.ITEM_TYPE_EQUIP then
        if self:getFirstAffixId() ~= 0 then
            quality = quality + 1
        end
        if self:getSecondAffixId() ~= 0 then
            quality = quality + 1
        end
        if self:getThirdAffixId() ~= 0 then
            quality = quality + 1
        end
    elseif self:getItemType() == Constant.ItemType.ITEM_TYPE_PROP then
        quality = self:getValue(ItemValueDef.Attr_Quality) or self._itemMeta:getQuality()
    end
    return quality
end

function ItemData:getClearItem()
    return self:getValue(ItemValueDef.Attr_ClearItem)
end

function ItemData:getCreateTime()
    return self:getValue(ItemValueDef.Attr_CreateTime)
