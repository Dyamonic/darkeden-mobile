
local ItemData = class("ItemData")
--[[
    物品
]]
local Constant = lt.Constant
local ServerClientEnum = lt.ServerClientEnum
local ItemDao = lt.ItemDao
local PetModule = lt.PetModule
local ItemValueDef = ServerClientEnum.ItemValueDef

ItemData._objId              = nil
ItemData._propertyData       = nil
ItemData._itemMeta           = nil
-- ItemData._typePos            = nil
ItemData._propertyArray      = nil
ItemData._usetype            = false
ItemData._pickEndTime        = nil


function ItemData:ctor(objId, propertyArray,propertyTable)
    assert(objId ~= nil, "ItemData objId is nil ! ")
    
    self:setObjId(objId)
    self._propertyData = lt.PropertyData.new(propertyArray,propertyTable)
    self._propertyArray = propertyArray
    self:initMetaInfo()
end

function ItemData:initMetaInfo()
    local itemType = self:getItemType()
    local itemIdx = self:getItemId()
    if itemType == 1 then
        self._itemMeta = lt.ItemDao:query(itemIdx)
        if not self._itemMeta then
            self._itemMeta = lt.ItemDao:query(1320001)
        end
    elseif itemType == 2 then
        self._itemMeta = lt.EquipDao:query(itemIdx)
        if not self._itemMeta then
            self._itemMeta = lt.EquipDao:query(602001)
        end
    elseif itemType == 3 then
        self._itemMeta = lt.BookDao:query(itemIdx)
        if not self._itemMeta then
            self._itemMeta = lt.BookDao:query(64)
        end
    elseif itemType == lt.Constant.ItemType.ITEM_TYPE_RUNE then
        self._itemMeta = lt.RuneDao:queryGood(itemIdx)
        if not self._itemMeta then
            self._itemMeta = lt.RuneDao:queryGood(102001)
        end
    elseif itemType == 5 then
        self._itemMeta = lt.SpiritEquipDao:queryItem(itemIdx)
        if not self._itemMeta then
            self._itemMeta = lt.SpiritEquipDao:queryItem(100)
        end
    end
end

function ItemData:getObjId()
    return self._objId
end

function ItemData:setObjId(objId)
    self._objId = objId
end

function ItemData:setPropertyArray(propertyArray)
    self._propertyData:setPropertyArray(propertyArray)
end

function ItemData:setValue(key, value)
    self._propertyData:setValue(key, value)
end

function ItemData:getValue(key)
    return self._propertyData:getValue(key)
end

function ItemData:getPreValue(key)
    return self._propertyData:getPreValue(key)
end

function ItemData:getChangeValueByKey(key)
    return self._propertyData:getChangeValueByKey(key)
end

function ItemData:getItemMeta()
    return self._itemMeta
end

-- 保存类型 1背包 2装备 3仓库 4扩容背包 5腰带
function ItemData:setTypePos(typePos)
    self:setValue(ItemValueDef.Attr_SaveType, typePos)
end

function ItemData:getTypePos()
    return self:getValue(ItemValueDef.Attr_SaveType) or 0
end

function ItemData:setSellItem(value)
    self._sell = value
end

function ItemData:getSellItem()
    return self._sell
end
