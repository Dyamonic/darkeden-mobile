--[[
    *******************  道具信息 *******************
    
    Attr_Dura               = 8053,        -- 持久  -- 个数
    Attr_DuraMax            = 8075,        -- 最大持久
    Attr_AddLimit           = 8054,        -- 是否可以叠加    大于0就是可叠加的上限
    Attr_Bound              = 8055,        -- 配置绑定标记   0bit=1 内绑定, 1bit=1 不可丢弃, 2bit=1 不可存仓
    Attr_Price              = 8056,        -- 价格
    Attr_PriceType          = 8077,        -- 价格类型
    Attr_Type               = 8063,        -- 道具小类
    Attr_King               = 8062,        -- 道具大类
    Attr_Quality            = 8064,        -- 道具品质
    Attr_ClearItem          = 8078,        -- 地上消失时间，单位：分钟
    Attr_CreateTime         = 8079,        -- 物品创建时间
    Attr_ValidPeriod        = 8076,        -- 是否具有有效期  大于0有有效期  单位：分钟
    Attr_StorePrice         = 8080,        -- 商铺/摊位物品价格
    Attr_ItemExp            = 8081,        -- 物品基础经验
    Attr_RenewHp            = 8082,        -- 回血 每一次回血的值                     
    Attr_RenewMp            = 8083,        -- 回蓝 每一次回蓝的值                         
    Attr_RenewCd            = 8084,        -- 使用物品冷却时间                                    
    Attr_RenewTime          = 8085,        -- 使用物品持续的时间
    Attr_ItemOwner          = 8086,        -- 物品在地上属于的人POINTID 
    Attr_Deadline           = 8106,        -- 限时道具截止日期
]]

