-- 是否可穿戴
function ItemData:isWearable()
    local itemType = self:getItemType()
    if itemType == Constant.ItemType.ITEM_TYPE_EQUIP then
        local itemMeta = self:getItemMeta()
        local race = lt.GameModule:getHeroRace()
        local heroData = lt.GameModule:getHeroData()
        local sex = heroData:getSex() + 1
        --种族要求
        if tonumber(itemMeta:getRace()) ~= 0 and race ~= tonumber(itemMeta:getRace()) then
            return false
        end
        --性别要求
        if itemMeta:getNeedSex() ~= 0 and sex ~= itemMeta:getNeedSex() then
            return false
        end
        --装备词条额外等级限制
        local totalAffixLv = lt.StrengthenModule:getTotalAffixLv(self)
        --等级要求
        local advState, level = itemMeta:getNeedLevel()
        if advState == Constant.AdvState.NotAdv then
            if level > 0 then
                local heroLevel = heroData:getLevel()
                if heroLevel < level + totalAffixLv then
                    return false
                end
            end
        else
            if heroData:getAdvanceState() ~= Constant.AdvState.Adv then
                return false
            end
            local heroLevel = heroData:getAdvanceLevel()
            if heroLevel < level then
                return false
            end
        end
        --力量要求
        local requireStr = itemMeta:getRequireSTR()
        local heroStr = heroData:getPureSTR()
        if requireStr > 0 and heroStr < requireStr + totalAffixLv*2 then
            return false
        end
        --敏捷要求
        local requireDex = itemMeta:getRequireDEX()
        local heroDex = heroData:getPureDEX()
        if requireDex > 0 and heroDex < requireDex + totalAffixLv then
            return false
        end
        --智力要求
        local requireInt = itemMeta:getRequireINT()
        local heroInt = heroData:getPureINT()
        if requireInt > 0 and heroInt < requireInt + totalAffixLv then
            return false
        end
        --总能力要求
        local requireSum = itemMeta:getRequireSum()
        if requireSum > 0 and heroStr+heroDex+heroInt < requireSum + totalAffixLv then
            return false
        end
        return true
    else
        --宠物死亡显示红色
        if self:getItemPetDeadTime() > 0 then
            local isDie = PetModule:isDie(self:getItemPetDeadTime())
            return not isDie
        end
    end
    return true
end

