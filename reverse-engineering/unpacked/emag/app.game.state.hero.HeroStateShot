local HeroStateShot = class("HeroStateShot", lt.HeroStateBase)

local Constant = lt.Constant
local SkillModule = lt.SkillModule
local SkillEnum = lt.SkillEnum

--[[
    重复连发技能
    技能: 枪
]]

HeroStateShot._skillCode = nil
HeroStateShot._targetAgentId = nil

function HeroStateShot:ctor(heroAgent, skillCode, targetAgentId, mTouch, nTouch)
    HeroStateShot.super.ctor(self, heroAgent)

    self._skillCode     = skillCode
    self._targetAgentId = targetAgentId
    self._mTouch = mTouch
    self._nTouch = nTouch
end

function HeroStateShot:onClear()
                
    HeroStateShot.super.onClear(self)
end

function HeroStateShot:onEnter()
    -- 设置方向
    local mHero, nHero = self._heroAgent:getMNExactly()
    local targetAgent = lt.AgentManager:getAgent(self._targetAgentId)
    local mTarget, nTarget
    if self._mTouch and self._nTouch and not SkillModule:isLongPress() or not targetAgent then
        mTarget, nTarget = self._mTouch, self._nTouch
    else
        if targetAgent then
            mTarget, nTarget = targetAgent:getMNExactly()
        end
    end

    if mTarget then
        local direction = lt.MapUtil:getDirectionToPosition(mHero, nHero, mTarget, nTarget)
        self._heroAgent:setDirection(direction)
    end

    if self._heroAgent:getIsSelf() then
        self._heroAgent:setTargetAgentId(self._targetAgentId)
    end
    self._heroAgent:setRotateShotMN(self._mTouch, self._nTouch)

    if self._skillCode == SkillEnum.SKILL_GUN_SHOT_GUIDANCE then
        lt.SkillManager:playShotGuidance(self._skillCode, self._heroAgent:getAgentId(), self._targetAgentId, self._mTouch, self._nTouch)
    end

    if self._skillCode == lt.SkillEnum.SKILL_SET_AFIRE then
        lt.SkillManager:playSkillAFire(self._skillCode, self._heroAgent:getAgentId(), Constant.ErrorCode.Success, true, self._targetAgentId)
    end

    if not self._heroAgent:getIsSelf() then
        self._heroAgent:addShotTime()
    end
end

function HeroStateShot:onExit()
    if self._heroAgent then
        self._heroAgent:clearShotTime()
    end
end

function HeroStateShot:onUpdate()
    if not self._skillCode then
        return
    end

    if not self._heroAgent then
        return
    end

    if not self._heroAgent:getIsSelf() then
       local shotRepeatSkill = SkillEnum.GUN_SHOT_SKILL_REPEATED_TIMES_TABLE[self._skillCode]
        if shotRepeatSkill == -1 then -- 等于-1枪无限重复
            self:cmdShot()
        end
        
        if shotRepeatSkill and shotRepeatSkill > 0 then -- 连击有次数限制的处理
            if self._heroAgent:getShotTime() < shotRepeatSkill then
                self:cmdShot()
            end
        end
    end
end

function HeroStateShot:cmdShot()
    if self._heroAgent:isStateShot() then
        local cmd = self._heroAgent:getCmdSystem():get()
        if cmd and cmd:getCmdId() == Constant.CmdId.CMD_ATTACK then
            if cmd:getSkillId() == self._skillCode then
                self._heroAgent:getCmdSystem():pop()
                self._heroAgent:addShotTime()
                self:showEffectByCmd(cmd)
                return
            end
        end
    end
end

function HeroStateShot:showEffectByCmd(cmd)
    if cmd:getSkillId() == lt.SkillEnum.SKILL_PLASMA_ROCKET_LAUNCHER or cmd:getSkillId() == lt.SkillEnum.SKILL_XRL_MISSILE then
        local targetAgent = lt.AgentManager:getWorldAgent():getAgent(cmd:getTargetObjId())
        if targetAgent then
            lt.SkillManager:playMissile(cmd:getSkillId(), cmd:getSkillLevel(), self._heroAgent:getAgentId(), targetAgent:getAgentId(), cmd:getCode(), cmd:getExtraCode())
        end
    elseif cmd:getSkillId() == lt.SkillEnum.SKILL_TURRET_FIRE then
        self:changeDir(cmd)
        lt.SkillManager:playTurretFire(cmd:getSkillId(), cmd:getSkillLevel(), self._heroAgent:getAgentId(), cmd:getTargetM(), cmd:getTargetN(), cmd:getCode())
    elseif cmd:getSkillId() == lt.SkillEnum.SKILL_INFINITY_THUNDERBOLT then
        local targetAgent = lt.AgentManager:getWorldAgent():getAgent(cmd:getTargetObjId())
        local targetAgentId = nil
        if targetAgent then
            targetAgentId = targetAgent:getAgentId()
        end

        self:changeDir(cmd)
        lt.SkillManager:playInfinityThunderbolt(cmd:getSkillId(), self._heroAgent:getAgentId(), targetAgentId, cmd:getTargetM(), cmd:getTargetN(), cmd:getCode())
    elseif cmd:getSkillId() == lt.SkillEnum.SKILL_SLAYER_SWORD_SKY_FIRE then
        self:changeDir(cmd)

        local targetAgent = lt.AgentManager:getWorldAgent():getAgent(cmd:getTargetObjId())
        lt.SkillManager:playSlayerSwordSkyFire(cmd:getSkillId(), cmd:getSkillLevel(),self._heroAgent:getAgentId(), targetAgent and targetAgent:getAgentId(), cmd:getCode(), cmd:getTargetM(), cmd:getTargetN())
    elseif cmd:getSkillId() == lt.SkillEnum.SKILL_SET_AFIRE then
        local targetAgent = lt.AgentManager:getWorldAgent():getAgent(cmd:getTargetObjId())
        lt.SkillManager:playSkillAFire(cmd:getSkillId(), self._heroAgent:getAgentId(), cmd:getSkillLevel(), Constant.ErrorCode.Success, true, targetAgent and targetAgent:getAgentId())
    elseif cmd:getSkillId() == SkillEnum.SKILL_SPIT_STREAM or cmd:getSkillId() == SkillEnum.SKILL_SLAYER_BLADE_CUT_STORM then
        local targetAgent = lt.AgentManager:getWorldAgent():getAgent(cmd:getTargetObjId())
        local targetAgentId = nil
         if targetAgent then
            targetAgentId = targetAgent:getAgentId()
        end
        lt.SkillManager:playSpitStream(cmd:getSkillId(),self._heroAgent:getAgentId(), targetAgentId,cmd:getTargetM(), cmd:getTargetN())
    elseif cmd:getSkillId() == SkillEnum.SKILL_MOONLIGHT_SEVER -- 断月斩
        or cmd:getSkillId() == SkillEnum.SKILL_LIGHTNING_HAND then  -- 电光铁手
        -- 目标身上的Effect
        local targetAgent = lt.AgentManager:getWorldAgent():getAgent(cmd:getTargetObjId())
        if targetAgent then
            targetAgent:playParallelEffectByLv(cmd:getSkillId(), 1, Constant.EFFECT.PROCESS)
        end
    end
end

function HeroStateShot:changeDir(cmd)
    local mHero, nHero = self._heroAgent:getMNExactly()
    local mTarget, nTarget = cmd:getTargetM(), cmd:getTargetN()
    local direction = lt.MapUtil:getDirectionToPosition(mHero, nHero, mTarget, nTarget)
    local mulFrame, _, _ = SkillModule:getRepeatConfig(self._heroAgent:getActionId(),cmd:getSkillId())
    if self._heroAgent:getDirection() ~= direction then
        self._heroAgent:setDirection(direction)
        self._heroAgent:getActor():setNextFrameIndex(mulFrame+1)
        self._heroAgent:getActor():setCurShotCount(self._heroAgent:getShotTime())
    end
end

function HeroStateShot:onMessage(msg)
end

function HeroStateShot:getStateId()
    return Constant.HERO_STATE_SHOT
end

function HeroStateShot:getStateName()
    return "HeroStateShot"
end

function HeroStateShot:getSkillId()
    return self._skillCode
end

return HeroStateShot