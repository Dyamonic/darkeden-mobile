local cliggproto = lt.CliGgProto
local SocketManager = lt.SocketManager
local CommonUtil = lt.CommonUtil

local SocketApi = {}

SocketApi._netdata = lt.NetData.new()

SocketApi._Event = {

    SOCKET_CONNECT_SUCCESS  =  "1",   --网络连接成功
    SOCKET_DISCONNECT       =  "2",   --网络连接断开
    SOCKET_CONNECT_FAIL     =  "3",   --网络连接失败
    
    -----------------------下面是从20开始---------------------------
	Login_ACK         = cliggproto.MessageID.GG_CLI_Login_ACK,
	SelectRole_ACK    = cliggproto.MessageID.GG_CLI_SelectRole_ACK,
	CreateRole_ACK    = cliggproto.MessageID.GG_CLI_CreateRole_ACK,
	DelRole_ACK       = cliggproto.MessageID.GG_CLI_DelRole_ACK,
	ReselRole_ACK     = cliggproto.MessageID.GG_CLI_ReselRole_ACK,
	UnDelRole_ACK     = cliggproto.MessageID.GG_CLI_UnDelRole_ACK,
	KickOff_NTF       = cliggproto.MessageID.GG_CLI_KickOff_NTF,
    WaitQue_NTF       = cliggproto.MessageID.GG_CLI_WaitQue_NTF,
    VerifyUserName_ACK = cliggproto.MessageID.GG_CLI_VerifyUserName_ACK
    
    ----------------------100之后给了GS协议-------------------------
}

function SocketApi:init()
    cc.load("event").new():bind(self)

    -- 协议初始化
    lt.CliGgProto:init()
    lt.PacketParser:init()
    lt.SocketManager:init()
end

function SocketApi:clear()
    self:removeAllEventListeners()
end

function SocketApi:addProtoListener(id, theHandler, tag)
    self:addEventListener(tostring(id), theHandler, tag)
end

function SocketApi:removeProtoListenerById(id)
    self:removeEventListenersByEvent(tostring(id))
end

function SocketApi:removeProtoListenerByTag(tag)
    self:removeEventListenersByTag(tag)
end

function SocketApi:dispatchProto(id, param)
    self:dispatchEvent({name=id,param=param})
end

function SocketApi:connect(domain, ip, port)
    return SocketManager:connect(domain, ip, port)
end

function SocketApi:disconnect()
    SocketManager:disconnect()
end

function SocketApi:setServerName(name)
    SocketManager:setServerName(name)
end

function SocketApi:setServerId(id)
    SocketManager:setServerId(id)
end

function SocketApi:setUserId(userId)
    SocketManager:setUserId(userId)
end

function SocketApi:setClientVer(clientVer)
    SocketManager:setClientVer(clientVer)
end

function SocketApi:addListener(messageId, handler, tag)
    local eventName = CommonUtil:composeMessageEventName(messageId)
    self:addEventListener(eventName, handler, tag)
end

function SocketApi:_sendData(msg,msgLen)
    SocketManager:sendData(msg, msgLen)
end

function SocketApi:sendToGs(msgid,msg,msgType)
    
    local bodyLen = 0
    local msgLen = 0
    local data = nil
    msgType = msgType or 0 

    if msg ~= nil then
        
        if msgType == 0 then --默认protocol buffer序列化
            data = msg:SerializeToString()
            msgLen = #data
        else --自己序列化
            
        end
    end
    bodyLen = msgLen + 5

    --这里要加2个头，一个gs头，一个gg头
    self._netdata:reset()
    --gg头
	self._netdata:writeWord(cliggproto.MessageID.CLI_GG_GS_MSG)
	self._netdata:writeWord(bodyLen)
	self._netdata:writeByte(0)
	self._netdata:writeByte(0)
    --gs头
    self._netdata:writeByte(msgType)
    self._netdata:writeWord(msgid)
    self._netdata:writeWord(msgLen)
    if data ~= nil then
        self._netdata:writeBuf(data)
    end

    --发送
    local allData = self._netdata:getData()
    SocketManager:sendData(allData, #allData)

    --lt.LogUtil:debug("sendGs msg:%d len:%d", msgid, #allData)

    self:statisticByte(bodyLen)
end

function SocketApi:statisticByte(bytes)
    self:dispatchProto(tostring(lt.ServerCmdDef.C_STATISTIC_BYTES), {bytes = bytes})
end

function SocketApi:isAlive()
    return SocketManager:isAlive()
end

return SocketApi
