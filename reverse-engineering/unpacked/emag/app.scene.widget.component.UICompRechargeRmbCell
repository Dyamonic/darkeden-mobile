local UICompRechargeRmbCell = class("UICompRechargeRmbCell", lt.UIGButtonBase)

local NtfManager = lt.NtfManager
local GameModule = lt.GameModule
local RechargeModule = lt.RechargeModule
local Constant = lt.Constant
local RechargeShopType = Constant.RechargeShopType

function UICompRechargeRmbCell:ctor()
    UICompRechargeRmbCell.super.ctor(self)
end

function UICompRechargeRmbCell:onConstruct()
    self._lblName = self:getChild("lbl_name")
    self._iconGold = self:getChild("icon_gold")
    self._btnRecharge = self:getChild("btn_recharge")
end

function UICompRechargeRmbCell:onClear()
    self._lblName = nil
    self._iconGold = nil
    self._btnRecharge = nil
    UICompRechargeRmbCell.super.onClear(self)
end

function UICompRechargeRmbCell:onEnter()
    self._btnRecharge:addClickListener(handler(self, self.onRechargeBtnClick))
end
function UICompRechargeRmbCell:onExit()
    self._btnRecharge:removeClickListener()
end

function UICompRechargeRmbCell:setInfo(info, index)
    local point = info:getItemCount()
    local price = info:getPrice()
    local name = info:getName()
    local rechargeId = info:getId()
    local shopType = info:getShopType()
    local wordStr = ""
    local imagStr = _GURL.GetHuobiImg
    if shopType == RechargeShopType.POINT then
        wordStr = GReadText.KEY_SHOPPING_TIPS19
        imagStr = _GURL.GetHuobiImg
    elseif shopType == RechargeShopType.VOUCHER then
        wordStr = GReadText.KEY_SHOPPING_TIPS20
        imagStr = _GURL.GetVoucherImg
    end
    self._lblName:setText(point .. wordStr)
    self._iconGold:setURL(string.format(imagStr, index))
    local newIndex = Constant.PRICE2INDEX[price] or ""
    self._btnRecharge:setIcon((string.format(_GURL.GetRmbImg, newIndex)))
    self._info = {
        point = point,
        price = price,
        productName = name,
        rechargeId = rechargeId,
        shopType = shopType
    }
end

function UICompRechargeRmbCell:onRechargeBtnClick()
    local heroData = GameModule:getHeroData()
    local point = heroData:getGold()

    local shopType = self._info.shopType
    local msgStr = GReadText.KEY_SHOPPING_TIPS21
    local needTips = false
    local rechargeId = self._info.rechargeId
    local price = self._info.price or 999999999999999999
    if shopType == RechargeShopType.POINT then
        msgStr = GReadText.KEY_SHOPPING_TIPS21
        local heroData = lt.GameModule:getHeroData()
        local voucher = 0
        if heroData then
            voucher = heroData:getVoucher()
        end
        if voucher < price then
            needTips = true
        end
    elseif shopType == RechargeShopType.VOUCHER then
        msgStr = GReadText.KEY_SHOPPING_TIPS22
        needTips = true
    end

    if needTips then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_MESSAGEBOX, {
            content = string.format(msgStr, self._info.price, self._info.point),
            confirmCallback = function()
                self:recharge(point)
            end
        })
    else
        self:recharge(point)
    end
end
