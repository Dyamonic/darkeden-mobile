---@class CompItemTips 物品tips
local CompItemTips = class("CompItemTips", lt.UIGButtonBase)
local Constant = lt.Constant
local MIN_H = 91
local MAX_H = 378
local BTN_HEIHT = 45
local BTN_ACCESS_HEIHT = 38

local ItemModule = lt.ItemModule
local NtfManager = lt.NtfManager
local BtnType = Constant.ItemTipBtns
local WndLockManager = lt.WndLockManager
local NpcModule = lt.NpcModule
local SkillEnum = lt.SkillEnum
local SkillModule = lt.SkillModule
local PetModule = lt.PetModule
local RechargeModule = lt.RechargeModule
local AutoFightManager = lt.AutoFightManager
local PROPTIPS_ACCESS = Constant.PROPTIPS_ACCESS
local CommonUtil = lt.CommonUtil
local GuideModule = lt.GuideModule
local FunctionToggleModule = lt.FunctionToggleModule

local BTN_GROUPS = {
    [BtnType.TakeOff]   = {name = GReadText.KEY_ITEMTIPS_TIPS1, type = BtnType.TakeOff},
    [BtnType.TakeOn]   = {name = GReadText.TIPS_ITEM_TAKEON, type = BtnType.TakeOn},
    [BtnType.Replace]   = {name = GReadText.TIPS_ITEM_REPLACE, type = BtnType.Replace},
    [BtnType.Use]       = {name = GReadText.KEY_ITEMTIPS_TIPS2, type = BtnType.Use},
    [BtnType.Discard]   = {name = GReadText.KEY_ITEMTIPS_TIPS3, type = BtnType.Discard},
    [BtnType.Deposit]   = {name = GReadText.KEY_ITEMTIPS_TIPS4, type = BtnType.Deposit}, 
    [BtnType.TakeOut]   = {name = GReadText.KEY_ITEMTIPS_TIPS5, type = BtnType.TakeOut},
    [BtnType.PutInBelt] = {name = GReadText.KEY_ITEMTIPS_TIPS6, type = BtnType.PutInBelt},
    [BtnType.TakeOutBelt]   = {name = GReadText.KEY_ITEMTIPS_TIPS7, type = BtnType.TakeOutBelt},
    [BtnType.Buy]   = {name = GReadText.KEY_ITEMTIPS_TIPS15, type = BtnType.Buy},
    [BtnType.Sell]   = {name = GReadText.KEY_ITEMTIPS_TIPS16, type = BtnType.Sell},
    [BtnType.AllSell]   = {name = GReadText.KEY_ITEMTIPS_TIPS17, type = BtnType.AllSell},
    [BtnType.Repair]   = {name = GReadText.KEY_NPC_REPAIR_TIPS3, type = BtnType.Repair},
    [BtnType.Share]   = {name = GReadText.KEY_ACCESS_TIPS5, type = BtnType.Share},
}

local ACCESS_GROUP = {
    [PROPTIPS_ACCESS.SHOP]   = {name = GReadText.KEY_ACCESS_TIPS1, type = PROPTIPS_ACCESS.SHOP},
    [PROPTIPS_ACCESS.NPC]    = {name = GReadText.KEY_ACCESS_TIPS2, type = PROPTIPS_ACCESS.NPC},
    [PROPTIPS_ACCESS.DUNGEON]= {name = GReadText.KEY_ACCESS_TIPS3, type = PROPTIPS_ACCESS.DUNGEON},
    [PROPTIPS_ACCESS.TEXT]   = {name = GReadText.KEY_ACCESS_TIPS4, type = PROPTIPS_ACCESS.TEXT},
}

local equipQuality = {
    [0] = cc.c3b(255, 255, 255),
    [1] = cc.c3b(255, 255, 0),
    [2] = cc.c3b(155, 155, 255),
    [3] = cc.c3b(255, 80, 80),
}
local equipEnQuality = {
    [0] = cc.c3b(200, 200, 200),
    [1] = cc.c3b(206, 206, 99),
    [2] = cc.c3b(123, 123, 255),
    [3] = cc.c3b(206, 64, 64),
}
local equipShadow = {
    [0] = cc.c3b(100, 100, 100),
    [1] = cc.c3b(100, 100, 0),
    [2] = cc.c3b(0, 0, 255),
    [3] = cc.c3b(100, 15, 15),
}

local EXPAND_OP = {
    TAKEON = 0,
    TAKEOFF = 1
}
local EventTag = {
    TouchBegin = 1000,
    ClickItem = 1001,
}

local SpecialLingshi = 201040

function CompItemTips:ctor()
    CompItemTips.super.ctor(self)
    self._btnType = nil
    self._contentRichText = nil
    -- 存储所有tween引用
    self._blinkTweenArray = nil
end 

function CompItemTips:onConstruct()
    self._itemView = self:getChild("itemTips")
    self._txtList = self._itemView:getChild("txtList")
    self._btnTabList = self._itemView:getChild("tabList")
    self._bg = self._itemView:getChild("bg")
    self._compTxt = self._txtList:addItemFromPool()
    self._touchLayer = self:getChild("touch")

    self._accessList = self._itemView:getChild("accessList")
    self._panelAccess = self._itemView:getChild("panelAccess")
    self._bgAccess = self._itemView:getChild("bg_access")
end

function CompItemTips:onClear()
    self:stopBlinkAnimation()

    self._itemView = nil
    self._txtList = nil
    self._bg = nil
    self._compTxt = nil

    self._accessList = nil
    self._panelAccess = nil
    self._bgAccess = nil

    self._touchLayer = nil
    self._btnTabList = nil
    self._tipsTypeFrom = nil
    self._contentRichText = nil
    self._itemInfo = nil
    self._nameT = nil
    self._nameEnT = nil
    self._brandT = nil
end

function CompItemTips:onEnter()
    self._touchLayer:addEventListener(fgui.UIEventType.TouchBegin, handler(self, self.onLayerClick))
    self._btnTabList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickBtnHandler))
    self._accessList:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItemAccess))
end

function CompItemTips:onExit()
    self._touchLayer:removeEventListener(fgui.UIEventType.TouchBegin)
    self._btnTabList:removeEventListener(fgui.UIEventType.ClickItem)
    self._accessList:removeEventListener(fgui.UIEventType.ClickItem)
end

function CompItemTips:onLayerClick()
    --判断如果是买卖界面取消选中
    if self._tipsTypeFrom == Constant.PROPTIPS_FORM.BUY or self._tipsTypeFrom == Constant.PROPTIPS_FORM.SELL
    or self._tipsTypeFrom == Constant.PROPTIPS_FORM.Display then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_TRADE_CHOOSE)
    elseif self._tipsTypeFrom == Constant.PROPTIPS_FORM.BAG or self._tipsTypeFrom == Constant.PROPTIPS_FORM.WAREHOUSE then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_SELECT_STATE_ITEM)
    elseif self._tipsTypeFrom == Constant.PROPTIPS_FORM.REPAIR then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_REPAIR_CHOOSE)
    end
    self:hideSelf()
end

function CompItemTips:clear()
    if  self._contentRichText then
        self._contentRichText:setText("")
    end
    self._btnTabList:removeChildrenToPool()
    self._accessList:removeChildrenToPool()
end

function CompItemTips:setItemTxtUI(param)
    self:setVisible(true)
    self:clear()

    self._itemInfo = param.itemInfo
    self._tipsTypeFrom = param.tipsType

    local item = param.itemInfo
    if item:getItemMeta() == nil then
        item = lt.ItemModule:getItemDataByConfig(item)
    end
    self:btnGroupsShow(item)
    self:itemAccessShow(item)

    local itemConfig = item:getItemMeta()
    local itemName = itemConfig:getName()
    local itemEnName = itemConfig:getEnName()
    local itemNum = item:getNum() or 1
    local itemDecr = itemConfig:getDes()
    local itemQuality = itemConfig:getQuality()
    if self._nameT == nil then
        self._nameT = ccui.Text:create()
        self._nameT:setFontName(Constant.FONT_4)
        self._nameT:setFontSize(22)
        self._compTxt:displayObject():addChild(self._nameT)
    end
    local qualityColor = equipQuality[itemQuality]
    local shadowColor = equipShadow[itemQuality]
    self._nameT:setString(itemName)
    self._nameT:setTextColor(qualityColor)
    self._nameT:enableShadow(shadowColor, cc.size(1,-1), 1)

    local qualityEnColor = equipEnQuality[itemQuality]
    if self._nameEnT == nil then
        self._nameEnT = ccui.Text:create()
        self._nameEnT:setFontName(Constant.FONT_4)
        self._nameEnT:setFontSize(18)
        self._compTxt:displayObject():addChild(self._nameEnT)
    end
    self._nameEnT:setString(string.format("(%s)",itemEnName))
    self._nameEnT:setTextColor(qualityColor)
    self._nameEnT:enableShadow(shadowColor, cc.size(1,-1), 1)

    --标记(限时/绑定/锁定)
    if self._brandT == nil then
        self._brandT = ccui.Text:create()
        self._brandT:setFontName(Constant.FONT_4)
        self._brandT:setFontSize(22)
        self._compTxt:displayObject():addChild(self._brandT)
    end
    self._brandT:setVisible(false)

    self._contentRichText = self._compTxt:getChild("detail")

    local commonTable = {
        [1] = {key = GReadText.KEY_ITEMTIPS_TIPS21, value = nil},
        [2] = {key = GReadText.KEY_ITEMTIPS_TIPS22, value = nil},
        [3] = {key = GReadText.KEY_ITEMTIPS_TIPS9, value = itemNum},
        [4] = {key = GReadText.KEY_ITEMTIPS_TIPS11, value = nil},
        [5] = {key = GReadText.KEY_ITEMTIPS_TIPS12, value = nil},
        [6] = {key = GReadText.KEY_ITEMTIPS_TIPS13, value = nil},
    }

    --宠物显示
    if itemConfig:getKind() == Constant.PropType.PET then
        --等级
        local petLevel = PetModule:getPetLevel(item:getItemPetExp())
        commonTable[1].key = GReadText.KEY_TEAM_HALL_TIPS9
        commonTable[1].value = petLevel
        --属性1
        commonTable[2].key = GReadText.KEY_PET_TIPS3
        commonTable[2].value = nil
        local attr1 = item:getItemPetAttr1()
        if attr1 > 0 then
            local petLevel = PetModule:getPetLevel(item:getItemPetExp())
            local optionInfo = lt.CacheManager:getOptionInfoMeta(attr1)
            local petAttr = lt.CacheManager:getPetAttrByPetLevel(attr1,petLevel)
            if optionInfo and petAttr then
                commonTable[2].value = optionInfo:getName() .. "+" .. petAttr:getAccumAttr()
            end
        end

        --属性2
        commonTable[3].key = GReadText.KEY_PET_TIPS3
        commonTable[3].value = nil
        local attr2 = item:getItemPetAttr2()
        if attr2 > 0 then
            local attrMeta = lt.CacheManager:getAttributeMetaByOptionId(attr2)
            if attrMeta then
                commonTable[3].value = attrMeta:getName()
                commonTable[3].colorStr = "#ffff00"
            end
        end
        
        --属性3
        commonTable[4].key = GReadText.KEY_PET_TIPS3
        commonTable[4].value = nil
        local attr3 = item:getItemPetAttr3()
        if attr3 > 0 then
            commonTable[4].value = GReadText.KEY_PET_TIPS37 .. attr3
            if commonTable[3].value then
                commonTable[4].key = ""
                commonTable[4].value = "      " .. commonTable[4].value
                commonTable[4].colorStr = "#ffff00"
            end
        end

        --组合
        commonTable[5].key = GReadText.KEY_PET_TIPS70
        commonTable[5].value = nil
        local compose= item:getItemPetCompose()
        if type(compose) == "string" and compose ~= "" then
            local composeList = string.split(compose, ",")
            local key   = tonumber(composeList[1])
            local value = tonumber(composeList[2])
            local optionInfo = lt.CacheManager:getOptionInfoMeta(key)
            if optionInfo then
                commonTable[5].value = optionInfo:getName() .. "+" .. value
                commonTable[5].colorStr = "#ffff00"
            end
        end

        --饲料
        if item:getItemPetDeadTime() > 0 then
            local isDie = PetModule:isDie(item:getItemPetDeadTime())
            if isDie then
                --死亡显示已死亡天数
                local day = PetModule:getDeadTime(item:getItemPetDeadTime())
                commonTable[6].key = ""
                commonTable[6].value = "      "..string.format(GReadText.KEY_ITEMTIPS_TIPS25, day)
            else
                --存活显示饲料
                local day, hour = PetModule:getSurviveTime(item:getItemPetDeadTime())
                hour = math.ceil(hour/3600)
                commonTable[6].key = GReadText.KEY_ITEMTIPS_TIPS24
                commonTable[6].value = string.format(GReadText.KEY_ITEMTIPS_TIPS26, day, hour)
            end
        end
    end

    --道具效果
    if itemConfig:getKind() == Constant.PropType.CONSUMABLES then
        if itemConfig:getType() == Constant.PropTypeSub_3.SlayerPotion or
            itemConfig:getType() == Constant.PropTypeSub_3.VampirePotion or
            itemConfig:getType() == Constant.PropTypeSub_3.OustersPotion or
            itemConfig:getType() == Constant.PropTypeSub_3.CommonPotion then
            local param = itemConfig:getEffectParam()
            for i = 1, #param do
                if param[i][1] == "Hp" then
                    commonTable[1].key = GReadText.KEY_ITEMTIPS_TIPS21
                    commonTable[1].value = "+"..param[i][2]
                elseif param[i][1] == "Mp" then
                    local race = lt.GameModule:getHeroData():getRace()
                    commonTable[2].key = race == Constant.RaceType.Ousters and GReadText.KEY_ITEMTIPS_TIPS23 or GReadText.KEY_ITEMTIPS_TIPS22
                    commonTable[2].value = "+"..param[i][2]
                end
            end
        end
    elseif itemConfig:getKind() == Constant.PropType.TRANSFER then
        if itemConfig:getType() == Constant.PropTypeSub_6.SlayerTransform then
            commonTable[3].key = GReadText.KEY_PET_TIPS3
            commonTable[3].value = nil
        end
    end
    
    ---地图标记
    if itemConfig:getKind() == Constant.PropType.TRANSFER then
        if itemConfig:getType() == Constant.PropTypeSub_6.SlayerTransform then
            local useCountStr = self:getUseCount(item)
            commonTable[4].value = useCountStr
        elseif itemConfig:getType() == Constant.PropTypeSub_6.VampireTransform
        or itemConfig:getType() == Constant.PropTypeSub_6.VampireTransformS then
            local markStr = self:getMarkInfo(item)
            commonTable[5].value = markStr
        end
    end
    
    --TODO 其他字段后续有该功能了，再补充
    local textTable = {}
    for _, info in ipairs(commonTable) do
        if info.value ~= nil then
            table.insert(textTable,"[color=#c6c3ff]")
            table.insert(textTable,info.key)
            if info.colorStr then
                table.insert(textTable,string.format("[/color][color=%s]",info.colorStr))
            else
                
                table.insert(textTable,"[/color][color=#ffffff]")
            end
            table.insert(textTable,info.value)
            --特殊要求：道具数量：%d个
            if info.key == GReadText.KEY_ITEMTIPS_TIPS9 then
                table.insert(textTable," "..GReadText.KEY_ITEMTIPS_TIPS27)
            end
            table.insert(textTable,"\n[/color]")
        end
    end

    --购买/出售价格
    if self._tipsTypeFrom == Constant.PROPTIPS_FORM.BUY or self._tipsTypeFrom == Constant.PROPTIPS_FORM.SELL then
        local money = 0
        if self._tipsTypeFrom == Constant.PROPTIPS_FORM.BUY then
            money = NpcModule:getShopBuyPrice(Constant.ItemType.ITEM_TYPE_PROP, item, itemConfig)
        else
            money = NpcModule:getShopSellPrice(Constant.ItemType.ITEM_TYPE_PROP, item, itemConfig)
        end
        if money > 0 then
            table.insert(textTable,"[color=#c6c3ff]")
            table.insert(textTable, GReadText.KEY_EQUIP_TIPS33)
            table.insert(textTable,"[/color][color=#ffffff]")
            table.insert(textTable, "$"..money)
            table.insert(textTable,"\n[/color]")
        end
    end

    --描述
    if type(itemDecr) == "string" and itemDecr ~= "" then
        table.insert(textTable,"[color=#FF8242]")
        table.insert(textTable, itemDecr)
        table.insert(textTable,"\n[/color]")
    end

    --不可出售
    if self._tipsTypeFrom == Constant.PROPTIPS_FORM.SELL then
        local money = NpcModule:getShopSellPrice(Constant.ItemType.ITEM_TYPE_PROP, item, itemConfig)
        if money == 0 then
            table.insert(textTable,"[color=#FF0000]")
            table.insert(textTable, GReadText.KEY_NPC_TRADE_TIPS9)
            table.insert(textTable,"\n[/color]")
        end
    end

    local isBind = false
    if item:getDeadline() ~= 0 then
        --限时
        self._nameT:setTextColor(cc.c3b(255, 245, 125))
        self._nameT:enableShadow(cc.c3b(0, 0, 0, 0))
        self._nameEnT:setTextColor(cc.c3b(255, 245, 125))
        self._nameEnT:enableShadow(cc.c3b(0, 0, 0, 0))
        self._brandT:setString("("..GReadText.KEY_EQUIP_TIPS37..")")
        self._brandT:setTextColor(cc.c3b(255, 245, 125))
        self._brandT:setVisible(true)

        --闪烁动画
        self:startBlinkAnimation()

        table.insert(textTable,"[color=#FF0000]")
        table.insert(textTable, GReadText.KEY_NPC_TRADE_TIPS15)
        table.insert(textTable,"\n[/color]")

        --计算剩余时间
        local serverTime = lt.TimeCounter:serverTime()
        local leftime = item:getDeadline() - serverTime
        if leftime <= 0 then
            table.insert(textTable,GReadText.KEY_EQUIP_TIPS39)
        else
            table.insert(textTable,"[color=#c6c3ff]")
            table.insert(textTable, GReadText.KEY_EQUIP_TIPS38)
            table.insert(textTable,"[/color]")
            local strs = ""
            local day, hour, minite = lt.CommonFunc:secondsToTime(leftime)
            if day > 0 then
                strs = day..GReadText.KEY_EQUIP_TIPS40..hour..GReadText.KEY_EQUIP_TIPS41..minite..GReadText.KEY_EQUIP_TIPS42
            elseif hour > 0 then
                strs = hour..GReadText.KEY_EQUIP_TIPS41..minite..GReadText.KEY_EQUIP_TIPS42
            else
                if minite == 0 then minite = 1 end
                strs = minite..GReadText.KEY_EQUIP_TIPS42
            end
            table.insert(textTable,strs)
        end
    else
        --判断绑定
        if item:getBound() == Constant.BOUND_TYPE.FIXED_BOUND or item:getBound() == Constant.BOUND_TYPE.DOUBLE_BOUND then
            --固定绑定
            self._nameT:setTextColor(equipQuality[0])
            self._nameT:enableShadow(equipShadow[0], cc.size(1,-1), 1)
            self._nameEnT:setTextColor(equipEnQuality[0])
            self._nameEnT:enableShadow(equipShadow[0], cc.size(1,-1), 1)
            self._brandT:setString("("..GReadText.KEY_EQUIP_TIPS36..")")
            self._brandT:setTextColor(Constant.COLOR_TEXT_RED)
            self._brandT:setVisible(true)

            table.insert(textTable,"[color=#FF0000]")
            table.insert(textTable, GReadText.KEY_NPC_TRADE_TIPS15)
            table.insert(textTable,"\n[/color]")
        elseif item:getBound() == Constant.BOUND_TYPE.MONTH_BOUND then
            --月卡绑定(且自己没有月卡)
            local isMonthCard = RechargeModule:checkMonthCard()
            if not isMonthCard then
                self._brandT:setString("("..GReadText.KEY_EQUIP_TIPS47..")")
                self._brandT:setTextColor(cc.c3b(255, 136, 0))
                self._brandT:setVisible(true)

                table.insert(textTable,"[color=#FF0000]")
                table.insert(textTable, GReadText.KEY_NPC_TRADE_TIPS15)
                table.insert(textTable,"\n[/color]")

                table.insert(textTable,"[color=#FF8800]")
                table.insert(textTable, GReadText.KEY_NPC_TRADE_TIPS16)
                table.insert(textTable,"\n[/color]")
            end
        end
        self._nameT:setOpacity(255)
        self._nameEnT:setOpacity(255)
        self._brandT:setOpacity(255)
    end

    local textStr = table.concat(textTable)
    self._contentRichText:setText(textStr)

    local richTextH = self._contentRichText:getHeight() + 65
    local richTextW = self._contentRichText:getWidth()
    self._compTxt:setSize(richTextW,richTextH)

    if richTextH < MIN_H then
        richTextH = MIN_H
    end

    if richTextH > MAX_H then
        richTextH = MAX_H
    end

    self._bg:setHeight(richTextH+12)
    self._txtList:setHeight(richTextH)
    self._itemView:setHeight(richTextH)
    self._itemView:setPivot(0.5, 0, true)
    local pt = param.pt -- 位置
    local pivot = param.pivot -- 锚点
    local size = cc.size(1136, 640)
    local offset = display.width/2 - size.width/2
    
    local offsetValue = lt.AutoFightManager:getEditConfOffsetValue()

    if pt then
        self._itemView:setPosition(math.floor(pt.x) - offset, math.floor(pt.y))
    else
        self._itemView:setPosition(display.cx + offsetValue - offset, 130)
    end
    if pivot and pivot.x and pivot.y then
        self._itemView:setPivot(pivot.x, pivot.y, true)
    else
        self._itemView:setPivot(0.5, 0, true)
    end
    self._nameT:setPosition(cc.p(5+self._nameT:getContentSize().width/2, richTextH-4-self._nameT:getContentSize().height/2))
    self._nameEnT:setPosition(cc.p(4+self._nameEnT:getContentSize().width/2, richTextH-30-self._nameT:getContentSize().height/2))
    self._brandT:setPosition(cc.p(300-self._brandT:getContentSize().width/2, richTextH-4-self._nameT:getContentSize().height/2))

    lt.ScheduleUtil:performWithDelayGlobal(function()
        self:checkGuide()
    end, 0.1)
end

function CompItemTips:getMarkInfo(item)
    local markInfo = item:getMarkInfo()
    local markStr = ""
    if markInfo.mapId and markInfo.mapId ~= 0 then
        local mapMeta = lt.CacheManager:getMapMeta(markInfo.mapId)
        local mapName = mapMeta:getMapName()
        markStr = string.format("%s\n          X:%s Y:%s",mapName, markInfo.x, markInfo.y)
    else
        markStr = "没有"
    end
    return markStr
end

function CompItemTips:getUseCount(item)
    local useCount = item:getUseCount()
    local maxCount = item:getItemMeta():getEffectParam()[1][2]
    local useCountStr = useCount.."/"..maxCount
    return useCountStr
end

function CompItemTips:getColorByQuality(quality)
    return COLOR_NAME[quality] or "white"
end

function CompItemTips:onClickBtnHandler(context)
    local btn = context:getData()
    local type = btn.btnType
    self:btnUseByType(type)
end

function CompItemTips:btnGroupsShow(item)
    local itemConfig = item:getItemMeta() or item
    local kind = itemConfig:getKind()
    local itemType = itemConfig:getType()
    local btnsGroups = {}
    if self._tipsTypeFrom == Constant.PROPTIPS_FORM.BAG then
        if kind ~= Constant.ACTIVITY then
            if item:getTypePos() == Constant.ItemTypePos.Item_InExpandBag then -- 扩展背包位置显示取出按钮
                table.insert(btnsGroups, BTN_GROUPS[BtnType.TakeOff])
            else-- 其他位置按钮显示
                -- 仓库多窗口只能存入操作
                if WndLockManager:getWndLockType() == Constant.WndLockType.WareHouse then
                    -- 不显示存入按钮的类型列表
                    local ignoreList = { Constant.ItemType.ITEM_TYPE_PET }
                    local isIgnore = false
                    for k,v in pairs(ignoreList) do
                        if v == kind then
                            isIgnore = true
                        end
                    end

                    btnsGroups = {}
                    if not isIgnore then
                        table.insert(btnsGroups, BTN_GROUPS[BtnType.Deposit])
                    end
                else
                    -- 正常背包显示
                    -- 使用按钮
                    if kind == Constant.PropType.BAG then
                        table.insert(btnsGroups, BTN_GROUPS[BtnType.TakeOn])
                        ---满了之后使用修改为替换
                        if table.nums(ItemModule:getExpandArray()) == Constant.ExpandMaxCnt then 
                            for index, btnInfo in ipairs(btnsGroups) do
                                if btnInfo.type == BtnType.TakeOn then
                                    btnsGroups[index] = BTN_GROUPS[BtnType.Replace]
                                end
                            end
                        end
                    else
                        --灵石没有使用按钮(追讨者灵石除外)
                        if itemConfig:getItemId() == SpecialLingshi or kind ~= Constant.PropType.TROPHY or itemType ~= Constant.PropTypeSub_2.LINGSHI then
                            if (kind == Constant.PropType.PET and not FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.Pet)) or
                                (kind == Constant.PropType.OTHER and itemType == Constant.PropTypeSub_11.ZIMOTT) or 
                                 (kind == Constant.PropType.OTHER and itemType == Constant.PropTypeSub_11.HALO) then

                            else
                                table.insert(btnsGroups, BTN_GROUPS[BtnType.Use])
                            end
                        end
                    end
                   
                    -- 放入腰带按钮
                    -- 口袋数量 > 0
                    local isShow = itemConfig:getPutBelt() == 1
                    local pocketCount = ItemModule:getPocketCount()
                    if (pocketCount > 0) and isShow then 
                        table.insert(btnsGroups, BTN_GROUPS[BtnType.PutInBelt])
                    end

                    -- 是否能丢弃
                    local isDrop = itemConfig:getIsDrop() or 0
                    -- 丢弃(限时绑定道具没有丢弃)
                    if item:getDeadline() == 0 and isDrop ~= 1 and 
                    (item:getBound() == Constant.BOUND_TYPE.NO_BOUND or item:getBound() == Constant.BOUND_TYPE.MONTH_BOUND) then
                        table.insert(btnsGroups, BTN_GROUPS[BtnType.Discard])
                    end
                    -- 分享
                    table.insert(btnsGroups, BTN_GROUPS[BtnType.Share])

                    --判断是否可以出售
                    if itemConfig:getSell() == 1 then
                        table.insert(btnsGroups, BTN_GROUPS[BtnType.Sell])
                    end
                    --灵石道具(怪物头颅)需要一键出售
                    if itemConfig:getKind() == Constant.PropType.TROPHY and itemConfig:getType() == Constant.PropTypeSub_2.LINGSHI then
                        table.insert(btnsGroups, BTN_GROUPS[BtnType.AllSell])
                    end
                end
            end
        end
    elseif self._tipsTypeFrom == Constant.PROPTIPS_FORM.WAREHOUSE then
        table.insert(btnsGroups, BTN_GROUPS[BtnType.TakeOut])
    elseif self._tipsTypeFrom == Constant.PROPTIPS_FORM.BELT then
        table.insert(btnsGroups, BTN_GROUPS[BtnType.TakeOutBelt])
    elseif self._tipsTypeFrom == Constant.PROPTIPS_FORM.BUY then
        table.insert(btnsGroups, BTN_GROUPS[BtnType.Buy])
    elseif self._tipsTypeFrom == Constant.PROPTIPS_FORM.SELL then
        --判断是否可以出售
        if itemConfig:getSell() == 1 then
            table.insert(btnsGroups, BTN_GROUPS[BtnType.Sell])
        end
        --灵石道具(怪物头颅)需要一键出售
        if itemConfig:getKind() == Constant.PropType.TROPHY and itemConfig:getType() == Constant.PropTypeSub_2.LINGSHI then
            table.insert(btnsGroups, BTN_GROUPS[BtnType.AllSell])
        end
    elseif self._tipsTypeFrom == Constant.PROPTIPS_FORM.REPAIR then
        --判断是否可以维修
        local effectParam = itemConfig:getEffectParamJson()
        if effectParam and effectParam["Use"] and effectParam["Maintain"] then
            local useCount = item:getUseCount()
            if useCount < effectParam["Use"][2] then
                table.insert(btnsGroups, BTN_GROUPS[BtnType.Repair])
            end
        end
    end

    --某些道具没有按钮
    if kind == Constant.PropType.OTHER and itemType == Constant.PropTypeSub_11.ADVANCE then
        btnsGroups = {}
    end
    
    --销毁按钮
    local race = lt.GameModule:getHeroData():getRace()
    for _, btnInfo in ipairs(btnsGroups) do
        local btnNode = self._btnTabList:addItemFromPool()
        if btnInfo.type == BtnType.TakeOutBelt or btnInfo.type == BtnType.PutInBelt then
            btnNode:setTitle(string.format(btnInfo.name, GReadText["KEY_BELT_"..race]))
        else
            btnNode:setTitle(btnInfo.name)
        end
        btnNode.btnType = btnInfo.type
    end

    local originalSize = self._btnTabList:getSize()
    self._btnTabList:setSize(originalSize.width, BTN_HEIHT * #btnsGroups + #btnsGroups * 2)
end

function CompItemTips:btnUseByType(type)
    self:hideSelf()
    local itemConfig = self._itemInfo:getItemMeta() or self._itemInfo
    local kind = itemConfig:getKind()
    local itemType = itemConfig:getType()
    if type == BtnType.Use then
        local itemId = itemConfig:getItemId()
        if lt.CommonFunc:isInArray(SkillEnum.USE_SKILL_ITEMS[SkillEnum.BLOODY_TUNNEL], itemId) then --技能相关物品
            if (self._itemInfo:getMarkMapId() == nil or tonumber(self._itemInfo:getMarkMapId()) == 0) then
                if SkillModule:hasSkill(SkillEnum.MAGIC_BLOODY_MARK) then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_PROP_USE, {itemId = itemId, callback = function()
                        local itemObjId = self._itemInfo:getObjId()
                        lt.GameModule:sendAttack(SkillEnum.MAGIC_BLOODY_MARK, 0, 0, 0, 0, itemObjId)
                    end})
                else
                    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = "未学习技能：血之印记"})
                end
            elseif self._itemInfo:getMarkMapId() and tonumber(self._itemInfo:getMarkMapId()) > 0 then
                if SkillModule:hasSkill(SkillEnum.BLOODY_TUNNEL) then
                    NtfManager:dispatchNtf(NtfManager.NTF.NTF_PROP_USE, {itemId = itemId, callback = function()
                        local itemObjId = self._itemInfo:getObjId()
                        lt.GameModule:sendAttack(SkillEnum.BLOODY_TUNNEL, 0, 0, 0, 0, itemObjId)
                    end})
                else
                    lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = "未学习技能：血之漩涡"})
                end
            end
            return
        elseif itemId == 310001 or itemId == 310002 or itemId == 310003 then --喇叭
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndChatLaba", itemObjID = self._itemInfo:getObjId() })
            return
        elseif itemId == 1302027 or itemId == 1302041 or itemId == 1302042 then --广告牌
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndCustomize", itemObjID = self._itemInfo:getObjId() })
            return
        -- elseif kind == Constant.PropType.VEHICLE and (itemType == Constant.PropTypeSub_5.Slayer_key or itemType == Constant.PropTypeSub_5.Vampire_key 
        --     or itemType == Constant.PropTypeSub_5.Ousters_key) then--载具
        --     local open,tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.Mount)
        --     if not open then
        --         NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
        --         return
        --     end
        --     NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndMountMain",param = {itemId = itemId}}) 
        --     return
        elseif (kind == Constant.PropType.PERSONALIZATION and itemType == Constant.PropTypeSub_8.HALO) then
            local open,tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.Aura)
            if not open then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP, {content = tips})
                return
            end
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndMountMain",param = {index = Constant.FITER_MOUNT_TYPE.HALO,itemId = itemId}}) 
            return
        end
        
        ItemModule:sendUseItemLimit(self._itemInfo)
    elseif type == BtnType.TakeOn then
        if kind == Constant.PropType.BAG then--扩容背包
            local emptyPos = ItemModule:getEmptyPos()
            self:sendTakeOnExpand(emptyPos)
        end
    elseif type == BtnType.Replace then
        if kind == Constant.PropType.BAG then--扩容背包
            local replaceH = itemConfig:getEffectParam()[1][2]
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_REPLACE_EXPAND,{replaceH = replaceH, tag = "EXPAND_REPLACE", callback = function(pos)
                self:sendTakeOnExpand(pos)
            end})
        end
    elseif type == BtnType.Split then
    elseif type == BtnType.TakeOff then
        if kind == Constant.PropType.BAG then --扩容背包
            self:sendTakeOffExpand()
        else
            print("TODO TakeOff")
        end
    elseif type == BtnType.Discard then
        self:discardItem(self._itemInfo)
    elseif type == BtnType.Deposit then --存入仓库
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_WEARHOUSE_DEPOSIT,{ itemInfo = self._itemInfo})
    elseif type == BtnType.TakeOut then --取出仓库
        if self._itemInfo:getNum() > 1 then
            lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_MESSAGEBOX_NUM, 
            {
                content = GReadText.KEY_WAREHOUSE_DEPOSIT_NUM2,
                confirmCallback = function(curNum)
                    ItemModule:sendFromDepotOut(self._itemInfo:getObjId(),self._itemInfo:getPos(),curNum)
                end,
                param = {
                    maxNum = self._itemInfo:getNum(),
                }
            })
        else
            ItemModule:sendFromDepotOut(self._itemInfo:getObjId(),self._itemInfo:getPos(),1)
        end
    elseif type == BtnType.PutInBelt then --放入腰带
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_PUT_IN_BELT_EVENT,{ itemInfo = self._itemInfo})
    elseif type == BtnType.TakeOutBelt then -- 取出腰带
        yflog:Info("BELT TAKEOUT")
        ItemModule:sendBeltItemOperate(1,self._itemInfo:getObjId(),self._itemInfo:getPos())
        WndLockManager:clearSelectItemInfo()
    elseif type == BtnType.Buy then -- 买
        self:btnUseFunc(BtnType.Buy)
    elseif type == BtnType.Sell then -- 卖
        self:btnUseFunc(BtnType.Sell)
    elseif type == BtnType.AllSell then -- 一键卖
        local wndLockType = WndLockManager:getWndLockType()
        if not wndLockType or (wndLockType ~= Constant.WndLockType.Trade) then
            NpcModule:setNpcId(nil)
        end 
        --服务器交互
        NpcModule:sendSellItem(1, kind, itemType, self._itemInfo)
        --判断如果是买卖界面取消选中
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_TRADE_CHOOSE)
    elseif type == BtnType.Repair then --维修
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_REFRESH_REPAIR_VIEW)
    elseif type == BtnType.Share then --分享
        if lt.ChatModule._isChating == false then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_DLG_MAIN_VIEW, {class = "UIWndInventory", close = true})
            lt.ChatModule:openChatUI()
        end
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_CHAT_ADDKINK_POST, {items = self._itemInfo,index = 1})
    end
end

function CompItemTips:hideSelf()
    self:stopBlinkAnimation()
    self:setVisible(false)
end

-----------------protocol --------------------------------

function CompItemTips:sendTakeOnExpand(pos)
    -- if not emptyPos then
    --     lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_ITEMTIPS_TIPS14})
    --     return
    -- end
    local param = {
        operateId = EXPAND_OP.TAKEON,
        pos = pos - 1,
        objId = self._itemInfo:getObjId()
    }
    ItemModule:setOperateExpandItemH(self._itemInfo:getItemMeta():getEffectParam()[1][2])
    ItemModule:sendExpandBag(param)
end

function CompItemTips:sendTakeOffExpand()
    local param = {
        operateId = EXPAND_OP.TAKEOFF,
        pos = self._itemInfo:getPos() - 1,
        objId = self._itemInfo:getObjId()
    }
    ItemModule:setOperateExpandItemH(self._itemInfo:getItemMeta():getEffectParam()[1][2])
    ItemModule:sendExpandBag(param)
end

function CompItemTips:btnUseFunc(types)
    if types == BtnType.Buy then
        --购买
        self:buyFunc()
    elseif types == BtnType.Sell then
        --出售
        self:sellFunc()
    end
end

function CompItemTips:buyFunc()
    local tradeItem = WndLockManager:getTradeItemInfo()
    if not tradeItem then
        return
    end
    local tradeMeta = tradeItem.meta
    local meta = self._itemInfo:getItemMeta() or self._itemInfo
    local isMeta = self._itemInfo:getItemMeta() == nil
    if tradeMeta:getAddLimit() > 1 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SELL,
        {   
            closeCallback = function()
                --取消选中
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_TRADE_CHOOSE)
            end,
            confirmCallback = function(buyNum)
                --买东西先判断金币是否足够
                local price = NpcModule:getShopBuyPrice(Constant.ItemType.ITEM_TYPE_PROP, not isMeta and self._itemInfo or nil, isMeta and self._itemInfo or nil)
                local totalPrice = price * buyNum
                local enoughMoney = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN, totalPrice, {tips = true})
                if not enoughMoney then
                    return
                end
                --取消选中
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_TRADE_CHOOSE)
                --服务器交互
                NpcModule:sendExchangeItem(tradeMeta:getItemId(), tradeItem.types, tradeMeta:getSite(), buyNum)
            end,
            calculateMaxNum = function()
                --堆叠数量上限
                local addLimite = NpcModule:getMaxShopBuyNum(Constant.ItemType.ITEM_TYPE_PROP, self._itemInfo)
                --携带的金币数
                local coinNum = ItemModule:getValueItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN)
                local canBuyNum = math.floor(coinNum/meta:getPrice())
                local maxNum = addLimite > canBuyNum and canBuyNum or addLimite
                if maxNum <= 0 then maxNum = 1 end
                return maxNum
            end,
            refreshInfo = function(buyNum)
                --详情
                local nameStr = (tradeMeta and tradeMeta.getItemName) and tradeMeta:getItemName() or meta:getName()
                local descStr = string.format(GReadText.KEY_NPC_TRADE_TIPS1, "[color=#00ff00]"..nameStr.."[/color]")
                --消耗
                local haveNum = ItemModule:getValueItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN)
                local price = NpcModule:getShopBuyPrice(Constant.ItemType.ITEM_TYPE_PROP, not isMeta and self._itemInfo or nil, isMeta and self._itemInfo or nil)
                local totalNum = price * buyNum
                local colorStr = haveNum < totalNum and "[color=#ff0000]" or "[color=#00ff00]"
                local needStr = GReadText.KEY_NPC_TRADE_TIPS3..colorStr..totalNum.."[/color]"
                return descStr, needStr
            end,
        })
    else
        --叠加数量为1显示二次弹窗
        local nameStr = (tradeMeta and tradeMeta.getItemName) and tradeMeta:getItemName() or meta:getName()
        local price = NpcModule:getShopBuyPrice(Constant.ItemType.ITEM_TYPE_PROP, not isMeta and self._itemInfo or nil, isMeta and self._itemInfo or nil)
        local enoughMoney = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN, price)
        local colorStr = (not enoughMoney) and "[color=#ff0000]" or "[color=#00ff00]"
        local descStr = string.format(GReadText.KEY_NPC_TRADE_TIPS11, colorStr..price.."[/color]", nameStr)
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {type = 2, content = descStr, confirmCallback = function()
            local enoughMoney = ItemModule:enoughItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN, price, {tips = true})
            if not enoughMoney then
                NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_TRADE_CHOOSE)
                return
            end
            NpcModule:sendExchangeItem(tradeMeta:getItemId(), tradeItem.types, tradeMeta:getSite(), 1)
        end, cancelCallback = function()
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_TRADE_CHOOSE)
        end})
    end
end

function CompItemTips:sellFunc()
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SELL,
    {
        closeCallback = function()
            --取消选中
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_TRADE_CHOOSE)
        end,
        confirmCallback = function(sellNum)
            --卖东西先判断金币是否超过20亿
            local coinNum = ItemModule:getValueItem(Constant.ItemType.ITEM_TYPE_PROP, Constant.TYPE_VAULE_ITEM.COIN)
            local price = NpcModule:getShopSellPrice(Constant.ItemType.ITEM_TYPE_PROP, self._itemInfo, nil)
            local totalPrice = price * sellNum
            if coinNum + totalPrice >= Constant.COIN_LIMITE then
                local str = string.format(GReadText.KEY_NPC_TRADE_TIPS5, Constant.COIN_LIMITE)
                lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_FLOAT_TIP,{content = str})
                return
            end
            --取消选中
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_TRADE_CHOOSE)
            local wndLockType = WndLockManager:getWndLockType()
            if not wndLockType or (wndLockType ~= Constant.WndLockType.Trade) then
                NpcModule:setNpcId(nil)
            end 
            --服务器交互
            NpcModule:sendSellItem(0, self._itemInfo:getObjId(), sellNum, self._itemInfo)
        end,
        calculateMaxNum = function()
            --堆叠数量上限
            local addLimite = NpcModule:getMaxShopBuyNum(Constant.ItemType.ITEM_TYPE_PROP, self._itemInfo)
            local itemObj = ItemModule:getItemByObjId(self._itemInfo:getObjId())
            local haveNum = itemObj and itemObj:getNum() or 0
            local maxNum = addLimite > haveNum and haveNum or addLimite
            if maxNum <= 0 then maxNum = 1 end
            return maxNum
        end,
        refreshInfo = function(sellNum)
            local descStr = string.format(GReadText.KEY_NPC_TRADE_TIPS2, "[color=#00ff00]"..self._itemInfo:getName().."[/color]")
            --出售价格为购买价格的1/4
            local price = NpcModule:getShopSellPrice(Constant.ItemType.ITEM_TYPE_PROP, self._itemInfo, nil)
            local totalNum = price * sellNum
            local needStr = GReadText.KEY_NPC_TRADE_TIPS4..totalNum
            return descStr, needStr
        end,
    })
end

function CompItemTips:discardItem(itemInfo)
    --判断有没有月卡
    if itemInfo:getBound() == Constant.BOUND_TYPE.MONTH_BOUND then
        local isMonthCard = RechargeModule:checkMonthCard(true)
        if not isMonthCard then
            return
        end
    end
    --丢弃逻辑
    local num = self._itemInfo:getNum()
    local maxNum = self._itemInfo:getMaxNum()
    if num > 1 and maxNum > 1 then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SELL,
        { 
            confirmCallback = function(buyNum)
                self:sendPeckItem(self._itemInfo, buyNum)
            end,
            calculateMaxNum = function()
                return num
            end,
            refreshInfo = function(buyNum)
                --详情
                local descStr = GReadText.KEY_NPC_TRADE_TIPS13
                --消耗
                local needStr = GReadText.KEY_NPC_TRADE_TIPS14..buyNum.."/"..num
                return descStr, needStr
            end,
        })
    else
        self:sendPeckItem(self._itemInfo)
    end
end

--丢弃物品
function CompItemTips:sendPeckItem(itemInfo, num)
    num = num or 1
    local editTable = AutoFightManager:getEditConfByIndex(Constant.SETTINGS_TYPES.DISCARD_SURE)
    if editTable.switch == 1 then
        local content = GReadText.KEY_TASK_TIPS6
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_MESSAGEBOX_SMALL, {type = 2, content = content,
        confirmCallback = function()
            ItemModule:sendPeckItem(itemInfo:getObjId(), num)
        end,
        cancelCallback = function()
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_CANCEL_SELECT_STATE_ITEM)
        end})
    else
        ItemModule:sendPeckItem(itemInfo:getObjId(), num)
    end
end

-----------------------------------物品获取---------------------------------------------------------------------------
function CompItemTips:itemAccessShow(item)
    local itemConfig = item:getItemMeta() or item
    local access = itemConfig:getAccess()
    if access == nil or self._tipsTypeFrom == Constant.PROPTIPS_FORM.DisplayShop then
        self._panelAccess:setVisible(false)
        return
    end
    local open,tips = FunctionToggleModule:checkOpen(FunctionToggleModule.FunctionHelpId.Mall) 
    if not open then
        self._panelAccess:setVisible(false)
        return
    end
    self._panelAccess:setVisible(true)
    local kind = itemConfig:getKind()
    local itemType = itemConfig:getType()
    
    for i,v in ipairs(access or {}) do
        local btnNode = self._accessList:addItemFromPool()
        local type = tonumber(v[1])
        local info = ACCESS_GROUP[type]
        btnNode:getChild("title"):setText(info and info.name or "")
        local lblDesc = btnNode:getChild("lbl_desc")
        local icon = btnNode:getChild("icon")
        if type == PROPTIPS_ACCESS.TEXT then
            lblDesc:setText(v[2] or "")
            lblDesc:setColor(CommonUtil:convertColorWithX("#C0BDF8"))
            icon:setVisible(false)
            btnNode:setTouchable(false)
        elseif type == PROPTIPS_ACCESS.NPC then
            lblDesc:setText(v[2] or "")
            lblDesc:setColor(CommonUtil:convertColorWithX("#060606"))
            btnNode:setTouchable(true)
            icon:setVisible(true)
        elseif type == PROPTIPS_ACCESS.DUNGEON then
            lblDesc:setText(GReadText.KEY_ACCESS_TIPS6)
            lblDesc:setColor(CommonUtil:convertColorWithX("#060606"))
            btnNode:setTouchable(true)
            icon:setVisible(true)
        elseif type == PROPTIPS_ACCESS.SHOP then
            lblDesc:setText(GReadText.KEY_ACCESS_TIPS6)
            lblDesc:setColor(CommonUtil:convertColorWithX("#060606"))
            btnNode:setTouchable(true)
            icon:setVisible(true)
        end
        btnNode.btnType = type
        btnNode.accessMeta = v
    end

    local originalSize = self._accessList:getSize()
    local height = BTN_ACCESS_HEIHT * #access
    local listHeight = height + 10
    self._accessList:setSize(originalSize.width, listHeight)
    local bgHeight = listHeight + 42
    self._bgAccess:setHeight(bgHeight + 10)
end

function CompItemTips:onClickItemAccess(context)
    local heroData = lt.GameModule:getHeroData()
    if not heroData then
        return
    end
    local isAlive = heroData:isAlive()
    if not isAlive then
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_TIP,{content = GReadText.KEY_REVIVE_TIPS7})
        return
    end
    local btn = context:getData()
    local type = btn.btnType
    local accessMeta = btn.accessMeta
    yflog:Info("----------------------type-"..type)
    if type == PROPTIPS_ACCESS.SHOP then
        -- 跳转商城
        self:hideSelf()
        local itemId = tonumber(accessMeta[2])
        RechargeModule:openRechargeByItemId(itemId)
        
    elseif type == PROPTIPS_ACCESS.NPC then
        self:hideSelf()
    elseif type == PROPTIPS_ACCESS.DUNGEON then
        self:hideSelf()
    else
        -- Do Nothing
    end
end

-- 开始闪烁动画
function CompItemTips:startBlinkAnimation()
    local function createTween(target, start, ends, duration)
        local tween = fgui.GTween:to(start, ends, duration):setTarget(target, fgui.TweenPropType.Alpha)
        table.insert(self._blinkTweenArray, tween)
        return tween
    end

    local function blink()
        -- 清除旧tween
        if self._blinkTweenArray then
            for _, t in ipairs(self._blinkTweenArray) do
                t:kill()
            end
        end
        self._blinkTweenArray = {}

        -- 第一阶段
        createTween(self._nameT, 255, 125, 0.75)
        createTween(self._nameEnT, 255, 125, 0.75)
        createTween(self._brandT, 255, 125, 0.75)
        
        -- 只在最后一个tween上挂回调
        self._blinkTweenArray[#self._blinkTweenArray]:onComplete(function()
            -- 第二阶段
            createTween(self._nameT, 125, 255, 0.75)
            createTween(self._nameEnT, 125, 255, 0.75)
            createTween(self._brandT, 125, 255, 0.75)
            
            self._blinkTweenArray[#self._blinkTweenArray]:onComplete(blink) -- 循环
        end)
    end
    
    blink()
end

-- 停止动画
function CompItemTips:stopBlinkAnimation()
    if self._blinkTweenArray then
        for _, t in ipairs(self._blinkTweenArray) do
            t:kill()
        end
    end
    self._blinkTweenArray = nil
end

function CompItemTips:checkGuide()
    local childs = self._btnTabList:getChildren()
    for i = 1, #childs do
        if childs[i].btnType == BtnType.Use then
            --了解宠物引导
            if GuideModule:checkCanGuide(Constant.GUIDE_ID.PETFIGHT5) then
                local pos = self._btnTabList:displayObject():convertToWorldSpace(childs[(#childs+1)-i]:getPosition())
                GuideModule:triggerGuide(Constant.GUIDE_ID.PETFIGHT5, childs[i], cc.p(pos.x, display.height - pos.y - childs[i]:getSize().height), function()
                    self:btnUseByType(childs[i].btnType)
                end)
            end
        end
    end
end

return CompItemTips