-- 
local BufferBaseItem = class("BufferBaseItem")

BufferBaseItem._bufferId    = nil
BufferBaseItem._agent       = nil
BufferBaseItem._itemId      = nil
BufferBaseItem._source      = nil

function BufferBaseItem:ctor(bufferId, agent, itemId, source)
    self._bufferId   = bufferId
    self._agent      = agent
    self._itemId     = itemId
    self._source     = source
end

function BufferBaseItem:onUpdate()
end

function BufferBaseItem:onClear()
    self._bufferId   = nil
    self._agent      = nil
    self._itemId     = nil
    self._source     = nil
end

-- Setter && Getter
function BufferBaseItem:getBufferId()
    return self._bufferId
end

function BufferBaseItem:getItemId()
    return self._itemId
end

function BufferBaseItem:getSource()
    return self._source
end

function BufferBaseItem:getBufferData()
    return {
        bufferId = self._bufferId,
        time = self._time,
        actor = self._actor,
        skilllevel = self._skilllevel,
        source = self._source
    }
end

function BufferBaseItem:setIsTemp(value)
    self._isTemp = value
end

function BufferBaseItem:getIsTemp()
    return self._isTemp
end

return BufferBaseItem
