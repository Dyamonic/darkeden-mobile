local ShadowActor = class("ShadowActor", lt.RoleActor)

local ActionManager = lt.ActionManager
--[[
    用于模型中影子部分
    因影子层级永远在人物模型之下层
]]

--[[
    1:hero
    2:monster
]]
ShadowActor._actorType = nil
ShadowActor._roleData = nil

ShadowActor._isHeroSlayer = nil  -- hero 人族标记

function ShadowActor:ctor(actorType, roleData)
    self._actorType = actorType
    self._roleData = roleData

    local offsetX, offsetY = -25, 15
    local zorder = 0
    -- 人物模型
    self._heroNode = display.newNode()
    self._heroNode:setPosition(offsetX, offsetY)
    self:addChild(self._heroNode, zorder)

    self._spriteShadow = self:CreateSprite(self.ANCHOR_MIDDLE, self.ANCHOR_MIDDLE, 0, self._heroNode)

    -- 人族需要加载裤子
    if roleData and roleData:isSlayer() then
        self._isHeroSlayer = true

        self._helmetShadowName, self._modelShadowName, self._pantsShadowName = roleData:getModelShadowName()

        -- 头盔
        self._spriteHelmetShadow = self:CreateSprite(self.ANCHOR_MIDDLE, self.ANCHOR_MIDDLE, 0, self._heroNode)

        -- 裤子
        self._spritePantsShadow = self:CreateSprite(self.ANCHOR_MIDDLE, self.ANCHOR_MIDDLE, 0, self._heroNode)
    end

    zorder = zorder + 1
    self._spriteWeaponShadow = self:CreateSprite(self.ANCHOR_MIDDLE, self.ANCHOR_MIDDLE, zorder, self._heroNode)
    self._spriteShieldShadow = self:CreateSprite(self.ANCHOR_MIDDLE, self.ANCHOR_MIDDLE, zorder, self._heroNode)
    self._spriteMountShadow = self:CreateSprite(self.ANCHOR_MIDDLE, self.ANCHOR_MIDDLE, zorder, self._heroNode)
end

function ShadowActor:onClear()

    self:removeAllChildren()

    self._spritePantsShadow = nil
    self._spriteHelmetShadow = nil
    self._spriteShadow = nil
    self._heroNode = nil
    self._spriteMountShadow = nil
end

-- 怪物模型
function ShadowActor:LoadMonsterActionInfo(modelId, actionId, dirction)
    self._actionShadowInfo = ActionManager:getActionMonsterInfo("monster_s", modelId, actionId, dirction, true)
end

-- 英雄模型
function ShadowActor:LoadHeroActionInfo(modelName, actionId, dirction)
    
    self._actionShadowInfo = ActionManager:getAcitonHeroInfo(modelName, actionId, dirction, true)
    if self._isHeroSlayer then
        self._actionHelmetShadowInfo = ActionManager:getAcitonHeroInfo(self._helmetShadowName, actionId, dirction, true)
        self._actionPantsShadowInfo = ActionManager:getAcitonHeroInfo(self._pantsShadowName, actionId, dirction, true)
    end
end

-- 英雄武器
function ShadowActor:LoadHeroWeaponActionInfo(modelName, actionId, dirction)
    self._actionWeaponShadowInfo = ActionManager:getActionWeaponInfo(modelName, actionId, dirction, true)
end

-- 坐骑
function ShadowActor:LoadHeroMountActionInfo(modelName, actionId, dirction)
    self._actionMountShadowInfo = ActionManager:getActionMountInfo(modelName, actionId, dirction, true)
end

function ShadowActor:LoadHeroMountActionInfoAdvance(modelName, actionId, dirction)
    self._actionShadowInfo = ActionManager:getActionMountInfo(modelName, actionId, dirction, true)
end

-- 英雄盾牌
function ShadowActor:LoadHeroShieldActionInfo(modelName, actionId, dirction)
    self._actionShieldShadowInfo = ActionManager:getActionShieldInfo(modelName, actionId, dirction, true)
end

function ShadowActor:onUpdateFrame(nextFrameIndex)
    self:onUpdateModel(nextFrameIndex)

    if not self._isHeroSlayer then
        return
    end
    self:onUpdateHelmet(nextFrameIndex)
    self:onUpdatePants(nextFrameIndex)
end

-- 模型
function ShadowActor:onUpdateModel(nextFrameIndex)
    self:updateFrame(self._spriteShadow, self._actionShadowInfo, nextFrameIndex)
end

-- 头部
function ShadowActor:onUpdateHelmet(nextFrameIndex)
    self:updateFrame(self._spriteHelmetShadow, self._actionHelmetShadowInfo, nextFrameIndex)
end

-- 裤子
function ShadowActor:onUpdatePants(nextFrameIndex)
    self:updateFrame(self._spritePantsShadow, self._actionPantsShadowInfo, nextFrameIndex)
end

-- 武器
function ShadowActor:onUpdateWeaponFrame(nextFrameIndex)
    self:updateFrame(self._spriteWeaponShadow, self._actionWeaponShadowInfo, nextFrameIndex)
end

-- 坐骑
function ShadowActor:onUpdateMountFrame(nextFrameIndex)
    self:updateFrame(self._spriteMountShadow, self._actionMountShadowInfo, nextFrameIndex)
end


-- 盾牌
function ShadowActor:onUpdateShieldFrame(nextFrameIndex)
    self:updateFrame(self._spriteShieldShadow, self._actionShieldShadowInfo, nextFrameIndex)
end

function ShadowActor:updateFrame(spriteShadow, actionShadowInfo, nextFrameIndex)
    if not actionShadowInfo then
        return
    end

    spriteShadow:setVisible(true)
    local frameShadow = actionShadowInfo:getSpriteFrame(nextFrameIndex)
    if frameShadow then
        -- yflog:Info("self._spriteHero:updateFrame=%s",frameShadow.path)
        local sprite = frameShadow.sprite
        spriteShadow:setSpriteFrame(sprite)

        local shadowPos = self:conversionOffsetPoint(cc.p(0, 0), cc.p(frameShadow.x, frameShadow.y), frameShadow.size)
        spriteShadow:setPosition(shadowPos)
    end
end

function ShadowActor:hideSprite()
    self._spriteShadow:setVisible(false)
    self._spriteWeaponShadow:setVisible(false)
    self._spriteShieldShadow:setVisible(false)
    self._spriteMountShadow:setVisible(false)

    if not self._isHeroSlayer then
        return
    end
    
    self._spriteHelmetShadow:setVisible(false)
    self._spritePantsShadow:setVisible(false)
end

-- 隐藏武器
function ShadowActor:hideWeaponSprite()
    self._spriteWeaponShadow:setVisible(false)
end

-- 隐藏盾牌
function ShadowActor:hideShieldSprite()
    self._spriteShieldShadow:setVisible(false)
end

-- 隐藏坐骑
function ShadowActor:hideMountSprite()
    self._spriteMountShadow:setVisible(false)
end

function ShadowActor:hideHeroSlayerSprite()
    self._spriteHelmetShadow:setVisible(false)
    self._spritePantsShadow:setVisible(false)
end

return ShadowActor