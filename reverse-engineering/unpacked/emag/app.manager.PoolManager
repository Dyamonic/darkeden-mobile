
local PoolManager = {}

PoolManager._spriteArray = {}

function PoolManager:init()
    for i = 1, 1500 do
        local sprite = display.newSprite()
        sprite:retain()
        self:pushSprite(sprite)
    end
end

function PoolManager:clear()
    for _, sprite in ipairs(self._spriteArray) do
        sprite:release()
    end
    self._spriteArray = {}
end

function PoolManager:pushSprite(sprite)
    -- 清理纹理的引用
    sprite:initWithFile("ui/common/rect_dumb.png")

    self._spriteArray[#self._spriteArray + 1] = sprite
end

function PoolManager:popSprite()
    if #self._spriteArray > 0 then
        local sprite = self._spriteArray[#self._spriteArray]
        self._spriteArray[#self._spriteArray] = nil
        return sprite
    else
        -- lt.LogUtil:debug("新建Sprite")
        local sprite = display.newSprite()
        sprite:retain()
        return sprite
    end
end

return PoolManager
