
local ItemAgent = class("ItemAgent", lt.BaseAgent)

ItemAgent._itemData  = nil
ItemAgent._itemActor = nil

-- MN，与服务器严格对应
ItemAgent._mCur = nil
ItemAgent._nCur = nil

ItemAgent._pickFlag = nil

function ItemAgent:ctor(itemData, m, n, direction)
    ItemAgent.super.ctor(self, lt.Constant.AGENT_TYPE_ITEM)

    self._itemData = itemData
    self._mCur     = m
    self._nCur     = n
    self._objId    = itemData:getObjId()

    local itemX, itemY = lt.MapUtil:calcMNMid(self._mCur, self._nCur)

    self._itemActor = lt.ItemActor.new(self._itemData)
    self:setPosition(itemX, itemY)

    self._pickFlag = false
end

function ItemAgent:onClear()
    lt.GameModule:removeDropAndBodyGridMap(self)
    lt.AgentManager:removeAgent(self)
    self._itemActor:onClear()
    if self._upAnim then
        self._upAnim:removeSelf()
        self._upAnim = nil
    end
    if self._downAnim then
        self._downAnim:removeSelf()
        self._downAnim = nil
    end
end

function ItemAgent:onUpdate()
    self._itemActor:onUpdate()
end

function ItemAgent:onMessage(msg)
end

function ItemAgent:setMNExactly(m, n)
    self._mCur = m
    self._nCur = n
end

function ItemAgent:getMNExactly()
    return self._mCur, self._nCur
end

function ItemAgent:getMN()
    return self:getMNExactly()
end

function ItemAgent:setPosition(x, y)
    self._itemActor:setPositionEx(x, y)
end

-- Setter && Getter
function ItemAgent:getObjId()
    return self._objId
end

function ItemAgent:getItemActor()
    return self._itemActor
end

function ItemAgent:getActor()
    return self:getItemActor()
end

function ItemAgent:getItemData()
    return self._itemData
end

function ItemAgent:setPickFlag(pickFlag)
    self._pickFlag = pickFlag
end

function ItemAgent:getPickFlag()
    return self._pickFlag
end

function ItemAgent:showBorder(isShowBorder)
    if self._itemActor then
        self._itemActor:loadShader(isShowBorder)
    end
end


return ItemAgent
