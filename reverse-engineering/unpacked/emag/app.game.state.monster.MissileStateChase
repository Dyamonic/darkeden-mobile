
local MissileStateChase = class("MissileStateChase", lt.MonsterStateBase)

local Constant = lt.Constant

MissileStateChase._moveType = nil
MissileStateChase._mTarget = nil
MissileStateChase._nTarget = nil
MissileStateChase._xTarget = nil
MissileStateChase._yTarget = nil

function MissileStateChase:ctor(monsterAgent, moveType, targetAgentId, extraCode,skillId)
    
    MissileStateChase.super.ctor(self, monsterAgent)

    self._moveType = moveType
    self._targetAgentId = targetAgentId
    self._extraCode = extraCode
    self._skillId = skillId
    self._monsterActor = self._monsterAgent:getActor()

    self._timeTriggerAttack = lt.TimeTrigger.new((self._extraCode or 0)/1000)
    self.monsterDir = self._monsterAgent:getDirection()
    self:gotoNextMN()
end

function MissileStateChase:gotoNextMN()
    local targetAgent = lt.AgentManager:getAgent(self._targetAgentId)
    if not targetAgent then
       return 
    end
    local mTarget, nTarget = targetAgent:getMNExactly()
    local mMonster, nMonster = self._monsterAgent:getMNExactly()
    local direction = lt.MapUtil:getDirectionToPosition(mMonster, nMonster, mTarget, nTarget)
    self._monsterAgent:setDirection(direction)
    self.monsterDir = self._monsterAgent:getDirection()
    local nextPos = lt.MapUtil:getNextTileByDirection(mMonster, nMonster, direction)
    self._mTarget = nextPos.x
    self._nTarget = nextPos.y
    -- self._monsterAgent:setMNExactly(self._mTarget,self._nTarget)
    self._xTarget, self._yTarget = lt.MapUtil:calcMNMid(self._mTarget, self._nTarget)
    self._monsterAgent:playAction(Constant.ROLE_ACTION_MOVE)

    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
    mapAgent:changeAgentMN(self._monsterAgent, self._mTarget, self._nTarget)
end

function MissileStateChase:gotoNextMN2()
    local mMonster, nMonster = self._monsterAgent:getMNExactly()
    self.monsterDir = self.monsterDir + 1
    local nextPos = lt.MapUtil:getNextTileByDirection(mMonster, nMonster, self.monsterDir % 8)
    self._mTarget = nextPos.x
    self._nTarget = nextPos.y
    -- self._monsterAgent:setMNExactly(self._mTarget,self._nTarget)
    self._xTarget, self._yTarget = lt.MapUtil:calcMNMid(self._mTarget, self._nTarget)
    self._monsterAgent:playAction(Constant.ROLE_ACTION_MOVE)
    local direction = lt.MapUtil:getDirectionToPosition(mMonster, nMonster, self._mTarget, self._nTarget)
    self._monsterAgent:setDirection(direction)
    
    local mapAgent = lt.AgentManager:getWorldAgent():getMapAgent()
    mapAgent:changeAgentMN(self._monsterAgent, self._mTarget, self._nTarget)
end

function MissileStateChase:onClear()
end

function MissileStateChase:onEnter()
end

function MissileStateChase:onExit()
end

function MissileStateChase:onUpdate()
    if (self._timeTriggerAttack and self._timeTriggerAttack:tick(lt.GameBoard:getDeltaTime())) then
        self._timeTriggerAttack = nil
        local worldAgent = lt.AgentManager:getWorldAgent()
        if worldAgent then
            worldAgent:deleteAgent(self._monsterAgent:getObjId())
            if self._skillId == lt.SkillEnum.SKILL_PLASMA_ROCKET_LAUNCHER then
                local targetAgent = lt.AgentManager:getAgent(self._targetAgentId)
                if not targetAgent then
                    return
                end
                local param = {
                    skillID = self._skillId,
                    objID = targetAgent:getObjId(),
                    skillLevel = 0,
                    attackerID = self._monsterAgent:getObjId(),
                }
                lt.SkillManager:skillDamageEffect(param)
            end
        end
        return
    end
    
    if not self._timeTriggerAttack then
        return
    end

    if not self._targetAgentId then
       return 
    end

    if not self._xTarget or not self._yTarget then
        return
    end
    
    local xMonster, yMonster = self._monsterAgent:getPosition()
    local directionV = cc.pSub(cc.p(self._xTarget, self._yTarget), cc.p(xMonster, yMonster))
    local length = cc.pGetLength(directionV)

    local step = 150 * lt.GameBoard:getDeltaTime()
    if length < step or length > 300 then
        -- 到达
        self._monsterAgent:setPosition(self._xTarget, self._yTarget)
        local targetAgent = lt.AgentManager:getAgent(self._targetAgentId)
        if not targetAgent then
           return 
        end
        local mTarget, nTarget = targetAgent:getMNExactly()
        if mTarget == self._mTarget and nTarget == self._nTarget then
            self:gotoNextMN2()
            -- self._timeTriggerAttack = nil
            -- local worldAgent = lt.AgentManager:getWorldAgent()
            -- if worldAgent then
            --     worldAgent:deleteAgent(self._monsterAgent:getObjId())
            -- end
            return
        else
            self:gotoNextMN()
        end
    else
        -- 未到到
        directionV = cc.pMul(cc.pNormalize(directionV), step)
        self._monsterAgent:setPosition(xMonster + directionV.x, yMonster + directionV.y)
    end
end

function MissileStateChase:onMessage(msg)
end

function MissileStateChase:getStateId()
    return Constant.MONSTER_STATE_MISSILE
end

function MissileStateChase:getStateName()
    return "MissileStateChase"
end

return MissileStateChase
