
local TaskData = class("TaskData")

local Constant = lt.Constant

TaskData._taskId      = nil
TaskData._taskType    = nil
TaskData._title       = nil
TaskData._track       = nil
TaskData._rate        = nil
TaskData._des         = nil
TaskData._awardDes    = nil

TaskData._mapId      = nil
TaskData._pos        = nil
TaskData._npcName    = nil
TaskData._command    = nil

TaskData._searchArray = nil

function TaskData:ctor(perTaskData)
    assert(perTaskData ~= nil, "perTaskData is nil !")

    self:initTaskData(perTaskData)
    self:initTaskInfo()
end
-- ##ti支线测试标题
-- ##trgotoxxx1
-- ##pr2
-- ##de这是二个测，然后才能完成这个任务，感谢的参与
-- ##rd<item 1,10000,10><item 1,50002,12><item 1,50001,9>


function TaskData:initTaskData(perTaskData)
    self._taskId = perTaskData.taskID
    self._taskType = perTaskData.taskType
    self._taskInfo = perTaskData.taskInfo
end

function TaskData:initTaskInfo()
    local output = self:parseString(self._taskInfo)
    for _,v in ipairs(output) do
        if v.markStr == "ti" then
            self:setTitle(v.message)
        elseif v.markStr == "tr" then
            self:setTrack(v.message)
            self:initTraceData()
        elseif v.markStr == "pr" then
            -- self:setRate(v.message)
            self:initRateData(v.message)
        elseif v.markStr == "de" then
            self:setDes(v.message)
        elseif v.markStr == "rd" then
            self:setAwardDes(v.message)
        elseif v.markStr == "fy" then
            self:setFly(v.message)
        end
    end
end

function TaskData:refreshTaskInfo(taskInfo)
    local output = self:parseString(taskInfo)
    for _,v in ipairs(output) do
        if v.markStr == "ti" then
            self:setTitle(v.message)
        elseif v.markStr == "tr" then
            self:setTrack(v.message)
            self:initTraceData()
        elseif v.markStr == "pr" then
            -- self:setRate(v.message)
            self:initRateData(v.message)
        elseif v.markStr == "de" then
            self:setDes(v.message)
        elseif v.markStr == "rd" then
            self:setAwardDes(v.message)
        elseif v.markStr == "fy" then
            self:setFly(v.message)
        end
    end
end

function TaskData:initTraceData()
    local output = self:parseTrackString(self._track)
    if output then
        self._mapId = output.mapId
        self._pos = cc.p(output.x, output.y)
        self._npcName = output.npcName
        self._command = output.command
    else
        -- local str = "任务解析出错 track = "..tostring(self._track).." taskId = "..tostring(self._taskId)
        -- lt.NtfManager:dispatchNtf(lt.NtfManager.NTF.NTF_ALERT_TIP, {content = str,
        --                                                             btns = {Constant.COMMON_TIP_BTN.BTN_CONFIM}})
    end
end

function TaskData:initRateData(message)
    self._searchArray = self:parseRateString(message or "")

    -- self._rate, 
end

function TaskData:setPropertyArray(propertyArray)
    self._propertyData:setPropertyArray(propertyArray)
end

function TaskData:getTaskId()
    return self._taskId
end

function TaskData:getTaskType()
    return self._taskType
end

function TaskData:isMainTask()
    return (self._taskType or 0) == 1
end

function TaskData:setTitle(title)
    self._title = title
end

function TaskData:getTitle()
    return self._title
end

function TaskData:setTrack(track)
    self._track = track
end

function TaskData:getTrack()
    return self._track
end

function TaskData:setRate(rate)
    self._rate = rate
end

function TaskData:getRate()
    return self._rate
end

function TaskData:getSearchArray()
    return self._searchArray
end

function TaskData:getRandomLocation()
    local num = #self._searchArray
    if num == 0 then
        return nil
    end
    local idx = math.random(1,num)
    return self._searchArray[idx]
end

function TaskData:setDes(des)
    self._des = des
end

function TaskData:getDes()
    return self._des
end

function TaskData:setAwardDes(awardDes)
    self._awardDes = awardDes
end

function TaskData:getAwardDes()
    return self._awardDes
end

function TaskData:setFly(fly)
    self._fly = fly
end

function TaskData:getFly()
    return (self._fly and self._fly == "1")
end

function TaskData:getCommand()
    return self._command
end

function TaskData:isFightTask()
    return self._command and self._command == "gofight"
end

function TaskData:getPos()
    return self._pos
end

function TaskData:getMapId()
    return self._mapId
end

function TaskData:isInMap(mapId)
    return self._mapId and tonumber(self._mapId) == tonumber(mapId)
end

function TaskData:getPosDis(pos)
    if not self._pos then return false end
    return lt.CommonUtil:getDistance(self._pos, pos)
end

function TaskData:getNpcName()
    return self._npcName
end

--[[
    ##ti 任务标题 -- 颜色XX 下划线  可点击（tr）是否显示
    ##tr 任务追踪
    ##pr 任务进度 
    ##de 任务描述
    ##pr 奖励描述
    ##fy 是否显示飞鞋
--]]
function TaskData:parseString(str)
    -- lt.LogUtil:debugTable("str = "..tostring(str))
    if not str or str == "" then
        lt.LogUtil:debugInfo("TaskData:parseString str is nil or empty")
        return
    end
    local returnMsg = string.split(str, "\n")
    local output = {}
    for k, v in ipairs(returnMsg) do
        local msg = string.split(v, "##")
        for i = 1, #msg do
            if msg[i] and msg[i] ~= "" then
                local message = nil
                -- 0-9|
                -- local pos1,pos2 = string.find(msg[i],"0x[(a-f)|(A-F)]*")
                markStr = string.sub(msg[i], 1, 2)
                message = string.sub(msg[i], 3)
                table.insert(output, {message = message, markStr = markStr})
            end
        end
    end
    return output
end

function TaskData:parseTrackString(str)
    -- str = "gonpc  1002 10 20 大夫"
    if not str or str == "" then
        lt.LogUtil:debugInfo("TaskData:parseTrackString str is nil or empty")
        return
    end
    -- local returnMsg = string.split(str, " ")
    local returnMsg = {}
    for w in string.gmatch(str, "%S+") do
        table.insert(returnMsg,w)
    end 
    local msg = {}
    msg.command = returnMsg[1]
    msg.mapId = returnMsg[2]
    msg.x = returnMsg[3]
    msg.y = returnMsg[4]
    msg.npcName = returnMsg[5]

    -- lt.LogUtil:debugTable(msg,"msg = ")
    return msg
end

function TaskData:parseRateString(str)
    -- str = "任务测试去某地方找到某个物件才行任务测试去某地<物件物品:202,203><物件物件物品:202,203><物件:202,203>"
    str = str .. "<>"
    local content = ""
    local config = {}
    string.gsub(str,"(.-)<(.-)>",function(normalText, richContent)
        if normalText and normalText ~= "" then
            normalText = string.gsub(normalText, "\\n", "\n")
            local normalTextTable = string.split(normalText, "\n")
            for k, v in pairs(normalTextTable) do
                if v and v ~= "" then
                    table.insert(config,{oType = "font",content = v, color = "title"})
                end
            end
        end

        if richContent ~= "" then
            local returnMsg = string.split(richContent, ":")
            local flyArr = string.split(returnMsg[2], ",")
            table.insert(config,{oType = "fontBtn",content = returnMsg[1], flyArr = flyArr, color = "yellow", unLine = true, button = true})
        end
    end)
    return config
end

function TaskData:dump()
    lt.LogUtil:debug(">>>>>>>>>>>>>>>>>>>> TaskData >>>>>>>>>>>>>>>>>>>>")
    lt.LogUtil:debug("self._taskId = "..self._taskId)
    lt.LogUtil:debug("self._taskType = "..self._taskType)
    lt.LogUtil:debug("<<<<<<<<<<<<<<<<<<<< TaskData <<<<<<<<<<<<<<<<<<<<")
end

return TaskData
