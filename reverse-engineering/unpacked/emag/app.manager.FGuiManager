        ["UICompLeaderBossItem"]= {url = "ui://HolyFight/BossCell", component = lt.UICompLeaderBossItem, common = false},   -- bosscell
        ["UICompLeaderEliteItem"]= {url = "ui://HolyFight/EliteCell", component = lt.UICompLeaderEliteItem, common = false},   -- 精英cell
        ["UICompLeaderDropItem"]= {url = "ui://HolyFight/DropCell", component = lt.UICompLeaderDropItem, common = false},   -- 掉落cell
        
        ["UICompRewardTips"]  = {url = "ui://RewardTips/RewardTips",  component = lt.UICompRewardTips,  common = false},-- 奖励提示获得奖励界面
        ["UICompWelfareGiftRewardCell"]    = { url = "ui//Welfare/WelfareCell", component = lt.UICompWelfareGiftRewardCell, common = false },         -- 福利礼包子项
        ["UICompWelfareTitle"]             = { url = "ui//Welfare/BtnIndex", component = lt.UICompWelfareTitle, common = false },                     -- 福利页签
    }

    self._fguiUIFactoryComponentPool = {}
end

function FGuiManager:clear()
    if self._fguiUIFactoryComponentPool then
        for url, fguiUIFactoryClasses in pairs(self._fguiUIFactoryComponentPool) do
            for className, _ in pairs(fguiUIFactoryClasses) do
                self:unregisterUIFactoryComponent(className, url)
            end
        end

        self._fguiUIFactoryComponentPool = nil
    end
end

function FGuiManager:getFGuiComponent(key)
    return self._fguiComponents[key]
end

function FGuiManager:registerComponent(className, component)
    local fguiCompTable = self:getFGuiComponent(component)
    if not fguiCompTable then
        yflog:Error("FGuiManager:registerComponent error className:%s component name:%s",className, component)
        return
    end

    self:registerUIFactoryComponent(className, fguiCompTable.url, fguiCompTable.component)
end

function FGuiManager:unregisterComponent(className, component)
    local fguiCompTable = self:getFGuiComponent(component)
    if not fguiCompTable then
        yflog:Error("FGuiManager:unregisterComponent error className:%s component name:%s",className, component)
        return
    end

    self:unregisterUIFactoryComponent(className, fguiCompTable[1])
end

function FGuiManager:unregisterAllComponent(className)
    if self._fguiUIFactoryComponentPool then
        for url, fguiUIFactoryClasses in pairs(self._fguiUIFactoryComponentPool) do
            if fguiUIFactoryClasses[className] then
                self:unregisterUIFactoryComponent(className, url)
            end
        end
    end
end

--[[__fmt
    className:父类classname
    objClassName: 子类classname
    obj fgui object类
]]
function FGuiManager:insertObjectToFactory(className,  objClassName, obj)
    local fguiCompTable = self:getFGuiComponent(objClassName)
    if not fguiCompTable then
        yflog:Error("FGuiManager:insertObjectToFactory error className:%s objClassName name:%s",className, objClassName)
        return
    end

    local url = fguiCompTable.url
    if not self._fguiUIFactoryComponentPool[url] then
        yflog:Error("FGuiManager:insertObjectToFactory no url error className:%s objClassName:%s url:%s",className, objClassName, url)
        return
    end

    if not self._fguiUIFactoryComponentPool[url][className] then
        -- 公共部分的组件需要重新注册
        if not fguiCompTable.common then
            yflog:Error("FGuiManager:insertObjectToFactory url no className error className:%s objClassName:%s url:%s",className, objClassName, url)
            return
        end

        self._fguiUIFactoryComponentPool[url][className] = {objs = {}}
    end

    local objs = self._fguiUIFactoryComponentPool[url][className].objs

    for _, value in ipairs(objs) do
        if obj == value then
            return
        end
    end
    -- yflog:Info("FGuiManager:insertObjectToFactory className:%s  url:%s #obj.__cname:%s", className, url, obj.__cname)
    table.insert(self._fguiUIFactoryComponentPool[url][className].objs, obj)
end

function FGuiManager:registerUIFactoryComponent(className, url, component)
    if self._fguiUIFactoryComponentPool[url] then
        if not self._fguiUIFactoryComponentPool[url][className] then
            self._fguiUIFactoryComponentPool[url][className] = {objs = {}}
        else
            -- 当前类已经注册过 重复注册
            yflog:Error("FGuiManager:registerUIFactoryComponent register repeat error className:%s url:%s",className, url)
        end
        return
    end

    self._fguiUIFactoryComponentPool[url] = {}
    self._fguiUIFactoryComponentPool[url][className] = {objs = {}}

    fgui.UIObjectFactory:registComponent(url, function()
        local obj = component.new()
        return obj
    end,function(obj)
        component.onConstruct(obj)
    end)
end

function FGuiManager:unregisterUIFactoryComponent(className, url)
    if not self._fguiUIFactoryComponentPool[url] then
        yflog:Info("FGuiManager:unregisterUIFactoryComponent Fail no url, className:%s url:%s",className, url)
        return
    end

    if not self._fguiUIFactoryComponentPool[url][className] then
        yflog:Info("FGuiManager:unregisterUIFactoryComponent Fail no className, className:%s url:%s",className, url)
        return
    end

    local objs = self._fguiUIFactoryComponentPool[url][className].objs
    for i = #objs, 1, -1 do
        -- objs[i]:release()
        -- yflog:Info("FGuiManager:unregisterUIFactoryComponent url, className:%s url:%s",className, url)
        table.remove(self._fguiUIFactoryComponentPool[url][className].objs, i)
        -- 验证是否 :release() 真实release 是否调用回调
    end

    self._fguiUIFactoryComponentPool[url][className] = nil
    -- yflog:Info("self._fguiUIFactoryComponentPool[url]:%s",table.nums(self._fguiUIFactoryComponentPool[url]))

    if table.nums(self._fguiUIFactoryComponentPool[url]) == 0 then
        self._fguiUIFactoryComponentPool[url] = nil

        -- yflog:Info("fgui.UIObjectFactory:unregistComponent  url:%s",url)
        fgui.UIObjectFactory:unregistComponent(url)
    end
end

return FGuiManager