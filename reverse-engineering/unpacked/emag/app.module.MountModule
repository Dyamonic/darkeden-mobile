-- 坐骑系统

local MountModule           = {}

local SocketApi             = lt.SocketApi
local ServerCmdDef          = lt.ServerCmdDef
local NtfManager            = lt.NtfManager
local GameModule            = lt.GameModule
local CacheManager          = lt.CacheManager
local CommonModule          = lt.CommonModule
local netcmd_pb             = lt.netcmd_pb
local ClientCmdDef          = lt.ClientCmdDef
local RedDotModule          = lt.RedDotModule
local Constant              = lt.Constant
local ItemModule            = lt.ItemModule

MountModule.MOUNT_SELECT    = "MOUNT_SELECT"
MountModule._mountList      = {}
MountModule._haloList       = {}

function MountModule:init()
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_QUERY_MOUNT_RESP),
        handler(self, self.onQueryMountResp), "MountModule:onQueryMountResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_USE_MOUNT_RESP),
        handler(self, self.onUseMountResp), "MountModule:onUseMountResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_UPGRADE_MOUNT_RESP),
        handler(self, self.onUpgradeMountResp), "MountModule:onUpgradeMountResp")

    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_QUERY_HALO_RESP),
        handler(self, self.onQueryHaloResp), "MountModule:onQueryHaloResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_USE_HALO_RESP),
        handler(self, self.onUseHaloResp), "MountModule:onUseHaloResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.S_UPGRADE_HALO_RESP),
        handler(self, self.onUpgradeHaloResp), "MountModule:onUpgradeHaloResp")

    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_ITEM_NUMB,
        handler(self, self.initMountRedTips), "MountModule:NTF_UPDATE_ITEM_NUMB")
    NtfManager:addNtfListener(NtfManager.NTF.NTF_UPDATE_MONEY_EVENT,
        handler(self, self.initMountRedTips), "MountModule:NTF_UPDATE_MONEY_EVENT")
end

function MountModule:clear()
    SocketApi:removeProtoListenerByTag("MountModule:onQueryMountResp")
    SocketApi:removeProtoListenerByTag("MountModule:onUseMountResp")
    SocketApi:removeProtoListenerByTag("MountModule:onUpgradeMountResp")
    SocketApi:removeProtoListenerByTag("MountModule:onQueryHaloResp")
    SocketApi:removeProtoListenerByTag("MountModule:onUseHaloResp")
    SocketApi:removeProtoListenerByTag("MountModule:onUpgradeHaloResp")
    NtfManager:removeNtfListenerByTag("MountModule:NTF_UPDATE_ITEM_NUMB")
    NtfManager:removeNtfListenerByTag("MountModule:NTF_UPDATE_MONEY_EVENT")
    self._mountList      = {}
    self._haloList       = {}
    self._mountDatas     = nil
    self._haloDatas      = nil
    self._mountInfos     = nil
    self._haloDInfos     = nil
    self._usingHalo      = nil
    self._usingMount     = nil
    self._haloTable      = nil
end

--------------------------------------------------求静态表---------------------------------------------------
--坐骑
function MountModule:getMountMapByRace(myRace, mountMap)
    local mapArray = {}
    for i = 1, #mountMap do
        local meta = mountMap[i]
        local race = meta:getRace()
        if race == 0 or myRace == race then
            local type = meta:getType()
            if not mapArray[type] then
                local tabs = {}
                tabs.type = type
                tabs.name = meta:getName()
                tabs.metas = {}
                mapArray[type] = tabs
            end
            table.insert(mapArray[type].metas, meta)
        end
    end
    return mapArray
end

function MountModule:getMountMapData()
    if self._mountDatas == nil then
        local mountMap = CacheManager:getMountMap()
        local heroData = GameModule:getHeroData()
        if not heroData then
            return
        end
        self._mountDatas = MountModule:getMountMapByRace(heroData:getRace(), mountMap)
    end
    return self._mountDatas
end

--光环
function MountModule:getHaloMapByRace(myRace, haloMap)
    local mapArray = {}
    for i = 1, #haloMap do
        local meta = haloMap[i]
        local race = meta:getRace()
        if race == 0 or myRace == race then
            local type = meta:getType()
            if not mapArray[type] then
                local tabs = {}
                tabs.type = type
                tabs.name = meta:getName()
                tabs.metas = {}
                mapArray[type] = tabs
            end
            table.insert(mapArray[type].metas, meta)
        end
    end
    return mapArray
end

function MountModule:getHaloMapData()
    if self._haloDatas == nil then
        local haloMap = CacheManager:getHaloMap()
        local heroData = GameModule:getHeroData()
        if not heroData then
            return
        end
        self._haloDatas = MountModule:getHaloMapByRace(heroData:getRace(), haloMap)
    end
    return self._haloDatas
end

function MountModule:getHaloMetasByKey(_type)
    local haloMap = CacheManager:getHaloMap()
    self._haloTable = self._haloTable or {}
    if self._haloTable[_type] == nil then
        for k, v in pairs(haloMap) do
            if v:getType() == _type then
                self._haloTable[_type] = v
                break
            end
        end
    end
    return self._haloTable[_type]
end

function MountModule:getLevelDatas(isMont)
    return isMont and self._mountDatas or self._haloDatas
end

-------------------------下行数据--------------------------------------------
function MountModule:analysisNtfMapByData(datas)
    datas = datas or {}
    local tables = {}
    for i = 1, #datas do
        local key = datas[i].type or 0
        local level = datas[i].level or 0
        if key ~= 0 then
            tables[key] = level
        end
    end
    return tables
end

function MountModule:onQueryMountResp(event)
    local proto      = event.param
    local mount_list = self:analysisNtfMapByData(proto.mount_list)
    self._mountList  = mount_list
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATA_MOUNTEORHALO_CHANGE,
        { type = Constant.FITER_MOUNT_TYPE.MOUNT })

    self:checkAllRed(Constant.FITER_MOUNT_TYPE.MOUNT)
end

function MountModule:onUseMountResp(event)
    local proto = event.param
    local ret   = proto.ret
    local type  = proto.type
    if ret == 0 then
        self._usingMount = type
    end
end

function MountModule:onUpgradeMountResp(event)
    local proto = event.param
    local ret   = proto.ret
    if ret == 0 then
        local type            = proto.type
        local level           = proto.level
        self._mountList[type] = level
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATA_MOUNTEORHALO_CHANGE,
            { type = Constant.FITER_MOUNT_TYPE.MOUNT })
        self:checkAllRed(Constant.FITER_MOUNT_TYPE.MOUNT)
    end
end

function MountModule:onQueryHaloResp(event)
    local proto     = event.param
    local halo_list = self:analysisNtfMapByData(proto.halo_list)
    self._haloList  = halo_list
    self._usingHalo = proto.using_halo
    NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATA_MOUNTEORHALO_CHANGE,
        { type = Constant.FITER_MOUNT_TYPE.HALO })

    self:checkAllRed(Constant.FITER_MOUNT_TYPE.HALO)
end

function MountModule:onUseHaloResp(event)
    local proto = event.param
    local ret   = proto.ret
    if ret == 0 then
        self._usingHalo = proto.type
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATA_MOUNTEORHALO_CHANGE,
            { type = Constant.FITER_MOUNT_TYPE.HALO })
    end
end

function MountModule:onUpgradeHaloResp(event)
    local proto = event.param
    local ret   = proto.ret
    if ret == 0 then
        local type           = proto.type
        local level          = proto.level
        self._haloList[type] = level
        NtfManager:dispatchNtf(NtfManager.NTF.NTF_UPDATA_MOUNTEORHALO_CHANGE,
            { type = Constant.FITER_MOUNT_TYPE.HALO })
        self:checkAllRed(Constant.FITER_MOUNT_TYPE.HALO)
    end
end

function MountModule:getHaloInfos(_fiterType, _type)
    if _fiterType == Constant.FITER_MOUNT_TYPE.MOUNT then
        if self._mountList then
            return self._mountList[_type] or -1
        end
    else
        if self._haloList then
            return self._haloList[_type] or -1
        end
    end
end

function MountModule:getUseType(isMont)
    if isMont then
        local keySelect = lt.PrefManager:getUserValueByKey(MountModule.MOUNT_SELECT) or 0
        return tonumber(keySelect)
    else
        return self._usingHalo
    end
end

--------------------------------------------------请求---------------------------------------------------
--查询坐骑信息
function MountModule:onQueryMountReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_QUERY_MOUNT_REQ))
end

--使用坐骑
function MountModule:onUseMountReq(type)
    local msg = netcmd_pb.CS_UseMountReq()
    msg.type = type
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_USE_MOUNT_REQ), msg)
end

-- 升级/激活坐骑
function MountModule:onUpgradeMountReq(type)
    local msg = netcmd_pb.CS_UpgradeMountReq()
    msg.type = type --坐骑类型(服务器不支持取消)
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_UPGRADE_MOUNT_REQ), msg)
end

--查询光环信息
function MountModule:onQueryHaloReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_QUERY_HALO_REQ))
end

--使用光环
function MountModule:onUseHaloReq(type)
    local use_type = type
    if self._usingHalo == type then
        use_type = 0
    end
    local msg = netcmd_pb.CS_UseHaloReq()
    msg.type = use_type -- 光环类型(0 取消)
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_USE_HALO_REQ), msg)
end

-- 升级/激活光环
function MountModule:onUpgradeHaloReq(type)
    local msg = netcmd_pb.CS_UpgradeHaloReq()
    msg.type = type
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.C_UPGRADE_HALO_REQ), msg)
end

------------------------------------------------------------------------------------------------------

--根据id获得属性：富文本
function MountModule:getPropInfo(propData)
    local propId       = propData[1]
    local propValue    = propData[2]
    local meta         = CacheManager:getOptionInfoMeta(propId)
    local attrName     = meta:getName()
    local isPer        = meta:getPercentage()
    local isPermyriad  = meta:getPermyriad()
    local attrNum      = propValue
    local str          = ""

    local COLOR_GREEN  = "[color=#00ff00]"
    local COLOR_END    = "[/color]"
    if isPermyriad == 1 then
        attrNum = attrNum / 100
    end
    local coloredValue = attrName .. COLOR_GREEN .. "+".. attrNum .. COLOR_END
    if isPer == 1 then
        str = coloredValue .. COLOR_GREEN .. "%" .. COLOR_END
    else
        str = coloredValue
    end
    return str
end

-- 是否是坐骑 或者buff
function MountModule:onMountDown()
    local heroAgent = lt.AgentManager:getWorldAgent():getHeroAgent()
    if not heroAgent then
        return
    end
    local mountId = 0
    if heroAgent:hasBuffer(lt.BuffEnum.EFFECT_CLASS_SLAYER_MOUNT) then
        mountId = heroAgent:getHeroData():getMountId()
    elseif heroAgent:hasBuffer(lt.BuffEnum.EFFECT_SUMMON_SYLPH) then
        mountId = heroAgent:getHeroData():getSummonSylphId()
    elseif heroAgent:hasBuffer(lt.BuffEnum.EFFECT_CLASS_TRANSFORM_TO_BAT) then
        mountId = heroAgent:getTransformId()
    end

    if mountId == 0 then
        return
    end

    local metadatas = MountModule:getMountMapData()
    if metadatas[mountId] then -- 坐骑
        self:onUseMountReq(0)
    else
        if heroAgent:hasBuffer(lt.BuffEnum.EFFECT_CLASS_TRANSFORM_TO_BAT) then
            lt.SkillModule:sendCancelTransform()
        else
            lt.GameModule:sendAttack(0, 0, 0, 0, 0)
        end
    end
end

-------------------------------------------------------------------------------------------------------
----------------------------红点----------------------------

-- 这么刷新？？？
function MountModule:initMountRedTips()
    for fiterType = 1, table.nums(Constant.FITER_MOUNT_TYPE) do
        self:checkAllRed(fiterType)
    end
end

-- 检测单个红点
function MountModule:checkRed(level, type, fiterType)
    local type = type
    local itemMetas = MountModule:getLevelDatas(fiterType == Constant.FITER_MOUNT_TYPE.MOUNT)[type]
    local curLevel = level + 1
    local nextLevel = curLevel + 1
    if nextLevel > #itemMetas.metas then
        return false
    end

    local itemList = itemMetas.metas[nextLevel]:getCost() or {}
    for i, v in ipairs(itemList or {}) do
        local itemData = v
        local itemType = tonumber(itemData[1])
        local enough = ItemModule:enoughItem(itemType, itemData[2], tonumber(itemData[3]))
        if not enough then
            return false
        end
    end
    return true
end

function MountModule:checkAllRed(fiterType)
    local open, tips = lt.FunctionToggleModule:checkOpen(lt.FunctionToggleModule.FunctionHelpId.Mount)
    if not open then
        return
    end
    local metadatas = {}
    if fiterType == Constant.FITER_MOUNT_TYPE.MOUNT then
        metadatas = MountModule:getMountMapData()
    else
        metadatas = MountModule:getHaloMapData()
    end
    local setTypes = false
    for _, v in pairs(metadatas) do
        local level = self:getHaloInfos(fiterType, _)
        local red = self:checkRed(level, _, fiterType)
        if red == true then
            setTypes = true
            break
        end
    end
    if fiterType == Constant.FITER_MOUNT_TYPE.MOUNT then
        RedDotModule:setTipsStateByName("MountRedTips", setTypes)
    else
        RedDotModule:setTipsStateByName("HaloRedTips", setTypes)
    end
end

function MountModule:getRedByType(_fiterType)
    if _fiterType == Constant.FITER_MOUNT_TYPE.MOUNT then
        return RedDotModule:getTipsStateByName("MountRedTips")
    else
        return RedDotModule:getTipsStateByName("HaloRedTips")
    end
end

function MountModule:getRedPointAll()
    for fiterType = 1, table.nums(Constant.FITER_MOUNT_TYPE) do
        local point = self:getRedByType(fiterType)
        if point then
            return true
        end
    end
    return false
end

-- 站立状态坐骑acitionId
function MountModule:getMountActionId(mountId)
    local action = Constant.ACTION_SLAYER_MOTOR_STAND
    if Constant.MOUNT_ADVANCED_ITEMS3[mountId] then
        action = Constant.ACTION_STAND
    elseif Constant.MOUNT_ADVANCED_ITEMS2[mountId] or Constant.MOUNT_ADVANCED_ITEMS1[mountId] then
        action = Constant.ACTION_MOUNT_ADVANCED_SLAYER_STAND
    elseif mountId == Constant.OUTSET_MOUNTID.FAIRY then
        action = Constant.ACTION_OUSTERS_FAIRY_MOVE_STAND
    elseif mountId == Constant.OUTSET_MOUNTID.PEGASUS then
        action = Constant.ACTION_OUSTERS_PEGASUS_MOVE_STAND
    end
    return action
end

return MountModule
