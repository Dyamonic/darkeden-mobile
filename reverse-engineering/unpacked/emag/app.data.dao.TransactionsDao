local TransactionsDao = {}

function TransactionsDao:queryById(Id)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Transactions WHERE Id=%d ;", Id)) do
        local meta = lt.TransactionsMeta.new(row)
        return meta
    end
    return nil
end

function TransactionsDao:queryDefault()
    local mapTable = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Transactions") do
        local meta = lt.TransactionsMeta.new(row)
        mapTable[#mapTable + 1] = meta
    end
    return mapTable
end

return TransactionsDao
