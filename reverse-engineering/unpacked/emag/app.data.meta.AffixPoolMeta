
local AffixPoolMeta = class("AffixPoolMeta")

local CommonFunc = lt.CommonFunc

function AffixPoolMeta:ctor(row)
    self._kind          = row.Kind
    self._type          = row.Type
    self._affixClass    = CommonFunc:analysisJsonToTable(row.AffixClass)

    if row.ComposeItem == "" then
        self._composeItem = nil
    else
        self._composeItem = CommonFunc:analysisJsonToTable(row.ComposeItem, true)
    end

    if row.EraseItem == "" then
        self._eraseItem = nil
    else
        self._eraseItem = CommonFunc:analysisJsonToTable(row.EraseItem, true)
    end
    
    if row.RecastingItem == "" then
        self._recastingItem = nil
    else
        self._recastingItem = CommonFunc:analysisJsonToTable(row.RecastingItem, true)
    end

    if row.RecastingCost == "" then
        self._recastingCost = nil
    else
        self._recastingCost = CommonFunc:analysisJsonToTable(row.RecastingCost, true)
    end

    if row.MotivateItem == "" then
        self._motivateItem = nil
    else
        self._motivateItem  = json.decode(row.MotivateItem)
    end

    if row.MotivateLockItem == "" then
        self._motivateLockItem = nil
    else
        self._motivateLockItem  = json.decode(row.MotivateLockItem)
    end

    if row.MotivateCost == "" then
        self._motivateCost = nil
    else
        self._motivateCost  = json.decode(row.MotivateCost)
    end
end

function AffixPoolMeta:getKind()
    return self._kind
end

function AffixPoolMeta:getType()
    return self._type
end

function AffixPoolMeta:getAffixClass()
	return self._affixClass
end

function AffixPoolMeta:getComposeItem()
    return self._composeItem
end

function AffixPoolMeta:getEraseItem()
    return self._eraseItem
end

function AffixPoolMeta:getRecastingItem()
    return self._recastingItem
end

function AffixPoolMeta:getRecastingCost()
    return self._recastingCost
end

function AffixPoolMeta:getMotivateItem()
    return self._motivateItem
end

function AffixPoolMeta:getMotivateLockItem()
    return self._motivateLockItem
end

function AffixPoolMeta:getMotivateCost()
    return self._motivateCost
end

return AffixPoolMeta
