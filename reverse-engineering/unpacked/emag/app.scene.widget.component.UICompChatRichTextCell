---@class UICompChatRichTextCell
--- 富文本（不带头像框）聊天cell
local UICompChatRichTextCell = class("UICompChatRichTextCell", lt.UIGButtonBase)
local Constant               = lt.Constant
local GameModule             = lt.GameModule
local ChatModule             = lt.ChatModule
local NtfManager             = lt.NtfManager

function UICompChatRichTextCell:ctor()
    UICompChatRichTextCell.super.ctor(self)
    self._item     = nil
    self._chatInfo = nil
end

function UICompChatRichTextCell:onClear()
    self._lblMsg   = nil
    self._item     = nil
    self._chatInfo = nil
    UICompChatRichTextCell.super.onClear(self)
end

function UICompChatRichTextCell:onEnter()
    UICompChatRichTextCell.super.onEnter(self)
    self._lblMsg:addEventListener(fgui.UIEventType.ClickLink, handler(self, self.ClickLinkChat))
end

function UICompChatRichTextCell:onExit()
    self._lblMsg:removeEventListener(fgui.UIEventType.ClickLink)
    UICompChatRichTextCell.super.onExit(self)
end

function UICompChatRichTextCell:onConstruct()
    self._lblMsg = self:getChild("lbl")
end

function UICompChatRichTextCell:setInfo(chatinfo, chattype)
    local richstr = ChatModule:initStr(chatinfo)
    self._lblMsg:setText(richstr)
    self._item = chatinfo.chatMsg
    self._chatInfo = chatinfo
    self._chatType = chattype
end

-- 去除最外面[]
function UICompChatRichTextCell:trim_fixed_brackets(str)
    if str:sub(1, 1) == "[" and str:sub(-1) == "]" then
        return str:sub(2, -2)
    else
        return str -- 如果不以 [] 包围，则返回原字符串
    end
end

function UICompChatRichTextCell:ClickLinkChat(context)
    local datavalue = context:getDataValue()
    local strDatavalue = self:trim_fixed_brackets(tostring(datavalue))
    local myName = GameModule:getHeroData():getName()

    if self._chatType == Constant.MESSAGE_TALK_TYPE.TALKTYPE_PRIVATE then -- 点击私聊
        if strDatavalue == self._chatInfo.sendMan or strDatavalue == self._chatInfo.recieveMan then
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_FLOAT_CHAT_PRIVATE, { playername = strDatavalue })
            return
        end
    end
    if strDatavalue == self._chatInfo.sendMan then -- 玩家tips
        if self._chatType == Constant.MESSAGE_TALK_TYPE.TALKTYPE_WORD then -- 喇叭 服务器没发属性 这边屏蔽
            return
        end
        local playerInfo = {}
        playerInfo.playerName = self._chatInfo.sendMan
        playerInfo.level = self._chatInfo.sendLevel
        playerInfo.race = self._chatInfo.sendRace
        playerInfo.sex = self._chatInfo.sendSex
        playerInfo.faceShape = self._chatInfo.sendFaceShape or 1
        playerInfo.advanceState = self._chatInfo.advanceState or 1
        playerInfo.advanceLv = self._chatInfo.advanceLv or 1
        playerInfo.gradeLevel = self._chatInfo.gradeLevel or 1
        playerInfo.tendencies = self._chatInfo.tendencies or 1
        playerInfo.guildName = self._chatInfo.guildName or 1

        NtfManager:dispatchNtf(NtfManager.NTF.NTF_PLAYER_TIPS, { playerInfo = playerInfo, isPrivateChat = true })
    else -- 装备tips
        if self._item ~= nil then
            local item = ChatModule:getItemInfo(self._item, 2)
            if not item then
                return
            end
            NtfManager:dispatchNtf(NtfManager.NTF.NTF_SHOW_EQUIP_TIPS,
                { itemInfo = item, tipsType = Constant.EquipShowTipsType.Display })
        end
    end
end

return UICompChatRichTextCell
