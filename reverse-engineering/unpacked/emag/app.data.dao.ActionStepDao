
local ActionStepDao = {}

function ActionStepDao:queryAll()
    local skillMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM ActionStep;") do
    	local stepMeta = lt.ActionStepMeta.new(row)
        local key = stepMeta:getRace() .. stepMeta:getActionId()
        skillMap[key] = stepMeta
    end
    return skillMap
end

return ActionStepDao
