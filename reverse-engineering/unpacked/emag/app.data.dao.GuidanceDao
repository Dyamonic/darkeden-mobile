local GuidanceDao = {}

function GuidanceDao:query(guideId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM Guidance WHERE GuideId=%d;", tonumber(guideId))) do
    	local meta = lt.GuidanceMeta.new(row)
        return meta
    end
end

function GuidanceDao:queryAll()
    local map = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM Guidance") do
        local meta = lt.GuidanceMeta.new(row)
        if not map[meta:getGuideId()] then
            map[meta:getGuideId()] = meta
        end
    end
    return map
end

return GuidanceDao