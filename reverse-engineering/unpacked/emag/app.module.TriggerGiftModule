-- 触发礼包
local TriggerGiftModule             = {}

local SocketApi                     = lt.SocketApi
local netcmd_pb                     = lt.netcmd_pb
local CommonModule                  = lt.CommonModule
local ServerCmdDef                  = lt.ServerCmdDef
local ClientCmdDef                  = lt.ClientCmdDef
local NtfManager                    = lt.NtfManager

TriggerGiftModule._triggerGiftTable = {}

function TriggerGiftModule:init()
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.CS_TRIGGER_GIFT_RESP),
        handler(self, self.onTriggerGiftResp), "TriggerGiftModule:onTriggerGiftResp")
    SocketApi:addProtoListener(CommonModule:GetNetCmdEnum(ServerCmdDef.CS_TRIGGER_GIFT_NTF),
        handler(self, self.onTriggerGiftNtf), "TriggerGiftModule:onTriggerGiftNtf")
end

function TriggerGiftModule:clear()
    SocketApi:removeProtoListenerByTag("TriggerGiftModule:onTriggerGiftResp")
    SocketApi:removeProtoListenerByTag("TriggerGiftModule:onTriggerGiftNtf")
    self._triggerGiftTable = {}
end

----------------------------回调----------------------------

function TriggerGiftModule:onTriggerGiftResp(event)
    local proto            = event.param
    local triggerGiftData  = proto.triggerGiftData
    local triggerGiftArray = triggerGiftData.triggerGiftArray
    -- yflog:Info("-----------------------------triggerGiftArray-%s", #triggerGiftArray)
    self._triggerGiftTable = {}
    for _, v in ipairs(triggerGiftArray or {}) do
        -- yflog:Info("----------------------id=%s-", v.id)
        self._triggerGiftTable[v.id] = v
    end

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_TRIGGERGIFT_LIST_CHANGE)
end

function TriggerGiftModule:onTriggerGiftNtf(event)
    local proto            = event.param
    local triggerGiftData  = proto.triggerGiftData
    local triggerGiftArray = triggerGiftData.triggerGiftArray
    if not self._triggerGiftTable then
        self._triggerGiftTable = {}
    end
    for _, v in ipairs(triggerGiftArray or {}) do
        self._triggerGiftTable[v.id] = v
    end

    -- for k, v in pairs(self._triggerGiftTable or {}) do
    --     yflog:Info("---------------------onTriggerGiftNtf-id=%s-", v.id)
    -- end

    NtfManager:dispatchNtf(NtfManager.NTF.NTF_TRIGGERGIFT_LIST_CHANGE)
end

----------------------------请求----------------------------

function TriggerGiftModule:onTriggerGiftReq()
    SocketApi:sendToGs(CommonModule:GetNetCmdEnum(ClientCmdDef.CS_TRIGGER_GIFT_REQ))
end

----------------------------方法----------------------------
function TriggerGiftModule:onGetTriggerGiftTable()
    return self._triggerGiftTable or {}
end

function TriggerGiftModule:onGetTriggerGiftTableLength()
    local table = self:onGetTriggerGiftTable()
    local count = 0
    for i, v in pairs(table or {}) do
        if v then
            count = count + 1
        end
    end
    return count
end

return TriggerGiftModule
