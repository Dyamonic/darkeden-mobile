local BuffHalo = class("BuffHalo", lt.BufferBase)
local BuffEnum = lt.BuffEnum
local SkillEnum = lt.SkillEnum
local ScheduleUtil  = lt.ScheduleUtil
local CacheManager = lt.CacheManager
local Constant = lt.Constant

--[[
    光晕
]]
function BuffHalo:ctor(time, actor, skilllevel, source, buffId)    
    BuffHalo.super.ctor(self, buffId, time, actor)
    -- 被攻击播特效即可
    self._skillId = SkillEnum.SKILL_HALO

    self._agent = actor:getAgent()
    self._skillM, self._skillN = source.x, source.y
    self._fromObjId = source.srcId
    -- print("BuffHalo===MN", self._skillM, self._skillN, self._fromObjId )
    self:checkRange()
end

function BuffHalo:onClear()
    self:deleteClientTrap()
    BuffHalo.super.onClear(self)
end

function BuffHalo:deleteClientTrap()
    local worldAgent = lt.AgentManager:getWorldAgent()
   
    -- stop 播放
    if self._trapAgent then
        local objId = self._trapAgent:getObjId()
        local skillM, skillN = self._trapAgent:getMNExactly()
        local worldAgent = lt.AgentManager:getWorldAgent()
        worldAgent:deleteAgent(objId)
        self._trapAgent = nil
    end
end

function BuffHalo:checkRange()
    local isRange = false
    self._mHero, self._nHero = self._agent:getMNExactly()
    if math.max(math.abs(self._skillM - self._mHero), math.abs(self._skillN - self._nHero)) <= 6 then
        local worldAgent = lt.AgentManager:getWorldAgent()
        self._targetObjId = self._agent:getObjId() 
        local trapAgent = worldAgent:createClientTrap(self._skillId, self._fromObjId, self._targetObjId, self._skillM, self._skillN, "")
        trapAgent:getActor():setLocalZOrder((self._skillN  * 10000 + self._skillM + 9999) * 10 * 1)
        self._trapAgent = trapAgent
        isRange = true
    else
        if self._agent:hasBuffer(BuffEnum.EFFECT_CLASS_HALO) then
            self:deleteClientTrap()
        end
    end
    return isRange
end


return BuffHalo
