
local ItemSetDao = {}

function ItemSetDao:queryDefault(itemid,types)
    if not itemid then
        return
    end

    if not types then types = 1 end
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM ItemSet WHERE ItemIdx=%d and ItemType=%d; ;", itemid,types)) do
    	local Meta = lt.ItemSetMeta.new(row)
        return Meta
    end
end

function ItemSetDao:queryAll()
    local Table = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM ItemSet WHERE ItemIdx!=0;") do
        local Meta = lt.ItemSetMeta.new(row)
        Table[Meta:getSort()] = Meta
    end
    return Table
end

function ItemSetDao:queryRare()
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM ItemSet WHERE ItemIdx==0;") do
        local Meta = lt.ItemSetMeta.new(row)
        return Meta
    end
end

return ItemSetDao
