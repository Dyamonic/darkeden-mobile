
local EquipSuitDao = {}

function EquipSuitDao:query(suitId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM EquipSuit WHERE IdxId=%d;", suitId)) do
        local equipSuit = lt.EquipSuitMeta.new(row)
        return equipSuit
    end
end

return EquipSuitDao
