
local LevelExpInfoDao = {}

function LevelExpInfoDao:queryAll()
    local levelExpInfoMap = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM LevelExpInfo;") do
    	local levelExpInfoMeta = lt.LevelExpInfoMeta.new(row)
        levelExpInfoMap[levelExpInfoMeta:getLevel()] = levelExpInfoMeta
    end

    return levelExpInfoMap
end

return LevelExpInfoDao
