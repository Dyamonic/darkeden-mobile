local MathTableManger = {}
local MathTableManger = {}
local Constant = lt.Constant
local MAX_ANGLE = Constant.MAX_ANGLE

function MathTableManger:init()
    -- print("MathTableManger 原大小",#Constant.FSinTab, #Constant.FCosTab, Constant.FSinTab[1024], Constant.FCosTab[2])
    Constant.FSinTab = {}
    Constant.FCosTab = {}

    for i = 0, MAX_ANGLE - 1 do
        local angle = i * math.pi / 1024

        Constant.FSinTab[i + 1] = math.floor(math.sin(angle) * 0x10000 + 0.5)  -- Lua 数组从1开始，所以用 i+1
        Constant.FCosTab[i + 1] = math.floor(math.cos(angle) * 0x10000 + 0.5)
        -- Constant.FSinTab[i] = math.floor(math.sin(angle) * 0x10000)
        -- Constant.FCosTab[i] = math.floor(math.cos(angle) * 0x10000)
    end
    -- print("MathTableManger 赋值后大小",#Constant.FSinTab, #Constant.FCosTab, Constant.FSinTab[1023], Constant.FCosTab[1])

    for i = 0, MAX_ANGLE - 1 do
        local tanValue = Constant.FArcTanTab[i + 1]
        local sign = tanValue < 0 and -1 or 1 --标记符号位
        local lshiftTanValue = bit.lshift(math.abs(tanValue), 16) * sign --保留符号位
        Constant.FArcTanTab[i] = lshiftTanValue
    end

    Constant.FSin = function(angle)
        angle = bit.band(angle, Constant.MAX_ANGLE_1)
        -- print("jxljfslf1",angle)
        return Constant.FSinTab[angle + 1]
    end
    Constant.FCos = function(angle)
        angle = bit.band(angle, Constant.MAX_ANGLE_1)
        -- print("jxljfslf",angle)
        return Constant.FCosTab[angle + 1]
    end
end

function MathTableManger:clear()
end


return MathTableManger
