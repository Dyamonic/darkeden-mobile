local TransferPointDao = {}

function TransferPointDao:query(transferId)
    local db = lt.DbManager:getDb()
    for row in db:nrows(string.format("SELECT * FROM TransferPoint WHERE TransferId=%d;", tonumber(transferId))) do
    	local meta = lt.TransferPointMeta.new(row)
        return meta
    end
end

function TransferPointDao:queryAll()
    local map = {}
    local db = lt.DbManager:getDb()
    for row in db:nrows("SELECT * FROM TransferPoint") do
        local meta = lt.TransferPointMeta.new(row)
        local key = meta:getMapId().."_"..meta:getRaceType()
        if not map[key] then
            map[key] = {}
        end
        table.insert(map[key], meta)
    end
    return map
end

return TransferPointDao