---@class UICompSkillItem 技能item
---
local UICompSkillItem = class("UICompSkillItem", lt.UICompBase, lt.UICompChangeSkin)

local ShaderBackendUtil = lt.ShaderBackendUtil

UICompSkillItem.ChangeSkinConf = {
   ["RoleInfo"] = {
        ["frame1"] = "bg_jineng_zhuanzhi_01",
        ["frame2"] = "bg_jineng_zhuanzhi_da01",
   } 
}

local Constant = lt.Constant

function UICompSkillItem:ctor()
    self._spriteId = nil
    self._cyanIcon = nil
    self._curState = nil
    UICompSkillItem.super.ctor(self)
end

function UICompSkillItem:onClear()
    self._spriteId = nil
    self._cyanIcon = nil
    self._curState = nil
    UICompSkillItem.super.onClear(self)
end

function UICompSkillItem:onEnter()
end

function UICompSkillItem:onExit()
end

function UICompSkillItem:onConstruct()
    self:startSkin()
end

function UICompSkillItem:getCurState()
    return self._curState
end

function UICompSkillItem:setSpriteId(spriteId)
    self._spriteId = spriteId
end

-- 转职技能刷新
function UICompSkillItem:refreshItemEx(curState)
    self._curState = curState
    local icon = self:getChild("icon")
    local frame = self:getChild("frame")
    frame:setVisible(false)

    icon:setURL(string.format("ui://Skill/%s", self._spriteId))

    if curState == Constant.SkillState.NotLearnable then
        icon:setGrayed(true)
    elseif curState == Constant.SkillState.Learnable then
        icon:setGrayed(false)
        icon:setColor(cc.c3b(0,255,0))
    elseif curState == Constant.SkillState.Learned then
        icon:setGrayed(false)
        icon:setColor(cc.c3b(255,255,255))
    end
end

-- 阶级技能刷新
function UICompSkillItem:refreshItem(curState)
    self._curState = curState
    local icon = self:getChild("icon")
    local frame = self:getChild("frame")

    icon:setURL(string.format("ui://Skill/%s", self._spriteId))

    if self._cyanIcon then
        self._cyanIcon:removeFromParent()
        self._cyanIcon = nil
    end
    local resPath = string.format("ui://Skill/%s", self._spriteId)
    self._cyanIcon = fgui.UIPackage:createObjectFromURL(resPath)
    if not self._cyanIcon then
        return
    end
    self._cyanIcon:setScale(1.6,1.6)
    self._cyanIcon:setPivot(0.5,0.5,true)
    self._cyanIcon:setPosition(55,55)
    self:addChild(self._cyanIcon)

    if curState == Constant.ClsSkillState.Learned then
        icon:setVisible(false)
        self._cyanIcon:setVisible(true)
        --[[
            cocos4.0 FIXME:To be verified, shader change use.
        ]] 
        ShaderBackendUtil:makeCyanEffect(self._cyanIcon:displayObject())
    else
        icon:setVisible(true)
        self._cyanIcon:setVisible(false)
    end

    if curState == Constant.ClsSkillState.CurUnableToLearn then
        frame:setVisible(true)
        icon:setGrayed(false)
        local white =  cc.c3b(255,255,255)
        icon:setColor(white)
    else
        frame:setVisible(false)
    end

    if curState == Constant.ClsSkillState.NotLearnable then
        icon:setGrayed(true)
        local white = cc.c3b(255,255,255)
        icon:setColor(white)
    elseif curState == Constant.ClsSkillState.Learnable then
        icon:setGrayed(false)
        local green = cc.c3b(0,255,0)
        icon:setColor(green)
    end
end

return UICompSkillItem