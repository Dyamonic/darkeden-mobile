
local MonsterStateDie = class("MonsterStateDie", lt.MonsterStateBase)

local CacheManager = lt.CacheManager
local TimeTrigger = lt.TimeTrigger
local Constant = lt.Constant
local ActionManager = lt.ActionManager
local GameBoard = lt.GameBoard
local AutoManager = lt.AutoManager
local SkillEnum = lt.SkillEnum

MonsterStateDie._isDead = nil
MonsterStateDie._timeTrigger = nil

function MonsterStateDie:ctor(monsterAgent)
    MonsterStateDie.super.ctor(self, monsterAgent)

    self._modelId = monsterAgent:getMonsterData():getModelId()
    local time = nil
    if self._modelId ~= SkillEnum.SUMMON.SUMMON_MIGA and self._modelId ~= SkillEnum.SUMMON.SUMMON_WIND then
        local frameCount = ActionManager:getCreatureFrameCount("monster", self._modelId, Constant.ROLE_ACTION_DIE, monsterAgent:getDirection())
        time = frameCount * 0.1
    end
    
    self._timeTrigger = TimeTrigger.new(time)
end

function MonsterStateDie:onClear()
end

function MonsterStateDie:onEnter()
    -- yflog:Info("playAction Constant.ROLE_ACTION_DIE = %d", Constant.ROLE_ACTION_DIE)
    if not SkillEnum.IS_SUMMON_MODEL[self._modelId] then  --技能召唤怪物不播死亡动作
        self._monsterAgent:playAction(Constant.ROLE_ACTION_DIE)
    end

    -- 用于选择目标时的状态
    self._monsterAgent:setIsOutOfGame(true)
    self._monsterAgent:hideNameNode()

    -- 普通移除地图上占用的点 死亡时不占用格子 TODO在当前地复活，需要再把格子占用了
    -- 普通移除地图上占用的点 死亡时不占用格子
    local worldAgent = lt.AgentManager:getWorldAgent()
    local mapAgent = worldAgent:getMapAgent()
    mapAgent:removeAgentMN(self._monsterAgent, self._monsterAgent:getMNExactly())

    --宠物挖尸体
    local pet = worldAgent:getOwnPet()
    if pet and worldAgent:getCanDigMonster() then
        pet:changeState(lt.MonsterStateDig.new(pet))
    end
end

function MonsterStateDie:onExit()
end

function MonsterStateDie:onUpdate()
    local deltaTime = GameBoard:getDeltaTime()
    if self._timeTrigger:tick(deltaTime) then
        -- self._monsterAgent:changeState(lt.MonsterStateDead.new(self._monsterAgent))
        return
    end

    --[[ 设置隐藏死亡播放 
        if AutoManager:queryKey("HIDE_DEAD") then
            self._monsterAgent:getActor():hideSprite()

        else
            self._monsterAgent:getActor():showSprite()
        end
    ]]
end

function MonsterStateDie:onMessage(msg)
end

function MonsterStateDie:getStateId()
    return Constant.MONSTER_STATE_DIE
end

function MonsterStateDie:getStateName()
    return "MonsterStateDie"
end

return MonsterStateDie
