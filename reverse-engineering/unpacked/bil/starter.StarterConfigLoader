
local StarterConfigLoader = {}
--[[
	-- gamelist 参数说明
	GAME_SDK_ID   Sdk id
	GAME_CHANNEL_ID 渠道ID
	DEVELOPER   开发者
	GAME_USER_TYPE 用户类型
	GAME_BUNDLE_VERSION bundle version
]]

function StarterConfigLoader:getConfig()
	if not self._config then
		local path = cc.FileUtils:getInstance():fullPathForFilename("game.plist")
		self._config = cc.FileUtils:getInstance():getValueMapFromFile(path)
	end

	return self._config
end

-- Sdk id
function StarterConfigLoader:getSdkId()
	return self:getConfig()["GAME_SDK_ID"]
end

function StarterConfigLoader:isNoSdk()
	return device.platform == "ios" and self:getSdkId() == 0
end

function StarterConfigLoader:getChannelId()
	return self:getConfig()["GAME_CHANNEL_ID"]
end

function StarterConfigLoader:getCDNType()
	return tonumber(self:getConfig()["CDN_TYPE"]) or 4
end

function StarterConfigLoader:isDev()
	return self:getConfig()["DEVELOPER"] or 1
end

function StarterConfigLoader:isSkipUpdate()
	local skipUpdate = self:getConfig()["SKIP_UPT"] or 0
	return tonumber(skipUpdate) == 1
end

function StarterConfigLoader:isLoginCode()
	local skipLoginCode = self:getConfig()["NEED_LOGINCODE"] or 0
	return tonumber(skipLoginCode) == 1
end

function StarterConfigLoader:getUserType()
	local userType 

	if device.platform == "ios" then
		userType = self:getConfig()["GAME_USER_TYPE_IOS"]
	elseif device.platform == "android" then
		userType = self:getConfig()["GAME_USER_TYPE_ANDROID"]
	end

	if not userType then
		userType = self:getConfig()["GAME_USER_TYPE"]
	end

	return userType 
end

function StarterConfigLoader:getHideBanhao()
	return self:getConfig()["GAME_HIDE_BANHAO"] or 0
end

function StarterConfigLoader:getBundleVersion()
	return self:getConfig()["GAME_BUNDLE_VERSION"]
end

function StarterConfigLoader:getCp()
	return tonumber(self:getConfig()["CP"])
end

function StarterConfigLoader:isDeveloper()
	return cc.FileUtils:getInstance():isFileExist("developer")
end

function StarterConfigLoader:getCustomDeviceId()
	if not self._customDeviceId then
		self._customDeviceId = cc.UserDefault:getInstance():getStringForKey("GAME_CUSTOM_DEVICE", "")

		if self._customDeviceId == "" then
			local randKey = function(len, randSeed)
				if randSeed then
					local seed = tostring(socket.gettime() * 10000):reverse()
					math.randomseed(seed)
				end

				local rankStr = "" 
				local randNum = 0 
				for i=0,len do   
					if math.random(1,3)==1 then     
						randNum=string.char(math.random(0,26)+65)
					elseif math.random(1,3)==2 then     
						randNum=string.char(math.random(0.26)+97)
					else     
						randNum=math.random(0,10)   
					end   
					rankStr=rankStr..randNum 
				end 
				return rankStr
			end

			local socket = require "socket"
			self._customDeviceId = string.format("%.0f_%s", socket.gettime() * 10000, randKey(32, true))
			cc.UserDefault:getInstance():setStringForKey("GAME_CUSTOM_DEVICE", self._customDeviceId)
			cc.UserDefault:getInstance():flush()
		end
	end
	
	return self._customDeviceId
end

return StarterConfigLoader
