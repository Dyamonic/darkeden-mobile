-- bit operation

bit = bit or {}
bit.data32 = {}

for i=1,32 do
    bit.data32[i]=2^(32-i)
end

-- 二进制转十进制
function bit._b2d(arg)
    local nr=0
    for i=1,32 do
        if arg[i] ==1 then
            nr=nr+bit.data32[i]
        end
    end
    return  nr
end

-- 十进制转二进制
function bit._d2b(arg)
    arg = arg >= 0 and arg or (0xFFFFFFFF + arg + 1)
    local tr={}
    for i=1,32 do
        if arg >= bit.data32[i] then
            tr[i]=1
            arg=arg-bit.data32[i]
        else
            tr[i]=0
        end
    end
    return   tr
end

function bit._and(a,b)
    local op1=bit._d2b(a)
    local op2=bit._d2b(b)
    local r={}

    for i=1,32 do
        if op1[i]==1 and op2[i]==1  then
            r[i]=1
        else
            r[i]=0
        end
    end
    return  bit._b2d(r)

end

function bit._or(a,b)
    local op1=bit._d2b(a)
    local op2=bit._d2b(b)
    local r={}

    for i=1,32 do
        if op1[i]==1 or op2[i]==1  then
            r[i]=1
        else
            r[i]=0
        end
    end
    return bit._b2d(r)
end

function bit._not(a)
    local op1=bit._d2b(a)
    local r={}

    for i=1,32 do
        if  op1[i]==1   then
            r[i]=0
        else
            r[i]=1
        end
    end
    return bit._b2d(r)
end

-- 左移位运算
function bit._lshift(num, shift)
    shift = shift <= 32 and shift or 32
    shift = shift >= 0 and shift or 0

    local binary = bit._d2b(num)
    local shifted = {}

    -- 左移操作：移除前shift位，右侧补零
    for i = 1, 32 do
        if i <= (32 - shift) then
            shifted[i] = binary[i + shift]
        else
            shifted[i] = 0
        end
    end

    return  bit._b2d(shifted)
end

-- 右移位运算
function bit._rshift(num, shift)
    shift = shift <= 32 and shift or 32
    shift = shift >= 0 and shift or 0

    local binary = bit._d2b(num)
    local shifted = {}

    -- 右移操作：左侧补零，保留前 (32 - shift) 位
    for i = 1, 32 do
        if i > shift then
            shifted[i] = binary[i - shift]
        else
            shifted[i] = 0  -- 左侧补零
        end
    end

    return bit._b2d(shifted)
end

bit.band   = bit.band or bit._and
bit.bnot   = bit.bnot or bit._not
bit.lshift = bit.lshift or bit._lshift
bit.rshift = bit.rshift or bit._rshift
bit.bor    = bit.bor or bit._or