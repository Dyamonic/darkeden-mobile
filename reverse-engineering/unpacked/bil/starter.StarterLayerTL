
local StarterStr = require("starter.StarterStr")
local StarterCommitLayer = require("starter.StarterCommitLayerTL")

local StarterLayerTL = class("StarterLayerTL",  fgui.GComponent)

function StarterLayerTL:ctor()
	self._view = fgui.UIPackage:createObject("Login","Download")
    self._view:makeFullScreen()
	self._view:center()
	self:addChild(self._view)
	self._bar = self._view:getChild("loadingBar")
	self._progress = self._view:getChild("loadingNum")
    self._downloadControl = self._view:getController("download")
	self._loadingProgress = self._view:getChild("loadingProgress")
	self._arrow = self._bar:getChild("arrow")
	self._barSize = self._bar:getChild("bar"):getSize()
end

function StarterLayerTL:checkStarterUpdateFail(code)
	local commitLayer = StarterCommitLayer.new(StarterStr.UPDATE_FIAL.."\ncode:"..code, function()
		if _G_STARTER then
			_G_STARTER:checkStarterUpdate()
		end
	end, nil, {noCancel = true})
	self:addChild(commitLayer)
end

-- 下载提示确认框
function StarterLayerTL:downloadCommit(sumSize)
	-- 弹出确认
	local size = ""
	if sumSize > 1024 * 1024 then
		size = string.format("%.2fM", sumSize / 1024 / 1024)
	else
		size = string.format("%.1fK", sumSize / 1024)
	end

	local commitLayer = StarterCommitLayer.new(string.format(StarterStr.UPDATE_MSG, size), function()
		if _G_STARTER then
			self._downloadControl:setSelectedIndex(1)
			_G_STARTER:startDownload()
		end
	end, nil, {noCancel = true})
	self:addChild(commitLayer)
end

-- 下载进度条显示
function StarterLayerTL:displayDownloadProgress(curSize, sumSize, curIdx, sumIdx)

	local fixPercent = 0
	if sumSize > 0 then
		fixPercent = curSize/sumSize
	end
	if fixPercent < 0 then
		fixPercent = 0
	elseif fixPercent > 1 then
		fixPercent = 1
	end

	local size1 = curSize
	local size2 = sumSize
	local ttype = "KB"
	if size2 > 1024 * 1024 then
		size1 = curSize / 1024 / 1024
		size2 = sumSize / 1024 / 1024
		ttype = "MB"
	else
		size1 = curSize / 1024
		size2 = sumSize / 1024
	end

	self._bar:setValue(fixPercent*100)
	self._progress:setText(string.format("(%.1f%s/%.1f%s)", size1, ttype, size2, ttype))
	self._loadingProgress:setText(string.format("%.1f%%",fixPercent * 100))
	self._arrow:setPosition(2+self._barSize.width*fixPercent,2)
	self._arrow:setVisible((fixPercent * 100) > 1)
end

function StarterLayerTL:downloadFail(code)
	local commitLayer = StarterCommitLayer.new(StarterStr.UPDATE_FIAL.."\ncode:"..(code or "nil"), function()
		if _G_STARTER then
			_G_STARTER:checkStarterUpdate()
		end
	end, nil, {noCancel = true})
	self:addChild(commitLayer)
end

return StarterLayerTL
