-- 注册fgui.LuaWindow 事件:onInit,onHide,onShown,doShowAnimation,doHideAnimation
function fgui.LuaWindow:enableWindowEvents()
    self:registerScriptHandler(function(state)
        if DEBUG > 0 then 
            print("launch fgui.LuaWindow enableWindowEvents", state, self.class.__cname)
            local printInfo = string.format("use class: 【%s】 function:【%s】 isExist: 【%s】",self.class.__cname, state, self[state]~=nil and "true" or "false")
            print(printInfo)
        end
        if self[state] then
            self[state](self)
        end
        return self[state] ~= nil
    end)
end

-- 禁用生命周期事件
function fgui.LuaWindow:disableWindowEvents()
    self:unregisterLifeCycle()
end


-- 注册fgui.GComponent 事件:  onEnter()  onExit() 
function fgui.GComponent:enableComponentEvents()
    self:registerLifeCycle(function(state)
        if DEBUG > 0 then
            print("launch fgui.GComponent enableComponentEvents", state)
            local printInfo = string.format("use class: 【%s】 function:【%s】 isExist: 【%s】",self.class.__cname, state, self[state]~=nil and "true" or "false")
            print(printInfo)
        end
        if self[state] then
            self[state](self)
        end
        return self[state] ~= nil
    end)
end

-- 禁用生命周期事件
function fgui.GComponent:disableComponentEvents()
    self:unregisterScriptHandler()
end


--- 注册组件拓展
---@param url string
---@param extensiton class
function fgui.registerComponent(url, extensiton)
    if not GREG_URL_EXTENDS then
        GREG_URL_EXTENDS = {}
    end
    if GREG_URL_EXTENDS and GREG_URL_EXTENDS[url] and GREG_URL_EXTENDS[url].isRegister then
       print("fgui.registerComponent拦截",url)
       return  
    end
    if DEBUG > 0 then
        local checkUrlItem  = fgui.UIPackage:hasItemByURL(url)
        assert(checkUrlItem, string.format("[error] function 'fgui.registerComponent' url:[%s] is not exist, fix path correct.", url))
    end
    fgui.UIObjectFactory:registComponent(url, function()
        local obj = extensiton.new()
        obj:retain()
        table.insert(GREG_URL_EXTENDS[url].objs, obj)
        return obj
    end,function(obj)
        extensiton.onConstruct(obj)
    end)
    GREG_URL_EXTENDS[url] = {}
    GREG_URL_EXTENDS[url].isRegister = true
    GREG_URL_EXTENDS[url].objs = {}
    
end

-- 清理组件注册
function fgui.unregisterComponent(url) 
    if GREG_URL_EXTENDS and GREG_URL_EXTENDS[url] then
        if GREG_URL_EXTENDS[url].objs and #GREG_URL_EXTENDS[url].objs > 0  then
            for i, _ in ipairs(GREG_URL_EXTENDS[url].objs) do
                GREG_URL_EXTENDS[url].objs[i]:release()
                GREG_URL_EXTENDS[url].objs[i] = nil
            end
            GREG_URL_EXTENDS[url].objs = nil
        end
        GREG_URL_EXTENDS[url] = nil
        fgui.UIObjectFactory:unregistComponent(url)
    end
end


fgui.UIRoot = fgui.GRoot:getInstance()