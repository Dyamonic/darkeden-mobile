
local scheduler = require("cocos.framework.scheduler")

local LauncherLoadingLayer = class("LauncherLoadingLayer", function()
	return display.newLayer()
end)

LauncherLoadingLayer._loadEffect = false

function LauncherLoadingLayer:ctor()
	self:enableNodeEvents()
    self:setTouchEnabled(true)
    self:setTouchMode(cc.EVENT_TOUCH_ONE_BY_ONE)
    self:setSwallowsTouches(true)

    self._touchListener = cc.EventListenerTouchOneByOne:create()
    self._touchListener:setEnabled(true)
    self._touchListener:setSwallowTouches(true)
    self._touchListener:registerScriptHandler(function()
    	return true
    end, cc.Handler.EVENT_TOUCH_BEGAN)
    self._touchListener:registerScriptHandler(function()
    end, cc.Handler.EVENT_TOUCH_MOVED)
    self._touchListener:registerScriptHandler(function()
    end, cc.Handler.EVENT_TOUCH_ENDED)
    cc.Director:getInstance():getEventDispatcher():addEventListenerWithSceneGraphPriority(self._touchListener, self)

	self._delayHandler = scheduler.performWithDelayGlobal(handler(self, self.effect), 0.5)
end

function LauncherLoadingLayer:onExit()
	if self._loadEffect then
		-- ccs.ArmatureDataManager:getInstance():removeArmatureFileInfo("effect/uieffect_loading/uieffect_loading.ExportJson")
	end

	if self._delayHandler then
		scheduler.unscheduleGlobal(self._delayHandler)
		self._delayHandler = nil
	end

	if self._touchListener then
    	cc.Director:getInstance():getEventDispatcher():removeEventListener(self._touchListener)
    	self._touchListener = nil
    end
end

function LauncherLoadingLayer:effect()
	self._delayHandler = nil
	self._loadEffect = true

    -- 特效
    ccs.ArmatureDataManager:getInstance():addArmatureFileInfo("effect/uieffect_loading/uieffect_loading.ExportJson")

    local armature = ccs.Armature:create("uieffect_loading")
    armature:getAnimation():playWithIndex(0)
    armature:setPosition(display.cx, display.cy)
    self:addChild(armature)
end

return LauncherLoadingLayer
