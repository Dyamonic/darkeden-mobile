function LauncherLayerTL:ctor()
    fgui.registerComponent("ui://Login/AccountInputPC", CompAccountViewPC)
    fgui.registerComponent("ui://Login/SelectZone", CompSelectZone)
    fgui.registerComponent("ui://Login/loginCode", UseLoginCode)
    self:enableComponentEvents()

    -- 屏幕常亮
	cc.Device:setKeepScreenOn(true)
    self._data = nil
    self._isSdkLogin = false
    self:startFSM()
    self:initUI()
end

function LauncherLayerTL:onClear()
