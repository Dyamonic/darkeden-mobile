end

function LauncherLayerTL:displayDownloadProgress(curSize, sumSize, curIdx, sumIdx, isStep)
    local progressLayer = self:getProgressLayer()
    progressLayer:displayDownloadProgress(curSize, sumSize, curIdx, sumIdx, isStep)
end

function LauncherLayerTL:onRefreshProgressLayerTips()
    self._progressLayer:refreshBgTips()
end

function LauncherLayerTL:removeProgressLayer()
    if self._progressLayer then
        self._progressLayer:removeSelf()
        self._progressLayer = nil
    end

    if self._progressHandle then
        scheduler.unscheduleGlobal(self._progressHandle)
        self._progressHandle = nil
    end
end

-- 公告
function LauncherLayerTL:onAnnounce()
    LauncherHttpApi:getLoginNotice({}, handler(self, self.onGetAnnounceSuccess), handler(self, self.onGetAnnounceFail))
end

function LauncherLayerTL:onGetAnnounceFail(code)
    local commitLayer = StarterCommitLayer.new(string.format("%s\ncode:%s", LauncherStr.ANNOUNCE_FAIL, tostring(code)), handler(self, self.onAnnounce), nil, {noCancel = true})
    self:addChild(commitLayer)
end

function LauncherLayerTL:onGetAnnounceSuccess(responseStr)
    local responseJson = json.decode(responseStr) or {}
    local code = responseJson.code or -1

    if code ~= 0 then
        local commitLayer = StarterCommitLayer.new(string.format("%s\ncode:%s", LauncherStr.ANNOUNCE_FAIL, tostring(code)), handler(self, self.onAnnounce), nil, {noCancel = true})
        self:addChild(commitLayer)
        return
    end
    self._data = responseJson.data

    -- 自动弹出

    -- local data = {}
    -- for i = 1 ,3 do
    --     -- data[i] = self._data[1]
    --     data[i] = {}
    --     data[i].title = "标题"..i
    --     data[i].content = LauncherStr.BANHAO_2 .. LauncherStr.BANHAO_3
    --     data[i].type = i
    --     data[i].version = "100013"
    -- end
    -- self._data = data
    local isshow = self:checkNotice()
    if isshow then
        local announceLayer = Announce.new(self._data,handler(self, self.refreshNotice))
        self:addChild(announceLayer)
        self._btnNotice:getChild("red"):setVisible(true)
    end
    self._btnNotice:getChild("red"):setVisible(isshow)
end

function LauncherLayerTL:checkNotice()
    for i = 1 , #self._data do
        local datainfo = self._data[i]
        if datainfo then
            local type = datainfo.type
            local version = datainfo.version
            local userversion = cc.UserDefault:getInstance():getStringForKey("GAME_ANNOUNCE_VERSION"..type, "0")
            if userversion ~= version then
                return true
            end
        end
    end
    return false
end

function LauncherLayerTL:refreshNotice()
    local isshow = self:checkNotice()
    self._btnNotice:getChild("red"):setVisible(isshow)
end

--开服倒计时
function LauncherLayerTL:getOpenTime(callback)
    LauncherHttpApi:getCountDown({}, function(responseStr)
        local responseJson = json.decode(responseStr) or {}
        local leftTime = responseJson.data
        if leftTime == 0 then
            callback(RET.Success)
        else
            callback(RET.Fail, "", leftTime)
        end
    end, function (code)
        callback(RET.Fail, LauncherStr.SERVER_FAIL.."\ncode:"..code)
    end)
end

function LauncherLayerTL:playMusic(musicName, loop)
    self:stopMusic()
    local musicName = string.format("%s%s.mp3", "audio/music/", tostring(musicName))
    self._musicHandle = cc.AudioEngine:play2d(musicName, loop, 1)
end

function LauncherLayerTL:stopMusic()
    if self._musicHandle then
        cc.AudioEngine:stop(self._musicHandle)
        self._musicHandle = nil
    end
end


function LauncherLayerTL:getChannelId()
    return cpp.SdkService:shared().getChannelType and cpp.SdkService:shared():getChannelType()
end

return LauncherLayerTL
