function LauncherLayerTL:_connectGame()
    -- 代理连接服务器  为启动器在加载游戏场景时会优先创建initLauncherLayer,再讲self._delegateLayer赋值(游戏中的initLauncherLayer，用于传送变量)
    if self._delegateLayer then
        if self._delegateLayer.connectServer then
            if not self._serverInfo then
                return
            end

            self._token, self._checkToken = LaunchModuleTL:getAccoutInfo()
            _G_TOKEN = self._token
            _G_CHECK_TOKEN = self._checkToken
            _G_SERVER_INFO = self._serverInfo

            -- self:loadingOn()
            local url = self._serverInfo.url
            local ip = self._serverInfo.ip
            local port = self._serverInfo.port
            local serverName = self._serverInfo.serverName
            local serverId = self._serverInfo.serverId

            local subPortArray = string.split(port, ",")
            if #subPortArray > 0 then
                port = subPortArray[math.random(1, #subPortArray)]
            end

            local result = self._delegateLayer:connectServer(url,ip,port)
            if self._delegateLayer.setServerName then
                self._delegateLayer:setServerName(serverName)
            end

            if self._delegateLayer.setServerId then
                self._delegateLayer:setServerId(serverId)
            end

            if self._delegateLayer.setUserId then
                self._delegateLayer:setUserId(self._thirdPartyId)
            end

            if self._delegateLayer.setClientVer then
                self._delegateLayer:setClientVer(self._concatVer)
            end

            -- if self._delegateLayer.

            if not result then
                print("连接失败")
                self:createTips(LauncherStr.CONNECT_ERROR)
                return
            else
                print("开始连接")
            end

            local gameId = 0
            if _G_GAME_INFO then
                gameId = _G_GAME_INFO.id
            end
        else
            local showStr = LauncherStr.CONNECT_ERROR.."\ncode:2"
            local commitLayer = StarterCommitLayer.new(showStr, handler(self, self._startGame))
            self:addChild(commitLayer, 10000)
        end
    else
        local showStr = LauncherStr.CONNECT_ERROR.."\ncode:1"
        local commitLayer = StarterCommitLayer.new(showStr, handler(self, self._startGame))
        self:addChild(commitLayer, 10000)
    end
end

-----------------  FSM  func--------------------------------
function LauncherLayerTL:reqGameList(callback)
    _G_GAME_INFO = {
        type = "win32",
        id = 10001,
    }
    callback(RET.Success)
end
function LauncherLayerTL:reqZoneList(callback)
    local uuid = nil
    if self._uuid then
        uuid = self._uuid
    end
	LauncherHttpApi:initServerList({uuid = uuid}, function(responseStr)
        LaunchModuleTL:response(responseStr)
        callback(RET.Success)
    end, function (code)
        callback(RET.Fail, LauncherStr.SERVER_FAIL.."\ncode:"..code)
    end)
end
function LauncherLayerTL:reqDefaultServer(callback)
    local uuid = nil
    if self._uuid then
        uuid = self._uuid
    end
	LauncherHttpApi:initDefaultServer({uuid = uuid}, function(responseStr)
        local defaultServer = json.decode(responseStr)
        local defaultServerData = defaultServer.data
        if not defaultServerData then
            callback(RET.Fail, "请求默认区服失败") -- 保护data 值为空问题
            return 
        end
        LaunchModuleTL:setDefaultServer(defaultServerData)
        callback(RET.Success)
    end, function (code)
        callback(RET.Fail, LauncherStr.SERVER_FAIL.."\ncode:"..code)
    end)
end

-----------------   FSM  func---------------------------------
function LauncherLayerTL:checkLoginCode(callback)
    self._openTypeControl:setSelectedIndex(OPEN.CODE)
    self._codeview:setCallBack(function(_codekey)
        local u_id = self._thirdPartyId
        if u_id == nil then
            local acc,pwd = LaunchModuleTL:getAccoutInfo()
            u_id = acc
        end
        LauncherHttpApi:useCdKey(u_id,self._channelId or self:getChannelId(),_codekey, function(responseStr)
            local responseJson = json.decode(responseStr) or {}
            local code = responseJson.code or -1
            if code == 0 then
                if responseJson.cdkey_state == 0 then
                    callback(RET.Success)
                end
            else
                self._codeview:setCodeErrorTips(responseJson.code)
                --绑定失败
            end
        end, function (code)
            self._codeview:setCodeErrorTips(code)
            --绑定失败
        end)
        end,function()
            self._fsm:transform("ReqGameList")
        end)
end
