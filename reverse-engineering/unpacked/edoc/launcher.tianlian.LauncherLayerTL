function LauncherLayerTL:onStartGame()
    self._serverInfo = LaunchModuleTL:getEnterGameZoneInfo()
    self._openTypeControl:setSelectedIndex(OPEN.LOADING)
    self:setLoadTips("")
    if not self._serverInfo then
        self:createTips("未获取到服务器信息")
        return 
    end
    local state = tonumber(self._serverInfo.state)
    if state == SEVER_STATE.MAINTENANCE then
        self:createTipsOfBusy("服务器维护中，请稍后再试")
        return
    elseif state == SEVER_STATE.BUSY then
        self:createTipsOfBusy("服务器人数已满，请选择其他服务器。")
        return
    end

    self:checkUpt()
end

