end

function LauncherLayerTL:addDelegateLayer(layer)
	self._delegateLayer = layer
end

function LauncherLayerTL:onEnter()
    -- 监听事件
    local eventDispatcher = cc.Director:getInstance():getEventDispatcher()

    -- 登录成功监听
    self._listenerLoginSuccess = cc.EventListenerCustom:create("onLoginSuccess", handler(self, self.onLoginSuccess))
    self._listernerLoginFail = cc.EventListenerCustom:create("onLoginError", handler(self, self.onLoginError))
    eventDispatcher:addEventListenerWithFixedPriority(self._listenerLoginSuccess, -200)
    eventDispatcher:addEventListenerWithFixedPriority(self._listernerLoginFail, -200)


    -- 账号注销成功监听
    self._listenerClearSessionSuccess = cc.EventListenerCustom:create("onClearSession", handler(self, self.onLogoutSuccess))
    eventDispatcher:addEventListenerWithFixedPriority(self._listenerClearSessionSuccess, -200)

	scheduler.performWithDelayGlobal(function()
        self._fsm:transform("ReqGameList")
	end, 0.2)
end

function LauncherLayerTL:onExit()
    self:stopMusic()
    local eventDispatcher = cc.Director:getInstance():getEventDispatcher()
    if self._listernerLoginFail then
        eventDispatcher:removeEventListener(self._listernerLoginFail)
        self._listernerLoginFail = nil
    end
    if self._listenerLoginSuccess then
        eventDispatcher:removeEventListener(self._listenerLoginSuccess)
        self._listenerLoginSuccess = nil
    end
    if self._listenerClearSessionSuccess then
        eventDispatcher:removeEventListener(self._listenerClearSessionSuccess)
        self._listenerClearSessionSuccess = nil
    end
end

function LauncherLayerTL:onConnFail(code, errCode)
    self:createTips("连接服务器失败,code:"..(errCode or ""))
end


function LauncherLayerTL:startFSM()
    local states = {
        Restart = {
            onEnter = function(fsm,name)
                self._fsm:transform("ReqGameList")
            end
        },
        ReqGameList = {
            onEnter = function(fsm,name)
                self:setLoadTips("获取游戏列表中...")
                self:reqGameList(function(ret,err)
                    if ret == RET.Success then
                        self._fsm:transform("AccountLogin")
                    else
                        self:createTips(err)
                    end
                end)

                self:playMusic("blood", true)
            end,
            onExit = function(fsm,name)
                print('ReqGameList end')
            end
        },
        ReqCountDown = {
            onEnter = function(fsm,name)
                self:setLoadTips("")
                self:getOpenTime(function(ret,err,countDown)
                    if ret == RET.Success then
                        self._fsm:transform("CheckLoginCode")
                    else
                        self:createTips(err,countDown)
                    end
                end)
            end,
            onExit = function(fsm,name)
            end
        },
        ReqZoneList = {
            onEnter = function(fsm,name)
                self:setLoadTips("请求区服列表中...")
                self:reqZoneList(function(ret,err)
                    if ret == RET.Success then
                        self._fsm:transform("ReqDefaultServer")
                    else
                        self:createTips(err)
                    end
                end)
            end,
            onExit = function(fsm,name)
                print('ReqZoneList end')
            end
        },
        ReqDefaultServer = {
            onEnter = function(fsm,name)
                self:setLoadTips("请求默认服务器中...")
                self:reqDefaultServer(function(ret,err)
                    if ret == RET.Success then
                        self._openTypeControl:setSelectedIndex(OPEN.ENTER)
                        self:refreshUI()
                        self:onAnnounce()
                    else
                        self:createTips(err)
                    end
                end)
            end,
            onExit = function(fsm,name)
                print('ReqDefaultServer end')
            end
        },
        AccountLogin = {
            onEnter = function(fsm,name)
                self:setLoadTips("登录中...")
                -- 登录状态 进入初始界面第一步，唤起sdk登录
                self._isSdkLogin = cpp.SdkService:shared():login()
                if not self._isSdkLogin then
                    -- 非sdk登录
                    self._openTypeControl:setSelectedIndex(OPEN.ACCOUNT)
                    self:login(function(ret, acc, pwd, err)
                        if ret == RET.Success then
                            self._uuid = acc
                            self._fsm:transform("ReqZoneList")
                            -- self._fsm:transform("CheckLoginCode")--测试代码
                        else
                            self:createTips(err)
                        end
                    end)
                else
                    --- 进入sdk 登录等待返回即可 onLoginSuccess 回调
                    LauncherHttpApi:reportGameStage(LauncherConstant.GAME_STAGE.LOGIN_SDK)
                end
			end,
            onExit = function(fsm,name)
                self._openTypeControl:setSelectedIndex(OPEN.LOADING)
            end
        },
        CheckLoginCode = {
            --sdk登录之后&游戏服务器登录之前校验
            onEnter = function(fsm,name)
                if not NEED_LOGINCODE then
                    if self._isSdkLogin then
                        self._fsm:transform("TokenCheck")
                    else
                        self._fsm:transform("ReqZoneList")
                    end
                    return
                end
                self:setLoadTips("账号激活码检测中...")
                local u_id = self._thirdPartyId
                if u_id == nil then
                    local acc,pwd = LaunchModuleTL:getAccoutInfo()
                    u_id = acc
                end
                LauncherHttpApi:selectCdKey(u_id,self._channelId or self:getChannelId(),function(responseStr)
                    local responseJson = {}
                    local success,result = pcall(json.decode, responseStr)
                    if success then
                        responseJson = json.decode(responseStr)
                    else
                        responseJson = {code = 0}
                    end
                    local code = responseJson.code or -1
                    if code == 0 then
                        --激活邀请直接过
                        if responseJson.cdkey_state == 0 then
                            if self._isSdkLogin then
                                self._fsm:transform("TokenCheck")
                            else
                                self._fsm:transform("ReqZoneList")
                            end
                            return
                        end
                    else
                        self:createTips("账号激活码检测失败" .. code)
                        return
                    end
                    self:checkLoginCode(function(ret,err)
                        if ret == RET.Success then
                            if self._isSdkLogin then
                                self._fsm:transform("TokenCheck")
                            else
                                self._fsm:transform("ReqZoneList")
                            end
                        else
                            self:createTips(err)
                        end
                    end)
                end,function(code)
                    self:createTips("账号激活码检测失败")
                end)
            end,
            onExit = function(fsm,name)
                print('CheckLoginCode end')
            end
        },
        TokenCheck = {
            onEnter = function(fsm,name)
                self:setLoadTips("签名校验中...")
                LauncherHttpApi:thirdLogin(self._thirdAccessToken, self._thirdPartyId, self._thirdExtra, function(responseStr)
                    local responseJson = json.decode(responseStr) or {}
                    -- dump(responseJson)
                    local code = responseJson.code or -1
                    if code ~= 0 then
                        self:createTips("请求第三方token失败" .. code)
                        return
                    end
                    print("第三方token校验成功")
                    local acc = responseJson.token
                    local pwd = responseJson.check_token
                    self._uuid = acc --用户唯一标识
                    LaunchModuleTL:setAccoutInfo(acc, pwd)
                    self._fsm:transform("ReqZoneList")
                end, function()
                    self:createTips("请求第三方token失败")
                end)    
			end,
        },
        EnterGame = {
            onEnter = function(fsm,name)
				self:setLoadTips("正在连接中...")
                -- 开始游戏
                LauncherHttpApi:reportGameStage(LauncherConstant.GAME_STAGE.ENTER_GAME)

                StartGameTL:startGame()
                scheduler.performWithDelayGlobal(handler(self, self._connectGame), 0)
			end,
        },
        CheckUpdate = {
            onEnter = function(fsm,name)
				self:setLoadTips("检测游戏热更新中...")

                -- 忽略更新
                if SKIP_UPT then
                    scheduler.performWithDelayGlobal(function()
                        self._fsm:transform("EnterGame")
                    end , 0.5)
                    return
                end

                if not display.getRunningScene():getUpdater():isGameInstall() then 
                    -- 游戏尚未安装，则提示，并下载
                    self:downloadGameCommit()
                    return
                end

                if self._serverInfo then
                    -- 是否灰度判断
                    local isGary = self._serverInfo.isGray
                    local tarVersion = self._serverInfo.tarVersion or ""

                    if tostring(isGary) == "1" and tarVersion ~= "" then
                        -- 检测并更新 灰度版本
                        display.getRunningScene():getUpdater():downloadGaryGame(tarVersion)
                        return
                    end
                end

                -- 检测并更新
                display.getRunningScene():getUpdater():downloadGame()
			end,
        },
        Download = {
            onEnter = function(fsm,name)
                yflog:Info("开始下载")
                display.getRunningScene():getUpdater():startDownload()
                self:playMusic("EvenInDreams", true)
			end
        }
    }
	self._fsm = FSM.new(states)
	self:displayObject():onUpdate(function (dt)
		self._fsm:tick(dt)
    end)
end

