
local LauncherStr = require("launcher.LauncherStr")

local LauncherCommitLayer = class("LauncherCommitLayer", function()
	return display.newLayer()
end)

function LauncherCommitLayer:ctor(msg, commitCallback, cancelCallback, params)
    params = params or {}

    self:enableNodeEvents()
    self:setTouchEnabled(true)
    self:setTouchMode(cc.EVENT_TOUCH_ONE_BY_ONE)
    self:setSwallowsTouches(true)

    self._touchListener = cc.EventListenerTouchOneByOne:create()
    self._touchListener:setEnabled(true)
    self._touchListener:setSwallowTouches(true)
    self._touchListener:registerScriptHandler(function()
    	return true
    end, cc.Handler.EVENT_TOUCH_BEGAN)
    self._touchListener:registerScriptHandler(function()
    end, cc.Handler.EVENT_TOUCH_MOVED)
    self._touchListener:registerScriptHandler(function()
    end, cc.Handler.EVENT_TOUCH_ENDED)
    cc.Director:getInstance():getEventDispatcher():addEventListenerWithSceneGraphPriority(self._touchListener, self)

	self._commitCallback = commitCallback
	self._cancelCallback = cancelCallback

	local bg = display.newSprite("updater/Common_Bg_Frame_04.png")
	bg:setPosition(display.cx, display.cy)
	self:addChild(bg)

	local w = bg:getContentSize().width

	local titleLabel = display.newTTFLabel({text = LauncherStr.SYSTEM_TIPS, font = "font/chs/FONT_1.TTF", size = 24, color = cc.c3b(0xEB, 0xC4, 0x91)})
	titleLabel:enableOutline(cc.c4b(0x15, 0x0F, 0x05, 0xFF), 2)
    titleLabel:setPosition(display.cx, display.cy + 90)
    self:addChild(titleLabel)

    local msgLabel = display.newTTFLabel({text = msg, font = "font/chs/FONT_1.TTF", size = 18, color = cc.c3b(0xFC, 0xF0, 0xDF)})
    msgLabel:enableOutline(cc.c4b(0x15, 0x0F, 0x05, 0xFF), 2)
    msgLabel:setAnchorPoint(0, 1)
    msgLabel:setDimensions(w - 100, 0)
    msgLabel:setPosition(display.cx + 50 - w / 2, titleLabel:getPositionY() - 45)
    self:addChild(msgLabel)

    local commitBtn = ccui.Button:create("updater/Common_Btn_02.png")
    commitBtn:setTitleText(params.commitStr or LauncherStr.COMMIT)
    commitBtn:setTitleFontSize(18)
    commitBtn:setTitleColor(cc.c3b(0xFC, 0xF0, 0xDF))
    commitBtn:setPosition(display.cx, display.cy - 70)
    commitBtn:addClickEventListener(handler(self, self.onCommit))
    self:addChild(commitBtn)

    if not params.noCancel then
        commitBtn:setPosition(display.cx - 80, display.cy - 70)

    	local cancelBtn = ccui.Button:create("updater/Common_Btn_02.png")
        cancelBtn:setTitleText(LauncherStr.CANCEL)
        cancelBtn:setTitleFontSize(18)
        cancelBtn:setTitleColor(cc.c3b(0xFC, 0xF0, 0xDF))
        cancelBtn:setPosition(display.cx + 80, display.cy - 70)
        cancelBtn:addClickEventListener(handler(self, self.onCancel))
        self:addChild(cancelBtn)

    end
end

function LauncherCommitLayer:onExit()
	if self._touchListener then
    	cc.Director:getInstance():getEventDispatcher():removeEventListener(self._touchListener)
    	self._touchListener = nil
    end
end

function LauncherCommitLayer:onCancel()
	local cancelCallback = self._cancelCallback

	self:close()

	if cancelCallback then
		cancelCallback()
	end
end

function LauncherCommitLayer:onCommit()
	local commitCallback = self._commitCallback

	self:close()

	if commitCallback then
		commitCallback()
	end
end

function LauncherCommitLayer:close()
	self:removeFromParent()
end

return LauncherCommitLayer
