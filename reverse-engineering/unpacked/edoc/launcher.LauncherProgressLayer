
local LauncherStr = require("launcher.LauncherStr")

local LauncherProgressLayer = class("LauncherProgressLayer", function()
	return display.newLayer()
end)

LauncherProgressLayer.BG_JPG = {
    "starter/bg1.png",
    "starter/bg2.png",
    "starter/bg3.png",
    "starter/bg4.png",
}

LauncherProgressLayer._state = nil

local fontName = "font/fangzheng.ttf"
local fontSize18 = 18

function LauncherProgressLayer:ctor(msg, commitCallback, cancelCallback, params)    
    self:enableNodeEvents()
    self:setTouchEnabled(true)
    self:setTouchMode(cc.EVENT_TOUCH_ONE_BY_ONE)
    self:setSwallowsTouches(true)

    params = params or {}

    self._touchListener = cc.EventListenerTouchOneByOne:create()
    self._touchListener:setEnabled(true)
    self._touchListener:setSwallowTouches(true)
    self._touchListener:registerScriptHandler(function()
    	return true
    end, cc.Handler.EVENT_TOUCH_BEGAN)
    self._touchListener:registerScriptHandler(function()
    end, cc.Handler.EVENT_TOUCH_MOVED)
    self._touchListener:registerScriptHandler(function()
    end, cc.Handler.EVENT_TOUCH_ENDED)
    cc.Director:getInstance():getEventDispatcher():addEventListenerWithSceneGraphPriority(self._touchListener, self)

    local bgPic = "starter/bg.png"

    self._bg = display.newSprite(bgPic)
    self._bg:setPosition(display.cx, display.cy)
    self:addChild(self._bg)

    self._bg2 = display.newSprite(bgPic)
    self._bg2:setPosition(display.cx, display.cy)
    self:addChild(self._bg2)

    -- 特效
    -- ccs.ArmatureDataManager:getInstance():addArmatureFileInfo("effect/BackDropEffect/BackDropEffect.ExportJson")

    -- local armature = ccs.Armature:create("BackDropEffect")
    -- armature:getAnimation():playWithIndex(0)
    -- armature:setPosition(display.cx, display.cy)
    -- self:addChild(armature)

    local y = display.cy - 222
    local x = display.cx

    -- 进度条
    -- y = y --- 50
    local bg = display.newSprite("starter/bg_denglu_jdt01.png", display.cx, y)
    self:addChild(bg)
    local bagSize = bg:getContentSize()

    self._bar = cc.ProgressTimer:create(display.newSprite("starter/bg_denglu_jdt02.png"))
    self._bar:setType(cc.PROGRESS_TIMER_TYPE_BAR)
    self._bar:setBarChangeRate(cc.p(1, 0))
    self._bar:setMidpoint(cc.p(0, 0.5))
    self._bar:setAnchorPoint(0, 0.5)
    self._bar:setPosition(2,5)
    bg:addChild(self._bar)
    self._barSize = self._bar:getContentSize()

    self._arrow = display.newSprite("starter/bg_denglu_guang.png")
    self._arrow:setAnchorPoint(1, 0)
    self._bar:addChild(self._arrow)
    self._arrowSize = self._arrow:getContentSize()

    -- 小提示
    local tipLab = display.newTTFLabel({text = LauncherStr.STARTER_GAME_TIP_TITLE, font = fontName, size = 24, color = cc.c3b(0xFF, 0xFF, 0x00)})
    tipLab:enableOutline(cc.c4b(0x15, 0x0F, 0x05, 0xFF), 1)
    tipLab:setAnchorPoint(0, 0)
    tipLab:setPosition(x - bagSize.width/2, y + 13)
    self:addChild(tipLab)
    local tw = tipLab:getContentSize().width
    x = x + tw 

    self._tipLabel = display.newTTFLabel({text = "", font = fontName, size = 24, color = cc.c3b(0xFF, 0xFF, 0x00)}) 
    self._tipLabel:enableOutline(cc.c4b(0x15, 0x0F, 0x05, 0xFF), 1)
    self._tipLabel:setAnchorPoint(0, 0)
    self._tipLabel:setPosition(x - bagSize.width/2, y + 13)
    self:addChild(self._tipLabel)

    -- 文本
    y = y - 18
    self._progressLabel = display.newTTFLabel({text = "100/100", font = fontName, size = 18, color = cc.c3b(0xFF, 0xFF, 0xFF)})
    self._progressLabel:enableOutline(cc.c4b(0x15, 0x0F, 0x05, 0xFF), 1)
    self._progressLabel:setAnchorPoint(cc.p(1,0.5))
    self._progressLabel:setPosition(display.cx + bagSize.width/2, y)
    self:addChild(self._progressLabel)

    self._sizeLabel = display.newTTFLabel({text = "100/100", font = fontName, size = 18, color = cc.c3b(0xFF, 0xFF, 0xFF)})
    self._sizeLabel:enableOutline(cc.c4b(0x15, 0x0F, 0x05, 0xFF), 1)
    self._sizeLabel:setAnchorPoint(cc.p(0,0.5))
    self._sizeLabel:setPosition(display.cx - bagSize.width/2, y)
    self:addChild(self._sizeLabel)

    self._bgResArr = self:RandSort(#LauncherProgressLayer.BG_JPG, #LauncherProgressLayer.BG_JPG, LauncherProgressLayer.BG_JPG)
    self._strTipArr = self:RandSort(#LauncherStr.STARTER_GAME_TIP, #LauncherStr.STARTER_GAME_TIP, LauncherStr.STARTER_GAME_TIP)
    self._pngT = 1
    self._tipT = 1
    self:setBgSprite(1)
    self:setTips(1)
end

function LauncherProgressLayer:onExit()
    -- ccs.ArmatureDataManager:getInstance():removeArmatureFileInfo("effect/BackDropEffect/BackDropEffect.ExportJson")

	if self._touchListener then
    	cc.Director:getInstance():getEventDispatcher():removeEventListener(self._touchListener)
    	self._touchListener = nil
    end
end



function LauncherProgressLayer:refreshBgTips()
    self._pngT = self._pngT + 1
    if not self._bgResArr[self._pngT] then
        self._strTipArr = self:RandSort(#LauncherProgressLayer.BG_JPG, #LauncherProgressLayer.BG_JPG, LauncherProgressLayer.BG_JPG)
        self._pngT = 1
    end
    self:setBgSprite(self._pngT)
    
    self._tipT = self._tipT + 1
    if not self._strTipArr[self._tipT] then
        self._strTipArr = self:RandSort(#LauncherStr.STARTER_GAME_TIP, #LauncherStr.STARTER_GAME_TIP, LauncherStr.STARTER_GAME_TIP)
        self._tipT = 1
    end
    self:setTips(self._tipT)
end

function LauncherProgressLayer:setTips(state)
    local str = self._strTipArr[state]
    if str then
        self._tipLabel:setString(str)
    end
end

function LauncherProgressLayer:setBgSprite(state)
    local path = self._bgResArr[state]
    if path then
        local sprite = display.newSprite(path)
        if sprite then
            if self._bg:getOpacity() > 0 and self._bg2:getOpacity() > 0 then
                self._bg:setSpriteFrame(sprite:getSpriteFrame())
                self._bg2:setSpriteFrame(sprite:getSpriteFrame())
                self._bg2:setOpacity(0)
                return
            end

            self:changeBgFade(sprite)
        end
    end
end

function LauncherProgressLayer:changeBgFade(sprite)
    local bg  = self._bg2
    local bg2 = self._bg
    if self._bg:getOpacity() > 0 then
        bg  = self._bg
        bg2 = self._bg2
    end

    bg:stopAllActions()
    bg:setOpacity(255)
    bg:runAction(cc.FadeOut:create(1.0))

    bg2:setSpriteFrame(sprite:getSpriteFrame())
    bg2:stopAllActions()
    bg2:setOpacity(0)
    bg2:runAction(cc.FadeIn:create(1.0))
end

function LauncherProgressLayer:RandSort(num, poolSize, pool)
    local list = {}
    pool = pool or {}
    math.randomseed( tonumber(tostring(os.time()):reverse():sub(1,6)))
    for i=1,num do
        local rand = math.random(i, poolSize)
        local tmp = pool[rand] or rand -- 对于第二个池子，序号跟id号是一致的
        pool[rand] = pool[i] or i
        pool[i] = tmp

        table.insert(list, tmp)
    end
    return list
end

function LauncherProgressLayer:displayDownloadProgress(curSize, sumSize, curIdx, sumIdx, isStep)
    local fixPercent = 0
    if sumSize > 0 then
        fixPercent = curSize/sumSize
    end
    if fixPercent < 0 then
        fixPercent = 0
    elseif fixPercent > 1 then
        fixPercent = 1
    end
    
    self._bar:setPercentage(fixPercent * 100)
    
    local barWidth = self._barSize.width * fixPercent
    self._arrow:setPosition(barWidth,0)
    local cutDownWidth = 0
    if barWidth >= self._arrowSize.width then
        cutDownWidth = 0
    else
        cutDownWidth = self._arrowSize.width - barWidth
    end
    self._arrow:setTextureRect({x = cutDownWidth,y = 0, width = self._arrowSize.width - cutDownWidth, height = 6},isRotated,cc.size(self._arrowSize.width - cutDownWidth,6))

    self._progressLabel:setString(string.format("%.2f%%", fixPercent * 100))

    local size1 = 0
    local size2 = 0
    local tt = "KB"
    if sumSize > 1024 * 1024 then
        tt = "MB"
        size1 = string.format("%.1fMB", curSize / 1024 / 1024)
        size2 = string.format("%.1fMB", sumSize / 1024 / 1024)
    else
        size1 = string.format("%.1fKB", curSize / 1024)
        size2 = string.format("%.1fKB", curSize / 1024)
    end
    -- self._sizeLabel:setString(string.format("%.2f/%.2f%s", size1, size2, tt))
    if isStep then
        self._sizeLabel:setString(string.format(LauncherStr.STARTER_GAME_DECOMPRESS_TIP, curIdx, sumIdx))
    else
        if _G_IS_EXAMINE then
            self._sizeLabel:setString(string.format(LauncherStr.STARTER_GAME_DECOMPRESS_TIP, curIdx, sumIdx))
        else
            self._sizeLabel:setString(string.format(LauncherStr.STARTER_GAME_DOWNLOAD_TIP, size1, size2))
        end
    end
end

function LauncherProgressLayer:getDownSizeStr(size)
    local downloadSize = math.ceil(size / 1024)
    local downloadText = string.format("%dKB", downloadSize)
    if downloadSize > 1000 then
        downloadSize = downloadSize / 1024 / 1024
        downloadText = string.format("%.1fMB", downloadSize)
    end

    return downloadText
end

function LauncherProgressLayer:close()
	self:removeFromParent()
end

return LauncherProgressLayer
