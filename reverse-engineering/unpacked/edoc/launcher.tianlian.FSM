local FSM = class("FSM")

table.merge(FSM,{
	_curState = nil,
	_states = {}
})

function FSM:ctor(states)
	self._states = states
end

-- 切换状态
function FSM:transform(name,...)
	local curState = self._curState
	if curState == name then
		return false
	end

	if curState then
		local cs = self._states[curState]
		assert(cs,curState)
		if cs.onExit then
			cs.onExit(self,curState)
		end
	end

	local ns = self._states[name]
	assert(ns,name)
	self._curState = name
	if ns.onEnter then
		ns.onEnter(self,name,...)
	end

	return true
end

function FSM:tick(dt)
	local curState = self._curState
	if  curState then
		local cs = self._states[curState]
		assert(cs,curState)
		if cs.onUpdate then
			cs.onUpdate(self,curState,dt)
		end
	end
end

return FSM