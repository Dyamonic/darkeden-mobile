        sdk_id      = ConfigLoader:getSdkId(),
        channel_id  = self:getChannelId(),
    }
    local sign = self:urlSign(params)
    params.sign = sign
    params.extra = extra

    -- 设备id
    local deviceId = ""
    if cpp.GamePlatform and cpp.GamePlatform.getDeviceId then
        deviceId = cpp.GamePlatform:getDeviceId()
    end
    params.device_id = deviceId

    -- 自定义设备id
    local customDeviceId = ConfigLoader:getCustomDeviceId()
    params.custom_device_id = customDeviceId
    print('thirdLogin url',params)
    dump(params)
    local httpClient = HttpClient.new(url, params, onSuccess, onFailed)
    httpClient:get(true)
end

