---非sdk登录（输入账号密码界面）
local CompAccountViewPC = class("CompAccountViewPC", fgui.GButton)
local LaunchModuleTL = require("launcher.tianlian.LaunchModuleTL")
local RET = {
    Success = 0,
    Fail =1
}
function CompAccountViewPC:ctor()
    self:enableComponentEvents()
    self._callback = nil
end

function CompAccountViewPC:onConstruct()
    self._textAcc = self:getChild("textAcc")
    self._textPwd = self:getChild("textPwd")
    self._btnLogin = self:getChild("btnLogin")
    self._btnLogin:addClickListener(handler(self, self.btnLoginClick))
end

function CompAccountViewPC:onClear()
    self._textAcc = nil
    self._textPwd = nil
    self._btnLogin = nil
    self._callback = nil
end

function CompAccountViewPC:onEnter()
    self:refreshUI()
end

function CompAccountViewPC:onExit()
end

function CompAccountViewPC:btnLoginClick(context)
    local acc = self._textAcc:getText()
    local pwd = self._textPwd:getText()
    if acc == "" or pwd == "" then
        return 
    end
    LaunchModuleTL:setAccoutInfo(acc, pwd)
    if self.callback then
        self.callback(RET.Success, acc, pwd)
    end
end

function CompAccountViewPC:refreshUI()
    local acc, pwd = LaunchModuleTL:getAccoutInfo()
    if acc ~= "" then
        self._textAcc:setText(acc)
        self._textPwd:setText(pwd)
    end
end

function CompAccountViewPC:loginCallback(callback)
    self.callback = callback
end


return CompAccountViewPC


