---@公告
---@class Announce:fgui.GComponent
local Announce = class("Announce", fgui.GComponent)

---@param param table
--[[
--- {content = "",noCancel = true, confirmCallback = function() end }
]]
function Announce:ctor(data, callback)
    self.data = data
    if type(self.data) ~= "table" then
       return 
    end
    self._callback = callback
    self._view = fgui.UIPackage:createObject("Login", "Announce")
    self:addChild(self._view)
    self._view:setPivot(0.5, 0.5, true)
    self._view:setPosition(display.cx, display.cy)
    self.cancelBtn = self._view:getChild("btnClose")
    self.cancelBtn:addClickListener(handler(self, self.onCancelBtnClick))
    self._img = self._view:getChild("img")
    self._img:addClickListener(handler(self, self.onCancelBtnClick))
    self._lbltitle = self._view:getChild("lbltitle")
    self._listtitle = self._view:getChild("listtitle")

    self._list_content = self._view:getChild("list_content")
    self._lblcontent = self._list_content:getChildAt(0):getChild("lblcontent")
    self._lblAuthor = self._list_content:getChildAt(0):getChild("n11")
    -- self._listtitle:setItemProvider(handler(self, self.getListItemResource))
    self._listtitle:setItemRenderer(handler(self, self.renderTitleItem))
    self._listtitle:setNumItems(#self.data)
    self._listtitle:addEventListener(fgui.UIEventType.ClickItem, handler(self, self.onClickItem))
    self._listtitle:setSelectedIndex(self:onCheckRed())
    self:initContent()
end

function Announce:renderTitleItem(index, obj)
    local datainfo = self.data[index + 1]
    obj:getChild("title"):setText(datainfo.title)
    self:checkRedByIndex(index)
end

function Announce:onClickItem(context)
    self:initContent()
    self._list_content:getScrollPane():scrollTop()
end

function Announce:onCheckRed()
    for i = 1, #self.data do
        local datainfo = self.data[i]
        if datainfo then
            local type = datainfo.type
            local version = datainfo.version
            local userversion = cc.UserDefault:getInstance():getStringForKey("GAME_ANNOUNCE_VERSION" .. type, "0")
            if userversion ~= version then
                return i - 1
            end
        end
    end
    return 0
end

function Announce:checkRedByIndex(index)
    local datainfo = self.data[index + 1]
    if datainfo then
        local type = datainfo.type
        local version = datainfo.version
        local userversion = cc.UserDefault:getInstance():getStringForKey("GAME_ANNOUNCE_VERSION" .. type, "0")
        local isred = true
        if userversion == version then
            isred = false
        end

        local obj = self._listtitle:getChildAt(index)
        if obj then
            obj:getChild("bgred"):setVisible(isred)
        else
            obj:getChild("bgred"):setVisible(isred)
        end
    end
end

function Announce:initContent()
    local index = self._listtitle:getSelectedIndex()
    local datainfo = self.data[index + 1]
    if datainfo then
        self._lblcontent:setText(datainfo.content)
        self._lbltitle:setText(datainfo.title)
        self._lblAuthor:setText("")
        local type = datainfo.type
        local version = datainfo.version
        local userversion = cc.UserDefault:getInstance():getStringForKey("GAME_ANNOUNCE_VERSION" .. type, "0")
        if userversion ~= version then
            cc.UserDefault:getInstance():setStringForKey("GAME_ANNOUNCE_VERSION" .. type, version)
            cc.UserDefault:getInstance():flush()
            local obj = self._listtitle:getChildAt(index)
            if obj then
                obj:getChild("bgred"):setVisible(false)
            end
        end
    else
        self._lbltitle:setText("")
        self._lblcontent:setText("")
        self._lblAuthor:setText("")
    end
end

function Announce:onCancelBtnClick()
    local callback = self._callback
    if callback then
        callback()
    end
    self:close()
end

function Announce:close()
    self:removeFromParent()
end

return Announce
