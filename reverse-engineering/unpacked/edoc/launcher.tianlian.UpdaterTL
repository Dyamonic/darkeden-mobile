-- 获取当前文件版本号
function UpdaterTL:getLocalGameVersion()
	local version = ""
	local f = io.open(self:getLocalGameVersionPath(), "r")
	if f then
		for line in f:lines()  do
			version = line
			break
		end

		f:close()
	end

	return version
end

-- 获取本地游戏version.txt
function UpdaterTL:getLocalGameVersionPath()
	local path = device.writablePath
	if device.platform == "mac" or device.platform == "windows" then
		path = path .. "download/"
	end

	local filePath = path .. "win32/" .. GAME_VERSION_TXT
	if not io.exists(filePath) then
		cc.FileUtils:getInstance():createDirectory(path.."win32")
		
		local fullPath = cc.FileUtils:getInstance():fullPathForFilename("win32/"..GAME_VERSION_TXT)
		local dataFromFile = cc.FileUtils:getInstance():getDataFromFile(fullPath)

		local file = io.open(filePath, "w+b")
        file:write(dataFromFile)
        file:close()
	end

	return filePath
end

-- 当前res_map.txt 内容
function UpdaterTL:getLocalGameResMap()
    local resMap = {}
	local f = io.open(self:getLocalGameResMapPath(), "r")
	if f then
		for line in f:lines()  do
			if line and line ~= "" then
				local value = self:analysisResMapLine(line)
				if value then
					resMap[value[1]] = value
				end
			end
		end

		io.close(f)
	end

	return resMap
end

-- 获取本地res_map.txt
function UpdaterTL:getLocalGameResMapPath()
	local path = device.writablePath
	if device.platform == "mac" or device.platform == "windows" then
		path = path .. "download/"
	end

	local filePath = path .. "win32/" .. GAME_MAP_TXT
	if not io.exists(filePath) then
		cc.FileUtils:getInstance():createDirectory(path)
		
		local fullPath = cc.FileUtils:getInstance():fullPathForFilename("win32/"..GAME_MAP_TXT)
		local dataFromFile = cc.FileUtils:getInstance():getDataFromFile(fullPath)

		local file = io.open(filePath, "w+b")
        file:write(dataFromFile)
        file:close()
	end

	return filePath
end

-- 远程res信息
function UpdaterTL:getRemoteGameResMap()
	local resMap = {}

	if self._remoteGameResMapStr then
		local lines = string.split(self._remoteGameResMapStr, "\n")
		for _, line in ipairs(lines) do
			if line and line ~= "" then
				local value = self:analysisResMapLine(line)
				if value then
					resMap[value[1]] = value
				end
			end
		end
	end

	return resMap
end

-- 文件是否已下载，download信息: 格式：[res/bil.pk] = 8b8fa82ad6d2b3f3c2ef0c7562baf2e5
function UpdaterTL:isFileDownload(value)
	local downloadInfo = self:getFileDownloadInfo()
	return isset(downloadInfo, value[1]) and downloadInfo[value[1]] == value[2]
end

-- 获取downloadInfo
function UpdaterTL:getFileDownloadInfo()
	if not self._downloadInfo then
		local downloadList = cc.UserDefault:getInstance():getStringForKey(GAME_WIN32_DOWNLOAD_LIST_KEY, "")
		if downloadList == "" then
			self._downloadInfo = {}
		else
			self._downloadInfo = json.decode(downloadList) or {}
		end
	end

	return self._downloadInfo
end

function UpdaterTL:saveFileDownloadInfo(value)
    local downloadInfo = self:getFileDownloadInfo()
    self._downloadInfo[value[1]] = value[2]
    cc.UserDefault:getInstance():setStringForKey(GAME_WIN32_DOWNLOAD_LIST_KEY, json.encode(self._downloadInfo))
    cc.UserDefault:getInstance():flush()
end

function UpdaterTL:clearFileDownloadInfo()
    self._downloadInfo = {}
    cc.UserDefault:getInstance():setStringForKey(GAME_WIN32_DOWNLOAD_LIST_KEY, json.encode(self._downloadInfo))
    cc.UserDefault:getInstance():flush()
end

function UpdaterTL:saveLocalGameMap()
    if not self._remoteGameResMapStr then
        return
    end

    io.writefile(self:getLocalGameResMapPath(), self._remoteGameResMapStr)
end

-- res_map.txt 文件格式
function UpdaterTL:analysisResMapLine(line)
	local lineArray = string.split(line, ",")
	if #lineArray < 3 then
		return nil
	end

	return {lineArray[1] or "nil", lineArray[2] or "", lineArray[3] or 0}
end

-- 确认游戏是否安装
function UpdaterTL:isGameInstall()
	local status = cc.UserDefault:getInstance():getIntegerForKey(GAME_STARTER_GAME_INSTALL_win32, 0)
	if status == 0 then
		local resPath = "win32/res_map.txt"
		if cc.FileUtils:getInstance():isFileExist(resPath) then
			status = 1
		else
			status = 2
		end
		cc.UserDefault:getInstance():setIntegerForKey(GAME_STARTER_GAME_INSTALL_win32, status)
		cc.UserDefault:getInstance():flush()
	end

	return status == 1
end

-- 设置游戏已安装
function UpdaterTL:setGameInstalled()
    cc.UserDefault:getInstance():setIntegerForKey(GAME_STARTER_GAME_INSTALL_win32, 1)
    cc.UserDefault:getInstance():flush()
end


-- 完成下载
function UpdaterTL:completeDownload()
    yflog:Info("LauncherLayer:completeDownload")

    display.getRunningScene():getLauncherLayer():removeProgressLayer()

    -- 下载完成
    LauncherHttpApi:reportGameStage(LauncherConstant.GAME_STAGE.COMPLETE_GAME_DOWNLOAD)

    self:stopDownload()
    -- 保存
    self:clearFileDownloadInfo()
    self:saveLocalGameMap()
    self:checkGameUpdateComplete()
end

-- 下载地址
function UpdaterTL:getDownloadUrl()
    return self._downloadUrl
end

-- 下载到本地的目录
function UpdaterTL:getDownloadPath()
    return self._downloadPath
end

function UpdaterTL:checkGameUpdateComplete()
    -- 更新本地存储
    self:setGameInstalled()

    display.getRunningScene():getLauncherLayer():onGameUpdateCompleteEnterGame()
end

return UpdaterTL
