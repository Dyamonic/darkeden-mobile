
local UIWidget = class("UIWidget", function()
    return display.newNode()
end)

UIWidget._param         = nil
UIWidget._eventListener = nil

function UIWidget:ctor(param)
    self:setParam(param)
    self:enableNodeEvents()

end
function UIWidget:onCleanup()
    self:onViewOutHandler()
    self:onClear()
end

function UIWidget:onClear()
end

function UIWidget:onViewOutHandler()
end

function UIWidget:enterEvent()
    self._eventListener = cc.EventListenerTouchOneByOne:create()
    self._eventListener:setEnabled(true)
    self._eventListener:setSwallowTouches(true)
    self._eventListener:registerScriptHandler(handler(self, self.onWidgetTouchBegan), cc.Handler.EVENT_TOUCH_BEGAN)
    self._eventListener:registerScriptHandler(handler(self, self.onWidgetTouchMoved), cc.Handler.EVENT_TOUCH_MOVED)
    self._eventListener:registerScriptHandler(handler(self, self.onWidgetTouchEnded), cc.Handler.EVENT_TOUCH_ENDED)
    cc.Director:getInstance():getEventDispatcher():addEventListenerWithSceneGraphPriority(self._eventListener, self)
end

function UIWidget:exitEvent()
    cc.Director:getInstance():getEventDispatcher():removeEventListener(self._eventListener)
end

function UIWidget:onWidgetTouchBegan()
end

function UIWidget:onWidgetTouchMoved()
end

function UIWidget:onWidgetTouchEnded()
end

function UIWidget:setParam(param)
    self._param = param
end

function UIWidget:getParam()
    return self._param
end

return UIWidget