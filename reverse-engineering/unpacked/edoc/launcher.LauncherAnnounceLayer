function LauncherCommitLayer:initTaskInfo(announce)
    local listInfo = false
    local output = parseTaskInfo(announce)
    for _,v in ipairs(output) do
        if v.markStr == "lt" then
            listInfo = true
            self:addInfo(v)
        end
    end
    return listInfo
end

function LauncherCommitLayer:addInfo(v)
    if not self._announceArray then
        self._announceArray = {}
    end
    self._announceArray[#self._announceArray + 1] = v
end

