function LauncherCommitLayer:initTabListView()
    if not self._tabListView then
        local cfg = {
            renderItemCallBack = handler(self,self._reandBuyTabFunHandler),
            totalNumber = #self._announceArray,
        } 
        self._tabListView = ListView.new(self._tabCellNode,cfg)
    else
        self._tabListView:reload({totalNumber = #self._announceArray}) 
    end
end

function LauncherCommitLayer:_reandBuyTabFunHandler(list, index, info)
    local isCacheNode = true
    local data = self._announceArray[index]
    local item = list:getItemFromCache()
    if not item then
        item = display.newNode()
        local w, h = 128, 45
        item:setContentSize(cc.size(w, h))
        item:setAnchorPoint(0, 1)

        local x, y = w/2, h/2
        local tab = display.newSprite("launcher/bg_btn_normal.png")
        tab:setPosition(x, y)
        item:addChild(tab)

        local lab = display.newTTFLabel({text = "", font = "font/chs/FONT_2.TTF", size = 16, color = cc.c3b(0xE8, 0xC8, 0x00)})
        lab:setPosition(x, y)
        item:addChild(lab)

        item._btn = ccui.Button:create("launcher/none.png")
        item._btn:setScale9Enabled(true)
        item._btn:setContentSize(tab:getContentSize().width, tab:getContentSize().height)
        item._btn:setPosition(x, y)
        item:addChild(item._btn)

        item.setInfo = function(idata)
            if idata then
                lab:setString(idata.title)
                if idata.selected then
                    local frame = getSpriteFrameByPath("launcher/bg_btn_press.png")
                    tab:setSpriteFrame(frame)
                else
                    local frame = getSpriteFrameByPath("launcher/bg_btn_normal.png") 
                    tab:setSpriteFrame(frame)
                end
            end
        end
        isCacheNode = false
    end
    item.setInfo(data)
    info.item = item
    info.size = item:getContentSize()
    list:registerBtnHandler(index, "_btn", function(x, y, touchNode, listView)
        local touchIndex = listView:getCurTouchIndex()
        local cell = listView:getItemByIndex(touchIndex)
        if cell then
            self:doEventTabBuyItemState(touchIndex)
        end
    end)
    return isCacheNode
end

function LauncherCommitLayer:doEventTabBuyItemState(idx)
    if self._state and self._state == idx then
        return
    end
    self._state = idx

    for i=1,#self._announceArray do
        self._announceArray[i].selected = idx == i and true or false
    end
    self._tabListView:refreshData()

    self:refreshInfoNode()
end

function LauncherCommitLayer:refreshInfoNode()
    self._infoBg:removeAllChildren()

    self._scrollView = nil
    local w, h = 420, 360
    self._scrollView = ccui.ScrollView:create()
    self._scrollView:setTouchEnabled(true)
    self._scrollView:setDirection(ccui.ScrollViewDir.vertical)
    self._scrollView:setAnchorPoint(cc.p(0, 0))
    self._scrollView:setPosition(18, 10)
    self._scrollView:setScrollBarEnabled(false)
    self._scrollView:setBounceEnabled(true)
    self._scrollView:setContentSize(cc.size(w, h))
    self._infoBg:addChild(self._scrollView)

    self._scrollNode = display.newNode()
    self._scrollView:addChild(self._scrollNode)

    local announce = self._announceArray[self._state] and self._announceArray[self._state].detail or ""
    announce = string.gsub(string.gsub(announce, "\\t", "\t"), "\\n", "\n")
    local announceLabel = RichText.new(parseTaskString(announce .. "<>"), w, { defaultSize = 18, lineSpacing=5, label=true, defaultColor = cc.c3b(0xbe, 0xb4, 0x8e) }) 
    announceLabel:setAnchorPoint(cc.p(0, 1))
    self._scrollNode:addChild(announceLabel)

    local contentHeight = math.max(h, announceLabel:getContentSize().height)
    self._scrollNode:setPosition(0, contentHeight)
    self._scrollView:setInnerContainerSize(cc.size(w, contentHeight));
end

function LauncherCommitLayer:onExit()
	if self._touchListener then
    	cc.Director:getInstance():getEventDispatcher():removeEventListener(self._touchListener)
    	self._touchListener = nil
    end
end

function LauncherCommitLayer:onCancel()
	local cancelCallback = self._cancelCallback

	self:close()

	if cancelCallback then
		cancelCallback()
	end
end

function LauncherCommitLayer:onCommit()
	local commitCallback = self._commitCallback

	self:close()

	if commitCallback then
		commitCallback()
	end
end

function LauncherCommitLayer:close()
    if self._tabListView then
        self._tabListView:remove()
        self._tabListView = nil
    end
    self._scrollView = nil
    self._announceArray = nil
	self:removeFromParent()
end

return LauncherCommitLayer
