local function convertColorWithX(colorStr)
    local color = tonumber(string.format("%d",colorStr))
    local r = 0 
    local g = 0 
    local b = 0
    b = color%16
    color = math.floor(color/16)
    b = b + (color%16) * 16
    color = math.floor(color/16)
    g = color%16
    color = math.floor(color/16)
    g = g + (color%16) * 16
    color = math.floor(color/16)
    r = color%16
    color = math.floor(color/16)
    r = r + (color%16) * 16
    return cc.c3b(r,g,b)
end

--通过路径获取spriteFrame
local function getSpriteFrameByPath(path, np)
    if path == nil or path == "" then
        return nil
    end

    if type(path) == "table" then
        return path
    end

    local pos1,pos2 = string.find(path,".plist")
    if pos1 ~= nil and pos2 ~= nil then
        local plistPath = string.sub(path,0, pos2)
        local fileName = string.sub(path,pos2+2)

        cc.SpriteFrameCache:getInstance():addSpriteFrames(plistPath)
        return cc.SpriteFrameCache:getInstance():getSpriteFrame(fileName)
    else
        if np then
            return path
        end

        local sprite = cc.Sprite:create(path)
        if sprite then
            return sprite:getSpriteFrame()
        end
        assert(false, path.." not a plist file and not an image file.")
    end
end

local function parseTaskInfo(str)
    if not str or str == "" then
        print("parseTaskInfo str is nil or empty")
        return
    end
    -- local returnMsg = string.split(str, "\n")
    local output = {}
    local msg = string.split(str, "##")
    for i = 1, #msg do
        if msg[i] and msg[i] ~= "" then
            local message = nil
            -- 0-9|
            -- local pos1,pos2 = string.find(msg[i],"0x[(a-f)|(A-F)]*")
            markStr = string.sub(msg[i], 1, 2)
            message = string.sub(msg[i], 3)
            local m = string.split(message, "||")
            table.insert(output, {title = m[1]  or "" , detail = m[2] or "", markStr = markStr  or ""})
        end
    end
    return output
end

local function parseTaskString(str)
    if not str or str == "" then
        return
    end
    
    local config = {}
    local startIndex = string.find(str,"<.->")
    if startIndex then
        string.gsub(str,"(.-)<(.-)>",function(normalText, richContent)
            if normalText and normalText ~= "" then
                normalText = string.gsub(normalText, "\\n", "\n")
                local normalTextTable = string.split(normalText, "\n")

                for k, v in pairs(normalTextTable) do
                    if k > 1 then
                        table.insert(config,{oType = "wrap"})
                    end
                    if v and v ~= "" then
                        table.insert(config,{oType = "font",content = v, outline = true})
                    end
                end
            end

            if string.find(richContent, "%a-%s*=%s*#%s*%x+%s+.-") then
                string.gsub(richContent,"(%a-)%s*=%s*#%s*(%d+)%s+(.+)",function(tag, param, content)
                    if tag == "color" and param ~= "" then
                        local colorP = convertColorWithX(param)
                        table.insert(config,{oType = "font", content = content, tag = tag, color = colorP, outline = true})
                    elseif tag == "unLine" and param ~= "" then
                        local colorP = convertColorWithX(param)
                        table.insert(config,{oType = "font", content = content, tag = tag, color = colorP, outline = true, unLine = true})
                    end
                end)
            end

            if string.find(richContent, "%a-%s*=%s*%a-%s+.-") then
                string.gsub(richContent,"(%a-)%s*=%s*(%a-)%s+(.+)",function(tag, param, content)
                    if tag == "color" and param ~= "" then
                        table.insert(config,{oType = "font", content = content, tag = tag, color = param, outline = true})
                    elseif tag == "unLine" and param ~= "" then
                        table.insert(config,{oType = "font", content = content, tag = tag, color = param, outline = true, unLine = true})
                    end
                end)
            end

            if string.find(richContent, ".-%s*/%s*@%s*%a-") then
                string.gsub(richContent,"(.-)%s*/%s*@%s*(.+)",function(content, command)
                    local color
                    content, color = self:parseString(content)
                    table.insert(config,{oType = "font", content = content, command = command, color = color or "yellow", btnSign = fromNpc, unLine = not fromNpc, unLineHeight = 4, button = true, outline = true, btnSpacing = fromNpc and 16 or 0})
                end)
            end
            if string.find(richContent, "item%s+.-") then
                string.gsub(richContent,"item%s+(%w+)%s*,%s*(%w+)%s*,%s*(%w+)",function(itemType, itemId, itemNum)
                    table.insert(config,{oType = "item",itemType = itemType, itemId = itemId, itemNum = itemNum})
                end)
            end
        end)
    else
        if str ~= "" then
            local normalTextTable = string.split(str, "\n")
            for k, v in pairs(normalTextTable) do
                if k > 1 then
                    table.insert(config,{oType = "wrap"})
                end
                if v and v ~= "" then
                    table.insert(config,{oType = "font",content = v})
                end
            end
        end
    end

    return config
end

