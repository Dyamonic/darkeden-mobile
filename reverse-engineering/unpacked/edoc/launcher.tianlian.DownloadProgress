local DownloadProgress = class("DownloadProgress")

--[[
    状态字
    -2  挂起(不自动重启下载)
    -1  失败
    0   初始
    1   下载中
    99  下载完毕
]]
DownloadProgress._status = 0
DownloadProgress._downloadErrorCode = 0
DownloadProgress._downloadFailCount = 0
DownloadProgress._downloadProgress = nil

local DOWNLOAD_FAIL_MAX = 4

function DownloadProgress:ctor(delegate, value)
    self._delegate = delegate
    self._value = value

    self._cppUpdater = cpp.Updater:new()
    self._cppUpdater:registerScriptHandler(handler(self, self.cppUpdateHandler))
end

-- 监听
function DownloadProgress:cppUpdateHandler(event, value)
    if event == "success" then
        self._status = 99
        
    elseif event == "state" then
        -- 过程事件
        if value == "downloadStart" then
        elseif value == "downloadDone" then
        elseif value == "uncompressStart" then
        elseif value == "uncompressDone" then
        elseif value == "stateUnknown" then
        end
    elseif event == "error" then
        -- 错误事件
        local errorCode = -1
        if value == "errorCreateFile" then
            -- 创建文件失败 没权限?
            print("创建文件失败")
            errorCode = 1
        elseif value == "errorNetwork" then
            -- 网络下载失败 网不好?
            print("网络下载失败")
            errorCode = 2
        elseif value == "errorUncompress" then
            -- 解压失败 资源坏了?
            print("解压失败")
            errorCode = 3
        elseif value == "errorCopyFile" then
            -- 拷贝文件失败
            print("拷贝失败")
            errorCode = 4
        elseif value == "errorMD5" then
            -- MD5校验失败
            print("MD5校验失败")
            errorCode = 5
        elseif value == "errorUnknown" then
            print("errorUnknown wtf?")
        end

        self:downloadFail(errorCode)

    elseif event == "progress" then
        -- 下载进度
        self:downloadProgress(value) 
    end
end

function DownloadProgress:startDownload()
    self._status = 1

    -- 分析文件
    local pathinfo = io.pathinfo(self._value[1])
    if pathinfo.extname == ".zip" then
        -- 压缩包
        local zipUrl         = self._delegate:getDownloadUrl() .. self._value[1]
        local uncompressPath = self._delegate:getDownloadPath()
        local zipName        = pathinfo.filename
        local fileMd5        = self._value[2]

        self:_downloadZipFile(zipUrl, uncompressPath, zipName, fileMd5)

    else
        -- 普通文件
        local fileUrl  = self._delegate:getDownloadUrl() .. self._value[1]
        local filePath = self._delegate:getDownloadPath() .. pathinfo.dirname
        local fileName = pathinfo.filename
        local fileMd5  = self._value[2]

        self:_downloadNormalFile(fileUrl, filePath, fileName, fileMd5)
    end
end

function DownloadProgress:downloadFail(errorCode)
    self._downloadErrorCode = errorCode

    self._downloadFailCount = self._downloadFailCount + 1
    if self._downloadFailCount > DOWNLOAD_FAIL_MAX then
        self._status = -2
    else
        self._status = -1
    end
end

-- 普通文件下载
function DownloadProgress:_downloadNormalFile(fileUrl, filePath, fileName, fileMd5)
    self._cppUpdater:downloadNormalFile(fileUrl, filePath, fileName, fileMd5)
end

-- zip
function DownloadProgress:_downloadZipFile(zipUrl, uncompressPath, zipName, fileMd5)
    self._cppUpdater:downloadZipFile(zipUrl, uncompressPath, zipName, fileMd5)
end

function DownloadProgress:downloadProgress(progress)
    self._downloadProgress = math.max(0, math.min(100, progress))
end

-- 当前下载包的大小
function DownloadProgress:getCurDownloadSize()
    if self._downloadProgress and self._value then
        return self._value[3] * (self._downloadProgress / 100)
    end

    return 0
end

function DownloadProgress:getStatus()
    return self._status
end

function DownloadProgress:getValue()
    return self._value
end

function DownloadProgress:getErrorCode()
    return self._downloadErrorCode
end

return DownloadProgress